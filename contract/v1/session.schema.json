{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session.schema.json",
  "title": "Oulipoly Provider Session Contract",
  "type": "object",
  "$defs": {
    "SessionBaseParams": {
      "type": "object",
      "properties": {
        "settings_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string" }
      },
      "required": ["settings_id"],
      "additionalProperties": true
    },
    "SessionEnumerateParams": {
      "type": "object",
      "properties": {
        "settings_id": { "type": "string", "minLength": 1 },
        "limit": { "type": "integer", "minimum": 1 },
        "cursor": { "type": ["string", "null"] },
        "include_cwd": { "type": "boolean" },
        "include_turn_count": { "type": "boolean" },
        "since_unix_ms": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/UnixMilliseconds" },
            { "type": "null" }
          ]
        }
      },
      "required": ["settings_id"],
      "additionalProperties": false
    },
    "SessionEnumerateRequest": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/RequestEnvelope" },
        { "type": "object", "properties": { "params": { "$ref": "#/$defs/SessionEnumerateParams" } } }
      ]
    },
    "SessionEnumerateSource": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "detail": { "type": ["string", "null"] }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "SessionEnumerateEntry": {
      "type": "object",
      "properties": {
        "provider_session_id": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "cwd": { "type": ["string", "null"] },
        "created_unix_ms": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/UnixMilliseconds" },
            { "type": "null" }
          ]
        },
        "updated_unix_ms": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/UnixMilliseconds" },
            { "type": "null" }
          ]
        },
        "turn_count": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "$ref": "#/$defs/SessionEnumerateSource" }
      },
      "required": ["provider_session_id", "source"],
      "additionalProperties": false
    },
    "SessionEnumerateResult": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/$defs/SessionEnumerateEntry" }
        },
        "complete": { "type": "boolean" },
        "next_cursor": { "type": ["string", "null"] },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["sessions", "complete", "warnings"],
      "additionalProperties": false
    },
    "SessionEnumerateResponse": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/SuccessResponseEnvelope" },
        { "type": "object", "properties": { "result": { "$ref": "#/$defs/SessionEnumerateResult" } } }
      ]
    },
    "SessionEnumerateErrorResponse": { "$ref": "common.schema.json#/$defs/ErrorResponseEnvelope" },
    "SessionLocateTranscriptRequest": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/RequestEnvelope" },
        { "type": "object", "properties": { "params": { "$ref": "#/$defs/SessionBaseParams" } } }
      ]
    },
    "SessionLocateTranscriptResult": {
      "type": "object",
      "properties": {
        "located": { "type": "boolean" },
        "path": { "type": "string" },
        "format_id": { "type": "string" },
        "source_id": { "type": "string" },
        "require_existing_observed": { "type": "boolean" }
      },
      "required": ["located"],
      "additionalProperties": false
    },
    "SessionLocateTranscriptResponse": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/SuccessResponseEnvelope" },
        { "type": "object", "properties": { "result": { "$ref": "#/$defs/SessionLocateTranscriptResult" } } }
      ]
    },
    "SessionLocateTranscriptErrorResponse": { "$ref": "common.schema.json#/$defs/ErrorResponseEnvelope" },
    "SessionTurnPageToken": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 4096
    },
    "SessionTurnPageProjection": {
      "type": "string",
      "enum": ["canonical_ingest", "user_observation"]
    },
    "SessionReadTurnsParams": {
      "type": "object",
      "properties": {
        "settings_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "read_protocol": { "const": "oulipoly.session_turn_pages/v1" },
        "turn_projection": { "$ref": "#/$defs/SessionTurnPageProjection" },
        "expected_delivery_nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "start_mode": {
          "type": "string",
          "enum": ["beginning", "tail", "continuation"]
        },
        "after_token": { "$ref": "#/$defs/SessionTurnPageToken" },
        "snapshot_id": { "$ref": "#/$defs/SessionTurnPageToken" },
        "page_token": { "$ref": "#/$defs/SessionTurnPageToken" },
        "max_turns": { "type": "integer", "minimum": 1, "maximum": 256 },
        "max_response_bytes": { "type": "integer", "minimum": 1024, "maximum": 524288 },
        "max_source_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "max_inline_body_bytes": { "type": "integer", "minimum": 0, "maximum": 65536 }
      },
      "required": [
        "settings_id",
        "session_id",
        "read_protocol",
        "turn_projection",
        "start_mode",
        "after_token",
        "snapshot_id",
        "page_token",
        "max_turns",
        "max_response_bytes",
        "max_source_bytes",
        "max_inline_body_bytes"
      ],
      "oneOf": [
        {
          "properties": {
            "start_mode": { "const": "beginning" },
            "snapshot_id": { "const": null },
            "page_token": { "const": null }
          }
        },
        {
          "properties": {
            "start_mode": { "const": "tail" },
            "turn_projection": { "const": "user_observation" },
            "after_token": { "const": null },
            "snapshot_id": { "const": null },
            "page_token": { "const": null }
          }
        },
        {
          "properties": {
            "start_mode": { "const": "continuation" },
            "after_token": { "const": null },
            "snapshot_id": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "page_token": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": { "turn_projection": { "const": "user_observation" } },
            "required": ["turn_projection"]
          },
          "then": { "required": ["expected_delivery_nonce"] },
          "else": { "not": { "required": ["expected_delivery_nonce"] } }
        }
      ],
      "additionalProperties": false
    },
    "SessionReadTurnsRequest": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/RequestEnvelope" },
        { "type": "object", "properties": { "params": { "$ref": "#/$defs/SessionReadTurnsParams" } } }
      ]
    },
    "SessionTurnBodyChunk": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "text": { "type": "string", "maxLength": 65536 }
      },
      "required": ["type"],
      "additionalProperties": true
    },
    "SessionTurnPageTurn": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "turn_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "snapshot_sequence": { "type": "integer", "minimum": 0 },
        "timestamp": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "minLength": 1, "maxLength": 64 },
        "parent_turn_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1024
        },
        "is_sidechain": { "type": "boolean" },
        "is_compaction_boundary": { "type": "boolean" },
        "body_state": { "type": "string", "enum": ["inline", "absent", "omitted_oversize"] },
        "body": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/SessionTurnBodyChunk" } },
            { "type": "null" }
          ]
        },
        "body_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "body_sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "canonical_text_sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "session_id",
        "turn_id",
        "snapshot_sequence",
        "timestamp",
        "role",
        "parent_turn_id",
        "is_sidechain",
        "is_compaction_boundary",
        "body_state",
        "body",
        "body_bytes",
        "body_sha256",
        "canonical_text_sha256"
      ],
      "oneOf": [
        {
          "properties": {
            "body_state": { "const": "inline" },
            "body": { "type": "array", "items": { "$ref": "#/$defs/SessionTurnBodyChunk" } },
            "body_bytes": { "type": "integer", "minimum": 0 },
            "body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        {
          "properties": {
            "body_state": { "const": "absent" },
            "body": { "const": null },
            "body_bytes": { "const": null },
            "body_sha256": { "const": null },
            "canonical_text_sha256": { "const": null }
          }
        },
        {
          "properties": {
            "body_state": { "const": "omitted_oversize" },
            "body": { "const": null }
          }
        }
      ],
      "additionalProperties": false
    },
    "SessionReadTurnsResult": {
      "type": "object",
      "properties": {
        "read_protocol": { "const": "oulipoly.session_turn_pages/v1" },
        "provider_instance_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "settings_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "turn_projection": { "$ref": "#/$defs/SessionTurnPageProjection" },
        "snapshot_id": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "page_index": { "type": "integer", "minimum": 0 },
        "page_start_sequence": { "type": "integer", "minimum": 0 },
        "turns": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/SessionTurnPageTurn" }
        },
        "page_turn_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "source_bytes_examined": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "scan_progress": { "type": "boolean" },
        "snapshot_complete": { "type": "boolean" },
        "next_page_token": { "$ref": "#/$defs/SessionTurnPageToken" },
        "resume_token": { "$ref": "#/$defs/SessionTurnPageToken" },
        "source_final": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 1024 }
        }
      },
      "required": [
        "read_protocol",
        "provider_instance_id",
        "settings_id",
        "session_id",
        "turn_projection",
        "snapshot_id",
        "page_index",
        "page_start_sequence",
        "turns",
        "page_turn_count",
        "source_bytes_examined",
        "scan_progress",
        "snapshot_complete",
        "next_page_token",
        "resume_token",
        "source_final",
        "warnings"
      ],
      "oneOf": [
        {
          "properties": {
            "snapshot_complete": { "const": false },
            "next_page_token": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "resume_token": { "const": null }
          }
        },
        {
          "properties": {
            "snapshot_complete": { "const": true },
            "next_page_token": { "const": null },
            "resume_token": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        }
      ],
      "additionalProperties": false
    },
    "SessionReadTurnsResponse": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/SuccessResponseEnvelope" },
        { "type": "object", "properties": { "result": { "$ref": "#/$defs/SessionReadTurnsResult" } } }
      ]
    },
    "SessionReadTurnsErrorResponse": { "$ref": "common.schema.json#/$defs/ErrorResponseEnvelope" },
    "SessionLiveReport": {
      "type": "object",
      "properties": {
        "provider_session_id": { "type": "string", "minLength": 1 },
        "invocation_uuid": { "type": "string", "minLength": 1 }
      },
      "required": ["provider_session_id", "invocation_uuid"],
      "additionalProperties": false
    },
    "SessionCaptureRequest": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/RequestEnvelope" },
        {
          "type": "object",
          "properties": {
            "params": {
              "allOf": [
                { "$ref": "#/$defs/SessionBaseParams" },
                {
                  "type": "object",
                  "properties": {
                    "invocation_uuid": { "type": "string", "minLength": 1 },
                    "live_report": { "$ref": "#/$defs/SessionLiveReport" }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "SessionCaptureResult": {
      "type": "object",
      "properties": {
        "provider_session_id": { "type": ["string", "null"] },
        "state": { "type": ["object", "null"], "additionalProperties": true },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Artifact" }
        }
      },
      "required": ["artifacts"],
      "additionalProperties": false
    },
    "SessionCaptureResponse": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/SuccessResponseEnvelope" },
        { "type": "object", "properties": { "result": { "$ref": "#/$defs/SessionCaptureResult" } } }
      ]
    },
    "SessionCaptureErrorResponse": { "$ref": "common.schema.json#/$defs/ErrorResponseEnvelope" },
    "SessionExportRequest": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/RequestEnvelope" },
        { "type": "object", "properties": { "params": { "$ref": "#/$defs/SessionBaseParams" } } }
      ]
    },
    "SessionExportResult": {
      "type": "object",
      "properties": {
        "canonical_format": { "type": "string", "minLength": 1 },
        "data_base64": { "type": "string" },
        "turn_count": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" }
      },
      "required": ["canonical_format", "data_base64", "turn_count", "sha256"],
      "additionalProperties": false
    },
    "SessionExportResponse": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/SuccessResponseEnvelope" },
        { "type": "object", "properties": { "result": { "$ref": "#/$defs/SessionExportResult" } } }
      ]
    },
    "SessionExportErrorResponse": { "$ref": "common.schema.json#/$defs/ErrorResponseEnvelope" },
    "SessionReplaceHostStatePlan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": { "const": 1 },
            "operation": { "const": "session.replace" },
            "session_id": { "type": "string", "minLength": 1 },
            "provider_name": { "type": "string", "minLength": 1 },
            "canonical_format": { "const": "oulipoly.canonical_transcript/v1" },
            "turn_count": { "type": "integer", "minimum": 0 },
            "records_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            "postimage_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            "artifacts": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/Artifact" }
            }
          },
          "required": [
            "schema_version",
            "operation",
            "session_id",
            "provider_name",
            "canonical_format",
            "turn_count",
            "records_sha256",
            "postimage_sha256",
            "artifacts"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema_version": { "const": 2 },
            "operation": { "const": "session.replace" },
            "replace_protocol": { "const": "oulipoly.provider_owned_replace/v1" },
            "operation_id": { "type": "string", "minLength": 1 },
            "recovery_id": { "type": "string", "minLength": 1 },
            "session_id": { "type": "string", "minLength": 1 },
            "provider_name": { "type": "string", "minLength": 1 },
            "canonical_format": { "const": "oulipoly.canonical_transcript/v1" },
            "input_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            "postimage_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            "preimage_sha256_observed": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            "turn_count": { "type": "integer", "minimum": 0 },
            "db_apply": { "const": "replace_session_turns_from_canonical_v1" },
            "source_id": { "type": "string", "minLength": 1 },
            "last_turn_id": { "type": ["string", "null"] },
            "last_used_at": { "type": ["string", "null"] },
            "chain_id": { "type": "string", "minLength": 1 },
            "active_segment_id": { "type": "integer" }
          },
          "required": [
            "schema_version",
            "operation",
            "replace_protocol",
            "operation_id",
            "recovery_id",
            "session_id",
            "provider_name",
            "canonical_format",
            "input_sha256",
            "postimage_sha256",
            "preimage_sha256_observed",
            "turn_count",
            "db_apply",
            "source_id",
            "last_turn_id",
            "last_used_at"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SessionReplaceCanonicalTranscript": {
      "type": "object",
      "properties": {
        "kind": { "const": "bytes" },
        "data_base64": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "turn_count": { "type": "integer", "minimum": 0 }
      },
      "required": ["kind", "data_base64", "sha256", "turn_count"],
      "additionalProperties": false
    },
    "SessionReplaceParams": {
      "type": "object",
      "properties": {
        "settings_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "model_name": { "type": "string", "minLength": 1 },
        "provider_name": { "type": "string", "minLength": 1 },
        "replace_protocol": { "const": "oulipoly.provider_owned_replace/v1" },
        "operation_id": { "type": "string", "minLength": 1 },
        "canonical_format": { "const": "oulipoly.canonical_transcript/v1" },
        "canonical_transcript": { "$ref": "#/$defs/SessionReplaceCanonicalTranscript" },
        "preimage_sha256_expected": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "host_apply_capability": { "const": "replace_session_turns_from_canonical_v1" },
        "operation_mode": { "const": "recover" },
        "recovery_action": { "enum": ["query", "commit", "rollback"] },
        "recovery_id": { "type": "string", "minLength": 1 }
      },
      "required": [
        "settings_id",
        "session_id",
        "model_name",
        "provider_name",
        "replace_protocol",
        "operation_id",
        "canonical_format",
        "canonical_transcript",
        "host_apply_capability"
      ],
      "additionalProperties": false
    },
    "SessionReplaceArtifactEvidence": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "format_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "uri": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "turn_count": { "type": "integer", "minimum": 0 },
        "content_len": { "type": "integer", "minimum": 0 }
      },
      "required": ["role", "format_id", "sha256"],
      "additionalProperties": false
    },
    "SessionReplaceCanonicalPostimage": {
      "type": "object",
      "properties": {
        "format_id": { "const": "oulipoly.canonical_transcript/v1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "turn_count": { "type": "integer", "minimum": 0 },
        "source_id": { "type": "string", "minLength": 1 },
        "data_base64": { "type": "string" },
        "artifact": { "$ref": "#/$defs/SessionReplaceArtifactEvidence" }
      },
      "required": ["format_id", "sha256", "turn_count", "source_id"],
      "oneOf": [
        { "required": ["data_base64"], "not": { "required": ["artifact"] } },
        { "required": ["artifact"], "not": { "required": ["data_base64"] } }
      ],
      "additionalProperties": false
    },
    "SessionReplaceRequest": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/RequestEnvelope" },
        { "type": "object", "properties": { "params": { "$ref": "#/$defs/SessionReplaceParams" } } }
      ]
    },
    "SessionReplaceResult": {
      "type": "object",
      "properties": {
        "changed": { "type": "boolean" },
        "operation_id": { "type": "string", "minLength": 1 },
        "recovery_id": { "type": "string", "minLength": 1 },
        "operation_state": { "enum": ["prepared", "committed", "atomic_committed", "rolled_back", "not_found"] },
        "preimage_sha256_observed": { "type": "string" },
        "postimage_sha256": { "type": "string" },
        "canonical_postimage": { "$ref": "#/$defs/SessionReplaceCanonicalPostimage" },
        "provider_preimage_artifact": { "$ref": "#/$defs/SessionReplaceArtifactEvidence" },
        "provider_postimage_artifact": { "$ref": "#/$defs/SessionReplaceArtifactEvidence" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Artifact" }
        },
        "host_state_plan": { "$ref": "#/$defs/SessionReplaceHostStatePlan" }
      },
      "required": ["changed", "artifacts"],
      "allOf": [
        {
          "if": {
            "properties": { "changed": { "const": true } },
            "required": ["changed"]
          },
          "then": { "required": ["postimage_sha256", "host_state_plan"] }
        }
      ],
      "additionalProperties": false
    },
    "SessionReplaceResponse": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/SuccessResponseEnvelope" },
        { "type": "object", "properties": { "result": { "$ref": "#/$defs/SessionReplaceResult" } } }
      ]
    },
    "SessionReplaceErrorResponse": { "$ref": "common.schema.json#/$defs/ErrorResponseEnvelope" }
  }
}
