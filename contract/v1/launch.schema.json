{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launch.schema.json",
  "title": "Oulipoly Provider Launch Contract",
  "$comment": "intrinsic_surface_declarations:\n  - component: contract/v1/launch.schema.json\n    role: intrinsic-surface\n    Domain: oulipoly-provider-launch-contract\n    Owns:\n      - LaunchParams schema\n      - LaunchSession schema\n      - launch request, event, and result schemas\n      - common.schema.json references used by provider launch contract envelopes",
  "type": "object",
  "$defs": {
    "LaunchParams": {
      "type": "object",
      "properties": {
        "settings_id": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "model": { "$ref": "common.schema.json#/$defs/ProviderModelRequest" },
        "argv": { "type": "array", "items": { "type": "string" } },
        "working_directory": { "type": "string", "minLength": 1 },
        "env": { "$ref": "common.schema.json#/$defs/StringMap" },
        "stdin": { "$ref": "common.schema.json#/$defs/BytePayload" },
        "session": { "$ref": "#/$defs/LaunchSession" },
        "prompt_acceptance": { "$ref": "#/$defs/PromptAcceptanceRequestV1" }
      },
      "required": ["settings_id", "mode", "model", "argv", "working_directory"],
      "additionalProperties": false
    },
    "LaunchSession": {
      "type": "object",
      "description": "Host-supplied launch session intent. known_provider_session_id identifies the provider session id; start_mode=create means start a new provider session using that id, while start_mode=resume means continue an existing provider session with that id. Omit both fields when no known provider session id is supplied.",
      "properties": {
        "known_provider_session_id": { "type": "string", "minLength": 1 },
        "start_mode": { "enum": ["create", "resume"] }
      },
      "dependentRequired": {
        "known_provider_session_id": ["start_mode"],
        "start_mode": ["known_provider_session_id"]
      },
      "additionalProperties": true
    },
    "PromptAcceptanceRequestV1": {
      "type": "object",
      "description": "Host request for provider attestation after the provider submits the exact launch prompt. A provider may consume this extension only when it advertises capabilities.prompt_acceptance_v1. After exact submission it emits an oulipoly.prompt_accepted/v1 marker correlated by the launch event request_id.",
      "properties": {
        "protocol": { "const": "oulipoly.prompt_acceptance/v1" },
        "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "delivery_nonce": { "type": "string", "minLength": 1 }
      },
      "required": ["protocol", "prompt_sha256"],
      "additionalProperties": false
    },
    "PromptAcceptedMarkerValueV1": {
      "type": "object",
      "description": "Provider attestation that the exact launch prompt identified by prompt_sha256 was submitted to provider_session_id. delivery_nonce, when requested, identifies the mailbox delivery contained in that same prompt. This v1 shape is evolved by a new protocol and capability version rather than changing these semantics in place.",
      "properties": {
        "protocol": { "const": "oulipoly.prompt_acceptance/v1" },
        "provider_session_id": { "type": "string", "minLength": 1 },
        "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "delivery_nonce": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "message_id": { "type": "string" }
      },
      "required": ["protocol", "provider_session_id", "prompt_sha256"],
      "additionalProperties": false
    },
    "LaunchRequest": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/RequestEnvelope" },
        { "type": "object", "properties": { "params": { "$ref": "#/$defs/LaunchParams" } } }
      ]
    },
    "LaunchStdoutEvent": {
      "type": "object",
      "properties": {
        "contract": { "$ref": "common.schema.json#/$defs/ContractVersion" },
        "request_id": { "$ref": "common.schema.json#/$defs/RequestId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time_unix_ms": { "$ref": "common.schema.json#/$defs/UnixMilliseconds" },
        "kind": { "const": "stdout" },
        "data_base64": { "type": "string" }
      },
      "required": ["contract", "request_id", "seq", "time_unix_ms", "kind", "data_base64"],
      "additionalProperties": false
    },
    "LaunchStderrEvent": {
      "type": "object",
      "properties": {
        "contract": { "$ref": "common.schema.json#/$defs/ContractVersion" },
        "request_id": { "$ref": "common.schema.json#/$defs/RequestId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time_unix_ms": { "$ref": "common.schema.json#/$defs/UnixMilliseconds" },
        "kind": { "const": "stderr" },
        "data_base64": { "type": "string" }
      },
      "required": ["contract", "request_id", "seq", "time_unix_ms", "kind", "data_base64"],
      "additionalProperties": false
    },
    "LaunchMarkerEvent": {
      "type": "object",
      "description": "Generic launch marker. The reserved name oulipoly.prompt_accepted/v1 has the strict PromptAcceptedMarkerValueV1 shape and exact-prompt acceptance semantics; all other names retain generic marker semantics.",
      "properties": {
        "contract": { "$ref": "common.schema.json#/$defs/ContractVersion" },
        "request_id": { "$ref": "common.schema.json#/$defs/RequestId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time_unix_ms": { "$ref": "common.schema.json#/$defs/UnixMilliseconds" },
        "kind": { "const": "marker" },
        "name": { "type": "string", "minLength": 1 },
        "value": true
      },
      "required": ["contract", "request_id", "seq", "time_unix_ms", "kind", "name", "value"],
      "allOf": [
        {
          "if": {
            "properties": { "name": { "const": "oulipoly.prompt_accepted/v1" } },
            "required": ["name"]
          },
          "then": {
            "properties": { "value": { "$ref": "#/$defs/PromptAcceptedMarkerValueV1" } }
          }
        }
      ],
      "additionalProperties": false
    },
    "LaunchHeartbeatEvent": {
      "type": "object",
      "properties": {
        "contract": { "$ref": "common.schema.json#/$defs/ContractVersion" },
        "request_id": { "$ref": "common.schema.json#/$defs/RequestId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time_unix_ms": { "$ref": "common.schema.json#/$defs/UnixMilliseconds" },
        "kind": { "const": "heartbeat" },
        "detail": { "type": "string" }
      },
      "required": ["contract", "request_id", "seq", "time_unix_ms", "kind"],
      "additionalProperties": false
    },
    "LaunchExitEvent": {
      "type": "object",
      "properties": {
        "contract": { "$ref": "common.schema.json#/$defs/ContractVersion" },
        "request_id": { "$ref": "common.schema.json#/$defs/RequestId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time_unix_ms": { "$ref": "common.schema.json#/$defs/UnixMilliseconds" },
        "kind": { "const": "exit" },
        "status": { "$ref": "common.schema.json#/$defs/ProcessStatus" },
        "terminal_signal": { "$ref": "common.schema.json#/$defs/TerminalSignal" },
        "session": { "type": "object", "additionalProperties": true }
      },
      "required": [
        "contract",
        "request_id",
        "seq",
        "time_unix_ms",
        "kind",
        "status",
        "terminal_signal"
      ],
      "additionalProperties": false
    }
  }
}
