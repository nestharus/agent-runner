{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "describe.schema.json",
  "title": "Oulipoly Provider Describe Contract",
  "type": "object",
  "$defs": {
    "DescribeParams": {
      "type": "object",
      "additionalProperties": false
    },
    "DescribeRequest": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/RequestEnvelope" },
        {
          "type": "object",
          "properties": {
            "params": { "$ref": "#/$defs/DescribeParams" }
          }
        }
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "launch": { "type": "boolean" },
        "prompt_acceptance_v1": {
          "type": "boolean",
          "description": "Advertises support for the oulipoly.prompt_acceptance/v1 launch extension and oulipoly.prompt_accepted/v1 attestation marker. A provider must omit this property unless the describe request selected it with host.env.OULIPOLY_HOST_PROMPT_ACCEPTANCE_V1=1. Omitted or false means the host must not trust prompt-acceptance markers from this provider."
        },
        "launch_output_v1": {
          "type": "boolean",
          "description": "Advertises complete, duration-independent oulipoly.launch_output/v1 custody. A provider must omit this property unless selected with host.env.OULIPOLY_HOST_LAUNCH_OUTPUT_V1=1."
        },
        "policy": { "type": "boolean" },
        "quota": { "type": "boolean" },
        "session": { "type": "boolean" },
        "session_turn_pages_v1": {
          "type": "boolean",
          "description": "Advertises bounded oulipoly.session_turn_pages/v1 support for session.read_turns. A provider must omit this property unless selected with host.env.OULIPOLY_HOST_SESSION_TURN_PAGES_V1=1."
        },
        "session_enumerate": { "type": "boolean" },
        "terminal": { "type": "boolean" },
        "rotation": { "type": "boolean" },
        "discovery": { "type": "boolean" },
        "settings": { "type": "boolean" },
        "setup_brain": { "type": "boolean" },
        "setup": { "type": "boolean" },
        "migration": { "type": "boolean" }
      },
      "required": [
        "launch",
        "policy",
        "quota",
        "session",
        "terminal",
        "rotation",
        "discovery",
        "settings",
        "setup_brain",
        "setup",
        "migration"
      ],
      "additionalProperties": false
    },
    "DescribeResult": {
      "type": "object",
      "properties": {
        "provider_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "contract_versions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/ContractVersion" },
          "minItems": 1
        },
        "preferred_contract": { "$ref": "common.schema.json#/$defs/ContractVersion" },
        "capabilities": { "$ref": "#/$defs/Capabilities" },
        "settings_schema_id": { "type": "string" },
        "concurrency": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "provider_id",
        "display_name",
        "contract_versions",
        "preferred_contract",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "DescribeResponse": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/SuccessResponseEnvelope" },
        {
          "type": "object",
          "properties": {
            "result": { "$ref": "#/$defs/DescribeResult" }
          }
        }
      ]
    },
    "DescribeErrorResponse": {
      "$ref": "common.schema.json#/$defs/ErrorResponseEnvelope"
    }
  }
}
