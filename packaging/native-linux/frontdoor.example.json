{
 "v": 1,
 "allowed_users": [
  "nes"
 ],
 "run_base": "/var/lib/oulipoly-native/runs",
 "max_deadline_s": 7200,
 "cancel_grace_s": 30,
 "allow_keep": false,
 "default_path": "/usr/local/bin:/usr/bin:/bin",
 "routes": {
  "parent": {
   "harness": "provider",
   "executable": "/opt/oulipoly-providers/example/bin/provider",
   "settings": {
    "settings_id": "example",
    "mode": "arg",
    "model": {
     "name": "example-model",
     "provider_args": [],
     "inputs": {
      "prompt": null,
      "named": {}
     }
    },
    "launch": {}
   },
   "children": [
    "explorer"
   ]
  }
 },
 "child_limits": {
  "max_starts": 4,
  "max_concurrent": 2
 },
 "child_routes": {
  "explorer": {
   "harness": "provider",
   "executable": "/opt/oulipoly-providers/example/bin/provider",
   "settings": {
    "settings_id": "example",
    "mode": "arg",
    "model": {
     "name": "example-model",
     "provider_args": [],
     "inputs": {
      "prompt": null,
      "named": {}
     }
    },
    "launch": {}
   }
  }
 }
}
