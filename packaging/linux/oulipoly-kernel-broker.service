# Paired source artifact only. Requires a root-owned manifest, exact Runner
# and broker images, and an oulipoly group. The service owns only the broker;
# do not enable before a complete CLI/GUI/helper custody cutover exists.
[Unit]
Description=Oulipoly host PID namespace broker
After=local-fs.target

[Service]
Type=simple
User=root
Group=oulipoly
ExecStart=/usr/local/libexec/oulipoly/oulipoly-kernel-broker
RuntimeDirectory=oulipoly-kernel-broker
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
StateDirectory=oulipoly-kernel-broker
StateDirectoryMode=0700
Restart=on-failure
KillMode=process
Delegate=yes
NoNewPrivileges=no
# AGE-380: sized for 1056 producers with headroom; descendants inherit this.
# See README.md, Broker descriptor capacity, for sizing and effective readback.
LimitNOFILE=65536:1048576

[Install]
WantedBy=multi-user.target
