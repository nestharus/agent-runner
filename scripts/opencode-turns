#!/usr/bin/env python3
"""
Reference adapter: emit OpenCode exported sessions as normalized JSONL.

Usage: opencode-turns BASE_DIR [SESSION_ID ...]
   e.g. opencode-turns ~/.local/share/opencode ses_abc123

Session IDs and message content are read through the public OpenCode CLI:
  opencode session list --json
  opencode export <sessionID>

When SESSION_ID arguments are supplied, they are used directly. BASE_DIR is
accepted for compatibility with existing session source configuration; implicit
discovery uses `opencode session list --json`, not OpenCode's private storage
layout.

Implicit discovery is bounded to the recent quota-balancing window. If the
session list does not expose timestamps, the adapter falls back to a small cap
of most-recent CLI-listed sessions.

Emits one JSON object per line on stdout:
  {"session_id":"ses_...","turn_id":"msg_...","timestamp":"<rfc3339>","role":"user|assistant","body":[{"type":"text","text":"..."}]}

If an OpenCode CLI call times out, the adapter emits every turn collected so far
and then appends:
  {"degraded":true,"count":<assistant-turns-collected>}
The process still exits 0 so a partial turn count never hangs provider
selection.
"""

import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from typing import Any


MESSAGE_LIST_KEYS = ("messages", "turns", "items", "entries")
SESSION_ID_RE = re.compile(r"\bses_[A-Za-z0-9_-]+\b")
SESSION_ID_KEYS = ("sessionID", "sessionId", "session_id", "id")
SESSION_TIMESTAMP_KEYS = (
    "updatedAt",
    "updated_at",
    "updated",
    "createdAt",
    "created_at",
    "created",
    "timestamp",
    "time",
)

DEFAULT_WINDOW_HOURS = 6.0
DEFAULT_MAX_SESSIONS = 25
DEFAULT_CALL_TIMEOUT_SECS = 20.0
DEFAULT_DEADLINE_SECS = 60.0


class Options:
    def __init__(self) -> None:
        self.window_hours = env_float("OPENCODE_TURNS_WINDOW_HOURS", DEFAULT_WINDOW_HOURS)
        self.max_sessions = env_int("OPENCODE_TURNS_MAX_SESSIONS", DEFAULT_MAX_SESSIONS)
        self.call_timeout = env_float("OPENCODE_TURNS_CALL_TIMEOUT", DEFAULT_CALL_TIMEOUT_SECS)
        self.deadline = env_float("OPENCODE_TURNS_DEADLINE", DEFAULT_DEADLINE_SECS)


class Deadline:
    def __init__(self, seconds: float) -> None:
        self.started_at = time.monotonic()
        self.seconds = seconds

    def remaining(self) -> float:
        return max(0.0, self.seconds - (time.monotonic() - self.started_at))

    def call_timeout(self, max_call_timeout: float) -> float:
        remaining = self.remaining()
        if remaining <= 0:
            return 0.0
        return min(max_call_timeout, remaining)


def env_float(name: str, default: float) -> float:
    value = os.environ.get(name)
    if value is None:
        return default
    try:
        parsed = float(value)
    except ValueError:
        return default
    return parsed if parsed > 0 else default


def env_int(name: str, default: int) -> int:
    value = os.environ.get(name)
    if value is None:
        return default
    try:
        parsed = int(value)
    except ValueError:
        return default
    return parsed if parsed > 0 else default


def text_chunk(text: str) -> dict:
    return {"type": "text", "text": text}


def canonical_chunk_type(native_type) -> str:
    if not isinstance(native_type, str):
        return "text"
    if native_type in ("input_text", "output_text", "markdown"):
        return "text"
    return native_type


def extract_content_chunks(value) -> list:
    if isinstance(value, str):
        return [text_chunk(value)]
    if isinstance(value, list):
        chunks = []
        for item in value:
            chunks.extend(extract_content_chunks(item))
        return chunks
    if isinstance(value, dict):
        text = value.get("text")
        if text is None:
            text = value.get("content")
        if isinstance(text, str):
            native_type = value.get("type") or "text"
            return [{"type": canonical_chunk_type(native_type), "text": text}]
        for key in ("parts", "content", "message"):
            chunks = extract_content_chunks(value.get(key))
            if chunks:
                return chunks
    return []


def unique_values(values: list[str]) -> list[str]:
    seen = set()
    unique = []
    for value in values:
        if value and value not in seen:
            seen.add(value)
            unique.append(value)
    return unique


def session_ids_from_value(value: Any) -> list[str]:
    if isinstance(value, str):
        return SESSION_ID_RE.findall(value)
    if isinstance(value, list):
        session_ids = []
        for item in value:
            session_ids.extend(session_ids_from_value(item))
        return session_ids
    if isinstance(value, dict):
        session_ids = []
        for item in value.values():
            session_ids.extend(session_ids_from_value(item))
        return session_ids
    return []


def parse_session_list_stdout(stdout: str, options: Options) -> list[str]:
    try:
        parsed = json.loads(stdout)
    except json.JSONDecodeError:
        return unique_values(session_ids_from_value(stdout))[: options.max_sessions]

    candidates = unique_session_candidates(session_candidates_from_value(parsed))
    if not candidates:
        return unique_values(session_ids_from_value(parsed))[: options.max_sessions]

    if any(candidate.get("timestamp") is not None for candidate in candidates):
        cutoff = datetime.now(timezone.utc) - timedelta(hours=options.window_hours)
        return [
            candidate["session_id"]
            for candidate in candidates
            if candidate.get("timestamp") is not None and candidate["timestamp"] >= cutoff
        ]

    return [candidate["session_id"] for candidate in candidates][: options.max_sessions]


def unique_session_candidates(candidates: list[dict]) -> list[dict]:
    seen = set()
    unique = []
    for candidate in candidates:
        session_id = candidate.get("session_id")
        if not session_id or session_id in seen:
            continue
        seen.add(session_id)
        unique.append(candidate)
    return unique


def session_candidates_from_value(value: Any) -> list[dict]:
    if isinstance(value, list):
        candidates = []
        for item in value:
            candidates.extend(session_candidates_from_value(item))
        return candidates
    if isinstance(value, dict):
        session_id = session_list_session_id(value)
        if session_id:
            return [
                {
                    "session_id": session_id,
                    "timestamp": session_list_timestamp(value),
                }
            ]
        candidates = []
        for item in value.values():
            candidates.extend(session_candidates_from_value(item))
        return candidates
    return []


def session_list_session_id(obj: dict) -> str | None:
    for key in SESSION_ID_KEYS:
        value = obj.get(key)
        if not isinstance(value, str):
            continue
        match = SESSION_ID_RE.search(value)
        if match:
            return match.group(0)
    return None


def session_list_timestamp(obj: dict) -> datetime | None:
    for key in SESSION_TIMESTAMP_KEYS:
        converted = timestamp_datetime(obj.get(key))
        if converted:
            return converted
    return None


def timestamp_datetime(value) -> datetime | None:
    if isinstance(value, (int, float)):
        return numeric_timestamp_datetime(value)
    if not isinstance(value, str) or not value.strip():
        return None
    stripped = value.strip()
    if re.fullmatch(r"\d+(\.\d+)?", stripped):
        return numeric_timestamp_datetime(float(stripped))
    normalized = stripped.replace("Z", "+00:00")
    try:
        parsed = datetime.fromisoformat(normalized)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def numeric_timestamp_datetime(value: int | float) -> datetime | None:
    seconds = value / 1000 if value > 10_000_000_000 else value
    try:
        return datetime.fromtimestamp(seconds, tz=timezone.utc)
    except (OverflowError, OSError, ValueError):
        return None


def discover_session_ids(options: Options, deadline: Deadline) -> tuple[list[str], bool]:
    stdout, timed_out = run_opencode(["session", "list", "--json"], options, deadline)
    if timed_out:
        return [], True
    if stdout is None:
        return [], False
    return parse_session_list_stdout(stdout, options), False


def requested_session_ids(
    args: list[str], options: Options, deadline: Deadline
) -> tuple[list[str], bool]:
    if args:
        return unique_values(args), False
    return discover_session_ids(options, deadline)


def numeric_timestamp(value) -> str | None:
    if not isinstance(value, (int, float)):
        return None
    seconds = value / 1000 if value > 10_000_000_000 else value
    return datetime.fromtimestamp(seconds, tz=timezone.utc).isoformat().replace("+00:00", "Z")


def timestamp_from_obj(obj: dict) -> str | None:
    for key in ("timestamp", "createdAt", "created_at", "time"):
        value = obj.get(key)
        if isinstance(value, str) and value:
            return value
        converted = numeric_timestamp(value)
        if converted:
            return converted
    return None


def session_id_from_obj(obj: dict) -> str | None:
    for key in ("sessionID", "sessionId", "session_id"):
        value = obj.get(key)
        if isinstance(value, str) and value:
            return value
    return None


def role_from_obj(obj: dict) -> str | None:
    value = obj.get("role")
    if value in ("user", "assistant"):
        return value
    message = obj.get("message")
    if isinstance(message, dict) and message.get("role") in ("user", "assistant"):
        return message.get("role")
    return None


def turn_id_from_obj(obj: dict, default_session_id: str, index: int) -> str:
    for key in ("id", "messageID", "messageId", "message_id"):
        value = obj.get(key)
        if isinstance(value, str) and value:
            return value
    message = obj.get("message")
    if isinstance(message, dict):
        for key in ("id", "messageID", "messageId", "message_id"):
            value = message.get(key)
            if isinstance(value, str) and value:
                return value
    return f"{default_session_id}:{index}"


def opencode_command() -> list[str]:
    configured = os.environ.get("OPENCODE_BIN", "opencode")
    return shlex.split(configured) or ["opencode"]


def run_opencode(
    args: list[str], options: Options, deadline: Deadline
) -> tuple[str | None, bool]:
    timeout = deadline.call_timeout(options.call_timeout)
    if timeout <= 0:
        return None, True
    try:
        process = subprocess.Popen(
            opencode_command() + args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL,
            text=True,
            start_new_session=True,
        )
    except OSError:
        return None, False

    try:
        stdout, _stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        kill_process_group(process)
        return None, True

    if process.returncode != 0:
        return None, False
    return stdout, False


def kill_process_group(process: subprocess.Popen) -> None:
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except (OSError, ProcessLookupError):
        try:
            process.kill()
        except OSError:
            pass
    try:
        process.communicate(timeout=1)
    except subprocess.TimeoutExpired:
        try:
            process.kill()
        except OSError:
            pass
        process.communicate()


def parse_export_stdout(stdout: str) -> Any | None:
    try:
        return json.loads(stdout)
    except json.JSONDecodeError:
        return None


def export_session(
    session_id: str, options: Options, deadline: Deadline
) -> tuple[Any | None, bool]:
    stdout, timed_out = run_opencode(["export", session_id], options, deadline)
    if timed_out:
        return None, True
    if stdout is None:
        return None, False
    return parse_export_stdout(stdout), False


def exported_message_items(exported: Any) -> list[dict]:
    if isinstance(exported, list):
        return [item for item in exported if isinstance(item, dict)]
    if not isinstance(exported, dict):
        return []
    for key in MESSAGE_LIST_KEYS:
        value = exported.get(key)
        if isinstance(value, list):
            return [item for item in value if isinstance(item, dict)]
    if role_from_obj(exported):
        return [exported]
    return []


def record_from_message(default_session_id: str, index: int, obj: dict) -> dict | None:
    session_id = session_id_from_obj(obj) or default_session_id
    role = role_from_obj(obj)
    timestamp = timestamp_from_obj(obj)
    if not session_id or not role or not timestamp:
        return None
    record = {
        "session_id": session_id,
        "turn_id": turn_id_from_obj(obj, default_session_id, index),
        "timestamp": timestamp,
        "role": role,
    }
    body = extract_content_chunks(obj.get("parts")) or extract_content_chunks(
        obj.get("content")
    ) or extract_content_chunks(obj.get("message"))
    if body:
        record["body"] = body
    return record


def records_from_exported_session(session_id: str, exported: Any) -> list[dict]:
    records = []
    for index, obj in enumerate(exported_message_items(exported), start=1):
        record = record_from_message(session_id, index, obj)
        if record:
            records.append(record)
    return records


def collect_records(
    session_ids: list[str], options: Options, deadline: Deadline
) -> tuple[list[dict], bool]:
    records = []
    degraded = False
    for session_id in session_ids:
        exported, timed_out = export_session(session_id, options, deadline)
        if timed_out:
            degraded = True
            break
        if exported is None:
            continue
        records.extend(records_from_exported_session(session_id, exported))
    return records, degraded


def emit_record(record: dict, out) -> None:
    out.write(json.dumps(record, separators=(",", ":")))
    out.write("\n")


def emit_degraded_marker(records: list[dict], out) -> None:
    count = sum(1 for record in records if record.get("role") == "assistant")
    emit_record({"degraded": True, "count": count}, out)


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: opencode-turns BASE_DIR [SESSION_ID ...]", file=sys.stderr)
        return 2
    _base_dir = sys.argv[1]
    options = Options()
    deadline = Deadline(options.deadline)
    out = sys.stdout

    session_ids, discovery_degraded = requested_session_ids(sys.argv[2:], options, deadline)
    records, export_degraded = collect_records(session_ids, options, deadline)
    for record in records:
        emit_record(record, out)
    if discovery_degraded or export_degraded:
        emit_degraded_marker(records, out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
