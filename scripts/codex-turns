#!/usr/bin/env python3
"""
Reference adapter: emit Codex CLI session turns as normalized JSONL.

Usage: codex-turns BASE_DIR

Codex's per-session JSONL has a `session_meta` line carrying the session id,
and subsequent `response_item` lines whose `payload.type == "message"` are
turns. `payload.id` is null in current Codex versions, so we synthesize a
stable turn_id from `<file>:<line_no>`.

The runner sets STATE_DIR for incremental cursor bookkeeping. We track the
highest mtime emitted; subsequent runs skip files unchanged since.
"""

import json
import os
import sys
from pathlib import Path


def canonical_chunk_type(native_type) -> str:
    if not isinstance(native_type, str):
        return "text"
    if native_type in ("input_text", "output_text"):
        return "text"
    return native_type


def text_chunk(text: str) -> dict:
    return {"type": "text", "text": text}


def extract_content_chunks(value) -> list:
    if isinstance(value, str):
        return [text_chunk(value)]
    if isinstance(value, list):
        chunks = []
        for item in value:
            if isinstance(item, str):
                chunks.append(text_chunk(item))
            elif isinstance(item, dict):
                text = item.get("text")
                if text is None:
                    text = item.get("content")
                if isinstance(text, str):
                    native_type = item.get("type") or "text"
                    chunks.append(
                        {
                            "type": canonical_chunk_type(native_type),
                            "text": text,
                        }
                    )
        return chunks
    if isinstance(value, dict):
        text = value.get("text")
        if text is None:
            text = value.get("content")
        if isinstance(text, str):
            native_type = value.get("type") or "text"
            return [{"type": canonical_chunk_type(native_type), "text": text}]
    return []


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: codex-turns BASE_DIR", file=sys.stderr)
        return 2
    base = Path(sys.argv[1]).expanduser()
    state_dir = Path(os.environ.get("STATE_DIR", "/tmp/codex-turns-state"))
    state_dir.mkdir(parents=True, exist_ok=True)
    cursor_file = state_dir / "last_mtime"

    last_mtime = 0
    if cursor_file.exists():
        try:
            last_mtime = int(cursor_file.read_text().strip())
        except ValueError:
            last_mtime = 0

    new_max = last_mtime
    out = sys.stdout

    for path in base.rglob("rollout-*.jsonl"):
        try:
            mtime = int(path.stat().st_mtime)
        except OSError:
            continue
        if mtime <= last_mtime:
            continue
        if mtime > new_max:
            new_max = mtime
        emit_file(path, out)

    cursor_file.write_text(str(new_max))
    return 0


def emit_file(path: Path, out) -> None:
    sid = None
    try:
        with path.open("r", encoding="utf-8") as fh:
            for line_no, raw in enumerate(fh, start=1):
                line = raw.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                kind = obj.get("type")
                if kind == "session_meta":
                    sid = (obj.get("payload") or {}).get("id")
                elif kind == "response_item" and sid:
                    payload = obj.get("payload") or {}
                    if payload.get("type") != "message":
                        continue
                    role = payload.get("role")
                    if role not in ("user", "assistant"):
                        continue
                    ts = obj.get("timestamp")
                    if not ts:
                        continue
                    record = {
                        "session_id": sid,
                        "turn_id": f"{path}:{line_no}",
                        "timestamp": ts,
                        "role": role,
                    }
                    body = extract_content_chunks(payload.get("content"))
                    if body:
                        record["body"] = body
                    out.write(json.dumps(record))
                    out.write("\n")
    except OSError:
        return


if __name__ == "__main__":
    sys.exit(main())
