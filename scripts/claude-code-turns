#!/usr/bin/env python3
"""
Reference adapter: emit Claude Code session turns as normalized JSONL
for oulipoly-agent-runner's session ingester.

Usage: claude-code-turns BASE_DIR
   e.g. claude-code-turns ~/.claude/projects

The runner sets STATE_DIR to a writable dir for incremental bookkeeping.
We track the highest mtime emitted; subsequent runs skip files unchanged
since.

Emits one JSON object per line on stdout:
  {"session_id":"<sid>","turn_id":"<uuid>","timestamp":"<rfc3339>","role":"user|assistant","parent_turn_id":"<uuid|null>","is_sidechain":true|false|null,"is_compaction_boundary":true|false,"body":[{"type":"text","text":"..."}]}
  body is optional and is emitted only when extractable chunks exist.
"""

import json
import os
import sys
from pathlib import Path


def canonical_chunk_type(native_type) -> str:
    if not isinstance(native_type, str):
        return "text"
    if native_type in ("input_text", "output_text"):
        return "text"
    return native_type


def text_chunk(text: str) -> dict:
    return {"type": "text", "text": text}


def extract_content_chunks(value) -> list:
    if isinstance(value, str):
        return [text_chunk(value)]
    if isinstance(value, list):
        chunks = []
        for item in value:
            if isinstance(item, str):
                chunks.append(text_chunk(item))
            elif isinstance(item, dict):
                text = item.get("text")
                if text is None:
                    text = item.get("content")
                if isinstance(text, str):
                    native_type = item.get("type") or "text"
                    chunks.append(
                        {
                            "type": canonical_chunk_type(native_type),
                            "text": text,
                        }
                    )
        return chunks
    if isinstance(value, dict):
        text = value.get("text")
        if text is None:
            text = value.get("content")
        if isinstance(text, str):
            native_type = value.get("type") or "text"
            return [{"type": canonical_chunk_type(native_type), "text": text}]
    return []


def extract_claude_body(obj: dict) -> list:
    message = obj.get("message")
    if isinstance(message, str):
        return [text_chunk(message)]
    if isinstance(message, dict) and "content" in message:
        return extract_content_chunks(message.get("content"))
    return extract_content_chunks(obj.get("content"))


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: claude-code-turns BASE_DIR", file=sys.stderr)
        return 2
    base = Path(sys.argv[1]).expanduser()
    state_dir = Path(os.environ.get("STATE_DIR", "/tmp/claude-code-turns-state"))
    state_dir.mkdir(parents=True, exist_ok=True)
    cursor_file = state_dir / "last_mtime"

    last_mtime = 0
    if cursor_file.exists():
        try:
            last_mtime = int(cursor_file.read_text().strip())
        except ValueError:
            last_mtime = 0

    new_max = last_mtime
    out = sys.stdout

    for path in base.rglob("*.jsonl"):
        try:
            mtime = int(path.stat().st_mtime)
        except OSError:
            continue
        if mtime <= last_mtime:
            continue
        if mtime > new_max:
            new_max = mtime
        emit_file(path, out)

    cursor_file.write_text(str(new_max))
    return 0


def emit_file(path: Path, out) -> None:
    try:
        with path.open("r", encoding="utf-8") as fh:
            for raw in fh:
                line = raw.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                kind = obj.get("type")
                is_compaction_boundary = obj.get("isCompactSummary") is True
                if kind not in ("user", "assistant") and not is_compaction_boundary:
                    continue
                uuid = obj.get("uuid")
                ts = obj.get("timestamp")
                sid = obj.get("sessionId")
                if not (uuid and ts and sid):
                    continue
                record = {
                    "session_id": sid,
                    "turn_id": uuid,
                    "timestamp": ts,
                    "role": kind,
                    "parent_turn_id": obj.get("parentUuid"),
                    "is_sidechain": obj.get("isSidechain"),
                    "is_compaction_boundary": is_compaction_boundary,
                }
                body = extract_claude_body(obj)
                if body:
                    record["body"] = body
                out.write(json.dumps(record))
                out.write("\n")
    except OSError:
        return


if __name__ == "__main__":
    sys.exit(main())
