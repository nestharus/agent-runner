    {
      "id": "assess-capability-missing",
      "mode": "describe-rotation-disabled",
      "describe": {
        "provider_id": "fake-provider",
        "capabilities": { "rotation": false, "migration": true }
      }
    },
    {
      "id": "assess-transport-failure",
      "mode": "exit-nonzero-no-envelope",
      "transport": { "exit_code": 7 }
    }
