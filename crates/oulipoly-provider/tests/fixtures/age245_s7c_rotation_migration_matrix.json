          "source": { "provider": "source-provider", "settings_id": "source-settings", "provider_session_id": "session-source" },
          "target": { "provider": "target-provider", "settings_id": "target-settings" },
          "session": { "chain_id": "chain-alpha", "workspace": "/tmp/project-alpha" },
          "reason": "quota_exhausted"
        }
      },
      "response": {
        "contract": "oulipoly.provider/v1",
        "request_id": "request-example-001",
        "ok": true,
        "result": { "allowed": true, "score": 80, "reason": "target-provider accepted", "requirements": [] }
      }
    },
    {
      "id": "assess-denied",
      "mode": "s7c-rotation-assess-denied",
      "response": {
        "contract": "oulipoly.provider/v1",
        "request_id": "request-example-001",
        "ok": true,
        "result": { "allowed": false, "score": 0, "reason": "target-provider denied", "requirements": [{ "kind": "quota" }] }
      }
    },
    {
      "id": "assess-provider-error",
