# DO NOT add tokens or any secrets to this file. This file is committed to
# the repo to share the pnpm layout convention across worktrees and CI.
# Personal/auth tokens go in ~/.npmrc, not here.

# Use the npm-compatible flat node_modules layout instead of pnpm's strict
# layout. Required because Tauri/Vite tooling and a number of indirect
# devDependencies assume hoisted access. Revisit if/when we audit the
# affected packages.
node-linker=hoisted
