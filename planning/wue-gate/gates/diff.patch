+fn caller_chain(identity: &ProcessIdentity) -> Value {
+    json!({
+        "caller_chain": [{
+            "pid": identity.os_pid,
+            "starttime_ticks": identity.os_pid_starttime_ticks,
+            "boot_id": identity.os_boot_id,
+        }]
+    })
+}
