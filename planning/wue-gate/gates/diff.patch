+    Ok(liveness == SessionLiveness::Busy)
+}
+
+#[cfg(unix)]
+fn unlink_stale_pty_socket(path: Option<&str>) {
+    if let Some(path) = path {
+        let _ = pty_broker::unlink_control_socket_if_owned(path);
+    }
 }
 
+#[cfg(not(unix))]
+fn unlink_stale_pty_socket(_path: Option<&str>) {}
