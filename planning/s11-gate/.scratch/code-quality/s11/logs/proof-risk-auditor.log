{"type":"tool_use","timestamp":1780782397646,"sessionID":"ses_1611a223effeVm9QJZLOjnSHiy","part":{"type":"tool","tool":"read","callID":"call_bwkto9hMPS5rodPXEbSOrJmR","state":{"status":"completed","input":{"filePath":"/tmp/s11-gate-worktree-head/src-tauri/tests/s11_external_provider_wake.rs","offset":1,"limit":520},"output":"<path>/tmp/s11-gate-worktree-head/src-tauri/tests/s11_external_provider_wake.rs</path>\n<type>file</type>\n<content>\n1: #![cfg(unix)]\n2: \n3: use oulipoly_state::mailbox::MailboxDb;\n4: use rusqlite::{Connection, params};\n5: use serde_json::Value;\n6: use std::fs;\n7: use std::os::unix::fs::PermissionsExt;\n8: use std::path::{Path, PathBuf};\n9: use std::process::{Command, Output};\n10: use std::time::{Duration, Instant};\n11: \n12: const MODEL: &str = \"s11-external-wake-model\";\n13: const PROVIDER: &str = \"opencode\";\n14: const SESSION: &str = \"ses_s11externalwake\";\n15: const HANDLE: &str = \"h-s11-external\";\n16: \n17: struct Fixture {\n18:     dir: tempfile::TempDir,\n19:     config_home: PathBuf,\n20:     data_home: PathBuf,\n21:     home_dir: PathBuf,\n22:     app_config_dir: PathBuf,\n23:     models_dir: PathBuf,\n24:     work_dir: PathBuf,\n25: }\n26: \n27: impl Fixture {\n28:     fn new() -> Self {\n29:         let dir = tempfile::tempdir().unwrap();\n30:         let config_home = dir.path().join(\"xdg-config\");\n31:         let data_home = dir.path().join(\"xdg-data\");\n32:         let home_dir = dir.path().join(\"home\");\n33:         let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n34:         let models_dir = app_config_dir.join(\"models\");\n35:         let work_dir = dir.path().join(\"work\");\n36:         fs::create_dir_all(&models_dir).unwrap();\n37:         fs::create_dir_all(&home_dir).unwrap();\n38:         fs::create_dir_all(&work_dir).unwrap();\n39:         Self {\n40:             dir,\n41:             config_home,\n42:             data_home,\n43:             home_dir,\n44:             app_config_dir,\n45:             models_dir,\n46:             work_dir,\n47:         }\n48:     }\n49: \n50:     fn sidecar_path(&self) -> PathBuf {\n51:         self.data_home\n52:             .join(\"oulipoly-agent-runner\")\n53:             .join(\"pid-identity.db\")\n54:     }\n55: \n56:     fn state_path(&self) -> PathBuf {\n57:         self.data_home\n58:             .join(\"oulipoly-agent-runner\")\n59:             .join(\"state.db\")\n60:     }\n61: \n62:     fn run(&self, mut cmd: Command) -> Output {\n63:         cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n64:             .env(\"XDG_DATA_HOME\", &self.data_home)\n65:             .env(\"HOME\", &self.home_dir)\n66:             .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n67:             .env(\"S11_WORK_DIR\", &self.work_dir)\n68:             .env_remove(\"OULIPOLY_DATA_DIR\")\n69:             .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n70:             .current_dir(self.dir.path());\n71:         cmd.output().unwrap()\n72:     }\n73: \n74:     fn run_agent(&self, prompt: &str) -> Output {\n75:         self.run_agent_with_env(prompt, &[])\n76:     }\n77: \n78:     fn run_agent_with_env(&self, prompt: &str, envs: &[(&str, &str)]) -> Output {\n79:         let mut cmd = Command::new(runner_bin());\n80:         for (key, value) in envs {\n81:             cmd.env(key, value);\n82:         }\n83:         cmd.arg(\"-m\")\n84:             .arg(MODEL)\n85:             .arg(\"--models-dir\")\n86:             .arg(&self.models_dir)\n87:             .arg(prompt);\n88:         self.run(cmd)\n89:     }\n90: \n91:     fn write_external_provider(&self) {\n92:         let provider_path = self.write_external_provider_script();\n93:         let turn_script_path = self.write_turn_script();\n94:         fs::write(\n95:             self.models_dir.join(format!(\"{MODEL}.toml\")),\n96:             format!(\n97:                 r#\"provider = {{ path = {} }}\n98: prompt_mode = \"arg\"\n99: \n100: [[providers]]\n101: name = \"{PROVIDER}\"\n102: args = []\n103: \"#,\n104:                 toml_string(&path_string(&provider_path))\n105:             ),\n106:         )\n107:         .unwrap();\n108:         fs::write(\n109:             self.app_config_dir.join(\"providers.toml\"),\n110:             format!(\n111:                 r#\"[{PROVIDER}]\n112: command = \"fixture-opencode\"\n113: args = []\n114: prompt_mode = \"arg\"\n115: \"#\n116:             ),\n117:         )\n118:         .unwrap();\n119:         fs::write(\n120:             self.app_config_dir.join(\"sessions.toml\"),\n121:             format!(\n122:                 r#\"[{PROVIDER}]\n123: turn_script = {}\n124: \"#,\n125:                 toml_string(&path_string(&turn_script_path))\n126:             ),\n127:         )\n128:         .unwrap();\n129:     }\n130: \n131:     fn write_external_provider_script(&self) -> PathBuf {\n132:         let path = self.dir.path().join(\"external-provider.py\");\n133:         fs::write(&path, external_provider_script()).unwrap();\n134:         let mut perms = fs::metadata(&path).unwrap().permissions();\n135:         perms.set_mode(0o755);\n136:         fs::set_permissions(&path, perms).unwrap();\n137:         path\n138:     }\n139: \n140:     fn write_turn_script(&self) -> PathBuf {\n141:         let path = self.dir.path().join(\"s11-turns.py\");\n142:         fs::write(&path, turn_script()).unwrap();\n143:         let mut perms = fs::metadata(&path).unwrap().permissions();\n144:         perms.set_mode(0o755);\n145:         fs::set_permissions(&path, perms).unwrap();\n146:         path\n147:     }\n148: \n149:     fn mailbox(&self) -> MailboxDb {\n150:         MailboxDb::open(&self.sidecar_path()).unwrap()\n151:     }\n152: \n153:     fn sidecar_conn(&self) -> Connection {\n154:         Connection::open(self.sidecar_path()).unwrap()\n155:     }\n156: \n157:     fn finalized_invocation_count(&self) -> i64 {\n158:         Connection::open(self.state_path())\n159:             .unwrap()\n160:             .query_row(\n161:                 \"SELECT COUNT(*) FROM invocations WHERE finished_at IS NOT NULL\",\n162:                 [],\n163:                 |row| row.get(0),\n164:             )\n165:             .unwrap()\n166:     }\n167: \n168:     fn pid_identity_session_id_for_provider(&self, provider_name: &str) -> Option<String> {\n169:         self.sidecar_conn()\n170:             .query_row(\n171:                 \"SELECT session_id\n172:                  FROM pid_identity\n173:                  WHERE provider_name = ?1\n174:                  ORDER BY recorded_at DESC, os_pid DESC\n175:                  LIMIT 1\",\n176:                 params![provider_name],\n177:                 |row| row.get(0),\n178:             )\n179:             .ok()\n180:     }\n181: \n182:     fn prompt_file(&self, name: &str) -> PathBuf {\n183:         self.work_dir.join(name)\n184:     }\n185: \n186:     fn assert_xdg_isolated(&self) {\n187:         assert!(\n188:             !self\n189:                 .home_dir\n190:                 .join(\".local/share/oulipoly-agent-runner\")\n191:                 .exists(),\n192:             \"state must stay in isolated XDG_DATA_HOME\"\n193:         );\n194:         assert!(\n195:             !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n196:             \"config must stay in isolated XDG_CONFIG_HOME\"\n197:         );\n198:     }\n199: }\n200: \n201: #[test]\n202: fn external_provider_launch_notify_uses_captured_sidecar_owner_and_wakes() {\n203:     let fixture = Fixture::new();\n204:     fixture.write_external_provider();\n205: \n206:     let output = fixture.run_agent(\"dispatch external provider wake\");\n207:     assert_success(&output);\n208: \n209:     wait_until(\"pid identity backfilled with captured session\", || {\n210:         fixture\n211:             .pid_identity_session_id_for_provider(PROVIDER)\n212:             .as_deref()\n213:             == Some(SESSION)\n214:     });\n215:     let (notify_json, notify) =\n216:         wait_for_json_file(&fixture.work_dir.join(HANDLE).join(\"notify.json\"));\n217:     let (_, notify_env) =\n218:         wait_for_json_file(&fixture.work_dir.join(HANDLE).join(\"notify-env.json\"));\n219:     assert_eq!(\n220:         notify_env.get(\"xdg_config_home\").and_then(Value::as_str),\n221:         None\n222:     );\n223:     assert_eq!(\n224:         notify_env.get(\"xdg_data_home\").and_then(Value::as_str),\n225:         None\n226:     );\n227:     assert_eq!(\n228:         notify_env.get(\"oulipoly_data_dir\").and_then(Value::as_str),\n229:         Some(path_string(&fixture.data_home.join(\"oulipoly-agent-runner\")).as_str())\n230:     );\n231:     assert_eq!(\n232:         notify.get(\"status\").and_then(Value::as_str),\n233:         Some(\"enqueued\"),\n234:         \"notify response: {notify_json}\"\n235:     );\n236:     assert_eq!(notify.get(\"enqueued\").and_then(Value::as_bool), Some(true));\n237:     assert_eq!(\n238:         notify.get(\"owner_session_id\").and_then(Value::as_str),\n239:         Some(SESSION)\n240:     );\n241:     assert_eq!(\n242:         notify.get(\"session_source\").and_then(Value::as_str),\n243:         Some(\"sidecar_session_id\")\n244:     );\n245:     assert_eq!(\n246:         notify\n247:             .get(\"wake\")\n248:             .and_then(|wake| wake.get(\"status\"))\n249:             .and_then(Value::as_str),\n250:         Some(\"spawned\"),\n251:         \"notify response: {notify_json}\"\n252:     );\n253:     let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n254:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n255:     assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n256:     assert!(prompt.contains(\"handle: h-s11-external\"), \"{prompt}\");\n257:     wait_until(\"external provider wake delivered\", || {\n258:         let db = fixture.mailbox();\n259:         let rows = db.list_mailbox(SESSION, true).unwrap();\n260:         rows.len() == 1\n261:             && rows[0].delivered_at.is_some()\n262:             && rows[0].owner_invocation_uuid.is_some()\n263:             && rows[0].matched_os_pid.is_some()\n264:             && rows[0].matched_chain_index == Some(0)\n265:             && db.wake_claim(SESSION).unwrap().is_none()\n266:     });\n267:     let runtime = fixture.mailbox().session_runtime(SESSION).unwrap().unwrap();\n268:     assert_eq!(runtime.run_state, \"idle\");\n269:     let expected_models_dir = path_string(&fixture.models_dir);\n270:     assert_eq!(\n271:         runtime.models_dir.as_deref(),\n272:         Some(expected_models_dir.as_str()),\n273:         \"detached wake must reload the same models directory as the original external launch\"\n274:     );\n275:     fixture.assert_xdg_isolated();\n276: }\n277: \n278: #[test]\n279: fn external_provider_runtime_uses_ingested_session_when_launch_capture_missing() {\n280:     let fixture = Fixture::new();\n281:     fixture.write_external_provider();\n282: \n283:     let output = fixture.run_agent_with_env(\n284:         \"dispatch external provider without launch session capture\",\n285:         &[(\"S11_NO_NOTIFY\", \"1\"), (\"S11_OMIT_EXIT_SESSION\", \"1\")],\n286:     );\n287:     assert_success(&output);\n288: \n289:     wait_until(\"initial invocation finalized\", || {\n290:         fixture.finalized_invocation_count() >= 1\n291:     });\n292:     let runtime = fixture.mailbox().session_runtime(SESSION).unwrap().unwrap();\n293:     let expected_models_dir = path_string(&fixture.models_dir);\n294:     assert_eq!(runtime.run_state, \"idle\");\n295:     assert_eq!(runtime.provider_name.as_deref(), Some(PROVIDER));\n296:     assert_eq!(runtime.model_name.as_deref(), Some(MODEL));\n297:     assert_eq!(\n298:         runtime.models_dir.as_deref(),\n299:         Some(expected_models_dir.as_str())\n300:     );\n301:     fixture.assert_xdg_isolated();\n302: }\n303: \n304: #[test]\n305: fn external_provider_wake_does_not_mark_delivered_when_resume_produces_no_turn() {\n306:     let fixture = Fixture::new();\n307:     fixture.write_external_provider();\n308: \n309:     let output = fixture.run_agent_with_env(\n310:         \"dispatch external provider wake dropped payload\",\n311:         &[\n312:             (\"S11_DROP_RESUME_PAYLOAD\", \"1\"),\n313:             (\"OULIPOLY_AUTO_WAKE_MAX\", \"1\"),\n314:         ],\n315:     );\n316:     assert_success(&output);\n317: \n318:     let _dropped = wait_for_file(&fixture.prompt_file(\"external-wake-dropped.txt\"));\n319:     wait_until(\"failed wake released claim and recorded attempt\", || {\n320:         let db = fixture.mailbox();\n321:         let rows = db.list_mailbox(SESSION, true).unwrap();\n322:         rows.len() == 1\n323:             && rows[0].delivery_attempts == 1\n324:             && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n325:             && db.wake_claim(SESSION).unwrap().is_none()\n326:     });\n327: \n328:     let db = fixture.mailbox();\n329:     let rows = db.list_mailbox(SESSION, true).unwrap();\n330:     assert_eq!(rows.len(), 1, \"rows: {rows:?}\");\n331:     assert!(\n332:         rows[0].delivered_at.is_none(),\n333:         \"dropped resume payload must not mark mailbox delivered: {rows:?}\"\n334:     );\n335:     assert_eq!(db.list_pending(SESSION).unwrap().len(), 1);\n336:     assert!(\n337:         !fixture.prompt_file(\"external-wake-resumed.txt\").exists(),\n338:         \"drop mode must not write the payload-bearing resume file\"\n339:     );\n340:     fixture.assert_xdg_isolated();\n341: }\n342: \n343: #[test]\n344: fn external_provider_wake_confirms_delivery_from_submitted_turn_marker() {\n345:     let fixture = Fixture::new();\n346:     fixture.write_external_provider();\n347: \n348:     let output = fixture.run_agent_with_env(\n349:         \"dispatch external provider wake confirmed by marker\",\n350:         &[\n351:             (\"S11_EMIT_SUBMITTED_TURN_MARKER\", \"1\"),\n352:             (\"S11_EXPORT_REFORMATS_PROMPT\", \"1\"),\n353:             (\"S11_SKIP_SCAN_WAKE_TURN\", \"1\"),\n354:         ],\n355:     );\n356:     assert_success(&output);\n357: \n358:     let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n359:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n360:     assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n361:     let exported = wait_for_file(&fixture.prompt_file(\"external-wake-export.txt\"));\n362:     assert_ne!(exported, prompt);\n363:     assert!(exported.contains(\"[OULIPOLY-DELIVERY \"), \"{exported}\");\n364:     wait_until(\"submitted-turn marker delivered pending mailbox\", || {\n365:         let db = fixture.mailbox();\n366:         let rows = db.list_mailbox(SESSION, true).unwrap();\n367:         rows.len() == 1\n368:             && rows[0].delivered_at.is_some()\n369:             && rows[0].delivery_attempts == 1\n370:             && rows[0].delivery_error.is_none()\n371:             && db.wake_claim(SESSION).unwrap().is_none()\n372:     });\n373:     fixture.assert_xdg_isolated();\n374: }\n375: \n376: #[test]\n377: fn external_provider_wake_ignores_submitted_turn_marker_for_different_payload() {\n378:     let fixture = Fixture::new();\n379:     fixture.write_external_provider();\n380: \n381:     let output = fixture.run_agent_with_env(\n382:         \"dispatch external provider wake mismatched marker\",\n383:         &[\n384:             (\"S11_EMIT_SUBMITTED_TURN_MARKER\", \"1\"),\n385:             (\"S11_MARKER_PROMPT_SHA_MISMATCH\", \"1\"),\n386:             (\"S11_MARKER_DELIVERY_NONCE_MISMATCH\", \"1\"),\n387:             (\"S11_SKIP_SCAN_WAKE_TURN\", \"1\"),\n388:             (\"OULIPOLY_AUTO_WAKE_MAX\", \"1\"),\n389:         ],\n390:     );\n391:     assert_success(&output);\n392: \n393:     let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n394:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n395:     wait_until(\n396:         \"mismatched submitted-turn marker leaves mailbox pending\",\n397:         || {\n398:             let db = fixture.mailbox();\n399:             let rows = db.list_mailbox(SESSION, true).unwrap();\n400:             rows.len() == 1\n401:                 && rows[0].delivered_at.is_none()\n402:                 && rows[0].delivery_attempts == 1\n403:                 && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n404:                 && db.wake_claim(SESSION).unwrap().is_none()\n405:         },\n406:     );\n407:     fixture.assert_xdg_isolated();\n408: }\n409: \n410: #[test]\n411: fn external_provider_failed_wake_releases_claim_and_retries_pending_mailbox() {\n412:     let fixture = Fixture::new();\n413:     fixture.write_external_provider();\n414: \n415:     let output = fixture.run_agent_with_env(\n416:         \"dispatch external provider wake first dropped payload\",\n417:         &[\n418:             (\"S11_DROP_FIRST_RESUME_PAYLOAD\", \"1\"),\n419:             (\"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\", \"1000\"),\n420:         ],\n421:     );\n422:     assert_success(&output);\n423: \n424:     let _dropped = wait_for_file(&fixture.prompt_file(\"external-wake-dropped.txt\"));\n425:     wait_until(\"first failed wake released claim\", || {\n426:         let db = fixture.mailbox();\n427:         let rows = db.list_mailbox(SESSION, true).unwrap();\n428:         rows.len() == 1\n429:             && rows[0].delivered_at.is_none()\n430:             && rows[0].delivery_attempts == 1\n431:             && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n432:             && db.wake_claim(SESSION).unwrap().is_none()\n433:     });\n434: \n435:     let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n436:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n437:     wait_until(\"retried wake delivered pending mailbox\", || {\n438:         let db = fixture.mailbox();\n439:         let rows = db.list_mailbox(SESSION, true).unwrap();\n440:         rows.len() == 1\n441:             && rows[0].delivered_at.is_some()\n442:             && rows[0].delivery_attempts == 2\n443:             && rows[0].delivery_error.is_none()\n444:             && db.wake_claim(SESSION).unwrap().is_none()\n445:     });\n446:     fixture.assert_xdg_isolated();\n447: }\n448: \n449: #[test]\n450: fn external_provider_rate_limited_wake_records_error_and_retries_pending_mailbox() {\n451:     let fixture = Fixture::new();\n452:     fixture.write_external_provider();\n453: \n454:     let output = fixture.run_agent_with_env(\n455:         \"dispatch external provider wake first rate limited\",\n456:         &[\n457:             (\"S11_RATE_LIMIT_FIRST_RESUME\", \"1\"),\n458:             (\"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\", \"1000\"),\n459:         ],\n460:     );\n461:     assert_success(&output);\n462: \n463:     let _rate_limited = wait_for_file(&fixture.prompt_file(\"external-wake-rate-limited.txt\"));\n464:     wait_until(\"rate-limited wake released claim\", || {\n465:         let db = fixture.mailbox();\n466:         let rows = db.list_mailbox(SESSION, true).unwrap();\n467:         rows.len() == 1\n468:             && rows[0].delivered_at.is_none()\n469:             && rows[0].delivery_attempts == 1\n470:             && rows[0].delivery_error.as_deref() == Some(\"rate_limited\")\n471:             && db.wake_claim(SESSION).unwrap().is_none()\n472:     });\n473: \n474:     let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n475:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n476:     wait_until(\"rate-limited wake retry delivered pending mailbox\", || {\n477:         let db = fixture.mailbox();\n478:         let rows = db.list_mailbox(SESSION, true).unwrap();\n479:         rows.len() == 1\n480:             && rows[0].delivered_at.is_some()\n481:             && rows[0].delivery_attempts == 2\n482:             && rows[0].delivery_error.is_none()\n483:             && db.wake_claim(SESSION).unwrap().is_none()\n484:     });\n485:     fixture.assert_xdg_isolated();\n486: }\n487: \n488: #[test]\n489: fn external_provider_policy_rejection_terminal_signal_excerpt_includes_diagnostics() {\n490:     let fixture = Fixture::new();\n491:     fixture.write_external_provider();\n492: \n493:     let output = fixture.run_agent_with_env(\n494:         \"dispatch external provider reject\",\n495:         &[(\"S11_POLICY_REJECT\", \"1\")],\n496:     );\n497: \n498:     assert_ne!(output.status.code(), Some(0), \"{output:?}\");\n499:     let stderr = String::from_utf8_lossy(&output.stderr);\n500:     let marker = terminal_signal_marker(&stderr);\n501:     let excerpt = marker\n502:         .get(\"evidence\")\n503:         .and_then(|evidence| evidence.get(\"excerpt\"))\n504:         .and_then(Value::as_str)\n505:         .expect(\"terminal-signal marker should include evidence excerpt\");\n506:     assert!(excerpt.contains(\"policy rejected\"), \"{excerpt}\");\n507:     assert!(excerpt.contains(\"s11_policy_reject\"), \"{excerpt}\");\n508:     assert!(excerpt.contains(\"params.launch.argv\"), \"{excerpt}\");\n509:     assert!(excerpt.contains(\"s11 fixture rejected policy\"), \"{excerpt}\");\n510:     fixture.assert_xdg_isolated();\n511: }\n512: \n513: fn external_provider_script() -> &'static str {\n514:     r#\"#!/usr/bin/env python3\n515: import base64\n516: import hashlib\n517: import json\n518: import os\n519: import pathlib\n520: import subprocess\n\n(Showing lines 1-520 of 954. Use offset=521 to continue.)\n</content>","metadata":{"preview":"#![cfg(unix)]\n\nuse oulipoly_state::mailbox::MailboxDb;\nuse rusqlite::{Connection, params};\nuse serde_json::Value;\nuse std::fs;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::{Path, PathBuf};\nuse std::process::{Command, Output};\nuse std::time::{Duration, Instant};\n\nconst MODEL: &str = \"s11-external-wake-model\";\nconst PROVIDER: &str = \"opencode\";\nconst SESSION: &str = \"ses_s11externalwake\";\nconst HANDLE: &str = \"h-s11-external\";\n\nstruct Fixture {\n    dir: tempfile::TempDir,\n    config_home: PathBuf,\n    data_home: PathBuf,","truncated":true,"loaded":[],"display":{"type":"file","path":"/tmp/s11-gate-worktree-head/src-tauri/tests/s11_external_provider_wake.rs","text":"#![cfg(unix)]\n\nuse oulipoly_state::mailbox::MailboxDb;\nuse rusqlite::{Connection, params};\nuse serde_json::Value;\nuse std::fs;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::{Path, PathBuf};\nuse std::process::{Command, Output};\nuse std::time::{Duration, Instant};\n\nconst MODEL: &str = \"s11-external-wake-model\";\nconst PROVIDER: &str = \"opencode\";\nconst SESSION: &str = \"ses_s11externalwake\";\nconst HANDLE: &str = \"h-s11-external\";\n\nstruct Fixture {\n    dir: tempfile::TempDir,\n    config_home: PathBuf,\n    data_home: PathBuf,\n    home_dir: PathBuf,\n    app_config_dir: PathBuf,\n    models_dir: PathBuf,\n    work_dir: PathBuf,\n}\n\nimpl Fixture {\n    fn new() -> Self {\n        let dir = tempfile::tempdir().unwrap();\n        let config_home = dir.path().join(\"xdg-config\");\n        let data_home = dir.path().join(\"xdg-data\");\n        let home_dir = dir.path().join(\"home\");\n        let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n        let models_dir = app_config_dir.join(\"models\");\n        let work_dir = dir.path().join(\"work\");\n        fs::create_dir_all(&models_dir).unwrap();\n        fs::create_dir_all(&home_dir).unwrap();\n        fs::create_dir_all(&work_dir).unwrap();\n        Self {\n            dir,\n            config_home,\n            data_home,\n            home_dir,\n            app_config_dir,\n            models_dir,\n            work_dir,\n        }\n    }\n\n    fn sidecar_path(&self) -> PathBuf {\n        self.data_home\n            .join(\"oulipoly-agent-runner\")\n            .join(\"pid-identity.db\")\n    }\n\n    fn state_path(&self) -> PathBuf {\n        self.data_home\n            .join(\"oulipoly-agent-runner\")\n            .join(\"state.db\")\n    }\n\n    fn run(&self, mut cmd: Command) -> Output {\n        cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n            .env(\"XDG_DATA_HOME\", &self.data_home)\n            .env(\"HOME\", &self.home_dir)\n            .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n            .env(\"S11_WORK_DIR\", &self.work_dir)\n            .env_remove(\"OULIPOLY_DATA_DIR\")\n            .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n            .current_dir(self.dir.path());\n        cmd.output().unwrap()\n    }\n\n    fn run_agent(&self, prompt: &str) -> Output {\n        self.run_agent_with_env(prompt, &[])\n    }\n\n    fn run_agent_with_env(&self, prompt: &str, envs: &[(&str, &str)]) -> Output {\n        let mut cmd = Command::new(runner_bin());\n        for (key, value) in envs {\n            cmd.env(key, value);\n        }\n        cmd.arg(\"-m\")\n            .arg(MODEL)\n            .arg(\"--models-dir\")\n            .arg(&self.models_dir)\n            .arg(prompt);\n        self.run(cmd)\n    }\n\n    fn write_external_provider(&self) {\n        let provider_path = self.write_external_provider_script();\n        let turn_script_path = self.write_turn_script();\n        fs::write(\n            self.models_dir.join(format!(\"{MODEL}.toml\")),\n            format!(\n                r#\"provider = {{ path = {} }}\nprompt_mode = \"arg\"\n\n[[providers]]\nname = \"{PROVIDER}\"\nargs = []\n\"#,\n                toml_string(&path_string(&provider_path))\n            ),\n        )\n        .unwrap();\n        fs::write(\n            self.app_config_dir.join(\"providers.toml\"),\n            format!(\n                r#\"[{PROVIDER}]\ncommand = \"fixture-opencode\"\nargs = []\nprompt_mode = \"arg\"\n\"#\n            ),\n        )\n        .unwrap();\n        fs::write(\n            self.app_config_dir.join(\"sessions.toml\"),\n            format!(\n                r#\"[{PROVIDER}]\nturn_script = {}\n\"#,\n                toml_string(&path_string(&turn_script_path))\n            ),\n        )\n        .unwrap();\n    }\n\n    fn write_external_provider_script(&self) -> PathBuf {\n        let path = self.dir.path().join(\"external-provider.py\");\n        fs::write(&path, external_provider_script()).unwrap();\n        let mut perms = fs::metadata(&path).unwrap().permissions();\n        perms.set_mode(0o755);\n        fs::set_permissions(&path, perms).unwrap();\n        path\n    }\n\n    fn write_turn_script(&self) -> PathBuf {\n        let path = self.dir.path().join(\"s11-turns.py\");\n        fs::write(&path, turn_script()).unwrap();\n        let mut perms = fs::metadata(&path).unwrap().permissions();\n        perms.set_mode(0o755);\n        fs::set_permissions(&path, perms).unwrap();\n        path\n    }\n\n    fn mailbox(&self) -> MailboxDb {\n        MailboxDb::open(&self.sidecar_path()).unwrap()\n    }\n\n    fn sidecar_conn(&self) -> Connection {\n        Connection::open(self.sidecar_path()).unwrap()\n    }\n\n    fn finalized_invocation_count(&self) -> i64 {\n        Connection::open(self.state_path())\n            .unwrap()\n            .query_row(\n                \"SELECT COUNT(*) FROM invocations WHERE finished_at IS NOT NULL\",\n                [],\n                |row| row.get(0),\n            )\n            .unwrap()\n    }\n\n    fn pid_identity_session_id_for_provider(&self, provider_name: &str) -> Option<String> {\n        self.sidecar_conn()\n            .query_row(\n                \"SELECT session_id\n                 FROM pid_identity\n                 WHERE provider_name = ?1\n                 ORDER BY recorded_at DESC, os_pid DESC\n                 LIMIT 1\",\n                params![provider_name],\n                |row| row.get(0),\n            )\n            .ok()\n    }\n\n    fn prompt_file(&self, name: &str) -> PathBuf {\n        self.work_dir.join(name)\n    }\n\n    fn assert_xdg_isolated(&self) {\n        assert!(\n            !self\n                .home_dir\n                .join(\".local/share/oulipoly-agent-runner\")\n                .exists(),\n            \"state must stay in isolated XDG_DATA_HOME\"\n        );\n        assert!(\n            !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n            \"config must stay in isolated XDG_CONFIG_HOME\"\n        );\n    }\n}\n\n#[test]\nfn external_provider_launch_notify_uses_captured_sidecar_owner_and_wakes() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent(\"dispatch external provider wake\");\n    assert_success(&output);\n\n    wait_until(\"pid identity backfilled with captured session\", || {\n        fixture\n            .pid_identity_session_id_for_provider(PROVIDER)\n            .as_deref()\n            == Some(SESSION)\n    });\n    let (notify_json, notify) =\n        wait_for_json_file(&fixture.work_dir.join(HANDLE).join(\"notify.json\"));\n    let (_, notify_env) =\n        wait_for_json_file(&fixture.work_dir.join(HANDLE).join(\"notify-env.json\"));\n    assert_eq!(\n        notify_env.get(\"xdg_config_home\").and_then(Value::as_str),\n        None\n    );\n    assert_eq!(\n        notify_env.get(\"xdg_data_home\").and_then(Value::as_str),\n        None\n    );\n    assert_eq!(\n        notify_env.get(\"oulipoly_data_dir\").and_then(Value::as_str),\n        Some(path_string(&fixture.data_home.join(\"oulipoly-agent-runner\")).as_str())\n    );\n    assert_eq!(\n        notify.get(\"status\").and_then(Value::as_str),\n        Some(\"enqueued\"),\n        \"notify response: {notify_json}\"\n    );\n    assert_eq!(notify.get(\"enqueued\").and_then(Value::as_bool), Some(true));\n    assert_eq!(\n        notify.get(\"owner_session_id\").and_then(Value::as_str),\n        Some(SESSION)\n    );\n    assert_eq!(\n        notify.get(\"session_source\").and_then(Value::as_str),\n        Some(\"sidecar_session_id\")\n    );\n    assert_eq!(\n        notify\n            .get(\"wake\")\n            .and_then(|wake| wake.get(\"status\"))\n            .and_then(Value::as_str),\n        Some(\"spawned\"),\n        \"notify response: {notify_json}\"\n    );\n    let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n    assert!(prompt.contains(\"handle: h-s11-external\"), \"{prompt}\");\n    wait_until(\"external provider wake delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && rows[0].owner_invocation_uuid.is_some()\n            && rows[0].matched_os_pid.is_some()\n            && rows[0].matched_chain_index == Some(0)\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    let runtime = fixture.mailbox().session_runtime(SESSION).unwrap().unwrap();\n    assert_eq!(runtime.run_state, \"idle\");\n    let expected_models_dir = path_string(&fixture.models_dir);\n    assert_eq!(\n        runtime.models_dir.as_deref(),\n        Some(expected_models_dir.as_str()),\n        \"detached wake must reload the same models directory as the original external launch\"\n    );\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_runtime_uses_ingested_session_when_launch_capture_missing() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider without launch session capture\",\n        &[(\"S11_NO_NOTIFY\", \"1\"), (\"S11_OMIT_EXIT_SESSION\", \"1\")],\n    );\n    assert_success(&output);\n\n    wait_until(\"initial invocation finalized\", || {\n        fixture.finalized_invocation_count() >= 1\n    });\n    let runtime = fixture.mailbox().session_runtime(SESSION).unwrap().unwrap();\n    let expected_models_dir = path_string(&fixture.models_dir);\n    assert_eq!(runtime.run_state, \"idle\");\n    assert_eq!(runtime.provider_name.as_deref(), Some(PROVIDER));\n    assert_eq!(runtime.model_name.as_deref(), Some(MODEL));\n    assert_eq!(\n        runtime.models_dir.as_deref(),\n        Some(expected_models_dir.as_str())\n    );\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_wake_does_not_mark_delivered_when_resume_produces_no_turn() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider wake dropped payload\",\n        &[\n            (\"S11_DROP_RESUME_PAYLOAD\", \"1\"),\n            (\"OULIPOLY_AUTO_WAKE_MAX\", \"1\"),\n        ],\n    );\n    assert_success(&output);\n\n    let _dropped = wait_for_file(&fixture.prompt_file(\"external-wake-dropped.txt\"));\n    wait_until(\"failed wake released claim and recorded attempt\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n\n    let db = fixture.mailbox();\n    let rows = db.list_mailbox(SESSION, true).unwrap();\n    assert_eq!(rows.len(), 1, \"rows: {rows:?}\");\n    assert!(\n        rows[0].delivered_at.is_none(),\n        \"dropped resume payload must not mark mailbox delivered: {rows:?}\"\n    );\n    assert_eq!(db.list_pending(SESSION).unwrap().len(), 1);\n    assert!(\n        !fixture.prompt_file(\"external-wake-resumed.txt\").exists(),\n        \"drop mode must not write the payload-bearing resume file\"\n    );\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_wake_confirms_delivery_from_submitted_turn_marker() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider wake confirmed by marker\",\n        &[\n            (\"S11_EMIT_SUBMITTED_TURN_MARKER\", \"1\"),\n            (\"S11_EXPORT_REFORMATS_PROMPT\", \"1\"),\n            (\"S11_SKIP_SCAN_WAKE_TURN\", \"1\"),\n        ],\n    );\n    assert_success(&output);\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n    let exported = wait_for_file(&fixture.prompt_file(\"external-wake-export.txt\"));\n    assert_ne!(exported, prompt);\n    assert!(exported.contains(\"[OULIPOLY-DELIVERY \"), \"{exported}\");\n    wait_until(\"submitted-turn marker delivered pending mailbox\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivery_error.is_none()\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_wake_ignores_submitted_turn_marker_for_different_payload() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider wake mismatched marker\",\n        &[\n            (\"S11_EMIT_SUBMITTED_TURN_MARKER\", \"1\"),\n            (\"S11_MARKER_PROMPT_SHA_MISMATCH\", \"1\"),\n            (\"S11_MARKER_DELIVERY_NONCE_MISMATCH\", \"1\"),\n            (\"S11_SKIP_SCAN_WAKE_TURN\", \"1\"),\n            (\"OULIPOLY_AUTO_WAKE_MAX\", \"1\"),\n        ],\n    );\n    assert_success(&output);\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    wait_until(\n        \"mismatched submitted-turn marker leaves mailbox pending\",\n        || {\n            let db = fixture.mailbox();\n            let rows = db.list_mailbox(SESSION, true).unwrap();\n            rows.len() == 1\n                && rows[0].delivered_at.is_none()\n                && rows[0].delivery_attempts == 1\n                && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n                && db.wake_claim(SESSION).unwrap().is_none()\n        },\n    );\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_failed_wake_releases_claim_and_retries_pending_mailbox() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider wake first dropped payload\",\n        &[\n            (\"S11_DROP_FIRST_RESUME_PAYLOAD\", \"1\"),\n            (\"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\", \"1000\"),\n        ],\n    );\n    assert_success(&output);\n\n    let _dropped = wait_for_file(&fixture.prompt_file(\"external-wake-dropped.txt\"));\n    wait_until(\"first failed wake released claim\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_none()\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    wait_until(\"retried wake delivered pending mailbox\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && rows[0].delivery_attempts == 2\n            && rows[0].delivery_error.is_none()\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_rate_limited_wake_records_error_and_retries_pending_mailbox() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider wake first rate limited\",\n        &[\n            (\"S11_RATE_LIMIT_FIRST_RESUME\", \"1\"),\n            (\"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\", \"1000\"),\n        ],\n    );\n    assert_success(&output);\n\n    let _rate_limited = wait_for_file(&fixture.prompt_file(\"external-wake-rate-limited.txt\"));\n    wait_until(\"rate-limited wake released claim\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_none()\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivery_error.as_deref() == Some(\"rate_limited\")\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    wait_until(\"rate-limited wake retry delivered pending mailbox\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && rows[0].delivery_attempts == 2\n            && rows[0].delivery_error.is_none()\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_policy_rejection_terminal_signal_excerpt_includes_diagnostics() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider reject\",\n        &[(\"S11_POLICY_REJECT\", \"1\")],\n    );\n\n    assert_ne!(output.status.code(), Some(0), \"{output:?}\");\n    let stderr = String::from_utf8_lossy(&output.stderr);\n    let marker = terminal_signal_marker(&stderr);\n    let excerpt = marker\n        .get(\"evidence\")\n        .and_then(|evidence| evidence.get(\"excerpt\"))\n        .and_then(Value::as_str)\n        .expect(\"terminal-signal marker should include evidence excerpt\");\n    assert!(excerpt.contains(\"policy rejected\"), \"{excerpt}\");\n    assert!(excerpt.contains(\"s11_policy_reject\"), \"{excerpt}\");\n    assert!(excerpt.contains(\"params.launch.argv\"), \"{excerpt}\");\n    assert!(excerpt.contains(\"s11 fixture rejected policy\"), \"{excerpt}\");\n    fixture.assert_xdg_isolated();\n}\n\nfn external_provider_script() -> &'static str {\n    r#\"#!/usr/bin/env python3\nimport base64\nimport hashlib\nimport json\nimport os\nimport pathlib\nimport subprocess","lineStart":1,"lineEnd":520,"totalLines":954,"truncated":true}},"title":"src-tauri/tests/s11_external_provider_wake.rs","time":{"start":1780782397631,"end":1780782397642}},"metadata":{"openai":{"itemId":"fc_0787c0b82d5eebcc016a24953d8f688190916fc33a112609f4"}},"id":"prt_e9ee6f8a5001SECjl4h33iFjtD","sessionID":"ses_1611a223effeVm9QJZLOjnSHiy","messageID":"msg_e9ee6e347001p1XeKNSNvF08Qg"}}
