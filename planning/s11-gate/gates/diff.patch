roTurnAction,\n607: ) -> Result<ResumeAttemptLoopControl, String> {\n608:     let terminal_signal_disposition = terminal_signal_disposition_for_result(\n609:         &input.env.state,\n610:         &attempt.invocation.id,\n611:         &provider.name,\n612:         provider_session_id,\n613:         result,\n614:         zero_turn_action,\n615:     );\n616: \n617:     match handle_terminal_signal_disposition(ResumeTerminalDispositionInput {\n618:         agent_runtime_services: input.agent_runtime_services,\n619:         env: input.env,\n620:         invocation_row_id: attempt.invocation_row_id,\n621:         guard: &mut attempt.guard,\n622:         result,\n623:         terminal_signal_disposition,\n624:         zero_turn_action,\n625:     })? {\n626:         ResumeLoopControl::Continue => {\n627:             mark_resume_attempt_idle(\n628:                 provider_session_id,\n629:                 &attempt.invocation.id,\n630:                 Some(result.exit_code),\n631:             )?;\n632:             return Ok(ResumeAttemptLoopControl::Continue(result.exit_code));\n633:         }\n634:         ResumeLoopControl::Return(exit_code) => {\n635:             mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n636:             return Ok(ResumeAttemptLoopControl::Return(exit_code));\n637:         }\n638:         ResumeLoopControl::CompletedAttempt => {}\n639:     }\n640: \n641:     match finalize_completed_attempt(CompletedAttemptInput {\n642:         agent_runtime_services: input.agent_runtime_services,\n643:         env: input.env,\n644:         invocation: &attempt.invocation,\n645:         invocation_row_id: attempt.invocation_row_id,\n646:         guard: &mut attempt.guard,\n647:         provider_name: &provider.name,\n648:         model: input.resolved.model.as_ref(),\n649:         result,\n650:         working_dir: input.working_dir,\n651:         manual_migrate: input.manual_migrate,\n652:         session_id: input.session_id,\n653:         active_session_id: &input.resolved.active_session_id,\n654:         effective_spawn_cwd: input.effective_spawn_cwd,\n655:         attempts: input.attempts,\n656:         max_attempts: input.max_attempts,\n657:     })? {\n658:         CompletedAttemptControl::Continue => {\n659:             mark_resume_attempt_idle(\n660:                 provider_session_id,\n661:                 &attempt.invocation.id,\n662:                 Some(result.exit_code),\n663:             )?;\n664:             Ok(ResumeAttemptLoopControl::Continue(result.exit_code))\n665:         }\n666:         CompletedAttemptControl::Return(exit_code) => {\n667:             if exit_code == 0 {\n668:                 crate::mailbox_delivery::mark_headless_resume_delivered(\n669:                     input.mailbox_session_id,\n670:                     input.mailbox_delivery_seqs,\n671:                     &attempt.invocation.id,\n672:                 )?;\n673:                 let _ = crate::wake_coordinator::mark_successful_turn_idle_and_recheck(\n674:                     provider_session_id,\n675:                     &attempt.invocation.id,\n676:                     exit_code,\n677:                 )?;\n678:             } else {\n679:                 mark_resume_attempt_idle(\n680:                     provider_session_id,\n681:                     &attempt.invocation.id,\n682:                     Some(exit_code),\n683:                 )?;\n684:             }\n685:             Ok(ResumeAttemptLoopControl::Return(exit_code))\n686:         }\n687:     }\n688: }\n689: \n690: fn mark_resume_attempt_idle(\n691:     provider_session_id: &str,\n692:     invocation_uuid: &str,\n693:     exit_code: Option<i32>,\n694: ) -> Result<(), String> {\n695:     crate::wake_coordinator::mark_session_idle_after_turn(\n696:         provider_session_id,\n697:         invocation_uuid,\n698:         exit_code,\n699:     )\n700: }\n701: \n702: fn resolve_resume_for_headless_execution(\n703:     agent_runtime_services: &wiring::AgentRuntimeServices,\n704:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n705:     session_id: &str,\n706:     model_name: Option<&str>,\n707: ) -> Result<oulipoly_state::ResolvedResume, i32> {\n708:     let output = agent_runtime_services\n709:         .resume_service\n710:         .resolve_resume(mapper::resume_service_request(env, session_id, model_name))\n711:         .map_err(|err| err.to_string());\n712:     headless_resume_resolution_result(output, env, session_id, model_name)\n713: }\n714: \n715: fn headless_resume_resolution_result(\n716:     output: Result<ResumeServiceOutput, String>,\n717:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n718:     session_id: &str,\n719:     model_name: Option<&str>,\n720: ) -> Result<oulipoly_state::ResolvedResume, i32> {\n721:     match output {\n722:         Ok(ResumeServiceOutput::ResumeResolved { resolved }) => Ok(resolved),\n723:         Ok(ResumeServiceOutput::ResumeRejected {\n724:             error:\n725:                 oulipoly_state::ResumeError::ProviderModelMismatch {\n726:                     active_provider, ..\n727:                 },\n728:         }) => {\n729:             render_resume_model_pool_mismatch(\n730:                 &env.models,\n731:                 model_name.unwrap_or(\"<unknown>\"),\n732:                 session_id,\n733:                 &active_provider,\n734:             );\n735:             Err(1)\n736:         }\n737:         Ok(ResumeServiceOutput::ResumeRejected { error }) => {\n738:             render_resume_error(error);\n739:             Err(1)\n740:         }\n741:         Err(err) => {\n742:             render_resume_service_failure(&err);\n743:             Err(1)\n744:         }\n745:     }\n746: }\n747: \n748: fn render_resume_error(error: oulipoly_state::ResumeError) {\n749:     formatter::emit_stderr(&format_resume_error(error));\n750: }\n751: \n752: fn render_resume_service_failure(error: &str) {\n753:     formatter::emit_stderr(&format!(\"resume service failed: {error}\"));\n754: }\n755: \n756: fn prepare_initial_headless_resume_target(\n757:     resolved: &oulipoly_state::ResolvedResume,\n758:     providers_cfg: &oulipoly_config::ProvidersConfig,\n759:     stderr_is_terminal: bool,\n760: ) -> Result<(), i32> {\n761:     let target = renderable_resume_execution_target(resolved, providers_cfg)?;\n762:     render_resume_short_line_if_needed(stderr_is_terminal, &resolved.active_provider);\n763:     validate_headless_resume_target(resolved, &target, &resolved.active_provider)\n764: }\n765: \n766: fn render_resume_short_line_if_needed(stderr_is_terminal: bool, selected_provider: &str) {\n767:     if crate::dispatch::should_emit_resume_short_line(stderr_is_terminal) {\n768:         formatter::emit_resume_short_line(selected_provider);\n769:     }\n770: }\n771: \n772: fn validate_headless_resume_target(\n773:     resolved: &oulipoly_state::ResolvedResume,\n774:     target: &crate::resume_cli::ResumeExecutionTarget,\n775:     selected_provider: &str,\n776: ) -> Result<(), i32> {\n777:     if resolved_uses_provider_ref(resolved) {\n778:         return validate_provider_ref_headless_resume_target(resolved, target, selected_provider)\n779:             .map_err(|message| provider_ref_resume_block_exit_code(&message));\n780:     }\n781:     if headless_resume_target_has_resume(target) {\n782:         Ok(())\n783:     } else {\n784:         Err(headless_missing_resume_block_exit_code(selected_provider))\n785:     }\n786: }\n787: \n788: fn validate_provider_ref_headless_resume_target(\n789:     resolved: &oulipoly_state::ResolvedResume,\n790:     target: &crate::resume_cli::ResumeExecutionTarget,\n791:     selected_provider: &str,\n792: ) -> Result<(), String> {\n793:     let Some(model) = provider_ref_resolved_model(resolved) else {\n794:         return Err(provider_ref_missing_model_message(selected_provider));\n795:     };\n796:     if !provider_ref_model_has_implementation(model) {\n797:         return Err(provider_ref_missing_implementation_message(\n798:             selected_provider,\n799:         ));\n800:     }\n801:     let Some(target_member_name) = provider_ref_target_member_name(model, target.provider_index)\n802:     else {\n803:         return Err(provider_ref_invalid_index_message(\n804:             selected_provider,\n805:             target.provider_index,\n806:         ));\n807:     };\n808:     if target_member_name != selected_provider {\n809:         return Err(provider_ref_resolved_provider_message(\n810:             selected_provider,\n811:             target_member_name,\n812:         ));\n813:     }\n814:     let loaded_provider_name = provider_ref_loaded_provider_name(target);\n815:     if loaded_provider_name != selected_provider {\n816:         return Err(provider_ref_loaded_provider_message(\n817:             selected_provider,\n818:             loaded_provider_name,\n819:         ));\n820:     }\n821:     Ok(())\n822: }\n823: \n824: fn provider_ref_resolved_model(\n825:     resolved: &oulipoly_state::ResolvedResume,\n826: ) -> Option<&oulipoly_config::ModelConfig> {\n827:     resolved.model.as_ref()\n828: }\n829: \n830: fn provider_ref_model_has_implementation(model: &oulipoly_config::ModelConfig) -> bool {\n831:     model.provider.is_some()\n832: }\n833: \n834: fn provider_ref_target_member_name(\n835:     model: &oulipoly_config::ModelConfig,\n836:     provider_index: usize,\n837: ) -> Option<&str> {\n838:     model\n839:         .providers\n840:         .get(provider_index)\n841:         .map(|provider| provider.name.as_str())\n842: }\n843: \n844: fn provider_ref_loaded_provider_name(target: &crate::resume_cli::ResumeExecutionTarget) -> &str {\n845:     &target.provider.name\n846: }\n847: \n848: fn provider_ref_missing_model_message(selected_provider: &str) -> String {\n849:     format!(\"provider-ref resume target {selected_provider} has no model config\")\n850: }\n851: \n852: fn provider_ref_missing_implementation_mes