+
+fn terminal_signal_marker_line(stderr: &str) -> &str {
+    stderr
+        .lines()
+        .find_map(|line| line.strip_prefix("OULIPOLY_TERMINAL_SIGNAL="))
+        .unwrap_or_else(|| panic!("missing terminal-signal marker in stderr:\n{stderr}"))
