ind: HostErrorKind,\n202:         subcommand: impl Into<String>,\n203:         request_id: Option<String>,\n204:         diagnostics: ProviderDiagnostics,\n205:     ) -> Self {\n206:         Self::Transport {\n207:             description: kind.as_str().to_owned(),\n208:             kind,\n209:             subcommand: subcommand.into(),\n210:             request_id,\n211:             diagnostics: Box::new(diagnostics),\n212:             process_status: None,\n213:         }\n214:     }\n215: \n216:     pub fn protocol(\n217:         kind: HostErrorKind,\n218:         subcommand: impl Into<String>,\n219:         request_id: Option<String>,\n220:         diagnostics: ProviderDiagnostics,\n221:     ) -> Self {\n222:         Self::Protocol {\n223:             description: kind.as_str().to_owned(),\n224:             kind,\n225:             subcommand: subcommand.into(),\n226:             request_id,\n227:             diagnostics: Box::new(diagnostics),\n228:             process_status: None,\n229:         }\n230:     }\n231: \n232:     pub fn from_capability(error: ProviderCapabilityError) -> Self {\n233:         Self::ProviderCapability(Box::new(error))\n234:     }\n235: \n236:     pub fn with_process_context(\n237:         self,\n238:         diagnostics: ProviderDiagnostics,\n239:         process_status: ProcessStatus,\n240:     ) -> Self {\n241:         match self {\n242:             Self::Transport {\n243:                 kind,\n244:                 subcommand,\n245:                 request_id,\n246:                 description,\n247:                 ..\n248:             } => Self::Transport {\n249:                 kind,\n250:                 subcommand,\n251:                 request_id,\n252:                 description,\n253:                 diagnostics: Box::new(diagnostics),\n254:                 process_status: Some(Box::new(process_status)),\n255:             },\n256:             Self::Protocol {\n257:                 kind,\n258:                 subcommand,\n2