+fn spawn_provider_process<I, K, V>(
+    command: &ProcessCommand,
+    envs: I,
+) -> Result<Child, ProviderClientError>
+where
+    I: IntoIterator<Item = (K, V)>,
+    K: AsRef<OsStr>,
