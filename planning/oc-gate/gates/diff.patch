+++ b/scripts/opencode-turns
@@ -0,0 +1,259 @@
+#!/usr/bin/env python3
+"""
+Reference adapter: emit OpenCode exported sessions as normalized JSONL.
+
+Usage: opencode-turns BASE_DIR [SESSION_ID ...]
+   e.g. opencode-turns ~/.local/share/opencode ses_abc123
+
+Session IDs and message content are read through the public OpenCode CLI:
+  opencode session list
+  opencode export <sessionID>
+
+When SESSION_ID arguments are supplied, they are used directly. BASE_DIR is
+accepted for compatibility with existing session source configuration; implicit
+discovery uses `opencode session list`, not OpenCode's private storage layout.
+
+Emits one JSON object per line on stdout:
+  {"session_id":"ses_...","turn_id":"msg_...","timestamp":"<rfc3339>","role":"user|assistant","body":[{"type":"text","text":"..."}]}
+"""
+
+import json
+import os
+import re
+import shlex
+import subprocess
+import sys
+from datetime import datetime, timezone
+from typing import Any
+
+
+MESSAGE_LIST_KEYS = ("messages", "turns", "items", "entries")
+SESSION_ID_RE = re.compile(r"\bses_[A-Za-z0-9_-]+\b")
+
+
+def text_chunk(text: str) -> dict:
+    return {"type": "text", "text": text}
+
+
+def canonical_chunk_type(native_type) -> str:
+    if not isinstance(native_type, str):
+        return "text"
+    if native_type in ("input_text", "output_text", "markdown"):
+        return "text"
+    return native_type
+
+
+def extract_content_chunks(value) -> list:
+    if isinstance(value, str):
+        return [text_chunk(value)]
+    if isinstance(value, list):
+        chunks = []
+        for item in value:
+            chunks.extend(extract_content_chunks(item))
+        return chunks
+    if isinstance(value, dict):
+        text = value.get("text")
+        if text is None:
+            text = value.get("content")
+        if isinstance(text, str):
+            native_type = value.get("type") or "text"
+            return [{"type": canonical_chunk_type(native_type), "text": text}]
+        for key in ("parts", "content", "message"):
+            chunks = extract_content_chunks(value.get(key))
+            if chunks:
+                return chunks
+    return []
+
+
+def unique_values(values: list[str]) -> list[str]:
+    seen = set()
+    unique = []
+    for value in values:
+        if value and value not in seen:
+            seen.add(value)
+            unique.append(value)
+    return unique
+
+
+def session_ids_from_value(value: Any) -> list[str]:
+    if isinstance(value, str):
+        return SESSION_ID_RE.findall(value)
+    if isinstance(value, list):
+        session_ids = []
+        for item in value:
+            session_ids.extend(session_ids_from_value(item))
+        return session_ids
+    if isinstance(value, dict):
+        session_ids = []
+        for item in value.values():
+            session_ids.extend(session_ids_from_value(item))
+        return session_ids
+    return []
+
+
+def parse_session_list_stdout(stdout: str) -> list[str]:
+    try:
+        parsed = json.loads(stdout)
+    except json.JSONDecodeError:
+        parsed = stdout
+    return sorted(unique_values(session_ids_from_value(parsed)))
+
+
+def discover_session_ids() -> list[str]:
+    command = opencode_command() + ["session", "list"]
+    try:
+        completed = subprocess.run(
+            command,
+            check=True,
+            capture_output=True,
+            text=True,
+        )
+    except (OSError, subprocess.CalledProcessError):
+        return []
+    return parse_session_list_stdout(completed.stdout)
+
+
+def requested_session_ids(args: list[str]) -> list[str]:
+    if args:
+        return unique_values(args)
+    return discover_session_ids()
+
+
+def numeric_timestamp(value) -> str | None:
+    if not isinstance(value, (int, float)):
+        return None
+    seconds = value / 1000 if value > 10_000_000_000 else value
+    return datetime.fromtimestamp(seconds, tz=timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def timestamp_from_obj(obj: dict) -> str | None:
+    for key in ("timestamp", "createdAt", "created_at", "time"):
+        value = obj.get(key)
+        if isinstance(value, str) and value:
+            return value
+        converted = numeric_timestamp(value)
+        if converted:
+            return converted
+    return None
+
+
+def session_id_from_obj(obj: dict) -> str | None:
+    for key in ("sessionID", "sessionId", "session_id"):
+        value = obj.get(key)
+        if isinstance(value, str) and value:
+            return value
+    return None
+
+
+def role_from_obj(obj: dict) -> str | None:
+    value = obj.get("role")
+    if value in ("user", "assistant"):
+        return value
+    message = obj.get("message")
+    if isinstance(message, dict) and message.get("role") in ("user", "assistant"):
+        return message.get("role")
+    return None
+
+
+def turn_id_from_obj(obj: dict, default_session_id: str, index: int) -> str:
+    for key in ("id", "messageID", "messageId", "message_id"):
+        value = obj.get(key)
+        if isinstance(value, str) and value:
+            return value
+    message = obj.get("message")
+    if isinstance(message, dict):
+        for key in ("id", "messageID", "messageId", "message_id"):
+            value = message.get(key)
+            if isinstance(value, str) and value:
+                return value
+    return f"{default_session_id}:{index}"
+
+
+def opencode_command() -> list[str]:
+    configured = os.environ.get("OPENCODE_BIN", "opencode")
+    return shlex.split(configured) or ["opencode"]
+
+
+def parse_export_stdout(stdout: str) -> Any | None:
+    try:
+        return json.loads(stdout)
+    except json.JSONDecodeError:
+        return None
+
+
+def export_session(session_id: str) -> Any | None:
+    command = opencode_command() + ["export", session_id]
+    try:
+        completed = subprocess.run(
+            command,
+            check=True,
+            capture_output=True,
+            text=True,
+        )
+    except (OSError, subprocess.CalledProcessError):
+        return None
+    return parse_export_stdout(completed.stdout)
+
+
+def exported_message_items(exported: Any) -> list[dict]:
+    if isinstance(exported, list):
+        return [item for item in exported if isinstance(item, dict)]
+    if not isinstance(exported, dict):
+        return []
+    for key in MESSAGE_LIST_KEYS:
+        value = exported.get(key)
+        if isinstance(value, list):
+            return [item for item in value if isinstance(item, dict)]
+    if role_from_obj(exported):
+        return [exported]
+    return []
+
+
+def record_from_message(default_session_id: str, index: int, obj: dict) -> dict | None:
+    session_id = session_id_from_obj(obj) or default_session_id
+    role = role_from_obj(obj)
+    timestamp = timestamp_from_obj(obj)
+    if not session_id or not role or not timestamp:
+        return None
+    record = {
+        "session_id": session_id,
+        "turn_id": turn_id_from_obj(obj, default_session_id, index),
+        "timestamp": timestamp,
+        "role": role,
+    }
+    body = extract_content_chunks(obj.get("parts")) or extract_content_chunks(
+        obj.get("content")
+    ) or extract_content_chunks(obj.get("message"))
+    if body:
+        record["body"] = body
+    return record
+
+
+def emit_record(record: dict, out) -> None:
+    out.write(json.dumps(record, separators=(",", ":")))
+    out.write("\n")
+
+
+def emit_session(session_id: str, out) -> None:
+    exported = export_session(session_id)
+    if exported is None:
+        return
+    for index, obj in enumerate(exported_message_items(exported), start=1):
+        record = record_from_message(session_id, index, obj)
+        if record:
+            emit_record(record, out)
+
+
+def main() -> int:
+    if len(sys.argv) < 2:
+        print("usage: opencode-turns BASE_DIR [SESSION_ID ...]", file=sys.stderr)
+        return 2
+    _base_dir = sys.argv[1]
+    out = sys.stdout
+    for session_id in requested_session_ids(sys.argv[2:]):
+        emit_session(session_id, out)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
