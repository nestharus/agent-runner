++#!/usr/bin/env python3
++"""
++Reference adapter: emit OpenCode session messages as normalized JSONL.
++
++Usage: opencode-turns BASE_DIR
++   e.g. opencode-turns ~/.local/share/opencode
++
++Expected native layout:
++  BASE_DIR/storage/message/ses_<id>/msg_*.json
++
++The runner sets STATE_DIR to a writable dir for incremental bookkeeping. We
++track the highest mtime emitted; subsequent runs skip files unchanged since.
++
++Emits one JSON object per line on stdout:
++  {"session_id":"ses_...","turn_id":"msg_...","timestamp":"<rfc3339>","role":"user|assistant","body":[{"type":"text","text":"..."}]}
++"""
++
++import json
++import os
++import sys
++from datetime import datetime, timezone
++from pathlib import Path
++
++
++def text_chunk(text: str) -> dict:
++    return {"type": "text", "text": text}
++
++
++def canonical_chunk_type(native_type) -> str:
++    if not isinstance(native_type, str):
++        return "text"
++    if native_type in ("input_text", "output_text", "markdown"):
++        return "text"
++    return native_type
++
++
++def extract_content_chunks(value) -> list:
++    if isinstance(value, str):
++        return [text_chunk(value)]
++    if isinstance(value, list):
++        chunks = []
++        for item in value:
++            chunks.extend(extract_content_chunks(item))
++        return chunks
++    if isinstance(value, dict):
++        text = value.get("text")
++        if text is None:
++            text = value.get("content")
++        if isinstance(text, str):
++            native_type = value.get("type") or "text"
++            return [{"type": canonical_chunk_type(native_type), "text": text}]
++        for key in ("parts", "content", "message"):
++            chunks = extract_content_chunks(value.get(key))
++            if chunks:
++                return chunks
++    return []
++
++
++def message_roots(base: Path) -> list:
++    candidates = []
++    if base.name == "message":
++        candidates.append(base)
++    candidates.append(base / "storage" / "message")
++    candidates.append(base / "message")
++    seen = set()
++    roots = []
++    for candidate in candidates:
++        resolved = candidate.expanduser()
++        key = str(resolved)
++        if key not in seen and resolved.exists():
++            seen.add(key)
++            roots.append(resolved)
++    return roots
++
++
++def message_paths(base: Path) -> list:
++    paths = []
++    for root in message_roots(base):
++        paths.extend(root.glob("ses_*/msg_*.json"))
++    if not paths:
++        paths.extend(base.glob("**/ses_*/msg_*.json"))
++    return sorted(set(paths))
++
++
++def read_cursor(state_dir: Path) -> int:
++    cursor_file = state_dir / "last_mtime"
++    if not cursor_file.exists():
++        return 0
++    try:
++        return int(cursor_file.read_text().strip())
++    except ValueError:
++        return 0
++
++
++def write_cursor(state_dir: Path, value: int) -> None:
++    (state_dir / "last_mtime").write_text(str(value))
++
++
++def numeric_timestamp(value) -> str | None:
++    if not isinstance(value, (int, float)):
++        return None
++    seconds = value / 1000 if value > 10_000_000_000 else value
++    return datetime.fromtimestamp(seconds, tz=timezone.utc).isoformat().replace("+00:00", "Z")
++
++
++def timestamp_from_obj(obj: dict, path: Path) -> str:
++    for key in ("timestamp", "createdAt", "created_at", "time"):
++        value = obj.get(key)
++        if isinstance(value, str) and value:
++            return value
++        converted = numeric_timestamp(value)
++        if converted:
++            return converted
++    return datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc).isoformat().replace(
++        "+00:00", "Z"
++    )
++
++
++def session_id_from_obj(obj: dict, path: Path) -> str | None:
++    for key in ("sessionID", "sessionId", "session_id"):
++        value = obj.get(key)
++        if isinstance(value, str) and value:
++            return value
++    for parent in path.parents:
++        if parent.name.startswith("ses_"):
++            return parent.name
++    return None
++
++
