me(terminal.terminal_signal),\n36:         captured_child_invocations: Vec::new(),\n37:         returned_artifacts: Vec::new(),\n38:     }\n39: }\n40: \n41: fn launch_session_capture(result: &LaunchResult) -> SessionCaptureResult {\n42:     match launch_provider_session_id(result) {\n43:         Some(session_id) => SessionCaptureResult {\n44:             session_id: Some(session_id),\n45:             method: SessionCaptureMethod::ExternalProviderLaunch,\n46:         },\n47:         None => SessionCaptureResult {\n48:             session_id: None,\n49:             method: SessionCaptureMethod::None,\n50:         },\n51:     }\n52: }\n53: \n54: fn launch_provider_session_id(result: &LaunchResult) -> Option<String> {\n55:     result\n56:         .exit\n57:         .session\n58:         .as_ref()\n59:         .and_then(provider_session_id_from_value)\n60: }\n61: \n62: fn provider_session_id_from_value(value: &Value) -> Option<String> {\n63:     raw_provider_session_id(value).and_then(accepted_provider_session_id)\n64: }\n65: \n66: fn raw_provider_session_id(value: &Value) -> Option<&str> {\n67:     value\n68:         .get(\"provider_session_id\")\n69:         .and_then(Value::as_str)\n70:         .or_else(|| value.get(\"session_id\").and_then(Value::as_str))\n71: }\n72: \n73: fn accepted_provider_session_id(session_id: &str) -> Option<String> {\n74:     provider_session_id_is_present(session_id).then(|| owned_provider_session_id(session_id))\n75: }\n76: \n77: fn provider_session_id_is_present(session_id: &str) -> bool {\n78:     !session_id.is_empty()\n79: }\n80: \n81: fn owned_provider_session_id(session_id: &str) -> String {\n82:     session_id.to_string()\n83: }\n\n(End of file - total 83 lines)\n</content>","metadata":{"preview":"//! Role: mapper.\n\nuse super::terminal_cancel_mapper::map_terminal_cancel_outcome;\nuse crate::executor::{ExecutionResult, SessionCaptureMethod, SessionCaptureResult};\nuse crate::services::TerminalClassification;\nuse oulipoly_provider::stream::LaunchResult;\nuse serde_json::Value;\n\npub(crate) fn map_launch_result_with_terminal_classification(\n    result: LaunchResult,\n    provider_index: usize,\n    provider_name: &str,\n    classification: Option<TerminalClassification>,\n) -> ExecutionResult {\n    let stdout = result.stdout_bytes();\n    let stderr = String::from_utf8_lossy(&result.stderr_bytes()).into_owned();\n    let terminal = map_terminal_cancel_outcome(\n        &result.exit.status,\n        &result.exit.terminal_signal,\n        provider_name,","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/age-pid-sidecar/crates/oulipoly-runtime/src/executor/external_provider/launch_result_mapper.rs","text":"//! Role: mapper.\n\nuse super::terminal_cancel_mapper::map_terminal_cancel_outcome;\nuse crate::executor::{ExecutionResult, SessionCaptureMethod, SessionCaptureResult};\nuse crate::services::TerminalClassification;\nuse oulipoly_provider::stream::LaunchResult;\nuse serde_json::Value;\n\npub(crate) fn map_launch_result_with_terminal_classification(\n    result: LaunchResult,\n    provider_index: usize,\n    provider_name: &str,\n    classification: Option<TerminalClassification>,\n) -> ExecutionResult {\n    let stdout = result.stdout_bytes();\n    let stderr = String::from_utf8_lossy(&result.stderr_bytes()).into_owned();\n    let terminal = map_terminal_cancel_outcome(\n        &result.exit.status,\n        &result.exit.terminal_signal,\n        provider_name,\n    );\n    let terminal = classification.unwrap_or(TerminalClassification {\n        exit_code: terminal.exit_code,\n        terminal_reason: terminal.terminal_reason,\n        terminal_signal: terminal.terminal_signal,\n    });\n    ExecutionResult {\n        stdout,\n        stderr,\n        exit_code: terminal.exit_code,\n        provider_index,\n        session_capture: launch_session_capture(&result),\n        resume_acceptance: None,\n        terminal_reason: terminal.terminal_reason,\n        terminal_signal: Some(terminal.terminal_signal),\n        captured_child_invocations: Vec::new(),\n        returned_artifacts: Vec::new(),\n    }\n}\n\nfn launch_session_capture(result: &LaunchResult) -> SessionCaptureResult {\n    match launch_provider_session_id(result) {\n        Some(session_id) => SessionCaptureResult {\n            session_id: Some(session_id),\n            method: SessionCaptureMethod::ExternalProviderLaunch,\n        },\n        None => SessionCaptureResult {\n            session_id: None,\n            method: SessionCaptureMethod::None,\n        },\n    }\n}\n\nfn launch_provider_session_id(result: &LaunchResult) -> Option<String> {\n    result\n        .exit\n        .session\n        .as_ref()\n        .and_then(provider_session_id_from_value)\n}\n\nfn provider_session_id_from_value(value: &Value) -> Option<String> {\n    raw_provider_session_id(value).and_then(accepted_provider_session_id)\n}\n\nfn raw_provider_session_id(value: &Value) -> Option<&str> {\n    value\n        .get(\"provider_session_id\")\n        .and_then(Value::as_str)\n        .or_else(|| value.get(\"session_id\").and_then(Value::as_str))\n}\n\nfn accepted_provider_session_id(session_id: &str) -> Option<String> {\n    provider_session_id_is_present(session_id).then(|| owned_provider_session_id(session_id))\n}\n\nfn provider_session_id_is_present(session_id: &str) -> bool {\n    !session_id.is_empty()\n}\n\nfn owned_provider_session_id(session_id: &str) -> String {\n    session_id.to_string()\n}","lineStart":1,"lineEnd":83,"totalLines":83,"truncated":false}},"title":"crates/oulipoly-runtime/src/executor/external_provider/launch_result_mapper.rs","time":{"start":1780750097340,"end":1780750097367}},"metadata":{"openai":{"itemId":"fc_08d35cce02e5ccf3016a24171112788190a093b7656f96efb4"}},"id":"prt_e9cfa1bb4001n69mdAw4ii2BaB","sessionID":"ses_1630698a4ffe6jRHOZ2eUQGXQ5","messageID":"msg_e9cf9e636001CPPhroXtHS6CWL"}}
