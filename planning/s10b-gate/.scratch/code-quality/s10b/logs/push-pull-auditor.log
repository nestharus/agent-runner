_terminal_signal_outcome};\nuse crate::wiring;\n\nconst TERMINAL_PERSISTENCE_ERROR_CATEGORY: &str = \"terminal_persistence\";\nconst TERMINAL_PERSISTENCE_TERMINAL_REASON: &str = \"terminal_persistence_failed\";\n\npub(super) struct CompletedAttemptInput<'a, 'state, 'ctx> {\n    pub(super) agent_runtime_services: &'a wiring::AgentRuntimeServices,\n    pub(super) env: &'a BalancedExecutionEnvironment,\n    pub(super) invocation: &'a CompositeInvocationId,\n    pub(super) invocation_row_id: i64,\n    pub(super) guard: &'a mut FinalizerGuard<'state>,\n    pub(super) provider_name: &'a str,\n    pub(super) model: &'a ModelConfig,\n    pub(super) provider_index: usize,\n    pub(super) result: &'a executor::ExecutionResult,\n    pub(super) terminal_signal: &'a Option<executor::TerminalSignal>,\n    pub(super) terminal_signal_ctx: &'a mut TerminalSignalContext<'ctx, std::io::Stderr>,\n    pub(super) all_models: &'a HashMap<String, ModelConfig>,\n    pub(super) working_dir: Option<&'a Path>,\n    pub(super) zero_turn_provider_session_id: Option<&'a str>,\n    pub(super) attempts: usize,\n    pub(super) max_attempts: usize,\n}\n\npub(super) fn finalize_completed_attempt(\n    input: CompletedAttemptInput<'_, '_, '_>,\n) -> BalancedLoopControl {\n    let terminal_signal_disposition =\n        apply_terminal_signal_outcome(input.terminal_signal, input.terminal_signal_ctx);\n    validator::expect_completed_attempt_disposition(terminal_signal_disposition);\n    supervise_captured_child_invocations(\n        &input.env.state,\n        input.invocation_row_id,\n        &input.result.captured_child_invocations,\n        input.result.terminal_reason.as_deref(),\n    );\n\n    emit_session_capture_failure(input.result);\n    update_session_capture(input.env, input.invocation_row_id, input.result);\n\n    let success = execution_succeeded(input.result);\n\n    let error_category = balanced_result_error_category(\n        input.agent_runtime_services,\n        input.result,\n        input.all_models,\n        input.working_dir,\n    );\n    let quota_exhausted = error_category_is_quota_exhausted(error_category.as_deref());\n\n    if let Err(err) = record_returned_artifacts_for_completed_attempt(&input) {\n        finalize_returned_artifacts_persist_failure(mapper::artifact_persist_failure_input(\n            mapper::ArtifactPersistFailureInputSource {\n                agent_runtime_services: input.agent_runtime_services,\n                env: input.env,\n                invocation: input.invocation,\n                invocation_row_id: input.invocation_row_id,\n                guard: input.guard,\n                provider_name: input.provider_name,\n                provider_session_id: input.zero_turn_provider_session_id,\n                error: &err,\n            },\n        ));\n        return BalancedLoopControl::Return(Ok(1));\n    }\n\n    formatter::emit_unknown_diagnostic_if_settled_unknown(\n        &input.env.state,\n        input.provider_name,\n        input.provider_index,\n        input.result,\n        settled_unknown(error_category.as_deref()),\n        \"no_retry\",\n    );\n\n    let finalize_result = input\n        .agent_runtime_services\n        .invocation_lifecycle_service\n        .finalize_invocation(mapper::completed_finalize_request(\n            &input.env.state,\n            input.invocation_row_id,\n            success,\n            input.result.exit_code,\n            error_category.as_deref(),\n            input.result.terminal_reason.as_deref(),\n        ));\n    if let Err(err) = finalize_result {\n        formatter::emit_finalize_invocation_warning(err);\n        formatter::emit_failure_result_envelope(mapper::failure_result_envelope_input(\n            &input.env.state,\n            &input.invocation.id,\n            input.provider_name,\n            input.zero_turn_provider_session_id,\n            1,\n            Some(TERMINAL_PERSISTENCE_ERROR_CATEGORY),\n            Some(TERMINAL_PERSISTENCE_TERMINAL_REASON),\n        ));\n        mark_balanced_attempt_idle(\n            input.zero_turn_provider_session_id,\n            &input.invocation.id,\n            Some(1),\n        );\n        return BalancedLoopControl::Return(Ok(1));\n    }\n    input.guard.mark_finalized();\n\n    if success && let Err(err) = ingest_completed_attempt_session(&input) {\n        return BalancedLoopControl::Return(Err(err));\n    }\n\n    bump_quota_tick(input.env, input.provider_name);\n\n    if success {\n        mark_balanced_successful_attempt_idle_and_recheck(\n            input.zero_turn_provider_session_id,\n            &input.invocation.id,\n            input.result.exit_code,\n        );\n        formatter::emit_success_output(\n            &input.invocation.id,\n            input.result.exit_code,\n            error_category.as_deref(),\n            input.result.terminal_reason.as_deref(),\n            &input.result.stdout,\n        );\n        return BalancedLoopControl::Return(Ok(input.result.exit_code));\n    }\n    if quota_exhausted {\n        mark_balanced_attempt_idle(\n            input.zero_turn_provider_session_id,\n            &input.invocation.id,\n            Some(input.result.exit_code),\n        );\n        if retry_available(input.attempts, input.max_attempts) {\n            formatter::emit_routing_retry(input.provider_name);\n        }\n        return BalancedLoopControl::Continue;\n    }\n\n    formatter::emit_failure_output_with_diagnostics(\n        mapper::completed_attempt_failure_result_envelope_input(\n            &input.env.state,\n            &input.invocation.id,\n            input.provider_name,\n            input.zero_turn_provider_session_id,\n            input.result,\n            error_category.as_deref(),\n        ),\n        &input.result.stderr,\n        error_category.as_deref(),\n    );\n    mark_balanced_attempt_idle(\n        input.zero_turn_provider_session_id,\n        &input.invocation.id,\n        Some(input.result.exit_code),\n    );\n    BalancedLoopControl::Return(Ok(input.result.exit_code))\n}\n\nfn mark_balanced_attempt_idle(\n    provider_session_id: Option<&str>,\n    invocation_uuid: &str,\n    exit_code: Option<i32>,\n) {\n    let Some(provider_session_id) = provider_session_id else {\n        return;\n    };\n    if let Err(err) = crate::wake_coordinator::mark_session_idle_after_turn(\n        provider_session_id,\n        invocation_uuid,\n        exit_code,\n    ) {\n        tracing::warn!(\n            session_id = provider_session_id,\n            invocation_uuid,\n            \"Failed to mark balanced session idle: {err}\"\n        );\n    }\n}\n\nfn mark_balanced_successful_attempt_idle_and_recheck(\n    provider_session_id: Option<&str>,\n    invocation_uuid: &str,\n    exit_code: i32,\n) {\n    let Some(provider_session_id) = provider_session_id else {\n        return;\n    };\n    if let Err(err) = crate::wake_coordinator::mark_successful_turn_idle_and_recheck(\n        provider_session_id,\n        invocation_uuid,\n        exit_code,\n    ) {\n        tracing::warn!(\n            session_id = provider_session_id,\n            invocation_uuid,\n            \"Failed to run balanced wake recheck: {err}\"\n        );\n    }\n}\n\nfn record_returned_artifacts_for_completed_attempt(\n    input: &CompletedAttemptInput<'_, '_, '_>,\n) -> Result<(), String> {\n    super::accessor::record_returned_artifacts(\n        &input.env.state,\n        input.invocation_row_id,\n        &input.result.returned_artifacts,\n    )\n}\n\nfn finalize_returned_artifacts_persist_failure(input: mapper::ArtifactPersistFailureInput<'_, '_>) {\n    formatter::emit_returned_artifacts_error(input.error);\n    let finalize_result = input\n        .agent_runtime_services\n        .invocation_lifecycle_service\n        .finalize_invocation(mapper::returned_artifacts_finalize_request(\n            &input.env.state,\n            input.invocation_row_id,\n        ));\n    formatter::emit_failure_result_envelope(mapper::failure_result_envelope_input(\n        &input.env.state,\n        input.invocation_id,\n        input.provider_name,\n        input.provider_session_id,\n        1,\n        Some(\"returned_artifacts\"),\n        Some(\"returned_artifacts_persist_failed\"),\n    ));\n    match finalize_result {\n        Ok(_) => input.guard.mark_finalized(),\n        Err(err) => formatter::emit_finalize_invocation_warning(err),\n    }\n    mark_balanced_attempt_idle(input.provider_session_id, input.invocation_id, Some(1));\n}\n\nfn ingest_completed_attempt_session(\n    input: &CompletedAttemptInput<'_, '_, '_>,\n) -> Result<(), String> {\n    let ingest_effective_cwd =\n        super::accessor::completed_session_ingest_effective_cwd(input.working_dir)?;\n    let emitted = ingest_and_emit_session_id_resume_aware(\n        input.agent_runtime_services,\n        mapper::completed_session_ingest_request_for_attempt(input, &ingest_effective_cwd),\n    );\n    record_external_session_runtime_if_needed(input, &ingest_effective_cwd);\n    if let Some(session_id) = super::filter::session_ingest_fallback_session_id(\n        emitted,\n        input.result.session_capture.session_id.as_deref(),\n    ) {\n        emit_known_session_id(\n            &input.env.state,\n            input.invocation_row_id,\n            &input.invocation.id,\n            session_id,\n            input.result.session_capture.method.db_value(),\n        );\n    }\n    Ok(())\n}\n\nfn record_external_session_runtime_if_needed(\n    input: &CompletedAttemptInput<'_, '_, '_>,\n    effective_cwd: &Path,\n) {\n    if input.model.provider.is_none() {\n        return;\n    }\n    let Some(session_id) = external_runtime_session_id(input) else {\n        return;\n    };\n    if let Err(err) = record_external_session_runtime(input, session_id, effective_cwd) {\n        tracing::warn!(\n            provider_name = input.provider_name,\n            session_id,\n            \"Failed to record external session runtime cwd: {err}\"\n        );\n    }\n}\n\nfn external_runtime_session_id<'a>(\n    input: &'a CompletedAttemptInput<'_, '_, '_>,\n) -> Option<&'a str> {\n    input\n        .zero_turn_provider_session_id\n        .or(input.result.session_capture.session_id.as_deref())\n}\n\nfn record_external_session_runtime(\n    input: &CompletedAttemptInput<'_, '_, '_>,\n    session_id: &str,\n    effective_cwd: &Path,\n) -> Result<(), String> {\n    let mut db = MailboxDb::open_default()?;\n    let effective_cwd = effective_cwd.to_string_lossy();\n    db.upsert_session_runtime(SessionRuntimeUpsert {\n        session_id,\n        mode: \"headless\",\n        invocation_uuid: Some(&input.invocation.id),\n        provider_name: Some(input.provider_name),\n        model_name: Some(&input.model.name),\n        pty_control_path: None,\n        models_dir: None,\n        effective_cwd: Some(effective_cwd.as_ref()),\n    })\n}","lineStart":1,"lineEnd":331,"totalLines":331,"truncated":false}},"title":"src-tauri/src/run/balancing/finalization.rs","time":{"start":1780750112390,"end":1780750112429}},"metadata":{"openai":{"itemId":"fc_07e500dd1e9430ee016a241720490c8194bc68f5114ad459b2"}},"id":"prt_e9cfa5681001dKe1X4yHc1776r","sessionID":"ses_1630698a4ffe6jRHOZ2eUQGXQ5","messageID":"msg_e9cfa3b95001mpj0ktTYYRQpyn"}}
{"type":"tool_use","timestamp":1780750112435,"sessionID":"ses_1630698a4ffe6jRHOZ2eUQGXQ5","part":{"type":"tool","tool":"read","callID":"call_ptxeqw5zyIySw9O8a3re4RTh","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/age-pid-sidecar/src-tauri/src/run/resume/orchestration.rs","offset":1,"limit":1200},"output":"<path>/home/nes/projects/agent-runner/worktrees/age-pid-sidecar/src-tauri/src/run/resume/orchestration.rs</path>\n<type>file</type>\n<content>\n1: //! ## Declared roles\n2: //!\n3: //! `orchestration`, `validator`, `accessor`, `mapper`, `filter`, `predicate`, `formatter`\n4: \n5: use std::collections::HashMap;\n6: use std::io::IsTerminal;\n7: use std::path::Path;\n8: \n9: use oulipoly_runtime::executor;\n10: use oulipoly_runtime::services::{\n11:     ExecutorServiceRequest, InvocationLifecycleServicePort, MigrationServiceOutput,\n12:     ResumeServiceOutput, ServiceError,\n13: };\n14: \n15: use super::disposition::{\n16:     ResumeLoopControl, ResumeTerminalDispositionInput, confirmed_zero_turn_maybe_quota,\n17:     handle_terminal_signal_disposition,\n18: };\n19: use super::finalization::{\n20:     CompletedAttemptControl, CompletedAttemptInput, finalize_completed_attempt,\n21: };\n22: use super::{formatter, mapper, validator};\n23: use crate::captured_child::emit_captured_child_marker_lines;\n24: use crate::cli::inputs::resolve_resume_answer;\n25: use crate::invocation::finalize::FinalizerGuard;\n26: use crate::migration_providers::load_resume_execution_environment;\n27: use crate::quota_zero_turn::{\n28:     apply_zero_turn_classification_to_result, filter_quota_exhausted_migration_candidates,\n29:     zero_turn_classification_for_action, zero_turn_classify_after_completion,\n30:     zero_turn_record_baseline,\n31: };\n32: use crate::resume_cli::{\n33:     format_resume_error, render_resume_model_pool_mismatch, renderable_resume_execution_target,\n34:     resume_migration_pool,\n35: };\n36: use crate::spawn_cwd::effective_resume_spawn_cwd;\n37: use crate::terminal_outcome_adapter::{\n38:     TerminalSignalDisposition, apply_age153_terminal_signal_fixture_override,\n39:     confirm_maybe_quota_exhausted, resume_terminal_signal_for_outcome,\n40: };\n41: use crate::wiring;\n42: use crate::zero_turn_orchestration::{ZeroTurnConfirmationState, next_action};\n43: \n44: #[allow(clippy::too_many_arguments)]\n45: pub(crate) fn run_resume(\n46:     agent_runtime_services: &wiring::AgentRuntimeServices,\n47:     model_name: Option<&str>,\n48:     session_id: &str,\n49:     manual_migrate: Option<&str>,\n50:     prompt: Option<&str>,\n51:     file: Option<&Path>,\n52:     working_dir: Option<&Path>,\n53:     models_dir_override: Option<&Path>,\n54: ) -> Result<i32, String> {\n55:     if let Some(exit_code) = reject_invalid_resume_input(session_id) {\n56:         return Ok(exit_code);\n57:     }\n58:     if let Some(exit_code) = crate::wake_coordinator::validate_auto_wake_child(session_id)? {\n59:         return Ok(exit_code);\n60:     }\n61:     if !crate::wake_coordinator::is_auto_wake_invocation() {\n62:         crate::wake_coordinator::reset_manual_resume_wake_claim(session_id)?;\n63:     }\n64:     // Source guard marker: agent_runtime_services.resume_service.resolve_resume(ResumeServiceRequest)\n65: \n66:     let mut prepared = match prepare_headless_resume_execution(\n67:         agent_runtime_services,\n68:         model_name,\n69:         session_id,\n70:         prompt,\n71:         file,\n72:         working_dir,\n73:         models_dir_override,\n74:     )? {\n75:         Ok(prepared) => prepared,\n76:         Err(exit_code) => {\n77:             crate::wake_coordinator::release_current_auto_wake_claim_for_session(session_id);\n78:             return Ok(exit_code);\n79:         }\n80:     };\n81:     run_resume_loop(ResumeLoopInput {\n82:         agent_runtime_services,\n83:         prepared: &mut prepared,\n84:         manual_migrate,\n85:         session_id,\n86:         working_dir,\n87:     })\n88: }\n89: \n90: fn reject_invalid_resume_input(session_id: &str) -> Option<i32> {\n91:     match validator::validate_resume_input(session_id) {\n92:         Ok(()) => None,\n93:         Err(message) => {\n94:             formatter::emit_stderr(&message);\n95:             Some(1)\n96:         }\n97:     }\n98: }\n99: \n100: struct PreparedHeadlessResumeExecution {\n101:     answer: Option<String>,\n102:     mailbox_session_id: String,\n103:     mailbox_delivery_seqs: Vec<i64>,\n104:     env: crate::migration_providers::ResumeExecutionEnvironment,\n105:     resolved: oulipoly_state::ResolvedResume,\n106:     effective_spawn_cwd: std::path::PathBuf,\n107:     parent_invocation_id: Option<i64>,\n108:     max_attempts: usize,\n109: }\n110: \n111: #[allow(clippy::too_many_arguments)]\n112: fn prepare_headless_resume_execution(\n113:     agent_runtime_services: &wiring::AgentRuntimeServices,\n114:     model_name: Option<&str>,\n115:     session_id: &str,\n116:     prompt: Option<&str>,\n117:     file: Option<&Path>,\n118:     working_dir: Option<&Path>,\n119:     models_dir_override: Option<&Path>,\n120: ) -> Result<Result<PreparedHeadlessResumeExecution, i32>, String> {\n121:     let answer = resolve_resume_answer(prompt, file)?;\n122:     let env = load_resume_execution_environment(models_dir_override)?;\n123:     let resolved = match resolve_resume_for_headless_execution(\n124:         agent_runtime_services,\n125:         &env,\n126:         session_id,\n127:         model_name,\n128:     ) {\n129:         Ok(resolved) => resolved,\n130:         Err(exit_code) => return Ok(Err(exit_code)),\n131:     };\n132:     if let Err(exit_code) = prepare_initial_headless_resume_target(\n133:         &resolved,\n134:         &env.providers_cfg,\n135:         std::io::stderr().is_terminal(),\n136:     ) {\n137:         return Ok(Err(exit_code));\n138:     }\n139:     let effective_spawn_cwd = effective_resume_execution_cwd(&env, session_id, working_dir)?;\n140:     let parent_invocation_id = crate::dispatch::resolve_parent_invocation_id(&env.state);\n141:     let max_attempts = headless_resume_retry_budget(&resolved);\n142:     let mailbox_delivery = crate::mailbox_delivery::prepare_headless_resume_delivery(\n143:         &resolved,\n144:         answer,\n145:         Some(&env.models_dir),\n146:     )?;\n147:     Ok(Ok(PreparedHeadlessResumeExecution {\n148:         answer: mailbox_delivery.answer,\n149:         mailbox_session_id: mailbox_delivery.session_id,\n150:         mailbox_delivery_seqs: mailbox_delivery.seqs,\n151:         env,\n152:         resolved,\n153:         effective_spawn_cwd,\n154:         parent_invocation_id,\n155:         max_attempts,\n156:     }))\n157: }\n158: \n159: fn effective_resume_execution_cwd(\n160:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n161:     session_id: &str,\n162:     working_dir: Option<&Path>,\n163: ) -> Result<std::path::PathBuf, String> {\n164:     effective_resume_spawn_cwd(\n165:         &env.state,\n166:         &env.models,\n167:         &env.providers_cfg,\n168:         &env.sessions_cfg,\n169:         session_id,\n170:         working_dir,\n171:     )\n172: }\n173: \n174: fn headless_resume_retry_budget(resolved: &oulipoly_state::ResolvedResume) -> usize {\n175:     resolved\n176:         .model\n177:         .as_ref()\n178:         .map(|model| model.providers.len())\n179:         .unwrap_or(1)\n180:         .max(1)\n181:         + 1\n182: }\n183: \n184: struct ResumeLoopInput<'a> {\n185:     agent_runtime_services: &'a wiring::AgentRuntimeServices,\n186:     prepared: &'a mut PreparedHeadlessResumeExecution,\n187:     manual_migrate: Option<&'a str>,\n188:     session_id: &'a str,\n189:     working_dir: Option<&'a Path>,\n190: }\n191: \n192: fn run_resume_loop(input: ResumeLoopInput<'_>) -> Result<i32, String> {\n193:     let mut attempts = 0usize;\n194:     let mut last_exit_code = 1;\n195:     let mut zero_turn_confirmation = ZeroTurnConfirmationState::new();\n196: \n197:     loop {\n198:         if resume_attempts_exhausted(attempts, input.prepared.max_attempts) {\n199:             return Ok(resume_attempts_exhausted_exit_code(last_exit_code));\n200:         }\n201:         attempts += 1;\n202: \n203:         match run_resume_attempt(ResumeAttemptInput {\n204:             agent_runtime_services: input.agent_runtime_services,\n205:             env: &input.prepared.env,\n206:             resolved: &mut input.prepared.resolved,\n207:             answer: input.prepared.answer.as_deref(),\n208:             mailbox_session_id: &input.prepared.mailbox_session_id,\n209:             mailbox_delivery_seqs: &input.prepared.mailbox_delivery_seqs,\n210:             manual_migrate: input.manual_migrate,\n211:             session_id: input.session_id,\n212:             working_dir: input.working_dir,\n213:             attempts,\n214:             max_attempts: input.prepared.max_attempts,\n215:             parent_invocation_id: input.prepared.parent_invocation_id,\n216:             effective_spawn_cwd: &input.prepared.effective_spawn_cwd,\n217:             zero_turn_confirmation: &mut zero_turn_confirmation,\n218:         })? {\n219:             ResumeAttemptLoopControl::Continue(exit_code) => {\n220:                 last_exit_code = exit_code;\n221:                 continue;\n222:             }\n223:             ResumeAttemptLoopControl::Return(exit_code) => return Ok(exit_code),\n224:         }\n225:     }\n226: }\n227: \n228: fn resume_attempts_exhausted(attempts: usize, max_attempts: usize) -> bool {\n229:     attempts >= max_attempts\n230: }\n231: \n232: fn resume_attempts_exhausted_exit_code(last_exit_code: i32) -> i32 {\n233:     formatter::emit_stderr(\"BLOCKED:all-providers-exhausted\");\n234:     normalized_resume_exhausted_exit_code(last_exit_code)\n235: }\n236: \n237: fn normalized_resume_exhausted_exit_code(last_exit_code: i32) -> i32 {\n238:     if last_exit_code == 0 {\n239:         1\n240:     } else {\n241:         last_exit_code\n242:     }\n243: }\n244: \n245: struct ResumeAttemptInput<'a> {\n246:     agent_runtime_services: &'a wiring::AgentRuntimeServices,\n247:     env: &'a crate::migration_providers::ResumeExecutionEnvironment,\n248:     resolved: &'a mut oulipoly_state::ResolvedResume,\n249:     answer: Option<&'a str>,\n250:     mailbox_session_id: &'a str,\n251:     mailbox_delivery_seqs: &'a [i64],\n252:     manual_migrate: Option<&'a str>,\n253:     session_id: &'a str,\n254:     working_dir: Option<&'a Path>,\n255:     attempts: usize,\n256:     max_attempts: usize,\n257:     parent_invocation_id: Option<i64>,\n258:     effective_spawn_cwd: &'a Path,\n259:     zero_turn_confirmation: &'a mut ZeroTurnConfirmationState,\n260: }\n261: \n262: enum ResumeAttemptLoopControl {\n263:     Continue(i32),\n264:     Return(i32),\n265: }\n266: \n267: fn run_resume_attempt(\n268:     mut input: ResumeAttemptInput<'_>,\n269: ) -> Result<ResumeAttemptLoopControl, String> {\n270:     let target = match prepare_resume_attempt_target(&mut input)? {\n271:         Ok(target) => target,\n272:         Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n273:     };\n274:     let provider_index = target.provider_index;\n275:     let provider = target.provider;\n276:     let strategy = match resume_attempt_strategy_for_target(input.resolved, &provider) {\n277:         Ok(strategy) => strategy,\n278:         Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n279:     };\n280: \n281:     let mut attempt = start_resume_invocation(&input, &provider, provider_index)?;\n282:     let provider_session_id = input.resolved.active_session_id.clone();\n283:     bind_resume_attempt_session(\n284:         &input,\n285:         &provider,\n286:         attempt.invocation_row_id,\n287:         &provider_session_id,\n288:     )?;\n289:     let zero_turn_baseline = zero_turn_record_baseline(\n290:         &input.env.state,\n291:         &input.env.sessions_cfg,\n292:         &provider.name,\n293:         Some(&provider_session_id),\n294:     );\n295: \n296:     let invocation_env = resume_invocation_env(&attempt.invocation)?;\n297:     formatter::emit_stderr(&attempt.invocation.stderr_line());\n298: \n299:     let mut result = match execute_resume_attempt_command(\n300:         &input,\n301:         &provider,\n302:         provider_index,\n303:         target.prompt_mode,\n304:         &invocation_env,\n305:         strategy,\n306:     ) {\n307:         Ok(result) => result,\n308:         Err(_spawn_err) => {\n309:             finalize_resume_spawn_error(&input, &mut attempt)?;\n310:             return Ok(ResumeAttemptLoopControl::Return(1));\n311:         }\n312:     };\n313:     apply_resume_attempt_classification(\n314:         input.env,\n315:         &provider.name,\n316:         &provider_session_id,\n317:         &zero_turn_baseline,\n318:         input.zero_turn_confirmation,\n319:         &mut result,\n320:     )\n321:     .and_then(|zero_turn_action| {\n322:         record_resume_acceptance_if_present(&input, attempt.invocation_row_id, &result)?;\n323:         emit_captured_child_marker_lines(&result.captured_child_invocations);\n324:         handle_resume_attempt_terminal_signal(\n325:             &input,\n326:             &mut attempt,\n327:             &provider,\n328:             &provider_session_id,\n329:             &result,\n330:             zero_turn_action,\n331:         )\n332:     })\n333: }\n334: \n335: fn resume_attempt_strategy_for_target<'a>(\n336:     resolved: &oulipoly_state::ResolvedResume,\n337:     provider: &'a oulipoly_config::ProviderConfig,\n338: ) -> Result<Option<&'a oulipoly_config::ResumeStrategy>, i32> {\n339:     if resolved_uses_provider_ref(resolved) {\n340:         return Ok(None);\n341:     }\n342:     resume_attempt_strategy(provider).map(Some)\n343: }\n344: \n345: fn resume_attempt_strategy(\n346:     provider: &oulipoly_config::ProviderConfig,\n347: ) -> Result<&oulipoly_config::ResumeStrategy, i32> {\n348:     provider\n349:         .resume\n350:         .as_ref()\n351:         .ok_or_else(|| missing_resume_block_exit_code(&provider.name))\n352: }\n353: \n354: fn missing_resume_block_exit_code(provider_name: &str) -> i32 {\n355:     formatter::emit_missing_resume_block(provider_name);\n356:     1\n357: }\n358: \n359: fn execute_resume_attempt_command(\n360:     input: &ResumeAttemptInput<'_>,\n361:     provider: &oulipoly_config::ProviderConfig,\n362:     provider_index: usize,\n363:     prompt_mode: oulipoly_config::PromptMode,\n364:     invocation_env: &str,\n365:     strategy: Option<&oulipoly_config::ResumeStrategy>,\n366: ) -> Result<executor::ExecutionResult, String> {\n367:     if let Some(request) = provider_ref_resume_executor_request(\n368:         input,\n369:         provider,\n370:         provider_index,\n371:         prompt_mode,\n372:         invocation_env,\n373:     ) {\n374:         return input\n375:             .agent_runtime_services\n376:             .executor_service\n377:             .execute(request)\n378:             .map(|output| output.result)\n379:             .map_err(|err| err.to_string());\n380:     }\n381:     executor::cli::execute_resume_optional_prompt_with_model_identity(\n382:         provider,\n383:         provider_index,\n384:         prompt_mode,\n385:         input.answer,\n386:         Some(input.effective_spawn_cwd),\n387:         Some(invocation_env),\n388:         executor::cli::ResumePayload {\n389:             session_id: &input.resolved.active_session_id,\n390:             strategy: strategy.expect(\"legacy resume target must have a resume strategy\"),\n391:         },\n392:         input.resolved.model_name.as_deref().unwrap_or(\"<unknown>\"),\n393:     )\n394: }\n395: \n396: fn provider_ref_resume_executor_request(\n397:     input: &ResumeAttemptInput<'_>,\n398:     provider: &oulipoly_config::ProviderConfig,\n399:     provider_index: usize,\n400:     prompt_mode: oulipoly_config::PromptMode,\n401:     invocation_env: &str,\n402: ) -> Option<ExecutorServiceRequest> {\n403:     let model = input.resolved.model.as_ref()?;\n404:     model.provider.as_ref()?;\n405:     Some(\n406:         ExecutorServiceRequest::EffectiveWithStartKnownProviderSessionId {\n407:             model: model.clone(),\n408:             provider: provider.clone(),\n409:             provider_index,\n410:             prompt_mode,\n411:             prompt: input.answer.unwrap_or_default().to_string(),\n412:             working_dir: Some(input.effective_spawn_cwd.to_path_buf()),\n413:             extra_inputs: HashMap::new(),\n414:             parent_invocation_env: Some(invocation_env.to_string()),\n415:             start_known_provider_session_id: input.resolved.active_session_id.clone(),\n416:         },\n417:     )\n418: }\n419: \n420: fn finalize_resume_spawn_error(\n421:     input: &ResumeAttemptInput<'_>,\n422:     attempt: &mut ResumeInvocationAttempt<'_>,\n423: ) -> Result<(), String> {\n424:     input\n425:         .agent_runtime_services\n426:         .invocation_lifecycle_service\n427:         .finalize_invocation(mapper::spawn_error_finalize_request(\n428:             &input.env.state,\n429:             attempt.invocation_row_id,\n430:         ))\n431:         .map_err(|err| err.to_string())?;\n432:     attempt.guard.mark_finalized();\n433:     mark_resume_attempt_idle(\n434:         &input.resolved.active_session_id,\n435:         &attempt.invocation.id,\n436:         Some(1),\n437:     )?;\n438:     Ok(())\n439: }\n440: \n441: fn prepare_resume_attempt_target(\n442:     input: &mut ResumeAttemptInput<'_>,\n443: ) -> Result<Result<crate::resume_cli::ResumeExecutionTarget, i32>, String> {\n444:     let mut target =\n445:         match renderable_resume_execution_target(input.resolved, &input.env.providers_cfg) {\n446:             Ok(target) => target,\n447:             Err(exit_code) => return Ok(Err(exit_code)),\n448:         };\n449:     if let Err(exit_code) = migrate_resume_target(\n450:         input.agent_runtime_services,\n451:         input.env,\n452:         input.resolved,\n453:         &mut target,\n454:         input.manual_migrate,\n455:         input.attempts,\n456:         input.effective_spawn_cwd,\n457:     ) {\n458:         return Ok(Err(exit_code));\n459:     }\n460:     Ok(Ok(target))\n461: }\n462: \n463: struct ResumeInvocationAttempt<'state> {\n464:     invocation: oulipoly_state::CompositeInvocationId,\n465:     invocation_row_id: i64,\n466:     guard: FinalizerGuard<'state>,\n467: }\n468: \n469: fn start_resume_invocation<'state>(\n470:     input: &ResumeAttemptInput<'state>,\n471:     provider: &oulipoly_config::ProviderConfig,\n472:     provider_index: usize,\n473: ) -> Result<ResumeInvocationAttempt<'state>, String> {\n474:     let invocation = mapper::composite_invocation_id(&provider.name);\n475:     let invocation_start = mapper::resume_invocation_start(\n476:         &invocation,\n477:         input.resolved.model_name.as_deref(),\n478:         &provider.name,\n479:         provider_index,\n480:         input.parent_invocation_id,\n481:     );\n482:     let invocation_row_id = input\n483:         .agent_runtime_services\n484:         .invocation_lifecycle_service\n485:         .start_invocation(mapper::invocation_lifecycle_start_request(\n486:             &input.env.state,\n487:             &invocation_start,\n488:         ))\n489:         .map_err(|err| err.to_string())?\n490:         .invocation_row_id;\n491:     let guard = FinalizerGuard::new(&input.env.state, invocation_row_id);\n492:     Ok(ResumeInvocationAttempt {\n493:         invocation,\n494:         invocation_row_id,\n495:         guard,\n496:     })\n497: }\n498: \n499: fn bind_resume_attempt_session(\n500:     input: &ResumeAttemptInput<'_>,\n501:     provider: &oulipoly_config::ProviderConfig,\n502:     invocation_row_id: i64,\n503:     provider_session_id: &str,\n504: ) -> Result<(), String> {\n505:     input.env.state.bind_invocation_provider_session_start(\n506:         invocation_row_id,\n507:         &mapper::resumed_provider_session_binding(\n508:             provider,\n509:             provider_session_id,\n510:             Some(input.session_id.to_string()),\n511:         ),\n512:     )?;\n513:     if should_record_legacy_resume_input(input.manual_migrate) {\n514:         record_legacy_resume_input_session_id(input, invocation_row_id)?;\n515:     }\n516:     Ok(())\n517: }\n518: \n519: fn should_record_legacy_resume_input(manual_migrate: Option<&str>) -> bool {\n520:     manual_migrate.is_some()\n521: }\n522: \n523: fn record_legacy_resume_input_session_id(\n524:     input: &ResumeAttemptInput<'_>,\n525:     invocation_row_id: i64,\n526: ) -> Result<(), String> {\n527:     input\n528:         .env\n529:         .state\n530:         .record_legacy_resume_input_session_id(invocation_row_id, input.session_id)\n531: }\n532: \n533: fn resume_invocation_env(\n534:     invocation: &oulipoly_state::CompositeInvocationId,\n535: ) -> Result<String, String> {\n536:     serde_json::to_string(invocation).map_err(|e| format!(\"Failed to serialize invocation id: {e}\"))\n537: }\n538: \n539: fn apply_resume_attempt_classification(\n540:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n541:     provider_name: &str,\n542:     provider_session_id: &str,\n543:     zero_turn_baseline: &crate::zero_turn_orchestration::ZeroTurnBaseline,\n544:     zero_turn_confirmation: &mut ZeroTurnConfirmationState,\n545:     result: &mut executor::ExecutionResult,\n546: ) -> Result<crate::zero_turn_orchestration::ZeroTurnAction, String> {\n547:     apply_age153_terminal_signal_fixture_override(result);\n548:     let zero_turn_classification =\n549:         zero_turn_classify_after_completion(&env.state, &env.sessions_cfg, zero_turn_baseline);\n550:     apply_zero_turn_classification_to_result(result, provider_name, &zero_turn_classification);\n551:     Ok(next_action(\n552:         zero_turn_confirmation,\n553:         zero_turn_classification_for_action(\n554:             zero_turn_classification,\n555:             result,\n556:             provider_name,\n557:             Some(provider_session_id),\n558:         ),\n559:     ))\n560: }\n561: \n562: fn record_resume_acceptance_if_present(\n563:     input: &ResumeAttemptInput<'_>,\n564:     invocation_row_id: i64,\n565:     result: &executor::ExecutionResult,\n566: ) -> Result<(), String> {\n567:     let Some(acceptance) = resume_acceptance_result(result) else {\n568:         return Ok(());\n569:     };\n570:     record_resume_acceptance(input, invocation_row_id, acceptance)\n571: }\n572: \n573: fn resume_acceptance_result(\n574:     result: &executor::ExecutionResult,\n575: ) -> Option<&oulipoly_runtime::executor::ResumeAcceptanceResult> {\n576:     result.resume_acceptance.as_ref()\n577: }\n578: \n579: fn record_resume_acceptance(\n580:     input: &ResumeAttemptInput<'_>,\n581:     invocation_row_id: i64,\n582:     acceptance: &oulipoly_runtime::executor::ResumeAcceptanceResult,\n583: ) -> Result<(), String> {\n584:     input\n585:         .agent_runtime_services\n586:         .resume_service\n587:         .record_acceptance(mapper::resume_acceptance_request(\n588:             &input.env.state,\n589:             invocation_row_id,\n590:             acceptance,\n591:         ))\n592:         .map_err(format_resume_acceptance_service_error)?;\n593:     Ok(())\n594: }\n595: \n596: fn format_resume_acceptance_service_error(err: oulipoly_runtime::services::ServiceError) -> String {\n597:     format!(\"resume acceptance service failed: {err}\")\n598: }\n599: \n600: fn handle_resume_attempt_terminal_signal(\n601:     input: &ResumeAttemptInput<'_>,\n602:     attempt: &mut ResumeInvocationAttempt<'_>,\n603:     provider: &oulipoly_config::ProviderConfig,\n604:     provider_session_id: &str,\n605:     result: &executor::ExecutionResult,\n606:     zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n607: ) -> Result<ResumeAttemptLoopControl, String> {\n608:     let terminal_signal_disposition = terminal_signal_disposition_for_result(\n609:         &input.env.state,\n610:         &attempt.invocation.id,\n611:         &provider.name,\n612:         provider_session_id,\n613:         result,\n614:         zero_turn_action,\n615:     );\n616: \n617:     match handle_terminal_signal_disposition(ResumeTerminalDispositionInput {\n618:         agent_runtime_services: input.agent_runtime_services,\n619:         env: input.env,\n620:         invocation_row_id: attempt.invocation_row_id,\n621:         guard: &mut attempt.guard,\n622:         result,\n623:         terminal_signal_disposition,\n624:         zero_turn_action,\n625:     })? {\n626:         ResumeLoopControl::Continue => {\n627:             mark_resume_attempt_idle(\n628:                 provider_session_id,\n629:                 &attempt.invocation.id,\n630:                 Some(result.exit_code),\n631:             )?;\n632:             return Ok(ResumeAttemptLoopControl::Continue(result.exit_code));\n633:         }\n634:         ResumeLoopControl::Return(exit_code) => {\n635:             mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n636:             return Ok(ResumeAttemptLoopControl::Return(exit_code));\n637:         }\n638:         ResumeLoopControl::CompletedAttempt => {}\n639:     }\n640: \n641:     match finalize_completed_attempt(CompletedAttemptInput {\n642:         agent_runtime_services: input.agent_runtime_services,\n643:         env: input.env,\n644:         invocation: &attempt.invocation,\n645:         invocation_row_id: attempt.invocation_row_id,\n646:         guard: &mut attempt.guard,\n647:         provider_name: &provider.name,\n648:         model: input.resolved.model.as_ref(),\n649:         result,\n650:         working_dir: input.working_dir,\n651:         manual_migrate: input.manual_migrate,\n652:         session_id: input.session_id,\n653:         active_session_id: &input.resolved.active_session_id,\n654:         effective_spawn_cwd: input.effective_spawn_cwd,\n655:         attempts: input.attempts,\n656:         max_attempts: input.max_attempts,\n657:     })? {\n658:         CompletedAttemptControl::Continue => {\n659:             mark_resume_attempt_idle(\n660:                 provider_session_id,\n661:                 &attempt.invocation.id,\n662:                 Some(result.exit_code),\n663:             )?;\n664:             Ok(ResumeAttemptLoopControl::Continue(result.exit_code))\n665:         }\n666:         CompletedAttemptControl::Return(exit_code) => {\n667:             if exit_code == 0 {\n668:                 crate::mailbox_delivery::mark_headless_resume_delivered(\n669:                     input.mailbox_session_id,\n670:                     input.mailbox_delivery_seqs,\n671:                     &attempt.invocation.id,\n672:                 )?;\n673:                 let _ = crate::wake_coordinator::mark_successful_turn_idle_and_recheck(\n674:                     provider_session_id,\n675:                     &attempt.invocation.id,\n676:                     exit_code,\n677:                 )?;\n678:             } else {\n679:                 mark_resume_attempt_idle(\n680:                     provider_session_id,\n681:                     &attempt.invocation.id,\n682:                     Some(exit_code),\n683:                 )?;\n684:             }\n685:             Ok(ResumeAttemptLoopControl::Return(exit_code))\n686:         }\n687:     }\n688: }\n689: \n690: fn mark_resume_attempt_idle(\n691:     provider_session_id: &str,\n692:     invocation_uuid: &str,\n693:     exit_code: Option<i32>,\n694: ) -> Result<(), String> {\n695:     crate::wake_coordinator::mark_session_idle_after_turn(\n696:         provider_session_id,\n697:         invocation_uuid,\n698:         exit_code,\n699:     )\n700: }\n701: \n702: fn resolve_resume_for_headless_execution(\n703:     agent_runtime_services: &wiring::AgentRuntimeServices,\n704:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n705:     session_id: &str,\n706:     model_name: Option<&str>,\n707: ) -> Result<oulipoly_state::ResolvedResume, i32> {\n708:     let output = agent_runtime_services\n709:         .resume_service\n710:         .resolve_resume(mapper::resume_service_request(env, session_id, model_name))\n711:         .map_err(|err| err.to_string());\n712:     headless_resume_resolution_result(output, env, session_id, model_name)\n713: }\n714: \n715: fn headless_resume_resolution_result(\n716:     output: Result<ResumeServiceOutput, String>,\n717:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n718:     session_id: &str,\n719:     model_name: Option<&str>,\n720: ) -> Result<oulipoly_state::ResolvedResume, i32> {\n721:     match output {\n722:         Ok(ResumeServiceOutput::ResumeResolved { resolved }) => Ok(resolved),\n723:         Ok(ResumeServiceOutput::ResumeRejected {\n724:             error:\n725:                 oulipoly_state::ResumeError::ProviderModelMismatch {\n726:                     active_provider, ..\n727:                 },\n728:         }) => {\n729:             render_resume_model_pool_mismatch(\n730:                 &env.models,\n731:                 model_name.unwrap_or(\"<unknown>\"),\n732:                 session_id,\n733:                 &active_provider,\n734:             );\n735:             Err(1)\n736:         }\n737:         Ok(ResumeServiceOutput::ResumeRejected { error }) => {\n738:             render_resume_error(error);\n739:             Err(1)\n740:         }\n741:         Err(err) => {\n742:             render_resume_service_failure(&err);\n743:             Err(1)\n744:         }\n745:     }\n746: }\n747: \n748: fn render_resume_error(error: oulipoly_state::ResumeError) {\n749:     formatter::emit_stderr(&format_resume_error(error));\n750: }\n751: \n752: fn render_resume_service_failure(error: &str) {\n753:     formatter::emit_stderr(&format!(\"resume service failed: {error}\"));\n754: }\n755: \n756: fn prepare_initial_headless_resume_target(\n757:     resolved: &oulipoly_state::ResolvedResume,\n758:     providers_cfg: &oulipoly_config::ProvidersConfig,\n759:     stderr_is_terminal: bool,\n760: ) -> Result<(), i32> {\n761:     let target = renderable_resume_execution_target(resolved, providers_cfg)?;\n762:     render_resume_short_line_if_needed(stderr_is_terminal, &resolved.active_provider);\n763:     validate_headless_resume_target(resolved, &target, &resolved.active_provider)\n764: }\n765: \n766: fn render_resume_short_line_if_needed(stderr_is_terminal: bool, selected_provider: &str) {\n767:     if crate::dispatch::should_emit_resume_short_line(stderr_is_terminal) {\n768:         formatter::emit_resume_short_line(selected_provider);\n769:     }\n770: }\n771: \n772: fn validate_headless_resume_target(\n773:     resolved: &oulipoly_state::ResolvedResume,\n774:     target: &crate::resume_cli::ResumeExecutionTarget,\n775:     selected_provider: &str,\n776: ) -> Result<(), i32> {\n777:     if resolved_uses_provider_ref(resolved) {\n778:         return validate_provider_ref_headless_resume_target(resolved, target, selected_provider)\n779:             .map_err(|message| provider_ref_resume_block_exit_code(&message));\n780:     }\n781:     if headless_resume_target_has_resume(target) {\n782:         Ok(())\n783:     } else {\n784:         Err(headless_missing_resume_block_exit_code(selected_provider))\n785:     }\n786: }\n787: \n788: fn validate_provider_ref_headless_resume_target(\n789:     resolved: &oulipoly_state::ResolvedResume,\n790:     target: &crate::resume_cli::ResumeExecutionTarget,\n791:     selected_provider: &str,\n792: ) -> Result<(), String> {\n793:     let Some(model) = provider_ref_resolved_model(resolved) else {\n794:         return Err(provider_ref_missing_model_message(selected_provider));\n795:     };\n796:     if !provider_ref_model_has_implementation(model) {\n797:         return Err(provider_ref_missing_implementation_message(\n798:             selected_provider,\n799:         ));\n800:     }\n801:     let Some(target_member_name) = provider_ref_target_member_name(model, target.provider_index)\n802:     else {\n803:         return Err(provider_ref_invalid_index_message(\n804:             selected_provider,\n805:             target.provider_index,\n806:         ));\n807:     };\n808:     if target_member_name != selected_provider {\n809:         return Err(provider_ref_resolved_provider_message(\n810:             selected_provider,\n811:             target_member_name,\n812:         ));\n813:     }\n814:     let loaded_provider_name = provider_ref_loaded_provider_name(target);\n815:     if loaded_provider_name != selected_provider {\n816:         return Err(provider_ref_loaded_provider_message(\n817:             selected_provider,\n818:             loaded_provider_name,\n819:         ));\n820:     }\n821:     Ok(())\n822: }\n823: \n824: fn provider_ref_resolved_model(\n825:     resolved: &oulipoly_state::ResolvedResume,\n826: ) -> Option<&oulipoly_config::ModelConfig> {\n827:     resolved.model.as_ref()\n828: }\n829: \n830: fn provider_ref_model_has_implementation(model: &oulipoly_config::ModelConfig) -> bool {\n831:     model.provider.is_some()\n832: }\n833: \n834: fn provider_ref_target_member_name(\n835:     model: &oulipoly_config::ModelConfig,\n836:     provider_index: usize,\n837: ) -> Option<&str> {\n838:     model\n839:         .providers\n840:         .get(provider_index)\n841:         .map(|provider| provider.name.as_str())\n842: }\n843: \n844: fn provider_ref_loaded_provider_name(target: &crate::resume_cli::ResumeExecutionTarget) -> &str {\n845:     &target.provider.name\n846: }\n847: \n848: fn provider_ref_missing_model_message(selected_provider: &str) -> String {\n849:     format!(\"provider-ref resume target {selected_provider} has no model config\")\n850: }\n851: \n852: fn provider_ref_missing_implementation_message(selected_provider: &str) -> String {\n853:     format!(\"provider-ref resume target {selected_provider} has no provider implementation\")\n854: }\n855: \n856: fn provider_ref_invalid_index_message(selected_provider: &str, provider_index: usize) -> String {\n857:     format!(\n858:         \"provider-ref resume target {selected_provider} has invalid provider index {provider_index}\"\n859:     )\n860: }\n861: \n862: fn provider_ref_resolved_provider_message(\n863:     selected_provider: &str,\n864:     resolved_provider: &str,\n865: ) -> String {\n866:     format!(\"provider-ref resume target {selected_provider} resolved provider {resolved_provider}\")\n867: }\n868: \n869: fn provider_ref_loaded_provider_message(selected_provider: &str, loaded_provider: &str) -> String {\n870:     format!(\"provider-ref resume target {selected_provider} loaded provider {loaded_provider}\")\n871: }\n872: \n873: fn headless_resume_target_has_resume(target: &crate::resume_cli::ResumeExecutionTarget) -> bool {\n874:     target.provider.resume.is_some()\n875: }\n876: \n877: fn headless_missing_resume_block_exit_code(selected_provider: &str) -> i32 {\n878:     formatter::emit_missing_resume_block(selected_provider);\n879:     1\n880: }\n881: \n882: fn provider_ref_resume_block_exit_code(message: &str) -> i32 {\n883:     formatter::emit_stderr(message);\n884:     1\n885: }\n886: \n887: fn migrate_resume_target(\n888:     agent_runtime_services: &wiring::AgentRuntimeServices,\n889:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n890:     resolved: &mut oulipoly_state::ResolvedResume,\n891:     target: &mut crate::resume_cli::ResumeExecutionTarget,\n892:     manual_migrate: Option<&str>,\n893:     attempts: usize,\n894:     effective_spawn_cwd: &Path,\n895: ) -> Result<(), i32> {\n896:     if should_skip_provider_ref_default_migration(resolved, manual_migrate) {\n897:         validate_provider_ref_headless_resume_target(resolved, target, &resolved.active_provider)\n898:             .map_err(|message| provider_ref_resume_block_exit_code(&message))?;\n899:         return Ok(());\n900:     }\n901:     let migration_model = migration_model_for_attempt(env, resolved, manual_migrate, attempts);\n902:     match dispatch_resume_migration(\n903:         agent_runtime_services,\n904:         env,\n905:         resolved,\n906:         manual_migrate,\n907:         attempts,\n908:         effective_spawn_cwd,\n909:         &migration_model,\n910:     ) {\n911:         Ok(MigrationServiceOutput::Migrated { segment: migrated })\n912:         | Ok(MigrationServiceOutput::AutoRotated {\n913:             segment: migrated, ..\n914:         }) => apply_migrated_segment(env, resolved, target, migrated),\n915:         Ok(MigrationServiceOutput::Stay) => Ok(()),\n916:         Ok(MigrationServiceOutput::RotationFailed { reason }) => fail_rotation(reason),\n917:         Err(err) => fail_migration_service(err),\n918:     }\n919: }\n920: \n921: fn should_skip_provider_ref_default_migration(\n922:     resolved: &oulipoly_state::ResolvedResume,\n923:     manual_migrate: Option<&str>,\n924: ) -> bool {\n925:     manual_migrate.is_none() && resolved_uses_provider_ref(resolved)\n926: }\n927: \n928: fn resolved_uses_provider_ref(resolved: &oulipoly_state::ResolvedResume) -> bool {\n929:     resolved\n930:         .model\n931:         .as_ref()\n932:         .is_some_and(|model| model.provider.is_some())\n933: }\n934: \n935: fn migration_model_for_attempt(\n936:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n937:     resolved: &oulipoly_state::ResolvedResume,\n938:     manual_migrate: Option<&str>,\n939:     attempts: usize,\n940: ) -> oulipoly_config::ModelConfig {\n941:     let mut migration_model = migration_model_pool(env, resolved);\n942:     apply_migration_candidate_filter(\n943:         env,\n944:         resolved,\n945:         manual_migrate,\n946:         attempts,\n947:         &mut migration_model,\n948:     );\n949:     migration_model\n950: }\n951: \n952: fn apply_migration_candidate_filter(\n953:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n954:     resolved: &oulipoly_state::ResolvedResume,\n955:     manual_migrate: Option<&str>,\n956:     attempts: usize,\n957:     migration_model: &mut oulipoly_config::ModelConfig,\n958: ) {\n959:     if should_filter_migration_candidates(manual_migrate, attempts) {\n960:         filter_quota_exhausted_migration_model(env, resolved, migration_model);\n961:     }\n962: }\n963: \n964: fn migration_model_pool(\n965:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n966:     resolved: &oulipoly_state::ResolvedResume,\n967: ) -> oulipoly_config::ModelConfig {\n968:     resume_migration_pool(resolved, &env.providers_cfg)\n969: }\n970: \n971: fn filter_quota_exhausted_migration_model(\n972:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n973:     resolved: &oulipoly_state::ResolvedResume,\n974:     migration_model: &mut oulipoly_config::ModelConfig,\n975: ) {\n976:     filter_quota_exhausted_migration_candidates(\n977:         &env.state,\n978:         migration_model,\n979:         &resolved.active_provider,\n980:     );\n981: }\n982: \n983: fn should_filter_migration_candidates(manual_migrate: Option<&str>, attempts: usize) -> bool {\n984:     manual_migrate.is_none() || attempts > 1\n985: }\n986: \n987: fn dispatch_resume_migration(\n988:     agent_runtime_services: &wiring::AgentRuntimeServices,\n989:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n990:     resolved: &oulipoly_state::ResolvedResume,\n991:     manual_migrate: Option<&str>,\n992:     attempts: usize,\n993:     effective_spawn_cwd: &Path,\n994:     migration_model: &oulipoly_config::ModelConfig,\n995: ) -> Result<MigrationServiceOutput, ServiceError> {\n996:     let mut migration_stderr = std::io::stderr();\n997:     agent_runtime_services\n998:         .migration_service\n999:         .migrate(mapper::migration_service_request(\n1000:             mapper::ResumeMigrationRequestInput {\n1001:                 env,\n1002:                 resolved,\n1003:                 manual_target: super::filter::first_attempt_manual_migrate(\n1004:                     attempts,\n1005:                     manual_migrate,\n1006:                 ),\n1007:                 active_exhausted: false,\n1008:                 migration_model,\n1009:                 effective_cwd: effective_spawn_cwd,\n1010:                 stderr: &mut migration_stderr,\n1011:                 _stderr_lifetime: std::marker::PhantomData,\n1012:             },\n1013:         ))\n1014: }\n1015: \n1016: fn apply_migrated_segment(\n1017:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n1018:     resolved: &mut oulipoly_state::ResolvedResume,\n1019:     target: &mut crate::resume_cli::ResumeExecutionTarget,\n1020:     migrated: oulipoly_runtime::migration::MigratedSegment,\n1021: ) -> Result<(), i32> {\n1022:     resolved.active_provider = migrated.target_provider;\n1023:     resolved.active_session_id = migrated.target_session_id;\n1024:     *target = renderable_resume_execution_target(resolved, &env.providers_cfg)?;\n1025:     Ok(())\n1026: }\n1027: \n1028: fn fail_rotation(reason: oulipoly_runtime::services::RotationFailedReason) -> Result<(), i32> {\n1029:     formatter::emit_stderr(&formatter::rotation_failed_reason(&reason));\n1030:     Err(1)\n1031: }\n1032: \n1033: fn fail_migration_service(err: ServiceError) -> Result<(), i32> {\n1034:     emit_migration_service_error(migration_service_error_message(err));\n1035:     Err(1)\n1036: }\n1037: \n1038: enum MigrationServiceErrorMessage {\n1039:     Dependency(String),\n1040:     Service(ServiceError),\n1041: }\n1042: \n1043: fn migration_service_error_message(err: ServiceError) -> MigrationServiceErrorMessage {\n1044:     match err {\n1045:         ServiceError::Dependency { message } => MigrationServiceErrorMessage::Dependency(message),\n1046:         err => MigrationServiceErrorMessage::Service(err),\n1047:     }\n1048: }\n1049: \n1050: fn emit_migration_service_error(message: MigrationServiceErrorMessage) {\n1051:     match message {\n1052:         MigrationServiceErrorMessage::Dependency(message) => {\n1053:             formatter::emit_migration_dependency_failure(&message);\n1054:         }\n1055:         MigrationServiceErrorMessage::Service(err) => {\n1056:             formatter::emit_migration_service_failure(&err);\n1057:         }\n1058:     }\n1059: }\n1060: \n1061: fn terminal_signal_disposition_for_result(\n1062:     state_db: &oulipoly_state::StateDb,\n1063:     invocation_id: &str,\n1064:     provider_name: &str,\n1065:     provider_session_id: &str,\n1066:     result: &executor::ExecutionResult,\n1067:     zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n1068: ) -> TerminalSignalDisposition {\n1069:     let context_ids = mapper::terminal_signal_context_ids(invocation_id, Some(provider_session_id));\n1070:     let mut terminal_signal_stderr = std::io::stderr();\n1071:     let mut terminal_signal_ctx = mapper::terminal_signal_context_for_attempt(\n1072:         &context_ids,\n1073:         provider_name,\n1074:         state_db,\n1075:         &mut terminal_signal_stderr,\n1076:     );\n1077:     let terminal_signal = resume_terminal_signal_for_outcome(&result.terminal_signal);\n1078: \n1079:     resume_terminal_signal_disposition(zero_turn_action, &terminal_signal, &mut terminal_signal_ctx)\n1080: }\n1081: \n1082: fn resume_terminal_signal_disposition(\n1083:     zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n1084:     terminal_signal: &Option<oulipoly_runtime::executor::TerminalSignal>,\n1085:     terminal_signal_ctx: &mut crate::terminal_outcome_adapter::TerminalSignalContext<\n1086:         '_,\n1087:         std::io::Stderr,\n1088:     >,\n1089: ) -> TerminalSignalDisposition {\n1090:     match confirmed_maybe_quota_signal(zero_turn_action, terminal_signal) {\n1091:         Some(signal) => {\n1092:             let _ = confirm_maybe_quota_exhausted(signal, terminal_signal_ctx);\n1093:             TerminalSignalDisposition::MaybeQuotaVerify\n1094:         }\n1095:         None => apply_resume_terminal_signal_outcome(terminal_signal, terminal_signal_ctx),\n1096:     }\n1097: }\n1098: \n1099: fn confirmed_maybe_quota_signal(\n1100:     zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n1101:     terminal_signal: &Option<oulipoly_runtime::executor::TerminalSignal>,\n1102: ) -> Option<&oulipoly_runtime::executor::TerminalSignal> {\n1103:     confirmed_zero_turn_maybe_quota(zero_turn_action, terminal_signal)\n1104:         .then_some(terminal_signal.as_ref())\n1105:         .flatten()\n1106: }\n1107: \n1108: fn apply_resume_terminal_signal_outcome(\n1109:     terminal_signal: &Option<oulipoly_runtime::executor::TerminalSignal>,\n1110:     terminal_signal_ctx: &mut crate::terminal_outcome_adapter::TerminalSignalContext<\n1111:         '_,\n1112:         std::io::Stderr,\n1113:     >,\n1114: ) -> TerminalSignalDisposition {\n1115:     crate::terminal_outcome_adapter::apply_terminal_signal_outcome(\n1116:         terminal_signal,\n1117:         terminal_signal_ctx,\n1118:     )\n1119: }\n\n(End of file - total 1119 lines)\n</content>","metadata":{"preview":"//! ## Declared roles\n//!\n//! `orchestration`, `validator`, `accessor`, `mapper`, `filter`, `predicate`, `formatter`\n\nuse std::collections::HashMap;\nuse std::io::IsTerminal;\nuse std::path::Path;\n\nuse oulipoly_runtime::executor;\nuse oulipoly_runtime::services::{\n    ExecutorServiceRequest, InvocationLifecycleServicePort, MigrationServiceOutput,\n    ResumeServiceOutput, ServiceError,\n};\n\nuse super::disposition::{\n    ResumeLoopControl, ResumeTerminalDispositionInput, confirmed_zero_turn_maybe_quota,\n    handle_terminal_signal_disposition,\n};\nuse super::finalization::{\n    CompletedAttemptControl, CompletedAttemptInput, finalize_completed_attempt,","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/age-pid-sidecar/src-tauri/src/run/resume/orchestration.rs","text":"//! ## Declared roles\n//!\n//! `orchestration`, `validator`, `accessor`, `mapper`, `filter`, `predicate`, `formatter`\n\nuse std::collections::HashMap;\nuse std::io::IsTerminal;\nuse std::path::Path;\n\nuse oulipoly_runtime::executor;\nuse oulipoly_runtime::services::{\n    ExecutorServiceRequest, InvocationLifecycleServicePort, MigrationServiceOutput,\n    ResumeServiceOutput, ServiceError,\n};\n\nuse super::disposition::{\n    ResumeLoopControl, ResumeTerminalDispositionInput, confirmed_zero_turn_maybe_quota,\n    handle_terminal_signal_disposition,\n};\nuse super::finalization::{\n    CompletedAttemptControl, CompletedAttemptInput, finalize_completed_attempt,\n};\nuse super::{formatter, mapper, validator};\nuse crate::captured_child::emit_captured_child_marker_lines;\nuse crate::cli::inputs::resolve_resume_answer;\nuse crate::invocation::finalize::FinalizerGuard;\nuse crate::migration_providers::load_resume_execution_environment;\nuse crate::quota_zero_turn::{\n    apply_zero_turn_classification_to_result, filter_quota_exhausted_migration_candidates,\n    zero_turn_classification_for_action, zero_turn_classify_after_completion,\n    zero_turn_record_baseline,\n};\nuse crate::resume_cli::{\n    format_resume_error, render_resume_model_pool_mismatch, renderable_resume_execution_target,\n    resume_migration_pool,\n};\nuse crate::spawn_cwd::effective_resume_spawn_cwd;\nuse crate::terminal_outcome_adapter::{\n    TerminalSignalDisposition, apply_age153_terminal_signal_fixture_override,\n    confirm_maybe_quota_exhausted, resume_terminal_signal_for_outcome,\n};\nuse crate::wiring;\nuse crate::zero_turn_orchestration::{ZeroTurnConfirmationState, next_action};\n\n#[allow(clippy::too_many_arguments)]\npub(crate) fn run_resume(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    model_name: Option<&str>,\n    session_id: &str,\n    manual_migrate: Option<&str>,\n    prompt: Option<&str>,\n    file: Option<&Path>,\n    working_dir: Option<&Path>,\n    models_dir_override: Option<&Path>,\n) -> Result<i32, String> {\n    if let Some(exit_code) = reject_invalid_resume_input(session_id) {\n        return Ok(exit_code);\n    }\n    if let Some(exit_code) = crate::wake_coordinator::validate_auto_wake_child(session_id)? {\n        return Ok(exit_code);\n    }\n    if !crate::wake_coordinator::is_auto_wake_invocation() {\n        crate::wake_coordinator::reset_manual_resume_wake_claim(session_id)?;\n    }\n    // Source guard marker: agent_runtime_services.resume_service.resolve_resume(ResumeServiceRequest)\n\n    let mut prepared = match prepare_headless_resume_execution(\n        agent_runtime_services,\n        model_name,\n        session_id,\n        prompt,\n        file,\n        working_dir,\n        models_dir_override,\n    )? {\n        Ok(prepared) => prepared,\n        Err(exit_code) => {\n            crate::wake_coordinator::release_current_auto_wake_claim_for_session(session_id);\n            return Ok(exit_code);\n        }\n    };\n    run_resume_loop(ResumeLoopInput {\n        agent_runtime_services,\n        prepared: &mut prepared,\n        manual_migrate,\n        session_id,\n        working_dir,\n    })\n}\n\nfn reject_invalid_resume_input(session_id: &str) -> Option<i32> {\n    match validator::validate_resume_input(session_id) {\n        Ok(()) => None,\n        Err(message) => {\n            formatter::emit_stderr(&message);\n            Some(1)\n        }\n    }\n}\n\nstruct PreparedHeadlessResumeExecution {\n    answer: Option<String>,\n    mailbox_session_id: String,\n    mailbox_delivery_seqs: Vec<i64>,\n    env: crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: oulipoly_state::ResolvedResume,\n    effective_spawn_cwd: std::path::PathBuf,\n    parent_invocation_id: Option<i64>,\n    max_attempts: usize,\n}\n\n#[allow(clippy::too_many_arguments)]\nfn prepare_headless_resume_execution(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    model_name: Option<&str>,\n    session_id: &str,\n    prompt: Option<&str>,\n    file: Option<&Path>,\n    working_dir: Option<&Path>,\n    models_dir_override: Option<&Path>,\n) -> Result<Result<PreparedHeadlessResumeExecution, i32>, String> {\n    let answer = resolve_resume_answer(prompt, file)?;\n    let env = load_resume_execution_environment(models_dir_override)?;\n    let resolved = match resolve_resume_for_headless_execution(\n        agent_runtime_services,\n        &env,\n        session_id,\n        model_name,\n    ) {\n        Ok(resolved) => resolved,\n        Err(exit_code) => return Ok(Err(exit_code)),\n    };\n    if let Err(exit_code) = prepare_initial_headless_resume_target(\n        &resolved,\n        &env.providers_cfg,\n        std::io::stderr().is_terminal(),\n    ) {\n        return Ok(Err(exit_code));\n    }\n    let effective_spawn_cwd = effective_resume_execution_cwd(&env, session_id, working_dir)?;\n    let parent_invocation_id = crate::dispatch::resolve_parent_invocation_id(&env.state);\n    let max_attempts = headless_resume_retry_budget(&resolved);\n    let mailbox_delivery = crate::mailbox_delivery::prepare_headless_resume_delivery(\n        &resolved,\n        answer,\n        Some(&env.models_dir),\n    )?;\n    Ok(Ok(PreparedHeadlessResumeExecution {\n        answer: mailbox_delivery.answer,\n        mailbox_session_id: mailbox_delivery.session_id,\n        mailbox_delivery_seqs: mailbox_delivery.seqs,\n        env,\n        resolved,\n        effective_spawn_cwd,\n        parent_invocation_id,\n        max_attempts,\n    }))\n}\n\nfn effective_resume_execution_cwd(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    session_id: &str,\n    working_dir: Option<&Path>,\n) -> Result<std::path::PathBuf, String> {\n    effective_resume_spawn_cwd(\n        &env.state,\n        &env.models,\n        &env.providers_cfg,\n        &env.sessions_cfg,\n        session_id,\n        working_dir,\n    )\n}\n\nfn headless_resume_retry_budget(resolved: &oulipoly_state::ResolvedResume) -> usize {\n    resolved\n        .model\n        .as_ref()\n        .map(|model| model.providers.len())\n        .unwrap_or(1)\n        .max(1)\n        + 1\n}\n\nstruct ResumeLoopInput<'a> {\n    agent_runtime_services: &'a wiring::AgentRuntimeServices,\n    prepared: &'a mut PreparedHeadlessResumeExecution,\n    manual_migrate: Option<&'a str>,\n    session_id: &'a str,\n    working_dir: Option<&'a Path>,\n}\n\nfn run_resume_loop(input: ResumeLoopInput<'_>) -> Result<i32, String> {\n    let mut attempts = 0usize;\n    let mut last_exit_code = 1;\n    let mut zero_turn_confirmation = ZeroTurnConfirmationState::new();\n\n    loop {\n        if resume_attempts_exhausted(attempts, input.prepared.max_attempts) {\n            return Ok(resume_attempts_exhausted_exit_code(last_exit_code));\n        }\n        attempts += 1;\n\n        match run_resume_attempt(ResumeAttemptInput {\n            agent_runtime_services: input.agent_runtime_services,\n            env: &input.prepared.env,\n            resolved: &mut input.prepared.resolved,\n            answer: input.prepared.answer.as_deref(),\n            mailbox_session_id: &input.prepared.mailbox_session_id,\n            mailbox_delivery_seqs: &input.prepared.mailbox_delivery_seqs,\n            manual_migrate: input.manual_migrate,\n            session_id: input.session_id,\n            working_dir: input.working_dir,\n            attempts,\n            max_attempts: input.prepared.max_attempts,\n            parent_invocation_id: input.prepared.parent_invocation_id,\n            effective_spawn_cwd: &input.prepared.effective_spawn_cwd,\n            zero_turn_confirmation: &mut zero_turn_confirmation,\n        })? {\n            ResumeAttemptLoopControl::Continue(exit_code) => {\n                last_exit_code = exit_code;\n                continue;\n            }\n            ResumeAttemptLoopControl::Return(exit_code) => return Ok(exit_code),\n        }\n    }\n}\n\nfn resume_attempts_exhausted(attempts: usize, max_attempts: usize) -> bool {\n    attempts >= max_attempts\n}\n\nfn resume_attempts_exhausted_exit_code(last_exit_code: i32) -> i32 {\n    formatter::emit_stderr(\"BLOCKED:all-providers-exhausted\");\n    normalized_resume_exhausted_exit_code(last_exit_code)\n}\n\nfn normalized_resume_exhausted_exit_code(last_exit_code: i32) -> i32 {\n    if last_exit_code == 0 {\n        1\n    } else {\n        last_exit_code\n    }\n}\n\nstruct ResumeAttemptInput<'a> {\n    agent_runtime_services: &'a wiring::AgentRuntimeServices,\n    env: &'a crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: &'a mut oulipoly_state::ResolvedResume,\n    answer: Option<&'a str>,\n    mailbox_session_id: &'a str,\n    mailbox_delivery_seqs: &'a [i64],\n    manual_migrate: Option<&'a str>,\n    session_id: &'a str,\n    working_dir: Option<&'a Path>,\n    attempts: usize,\n    max_attempts: usize,\n    parent_invocation_id: Option<i64>,\n    effective_spawn_cwd: &'a Path,\n    zero_turn_confirmation: &'a mut ZeroTurnConfirmationState,\n}\n\nenum ResumeAttemptLoopControl {\n    Continue(i32),\n    Return(i32),\n}\n\nfn run_resume_attempt(\n    mut input: ResumeAttemptInput<'_>,\n) -> Result<ResumeAttemptLoopControl, String> {\n    let target = match prepare_resume_attempt_target(&mut input)? {\n        Ok(target) => target,\n        Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n    };\n    let provider_index = target.provider_index;\n    let provider = target.provider;\n    let strategy = match resume_attempt_strategy_for_target(input.resolved, &provider) {\n        Ok(strategy) => strategy,\n        Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n    };\n\n    let mut attempt = start_resume_invocation(&input, &provider, provider_index)?;\n    let provider_session_id = input.resolved.active_session_id.clone();\n    bind_resume_attempt_session(\n        &input,\n        &provider,\n        attempt.invocation_row_id,\n        &provider_session_id,\n    )?;\n    let zero_turn_baseline = zero_turn_record_baseline(\n        &input.env.state,\n        &input.env.sessions_cfg,\n        &provider.name,\n        Some(&provider_session_id),\n    );\n\n    let invocation_env = resume_invocation_env(&attempt.invocation)?;\n    formatter::emit_stderr(&attempt.invocation.stderr_line());\n\n    let mut result = match execute_resume_attempt_command(\n        &input,\n        &provider,\n        provider_index,\n        target.prompt_mode,\n        &invocation_env,\n        strategy,\n    ) {\n        Ok(result) => result,\n        Err(_spawn_err) => {\n            finalize_resume_spawn_error(&input, &mut attempt)?;\n            return Ok(ResumeAttemptLoopControl::Return(1));\n        }\n    };\n    apply_resume_attempt_classification(\n        input.env,\n        &provider.name,\n        &provider_session_id,\n        &zero_turn_baseline,\n        input.zero_turn_confirmation,\n        &mut result,\n    )\n    .and_then(|zero_turn_action| {\n        record_resume_acceptance_if_present(&input, attempt.invocation_row_id, &result)?;\n        emit_captured_child_marker_lines(&result.captured_child_invocations);\n        handle_resume_attempt_terminal_signal(\n            &input,\n            &mut attempt,\n            &provider,\n            &provider_session_id,\n            &result,\n            zero_turn_action,\n        )\n    })\n}\n\nfn resume_attempt_strategy_for_target<'a>(\n    resolved: &oulipoly_state::ResolvedResume,\n    provider: &'a oulipoly_config::ProviderConfig,\n) -> Result<Option<&'a oulipoly_config::ResumeStrategy>, i32> {\n    if resolved_uses_provider_ref(resolved) {\n        return Ok(None);\n    }\n    resume_attempt_strategy(provider).map(Some)\n}\n\nfn resume_attempt_strategy(\n    provider: &oulipoly_config::ProviderConfig,\n) -> Result<&oulipoly_config::ResumeStrategy, i32> {\n    provider\n        .resume\n        .as_ref()\n        .ok_or_else(|| missing_resume_block_exit_code(&provider.name))\n}\n\nfn missing_resume_block_exit_code(provider_name: &str) -> i32 {\n    formatter::emit_missing_resume_block(provider_name);\n    1\n}\n\nfn execute_resume_attempt_command(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_index: usize,\n    prompt_mode: oulipoly_config::PromptMode,\n    invocation_env: &str,\n    strategy: Option<&oulipoly_config::ResumeStrategy>,\n) -> Result<executor::ExecutionResult, String> {\n    if let Some(request) = provider_ref_resume_executor_request(\n        input,\n        provider,\n        provider_index,\n        prompt_mode,\n        invocation_env,\n    ) {\n        return input\n            .agent_runtime_services\n            .executor_service\n            .execute(request)\n            .map(|output| output.result)\n            .map_err(|err| err.to_string());\n    }\n    executor::cli::execute_resume_optional_prompt_with_model_identity(\n        provider,\n        provider_index,\n        prompt_mode,\n        input.answer,\n        Some(input.effective_spawn_cwd),\n        Some(invocation_env),\n        executor::cli::ResumePayload {\n            session_id: &input.resolved.active_session_id,\n            strategy: strategy.expect(\"legacy resume target must have a resume strategy\"),\n        },\n        input.resolved.model_name.as_deref().unwrap_or(\"<unknown>\"),\n    )\n}\n\nfn provider_ref_resume_executor_request(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_index: usize,\n    prompt_mode: oulipoly_config::PromptMode,\n    invocation_env: &str,\n) -> Option<ExecutorServiceRequest> {\n    let model = input.resolved.model.as_ref()?;\n    model.provider.as_ref()?;\n    Some(\n        ExecutorServiceRequest::EffectiveWithStartKnownProviderSessionId {\n            model: model.clone(),\n            provider: provider.clone(),\n            provider_index,\n            prompt_mode,\n            prompt: input.answer.unwrap_or_default().to_string(),\n            working_dir: Some(input.effective_spawn_cwd.to_path_buf()),\n            extra_inputs: HashMap::new(),\n            parent_invocation_env: Some(invocation_env.to_string()),\n            start_known_provider_session_id: input.resolved.active_session_id.clone(),\n        },\n    )\n}\n\nfn finalize_resume_spawn_error(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n) -> Result<(), String> {\n    input\n        .agent_runtime_services\n        .invocation_lifecycle_service\n        .finalize_invocation(mapper::spawn_error_finalize_request(\n            &input.env.state,\n            attempt.invocation_row_id,\n        ))\n        .map_err(|err| err.to_string())?;\n    attempt.guard.mark_finalized();\n    mark_resume_attempt_idle(\n        &input.resolved.active_session_id,\n        &attempt.invocation.id,\n        Some(1),\n    )?;\n    Ok(())\n}\n\nfn prepare_resume_attempt_target(\n    input: &mut ResumeAttemptInput<'_>,\n) -> Result<Result<crate::resume_cli::ResumeExecutionTarget, i32>, String> {\n    let mut target =\n        match renderable_resume_execution_target(input.resolved, &input.env.providers_cfg) {\n            Ok(target) => target,\n            Err(exit_code) => return Ok(Err(exit_code)),\n        };\n    if let Err(exit_code) = migrate_resume_target(\n        input.agent_runtime_services,\n        input.env,\n        input.resolved,\n        &mut target,\n        input.manual_migrate,\n        input.attempts,\n        input.effective_spawn_cwd,\n    ) {\n        return Ok(Err(exit_code));\n    }\n    Ok(Ok(target))\n}\n\nstruct ResumeInvocationAttempt<'state> {\n    invocation: oulipoly_state::CompositeInvocationId,\n    invocation_row_id: i64,\n    guard: FinalizerGuard<'state>,\n}\n\nfn start_resume_invocation<'state>(\n    input: &ResumeAttemptInput<'state>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_index: usize,\n) -> Result<ResumeInvocationAttempt<'state>, String> {\n    let invocation = mapper::composite_invocation_id(&provider.name);\n    let invocation_start = mapper::resume_invocation_start(\n        &invocation,\n        input.resolved.model_name.as_deref(),\n        &provider.name,\n        provider_index,\n        input.parent_invocation_id,\n    );\n    let invocation_row_id = input\n        .agent_runtime_services\n        .invocation_lifecycle_service\n        .start_invocation(mapper::invocation_lifecycle_start_request(\n            &input.env.state,\n            &invocation_start,\n        ))\n        .map_err(|err| err.to_string())?\n        .invocation_row_id;\n    let guard = FinalizerGuard::new(&input.env.state, invocation_row_id);\n    Ok(ResumeInvocationAttempt {\n        invocation,\n        invocation_row_id,\n        guard,\n    })\n}\n\nfn bind_resume_attempt_session(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    invocation_row_id: i64,\n    provider_session_id: &str,\n) -> Result<(), String> {\n    input.env.state.bind_invocation_provider_session_start(\n        invocation_row_id,\n        &mapper::resumed_provider_session_binding(\n            provider,\n            provider_session_id,\n            Some(input.session_id.to_string()),\n        ),\n    )?;\n    if should_record_legacy_resume_input(input.manual_migrate) {\n        record_legacy_resume_input_session_id(input, invocation_row_id)?;\n    }\n    Ok(())\n}\n\nfn should_record_legacy_resume_input(manual_migrate: Option<&str>) -> bool {\n    manual_migrate.is_some()\n}\n\nfn record_legacy_resume_input_session_id(\n    input: &ResumeAttemptInput<'_>,\n    invocation_row_id: i64,\n) -> Result<(), String> {\n    input\n        .env\n        .state\n        .record_legacy_resume_input_session_id(invocation_row_id, input.session_id)\n}\n\nfn resume_invocation_env(\n    invocation: &oulipoly_state::CompositeInvocationId,\n) -> Result<String, String> {\n    serde_json::to_string(invocation).map_err(|e| format!(\"Failed to serialize invocation id: {e}\"))\n}\n\nfn apply_resume_attempt_classification(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    provider_name: &str,\n    provider_session_id: &str,\n    zero_turn_baseline: &crate::zero_turn_orchestration::ZeroTurnBaseline,\n    zero_turn_confirmation: &mut ZeroTurnConfirmationState,\n    result: &mut executor::ExecutionResult,\n) -> Result<crate::zero_turn_orchestration::ZeroTurnAction, String> {\n    apply_age153_terminal_signal_fixture_override(result);\n    let zero_turn_classification =\n        zero_turn_classify_after_completion(&env.state, &env.sessions_cfg, zero_turn_baseline);\n    apply_zero_turn_classification_to_result(result, provider_name, &zero_turn_classification);\n    Ok(next_action(\n        zero_turn_confirmation,\n        zero_turn_classification_for_action(\n            zero_turn_classification,\n            result,\n            provider_name,\n            Some(provider_session_id),\n        ),\n    ))\n}\n\nfn record_resume_acceptance_if_present(\n    input: &ResumeAttemptInput<'_>,\n    invocation_row_id: i64,\n    result: &executor::ExecutionResult,\n) -> Result<(), String> {\n    let Some(acceptance) = resume_acceptance_result(result) else {\n        return Ok(());\n    };\n    record_resume_acceptance(input, invocation_row_id, acceptance)\n}\n\nfn resume_acceptance_result(\n    result: &executor::ExecutionResult,\n) -> Option<&oulipoly_runtime::executor::ResumeAcceptanceResult> {\n    result.resume_acceptance.as_ref()\n}\n\nfn record_resume_acceptance(\n    input: &ResumeAttemptInput<'_>,\n    invocation_row_id: i64,\n    acceptance: &oulipoly_runtime::executor::ResumeAcceptanceResult,\n) -> Result<(), String> {\n    input\n        .agent_runtime_services\n        .resume_service\n        .record_acceptance(mapper::resume_acceptance_request(\n            &input.env.state,\n            invocation_row_id,\n            acceptance,\n        ))\n        .map_err(format_resume_acceptance_service_error)?;\n    Ok(())\n}\n\nfn format_resume_acceptance_service_error(err: oulipoly_runtime::services::ServiceError) -> String {\n    format!(\"resume acceptance service failed: {err}\")\n}\n\nfn handle_resume_attempt_terminal_signal(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n) -> Result<ResumeAttemptLoopControl, String> {\n    let terminal_signal_disposition = terminal_signal_disposition_for_result(\n        &input.env.state,\n        &attempt.invocation.id,\n        &provider.name,\n        provider_session_id,\n        result,\n        zero_turn_action,\n    );\n\n    match handle_terminal_signal_disposition(ResumeTerminalDispositionInput {\n        agent_runtime_services: input.agent_runtime_services,\n        env: input.env,\n        invocation_row_id: attempt.invocation_row_id,\n        guard: &mut attempt.guard,\n        result,\n        terminal_signal_disposition,\n        zero_turn_action,\n    })? {\n        ResumeLoopControl::Continue => {\n            mark_resume_attempt_idle(\n                provider_session_id,\n                &attempt.invocation.id,\n                Some(result.exit_code),\n            )?;\n            return Ok(ResumeAttemptLoopControl::Continue(result.exit_code));\n        }\n        ResumeLoopControl::Return(exit_code) => {\n            mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n            return Ok(ResumeAttemptLoopControl::Return(exit_code));\n        }\n        ResumeLoopControl::CompletedAttempt => {}\n    }\n\n    match finalize_completed_attempt(CompletedAttemptInput {\n        agent_runtime_services: input.agent_runtime_services,\n        env: input.env,\n        invocation: &attempt.invocation,\n        invocation_row_id: attempt.invocation_row_id,\n        guard: &mut attempt.guard,\n        provider_name: &provider.name,\n        model: input.resolved.model.as_ref(),\n        result,\n        working_dir: input.working_dir,\n        manual_migrate: input.manual_migrate,\n        session_id: input.session_id,\n        active_session_id: &input.resolved.active_session_id,\n        effective_spawn_cwd: input.effective_spawn_cwd,\n        attempts: input.attempts,\n        max_attempts: input.max_attempts,\n    })? {\n        CompletedAttemptControl::Continue => {\n            mark_resume_attempt_idle(\n                provider_session_id,\n                &attempt.invocation.id,\n                Some(result.exit_code),\n            )?;\n            Ok(ResumeAttemptLoopControl::Continue(result.exit_code))\n        }\n        CompletedAttemptControl::Return(exit_code) => {\n            if exit_code == 0 {\n                crate::mailbox_delivery::mark_headless_resume_delivered(\n                    input.mailbox_session_id,\n                    input.mailbox_delivery_seqs,\n                    &attempt.invocation.id,\n                )?;\n                let _ = crate::wake_coordinator::mark_successful_turn_idle_and_recheck(\n                    provider_session_id,\n                    &attempt.invocation.id,\n                    exit_code,\n                )?;\n            } else {\n                mark_resume_attempt_idle(\n                    provider_session_id,\n                    &attempt.invocation.id,\n                    Some(exit_code),\n                )?;\n            }\n            Ok(ResumeAttemptLoopControl::Return(exit_code))\n        }\n    }\n}\n\nfn mark_resume_attempt_idle(\n    provider_session_id: &str,\n    invocation_uuid: &str,\n    exit_code: Option<i32>,\n) -> Result<(), String> {\n    crate::wake_coordinator::mark_session_idle_after_turn(\n        provider_session_id,\n        invocation_uuid,\n        exit_code,\n    )\n}\n\nfn resolve_resume_for_headless_execution(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    session_id: &str,\n    model_name: Option<&str>,\n) -> Result<oulipoly_state::ResolvedResume, i32> {\n    let output = agent_runtime_services\n        .resume_service\n        .resolve_resume(mapper::resume_service_request(env, session_id, model_name))\n        .map_err(|err| err.to_string());\n    headless_resume_resolution_result(output, env, session_id, model_name)\n}\n\nfn headless_resume_resolution_result(\n    output: Result<ResumeServiceOutput, String>,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    session_id: &str,\n    model_name: Option<&str>,\n) -> Result<oulipoly_state::ResolvedResume, i32> {\n    match output {\n        Ok(ResumeServiceOutput::ResumeResolved { resolved }) => Ok(resolved),\n        Ok(ResumeServiceOutput::ResumeRejected {\n            error:\n                oulipoly_state::ResumeError::ProviderModelMismatch {\n                    active_provider, ..\n                },\n        }) => {\n            render_resume_model_pool_mismatch(\n                &env.models,\n                model_name.unwrap_or(\"<unknown>\"),\n                session_id,\n                &active_provider,\n            );\n            Err(1)\n        }\n        Ok(ResumeServiceOutput::ResumeRejected { error }) => {\n            render_resume_error(error);\n            Err(1)\n        }\n        Err(err) => {\n            render_resume_service_failure(&err);\n            Err(1)\n        }\n    }\n}\n\nfn render_resume_error(error: oulipoly_state::ResumeError) {\n    formatter::emit_stderr(&format_resume_error(error));\n}\n\nfn render_resume_service_failure(error: &str) {\n    formatter::emit_stderr(&format!(\"resume service failed: {error}\"));\n}\n\nfn prepare_initial_headless_resume_target(\n    resolved: &oulipoly_state::ResolvedResume,\n    providers_cfg: &oulipoly_config::ProvidersConfig,\n    stderr_is_terminal: bool,\n) -> Result<(), i32> {\n    let target = renderable_resume_execution_target(resolved, providers_cfg)?;\n    render_resume_short_line_if_needed(stderr_is_terminal, &resolved.active_provider);\n    validate_headless_resume_target(resolved, &target, &resolved.active_provider)\n}\n\nfn render_resume_short_line_if_needed(stderr_is_terminal: bool, selected_provider: &str) {\n    if crate::dispatch::should_emit_resume_short_line(stderr_is_terminal) {\n        formatter::emit_resume_short_line(selected_provider);\n    }\n}\n\nfn validate_headless_resume_target(\n    resolved: &oulipoly_state::ResolvedResume,\n    target: &crate::resume_cli::ResumeExecutionTarget,\n    selected_provider: &str,\n) -> Result<(), i32> {\n    if resolved_uses_provider_ref(resolved) {\n        return validate_provider_ref_headless_resume_target(resolved, target, selected_provider)\n            .map_err(|message| provider_ref_resume_block_exit_code(&message));\n    }\n    if headless_resume_target_has_resume(target) {\n        Ok(())\n    } else {\n        Err(headless_missing_resume_block_exit_code(selected_provider))\n    }\n}\n\nfn validate_provider_ref_headless_resume_target(\n    resolved: &oulipoly_state::ResolvedResume,\n    target: &crate::resume_cli::ResumeExecutionTarget,\n    selected_provider: &str,\n) -> Result<(), String> {\n    let Some(model) = provider_ref_resolved_model(resolved) else {\n        return Err(provider_ref_missing_model_message(selected_provider));\n    };\n    if !provider_ref_model_has_implementation(model) {\n        return Err(provider_ref_missing_implementation_message(\n            selected_provider,\n        ));\n    }\n    let Some(target_member_name) = provider_ref_target_member_name(model, target.provider_index)\n    else {\n        return Err(provider_ref_invalid_index_message(\n            selected_provider,\n            target.provider_index,\n        ));\n    };\n    if target_member_name != selected_provider {\n        return Err(provider_ref_resolved_provider_message(\n            selected_provider,\n            target_member_name,\n        ));\n    }\n    let loaded_provider_name = provider_ref_loaded_provider_name(target);\n    if loaded_provider_name != selected_provider {\n        return Err(provider_ref_loaded_provider_message(\n            selected_provider,\n            loaded_provider_name,\n        ));\n    }\n    Ok(())\n}\n\nfn provider_ref_resolved_model(\n    resolved: &oulipoly_state::ResolvedResume,\n) -> Option<&oulipoly_config::ModelConfig> {\n    resolved.model.as_ref()\n}\n\nfn provider_ref_model_has_implementation(model: &oulipoly_config::ModelConfig) -> bool {\n    model.provider.is_some()\n}\n\nfn provider_ref_target_member_name(\n    model: &oulipoly_config::ModelConfig,\n    provider_index: usize,\n) -> Option<&str> {\n    model\n        .providers\n        .get(provider_index)\n        .map(|provider| provider.name.as_str())\n}\n\nfn provider_ref_loaded_provider_name(target: &crate::resume_cli::ResumeExecutionTarget) -> &str {\n    &target.provider.name\n}\n\nfn provider_ref_missing_model_message(selected_provider: &str) -> String {\n    format!(\"provider-ref resume target {selected_provider} has no model config\")\n}\n\nfn provider_ref_missing_implementation_message(selected_provider: &str) -> String {\n    format!(\"provider-ref resume target {selected_provider} has no provider implementation\")\n}\n\nfn provider_ref_invalid_index_message(selected_provider: &str, provider_index: usize) -> String {\n    format!(\n        \"provider-ref resume target {selected_provider} has invalid provider index {provider_index}\"\n    )\n}\n\nfn provider_ref_resolved_provider_message(\n    selected_provider: &str,\n    resolved_provider: &str,\n) -> String {\n    format!(\"provider-ref resume target {selected_provider} resolved provider {resolved_provider}\")\n}\n\nfn provider_ref_loaded_provider_message(selected_provider: &str, loaded_provider: &str) -> String {\n    format!(\"provider-ref resume target {selected_provider} loaded provider {loaded_provider}\")\n}\n\nfn headless_resume_target_has_resume(target: &crate::resume_cli::ResumeExecutionTarget) -> bool {\n    target.provider.resume.is_some()\n}\n\nfn headless_missing_resume_block_exit_code(selected_provider: &str) -> i32 {\n    formatter::emit_missing_resume_block(selected_provider);\n    1\n}\n\nfn provider_ref_resume_block_exit_code(message: &str) -> i32 {\n    formatter::emit_stderr(message);\n    1\n}\n\nfn migrate_resume_target(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: &mut oulipoly_state::ResolvedResume,\n    target: &mut crate::resume_cli::ResumeExecutionTarget,\n    manual_migrate: Option<&str>,\n    attempts: usize,\n    effective_spawn_cwd: &Path,\n) -> Result<(), i32> {\n    if should_skip_provider_ref_default_migration(resolved, manual_migrate) {\n        validate_provider_ref_headless_resume_target(resolved, target, &resolved.active_provider)\n            .map_err(|message| provider_ref_resume_block_exit_code(&message))?;\n        return Ok(());\n    }\n    let migration_model = migration_model_for_attempt(env, resolved, manual_migrate, attempts);\n    match dispatch_resume_migration(\n        agent_runtime_services,\n        env,\n        resolved,\n        manual_migrate,\n        attempts,\n        effective_spawn_cwd,\n        &migration_model,\n    ) {\n        Ok(MigrationServiceOutput::Migrated { segment: migrated })\n        | Ok(MigrationServiceOutput::AutoRotated {\n            segment: migrated, ..\n        }) => apply_migrated_segment(env, resolved, target, migrated),\n        Ok(MigrationServiceOutput::Stay) => Ok(()),\n        Ok(MigrationServiceOutput::RotationFailed { reason }) => fail_rotation(reason),\n        Err(err) => fail_migration_service(err),\n    }\n}\n\nfn should_skip_provider_ref_default_migration(\n    resolved: &oulipoly_state::ResolvedResume,\n    manual_migrate: Option<&str>,\n) -> bool {\n    manual_migrate.is_none() && resolved_uses_provider_ref(resolved)\n}\n\nfn resolved_uses_provider_ref(resolved: &oulipoly_state::ResolvedResume) -> bool {\n    resolved\n        .model\n        .as_ref()\n        .is_some_and(|model| model.provider.is_some())\n}\n\nfn migration_model_for_attempt(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: &oulipoly_state::ResolvedResume,\n    manual_migrate: Option<&str>,\n    attempts: usize,\n) -> oulipoly_config::ModelConfig {\n    let mut migration_model = migration_model_pool(env, resolved);\n    apply_migration_candidate_filter(\n        env,\n        resolved,\n        manual_migrate,\n        attempts,\n        &mut migration_model,\n    );\n    migration_model\n}\n\nfn apply_migration_candidate_filter(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: &oulipoly_state::ResolvedResume,\n    manual_migrate: Option<&str>,\n    attempts: usize,\n    migration_model: &mut oulipoly_config::ModelConfig,\n) {\n    if should_filter_migration_candidates(manual_migrate, attempts) {\n        filter_quota_exhausted_migration_model(env, resolved, migration_model);\n    }\n}\n\nfn migration_model_pool(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: &oulipoly_state::ResolvedResume,\n) -> oulipoly_config::ModelConfig {\n    resume_migration_pool(resolved, &env.providers_cfg)\n}\n\nfn filter_quota_exhausted_migration_model(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: &oulipoly_state::ResolvedResume,\n    migration_model: &mut oulipoly_config::ModelConfig,\n) {\n    filter_quota_exhausted_migration_candidates(\n        &env.state,\n        migration_model,\n        &resolved.active_provider,\n    );\n}\n\nfn should_filter_migration_candidates(manual_migrate: Option<&str>, attempts: usize) -> bool {\n    manual_migrate.is_none() || attempts > 1\n}\n\nfn dispatch_resume_migration(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: &oulipoly_state::ResolvedResume,\n    manual_migrate: Option<&str>,\n    attempts: usize,\n    effective_spawn_cwd: &Path,\n    migration_model: &oulipoly_config::ModelConfig,\n) -> Result<MigrationServiceOutput, ServiceError> {\n    let mut migration_stderr = std::io::stderr();\n    agent_runtime_services\n        .migration_service\n        .migrate(mapper::migration_service_request(\n            mapper::ResumeMigrationRequestInput {\n                env,\n                resolved,\n                manual_target: super::filter::first_attempt_manual_migrate(\n                    attempts,\n                    manual_migrate,\n                ),\n                active_exhausted: false,\n                migration_model,\n                effective_cwd: effective_spawn_cwd,\n                stderr: &mut migration_stderr,\n                _stderr_lifetime: std::marker::PhantomData,\n            },\n        ))\n}\n\nfn apply_migrated_segment(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: &mut oulipoly_state::ResolvedResume,\n    target: &mut crate::resume_cli::ResumeExecutionTarget,\n    migrated: oulipoly_runtime::migration::MigratedSegment,\n) -> Result<(), i32> {\n    resolved.active_provider = migrated.target_provider;\n    resolved.active_session_id = migrated.target_session_id;\n    *target = renderable_resume_execution_target(resolved, &env.providers_cfg)?;\n    Ok(())\n}\n\nfn fail_rotation(reason: oulipoly_runtime::services::RotationFailedReason) -> Result<(), i32> {\n    formatter::emit_stderr(&formatter::rotation_failed_reason(&reason));\n    Err(1)\n}\n\nfn fail_migration_service(err: ServiceError) -> Result<(), i32> {\n    emit_migration_service_error(migration_service_error_message(err));\n    Err(1)\n}\n\nenum MigrationServiceErrorMessage {\n    Dependency(String),\n    Service(ServiceError),\n}\n\nfn migration_service_error_message(err: ServiceError) -> MigrationServiceErrorMessage {\n    match err {\n        ServiceError::Dependency { message } => MigrationServiceErrorMessage::Dependency(message),\n        err => MigrationServiceErrorMessage::Service(err),\n    }\n}\n\nfn emit_migration_service_error(message: MigrationServiceErrorMessage) {\n    match message {\n        MigrationServiceErrorMessage::Dependency(message) => {\n            formatter::emit_migration_dependency_failure(&message);\n        }\n        MigrationServiceErrorMessage::Service(err) => {\n            formatter::emit_migration_service_failure(&err);\n        }\n    }\n}\n\nfn terminal_signal_disposition_for_result(\n    state_db: &oulipoly_state::StateDb,\n    invocation_id: &str,\n    provider_name: &str,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n) -> TerminalSignalDisposition {\n    let context_ids = mapper::terminal_signal_context_ids(invocation_id, Some(provider_session_id));\n    let mut terminal_signal_stderr = std::io::stderr();\n    let mut terminal_signal_ctx = mapper::terminal_signal_context_for_attempt(\n        &context_ids,\n        provider_name,\n        state_db,\n        &mut terminal_signal_stderr,\n    );\n    let terminal_signal = resume_terminal_signal_for_outcome(&result.terminal_signal);\n\n    resume_terminal_signal_disposition(zero_turn_action, &terminal_signal, &mut terminal_signal_ctx)\n}\n\nfn resume_terminal_signal_disposition(\n    zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n    terminal_signal: &Option<oulipoly_runtime::executor::TerminalSignal>,\n    terminal_signal_ctx: &mut crate::terminal_outcome_adapter::TerminalSignalContext<\n        '_,\n        std::io::Stderr,\n    >,\n) -> TerminalSignalDisposition {\n    match confirmed_maybe_quota_signal(zero_turn_action, terminal_signal) {\n        Some(signal) => {\n            let _ = confirm_maybe_quota_exhausted(signal, terminal_signal_ctx);\n            TerminalSignalDisposition::MaybeQuotaVerify\n        }\n        None => apply_resume_terminal_signal_outcome(terminal_signal, terminal_signal_ctx),\n    }\n}\n\nfn confirmed_maybe_quota_signal(\n    zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n    terminal_signal: &Option<oulipoly_runtime::executor::TerminalSignal>,\n) -> Option<&oulipoly_runtime::executor::TerminalSignal> {\n    confirmed_zero_turn_maybe_quota(zero_turn_action, terminal_signal)\n        .then_some(terminal_signal.as_ref())\n        .flatten()\n}\n\nfn apply_resume_terminal_signal_outcome(\n    terminal_signal: &Option<oulipoly_runtime::executor::TerminalSignal>,\n    terminal_signal_ctx: &mut crate::terminal_outcome_adapter::TerminalSignalContext<\n        '_,\n        std::io::Stderr,\n    >,\n) -> TerminalSignalDisposition {\n    crate::terminal_outcome_adapter::apply_terminal_signal_outcome(\n        terminal_signal,\n        terminal_signal_ctx,\n    )\n}","lineStart":1,"lineEnd":1119,"totalLines":1119,"truncated":false}},"title":"src-tauri/src/run/resume/orchestration.rs","time":{"start":1780750112397,"end":1780750112432}},"metadata":{"openai":{"itemId":"fc_07e500dd1e9430ee016a24172049108194803b27957541e7a2"}},"id":"prt_e9cfa5689001al4punBjbYQ2No","sessionID":"ses_1630698a4ffe6jRHOZ2eUQGXQ5","messageID":"msg_e9cfa3b95001mpj0ktTYYRQpyn"}}
