ware\n1512:         // for external rotation while preserving built-in provider == None.\n1513:     ]\n1514: }\n1515: \n1516: fn read_runtime_source(root: &Path, relative: &str) -> String {\n1517:     let path = root.join(relative);\n1518:     fs::read_to_string(&path)\n1519:         .unwrap_or_else(|error| panic!(\"failed to read {}: {error}\", path.display()))\n1520: }\n1521: \n1522: fn assert_source_forbids_provider_registry(relative: &str, source: &str) {\n1523:     assert!(\n1524:         !has_provider_registry_reference(source),\n1525:         \"{relative} must stay on the current production path in AGE-214 S4\"\n1526:     );\n1527: }\n1528: \n1529: fn has_provider_registry_reference(source: &str) -> bool {\n1530:     source.contains(\"provider_registry\")\n1531:         || source.contains(\"ProviderRegistry\")\n1532:         || source.contains(\"describe_model_provider\")\n1533: }\n1534: \n1535: fn assert_diagnostics_provider_registry_refs_are_terminal_classify_only(source: &str) {\n1536:     assert_diagnostics_terminal_classify_registry_hook_present(source);\n1537:     assert_diagnostics_legacy_error_branch_has_no_registry(source);\n1538:     assert_diagnostics_classify_exhaustion_branch_has_no_registry(source);\n1539: }\n1540: \n1541: fn assert_diagnostics_terminal_classify_registry_hook_present(source: &str) {\n1542:     for expected in [\n1543:         \"DiagnosticsServiceRequest::ClassifyTerminal\",\n1544:         \"classify_terminal_with_registry\",\n1545:         \"diagnose_terminal_classify_hook\",\n1546:         \"external_provider::classify_terminal\",\n1547:         \"ProviderRegistryHandle::current\",\n1548:     ] {\n1549:         assert!(\n1550:             source.contains(expected),\n1551:             \"diagnostics/mod.rs must keep the sanctioned external terminal.classify registry hook: {expected}\"\n1552:         );\n1553:     }\n1554: }\n1555: \n1556: fn assert_diagnostics_legacy_error_branch_has_no_registry(source: &str) {\n1557:     assert!