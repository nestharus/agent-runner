    Owns:\n//!       - production repository and service construction\n//!       - shared provider registry handle propagation\n//!       - CLI-default service graph construction\n//!       - configured runtime path wiring\n//! ```\n\nuse oulipoly_config as config;\nuse oulipoly_config::repositories::{\n    FilesystemAgentConfigRepository, FilesystemAppConfigRepository,\n    FilesystemModelConfigRepository, FilesystemProvidersConfigRepository,\n    FilesystemSessionsConfigRepository, ProvidersConfigRepository,\n};\nuse oulipoly_runtime::diagnostics::RuntimeDiagnosticsService;\nuse oulipoly_runtime::executor::RuntimeExecutorService;\nuse oulipoly_runtime::ports::{\n    DefaultProcessRunner, DefaultUuidGenerator, StderrWriter, StdoutWriter, SystemClock,\n};\nuse oulipoly_runtime::provider_registry::{\n    ProviderRegistry, ProviderRegistryHandle, ProviderRegistryOptions,\n};\nuse oulipoly_runtime::quota::RuntimeQuotaService;\nuse oulipoly_runtime::services::{\n    DiagnosticsServicePort, ExecutorServicePort, MigrationServicePort,\n    ProductionInvocationLifecycleService, ProductionMigrationService, ProductionResumeService,\n    ProductionRoutingService, ProductionSessionExportService, ProductionSessionLifecycleService,\n    ProductionSessionLockService, ProductionSessionReplaceService, ProductionTraceService,\n    QuotaServicePort, ResumeServicePort, SessionExportServicePort, SessionLifecycleServicePort,\n    SessionLockServicePort, SessionReplaceServicePort, TraceServicePort,\n};\nuse oulipoly_state::repositories::ProductionStateDbOpener;\nuse std::path::{Path, PathBuf};\nuse std::sync::Arc;\n\n#[derive(Debug, Clone)]\npub struct RuntimePaths {\n    pub config_root: PathBuf,\n    pub models_dir: PathBuf,\n    pub agents_dir: PathBuf,\n    pub data_root: PathBuf,\n    pub state_db_path: PathBuf,\n    pub lock_dir: PathBuf,\n    pub working_dir: PathBuf,\n}\n\npub struct AgentRuntimeServices {\n    pub state_db_opener: Arc<ProductionStateDbOpener>,\n    pub app_config: Arc<FilesystemAppConfigRepository>,\n    pub agent_config: Arc<FilesystemAgentConfigRepository>,\n    pub model_config: Arc<FilesystemModelConfigRepository>,\n    pub providers_config: Arc<FilesystemProvidersConfigRepository>,\n    pub sessions_config: Arc<FilesystemSessionsConfigRepository>,\n    pub clock: Arc<SystemClock>,\n    pub uuid_gen: Arc<DefaultUuidGenerator>,\n    pub process_runner: Arc<DefaultProcessRunner>,\n    pub stdout_sink: Arc<StdoutWriter>,\n    pub stderr_sink: Arc<StderrWriter>,\n    pub routing_service: Arc<ProductionRoutingService>,\n    pub invocation_lifecycle_service: Arc<ProductionInvocationLifecycleService>,\n    pub executor_service: Arc<dyn ExecutorServicePort>,\n    pub quota_service: Arc<dyn QuotaServicePort>,\n    pub diagnostics_service: Arc<dyn DiagnosticsServicePort>,\n    pub provider_registry: Arc<ProviderRegistry>,\n    pub provider_registry_handle: ProviderRegistryHandle,\n    pub provider_registry_options: ProviderRegistryOptions,\n    pub resume_service: Arc<dyn ResumeServicePort>,\n    pub session_lifecycle_service: Arc<dyn SessionLifecycleServicePort>,\n    pub migration_service: Arc<dyn MigrationServicePort>,\n    pub trace_service: Arc<dyn TraceServicePort>,\n    pub session_export_service: Arc<dyn SessionExportServicePort>,\n    pub session_replace_service: Arc<dyn SessionReplaceServicePort>,\n    pub session_lock_service: Arc<dyn SessionLockServicePort>,\n}\n\nimpl AgentRuntimeServices {\n    pub fn cli_defaults() -> Self {\n        let paths = default_cli_runtime_paths();\n        let provider_registry_options = ProviderRegistryOptions::default()\n            .with_path_entries_from_process_path()\n            .with_config_root(paths.config_root.clone())\n            .with_data_root(paths.data_root.clone());\n        let provider_registry = Arc::new(production_provider_registry(\n            &paths,\n            provider_registry_options.clone(),\n        ));\n        let provider_registry_handle = ProviderRegistryHandle::new(provider_registry.clone());\n        let session_lifecycle_service =\n            Arc::new(ProductionSessionLifecycleService::with_registry_handle(\n                provider_registry_handle.clone(),\n            ));\n        Self {\n            state_db_opener: Arc::new(ProductionStateDbOpener),\n            app_config: Arc::new(FilesystemAppConfigRepository),\n            agent_config: Arc::new(FilesystemAgentConfigRepository),\n            model_config: Arc::new(FilesystemModelConfigRepository),\n            providers_config: Arc::new(FilesystemProvidersConfigRepository),\n            sessions_config: Arc::new(FilesystemSessionsConfigRepository),\n            clock: Arc::new(SystemClock),\n            uuid_gen: Arc::new(DefaultUuidGenerator),\n            process_runner: Arc::new(DefaultProcessRunner),\n            stdout_sink: Arc::new(StdoutWriter),\n            stderr_sink: Arc::new(StderrWriter),\n            routing_service: Arc::new(ProductionRoutingService),\n            invocation_lifecycle_service: Arc::new(ProductionInvocationLifecycleService),\n            executor_service: Arc::new(RuntimeExecutorService::with_registry_handle(\n                provider_registry_handle.clone(),\n            )),\n            quota_service: Arc::new(RuntimeQuotaService::with_registry_handle(\n                provider_registry_handle.clone(),\n            )),\n            diagnostics_service: Arc::new(RuntimeDiagnosticsService::with_registry_handle(\n                provider_registry_handle.clone(),\n            )),\n            provider_registry,\n            provider_registry_handle: provider_registry_handle.clone(),\n            provider_registry_options,\n            resume_service: Arc::new(ProductionResumeService::new()),\n            session_lifecycle_service,\n            migration_service: Arc::new(ProductionMigrationService::with_registry_handle(\n                provider_registry_handle.clone(),\n            )),\n            trace_service: Arc::new(ProductionTraceService::default()),\n            session_export_service: Arc::new(ProductionSessionExportService::with_registry_handle(\n                provider_registry_handle.clone(),\n            )),\n            session_replace_service: Arc::new(\n                ProductionSessionReplaceService::with_registry_handle(\n                    provider_registry_handle.clone(),\n                ),\n            ),\n            session_lock_service: Arc::new(ProductionSessionLockService::default()),\n        }\n    }\n\n    pub fn production(paths: RuntimePaths) -> Result<Self, String> {\n        prepare_runtime_directories(&paths)?;\n        let registry_options = ProviderRegistryOptions::default()\n            .with_path_entries_from_process_path()\n            .with_config_root(paths.config_root.clone())\n            .with_data_root(paths.data_root.clone());\n        let provider_registry = Arc::new(production_provider_registry(\n            &paths,\n            registry_options.clone(),\n        ));\n        let provider_registry_handle = ProviderRegistryHandle::new(provider_registry.clone());\n        let session_lifecycle_service =\n            Arc::new(ProductionSessionLifecycleService::with_registry_handle(\n                provider_registry_handle.clone(),\n            ));\n\n        Ok(Self {\n            state_db_opener: Arc::new(ProductionStateDbOpener),\n            app_config: Arc::new(FilesystemAppConfigRepository),\n            agent_config: Arc::new(FilesystemAgentConfigRepository),\n            model_config: Arc::new(FilesystemModelConfigRepository),\n            providers_config: Arc::new(FilesystemProvidersConfigRepository),\n            sessions_config: Arc::new(FilesystemSessionsConfigRepository),\n            clock: Arc::new(SystemClock),\n            uuid_gen: Arc::new(DefaultUuidGenerator),\n            process_runner: Arc::new(DefaultProcessRunner),\n            stdout_sink: Arc::new(StdoutWriter),\n            stderr_sink: Arc::new(StderrWriter),\n            routing_service: Arc::new(ProductionRoutingService),\n            invocation_lifecycle_service: Arc::new(ProductionInvocationLifecycleService),\n            executor_service: Arc::new(RuntimeExecutorService::with_registry_handle(\n                provider_registry_handle.clone(),\n            )),\n            quota_service: Arc::new(RuntimeQuotaService::with_registry_handle(\n                provider_registry_handle.clone(),\n            )),\n            diagnostics_service: Arc::new(RuntimeDiagnosticsService::with_registry_handle(\n                provider_registry_handle.clone(),\n            )),\n            provider_registry,\n            provider_registry_handle: provider_registry_handle.clone(),\n            provider_registry_options: registry_options,\n            resume_service: Arc::new(ProductionResumeService::new()),\n            session_lifecycle_service,\n            migration_service: Arc::new(ProductionMigrationService::with_registry_handle(\n                provider_registry_handle.clone(),\n            )),\n            trace_service: Arc::new(ProductionTraceService::default()),\n            session_export_service: Arc::new(ProductionSessionExportService::with_registry_handle(\n                provider_registry_handle.clone(),\n            )),\n            session_replace_service: Arc::new(\n                ProductionSessionReplaceService::with_registry_handle(\n                    provider_registry_handle.clone(),\n                ),\n            ),\n            session_lock_service: Arc::new(ProductionSessionLockService::default()),\n        })\n    }\n}\n\nfn default_cli_runtime_paths() -> RuntimePaths {\n    let config_root = dirs::config_dir()\n        .map(|dir| dir.join(\"oulipoly-agent-runner\"))\n        .unwrap_or_else(|| PathBuf::from(\".\"));\n    let models_dir = config_root.join(\"models\");\n    let data_root = oulipoly_state::paths::data_dir().unwrap_or_else(|_| config_root.clone());\n    RuntimePaths {\n        config_root: config_root.clone(),\n        models_dir,\n        agents_dir: config_root.join(\"agents\"),\n        data_root: data_root.clone(),\n        state_db_path: data_root.join(\"state.db\"),\n        lock_dir: data_root.join(\"locks\"),\n        working_dir: std::env::current_dir().unwrap_or_else(|_| PathBuf::from(\".\")),\n    }\n}\n\nfn production_provider_registry(\n    paths: &RuntimePaths,\n    options: ProviderRegistryOptions,\n) -> ProviderRegistry {\n    let fallback_options = options.clone();\n    let providers = load_registry_providers(paths);\n    let models = load_registry_models(paths, &providers);\n    registry_from_model_configs(models, options)\n        .unwrap_or_else(|_| empty_provider_registry(fallback_options))\n}\n\nfn load_registry_providers(paths: &RuntimePaths) -> config::ProvidersConfig {\n    FilesystemProvidersConfigRepository\n        .load_providers(&paths.config_root.join(\"providers.toml\"))\n        .unwrap_or_default()\n}\n\nfn load_registry_models(\n    paths: &RuntimePaths,\n    providers: &config::ProvidersConfig,\n) -> std::collections::HashMap<String, config::ModelConfig> {\n    config::load_models(&paths.models_dir, Some(providers)).unwrap_or_default()\n}\n\nfn registry_from_model_configs(\n    models: std::collections::HashMap<String, config::ModelConfig>,\n    options: ProviderRegistryOptions,\n) -> Result<ProviderRegistry, oulipoly_runtime::provider_registry::ProviderRegistryError> {\n    ProviderRegistry::from_model_configs(&models.into_values().collect::<Vec<_>>(), options)\n}\n\nfn empty_provider_registry(options: ProviderRegistryOptions) -> ProviderRegistry {\n    ProviderRegistry::empty(options)\n}\n\nfn prepare_runtime_directories(paths: &RuntimePaths) -> Result<(), String> {\n    for (path, label) in runtime_directory_targets(paths) {\n        create_runtime_directory(path, label)?;\n    }\n    if let Some(parent) = paths.state_db_path.parent() {\n        create_runtime_directory(parent, \"state DB directory\")?;\n    }\n    Ok(())\n}\n\nfn runtime_directory_targets(paths: &RuntimePaths) -> [(&Path, &'static str); 6] {\n    [\n        (&paths.config_root, \"config root\"),\n        (&paths.models_dir, \"models directory\"),\n        (&paths.agents_dir, \"agents directory\"),\n        (&paths.data_root, \"data root\"),\n        (&paths.lock_dir, \"lock directory\"),\n        (&paths.working_dir, \"working directory\"),\n    ]\n}\n\nfn create_runtime_directory(path: &Path, label: &str) -> Result<(), String> {\n    std::fs::create_dir_all(path).map_err(|error| format_runtime_directory_error(label, error))\n}\n\nfn format_runtime_directory_error(label: &str, error: std::io::Error) -> String {\n    format!(\"Failed to create {label}: {error}\")\n}","lineStart":1,"lineEnd":285,"totalLines":285,"truncated":false}},"title":"src-tauri/src/wiring.rs","time":{"start":1780750105379,"end":1780750105404}},"metadata":{"openai":{"itemId":"fc_015720d2e26042e2016a24171933008190b4bc2c707a4878b3"}},"id":"prt_e9cfa3b1d001jcODv0pEkXQBbP","sessionID":"ses_1630698a4ffe6jRHOZ2eUQGXQ5","messageID":"msg_e9cfa1c33001EqnaRhtDdq3vzI"}}
{"type":"tool_use","timestamp":1780750105411,"sessionID":"ses_1630698a4ffe6jRHOZ2eUQGXQ5","part":{"type":"tool","tool":"read","callID":"call_dS4AgMNs1sN40gB1PlM8LY9K","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/age-pid-sidecar/crates/oulipoly-runtime/src/session_metadata/mod.rs","offset":1,"limit":1400},"output":"<path>/home/nes/projects/agent-runner/worktrees/age-pid-sidecar/crates/oulipoly-runtime/src/session_metadata/mod.rs</path>\n<type>file</type>\n<content>\n1: //! Session metadata adapter and resolver subsystem.\n2: //!\n3: //! ## Declared roles\n4: //!\n5: //! - orchestration\n6: //! - parser\n7: //! - formatter\n8: //! - accessor\n9: //! - validator\n10: //! - predicate\n11: //! - mapper\n12: //! - filter\n13: //!\n14: //! Rationale: this module is the session-metadata adapter/resolver subsystem.\n15: //! Focused sibling modules own transcript registry hydration, provider-private\n16: //! locator scans, cwd resolution, and display/error mapping while this module\n17: //! preserves the historical public API.\n18: //!\n19: //! ## Intrinsic-surface declarations\n20: //! intrinsic_surface_declarations:\n21: //!   - component: crates/oulipoly-runtime/src/session_metadata/mod.rs::session_metadata_resolution\n22: //!     role: intrinsic-surface\n23: //!     Domain: session-metadata-resolution-domain\n24: //!     Owns:\n25: //!       - SessionMetadata, SessionStorageType, TranscriptState, and MetadataError contracts\n26: //!       - locate_session_metadata and locate_resume_session_metadata orchestration APIs\n27: //!       - resolve_resume_workspace_root, resolve_workspace_root_for_provider_session, and resolve_jsonl_path_for_provider APIs\n28: //!       - UUID parser and formatter helpers\n29: //!       - ambiguity, recency, mutability, and provider-selection predicates\n30: //!       - ResumeError and LocatorError to MetadataError mapping\n31: \n32: mod ambiguity;\n33: mod cwd;\n34: mod errors;\n35: mod ids;\n36: mod locator;\n37: mod metadata_shape;\n38: mod mutability;\n39: mod registry;\n40: mod resume;\n41: #[cfg(test)]\n42: mod tests;\n43: mod transcript;\n44: mod workspace;\n45: \n46: pub use locator::{\n47:     ClaudeStorageLocator, CodexStorageLocator, IoErrorKind, LocatedTranscript, LocatorError,\n48:     LocatorSource, ProviderName, ScriptKind, SessionId, SessionsConfigLocator, TranscriptLocator,\n49:     TranscriptLookupMode, TranscriptRequest, TranscriptScriptLocator, UnsupportedStorageReason,\n50:     locator_error_to_stem, unsupported_storage_reason_to_stem,\n51: };\n52: pub use registry::{\n53:     TranscriptLocatorEntry, TranscriptLocatorRegistry, discover_transcript_locator_registry,\n54:     hydrate_transcript_locator_registry,\n55: };\n56: \n57: use crate::provider_registry::ProviderRegistry;\n58: use crate::session_provider::{self, SessionProviderIdentity, SessionProviderLocateRequest};\n59: use ambiguity::{\n60:     AmbiguityPolicy, count_recent_previews, recency_cutoff_for_resume_previews,\n61:     reject_ambiguous_recent_matches, rejects_recent_ambiguity,\n62: };\n63: use errors::{map_resume_error, metadata_db_result};\n64: use ids::{format_optional_uuid, format_uuid, parse_optional_uuid, parse_session_uuid};\n65: use metadata_shape::{SessionMetadataParts, session_metadata_from_parts};\n66: use mutability::is_metadata_mutable;\n67: use oulipoly_config::{ProvidersConfig, ScriptSessionStorageType, SessionStorage, SessionsConfig};\n68: use oulipoly_state::{ModelStore, StateDb};\n69: use resume::{\n70:     active_segment_id_to_metadata_error_or_value, effective_provider_for_resolved,\n71:     fetch_active_segment_id, fetch_resume_previews,\n72: };\n73: use serde::{Deserialize, Serialize};\n74: use std::path::PathBuf;\n75: use transcript::available_jsonl_path;\n76: #[cfg(test)]\n77: use transcript::locate_jsonl_path_from_storage;\n78: pub(crate) use transcript::resolve_jsonl_path_for_provider_with_mode;\n79: use workspace::resolve_cwd_from_session_storage;\n80: \n81: #[derive(Debug, Clone, Serialize)]\n82: pub struct SessionMetadata {\n83:     pub session_id: String,\n84:     pub chain_id: String,\n85:     #[serde(skip)]\n86:     pub active_segment_id: i64,\n87:     pub provider_name: String,\n88:     pub storage_type: SessionStorageType,\n89:     pub jsonl_path: PathBuf,\n90:     pub workspace_root: PathBuf,\n91:     pub transcript_state: TranscriptState,\n92:     pub mutable: bool,\n93: }\n94: \n95: #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n96: #[serde(rename_all = \"snake_case\")]\n97: pub enum SessionStorageType {\n98:     ClaudeCode,\n99:     CodexSession,\n100:     Other,\n101: }\n102: \n103: impl From<&Option<SessionStorage>> for SessionStorageType {\n104:     fn from(storage: &Option<SessionStorage>) -> Self {\n105:         match storage {\n106:             Some(SessionStorage::Script { storage_type, .. }) => match storage_type {\n107:                 Some(ScriptSessionStorageType::ClaudeCode) => Self::ClaudeCode,\n108:                 Some(ScriptSessionStorageType::CodexSession) => Self::CodexSession,\n109:                 None => Self::Other,\n110:             },\n111:             Some(SessionStorage::ClaudeCode { .. }) => Self::ClaudeCode,\n112:             Some(SessionStorage::Codex { .. }) => Self::CodexSession,\n113:             None => Self::Other,\n114:         }\n115:     }\n116: }\n117: \n118: #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\n119: #[serde(rename_all = \"snake_case\")]\n120: pub enum TranscriptState {\n121:     Unresolved,\n122:     NoLocator,\n123:     Missing,\n124:     Available,\n125: }\n126: \n127: impl TranscriptState {\n128:     pub(crate) fn as_str(self) -> &'static str {\n129:         match self {\n130:             TranscriptState::Unresolved => \"unresolved\",\n131:             TranscriptState::NoLocator => \"no_locator\",\n132:             TranscriptState::Missing => \"missing\",\n133:             TranscriptState::Available => \"available\",\n134:         }\n135:     }\n136: }\n137: \n138: #[derive(Debug, Clone)]\n139: pub enum MetadataError {\n140:     InvalidSessionId {\n141:         input: String,\n142:     },\n143:     SessionNotFound {\n144:         input: String,\n145:     },\n146:     AmbiguousSession {\n147:         input: String,\n148:     },\n149:     UnsupportedStorage {\n150:         provider_name: String,\n151:         reason: String,\n152:     },\n153:     Operational {\n154:         message: String,\n155:     },\n156: }\n157: \n158: pub fn locate_session_metadata(\n159:     state: &StateDb,\n160:     models: &ModelStore,\n161:     providers_cfg: &ProvidersConfig,\n162:     sessions_cfg: &SessionsConfig,\n163:     input: &str,\n164: ) -> Result<SessionMetadata, MetadataError> {\n165:     locate_session_metadata_with_policy(\n166:         state,\n167:         models,\n168:         providers_cfg,\n169:         sessions_cfg,\n170:         input,\n171:         AmbiguityPolicy::Reject,\n172:     )\n173: }\n174: \n175: pub fn locate_session_metadata_with_provider_dispatch(\n176:     state: &StateDb,\n177:     models: &ModelStore,\n178:     providers_cfg: &ProvidersConfig,\n179:     sessions_cfg: &SessionsConfig,\n180:     provider_registry: Option<&ProviderRegistry>,\n181:     input: &str,\n182: ) -> Result<SessionMetadata, MetadataError> {\n183:     locate_session_metadata_with_dispatch_policy(\n184:         state,\n185:         models,\n186:         providers_cfg,\n187:         sessions_cfg,\n188:         provider_registry,\n189:         input,\n190:         AmbiguityPolicy::Reject,\n191:     )\n192: }\n193: \n194: pub fn locate_resume_session_metadata(\n195:     state: &StateDb,\n196:     models: &ModelStore,\n197:     providers_cfg: &ProvidersConfig,\n198:     sessions_cfg: &SessionsConfig,\n199:     input: &str,\n200: ) -> Result<SessionMetadata, MetadataError> {\n201:     locate_session_metadata_with_policy(\n202:         state,\n203:         models,\n204:         providers_cfg,\n205:         sessions_cfg,\n206:         input,\n207:         AmbiguityPolicy::UseStrictRecency,\n208:     )\n209: }\n210: \n211: fn locate_session_metadata_with_policy(\n212:     state: &StateDb,\n213:     models: &ModelStore,\n214:     providers_cfg: &ProvidersConfig,\n215:     sessions_cfg: &SessionsConfig,\n216:     input: &str,\n217:     ambiguity_policy: AmbiguityPolicy,\n218: ) -> Result<SessionMetadata, MetadataError> {\n219:     let parsed_input = parse_metadata_input(input)?;\n220:     reject_recent_ambiguity_for_policy(state, input, ambiguity_policy)?;\n221:     let facts = load_builtin_metadata_facts(state, models, providers_cfg, sessions_cfg, input)?;\n222:     Ok(map_builtin_session_metadata(parsed_input, facts))\n223: }\n224: \n225: fn locate_session_metadata_with_dispatch_policy(\n226:     state: &StateDb,\n227:     models: &ModelStore,\n228:     providers_cfg: &ProvidersConfig,\n229:     sessions_cfg: &SessionsConfig,\n230:     provider_registry: Option<&ProviderRegistry>,\n231:     input: &str,\n232:     ambiguity_policy: AmbiguityPolicy,\n233: ) -> Result<SessionMetadata, MetadataError> {\n234:     let Some(registry) = provider_registry else {\n235:         return locate_session_metadata_with_policy(\n236:             state,\n237:             models,\n238:             providers_cfg,\n239:             sessions_cfg,\n240:             input,\n241:             ambiguity_policy,\n242:         );\n243:     };\n244:     let parsed_input = parse_metadata_input(input)?;\n245:     reject_recent_ambiguity_for_policy(state, input, ambiguity_policy)?;\n246:     let resolved = resolve_metadata_session(state, models, input)?;\n247:     if !resolved_uses_external_provider(&resolved) {\n248:         return locate_session_metadata_with_policy(\n249:             state,\n250:             models,\n251:             providers_cfg,\n252:             sessions_cfg,\n253:             input,\n254:             ambiguity_policy,\n255:         );\n256:     }\n257:     locate_external_provider_session_metadata(\n258:         state,\n259:         providers_cfg,\n260:         registry,\n261:         parsed_input,\n262:         &resolved,\n263:     )\n264: }\n265: \n266: fn parse_metadata_input(input: &str) -> Result<uuid::Uuid, MetadataError> {\n267:     parse_session_uuid(input)\n268: }\n269: \n270: fn reject_recent_ambiguity_for_policy(\n271:     state: &StateDb,\n272:     input: &str,\n273:     ambiguity_policy: AmbiguityPolicy,\n274: ) -> Result<(), MetadataError> {\n275:     if !rejects_recent_ambiguity(ambiguity_policy) {\n276:         return Ok(());\n277:     }\n278:     let previews = metadata_db_result(fetch_resume_previews(state, input))?;\n279:     let cutoff = recency_cutoff_for_resume_previews();\n280:     reject_ambiguous_recent_matches(input, count_recent_previews(&previews, cutoff))\n281: }\n282: \n283: fn resolve_metadata_session(\n284:     state: &StateDb,\n285:     models: &ModelStore,\n286:     input: &str,\n287: ) -> Result<oulipoly_state::ResolvedResume, MetadataError> {\n288:     state\n289:         .resolve_resume(models, input, None)\n290:         .map_err(map_resume_error)\n291: }\n292: \n293: fn resolved_uses_external_provider(resolved: &oulipoly_state::ResolvedResume) -> bool {\n294:     resolved\n295:         .model\n296:         .as_ref()\n297:         .is_some_and(|model| model.provider.is_some())\n298: }\n299: \n300: fn locate_external_provider_session_metadata(\n301:     state: &StateDb,\n302:     providers_cfg: &ProvidersConfig,\n303:     registry: &ProviderRegistry,\n304:     parsed_input: uuid::Uuid,\n305:     resolved: &oulipoly_state::ResolvedResume,\n306: ) -> Result<SessionMetadata, MetadataError> {\n307:     let facts = load_external_metadata_facts(state, providers_cfg, registry, resolved)?;\n308:     Ok(map_external_session_metadata(parsed_input, resolved, facts))\n309: }\n310: \n311: struct BuiltinMetadataFacts {\n312:     resolved: oulipoly_state::ResolvedResume,\n313:     provider: oulipoly_config::ProviderConfig,\n314:     provider_name: String,\n315:     active_segment_id: i64,\n316:     located_transcript: LocatedTranscript,\n317:     workspace_root: PathBuf,\n318: }\n319: \n320: fn load_builtin_metadata_facts(\n321:     state: &StateDb,\n322:     models: &ModelStore,\n323:     providers_cfg: &ProvidersConfig,\n324:     sessions_cfg: &SessionsConfig,\n325:     input: &str,\n326: ) -> Result<BuiltinMetadataFacts, MetadataError> {\n327:     let resolved = resolve_metadata_session(state, models, input)?;\n328:     let provider = effective_provider_for_resolved(&resolved, providers_cfg)?;\n329:     let provider_name = resolved.active_provider.clone();\n330:     let active_segment_id = external_active_segment_id(state, &resolved)?;\n331:     let located_transcript = available_jsonl_path(\n332:         sessions_cfg,\n333:         provider.session_storage.as_ref(),\n334:         &provider_name,\n335:         &resolved.active_session_id,\n336:     )?;\n337:     let workspace_root = resolve_cwd_from_session_storage(\n338:         provider.session_storage.as_ref(),\n339:         &provider_name,\n340:         &resolved.active_session_id,\n341:     )?;\n342:     Ok(BuiltinMetadataFacts {\n343:         resolved,\n344:         provider,\n345:         provider_name,\n346:         active_segment_id,\n347:         located_transcript,\n348:         workspace_root,\n349:     })\n350: }\n351: \n352: fn map_builtin_session_metadata(\n353:     parsed_input: uuid::Uuid,\n354:     facts: BuiltinMetadataFacts,\n355: ) -> SessionMetadata {\n356:     let storage_type = facts.located_transcript.storage_classification;\n357:     let jsonl_path = facts.located_transcript.path;\n358:     let active_session_uuid =\n359:         parse_optional_uuid(&facts.resolved.active_session_id).unwrap_or(parsed_input);\n360:     let chain_uuid = parse_optional_uuid(&facts.resolved.chain_id);\n361:     let mutable = is_metadata_mutable(\n362:         storage_type,\n363:         &facts.provider,\n364:         &jsonl_path,\n365:         &facts.workspace_root,\n366:     );\n367:     session_metadata_from_parts(SessionMetadataParts {\n368:         session_id: format_uuid(active_session_uuid),\n369:         chain_id: format_optional_uuid(&facts.resolved.chain_id, chain_uuid),\n370:         active_segment_id: facts.active_segment_id,\n371:         provider_name: facts.provider_name,\n372:         storage_type,\n373:         jsonl_path,\n374:         workspace_root: facts.workspace_root,\n375:         mutable,\n376:     })\n377: }\n378: \n379: struct ExternalMetadataFacts {\n380:     provider: oulipoly_config::ProviderConfig,\n381:     provider_name: String,\n382:     active_segment_id: i64,\n383:     located_transcript: LocatedTranscript,\n384:     workspace_root: PathBuf,\n385: }\n386: \n387: fn load_external_metadata_facts(\n388:     state: &StateDb,\n389:     providers_cfg: &ProvidersConfig,\n390:     registry: &ProviderRegistry,\n391:     resolved: &oulipoly_state::ResolvedResume,\n392: ) -> Result<ExternalMetadataFacts, MetadataError> {\n393:     let provider = effective_provider_for_resolved(resolved, providers_cfg)?;\n394:     let provider_name = resolved.active_provider.clone();\n395:     let model_name = external_resolved_model_name(resolved)?;\n396:     let active_segment_id = external_active_segment_id(state, resolved)?;\n397:     let identity = external_locate_identity(registry, model_name, &provider_name)?;\n398:     let located_transcript =\n399:         locate_external_provider_transcript(registry, identity, &resolved.active_session_id)?;\n400:     let workspace_root = external_workspace_root(\n401:         provider.session_storage.as_ref(),\n402:         &provider_name,\n403:         &resolved.active_session_id,\n404:     );\n405:     Ok(ExternalMetadataFacts {\n406:         provider,\n407:         provider_name,\n408:         active_segment_id,\n409:         located_transcript,\n410:         workspace_root,\n411:     })\n412: }\n413: \n414: fn map_external_session_metadata(\n415:     parsed_input: uuid::Uuid,\n416:     resolved: &oulipoly_state::ResolvedResume,\n417:     facts: ExternalMetadataFacts,\n418: ) -> SessionMetadata {\n419:     let storage_type = facts.located_transcript.storage_classification;\n420:     let jsonl_path = facts.located_transcript.path;\n421:     let active_session_uuid =\n422:         parse_optional_uuid(&resolved.active_session_id).unwrap_or(parsed_input);\n423:     let chain_uuid = parse_optional_uuid(&resolved.chain_id);\n424:     let mutable = is_metadata_mutable(\n425:         storage_type,\n426:         &facts.provider,\n427:         &jsonl_path,\n428:         &facts.workspace_root,\n429:     );\n430:     session_metadata_from_parts(SessionMetadataParts {\n431:         session_id: format_uuid(active_session_uuid),\n432:         chain_id: format_optional_uuid(&resolved.chain_id, chain_uuid),\n433:         active_segment_id: facts.active_segment_id,\n434:         provider_name: facts.provider_name,\n435:         storage_type,\n436:         jsonl_path,\n437:         workspace_root: facts.workspace_root,\n438:         mutable,\n439:     })\n440: }\n441: \n442: fn external_resolved_model_name(\n443:     resolved: &oulipoly_state::ResolvedResume,\n444: ) -> Result<&str, MetadataError> {\n445:     resolved\n446:         .model_name\n447:         .as_deref()\n448:         .ok_or_else(|| MetadataError::Operational {\n449:             message: \"session_provider_model_name_missing\".to_string(),\n450:         })\n451: }\n452: \n453: fn external_active_segment_id(\n454:     state: &StateDb,\n455:     resolved: &oulipoly_state::ResolvedResume,\n456: ) -> Result<i64, MetadataError> {\n457:     active_segment_id_to_metadata_error_or_value(\n458:         metadata_db_result(fetch_active_segment_id(state, resolved))?,\n459:         &resolved.chain_id,\n460:     )\n461: }\n462: \n463: fn locate_external_provider_transcript(\n464:     registry: &ProviderRegistry,\n465:     identity: SessionProviderIdentity,\n466:     session_id: &str,\n467: ) -> Result<LocatedTranscript, MetadataError> {\n468:     session_provider::locate_transcript(SessionProviderLocateRequest {\n469:         registry,\n470:         identity,\n471:         session_id,\n472:         lookup_mode: TranscriptLookupMode::RequireExisting,\n473:         effective_cwd: None,\n474:     })\n475:     .map_err(session_provider_metadata_error)\n476: }\n477: \n478: fn external_locate_identity(\n479:     registry: &ProviderRegistry,\n480:     model_name: &str,\n481:     provider_name: &str,\n482: ) -> Result<SessionProviderIdentity, MetadataError> {\n483:     let describe = external_locate_describe(registry, model_name)?;\n484:     Ok(external_identity_from_describe(\n485:         model_name,\n486:         provider_name,\n487:         describe,\n488:     ))\n489: }\n490: \n491: fn external_locate_describe(\n492:     registry: &ProviderRegistry,\n493:     model_name: &str,\n494: ) -> Result<oulipoly_provider::generated::DescribeResult, MetadataError> {\n495:     registry\n496:         .describe_model_provider(model_name)\n497:         .map_err(|error| MetadataError::Operational {\n498:             message: format!(\"session_provider_describe_failed: {error}\"),\n499:         })\n500: }\n501: \n502: fn external_identity_from_describe(\n503:     model_name: &str,\n504:     provider_name: &str,\n505:     describe: oulipoly_provider::generated::DescribeResult,\n506: ) -> SessionProviderIdentity {\n507:     SessionProviderIdentity {\n508:         model_name: model_name.to_string(),\n509:         provider_name: provider_name.to_string(),\n510:         provider_instance_id: Some(format_external_provider_instance_id(&describe.provider_id)),\n511:         settings_id: external_settings_id(describe.settings_schema_id),\n512:     }\n513: }\n514: \n515: fn format_external_provider_instance_id(provider_id: &str) -> String {\n516:     format!(\"{provider_id}-instance\")\n517: }\n518: \n519: fn external_settings_id(settings_schema_id: Option<String>) -> String {\n520:     settings_schema_id.unwrap_or_else(|| session_provider::S7A_NEUTRAL_SETTINGS_ID.to_string())\n521: }\n522: \n523: fn external_workspace_root(\n524:     session_storage: Option<&SessionStorage>,\n525:     provider_name: &str,\n526:     session_id: &str,\n527: ) -> PathBuf {\n528:     resolve_cwd_from_session_storage(session_storage, provider_name, session_id)\n529:         .unwrap_or_else(|_| std::env::current_dir().unwrap_or_else(|_| PathBuf::from(\".\")))\n530: }\n531: \n532: fn session_provider_metadata_error(error: session_provider::SessionProviderError) -> MetadataError {\n533:     MetadataError::Operational {\n534:         message: error.to_string(),\n535:     }\n536: }\n537: \n538: pub fn resolve_resume_workspace_root(\n539:     state: &StateDb,\n540:     models: &ModelStore,\n541:     providers_cfg: &ProvidersConfig,\n542:     input: &str,\n543: ) -> Result<PathBuf, MetadataError> {\n544:     parse_session_uuid(input)?;\n545:     let resolved = state\n546:         .resolve_resume(models, input, None)\n547:         .map_err(map_resume_error)?;\n548:     if let Some(workspace_root) = external_session_runtime_workspace_root(&resolved)? {\n549:         return Ok(workspace_root);\n550:     }\n551:     let provider = effective_provider_for_resolved(&resolved, providers_cfg)?;\n552:     resolve_cwd_from_session_storage(\n553:         provider.session_storage.as_ref(),\n554:         &resolved.active_provider,\n555:         &resolved.active_session_id,\n556:     )\n557: }\n558: \n559: fn external_session_runtime_workspace_root(\n560:     resolved: &oulipoly_state::ResolvedResume,\n561: ) -> Result<Option<PathBuf>, MetadataError> {\n562:     if !resolved_uses_external_provider(resolved) {\n563:         return Ok(None);\n564:     }\n565:     let Some(db) = external_session_runtime_db()? else {\n566:         return Ok(None);\n567:     };\n568:     let Some(row) = db\n569:         .session_runtime(&resolved.active_session_id)\n570:         .map_err(external_session_runtime_error)?\n571:     else {\n572:         return Ok(None);\n573:     };\n574:     row.effective_cwd\n575:         .map(validate_external_session_runtime_cwd)\n576:         .transpose()\n577: }\n578: \n579: fn external_session_runtime_db() -> Result<Option<oulipoly_state::mailbox::MailboxDb>, MetadataError>\n580: {\n581:     oulipoly_state::mailbox::MailboxDb::open_default_if_exists()\n582:         .map_err(external_session_runtime_error)\n583: }\n584: \n585: fn validate_external_session_runtime_cwd(value: String) -> Result<PathBuf, MetadataError> {\n586:     require_absolute_external_session_runtime_cwd(external_session_runtime_cwd_path(value))\n587: }\n588: \n589: fn external_session_runtime_cwd_path(value: String) -> PathBuf {\n590:     PathBuf::from(value)\n591: }\n592: \n593: fn require_absolute_external_session_runtime_cwd(path: PathBuf) -> Result<PathBuf, MetadataError> {\n594:     if external_session_runtime_cwd_is_absolute(&path) {\n595:         Ok(path)\n596:     } else {\n597:         Err(external_session_runtime_cwd_not_absolute(&path))\n598:     }\n599: }\n600: \n601: fn external_session_runtime_cwd_is_absolute(path: &std::path::Path) -> bool {\n602:     path.is_absolute()\n603: }\n604: \n605: fn external_session_runtime_cwd_not_absolute(path: &std::path::Path) -> MetadataError {\n606:     MetadataError::Operational {\n607:         message: external_session_runtime_cwd_not_absolute_message(path),\n608:     }\n609: }\n610: \n611: fn external_session_runtime_cwd_not_absolute_message(path: &std::path::Path) -> String {\n612:     format!(\n613:         \"session_runtime_effective_cwd_not_absolute: {}\",\n614:         path.display()\n615:     )\n616: }\n617: \n618: fn external_session_runtime_error(message: String) -> MetadataError {\n619:     MetadataError::Operational { message }\n620: }\n621: \n622: pub fn resolve_jsonl_path_for_provider_allow_missing(\n623:     sessions_cfg: &SessionsConfig,\n624:     session_storage: Option<&SessionStorage>,\n625:     provider_name: &str,\n626:     session_id: &str,\n627: ) -> Result<PathBuf, MetadataError> {\n628:     resolve_jsonl_path_for_provider_with_mode(\n629:         sessions_cfg,\n630:         session_storage,\n631:         provider_name,\n632:         session_id,\n633:         TranscriptLookupMode::AllowMissing,\n634:     )\n635: }\n636: \n637: pub fn resolve_workspace_root_for_provider_session(\n638:     session_storage: Option<&SessionStorage>,\n639:     provider_name: &str,\n640:     session_id: &str,\n641: ) -> Result<PathBuf, MetadataError> {\n642:     resolve_cwd_from_session_storage(session_storage, provider_name, session_id)\n643: }\n\n(End of file - total 643 lines)\n</content>","metadata":{"preview":"//! Session metadata adapter and resolver subsystem.\n//!\n//! ## Declared roles\n//!\n//! - orchestration\n//! - parser\n//! - formatter\n//! - accessor\n//! - validator\n//! - predicate\n//! - mapper\n//! - filter\n//!\n//! Rationale: this module is the session-metadata adapter/resolver subsystem.\n//! Focused sibling modules own transcript registry hydration, provider-private\n//! locator scans, cwd resolution, and display/error mapping while this module\n//! preserves the historical public API.\n//!\n//! ## Intrinsic-surface declarations\n//! intrinsic_surface_declarations:","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/age-pid-sidecar/crates/oulipoly-runtime/src/session_metadata/mod.rs","text":"//! Session metadata adapter and resolver subsystem.\n//!\n//! ## Declared roles\n//!\n//! - orchestration\n//! - parser\n//! - formatter\n//! - accessor\n//! - validator\n//! - predicate\n//! - mapper\n//! - filter\n//!\n//! Rationale: this module is the session-metadata adapter/resolver subsystem.\n//! Focused sibling modules own transcript registry hydration, provider-private\n//! locator scans, cwd resolution, and display/error mapping while this module\n//! preserves the historical public API.\n//!\n//! ## Intrinsic-surface declarations\n//! intrinsic_surface_declarations:\n//!   - component: crates/oulipoly-runtime/src/session_metadata/mod.rs::session_metadata_resolution\n//!     role: intrinsic-surface\n//!     Domain: session-metadata-resolution-domain\n//!     Owns:\n//!       - SessionMetadata, SessionStorageType, TranscriptState, and MetadataError contracts\n//!       - locate_session_metadata and locate_resume_session_metadata orchestration APIs\n//!       - resolve_resume_workspace_root, resolve_workspace_root_for_provider_session, and resolve_jsonl_path_for_provider APIs\n//!       - UUID parser and formatter helpers\n//!       - ambiguity, recency, mutability, and provider-selection predicates\n//!       - ResumeError and LocatorError to MetadataError mapping\n\nmod ambiguity;\nmod cwd;\nmod errors;\nmod ids;\nmod locator;\nmod metadata_shape;\nmod mutability;\nmod registry;\nmod resume;\n#[cfg(test)]\nmod tests;\nmod transcript;\nmod workspace;\n\npub use locator::{\n    ClaudeStorageLocator, CodexStorageLocator, IoErrorKind, LocatedTranscript, LocatorError,\n    LocatorSource, ProviderName, ScriptKind, SessionId, SessionsConfigLocator, TranscriptLocator,\n    TranscriptLookupMode, TranscriptRequest, TranscriptScriptLocator, UnsupportedStorageReason,\n    locator_error_to_stem, unsupported_storage_reason_to_stem,\n};\npub use registry::{\n    TranscriptLocatorEntry, TranscriptLocatorRegistry, discover_transcript_locator_registry,\n    hydrate_transcript_locator_registry,\n};\n\nuse crate::provider_registry::ProviderRegistry;\nuse crate::session_provider::{self, SessionProviderIdentity, SessionProviderLocateRequest};\nuse ambiguity::{\n    AmbiguityPolicy, count_recent_previews, recency_cutoff_for_resume_previews,\n    reject_ambiguous_recent_matches, rejects_recent_ambiguity,\n};\nuse errors::{map_resume_error, metadata_db_result};\nuse ids::{format_optional_uuid, format_uuid, parse_optional_uuid, parse_session_uuid};\nuse metadata_shape::{SessionMetadataParts, session_metadata_from_parts};\nuse mutability::is_metadata_mutable;\nuse oulipoly_config::{ProvidersConfig, ScriptSessionStorageType, SessionStorage, SessionsConfig};\nuse oulipoly_state::{ModelStore, StateDb};\nuse resume::{\n    active_segment_id_to_metadata_error_or_value, effective_provider_for_resolved,\n    fetch_active_segment_id, fetch_resume_previews,\n};\nuse serde::{Deserialize, Serialize};\nuse std::path::PathBuf;\nuse transcript::available_jsonl_path;\n#[cfg(test)]\nuse transcript::locate_jsonl_path_from_storage;\npub(crate) use transcript::resolve_jsonl_path_for_provider_with_mode;\nuse workspace::resolve_cwd_from_session_storage;\n\n#[derive(Debug, Clone, Serialize)]\npub struct SessionMetadata {\n    pub session_id: String,\n    pub chain_id: String,\n    #[serde(skip)]\n    pub active_segment_id: i64,\n    pub provider_name: String,\n    pub storage_type: SessionStorageType,\n    pub jsonl_path: PathBuf,\n    pub workspace_root: PathBuf,\n    pub transcript_state: TranscriptState,\n    pub mutable: bool,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum SessionStorageType {\n    ClaudeCode,\n    CodexSession,\n    Other,\n}\n\nimpl From<&Option<SessionStorage>> for SessionStorageType {\n    fn from(storage: &Option<SessionStorage>) -> Self {\n        match storage {\n            Some(SessionStorage::Script { storage_type, .. }) => match storage_type {\n                Some(ScriptSessionStorageType::ClaudeCode) => Self::ClaudeCode,\n                Some(ScriptSessionStorageType::CodexSession) => Self::CodexSession,\n                None => Self::Other,\n            },\n            Some(SessionStorage::ClaudeCode { .. }) => Self::ClaudeCode,\n            Some(SessionStorage::Codex { .. }) => Self::CodexSession,\n            None => Self::Other,\n        }\n    }\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum TranscriptState {\n    Unresolved,\n    NoLocator,\n    Missing,\n    Available,\n}\n\nimpl TranscriptState {\n    pub(crate) fn as_str(self) -> &'static str {\n        match self {\n            TranscriptState::Unresolved => \"unresolved\",\n            TranscriptState::NoLocator => \"no_locator\",\n            TranscriptState::Missing => \"missing\",\n            TranscriptState::Available => \"available\",\n        }\n    }\n}\n\n#[derive(Debug, Clone)]\npub enum MetadataError {\n    InvalidSessionId {\n        input: String,\n    },\n    SessionNotFound {\n        input: String,\n    },\n    AmbiguousSession {\n        input: String,\n    },\n    UnsupportedStorage {\n        provider_name: String,\n        reason: String,\n    },\n    Operational {\n        message: String,\n    },\n}\n\npub fn locate_session_metadata(\n    state: &StateDb,\n    models: &ModelStore,\n    providers_cfg: &ProvidersConfig,\n    sessions_cfg: &SessionsConfig,\n    input: &str,\n) -> Result<SessionMetadata, MetadataError> {\n    locate_session_metadata_with_policy(\n        state,\n        models,\n        providers_cfg,\n        sessions_cfg,\n        input,\n        AmbiguityPolicy::Reject,\n    )\n}\n\npub fn locate_session_metadata_with_provider_dispatch(\n    state: &StateDb,\n    models: &ModelStore,\n    providers_cfg: &ProvidersConfig,\n    sessions_cfg: &SessionsConfig,\n    provider_registry: Option<&ProviderRegistry>,\n    input: &str,\n) -> Result<SessionMetadata, MetadataError> {\n    locate_session_metadata_with_dispatch_policy(\n        state,\n        models,\n        providers_cfg,\n        sessions_cfg,\n        provider_registry,\n        input,\n        AmbiguityPolicy::Reject,\n    )\n}\n\npub fn locate_resume_session_metadata(\n    state: &StateDb,\n    models: &ModelStore,\n    providers_cfg: &ProvidersConfig,\n    sessions_cfg: &SessionsConfig,\n    input: &str,\n) -> Result<SessionMetadata, MetadataError> {\n    locate_session_metadata_with_policy(\n        state,\n        models,\n        providers_cfg,\n        sessions_cfg,\n        input,\n        AmbiguityPolicy::UseStrictRecency,\n    )\n}\n\nfn locate_session_metadata_with_policy(\n    state: &StateDb,\n    models: &ModelStore,\n    providers_cfg: &ProvidersConfig,\n    sessions_cfg: &SessionsConfig,\n    input: &str,\n    ambiguity_policy: AmbiguityPolicy,\n) -> Result<SessionMetadata, MetadataError> {\n    let parsed_input = parse_metadata_input(input)?;\n    reject_recent_ambiguity_for_policy(state, input, ambiguity_policy)?;\n    let facts = load_builtin_metadata_facts(state, models, providers_cfg, sessions_cfg, input)?;\n    Ok(map_builtin_session_metadata(parsed_input, facts))\n}\n\nfn locate_session_metadata_with_dispatch_policy(\n    state: &StateDb,\n    models: &ModelStore,\n    providers_cfg: &ProvidersConfig,\n    sessions_cfg: &SessionsConfig,\n    provider_registry: Option<&ProviderRegistry>,\n    input: &str,\n    ambiguity_policy: AmbiguityPolicy,\n) -> Result<SessionMetadata, MetadataError> {\n    let Some(registry) = provider_registry else {\n        return locate_session_metadata_with_policy(\n            state,\n            models,\n            providers_cfg,\n            sessions_cfg,\n            input,\n            ambiguity_policy,\n        );\n    };\n    let parsed_input = parse_metadata_input(input)?;\n    reject_recent_ambiguity_for_policy(state, input, ambiguity_policy)?;\n    let resolved = resolve_metadata_session(state, models, input)?;\n    if !resolved_uses_external_provider(&resolved) {\n        return locate_session_metadata_with_policy(\n            state,\n            models,\n            providers_cfg,\n            sessions_cfg,\n            input,\n            ambiguity_policy,\n        );\n    }\n    locate_external_provider_session_metadata(\n        state,\n        providers_cfg,\n        registry,\n        parsed_input,\n        &resolved,\n    )\n}\n\nfn parse_metadata_input(input: &str) -> Result<uuid::Uuid, MetadataError> {\n    parse_session_uuid(input)\n}\n\nfn reject_recent_ambiguity_for_policy(\n    state: &StateDb,\n    input: &str,\n    ambiguity_policy: AmbiguityPolicy,\n) -> Result<(), MetadataError> {\n    if !rejects_recent_ambiguity(ambiguity_policy) {\n        return Ok(());\n    }\n    let previews = metadata_db_result(fetch_resume_previews(state, input))?;\n    let cutoff = recency_cutoff_for_resume_previews();\n    reject_ambiguous_recent_matches(input, count_recent_previews(&previews, cutoff))\n}\n\nfn resolve_metadata_session(\n    state: &StateDb,\n    models: &ModelStore,\n    input: &str,\n) -> Result<oulipoly_state::ResolvedResume, MetadataError> {\n    state\n        .resolve_resume(models, input, None)\n        .map_err(map_resume_error)\n}\n\nfn resolved_uses_external_provider(resolved: &oulipoly_state::ResolvedResume) -> bool {\n    resolved\n        .model\n        .as_ref()\n        .is_some_and(|model| model.provider.is_some())\n}\n\nfn locate_external_provider_session_metadata(\n    state: &StateDb,\n    providers_cfg: &ProvidersConfig,\n    registry: &ProviderRegistry,\n    parsed_input: uuid::Uuid,\n    resolved: &oulipoly_state::ResolvedResume,\n) -> Result<SessionMetadata, MetadataError> {\n    let facts = load_external_metadata_facts(state, providers_cfg, registry, resolved)?;\n    Ok(map_external_session_metadata(parsed_input, resolved, facts))\n}\n\nstruct BuiltinMetadataFacts {\n    resolved: oulipoly_state::ResolvedResume,\n    provider: oulipoly_config::ProviderConfig,\n    provider_name: String,\n    active_segment_id: i64,\n    located_transcript: LocatedTranscript,\n    workspace_root: PathBuf,\n}\n\nfn load_builtin_metadata_facts(\n    state: &StateDb,\n    models: &ModelStore,\n    providers_cfg: &ProvidersConfig,\n    sessions_cfg: &SessionsConfig,\n    input: &str,\n) -> Result<BuiltinMetadataFacts, MetadataError> {\n    let resolved = resolve_metadata_session(state, models, input)?;\n    let provider = effective_provider_for_resolved(&resolved, providers_cfg)?;\n    let provider_name = resolved.active_provider.clone();\n    let active_segment_id = external_active_segment_id(state, &resolved)?;\n    let located_transcript = available_jsonl_path(\n        sessions_cfg,\n        provider.session_storage.as_ref(),\n        &provider_name,\n        &resolved.active_session_id,\n    )?;\n    let workspace_root = resolve_cwd_from_session_storage(\n        provider.session_storage.as_ref(),\n        &provider_name,\n        &resolved.active_session_id,\n    )?;\n    Ok(BuiltinMetadataFacts {\n        resolved,\n        provider,\n        provider_name,\n        active_segment_id,\n        located_transcript,\n        workspace_root,\n    })\n}\n\nfn map_builtin_session_metadata(\n    parsed_input: uuid::Uuid,\n    facts: BuiltinMetadataFacts,\n) -> SessionMetadata {\n    let storage_type = facts.located_transcript.storage_classification;\n    let jsonl_path = facts.located_transcript.path;\n    let active_session_uuid =\n        parse_optional_uuid(&facts.resolved.active_session_id).unwrap_or(parsed_input);\n    let chain_uuid = parse_optional_uuid(&facts.resolved.chain_id);\n    let mutable = is_metadata_mutable(\n        storage_type,\n        &facts.provider,\n        &jsonl_path,\n        &facts.workspace_root,\n    );\n    session_metadata_from_parts(SessionMetadataParts {\n        session_id: format_uuid(active_session_uuid),\n        chain_id: format_optional_uuid(&facts.resolved.chain_id, chain_uuid),\n        active_segment_id: facts.active_segment_id,\n        provider_name: facts.provider_name,\n        storage_type,\n        jsonl_path,\n        workspace_root: facts.workspace_root,\n        mutable,\n    })\n}\n\nstruct ExternalMetadataFacts {\n    provider: oulipoly_config::ProviderConfig,\n    provider_name: String,\n    active_segment_id: i64,\n    located_transcript: LocatedTranscript,\n    workspace_root: PathBuf,\n}\n\nfn load_external_metadata_facts(\n    state: &StateDb,\n    providers_cfg: &ProvidersConfig,\n    registry: &ProviderRegistry,\n    resolved: &oulipoly_state::ResolvedResume,\n) -> Result<ExternalMetadataFacts, MetadataError> {\n    let provider = effective_provider_for_resolved(resolved, providers_cfg)?;\n    let provider_name = resolved.active_provider.clone();\n    let model_name = external_resolved_model_name(resolved)?;\n    let active_segment_id = external_active_segment_id(state, resolved)?;\n    let identity = external_locate_identity(registry, model_name, &provider_name)?;\n    let located_transcript =\n        locate_external_provider_transcript(registry, identity, &resolved.active_session_id)?;\n    let workspace_root = external_workspace_root(\n        provider.session_storage.as_ref(),\n        &provider_name,\n        &resolved.active_session_id,\n    );\n    Ok(ExternalMetadataFacts {\n        provider,\n        provider_name,\n        active_segment_id,\n        located_transcript,\n        workspace_root,\n    })\n}\n\nfn map_external_session_metadata(\n    parsed_input: uuid::Uuid,\n    resolved: &oulipoly_state::ResolvedResume,\n    facts: ExternalMetadataFacts,\n) -> SessionMetadata {\n    let storage_type = facts.located_transcript.storage_classification;\n    let jsonl_path = facts.located_transcript.path;\n    let active_session_uuid =\n        parse_optional_uuid(&resolved.active_session_id).unwrap_or(parsed_input);\n    let chain_uuid = parse_optional_uuid(&resolved.chain_id);\n    let mutable = is_metadata_mutable(\n        storage_type,\n        &facts.provider,\n        &jsonl_path,\n        &facts.workspace_root,\n    );\n    session_metadata_from_parts(SessionMetadataParts {\n        session_id: format_uuid(active_session_uuid),\n        chain_id: format_optional_uuid(&resolved.chain_id, chain_uuid),\n        active_segment_id: facts.active_segment_id,\n        provider_name: facts.provider_name,\n        storage_type,\n        jsonl_path,\n        workspace_root: facts.workspace_root,\n        mutable,\n    })\n}\n\nfn external_resolved_model_name(\n    resolved: &oulipoly_state::ResolvedResume,\n) -> Result<&str, MetadataError> {\n    resolved\n        .model_name\n        .as_deref()\n        .ok_or_else(|| MetadataError::Operational {\n            message: \"session_provider_model_name_missing\".to_string(),\n        })\n}\n\nfn external_active_segment_id(\n    state: &StateDb,\n    resolved: &oulipoly_state::ResolvedResume,\n) -> Result<i64, MetadataError> {\n    active_segment_id_to_metadata_error_or_value(\n        metadata_db_result(fetch_active_segment_id(state, resolved))?,\n        &resolved.chain_id,\n    )\n}\n\nfn locate_external_provider_transcript(\n    registry: &ProviderRegistry,\n    identity: SessionProviderIdentity,\n    session_id: &str,\n) -> Result<LocatedTranscript, MetadataError> {\n    session_provider::locate_transcript(SessionProviderLocateRequest {\n        registry,\n        identity,\n        session_id,\n        lookup_mode: TranscriptLookupMode::RequireExisting,\n        effective_cwd: None,\n    })\n    .map_err(session_provider_metadata_error)\n}\n\nfn external_locate_identity(\n    registry: &ProviderRegistry,\n    model_name: &str,\n    provider_name: &str,\n) -> Result<SessionProviderIdentity, MetadataError> {\n    let describe = external_locate_describe(registry, model_name)?;\n    Ok(external_identity_from_describe(\n        model_name,\n        provider_name,\n        describe,\n    ))\n}\n\nfn external_locate_describe(\n    registry: &ProviderRegistry,\n    model_name: &str,\n) -> Result<oulipoly_provider::generated::DescribeResult, MetadataError> {\n    registry\n        .describe_model_provider(model_name)\n        .map_err(|error| MetadataError::Operational {\n            message: format!(\"session_provider_describe_failed: {error}\"),\n        })\n}\n\nfn external_identity_from_describe(\n    model_name: &str,\n    provider_name: &str,\n    describe: oulipoly_provider::generated::DescribeResult,\n) -> SessionProviderIdentity {\n    SessionProviderIdentity {\n        model_name: model_name.to_string(),\n        provider_name: provider_name.to_string(),\n        provider_instance_id: Some(format_external_provider_instance_id(&describe.provider_id)),\n        settings_id: external_settings_id(describe.settings_schema_id),\n    }\n}\n\nfn format_external_provider_instance_id(provider_id: &str) -> String {\n    format!(\"{provider_id}-instance\")\n}\n\nfn external_settings_id(settings_schema_id: Option<String>) -> String {\n    settings_schema_id.unwrap_or_else(|| session_provider::S7A_NEUTRAL_SETTINGS_ID.to_string())\n}\n\nfn external_workspace_root(\n    session_storage: Option<&SessionStorage>,\n    provider_name: &str,\n    session_id: &str,\n) -> PathBuf {\n    resolve_cwd_from_session_storage(session_storage, provider_name, session_id)\n        .unwrap_or_else(|_| std::env::current_dir().unwrap_or_else(|_| PathBuf::from(\".\")))\n}\n\nfn session_provider_metadata_error(error: session_provider::SessionProviderError) -> MetadataError {\n    MetadataError::Operational {\n        message: error.to_string(),\n    }\n}\n\npub fn resolve_resume_workspace_root(\n    state: &StateDb,\n    models: &ModelStore,\n    providers_cfg: &ProvidersConfig,\n    input: &str,\n) -> Result<PathBuf, MetadataError> {\n    parse_session_uuid(input)?;\n    let resolved = state\n        .resolve_resume(models, input, None)\n        .map_err(map_resume_error)?;\n    if let Some(workspace_root) = external_session_runtime_workspace_root(&resolved)? {\n        return Ok(workspace_root);\n    }\n    let provider = effective_provider_for_resolved(&resolved, providers_cfg)?;\n    resolve_cwd_from_session_storage(\n        provider.session_storage.as_ref(),\n        &resolved.active_provider,\n        &resolved.active_session_id,\n    )\n}\n\nfn external_session_runtime_workspace_root(\n    resolved: &oulipoly_state::ResolvedResume,\n) -> Result<Option<PathBuf>, Me