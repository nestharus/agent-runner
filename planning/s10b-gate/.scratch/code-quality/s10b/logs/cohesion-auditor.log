aunch\"];\n122:     let provider = provider_name();\n123:     assert_eq!(policy_launch[\"command\"].as_str(), Some(provider.as_str()));\n124:     assert_eq!(policy_launch[\"args\"], json!([]));\n125:     assert_eq!(policy_launch[\"prompt_mode\"].as_str(), Some(\"arg\"));\n126:     assert_eq!(\n127:         policy_records[0][\"request\"][\"params\"][\"model\"][\"provider_args\"],\n128:         json!([\"--model\", \"sonnet\"])\n129:     );\n130: }\n131: \n132: fn execute_external(\n133:     service: &RuntimeExecutorService,\n134:     known_session: Option<&str>,\n135: ) -> oulipoly_runtime::services::ExecutorServiceOutput {\n136:     service\n137:         .execute(external_execute_request(known_session))\n138:         .expect(\"external execution\")\n139: }\n140: \n141: fn external_execute_request(known_session: Option<&str>) -> ExecutorServiceRequest {\n142:     let model = external_model(Path::new(\"unused-by-registry-lookup\"));\n143:     let provider = ProviderConfig::new(\n144:         provider_name(),\n145:         vec![\"--model\".to_string(), \"sonnet\".to_string()],\n146:     );\n147:     match known_session {\n148:         Some(start_known_provider_session_id) => {\n149:             ExecutorServiceRequest::EffectiveWithStartKnownProviderSessionId {\n150:                 model,\n151:                 provider,\n152:                 provider_index: 0,\n153:                 prompt_mode: PromptMode::Arg,\n154:                 prompt: \"resume prompt\".to_string(),\n155:                 working_dir: None,\n156:                 extra_inputs: HashMap::new(),\n157:                 parent_invocation_env: None,\n158:                 start_known_provider_session_id: start_known_provider_session_id.to_string(),\n159:             }\n160:         }\n161:         None => ExecutorServiceRequest::Effective {\n162:             model,\n163:             provider,\n164:             provider_index: 0,\n165:             prompt_mode: PromptMode::Arg,\n166:             prompt: \"first prompt\".to_string(),\n167:             working_dir: None,\n168:             extra_inputs: HashMap::new(),\n169:             parent_invocation_env: None,\n170:         },\n171:     }\n172: }\n173: \n174: fn external_model(provider_path: &Path) -> ModelConfig {\n175:     ModelConfig {\n176:         name: model_name(),\n177:         prompt_mode: PromptMode::Arg,\n178:         providers: vec![ProviderConfig::model_provider(\n179:             provider_name(),\n180:             vec![\"--model\".to_string(), \"sonnet\".to_string()],\n181:         )],\n182:         inputs: Vec::new(),\n183:         provider: Some(ProviderImplementationRef {\n184:             path: Some(provider_path.display().to_string()),\n185:             crate_name: None,\n186:             version: None,\n187:             binary: None,\n188:             script: None,\n189:         }),\n190:     }\n191: }\n192: \n193: fn write_external_provider_fixture(dir: &Path, record_path: &Path) -> PathBuf {\n194:     let path = dir.join(\"external-provider-fixture.py\");\n195:     fs::write(&path, external_provider_fixture_body(record_path)).expect(\"provider script\");\n196:     let mut permissions = fs::metadata(&path).expect(\"metadata\").permissions();\n197:     permissions.set_mode(0o755);\n198:     fs::set_permissions(&path, permissions).expect(\"chmod\");\n199:     path\n200: }\n201: \n202: fn external_provider_fixture_body(record_path: &Path) -> String {\n203:     r#\"#!/usr/bin/env python3\n204: import base64\n205: import json\n206: import pathlib\n207: import sys\n208: \n209: CONTRACT = \"oulipoly.provider/v1\"\n210: RECORD_PATH = pathlib.Path(@@RECORD_PATH@@)\n211: SESSION_ID = \"@@SESSION_ID@@\"\n212: \n213: subcommand = sys.argv[1] if len(sys.argv) > 1 else \"\"\n214: raw = sys.stdin.read() or \"{}\"\n215: request = json.loads(raw)\n216: with RECORD_PATH.open(\"a\", encoding=\"utf-8\") as handle:\n217:     handle.write(json.dumps({\"subcommand\": subcommand, \"request\": request}, sort_keys=True) + \