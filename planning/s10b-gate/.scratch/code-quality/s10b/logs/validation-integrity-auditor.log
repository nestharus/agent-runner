t locate_export =\n1671: +        read_source(\"src-tauri/src/commands/session_locate_export/orchestration.rs\");\n1672: +    assert_contains(\n1673: +        \"session_locate_export/orchestration.rs::build_session_locate_provider_registry\",\n1674: +        &locate_export,\n1675: +        \".with_path_entries_from_process_path()\",\n1676: +    );\n1677: +\n1678: +    let app_state = read_source(\"src-tauri/src/app_state.rs\");\n1679: +    assert_contains(\n1680: +        \"app_state.rs::provider_registry_options\",\n1681: +        &app_state,\n1682: +        \".with_path_entries_from_process_path()\",\n1683: +    );\n1684: +\n1685: +    let provider_settings = read_source(\"src-tauri/src/commands/provider_settings.rs\");\n1686: +    assert_contains(\n1687: +        \"provider_settings.rs::host_options\",\n1688: +        &provider_settings,\n1689: +        \".with_path_entries_from_process_path()\",\n1690: +    );\n1691: +}\n1692: +\n1693:  fn read_source(relative: &str) -> String {\n1694:      std::fs::read_to_string(workspace_root().join(relative))\n1695:          .unwrap_or_else(|error| panic!(\"failed to read {relative}: {error}\"))\n1696:  }\n1697:  \n1698:  fn source_between<'a>(source: &'a str, start: &str, end: &str) -> &'a str {\n1699: -    let start_index = source\n1700: -        .find(start)\n1701: -        .unwrap_or_else(|| panic!(\"missing start marker {start:?}\"));\n1702: -    let end_index = source[start_index..]\n1703: +    let start_index = source_marker_index(source, start);\n1704: +    let end_index = source_end_marker_index(source, start_index, start, end);\n1705: +    source_slice_between(source, start_index, end_index)\n1706: +}\n1707: +\n1708: +fn source_marker_index(source: &str, marker: &str) -> usize {\n1709: +    source\n1710: +        .find(marker)\n1711: +        .unwrap_or_else(|| panic!(\"missing start marker {marker:?}\"))\n1712: +}\n1713: +\n1714: +fn source_end_marker_index(source: &str, start_index: usize, start: &str, end: &str) -> usize {\n1715: +    source[start_index..]\n1716:          .find(end)\n1717:          .map(|offset| start_index + offset)\n1718: -        .unwrap_or_else(|| panic!(\"missing end marker {end:?} after {start:?}\"));\n1719: +        .unwrap_or_else(|| panic!(\"missing end marker {end:?} after {start:?}\"))\n1720: +}\n1721: +\n1722: +fn source_slice_between(source: &str, start_index: usize, end_index: usize) -> &str {\n1723:      &source[start_index..end_index]\n1724:  }\n1725:  \n1726: @@ -217,10 +273,17 @@ fn assert_not_contains(context: &str, source: &str, needle: &str) {\n1727:  }\n1728:  \n1729:  fn assert_not_contains_compact(context: &str, source: &str, needle: &str) {\n1730: -    let compact_source = compact_whitespace(source);\n1731: -    let compact_needle = compact_whitespace(needle);\n1732: +    let (compact_source, compact_needle) = compact_source_and_needle(source, needle);\n1733: +    assert_compact_absent(context, &compact_source, &compact_needle, needle);\n1734: +}\n1735: +\n1736: +fn compact_source_and_needle(source: &str, needle: &str) -> (String, String) {\n1737: +    (compact_whitespace(source), compact_whitespace(needle))\n1738: +}\n1739: +\n1740: +fn assert_compact_absent(context: &str, compact_source: &str, compact_needle: &str, needle: &str) {\n1741:      assert!(\n1742: -        !compact_source.contains(&compact_needle),\n1743: +        !compact_source.contains(compact_needle),\n1744:          \"{context} must not hard-code missing external-provider identity: found {needle:?}\"\n1745:      );\n1746:  }\n1747: diff --git a/src-tauri/tests/s10_external_provider_resume.rs b/src-tauri/tests/s10_external_provider_resume.rs\n1748: new file mode 100644\n1749: index 0000000..86bab11\n1750: --- /dev/null\n1751: +++ b/src-tauri/tests/s10_external_provider_resume.rs\n1752: @@ -0,0 +1,535 @@\n1753: +#![cfg(unix)]\n1754: +\n1755: +use serde_json::Value;\n1756: +use std::fs;\n1757: +use std::os::unix::fs::PermissionsExt;\n1758: +use std::path::{Path, PathBuf};\n1759: +use std::process::{Command, Output};\n1760: +\n1761: +const MODEL: &str = \"provider-ref-model\";\n1762: +const PROVIDER: &str = \"provider-ref-account\";\n1763: +const SESSION_ID: &str = \"a9a8c8d0-8f5f-402e-857c-c5c549446beb\";\n1764: +\n1765: +struct Fixture {\n1766: +    _dir: tempfile::TempDir,\n1767: +    config_home: PathBuf,\n1768: +    data_home: PathBuf,\n1769: +    models_dir: PathBuf,\n1770: +    workspace: PathBuf,\n1771: +    hostile_cwd: PathBuf,\n1772: +    record_path: PathBuf,\n1773: +}\n1774: +\n1775: +struct FixturePaths {\n1776: +    config_home: PathBuf,\n1777: +    data_home: PathBuf,\n1778: +    app_config_dir: PathBuf,\n1779: +    models_dir: PathBuf,\n1780: +    workspace: PathBuf,\n1781: +    hostile_cwd: PathBuf,\n1782: +    record_path: PathBuf,\n1783: +}\n1784: +\n1785: +#[derive(Debug)]\n1786: +struct InvocationSessionRow {\n1787: +    session_id: Option<String>,\n1788: +    session_capture_method: Option<String>,\n1789: +    provider_session_id: Option<String>,\n1790: +    resume_input_id: Option<String>,\n1791: +    provider_session_capture_method: Option<String>,\n1792: +}\n1793: +\n1794: +struct ProviderOptions {\n1795: +    launch_session_key: &'static str,\n1796: +    session_capability: bool,\n1797: +}\n1798: +\n1799: +impl ProviderOptions {\n1800: +    fn provider_session_id() -> Self {\n1801: +        Self {\n1802: +            launch_session_key: \"provider_session_id\",\n1803: +            session_capability: true,\n1804: +        }\n1805: +    }\n1806: +\n1807: +    fn session_id_without_session_capability() -> Self {\n1808: +        Self {\n1809: +            launch_session_key: \"session_id\",\n1810: +            session_capability: false,\n1811: +        }\n1812: +    }\n1813: +}\n1814: +\n1815: +impl Fixture {\n1816: +    fn new() -> Self {\n1817: +        Self::new_with_provider_options(ProviderOptions::provider_session_id())\n1818: +    }\n1819: +\n1820: +    fn new_with_provider_options(options: ProviderOptions) -> Self {\n1821: +        let dir = tempfile::tempdir().unwrap();\n1822: +        let paths = fixture_paths(dir.path());\n1823: +        create_fixture_directories(&paths);\n1824: +        let provider_path = write_external_provider(dir.path(), &paths.record_path, options);\n1825: +        write_model_config(&paths.models_dir, &provider_path);\n1826: +        write_providers_config(&paths.app_config_dir);\n1827: +        fixture_from_paths(dir, paths)\n1828: +    }\n1829: +\n1830: +    fn run_launch(&self) -> Output {\n1831: +        let mut cmd = self.command();\n1832: +        cmd.current_dir(&self.workspace)\n1833: +            .arg(\"--models-dir\")\n1834: +            .arg(&self.models_dir)\n1835: +            .arg(\"--model\")\n1836: +            .arg(MODEL)\n1837: +            .arg(\"first prompt\");\n1838: +        cmd.output().unwrap()\n1839: +    }\n1840: +\n1841: +    fn run_resume(&self) -> Output {\n1842: +        let mut cmd = self.command();\n1843: +        cmd.current_dir(&self.hostile_cwd)\n1844: +            .arg(\"resume\")\n1845: +            .arg(\"--models-dir\")\n1846: +            .arg(&self.models_dir)\n1847: +            .arg(\"--model\")\n1848: +            .arg(MODEL)\n1849: +            .arg(\"--session-id\")\n1850: +            .arg(SESSION_ID)\n1851: +            .arg(\"--prompt\")\n1852: +            .arg(\"resume prompt\");\n1853: +        cmd.output().unwrap()\n1854: +    }\n1855: +\n1856: +    fn command(&self) -> Command {\n1857: +        let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_oulipoly-agent-runner\"));\n1858: +        cmd.env(\"XDG_CONFIG_HOME\", &self.config_home);\n1859: +        cmd.env(\"XDG_DATA_HOME\", &self.data_home);\n1860: +        cmd.env_remove(\"OULIPOLY_DATA_DIR\");\n1861: +        cmd.env_remove(\"OULIPOLY_PARENT_INVOCATION\");\n1862: +        cmd\n1863: +    }\n1864: +\n1865: +    fn db_path(&self) -> PathBuf {\n1866: +        self.data_home\n1867: +            .join(\"oulipoly-agent-runner\")\n1868: +            .join(\"state.db\")\n1869: +    }\n1870: +\n1871: +    fn invocation_session_rows(&self) -> Vec<InvocationSessionRow> {\n1872: +        let conn = rusqlite::Connection::open(self.db_path()).unwrap();\n1873: +        let mut stmt = conn\n1874: +            .prepare(\n1875: +                \"SELECT session_id, session_capture_method, provider_session_id,\n1876: +                        resume_input_id, provider_session_capture_method\n1877: +                   FROM invocations\n1878: +                   ORDER BY id\",\n1879: +            )\n1880: +            .unwrap();\n1881: +        stmt.query_map([], invocation_session_row)\n1882: +            .unwrap()\n1883: +            .collect::<Result<Vec<_>, _>>()\n1884: +            .unwrap()\n1885: +    }\n1886: +\n1887: +    fn records(&self) -> Vec<Value> {\n1888: +        parse_provider_records(&provider_record_text(&self.record_path))\n1889: +    }\n1890: +}\n1891: +\n1892: +fn fixture_paths(root: &Path) -> FixturePaths {\n1893: +    let config_home = root.join(\"config\");\n1894: +    let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n1895: +    FixturePaths {\n1896: +        data_home: root.join(\"data\"),\n1897: +        models_dir: app_config_dir.join(\"models\"),\n1898: +        workspace: root.join(\"workspace\"),\n1899: +        hostile_cwd: root.join(\"hostile-cwd\"),\n1900: +        record_path: root.join(\"provider-records.jsonl\"),\n1901: +        config_home,\n1902: +        app_config_dir,\n1903: +    }\n1904: +}\n1905: +\n1906: +fn create_fixture_directories(paths: &FixturePaths) {\n1907: +    fs::create_dir_all(&paths.models_dir).unwrap();\n1908: +    fs::create_dir_all(&paths.workspace).unwrap();\n1909: +    fs::create_dir_all(&paths.hostile_cwd).unwrap();\n1910: +}\n1911: +\n1912: +fn write_model_config(models_dir: &Path, provider_path: &Path) {\n1913: +    fs::write(\n1914: +        models_dir.join(format!(\"{MODEL}.toml\")),\n1915: +        model_config_toml(provider_path),\n1916: +    )\n1917: +    .unwrap();\n1918: +}\n1919: +\n1920: +fn model_config_toml(provider_path: &Path) -> String {\n1921: +    format!(\n1922: +        r#\"provider = {{ path = {:?} }}\n1923: +prompt_mode = \"arg\"\n1924: +\n1925: +[[providers]]\n1926: +name = {:?}\n1927: +args = [\"--model\", \"haiku\"]\n1928: +\"#,\n1929: +        provider_path.display().to_string(),\n1930: +        PROVIDER,\n1931: +    )\n1932: +}\n1933: +\n1934: +fn write_providers_config(app_config_dir: &Path) {\n1935: +    fs::write(\n1936: +        app_config_dir.join(\"providers.toml\"),\n1937: +        providers_config_toml(),\n1938: +    )\n1939: +    .unwrap();\n1940: +}\n1941: +\n1942: +fn providers_config_toml() -> String {\n1943: +    format!(\n1944: +        r#\"[{PROVIDER}]\n1945: +command = \"native-provider\"\n1946: +args = [\"--base\"]\n1947: +prompt_mode = \"arg\"\n1948: +\"#,\n1949: +    )\n1950: +}\n1951: +\n1952: +fn fixture_from_paths(dir: tempfile::TempDir, paths: FixturePaths) -> Fixture {\n1953: +    Fixture {\n1954: +        _dir: dir,\n1955: +        config_home: paths.config_home,\n1956: +        data_home: paths.data_home,\n1957: +        models_dir: paths.models_dir,\n1958: +        workspace: paths.workspace,\n1959: +        hostile_cwd: paths.hostile_cwd,\n1960: +        record_path: paths.record_path,\n1961: +    }\n1962: +}\n1963: +\n1964: +fn invocation_session_row(row: &rusqlite::Row<'_>) -> rusqlite::Result<InvocationSessionRow> {\n1965: +    Ok(InvocationSessionRow {\n1966: +        session_id: row.get(0)?,\n1967: +        session_capture_method: row.get(1)?,\n1968: +        provider_session_id: row.get(2)?,\n1969: +        resume_input_id: row.get(3)?,\n1970: +        provider_session_capture_method: row.get(4)?,\n1971: +    })\n1972: +}\n1973: +\n1974: +fn provider_record_text(path: &Path) -> String {\n1975: +    fs::read_to_string(path).unwrap()\n1976: +}\n1977: +\n1978: +fn parse_provider_records(text: &str) -> Vec<Value> {\n1979: +    text.lines()\n1980: +        .filter(|line| provider_record_line_has_content(line))\n1981: +        .map(parse_provider_record)\n1982: +        .collect()\n1983: +}\n1984: +\n1985: +fn provider_record_line_has_content(line: &str) -> bool {\n1986: +    !line.trim().is_empty()\n1987: +}\n1988: +\n1989: +fn parse_provider_record(line: &str) -> Value {\n1990: +    serde_json::from_str(line).unwrap()\n1991: +}\n1992: +\n1993: +#[test]\n1994: +fn external_provider_resume_without_rotate_uses_external_launch_and_recorded_cwd() {\n1995: +    let fixture = Fixture::new();\n1996: +\n1997: +    let launch = fixture.run_launch();\n1998: +    assert_success(&launch);\n1999: +\n2000: +    let resume = fixture.run_resume();\n2001: +    assert_success(&resume);\n2002: +    let resume_stderr = String::from_utf8_lossy(&resume.stderr);\n2003: +    assert!(\n2004: +        !resume_stderr.contains(\"migration failed\"),\n2005: +        \"{resume_stderr}\"\n2006: +    );\n2007: +    assert!(\n2008: +        !resume_stderr.contains(\"could not resolve original cwd\"),\n2009: +        \"{resume_stderr}\"\n2010: +    );\n2011: +\n2012: +    let records = fixture.records();\n2013: +    assert_no_rotation_or_migration_provider_calls(&records);\n2014: +    let launches = records_for_subcommand(&records, \"launch\");\n2015: +    assert_eq!(launches.len(), 2, \"records: {records:?}\");\n2016: +\n2017: +    let resume_launch = &launches[1][\"request\"];\n2018: +    assert_eq!(\n2019: +        resume_launch[\"params\"][\"session\"][\"known_provider_session_id\"].as_str(),\n2020: +        Some(SESSION_ID),\n2021: +        \"resume must pass the provider session captured by the first external launch\"\n2022: +    );\n2023: +    assert_eq!(\n2024: +        resume_launch[\"params\"][\"model\"][\"inputs\"][\"prompt\"].as_str(),\n2025: +        Some(\"resume prompt\")\n2026: +    );\n2027: +    assert_eq!(\n2028: +        resume_launch[\"params\"][\"working_directory\"].as_str(),\n2029: +        Some(fixture.workspace.to_string_lossy().as_ref()),\n2030: +        \"resume must use the original launch cwd, not the caller's current cwd\"\n2031: +    );\n2032: +    assert_eq!(\n2033: +        resume_launch[\"params\"][\"provider_name\"].as_str(),\n2034: +        None,\n2035: +        \"provider_name lives in session requests, not launch params\"\n2036: +    );\n2037: +\n2038: +    assert_external_launch_session_capture_rows(&fixture.invocation_session_rows());\n2039: +}\n2040: +\n2041: +#[test]\n2042: +fn external_launch_session_id_alias_persists_external_capture_method_without_session_capability() {\n2043: +    let fixture = Fixture::new_with_provider_options(\n2044: +        ProviderOptions::session_id_without_session_capability(),\n2045: +    );\n2046: +\n2047: +    let launch = fixture.run_launch();\n2048: +    assert_success(&launch);\n2049: +    let stderr = String::from_utf8_lossy(&launch.stderr);\n2050: +    assert!(stderr.contains(\"Session ingest failed\"), \"{stderr}\");\n2051: +\n2052: +    let rows = fixture.invocation_session_rows();\n2053: +    assert_eq!(rows.len(), 1, \"rows: {rows:?}\");\n2054: +    assert_external_launch_session_capture_row(&rows[0]);\n2055: +}\n2056: +\n2057: +fn assert_external_launch_session_capture_rows(rows: &[InvocationSessionRow]) {\n2058: +    assert_eq!(rows.len(), 2, \"rows: {rows:?}\");\n2059: +    assert_external_launch_session_capture_row(&rows[0]);\n2060: +\n2061: +    let resume = &rows[1];\n2062: +    assert_eq!(resume.session_id.as_deref(), Some(SESSION_ID));\n2063: +    assert_eq!(resume.session_capture_method.as_deref(), Some(\"resumed\"));\n2064: +    assert_eq!(resume.provider_session_id.as_deref(), Some(SESSION_ID));\n2065: +    assert_eq!(resume.resume_input_id.as_deref(), Some(SESSION_ID));\n2066: +    assert_eq!(\n2067: +        resume.provider_session_capture_method.as_deref(),\n2068: +        Some(\"resumed\")\n2069: +    );\n2070: +}\n2071: +\n2072: +fn assert_external_launch_session_capture_row(launch: &InvocationSessionRow) {\n2073: +    assert_eq!(launch.session_id.as_deref(), Some(SESSION_ID));\n2074: +    assert_eq!(\n2075: +        launch.session_capture_method.as_deref(),\n2076: +        Some(\"external_provider_launch\")\n2077: +    );\n2078: +    assert_eq!(launch.provider_session_id.as_deref(), Some(SESSION_ID));\n2079: +    assert_eq!(launch.resume_input_id.as_deref(), None);\n2080: +    assert_eq!(\n2081: +        launch.provider_session_capture_method.as_deref(),\n2082: +        Some(\"external_provider_launch\")\n2083: +    );\n2084: +}\n2085: +\n2086: +fn assert_success(output: &Output) {\n2087: +    assert_eq!(\n2088: +        output.status.code(),\n2089: +        Some(0),\n2090: +        \"stdout={}\\nstderr={}\",\n2091: +        String::from_utf8_lossy(&output.stdout),\n2092: +        String::from_utf8_lossy(&output.stderr)\n2093: +    );\n2094: +}\n2095: +\n2096: +fn records_for_subcommand<'a>(records: &'a [Value], subcommand: &str) -> Vec<&'a Value> {\n2097: +    records\n2098: +        .iter()\n2099: +        .filter(|record| record[\"subcommand\"] == subcommand)\n2100: +        .collect()\n2101: +}\n2102: +\n2103: +fn assert_no_rotation_or_migration_provider_calls(records: &[Value]) {\n2104: +    let subcommands = provider_record_subcommands(records);\n2105: +    assert_no_forbidden_provider_subcommands(&subcommands);\n2106: +}\n2107: +\n2108: +fn provider_record_subcommands(records: &[Value]) -> Vec<&str> {\n2109: +    records.iter().map(provider_record_subcommand).collect()\n2110: +}\n2111: +\n2112: +fn provider_record_subcommand(record: &Value) -> &str {\n2113: +    record[\"subcommand\"].as_str().unwrap_or_default()\n2114: +}\n2115: +\n2116: +fn assert_no_forbidden_provider_subcommands(subcommands: &[&str]) {\n2117: +    assert!(\n2118: +        subcommands\n2119: +            .iter()\n2120: +            .all(|subcommand| provider_subcommand_is_allowed(subcommand)),\n2121: +        \"unexpected rotation/migration calls: {subcommands:?}\"\n2122: +    );\n2123: +}\n2124: +\n2125: +fn provider_subcommand_is_allowed(subcommand: &str) -> bool {\n2126: +    !subcommand.starts_with(\"rotation.\") && !subcommand.starts_with(\"migration.\")\n2127: +}\n2128: +\n2129: +fn write_external_provider(dir: &Path, record_path: &Path, options: ProviderOptions) -> PathBuf {\n2130: +    fs::write(record_path, \"\").unwrap();\n2131: +    let path = dir.join(\"external-provider.py\");\n2132: +    fs::write(&path, external_provider_script(record_path, options)).unwrap();\n2133: +    let mut permissions = fs::metadata(&path).unwrap().permissions();\n2134: +    permissions.set_mode(0o755);\n2135: +    fs::set_permissions(&path, permissions).unwrap();\n2136: +    path\n2137: +}\n2138: +\n2139: +fn external_provider_script(record_path: &Path, options: ProviderOptions) -> String {\n2140: +    format!(\n2141: +        r#\"#!/usr/bin/env python3\n2142: +import base64\n2143: +import json\n2144: +import pathlib\n2145: +import sys\n2146: +\n2147: +CONTRACT = \"oulipoly.provider/v1\"\n2148: +PROVIDER = {provider}\n2149: +SESSION_ID = {session_id}\n2150: +RECORD_PATH = pathlib.Path({record_path})\n2151: +\n2152: +subcommand = sys.argv[1] if len(sys.argv) > 1 else \"\"\n2153: +request = json.loads(sys.stdin.read() or \"{{}}\")\n2154: +with RECORD_PATH.open(\"a\", encoding=\"utf-8\") as handle:\n2155: +    handle.write(json.dumps({{\"subcommand\": subcommand, \"request\": request}}, sort_keys=True) + \"\\n\")\n2156: +\n2157: +def request_id():\n2158: +    return request.get(\"request_id\", \"s10-request\")\n2159: +\n2160: +def envelope(result):\n2161: +    return {{\n2162: +        \"contract\": request.get(\"contract\", CONTRACT),\n2163: +        \"request_id\": request_id(),\n2164: +        \"ok\": True,\n2165: +        \"result\": result,\n2166: +    }}\n2167: +\n2168: +def error(code):\n2169: +    return {{\n2170: +        \"contract\": request.get(\"contract\", CONTRACT),\n2171: +        \"request_id\": request_id(),\n2172: +        \"ok\