+fn deserialize_fixed_str_type<E>(actual: String, expected: &str, type_name: &str) -> Result<(), E>
+where
+    E: de::Error,
+{
+    if actual == expected {
+        Ok(())
+    } else {
+        Err(E::custom(fixed_str_type_error(type_name, expected)))
+    }
