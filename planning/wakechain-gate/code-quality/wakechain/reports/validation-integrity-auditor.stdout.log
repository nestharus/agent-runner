ion regression suite\n2278: +//!     Owns:\n2279: +//!       - isolated config/data fixture materialization\n2280: +//!       - fake opencode script generation and executable setup\n2281: +//!       - transcript export fixture construction\n2282: +//!       - wake/resume command invocation and environment isolation\n2283: +//!       - delivery confirmation and consumed-notification assertions\n2284: +//! ```\n2285: +\n2286: +use oulipoly_state::StateDb;\n2287: +use oulipoly_state::mailbox::{AgentBashCompleteEnqueue, MailboxDb};\n2288: +use rusqlite::{Connection, params};\n2289: +use std::fs;\n2290: +use std::os::unix::fs::PermissionsExt;\n2291: +use std::path::{Path, PathBuf};\n2292: +use std::process::{Command, Output};\n2293: +use std::sync::{Mutex, MutexGuard, OnceLock};\n2294: +use std::time::{Duration, Instant};\n2295: +\n2296: +const MODEL: &str = \"wake-confirm-legacy-opencode\";\n2297: +const PROVIDER: &str = \"opencode\";\n2298: +const SESSION: &str = \"ses_wakeconfirmlegacy\";\n2299: +const HANDLE: &str = \"h-wake-confirm-legacy\";\n2300: +const CHAIN_ID: &str = \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\";\n2301: +\n2302: +struct Fixture {\n2303: +    dir: tempfile::TempDir,\n2304: +    config_home: PathBuf,\n2305: +    data_home: PathBuf,\n2306: +    home_dir: PathBuf,\n2307: +    app_config_dir: PathBuf,\n2308: +    models_dir: PathBuf,\n2309: +    bin_dir: PathBuf,\n2310: +    work_dir: PathBuf,\n2311: +    export_dir: PathBuf,\n2312: +}\n2313: +\n2314: +impl Fixture {\n2315: +    fn new() -> Self {\n2316: +        let dir = tempfile::tempdir().unwrap();\n2317: +        let config_home = dir.path().join(\"xdg-config\");\n2318: +        let data_home = dir.path().join(\"xdg-data\");\n2319: +        let home_dir = dir.path().join(\"home\");\n2320: +        let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n2321: +        let models_dir = app_config_dir.join(\"models\");\n2322: +        let bin_dir = dir.path().join(\"bin\");\n2323: +        let work_dir = dir.path().join(\"work\");\n2324: +        let export_dir = dir.path().join(\"fake-opencode-export\");\n2325: +        fs::create_dir_all(&models_dir).unwrap();\n2326: +        fs::create_dir_all(&bin_dir).unwrap();\n2327: +        fs::create_dir_all(&work_dir).unwrap();\n2328: +        fs::create_dir_all(&export_dir).unwrap();\n2329: +        fs::create_dir_all(&home_dir).unwrap();\n2330: +        Self {\n2331: +            dir,\n2332: +            config_home,\n2333: +            data_home,\n2334: +            home_dir,\n2335: +            app_config_dir,\n2336: +            models_dir,\n2337: +            bin_dir,\n2338: +            work_dir,\n2339: +            export_dir,\n2340: +        }\n2341: +    }\n2342: +\n2343: +    fn app_data_dir(&self) -> PathBuf {\n2344: +        self.data_home.join(\"oulipoly-agent-runner\")\n2345: +    }\n2346: +\n2347: +    fn sidecar_path(&self) -> PathBuf {\n2348: +        self.app_data_dir().join(\"pid-identity.db\")\n2349: +    }\n2350: +\n2351: +    fn state_path(&self) -> PathBuf {\n2352: +        self.app_data_dir().join(\"state.db\")\n2353: +    }\n2354: +\n2355: +    fn run(&self, mut cmd: Command) -> Output {\n2356: +        cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n2357: +            .env(\"XDG_DATA_HOME\", &self.data_home)\n2358: +            .env(\"HOME\", &self.home_dir)\n2359: +            .env(\"PATH\", self.path_env())\n2360: +            .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n2361: +            .env(\"WAKE_CONFIRM_WORK_DIR\", &self.work_dir)\n2362: +            .env(\"WAKE_CONFIRM_EXPORT_DIR\", &self.export_dir)\n2363: +            .env_remove(\"OULIPOLY_DATA_DIR\")\n2364: +            .env_remove(\"OULIPOLY_AUTO_WAKE\")\n2365: +            .env_remove(\"OULIPOLY_AUTO_WAKE_SESSION_ID\")\n2366: +            .env_remove(\"OULIPOLY_AUTO_WAKE_TOKEN\")\n2367: +            .env_remove(\"OULIPOLY_AUTO_WAKE_COUNT\")\n2368: +            .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n2369: +            .current_dir(self.dir.path());\n2370: +        cmd.output().unwrap()\n2371: +    }\n2372: +\n2373: +    fn path_env(&self) -> String {\n2374: +        let current = std::env::var(\"PATH\").unwrap_or_default();\n2375: +        format!(\"{}:{current}\", self.bin_dir.display())\n2376: +    }\n2377: +\n2378: +    fn run_agent(&self, prompt: &str) -> Output {\n2379: +        let mut cmd = Command::new(runner_bin());\n2380: +        cmd.env(\"WAKE_CONFIRM_NO_NOTIFY\", \"1\")\n2381: +            .arg(\"-m\")\n2382: +            .arg(MODEL)\n2383: +            .arg(\"--models-dir\")\n2384: +            .arg(&self.models_dir)\n2385: +            .arg(prompt);\n2386: +        self.run(cmd)\n2387: +    }\n2388: +\n2389: +    fn run_resume_with_env(&self, envs: &[(&str, &str)]) -> Output {\n2390: +        let mut cmd = Command::new(runner_bin());\n2391: +        for (key, value) in envs {\n2392: +            cmd.env(key, value);\n2393: +        }\n2394: +        cmd.arg(\"resume\")\n2395: +            .arg(\"--session-id\")\n2396: +            .arg(SESSION)\n2397: +            .arg(\"-m\")\n2398: +            .arg(MODEL)\n2399: +            .arg(\"--models-dir\")\n2400: +            .arg(&self.models_dir);\n2401: +        self.run(cmd)\n2402: +    }\n2403: +\n2404: +    fn write_legacy_opencode(&self) {\n2405: +        self.write_executable(\"opencode\", fake_opencode_script());\n2406: +        self.write_executable(\"opencode-turns\", fake_opencode_turns_script());\n2407: +        fs::write(\n2408: +            self.models_dir.join(format!(\"{MODEL}.toml\")),\n2409: +            format!(\n2410: +                r#\"prompt_mode = \"arg\"\n2411: +\n2412: +[[providers]]\n2413: +name = \"{PROVIDER}\"\n2414: +args = []\n2415: +\"#,\n2416: +            ),\n2417: +        )\n2418: +        .unwrap();\n2419: +        fs::write(\n2420: +            self.app_config_dir.join(\"providers.toml\"),\n2421: +            format!(\n2422: +                r#\"[{PROVIDER}]\n2423: +command = \"opencode\"\n2424: +args = [\"run\"]\n2425: +prompt_mode = \"arg\"\n2426: +\n2427: +[{PROVIDER}.session_capture]\n2428: +kind = \"stdout_json_event\"\n2429: +json_args = [\"--json\"]\n2430: +event_type = \"step_start\"\n2431: +event_id_path = \"sessionID\"\n2432: +\n2433: +[{PROVIDER}.resume]\n2434: +kind = \"flag\"\n2435: +flag = \"--session\"\n2436: +\"#,\n2437: +            ),\n2438: +        )\n2439: +        .unwrap();\n2440: +        fs::write(\n2441: +            self.app_config_dir.join(\"sessions.toml\"),\n2442: +            format!(\n2443: +                r#\"[{PROVIDER}]\n2444: +turn_script = \"opencode-turns\"\n2445: +state_dir = {}\n2446: +\"#,\n2447: +                toml_string(&path_string(&self.work_dir.join(\"turn-state\")))\n2448: +            ),\n2449: +        )\n2450: +        .unwrap();\n2451: +    }\n2452: +\n2453: +    fn write_executable(&self, name: &str, body: &str) -> PathBuf {\n2454: +        let path = self.bin_dir.join(name);\n2455: +        fs::write(&path, body).unwrap();\n2456: +        let mut perms = fs::metadata(&path).unwrap().permissions();\n2457: +        perms.set_mode(0o755);\n2458: +        fs::set_permissions(&path, perms).unwrap();\n2459: +        path\n2460: +    }\n2461: +\n2462: +    fn mailbox(&self) -> MailboxDb {\n2463: +        MailboxDb::open(&self.sidecar_path()).unwrap()\n2464: +    }\n2465: +\n2466: +    fn state(&self) -> StateDb {\n2467: +        StateDb::open(&self.state_path()).unwrap()\n2468: +    }\n2469: +\n2470: +    fn ensure_active_chain_for_legacy_session(&self) {\n2471: +        if self\n2472: +            .state()\n2473: +            .chain_id_for_segment(PROVIDER, SESSION)\n2474: +            .unwrap()\n2475: +            .is_some()\n2476: +        {\n2477: +            return;\n2478: +        }\n2479: +        let conn = Connection::open(self.state_path()).unwrap();\n2480: +        conn.execute(\n2481: +            \"INSERT INTO session_chains (chain_id, created_at, last_used_at, model_name)\n2482: +             VALUES (?1, '2026-06-07T00:00:00Z', '2026-06-07T00:00:00Z', ?2)\",\n2483: +            params![CHAIN_ID, MODEL],\n2484: +        )\n2485: +        .unwrap();\n2486: +        conn.execute(\n2487: +            \"INSERT INTO session_chain_segments\n2488: +                (chain_id, provider_name, session_id, started_at, transition_reason)\n2489: +             VALUES (?1, ?2, ?3, '2026-06-07T00:00:00Z', 'initial')\",\n2490: +            params![CHAIN_ID, PROVIDER, SESSION],\n2491: +        )\n2492: +        .unwrap();\n2493: +    }\n2494: +\n2495: +    fn seed_mailbox_notification(&self) {\n2496: +        let state_dir = self.work_dir.join(HANDLE);\n2497: +        fs::create_dir_all(&state_dir).unwrap();\n2498: +        let meta = state_dir.join(\"meta.json\");\n2499: +        let log = state_dir.join(\"log\");\n2500: +        let rc = state_dir.join(\"rc\");\n2501: +        fs::write(&meta, r#\"{\"caller_chain\":[]}\"#).unwrap();\n2502: +        fs::write(&log, \"legacy opencode workload completed\\n\").unwrap();\n2503: +        fs::write(&rc, \"0\\n\").unwrap();\n2504: +        let payload_json = serde_json::json!({\n2505: +            \"schema_version\": 1,\n2506: +            \"kind\": \"agent_bash_complete\",\n2507: +            \"handle\": HANDLE,\n2508: +            \"state_dir\": path_string(&state_dir),\n2509: +            \"meta_path\": path_string(&meta),\n2510: +            \"log_path\": path_string(&log),\n2511: +            \"rc_path\": path_string(&rc),\n2512: +            \"rc\": 0,\n2513: +        })\n2514: +        .to_string();\n2515: +        let mut mailbox = self.mailbox();\n2516: +        mailbox\n2517: +            .enqueue_agent_bash_complete(&AgentBashCompleteEnqueue {\n2518: +                session_id: SESSION,\n2519: +                handle: HANDLE,\n2520: +                payload_json: &payload_json,\n2521: +                owner_invocation_uuid: None,\n2522: +                matched_os_pid: None,\n2523: +                matched_os_boot_id: None,\n2524: +                matched_os_pid_starttime_ticks: None,\n2525: +                matched_chain_index: None,\n2526: +                state_dir: &path_string(&state_dir),\n2527: +                meta_path: &path_string(&meta),\n2528: +                log_path: &path_string(&log),\n2529: +                rc_path: &path_string(&rc),\n2530: +                rc: 0,\n2531: +            })\n2532: +            .unwrap();\n2533: +    }\n2534: +\n2535: +    fn notification_prompt_path(&self) -> PathBuf {\n2536: +        self.work_dir.join(\"legacy-wake-resumed.txt\")\n2537: +    }\n2538: +\n2539: +    fn export_path(&self) -> PathBuf {\n2540: +        self.export_dir.join(format!(\"{SESSION}.jsonl\"))\n2541: +    }\n2542: +\n2543: +    fn export_text(&self) -> String {\n2544: +        fs::read_to_string(self.export_path()).unwrap_or_default()\n2545: +    }\n2546: +\n2547: +    fn unconfirmed_invocation_count(&self) -> i64 {\n2548: +        Connection::open(self.state_path())\n2549: +            .unwrap()\n2550: +            .query_row(\n2551: +                \"SELECT COUNT(*) FROM invocations WHERE error_category = 'mailbox_delivery_unconfirmed'\",\n2552: +                [],\n2553: +                |row| row.get(0),\n2554: +            )\n2555: +            .unwrap()\n2556: +    }\n2557: +\n2558: +    fn assert_xdg_isolated(&self) {\n2559: +        assert!(\n2560: +            !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n2561: +            \"config must stay in isolated XDG_CONFIG_HOME\"\n2562: +        );\n2563: +        assert!(\n2564: +            !self\n2565: +                .home_dir\n2566: +                .join(\".local/share/oulipoly-agent-runner\")\n2567: +                .exists(),\n2568: +            \"state must stay in isolated XDG_DATA_HOME\"\n2569: +        );\n2570: +    }\n2571: +}\n2572: +\n2573: +#[test]\n2574: +fn legacy_opencode_resume_confirms_delivery_after_targeted_turn_ingest() {\n2575: +    let _guard = integration_test_guard();\n2576: +    let fixture = prepared_fixture();\n2577: +    fixture.seed_mailbox_notification();\n2578: +\n2579: +    let output = fixture.run_resume_with_env(&[]);\n2580: +    let prompt = wait_for_file(&fixture.notification_prompt_path());\n2581: +    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n2582: +    assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n2583: +    assert!(prompt.contains(\"handle: h-wake-confirm-legacy\"), \"{prompt}\");\n2584: +    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n2585: +    wait_until(\"fake opencode export contains delivery nonce\", || {\n2586: +        let exported = fixture.export_text();\n2587: +        exported.contains(\"[OULIPOLY NOTIFICATIONS]\") && exported.contains(\"[OULIPOLY-DELIVERY \")\n2588: +    });\n2589: +\n2590: +    assert_success(&output);\n2591: +    wait_until(\"legacy opencode delivery marked delivered\", || {\n2592: +        let db = fixture.mailbox();\n2593: +        let rows = db.list_mailbox(SESSION, true).unwrap();\n2594: +        rows.len() == 1\n2595: +            && rows[0].delivered_at.is_some()\n2596: +            && rows[0].delivery_error.is_none()\n2597: +            && rows[0].delivery_attempts == 1\n2598: +            && rows[0].delivered_by_invocation_uuid.is_some()\n2599: +    });\n2600: +    assert!(\n2601: +        !fixture\n2602: +            .state()\n2603: +            .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n2604: +            .unwrap(),\n2605: +        \"fixture should quote-wrap the delivered user body so exact-text confirmation stays red\"\n2606: +    );\n2607: +    assert!(\n2608: +        fixture\n2609: +            .state()\n2610: +            .has_session_user_turn_containing(\n2611: +                PROVIDER,\n2612: +                SESSION,\n2613: +                &delivery_nonce_from_prompt(&prompt)\n2614: +            )\n2615: +            .unwrap(),\n2616: +        \"session_turns should contain the delivery nonce in the quote-wrapped user body\"\n2617: +    );\n2618: +    assert_eq!(fixture.unconfirmed_invocation_count(), 0);\n2619: +    assert!(fixture.mailbox().list_pending(SESSION).unwrap().is_empty());\n2620: +    fixture.assert_xdg_isolated();\n2621: +}\n2622: +\n2623: +#[test]\n2624: +fn legacy_opencode_resume_leaves_mailbox_pending_when_ingested_turn_omits_delivery_nonce() {\n2625: +    let _guard = integration_test_guard();\n2626: +    let fixture = prepared_fixture();\n2627: +    fixture.seed_mailbox_notification();\n2628: +\n2629: +    let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\", \"1\")]);\n2630: +    assert_exit_code(&output, 1);\n2631: +    let prompt = wait_for_file(&fixture.notification_prompt_path());\n2632: +    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n2633: +    wait_until(\n2634: +        \"fake opencode export contains user turn without delivery nonce\",\n2635: +        || {\n2636: +            let exported = fixture.export_text();\n2637: +            exported.contains(\"[OULIPOLY NOTIFICATIONS]\")\n2638: +                && !exported.contains(\"[OULIPOLY-DELIVERY \")\n2639: +        },\n2640: +    );\n2641: +    wait_until(\n2642: +        \"nonce-less export leaves mailbox pending unconfirmed\",\n2643: +        || {\n2644: +            let db = fixture.mailbox();\n2645: +            let rows = db.list_mailbox(SESSION, true).unwrap();\n2646: +            rows.len() == 1\n2647: +                && rows[0].delivered_at.is_none()\n2648: +                && rows[0].delivery_attempts == 1\n2649: +                && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n2650: +                && rows[0].delivered_by_invocation_uuid.is_none()\n2651: +        },\n2652: +    );\n2653: +    assert!(\n2654: +        !fixture\n2655: +            .state()\n2656: +            .has_session_user_turn_containing(\n2657: +                PROVIDER,\n2658: +                SESSION,\n2659: +                &delivery_nonce_from_prompt(&prompt)\n2660: +            )\n2661: +            .unwrap(),\n2662: +        \"stored resume turn without the delivery nonce must not confirm delivery\"\n2663: +    );\n2664: +    assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n2665: +    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n2666: +    fixture.assert_xdg_isolated();\n2667: +}\n2668: +\n2669: +#[test]\n2670: +fn legacy_opencode_resume_leaves_mailbox_pending_when_export_omits_notification_turn() {\n2671: +    let _guard = integration_test_guard();\n2672: +    let fixture = prepared_fixture();\n2673: +    fixture.seed_mailbox_notification();\n2674: +\n2675: +    let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\", \"1\")]);\n2676: +    assert_exit_code(&output, 1);\n2677: +    let prompt = wait_for_file(&fixture.notification_prompt_path());\n2678: +    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n2679: +    wait_until(\"omitted export leaves mailbox pending unconfirmed\", || {\n2680: +        let db = fixture.mailbox();\n2681: +        let rows = db.list_mailbox(SESSION, true).unwrap();\n2682: +        rows.len() == 1\n2683: +            && rows[0].delivered_at.is_none()\n2684: +            && rows[0].delivery_attempts == 1\n2685: +            && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n2686: +            && rows[0].delivered_by_invocation_uuid.is_none()\n2687: +    });\n2688: +    assert!(\n2689: +        !fixture\n2690: +            .state()\n2691: +            .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n2692: +            .unwrap(),\n2693: +        \"omitted export must not create exact user-turn confirmation evidence\"\n2694: +    );\n2695: +    assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n2696: +    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n2697: +    fixture.assert_xdg_isolated();\n2698: +}\n2699: +\n2700: +fn prepared_fixture() -> Fixture {\n2701: +    let fixture = Fixture::new();\n2702: +    fixture.write_legacy_opencode();\n2703: +    let output = fixture.run_agent(\"launch legacy opencode parent\");\n2704: +    assert_success(&output);\n2705: +    fixture.ensure_active_chain_for_legacy_session();\n2706: +    wait_until(\"legacy opencode parent runtime idle\", || {\n2707: +        fixture\n2708: +            .mailbox()\n2709: +            .session_runtime(SESSION)\n2710: +            .unwrap()\n2711: +            .is_some_and(|runtime| runtime.run_state == \"idle\")\n2712: +    });\n2713: +    fixture\n2714: +}\n2715: +\n2716: +fn fake_opencode_script() -> &'static str {\n2717: +    r#\"#!/usr/bin/env python3\n2718: +import json\n2719: +import os\n2720: +import pathlib\n2721: +import re\n2722: +import sys\n2723: +\n2724: +SESSION = \"ses_wakeconfirmlegacy\"\n2725: +\n2726: +def work_dir():\n2727: +    return pathlib.Path(os.environ[\"WAKE_CONFIRM_WORK_DIR\"])\n2728: +\n2729: +def export_dir():\n2730: +    return pathlib.Path(os.environ[\"WAKE_CONFIRM_EXPORT_DIR\"])\n2731: +\n2732: +def session_path(session_id):\n2733: +    return export_dir() / f\"{session_id}.jsonl\"\n2734: +\n2735: +def next_turn_id(session_id, role):\n2736: +    path = session_path(session_id)\n2737: +    if not path.exists():\n2738: +        return f\"{role}-1\"\n2739: +    count = sum(1 for line in path.read_text(encoding=\"utf-8\").splitlines() if line.strip())\n2740: +    return f\"{role}-{count + 1}\"\n2741: +\n2742: +def append_turn(session_id, role, text):\n2743: +    export_dir().mkdir(parents=True, exist_ok=True)\n2744: +    turn = {\n2745: +        \"session_id\": session_id,\n2746: +        \"turn_id\": next_turn_id(session_id, role),\n2747: +        \"timestamp\": \"2026-06-07T00:00:00Z\",\n2748: +        \"role\": role,\n2749: +        \"body\": [{\"type\": \"text\", \"text\": text}],\n2750: +    }\n2751: +    with session_path(session_id).open(\"a\", encoding=\"utf-8\") as handle:\n2752: +        handle.write(json.dumps(turn, separators=(\",\", \":\")) + \"\\n\")\n2753: +\n2754: +def stored_resume_prompt(prompt):\n2755: +    if os.environ.get(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\") == \"1\":\n2756: +        prompt = re.sub(r\"^\\[OULIPOLY-DELIVERY [^\\n]*\\]\\n?\", \"\", prompt, flags=re.MULTILINE)\n2757: +    return f'\"{prompt}\"'\n2758: +\n2759: +def parse_run(argv):\n2760: +    session_id = SESSION\n2761: +    prompt = \"\"\n2762: +    index = 0\n2763: +    while index < len(argv):\n2764: +        arg = argv[index]\n2765: +        if arg == \"--session\" and index + 1 < len(argv):\n2766: +            session_id = argv[index + 1]\n2767: +            index += 2\n2768: +            continue\n2769: +        if arg == \"--json\":\n2770: +            index += 1\n2771: +            continue\n2772: +        prompt = arg\n2773: +        index += 1\n2774: +    return session_id, prompt\n2775: +\n2776: +def run(argv):\n2777: +    session_id, prompt = parse_run(argv)\n2778: +    if \"--session\" in argv:\n2779: +        (work_dir() / \"legacy-wake-resumed.txt\").write_text(prompt, encoding=\"utf-8\")\n2780: +        if os.environ.get(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\") != \"1\":\n2781: +            append_turn(session_id, \"user\", stored_resume_prompt(prompt))\n2782: +        append_turn(session_id, \"assistant\", \"legacy wake acknowledged\")\n2783: +        print(\"legacy wake acknowledged\", flush=True)\n2784: +        return 0\n2785: +    print(json.dumps({\"type\": \"step_start\", \"sessionID\": SESSION}), flush=True)\n2786: +    append_turn(SESSION, \"user\", prompt)\n2787: +    append_turn(SESSION, \"assistant\", \"legacy parent acknowledged\")\n2788: +    print(\"legacy parent acknowledged\", flush=True)\n2789: +    return 0\n2790: +\n2791: +def export_session(argv):\n2792: +    session_id = argv[0] if argv else SESSION\n2793: +    path = session_path(session_id)\n2794: +    if path.exists():\n2795: +        sys.stdout.write(path.read_text(encoding=\"utf-8\"))\n2796: +    return 0\n2797: +\n2798: +def main():\n2799: +    subcommand = sys.argv[1] if len(sys.argv) > 1 else \"\"\n2800: +    if subcommand == \"export\":\n2801: +        return export_session(sys.argv[2:])\n2802: +    if subcommand == \"run\":\n2803: +        return run(sys.argv[2:])\n2804: +    print(f\"unsupported fake opencode subcommand: {subcommand}\", file=sys.stderr)\n2805: +    return 64\n2806: +\n2807: +if __name__ == \"__main__\":\n2808: +    raise SystemExit(main())\n2809: +\"#\n2810: +}\n2811: +\n2812: +fn fake_opencode_turns_script() -> &'static str {\n2813: +    r#\"#!/usr/bin/env python3\n2814: +import os\n2815: +import subprocess\n2816: +import sys\n2817: +\n2818: +session_id = os.environ.get(\"SESSION_ID\")\n2819: +if not session_id:\n2820: +    raise SystemExit(0)\n2821: +\n2822: +result = subprocess.run(\n2823: +    [\"opencode\", \"export\", session_id],\n2824: +    stdout=subprocess.PIPE,\n2825: +    stderr=subprocess.PIPE,\n2826: +    text=True,\n2827: +    check=False,\n2828: +)\n2829: +if result.returncode != 0:\n2830: +    sys.stderr.write(result.stderr)\n2831: +    raise SystemExit(result.returncode)\n2832: +sys.stdout.write(result.stdout)\n2833: +\"#\n2834: +}\n2835: +\n2836: +fn assert_success(output: &Output) {\n2837: +    assert_exit_code(output, 0);\n2838: +}\n2839: +\n2840: +fn assert_exit_code(output: &Output, expected: i32) {\n2841: +    assert_eq!(\n2842: +        output.status.code(),\n2843: +        Some(expected),\n2844: +        \"stdout={}\\nstderr={}\",\n2845: +        String::from_utf8_lossy(&output.stdout),\n2846: +        String::from_utf8_lossy(&output.stderr)\n2847: +    );\n2848: +}\n2849: +\n2850: +fn wait_for_file(path: &Path) -> String {\n2851: +    wait_for_path_exists(path);\n2852: +    fs::read_to_string(path).unwrap()\n2853: +}\n2854: +\n2855: +fn wait_for_path_exists(path: &Path) {\n2856: +    wait_until(&format!(\"{} exists\", path.display()), || path.exists());\n2857: +}\n2858: +\n2859: +fn wait_until(label: &str, mut predicate: impl FnMut() -> bool) {\n2860: +    let start = Instant::now();\n2861: +    while start.elapsed() < Duration::from_secs(10) {\n2862: +        if predicate() {\n2863: +            return;\n2864: +        }\n2865: +        std::thread::sleep(Duration::from_millis(50));\n2866: +    }\n2867: +    panic!(\"timed out waiting for {label}\");\n2868: +}\n2869: +\n2870: +fn delivery_nonce_from_prompt(prompt: &str) -> String {\n2871: +    let prefix = \"[OULIPOLY-DELIVERY \";\n2872: +    let start = prompt\n2873: +        .find(prefix)\n2874: +        .unwrap_or_else(|| panic!(\"prompt missing delivery nonce: {prompt}\"))\n2875: +        + prefix.len();\n2876: +    let rest = &prompt[start..];\n2877: +    let end = rest\n2878: +        .find(']')\n2879: +        .unwrap_or_else(|| panic!(\"prompt has unterminated delivery nonce: {prompt}\"));\n2880: +    rest[..end].to_string()\n2881: +}\n2882: +\n2883: +fn integration_test_lock() -> &'static Mutex<()> {\n2884: +    static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n2885: +    LOCK.get_or_init(|| Mutex::new(()))\n2886: +}\n2887: +\n2888: +fn integration_test_guard() -> MutexGuard<'static, ()> {\n2889: +    integration_test_lock()\n2890: +        .lock()\n2891: +        .unwrap_or_else(|poisoned| poisoned.into_inner())\n2892: +}\n2893: +\n2894: +fn runner_bin() -> &'static str {\n2895: +    env!(\"CARGO_BIN_EXE_oulipoly-agent-runner\")\n2896: +}\n2897: +\n2898: +fn path_string(path: &Path) -> String {\n2899: +    path.to_string_lossy().into_owned()\n2900: +}\n2901: +\n2902: +fn toml_string(value: &str) -> String {\n2903: +    serde_json::to_string(value).unwrap()\n2904: +}\n2905: diff --git a/src-tauri/tests/wu_d_proactive_wake_integration.rs b/src-tauri/tests/wu_d_proactive_wake_integration.rs\n2906: index 04433a5..89546a0 100644\n2907: --- a/src-tauri/tests/wu_d_proactive_wake_integration.rs\n2908: +++ b/src-tauri/tests/wu_d_proactive_wake_integration.rs\n2909: @@ -1,11 +1,47 @@\n2910:  #![cfg(unix)]\n2911:  \n2912: +//! ## Declared roles\n2913: +//!\n2914: +//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n2915: +//! predicate, filter.\n2916: +//!\n2917: +//! TEST: proactive wake and wake-reclaim end-to-end fixtures — fake CLI script\n2918: +//! formatters, model/config mappers, state and mailbox accessors, JSON/record\n2919: +//! parsers, liveness and delivery predicates/filters, wake-claim and durable\n2920: +//! mailbox validators, and test orchestration.\n2921: +//!\n2922: +//! ## Adapter declarations\n2923: +//!\n2924: +//! ```yaml\n2925: +//! adapter_declarations:\n2926: +//!   - component: src-tauri/tests/wu_d_proactive_wake_integration.rs\n2927: +//!     role: adapter\n2928: +//!     Translates:\n2929: +//!       - runtime-cli-dispatch-contract\n\n(Showing lines 2244-2929 of 3430. Use offset=2930 to continue.)\n</content>","metadata":{"preview":"diff --git a/src-tauri/tests/wake_confirm_legacy_opencode.rs b/src-tauri/tests/wake_confirm_legacy_opencode.rs\nnew file mode 100644\nindex 0000000..b37c1f2\n--- /dev/null\n+++ b/src-tauri/tests/wake_confirm_legacy_opencode.rs\n@@ -0,0 +1,655 @@\n+#![cfg(unix)]\n+\n+//! ## Declared roles\n+//!\n+//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n+//! predicate, filter.\n+//!\n+//! TEST: legacy opencode wake-confirmation fixtures — fake CLI script\n+//! formatters, model/config mappers, state and mailbox accessors, transcript\n+//! parsers, consumed-notification predicates and filters, delivery/claim row\n+//! validators, and test orchestration.\n+//!\n+//! ## Adapter declarations\n+//!","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/planning/wakechain-gate/gates/diff.patch","text":"diff --git a/src-tauri/tests/wake_confirm_legacy_opencode.rs b/src-tauri/tests/wake_confirm_legacy_opencode.rs\nnew file mode 100644\nindex 0000000..b37c1f2\n--- /dev/null\n+++ b/src-tauri/tests/wake_confirm_legacy_opencode.rs\n@@ -0,0 +1,655 @@\n+#![cfg(unix)]\n+\n+//! ## Declared roles\n+//!\n+//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n+//! predicate, filter.\n+//!\n+//! TEST: legacy opencode wake-confirmation fixtures — fake CLI script\n+//! formatters, model/config mappers, state and mailbox accessors, transcript\n+//! parsers, consumed-notification predicates and filters, delivery/claim row\n+//! validators, and test orchestration.\n+//!\n+//! ## Adapter declarations\n+//!\n+//! ```yaml\n+//! adapter_declarations:\n+//!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n+//!     role: adapter\n+//!     Translates:\n+//!       - legacy-opencode-cli-contract\n+//!       - wake-confirmation-transcript-contract\n+//!       - mailbox-sidecar-contract\n+//!       - invocation-state-db-contract\n+//!       - test-fixture-process-contract\n+//! intrinsic_surface_declarations:\n+//!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n+//!     role: intrinsic-surface\n+//!     Domain: legacy opencode wake-confirmation regression suite\n+//!     Owns:\n+//!       - isolated config/data fixture materialization\n+//!       - fake opencode script generation and executable setup\n+//!       - transcript export fixture construction\n+//!       - wake/resume command invocation and environment isolation\n+//!       - delivery confirmation and consumed-notification assertions\n+//! ```\n+\n+use oulipoly_state::StateDb;\n+use oulipoly_state::mailbox::{AgentBashCompleteEnqueue, MailboxDb};\n+use rusqlite::{Connection, params};\n+use std::fs;\n+use std::os::unix::fs::PermissionsExt;\n+use std::path::{Path, PathBuf};\n+use std::process::{Command, Output};\n+use std::sync::{Mutex, MutexGuard, OnceLock};\n+use std::time::{Duration, Instant};\n+\n+const MODEL: &str = \"wake-confirm-legacy-opencode\";\n+const PROVIDER: &str = \"opencode\";\n+const SESSION: &str = \"ses_wakeconfirmlegacy\";\n+const HANDLE: &str = \"h-wake-confirm-legacy\";\n+const CHAIN_ID: &str = \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\";\n+\n+struct Fixture {\n+    dir: tempfile::TempDir,\n+    config_home: PathBuf,\n+    data_home: PathBuf,\n+    home_dir: PathBuf,\n+    app_config_dir: PathBuf,\n+    models_dir: PathBuf,\n+    bin_dir: PathBuf,\n+    work_dir: PathBuf,\n+    export_dir: PathBuf,\n+}\n+\n+impl Fixture {\n+    fn new() -> Self {\n+        let dir = tempfile::tempdir().unwrap();\n+        let config_home = dir.path().join(\"xdg-config\");\n+        let data_home = dir.path().join(\"xdg-data\");\n+        let home_dir = dir.path().join(\"home\");\n+        let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n+        let models_dir = app_config_dir.join(\"models\");\n+        let bin_dir = dir.path().join(\"bin\");\n+        let work_dir = dir.path().join(\"work\");\n+        let export_dir = dir.path().join(\"fake-opencode-export\");\n+        fs::create_dir_all(&models_dir).unwrap();\n+        fs::create_dir_all(&bin_dir).unwrap();\n+        fs::create_dir_all(&work_dir).unwrap();\n+        fs::create_dir_all(&export_dir).unwrap();\n+        fs::create_dir_all(&home_dir).unwrap();\n+        Self {\n+            dir,\n+            config_home,\n+            data_home,\n+            home_dir,\n+            app_config_dir,\n+            models_dir,\n+            bin_dir,\n+            work_dir,\n+            export_dir,\n+        }\n+    }\n+\n+    fn app_data_dir(&self) -> PathBuf {\n+        self.data_home.join(\"oulipoly-agent-runner\")\n+    }\n+\n+    fn sidecar_path(&self) -> PathBuf {\n+        self.app_data_dir().join(\"pid-identity.db\")\n+    }\n+\n+    fn state_path(&self) -> PathBuf {\n+        self.app_data_dir().join(\"state.db\")\n+    }\n+\n+    fn run(&self, mut cmd: Command) -> Output {\n+        cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n+            .env(\"XDG_DATA_HOME\", &self.data_home)\n+            .env(\"HOME\", &self.home_dir)\n+            .env(\"PATH\", self.path_env())\n+            .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n+            .env(\"WAKE_CONFIRM_WORK_DIR\", &self.work_dir)\n+            .env(\"WAKE_CONFIRM_EXPORT_DIR\", &self.export_dir)\n+            .env_remove(\"OULIPOLY_DATA_DIR\")\n+            .env_remove(\"OULIPOLY_AUTO_WAKE\")\n+            .env_remove(\"OULIPOLY_AUTO_WAKE_SESSION_ID\")\n+            .env_remove(\"OULIPOLY_AUTO_WAKE_TOKEN\")\n+            .env_remove(\"OULIPOLY_AUTO_WAKE_COUNT\")\n+            .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n+            .current_dir(self.dir.path());\n+        cmd.output().unwrap()\n+    }\n+\n+    fn path_env(&self) -> String {\n+        let current = std::env::var(\"PATH\").unwrap_or_default();\n+        format!(\"{}:{current}\", self.bin_dir.display())\n+    }\n+\n+    fn run_agent(&self, prompt: &str) -> Output {\n+        let mut cmd = Command::new(runner_bin());\n+        cmd.env(\"WAKE_CONFIRM_NO_NOTIFY\", \"1\")\n+            .arg(\"-m\")\n+            .arg(MODEL)\n+            .arg(\"--models-dir\")\n+            .arg(&self.models_dir)\n+            .arg(prompt);\n+        self.run(cmd)\n+    }\n+\n+    fn run_resume_with_env(&self, envs: &[(&str, &str)]) -> Output {\n+        let mut cmd = Command::new(runner_bin());\n+        for (key, value) in envs {\n+            cmd.env(key, value);\n+        }\n+        cmd.arg(\"resume\")\n+            .arg(\"--session-id\")\n+            .arg(SESSION)\n+            .arg(\"-m\")\n+            .arg(MODEL)\n+            .arg(\"--models-dir\")\n+            .arg(&self.models_dir);\n+        self.run(cmd)\n+    }\n+\n+    fn write_legacy_opencode(&self) {\n+        self.write_executable(\"opencode\", fake_opencode_script());\n+        self.write_executable(\"opencode-turns\", fake_opencode_turns_script());\n+        fs::write(\n+            self.models_dir.join(format!(\"{MODEL}.toml\")),\n+            format!(\n+                r#\"prompt_mode = \"arg\"\n+\n+[[providers]]\n+name = \"{PROVIDER}\"\n+args = []\n+\"#,\n+            ),\n+        )\n+        .unwrap();\n+        fs::write(\n+            self.app_config_dir.join(\"providers.toml\"),\n+            format!(\n+                r#\"[{PROVIDER}]\n+command = \"opencode\"\n+args = [\"run\"]\n+prompt_mode = \"arg\"\n+\n+[{PROVIDER}.session_capture]\n+kind = \"stdout_json_event\"\n+json_args = [\"--json\"]\n+event_type = \"step_start\"\n+event_id_path = \"sessionID\"\n+\n+[{PROVIDER}.resume]\n+kind = \"flag\"\n+flag = \"--session\"\n+\"#,\n+            ),\n+        )\n+        .unwrap();\n+        fs::write(\n+            self.app_config_dir.join(\"sessions.toml\"),\n+            format!(\n+                r#\"[{PROVIDER}]\n+turn_script = \"opencode-turns\"\n+state_dir = {}\n+\"#,\n+                toml_string(&path_string(&self.work_dir.join(\"turn-state\")))\n+            ),\n+        )\n+        .unwrap();\n+    }\n+\n+    fn write_executable(&self, name: &str, body: &str) -> PathBuf {\n+        let path = self.bin_dir.join(name);\n+        fs::write(&path, body).unwrap();\n+        let mut perms = fs::metadata(&path).unwrap().permissions();\n+        perms.set_mode(0o755);\n+        fs::set_permissions(&path, perms).unwrap();\n+        path\n+    }\n+\n+    fn mailbox(&self) -> MailboxDb {\n+        MailboxDb::open(&self.sidecar_path()).unwrap()\n+    }\n+\n+    fn state(&self) -> StateDb {\n+        StateDb::open(&self.state_path()).unwrap()\n+    }\n+\n+    fn ensure_active_chain_for_legacy_session(&self) {\n+        if self\n+            .state()\n+            .chain_id_for_segment(PROVIDER, SESSION)\n+            .unwrap()\n+            .is_some()\n+        {\n+            return;\n+        }\n+        let conn = Connection::open(self.state_path()).unwrap();\n+        conn.execute(\n+            \"INSERT INTO session_chains (chain_id, created_at, last_used_at, model_name)\n+             VALUES (?1, '2026-06-07T00:00:00Z', '2026-06-07T00:00:00Z', ?2)\",\n+            params![CHAIN_ID, MODEL],\n+        )\n+        .unwrap();\n+        conn.execute(\n+            \"INSERT INTO session_chain_segments\n+                (chain_id, provider_name, session_id, started_at, transition_reason)\n+             VALUES (?1, ?2, ?3, '2026-06-07T00:00:00Z', 'initial')\",\n+            params![CHAIN_ID, PROVIDER, SESSION],\n+        )\n+        .unwrap();\n+    }\n+\n+    fn seed_mailbox_notification(&self) {\n+        let state_dir = self.work_dir.join(HANDLE);\n+        fs::create_dir_all(&state_dir).unwrap();\n+        let meta = state_dir.join(\"meta.json\");\n+        let log = state_dir.join(\"log\");\n+        let rc = state_dir.join(\"rc\");\n+        fs::write(&meta, r#\"{\"caller_chain\":[]}\"#).unwrap();\n+        fs::write(&log, \"legacy opencode workload completed\\n\").unwrap();\n+        fs::write(&rc, \"0\\n\").unwrap();\n+        let payload_json = serde_json::json!({\n+            \"schema_version\": 1,\n+            \"kind\": \"agent_bash_complete\",\n+            \"handle\": HANDLE,\n+            \"state_dir\": path_string(&state_dir),\n+            \"meta_path\": path_string(&meta),\n+            \"log_path\": path_string(&log),\n+            \"rc_path\": path_string(&rc),\n+            \"rc\": 0,\n+        })\n+        .to_string();\n+        let mut mailbox = self.mailbox();\n+        mailbox\n+            .enqueue_agent_bash_complete(&AgentBashCompleteEnqueue {\n+                session_id: SESSION,\n+                handle: HANDLE,\n+                payload_json: &payload_json,\n+                owner_invocation_uuid: None,\n+                matched_os_pid: None,\n+                matched_os_boot_id: None,\n+                matched_os_pid_starttime_ticks: None,\n+                matched_chain_index: None,\n+                state_dir: &path_string(&state_dir),\n+                meta_path: &path_string(&meta),\n+                log_path: &path_string(&log),\n+                rc_path: &path_string(&rc),\n+                rc: 0,\n+            })\n+            .unwrap();\n+    }\n+\n+    fn notification_prompt_path(&self) -> PathBuf {\n+        self.work_dir.join(\"legacy-wake-resumed.txt\")\n+    }\n+\n+    fn export_path(&self) -> PathBuf {\n+        self.export_dir.join(format!(\"{SESSION}.jsonl\"))\n+    }\n+\n+    fn export_text(&self) -> String {\n+        fs::read_to_string(self.export_path()).unwrap_or_default()\n+    }\n+\n+    fn unconfirmed_invocation_count(&self) -> i64 {\n+        Connection::open(self.state_path())\n+            .unwrap()\n+            .query_row(\n+                \"SELECT COUNT(*) FROM invocations WHERE error_category = 'mailbox_delivery_unconfirmed'\",\n+                [],\n+                |row| row.get(0),\n+            )\n+            .unwrap()\n+    }\n+\n+    fn assert_xdg_isolated(&self) {\n+        assert!(\n+            !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n+            \"config must stay in isolated XDG_CONFIG_HOME\"\n+        );\n+        assert!(\n+            !self\n+                .home_dir\n+                .join(\".local/share/oulipoly-agent-runner\")\n+                .exists(),\n+            \"state must stay in isolated XDG_DATA_HOME\"\n+        );\n+    }\n+}\n+\n+#[test]\n+fn legacy_opencode_resume_confirms_delivery_after_targeted_turn_ingest() {\n+    let _guard = integration_test_guard();\n+    let fixture = prepared_fixture();\n+    fixture.seed_mailbox_notification();\n+\n+    let output = fixture.run_resume_with_env(&[]);\n+    let prompt = wait_for_file(&fixture.notification_prompt_path());\n+    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n+    assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n+    assert!(prompt.contains(\"handle: h-wake-confirm-legacy\"), \"{prompt}\");\n+    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n+    wait_until(\"fake opencode export contains delivery nonce\", || {\n+        let exported = fixture.export_text();\n+        exported.contains(\"[OULIPOLY NOTIFICATIONS]\") && exported.contains(\"[OULIPOLY-DELIVERY \")\n+    });\n+\n+    assert_success(&output);\n+    wait_until(\"legacy opencode delivery marked delivered\", || {\n+        let db = fixture.mailbox();\n+        let rows = db.list_mailbox(SESSION, true).unwrap();\n+        rows.len() == 1\n+            && rows[0].delivered_at.is_some()\n+            && rows[0].delivery_error.is_none()\n+            && rows[0].delivery_attempts == 1\n+            && rows[0].delivered_by_invocation_uuid.is_some()\n+    });\n+    assert!(\n+        !fixture\n+            .state()\n+            .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n+            .unwrap(),\n+        \"fixture should quote-wrap the delivered user body so exact-text confirmation stays red\"\n+    );\n+    assert!(\n+        fixture\n+            .state()\n+            .has_session_user_turn_containing(\n+                PROVIDER,\n+                SESSION,\n+                &delivery_nonce_from_prompt(&prompt)\n+            )\n+            .unwrap(),\n+        \"session_turns should contain the delivery nonce in the quote-wrapped user body\"\n+    );\n+    assert_eq!(fixture.unconfirmed_invocation_count(), 0);\n+    assert!(fixture.mailbox().list_pending(SESSION).unwrap().is_empty());\n+    fixture.assert_xdg_isolated();\n+}\n+\n+#[test]\n+fn legacy_opencode_resume_leaves_mailbox_pending_when_ingested_turn_omits_delivery_nonce() {\n+    let _guard = integration_test_guard();\n+    let fixture = prepared_fixture();\n+    fixture.seed_mailbox_notification();\n+\n+    let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\", \"1\")]);\n+    assert_exit_code(&output, 1);\n+    let prompt = wait_for_file(&fixture.notification_prompt_path());\n+    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n+    wait_until(\n+        \"fake opencode export contains user turn without delivery nonce\",\n+        || {\n+            let exported = fixture.export_text();\n+            exported.contains(\"[OULIPOLY NOTIFICATIONS]\")\n+                && !exported.contains(\"[OULIPOLY-DELIVERY \")\n+        },\n+    );\n+    wait_until(\n+        \"nonce-less export leaves mailbox pending unconfirmed\",\n+        || {\n+            let db = fixture.mailbox();\n+            let rows = db.list_mailbox(SESSION, true).unwrap();\n+            rows.len() == 1\n+                && rows[0].delivered_at.is_none()\n+                && rows[0].delivery_attempts == 1\n+                && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n+                && rows[0].delivered_by_invocation_uuid.is_none()\n+        },\n+    );\n+    assert!(\n+        !fixture\n+            .state()\n+            .has_session_user_turn_containing(\n+                PROVIDER,\n+                SESSION,\n+                &delivery_nonce_from_prompt(&prompt)\n+            )\n+            .unwrap(),\n+        \"stored resume turn without the delivery nonce must not confirm delivery\"\n+    );\n+    assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n+    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n+    fixture.assert_xdg_isolated();\n+}\n+\n+#[test]\n+fn legacy_opencode_resume_leaves_mailbox_pending_when_export_omits_notification_turn() {\n+    let _guard = integration_test_guard();\n+    let fixture = prepared_fixture();\n+    fixture.seed_mailbox_notification();\n+\n+    let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\", \"1\")]);\n+    assert_exit_code(&output, 1);\n+    let prompt = wait_for_file(&fixture.notification_prompt_path());\n+    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n+    wait_until(\"omitted export leaves mailbox pending unconfirmed\", || {\n+        let db = fixture.mailbox();\n+        let rows = db.list_mailbox(SESSION, true).unwrap();\n+        rows.len() == 1\n+            && rows[0].delivered_at.is_none()\n+            && rows[0].delivery_attempts == 1\n+            && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n+            && rows[0].delivered_by_invocation_uuid.is_none()\n+    });\n+    assert!(\n+        !fixture\n+            .state()\n+            .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n+            .unwrap(),\n+        \"omitted export must not create exact user-turn confirmation evidence\"\n+    );\n+    assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n+    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n+    fixture.assert_xdg_isolated();\n+}\n+\n+fn prepared_fixture() -> Fixture {\n+    let fixture = Fixture::new();\n+    fixture.write_legacy_opencode();\n+    let output = fixture.run_agent(\"launch legacy opencode parent\");\n+    assert_success(&output);\n+    fixture.ensure_active_chain_for_legacy_session();\n+    wait_until(\"legacy opencode parent runtime idle\", || {\n+        fixture\n+            .mailbox()\n+            .session_runtime(SESSION)\n+            .unwrap()\n+            .is_some_and(|runtime| runtime.run_state == \"idle\")\n+    });\n+    fixture\n+}\n+\n+fn fake_opencode_script() -> &'static str {\n+    r#\"#!/usr/bin/env python3\n+import json\n+import os\n+import pathlib\n+import re\n+import sys\n+\n+SESSION = \"ses_wakeconfirmlegacy\"\n+\n+def work_dir():\n+    return pathlib.Path(os.environ[\"WAKE_CONFIRM_WORK_DIR\"])\n+\n+def export_dir():\n+    return pathlib.Path(os.environ[\"WAKE_CONFIRM_EXPORT_DIR\"])\n+\n+def session_path(session_id):\n+    return export_dir() / f\"{session_id}.jsonl\"\n+\n+def next_turn_id(session_id, role):\n+    path = session_path(session_id)\n+    if not path.exists():\n+        return f\"{role}-1\"\n+    count = sum(1 for line in path.read_text(encoding=\"utf-8\").splitlines() if line.strip())\n+    return f\"{role}-{count + 1}\"\n+\n+def append_turn(session_id, role, text):\n+    export_dir().mkdir(parents=True, exist_ok=True)\n+    turn = {\n+        \"session_id\": session_id,\n+        \"turn_id\": next_turn_id(session_id, role),\n+        \"timestamp\": \"2026-06-07T00:00:00Z\",\n+        \"role\": role,\n+        \"body\": [{\"type\": \"text\", \"text\": text}],\n+    }\n+    with session_path(session_id).open(\"a\", encoding=\"utf-8\") as handle:\n+        handle.write(json.dumps(turn, separators=(\",\", \":\")) + \"\\n\")\n+\n+def stored_resume_prompt(prompt):\n+    if os.environ.get(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\") == \"1\":\n+        prompt = re.sub(r\"^\\[OULIPOLY-DELIVERY [^\\n]*\\]\\n?\", \"\", prompt, flags=re.MULTILINE)\n+    return f'\"{prompt}\"'\n+\n+def parse_run(argv):\n+    session_id = SESSION\n+    prompt = \"\"\n+    index = 0\n+    while index < len(argv):\n+        arg = argv[index]\n+        if arg == \"--session\" and index + 1 < len(argv):\n+            session_id = argv[index + 1]\n+            index += 2\n+            continue\n+        if arg == \"--json\":\n+            index += 1\n+            continue\n+        prompt = arg\n+        index += 1\n+    return session_id, prompt\n+\n+def run(argv):\n+    session_id, prompt = parse_run(argv)\n+    if \"--session\" in argv:\n+        (work_dir() / \"legacy-wake-resumed.txt\").write_text(prompt, encoding=\"utf-8\")\n+        if os.environ.get(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\") != \"1\":\n+            append_turn(session_id, \"user\", stored_resume_prompt(prompt))\n+        append_turn(session_id, \"assistant\", \"legacy wake acknowledged\")\n+        print(\"legacy wake acknowledged\", flush=True)\n+        return 0\n+    print(json.dumps({\"type\": \"step_start\", \"sessionID\": SESSION}), flush=True)\n+    append_turn(SESSION, \"user\", prompt)\n+    append_turn(SESSION, \"assistant\", \"legacy parent acknowledged\")\n+    print(\"legacy parent acknowledged\", flush=True)\n+    return 0\n+\n+def export_session(argv):\n+    session_id = argv[0] if argv else SESSION\n+    path = session_path(session_id)\n+    if path.exists():\n+        sys.stdout.write(path.read_text(encoding=\"utf-8\"))\n+    return 0\n+\n+def main():\n+    subcommand = sys.argv[1] if len(sys.argv) > 1 else \"\"\n+    if subcommand == \"export\":\n+        return export_session(sys.argv[2:])\n+    if subcommand == \"run\":\n+        return run(sys.argv[2:])\n+    print(f\"unsupported fake opencode subcommand: {subcommand}\", file=sys.stderr)\n+    return 64\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n+\"#\n+}\n+\n+fn fake_opencode_turns_script() -> &'static str {\n+    r#\"#!/usr/bin/env python3\n+import os\n+import subprocess\n+import sys\n+\n+session_id = os.environ.get(\"SESSION_ID\")\n+if not session_id:\n+    raise SystemExit(0)\n+\n+result = subprocess.run(\n+    [\"opencode\", \"export\", session_id],\n+    stdout=subprocess.PIPE,\n+    stderr=subprocess.PIPE,\n+    text=True,\n+    check=False,\n+)\n+if result.returncode != 0:\n+    sys.stderr.write(result.stderr)\n+    raise SystemExit(result.returncode)\n+sys.stdout.write(result.stdout)\n+\"#\n+}\n+\n+fn assert_success(output: &Output) {\n+    assert_exit_code(output, 0);\n+}\n+\n+fn assert_exit_code(output: &Output, expected: i32) {\n+    assert_eq!(\n+        output.status.code(),\n+        Some(expected),\n+        \"stdout={}\\nstderr={}\",\n+        String::from_utf8_lossy(&output.stdout),\n+        String::from_utf8_lossy(&output.stderr)\n+    );\n+}\n+\n+fn wait_for_file(path: &Path) -> String {\n+    wait_for_path_exists(path);\n+    fs::read_to_string(path).unwrap()\n+}\n+\n+fn wait_for_path_exists(path: &Path) {\n+    wait_until(&format!(\"{} exists\", path.display()), || path.exists());\n+}\n+\n+fn wait_until(label: &str, mut predicate: impl FnMut() -> bool) {\n+    let start = Instant::now();\n+    while start.elapsed() < Duration::from_secs(10) {\n+        if predicate() {\n+            return;\n+        }\n+        std::thread::sleep(Duration::from_millis(50));\n+    }\n+    panic!(\"timed out waiting for {label}\");\n+}\n+\n+fn delivery_nonce_from_prompt(prompt: &str) -> String {\n+    let prefix = \"[OULIPOLY-DELIVERY \";\n+    let start = prompt\n+        .find(prefix)\n+        .unwrap_or_else(|| panic!(\"prompt missing delivery nonce: {prompt}\"))\n+        + prefix.len();\n+    let rest = &prompt[start..];\n+    let end = rest\n+        .find(']')\n+        .unwrap_or_else(|| panic!(\"prompt has unterminated delivery nonce: {prompt}\"));\n+    rest[..end].to_string()\n+}\n+\n+fn integration_test_lock() -> &'static Mutex<()> {\n+    static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n+    LOCK.get_or_init(|| Mutex::new(()))\n+}\n+\n+fn integration_test_guard() -> MutexGuard<'static, ()> {\n+    integration_test_lock()\n+        .lock()\n+        .unwrap_or_else(|poisoned| poisoned.into_inner())\n+}\n+\n+fn runner_bin() -> &'static str {\n+    env!(\"CARGO_BIN_EXE_oulipoly-agent-runner\")\n+}\n+\n+fn path_string(path: &Path) -> String {\n+    path.to_string_lossy().into_owned()\n+}\n+\n+fn toml_string(value: &str) -> String {\n+    serde_json::to_string(value).unwrap()\n+}\ndiff --git a/src-tauri/tests/wu_d_proactive_wake_integration.rs b/src-tauri/tests/wu_d_proactive_wake_integration.rs\nindex 04433a5..89546a0 100644\n--- a/src-tauri/tests/wu_d_proactive_wake_integration.rs\n+++ b/src-tauri/tests/wu_d_proactive_wake_integration.rs\n@@ -1,11 +1,47 @@\n #![cfg(unix)]\n \n+//! ## Declared roles\n+//!\n+//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n+//! predicate, filter.\n+//!\n+//! TEST: proactive wake and wake-reclaim end-to-end fixtures — fake CLI script\n+//! formatters, model/config mappers, state and mailbox accessors, JSON/record\n+//! parsers, liveness and delivery predicates/filters, wake-claim and durable\n+//! mailbox validators, and test orchestration.\n+//!\n+//! ## Adapter declarations\n+//!\n+//! ```yaml\n+/