 Output {\n2976: +        let mut cmd = Command::new(runner_bin());\n2977: +        cmd.arg(\"mailbox\")\n2978: +            .arg(\"list\")\n2979: +            .arg(\"--session-id\")\n2980: +            .arg(session_id)\n2981: +            .arg(\"--json\");\n2982: +        self.run(cmd)\n2983: +    }\n2984: +\n2985:      fn write_provider(&self, body: &str) {\n2986:          let script = self.write_script(\"provider.sh\", body);\n2987:          fs::write(\n2988: @@ -239,13 +289,21 @@ flag = \"--session\"\n2989:          Connection::open(self.sidecar_path()).unwrap()\n2990:      }\n2991:  \n2992: +    fn state(&self) -> StateDb {\n2993: +        StateDb::open(&self.state_path()).unwrap()\n2994: +    }\n2995: +\n2996:      fn seed_session_turn(&self) {\n2997: -        let db = StateDb::open(&self.state_path()).unwrap();\n2998: +        self.seed_session_turn_for(PROVIDER, SESSION, \"turn-a\");\n2999: +    }\n3000: +\n3001: +    fn seed_session_turn_for(&self, provider_name: &str, session_id: &str, turn_id: &str) {\n3002: +        let db = self.state();\n3003:          db.ingest_session_turns_batch(\n3004: -            PROVIDER,\n3005: +            provider_name,\n3006:              &[SessionTurnIngest {\n3007: -                session_id: SESSION.to_string(),\n3008: -                turn_id: \"turn-a\".to_string(),\n3009: +                session_id: session_id.to_string(),\n3010: +                turn_id: turn_id.to_string(),\n3011:                  timestamp: ts(\"2026-06-04T12:00:00Z\"),\n3012:                  role: \"assistant\".to_string(),\n3013:                  parent_turn_id: None,\n3014: @@ -257,6 +315,24 @@ flag = \"--session\"\n3015:          .unwrap();\n3016:      }\n3017:  \n3018: +    fn seed_consumed_notification_turn(&self, handle: &str) {\n3019: +        self.state()\n3020: +            .ingest_session_turns_batch(\n3021: +                PROVIDER,\n3022: +                &[SessionTurnIngest {\n3023: +                    session_id: SESSION.to_string(),\n3024: +                    turn_id: format!(\"turn-consumed-{handle}\"),\n3025: +                    timestamp: ts(\"2026-06-04T12:01:00Z\"),\n3026: +                    role: \"user\".to_string(),\n3027: +                    parent_turn_id: None,\n3028: +                    is_sidechain: false,\n3029: +                    is_compaction_boundary: false,\n3030: +                    body: Some(format!(\"[OULIPOLY NOTIFICATIONS]\\nhandle: {handle}\\n\")),\n3031: +                }],\n3032: +            )\n3033: +            .unwrap();\n3034: +    }\n3035: +\n3036:      fn seed_idle_runtime(&self) {\n3037:          self.seed_idle_runtime_for(SESSION, PROVIDER, MODEL);\n3038:      }\n3039: @@ -302,6 +378,15 @@ flag = \"--session\"\n3040:      }\n3041:  \n3042:      fn seed_mailbox(&self, session_id: &str, handle: &str) {\n3043: +        self.seed_mailbox_for(session_id, handle, Some(INVOCATION));\n3044: +    }\n3045: +\n3046: +    fn seed_mailbox_for(\n3047: +        &self,\n3048: +        session_id: &str,\n3049: +        handle: &str,\n3050: +        owner_invocation_uuid: Option<&str>,\n3051: +    ) {\n3052:          let state_dir = self.work_dir.join(format!(\"seed-{handle}\"));\n3053:          fs::create_dir_all(&state_dir).unwrap();\n3054:          let meta = state_dir.join(\"meta.json\");\n3055: @@ -315,7 +400,7 @@ flag = \"--session\"\n3056:              session_id,\n3057:              handle,\n3058:              payload_json: r#\"{\"schema_version\":1,\"kind\":\"agent_bash_complete\"}\"#,\n3059: -            owner_invocation_uuid: Some(INVOCATION),\n3060: +            owner_invocation_uuid,\n3061:              matched_os_pid: Some(9_300),\n3062:              matched_os_boot_id: Some(\"boot-seeded\"),\n3063:              matched_os_pid_starttime_ticks: Some(456),\n3064: @@ -329,6 +414,30 @@ flag = \"--session\"\n3065:          .unwrap();\n3066:      }\n3067:  \n3068: +    fn age_mailbox_for(&self, session_id: &str, seconds_old: i64) {\n3069: +        let enqueued_at = (Utc::now() - chrono::Duration::seconds(seconds_old)).to_rfc3339();\n3070: +        self.sidecar_conn()\n3071: +            .execute(\n3072: +                \"UPDATE mailbox SET enqueued_at = ?2 WHERE session_id = ?1\",\n3073: +                rusqlite::params![session_id, enqueued_at],\n3074: +            )\n3075: +            .unwrap();\n3076: +    }\n3077: +\n3078: +    fn mark_mailbox_unconfirmed_twice(&self, session_id: &str, handle: &str) {\n3079: +        let mut db = self.mailbox();\n3080: +        let row = db\n3081: +            .list_mailbox(session_id, true)\n3082: +            .unwrap()\n3083: +            .into_iter()\n3084: +            .find(|row| row.handle == handle)\n3085: +            .unwrap_or_else(|| panic!(\"missing seeded mailbox row {handle}\"));\n3086: +        db.mark_delivery_failed(session_id, &[row.seq], \"mailbox_delivery_unconfirmed\")\n3087: +            .unwrap();\n3088: +        db.mark_delivery_failed(session_id, &[row.seq], \"mailbox_delivery_unconfirmed\")\n3089: +            .unwrap();\n3090: +    }\n3091: +\n3092:      fn record_identity(&self, identity: &ProcessIdentity) {\n3093:          self.record_identity_for(identity, SESSION, PROVIDER, MODEL);\n3094:      }\n3095: @@ -753,6 +862,241 @@ fn batch_cap_followup_wake() {\n3096:      fixture.assert_xdg_isolated();\n3097:  }\n3098:  \n3099: +#[test]\n3100: +fn wake_sweep_reclaims_dead_claim_and_delivers_pending_mailbox() {\n3101: +    let _guard = integration_test_guard();\n3102: +    let fixture = Fixture::new();\n3103: +    fixture.write_provider(&provider_script(\"\", \"\", \"sweep-reclaimed.txt\"));\n3104: +    fixture.seed_session_turn();\n3105: +    fixture.seed_idle_runtime();\n3106: +    fixture.seed_mailbox(SESSION, \"h-sweep-reclaim\");\n3107: +    seed_dead_wake_claim(&fixture, \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\", 601);\n3108: +\n3109: +    let output = fixture.run_mailbox_list(SESSION);\n3110: +    assert_success(&output);\n3111: +\n3112: +    let prompt = wait_for_file(&fixture.prompt_file(\"sweep-reclaimed.txt\"));\n3113: +    assert!(prompt.contains(\"handle: h-sweep-reclaim\"), \"{prompt}\");\n3114: +    wait_until(\"sweep reclaimed dead claim and delivered mailbox\", || {\n3115: +        let db = fixture.mailbox();\n3116: +        let rows = db.list_mailbox(SESSION, true).unwrap();\n3117: +        rows.len() == 1\n3118: +            && rows[0].delivered_at.is_some()\n3119: +            && rows[0].delivery_error.is_none()\n3120: +            && db.wake_claim(SESSION).unwrap().is_none()\n3121: +    });\n3122: +    fixture.assert_xdg_isolated();\n3123: +}\n3124: +\n3125: +#[test]\n3126: +fn wake_sweep_does_not_disturb_live_identity_matched_claim() {\n3127: +    let _guard = integration_test_guard();\n3128: +    let fixture = Fixture::new();\n3129: +    fixture.write_provider(&provider_script(\"\", \"\", \"live-claim-not-disturbed.txt\"));\n3130: +    fixture.seed_session_turn();\n3131: +    fixture.seed_idle_runtime();\n3132: +    fixture.seed_mailbox(SESSION, \"h-live-claim\");\n3133: +    seed_live_wake_claim(&fixture, \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\");\n3134: +\n3135: +    let output = fixture.run_mailbox_list(SESSION);\n3136: +    assert_success(&output);\n3137: +    std::thread::sleep(Duration::from_millis(300));\n3138: +\n3139: +    assert!(!fixture.prompt_file(\"live-claim-not-disturbed.txt\").exists());\n3140: +    let claim = fixture.mailbox().wake_claim(SESSION).unwrap().unwrap();\n3141: +    assert_eq!(claim.claim_token, \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\");\n3142: +    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n3143: +    fixture.assert_xdg_isolated();\n3144: +}\n3145: +\n3146: +#[test]\n3147: +fn wake_sweep_does_not_rewake_consumed_pending_mailbox() {\n3148: +    let _guard = integration_test_guard();\n3149: +    let fixture = Fixture::new();\n3150: +    fixture.write_provider(&provider_script(\"\", \"\", \"consumed-not-rewoken.txt\"));\n3151: +    fixture.seed_session_turn();\n3152: +    fixture.seed_idle_runtime();\n3153: +    fixture.seed_mailbox(SESSION, \"h-consumed\");\n3154: +    fixture.seed_consumed_notification_turn(\"h-consumed\");\n3155: +    seed_dead_wake_claim(&fixture, \"cccccccc-cccc-4ccc-8ccc-cccccccccccc\", 601);\n3156: +\n3157: +    let output = fixture.run_mailbox_list(SESSION);\n3158: +    assert_success(&output);\n3159: +    std::thread::sleep(Duration::from_millis(300));\n3160: +\n3161: +    assert!(!fixture.prompt_file(\"consumed-not-rewoken.txt\").exists());\n3162: +    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n3163: +    fixture.assert_xdg_isolated();\n3164: +}\n3165: +\n3166: +#[test]\n3167: +fn wake_sweep_does_not_rewake_twice_unconfirmed_pending_mailbox() {\n3168: +    let _guard = integration_test_guard();\n3169: +    let fixture = Fixture::new();\n3170: +    fixture.write_provider(&provider_script(\n3171: +        \"\",\n3172: +        \"\",\n3173: +        \"twice-unconfirmed-not-rewoken.txt\",\n3174: +    ));\n3175: +    fixture.seed_session_turn();\n3176: +    fixture.seed_idle_runtime();\n3177: +    fixture.seed_mailbox(SESSION, \"h-unconfirmed\");\n3178: +    fixture.mark_mailbox_unconfirmed_twice(SESSION, \"h-unconfirmed\");\n3179: +    seed_dead_wake_claim(&fixture, \"dddddddd-dddd-4ddd-8ddd-dddddddddddd\", 601);\n3180: +\n3181: +    let output = fixture.run_mailbox_list(SESSION);\n3182: +    assert_success(&output);\n3183: +    std::thread::sleep(Duration::from_millis(300));\n3184: +\n3185: +    assert!(\n3186: +        !fixture\n3187: +            .prompt_file(\"twice-unconfirmed-not-rewoken.txt\")\n3188: +            .exists()\n3189: +    );\n3190: +    let rows = fixture.mailbox().list_pending(SESSION).unwrap();\n3191: +    assert_eq!(rows.len(), 1);\n3192: +    assert_eq!(rows[0].handle, \"h-unconfirmed\");\n3193: +    assert_eq!(rows[0].delivery_attempts, 2);\n3194: +    fixture.assert_xdg_isolated();\n3195: +}\n3196: +\n3197: +#[test]\n3198: +fn wake_sweep_skips_twice_unconfirmed_rows_and_delivers_newer_pending_mailbox() {\n3199: +    let _guard = integration_test_guard();\n3200: +    let fixture = Fixture::new();\n3201: +    fixture.write_provider(&provider_script(\"\", \"\", \"newer-after-unconfirmed.txt\"));\n3202: +    fixture.seed_session_turn();\n3203: +    fixture.seed_idle_runtime();\n3204: +    fixture.seed_mailbox(SESSION, \"h-unconfirmed-old\");\n3205: +    fixture.seed_mailbox(SESSION, \"h-newer\");\n3206: +    fixture.mark_mailbox_unconfirmed_twice(SESSION, \"h-unconfirmed-old\");\n3207: +    seed_dead_wake_claim(&fixture, \"eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee\", 601);\n3208: +\n3209: +    let output = fixture.run_mailbox_list(SESSION);\n3210: +    assert_success(&output);\n3211: +\n3212: +    let prompt = wait_for_file(&fixture.prompt_file(\"newer-after-unconfirmed.txt\"));\n3213: +    assert!(!prompt.contains(\"handle: h-unconfirmed-old\"), \"{prompt}\");\n3214: +    assert!(prompt.contains(\"handle: h-newer\"), \"{prompt}\");\n3215: +    wait_until(\n3216: +        \"newer mailbox delivered while exhausted row remains pending\",\n3217: +        || {\n3218: +            let rows = fixture.mailbox().list_mailbox(SESSION, true).unwrap();\n3219: +            let old = rows.iter().find(|row| row.handle == \"h-unconfirmed-old\");\n3220: +            let newer = rows.iter().find(|row| row.handle == \"h-newer\");\n3221: +            old.is_some_and(|row| row.delivered_at.is_none() && row.delivery_attempts == 2)\n3222: +                && newer.is_some_and(|row| row.delivered_at.is_some())\n3223: +        },\n3224: +    );\n3225: +    fixture.assert_xdg_isolated();\n3226: +}\n3227: +\n3228: +#[test]\n3229: +fn wake_sweep_backlog_recovers_recent_leak_and_reaps_dead_owner_debris() {\n3230: +    let _guard = integration_test_guard();\n3231: +    let fixture = Fixture::new();\n3232: +    fixture.write_provider(&provider_script(\n3233: +        \"\",\n3234: +        r#\"printf '%s' \"$last\" > \"$work/backlog-$resume.txt\"\"#,\n3235: +        \"backlog-any.txt\",\n3236: +    ));\n3237: +\n3238: +    let dead_sessions = (0..16)\n3239: +        .map(|index| format!(\"00000000-0000-4000-8000-{index:012x}\"))\n3240: +        .collect::<Vec<_>>();\n3241: +    for (index, session_id) in dead_sessions.iter().enumerate() {\n3242: +        let handle = format!(\"h-dead-owner-{index}\");\n3243: +        fixture.seed_mailbox_for(session_id, &handle, None);\n3244: +        fixture.age_mailbox_for(session_id, 86_400);\n3245: +        seed_dead_wake_claim_for(\n3246: +            &fixture,\n3247: +            session_id,\n3248: +            &format!(\"dead0000-0000-4000-8000-{index:012x}\"),\n3249: +            601,\n3250: +        );\n3251: +    }\n3252: +\n3253: +    let idle_session = \"11111111-1111-4111-8111-000000000001\";\n3254: +    fixture.seed_active_chain_for(\n3255: +        \"22222222-2222-4222-8222-000000000001\",\n3256: +        PROVIDER,\n3257: +        idle_session,\n3258: +        MODEL,\n3259: +    );\n3260: +    fixture.seed_session_turn_for(PROVIDER, idle_session, \"turn-idle-backlog\");\n3261: +    fixture.seed_idle_runtime_for(idle_session, PROVIDER, MODEL);\n3262: +    fixture.seed_mailbox(idle_session, \"h-idle-resumable-backlog\");\n3263: +    fixture.age_mailbox_for(idle_session, 3_600);\n3264: +    seed_dead_wake_claim_for(\n3265: +        &fixture,\n3266: +        idle_session,\n3267: +        \"eeee0000-0000-4000-8000-000000000001\",\n3268: +        601,\n3269: +    );\n3270: +\n3271: +    let recent_session = \"11111111-1111-4111-8111-000000000002\";\n3272: +    fixture.seed_active_chain_for(\n3273: +        \"22222222-2222-4222-8222-000000000002\",\n3274: +        PROVIDER,\n3275: +        recent_session,\n3276: +        MODEL,\n3277: +    );\n3278: +    fixture.seed_session_turn_for(PROVIDER, recent_session, \"turn-recent-backlog\");\n3279: +    fixture.seed_idle_runtime_for(recent_session, PROVIDER, MODEL);\n3280: +    fixture.seed_mailbox(recent_session, \"h-recent-leak-backlog\");\n3281: +    seed_dead_wake_claim_for(\n3282: +        &fixture,\n3283: +        recent_session,\n3284: +        \"eeee0000-0000-4000-8000-000000000002\",\n3285: +        601,\n3286: +    );\n3287: +\n3288: +    let output = fixture.run_mailbox_list(recent_session);\n3289: +    assert_success(&output);\n3290: +\n3291: +    let idle_prompt = wait_for_file(&fixture.prompt_file(&format!(\"backlog-{idle_session}.txt\")));\n3292: +    assert!(\n3293: +        idle_prompt.contains(\"handle: h-idle-resumable-backlog\"),\n3294: +        \"{idle_prompt}\"\n3295: +    );\n3296: +    let recent_prompt =\n3297: +        wait_for_file(&fixture.prompt_file(&format!(\"backlog-{recent_session}.txt\")));\n3298: +    assert!(\n3299: +        recent_prompt.contains(\"handle: h-recent-leak-backlog\"),\n3300: +        \"{recent_prompt}\"\n3301: +    );\n3302: +\n3303: +    wait_until(\n3304: +        \"backlog recoverable sessions delivered and debris reaped\",\n3305: +        || {\n3306: +            let db = fixture.mailbox();\n3307: +            let idle_rows = db.list_mailbox(idle_session, true).unwrap();\n3308: +            let recent_rows = db.list_mailbox(recent_session, true).unwrap();\n3309: +            let recovered = idle_rows.len() == 1\n3310: +                && idle_rows[0].delivered_at.is_some()\n3311: +                && recent_rows.len() == 1\n3312: +                && recent_rows[0].delivered_at.is_some();\n3313: +            let debris_reaped = dead_sessions.iter().all(|session_id| {\n3314: +                let rows = db.list_mailbox(session_id, true).unwrap();\n3315: +                rows.len() == 1\n3316: +                    && rows[0].delivered_at.is_none()\n3317: +                    && rows[0].delivery_error.as_deref() == Some(WAKE_SWEEP_ABANDONED_ERROR)\n3318: +                    && db.wake_claim(session_id).unwrap().is_none()\n3319: +            });\n3320: +            recovered && debris_reaped\n3321: +        },\n3322: +    );\n3323: +    for session_id in dead_sessions {\n3324: +        assert!(\n3325: +            !fixture\n3326: +                .prompt_file(&format!(\"backlog-{session_id}.txt\"))\n3327: +                .exists(),\n3328: +            \"dead-owner debris must not be re-woken: {session_id}\"\n3329: +        );\n3330: +    }\n3331: +    fixture.assert_xdg_isolated();\n3332: +}\n3333: +\n3334:  fn notify_command(fixture: &Fixture, handle: &str, identity: &ProcessIdentity) -> Command {\n3335:      let state_dir = fixture.work_dir.join(format!(\"concurrent-{handle}\"));\n3336:      fs::create_dir_all(&state_dir).unwrap();\n3337: @@ -795,6 +1139,82 @@ fn notify_command(fixture: &Fixture, handle: &str, identity: &ProcessIdentity) -\n3338:      cmd\n3339:  }\n3340:  \n3341: +fn seed_dead_wake_claim(fixture: &Fixture, claim_token: &str, seconds_old: i64) {\n3342: +    seed_dead_wake_claim_for(fixture, SESSION, claim_token, seconds_old);\n3343: +}\n3344: +\n3345: +fn seed_dead_wake_claim_for(\n3346: +    fixture: &Fixture,\n3347: +    session_id: &str,\n3348: +    claim_token: &str,\n3349: +    seconds_old: i64,\n3350: +) {\n3351: +    acquire_seed_wake_claim_for(fixture, session_id, claim_token);\n3352: +    fixture\n3353: +        .mailbox()\n3354: +        .record_wake_claim_pid(session_id, claim_token, 999_999_999)\n3355: +        .unwrap();\n3356: +    age_wake_claim_for(fixture, session_id, seconds_old);\n3357: +}\n3358: +\n3359: +fn seed_live_wake_claim(fixture: &Fixture, claim_token: &str) {\n3360: +    acquire_seed_wake_claim(fixture, claim_token);\n3361: +    let identity = current_process_identity();\n3362: +    PidIdentityDb::open(&fixture.sidecar_path())\n3363: +        .unwrap()\n3364: +        .record_identity(PidIdentityRecord {\n3365: +            identity: &identity,\n3366: +            os_pgid: None,\n3367: +            invocation_uuid: claim_token,\n3368: +            session_id: Some(SESSION),\n3369: +            provider_name: Some(PROVIDER),\n3370: +            model_name: Some(MODEL),\n3371: +            recorded_at: \"2026-06-04T12:02:00Z\",\n3372: +        })\n3373: +        .unwrap();\n3374: +    fixture\n3375: +        .mailbox()\n3376: +        .record_wake_claim_pid(SESSION, claim_token, identity.os_pid)\n3377: +        .unwrap();\n3378: +}\n3379: +\n3380: +fn acquire_seed_wake_claim(fixture: &Fixture, claim_token: &str) {\n3381: +    acquire_seed_wake_claim_for(fixture, SESSION, claim_token);\n3382: +}\n3383: +\n3384: +fn acquire_seed_wake_claim_for(fixture: &Fixture, session_id: &str, claim_token: &str) {\n3385: +    let mut db = fixture.mailbox();\n3386: +    assert!(matches!(\n3387: +        db.try_acquire_wake_claim(WakeClaimRequest {\n3388: +            session_id,\n3389: +            claim_token,\n3390: +            reason: \"notify_idle\",\n3391: +            auto_wake_count: 1,\n3392: +            wake_invocation_uuid: None,\n3393: +            stale_after_seconds: 600,\n3394: +        })\n3395: +        .unwrap(),\n3396: +        WakeClaimAcquireResult::Acquired(_)\n3397: +    ));\n3398: +}\n3399: +\n3400: +fn age_wake_claim_for(fixture: &Fixture, session_id: &str, seconds_old: i64) {\n3401: +    let claimed_at = (Utc::now() - chrono::Duration::seconds(seconds_old)).to_rfc3339();\n3402: +    fixture\n3403: +        .sidecar_conn()\n3404: +        .execute(\n3405: +            \"UPDATE session_wake_claim SET claimed_at = ?2 WHERE session_id = ?1\",\n3406: +            rusqlite::params![session_id, claimed_at],\n3407: +        )\n3408: +        .unwrap();\n3409: +}\n3410: +\n3411: +fn current_process_identity() -> ProcessIdentity {\n3412: +    read_live_process_identity(i64::from(std::process::id()))\n3413: +        .unwrap()\n3414: +        .expect(\"test process should have a live identity\")\n3415: +}\n3416: +\n3417:  #[test]\n3418:  fn provider_shadow_xdg_notify_uses_pinned_data_dir_and_wakes() {\n3419:      let _guard = integration_test_guard();\n3420: @@ -840,6 +1260,10 @@ expor