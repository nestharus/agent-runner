e\")));\n405:  \n406:          let path = locate_transcript(&cfg, \"p\", \"session-123\")\n407: @@ -1054,9 +1256,8 @@ printf '%s\\n' \"{}\"\"#,\n408:              .expect(\"locator should return a path\");\n409:  \n410:          assert_eq!(path, transcript);\n411: -        let seen =\n412: -            std::fs::read_to_string(dir.path().join(\"state\").join(\"seen-session.txt\")).unwrap();\n413: -        assert_eq!(seen.trim(), \"session-123\");\n414: +        let seen = marker_contents(&dir.path().join(\"state\"), \"seen-session.txt\");\n415: +        assert_trimmed_eq(&seen, \"session-123\");\n416:      }\n417:  \n418:      #[test]\n419: diff --git a/crates/oulipoly-state/src/db.rs b/crates/oulipoly-state/src/db.rs\n420: index 7ec67ca..e249275 100755\n421: --- a/crates/oulipoly-state/src/db.rs\n422: +++ b/crates/oulipoly-state/src/db.rs\n423: @@ -5879,6 +5879,34 @@ impl StateDb {\n424:          Ok(false)\n425:      }\n426:  \n427: +    pub fn has_session_user_turn_containing(\n428: +        &self,\n429: +        provider_name: &str,\n430: +        session_id: &str,\n431: +        needle: &str,\n432: +    ) -> Result<bool, String> {\n433: +        if needle.is_empty() {\n434: +            return Ok(false);\n435: +        }\n436: +        let found: i64 = self\n437: +            .conn\n438: +            .query_row(\n439: +                \"SELECT EXISTS(\n440: +                    SELECT 1\n441: +                    FROM session_turns\n442: +                    WHERE provider_name = ?1\n443: +                      AND session_id = ?2\n444: +                      AND role = 'user'\n445: +                      AND body IS NOT NULL\n446: +                      AND instr(body, ?3) > 0\n447: +                )\",\n448: +                sqlite::params![provider_name, session_id, needle],\n449: +                |row| row.get(0),\n450: +            )\n451: +            .map_err(|e| format!(\"Failed to query session user turn substring: {e}\"))?;\n452: +        Ok(found != 0