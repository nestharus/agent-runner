r) -> String {\n759:     format!(\n760:         \"{} wait failed: {error}\",\n761:         capitalize_script_kind(script_kind)\n762:     )\n763: }\n764: \n765: fn join_script_reader(handle: JoinHandle<String>) -> String {\n766:     handle.join().unwrap_or_default()\n767: }\n768: \n769: fn format_session_script_nonzero(\n770:     script_kind: &str,\n771:     status: ExitStatus,\n772:     stderr_text: &str,\n773: ) -> String {\n774:     format!(\n775:         \"{} exited {}: {}\",\n776:         capitalize_script_kind(script_kind),\n777:         status.code().unwrap_or(-1),\n778:         stderr_text.trim()\n779:     )\n780: }\n781: \n782: fn capitalize_script_kind(kind: &str) -> String {\n783:     let mut chars = kind.chars();\n784:     match chars.next() {\n785:         Some(first) => first.to_uppercase().collect::<String>() + chars.as_str(),\n786:         None => kind.to_string(),\n787:     }\n788: }\n789: \n790: #[cfg(test)]\n791: mod tests {\n792:     use super::*;\n793:     use std::collections::HashMap;\n794:     use std::os::unix::fs::PermissionsExt;\n795:     use std::time::Duration;\n796: \n797:     fn db() -> StateDb {\n798:         StateDb::open(std::path::Path::new(\":memory:\")).unwrap()\n799:     }\n800: \n801:     /// Tempdir + executable script inside it. Returning the dir keeps the\n802:     /// path alive; writing via `std::fs::write` releases the file handle so\n803:     /// `sh` can exec it without \"Text file busy\".\n804:     struct Fixture {\n805:         _dir: tempfile::TempDir,\n806:         path: std::path::PathBuf,\n807:     }\n808: \n809:     fn fixture_script(body: &str) -> Fixture {\n810:         let dir = tempfile::tempdir().unwrap();\n811:         let path = fixture_script_path(dir.path());\n812:         write_script_file(&path, &formatted_fixture_script(body));\n813:         make_script_executable(&path);\n814:         Fixture { _dir: dir, path }\n815:     }\n816: \n817:     fn fixture_script_path(dir: &std::path::Path) -> std::path::PathBuf {\n818:         dir.join(\"turn-script.sh\")\n819:     }\n820: \n821:     fn formatted_fixture_script(body: &str) -> String {\n822:         format!(\"#!/usr/bin/env bash\\n{body}\\n\")\n823:     }\n824: \n825:     fn write_script_file(path: &std::path::Path, contents: &str) {\n826:         std::fs::write(path, contents).unwrap();\n827:     }\n828: \n829:     fn make_script_executable(path: &std::path::Path) {\n830:         let permissions = executable_permissions(script_permissions(path));\n831:         std::fs::set_permissions(path, permissions).unwrap();\n832:     }\n833: \n834:     fn script_permissions(path: &std::path::Path) -> std::fs::Permissions {\n835:         std::fs::metadata(path).unwrap().permissions()\n836:     }\n837: \n838:     fn executable_permissions(mut permissions: std::fs::Permissions) -> std::fs::Permissions {\n839:         permissions.set_mode(0o755);\n840:         permissions\n841:     }\n842: \n843:     fn cfg_with(provider: &str, script_path: &std::path::Path) -> SessionsConfig {\n844:         let mut entries = HashMap::new();\n845:         entries.insert(\n846:             provider.to_string(),\n847:             SessionSourceEntry {\n848:                 turn_script: script_path.to_string_lossy().into_owned(),\n849:                 transcript_locator: None,\n850:                 state_dir: None,\n851:             },\n852:         );\n853:         SessionsConfig { entries }\n854:     }\n855: \n856:     fn cfg_with_locator(\n857:         provider: &str,\n858:         locator_path: &std::path::Path,\n859:         state_dir: Option<std::path::PathBuf>,\n860:     ) -> SessionsConfig {\n861:         let mut entries = HashMap::new();\n862:         entries.insert(\n863:             provider.to_string(),\n864:             SessionSourceEntry {\n865:                 turn_script: \"true\".to_string(),\n866:                 transcript_locator: Some(locator_path.to_string_lossy().into_owned()),\n867:                 state_dir,\n868:             },\n869:         );\n870:         SessionsConfig { entries }\n871:     }\n872: \n873:     fn cfg_with_state_dir(\n874:         provider: &str,\n875:         script_path: &std::path::Path,\n876:         state_dir: std::path::PathBuf,\n877:     ) -> SessionsConfig {\n878:         let mut entries = HashMap::new();\n879:         entries.insert(\n880:             provider.to_string(),\n881:             SessionSourceEntry {\n882:                 turn_script: script_path.to_string_lossy().into_owned(),\n883:                 transcript_locator: None,\n884:                 state_dir: Some(state_dir),\n885:             },\n886:         );\n887:         SessionsConfig { entries }\n888:     }\n889: \n890:     fn stored_turn_body(\n891:         db: &StateDb,\n892:         provider_name: &str,\n893:         session_id: &str,\n894:         turn_id: &str,\n895:     ) -> String {\n896:         db.connection()\n897:             .query_row(\n898:                 \"SELECT body FROM session_turns\n899:                  WHERE provider_name = ?1 AND session_id = ?2 AND turn_id = ?3\",\n900:                 rusqlite::params![provider_name, session_id, turn_id],\n901:                 |row| row.get(0),\n902:             )\n903:             .unwrap()\n904:     }\n905: \n906:     fn parsed_json_value(raw: &str) -> serde_json::Value {\n907:         serde_json::from_str(raw).unwrap()\n908:     }\n909: \n910:     fn assert_edge_body_preserved(body: &serde_json::Value) {\n911:         assert_eq!(body, &expected_edge_body());\n912:     }\n913: \n914:     fn expected_edge_body() -> serde_json::Value {\n915:         serde_json::json!([{\"type\":\"text\",\"text\":\"line one\\n日本語\\n{\\\"escaped\\\":true}\\u{0007}\"}])\n916:     }\n917: \n918:     fn all_invalid_body_shape_errors(errors: &[String]) -> bool {\n919:         errors.iter().all(|error| {\n920:             error.contains(\"invalid body shape\")\n921:                 && error.contains(\"expected canonical content chunk array\")\n922:         })\n923:     }\n924: \n925:     fn stored_turn_bodies(\n926:         db: &StateDb,\n927:         provider_name: &str,\n928:         session_id: &str,\n929:     ) -> Vec<Option<String>> {\n930:         db.connection()\n931:             .prepare(\n932:                 \"SELECT body FROM session_turns\n933:                  WHERE provider_name = ?1 AND session_id = ?2\n934:                  ORDER BY turn_id\",\n935:             )\n936:             .unwrap()\n937:             .query_map(rusqlite::params![provider_name, session_id], |row| {\n938:                 row.get(0)\n939:             })\n940:             .unwrap()\n941:             .map(Result::unwrap)\n942:             .collect()\n943:     }\n944: \n945:     fn leaked_marker_script(marker_path: &std::path::Path) -> String {\n946:         format!(\n947:             \"(sleep 2; printf leaked > {}) & wait\",\n948:             marker_path.display()\n949:         )\n950:     }\n951: \n952:     fn assert_marker_does_not_exist(path: &std::path::Path) {\n953:         assert!(\n954:             path_does_not_exist(path),\n955:             \"timed-out turn script left a process-group child running\"\n956:         );\n957:     }\n958: \n959:     fn path_does_not_exist(path: &std::path::Path) -> bool {\n960:         !path.exists()\n961:     }\n962: \n963:     fn marker_contents(dir: &std::path::Path, name: &str) -> String {\n964:         std::fs::read_to_string(dir.join(name)).unwrap()\n965:     }\n966: \n967:     fn assert_contains_path(contents: &str, path: &std::path::Path) {\n968:         assert!(contents_contains_path(contents, path));\n969:     }\n970: \n971:     fn contents_contains_path(contents: &str, path: &std::path::Path) -> bool {\n972:         contents.contains(path_text(path))\n973:     }\n974: \n975:     fn path_text(path: &std::path::Path) -> &str {\n976:         path.to_str().unwrap()\n977:     }\n978: \n979:     fn assert_trimmed_eq(actual: &str, expected: &str) {\n980:         assert_eq!(trimmed_text(actual), expected);\n981:     }\n982: \n983:     fn trimmed_text(text: &str) -> &str {\n984:         text.trim()\n985:     }\n986: \n987:     fn session_turn_total(db: &StateDb, provider_name: &str, session_id: &str) -> u64 {\n988:         db.count_session_turns(provider_name, session_id)\n989:             .unwrap()\n990:             .total\n991:     }\n992: \n993:     fn assert_u64_eq(actual: u64, expected: u64) {\n994:         assert_eq!(actual, expected);\n995:     }\n996: \n997:     fn assert_session_turn_total(\n998:         db: &StateDb,\n999:         provider_name: &str,\n1000:         session_id: &str,\n1001:         expected: u64,\n1002:     ) {\n1003:         assert_u64_eq(session_turn_total(db, provider_name, session_id), expected);\n1004:     }\n1005: \n1006:     fn transcript_fixture_path(dir: &std::path::Path) -> std::path::PathBuf {\n1007:         dir.join(\"session.jsonl\")\n1008:     }\n1009: \n1010:     fn transcript_fixture_body() -> &'static str {\n1011:         \"{\\\"type\\\":\\\"system\\\"}\\n\"\n1012:     }\n1013: \n1014:     fn write_transcript_fixture(path: &std::path::Path) {\n1015:         std::fs::write(path, transcript_fixture_body()).unwrap();\n1016:     }\n1017: \n1018:     fn locator_script_for_transcript(transcript: &std::path::Path) -> String {\n1019:         format!(\n1020:             r#\"printf '%s\\n' \"$SESSION_ID\" > \"$STATE_DIR/seen-session.txt\"\n1021: printf '%s\\n' \"{}\"\"#,\n1022:             transcript.display()\n1023:         )\n1024:     }\n1025: \n1026:     #[test]\n1027:     fn ingests_assistant_turns_and_advances_count() {\n1028:         let db = db();\n1029:         let script = fixture_script(\n1030:             r#\"cat <<EOF\n1031: {\"session_id\":\"S1\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"user\"}\n1032: {\"session_id\":\"S1\",\"turn_id\":\"t2\",\"timestamp\":\"2026-04-17T08:00:01Z\",\"role\":\"assistant\"}\n1033: {\"session_id\":\"S1\",\"turn_id\":\"t3\",\"timestamp\":\"2026-04-17T08:00:02Z\",\"role\":\"user\"}\n1034: {\"session_id\":\"S1\",\"turn_id\":\"t4\",\"timestamp\":\"2026-04-17T08:00:03Z\",\"role\":\"assistant\"}\n1035: EOF\"#,\n1036:         );\n1037:         let cfg = cfg_with(\"p\", &script.path);\n1038:         let r = scan_provider(\"p\", &cfg, &db);\n1039:         assert_eq!(r.errors, Vec::<String>::new());\n1040:         assert_eq!(r.new_turns, 4);\n1041:         assert_eq!(db.count_assistant_turns_since(\"p\", None).unwrap(), 2);\n1042:     }\n1043: \n1044:     #[test]\n1045:     fn duplicate_turns_are_idempotent_per_unique_constraint() {\n1046:         let db = db();\n1047:         let script = fixture_script(\n1048:             r#\"cat <<EOF\n1049: {\"session_id\":\"S1\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\"}\n1050: {\"session_id\":\"S1\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\"}\n1051: EOF\"#,\n1052:         );\n1053:         let cfg = cfg_with(\"p\", &script.path);\n1054:         let r = scan_provider(\"p\", &cfg, &db);\n1055:         assert_eq!(r.new_turns, 1, \"second emission deduped by UNIQUE\");\n1056:         assert_eq!(r.script_lines, 2);\n1057:     }\n1058: \n1059:     #[test]\n1060:     fn script_turn_legacy_json_deserializes_with_none_defaults() {\n1061:         let turn: ScriptTurn = serde_json::from_str(\n1062:             r#\"{\"session_id\":\"S1\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\"}\"#,\n1063:         )\n1064:         .unwrap();\n1065: \n1066:         assert_eq!(turn.session_id, \"S1\");\n1067:         assert_eq!(turn.turn_id, \"t1\");\n1068:         assert_eq!(turn.role, \"assistant\");\n1069:         assert_eq!(turn.parent_turn_id, None);\n1070:         assert_eq!(turn.is_sidechain, None);\n1071:         assert_eq!(turn.body, None);\n1072:     }\n1073: \n1074:     #[test]\n1075:     fn script_turn_full_json_deserializes_parent_and_sidechain_fields() {\n1076:         let turn: ScriptTurn = serde_json::from_str(\n1077:             r#\"{\"session_id\":\"S1\",\"turn_id\":\"t2\",\"timestamp\":\"2026-04-17T08:00:01Z\",\"role\":\"assistant\",\"parent_turn_id\":\"t1\",\"is_sidechain\":true}\"#,\n1078:         )\n1079:         .unwrap();\n1080: \n1081:         assert_eq!(turn.session_id, \"S1\");\n1082:         assert_eq!(turn.turn_id, \"t2\");\n1083:         assert_eq!(turn.parent_turn_id.as_deref(), Some(\"t1\"));\n1084:         assert_eq!(turn.is_sidechain, Some(true));\n1085:     }\n1086: \n1087:     #[test]\n1088:     fn scan_provider_persists_body_encoding_edge_cases() {\n1089:         // risk: encoding regression; level: particular-integration; source: contract §4 T6 / proposal A5,A7.\n1090:         let db = db();\n1091:         let script = fixture_script(\n1092:             r#\"cat <<'EOF'\n1093: {\"session_id\":\"S1\",\"turn_id\":\"edge-body\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\",\"body\":[{\"type\":\"text\",\"text\":\"line one\\n日本語\\n{\\\"escaped\\\":true}\\u0007\"}]}\n1094: EOF\"#,\n1095:         );\n1096:         let cfg = cfg_with(\"p\", &script.path);\n1097: \n1098:         let report = scan_provider(\"p\", &cfg, &db);\n1099: \n1100:         assert_eq!(report.errors, Vec::<String>::new());\n1101:         assert_eq!(report.new_turns, 1);\n1102:         let raw_body = stored_turn_body(&db, \"p\", \"S1\", \"edge-body\");\n1103:         let body = parsed_json_value(&raw_body);\n1104:         assert_edge_body_preserved(&body);\n1105:     }\n1106: \n1107:     #[test]\n1108:     fn scan_provider_rejects_non_canonical_body_shape() {\n1109:         // risk: invalid adapter body poisons downstream canonical export; level: unit; source: CodeRabbit R4-F05.\n1110:         let db = db();\n1111:         let script = fixture_script(\n1112:             r#\"cat <<'EOF'\n1113: {\"session_id\":\"S1\",\"turn_id\":\"bad-body\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\",\"body\":{\"type\":\"text\",\"text\":\"not an array\"}}\n1114: {\"session_id\":\"S1\",\"turn_id\":\"bad-text\",\"timestamp\":\"2026-04-17T08:00:01Z\",\"role\":\"assistant\",\"body\":[{\"type\":\"text\",\"text\":7}]}\n1115: EOF\"#,\n1116:         );\n1117:         let cfg = cfg_with(\"p\", &script.path);\n1118: \n1119:         let report = scan_provider(\"p\", &cfg, &db);\n1120: \n1121:         assert_eq!(report.new_turns, 2);\n1122:         assert_eq!(report.errors.len(), 2);\n1123:         assert!(all_invalid_body_shape_errors(&report.errors));\n1124:         let stored_bodies = stored_turn_bodies(&db, \"p\", \"S1\");\n1125:         assert_eq!(stored_bodies, vec![None, None]);\n1126:     }\n1127: \n1128:     #[test]\n1129:     fn malformed_lines_collect_as_errors_but_dont_abort() {\n1130:         let db = db();\n1131:         let script = fixture_script(\n1132:             r#\"cat <<EOF\n1133: not-json\n1134: {\"session_id\":\"S1\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\"}\n1135: EOF\"#,\n1136:         );\n1137:         let cfg = cfg_with(\"p\", &script.path);\n1138:         let r = scan_provider(\"p\", &cfg, &db);\n1139:         assert_eq!(r.new_turns, 1);\n1140:         assert_eq!(r.errors.len(), 1);\n1141:         assert!(r.errors[0].contains(\"malformed\"));\n1142:     }\n1143: \n1144:     #[test]\n1145:     fn nonzero_exit_is_an_error() {\n1146:         let db = db();\n1147:         let script = fixture_script(\"echo something-bad >&2; exit 7\");\n1148:         let cfg = cfg_with(\"p\", &script.path);\n1149:         let r = scan_provider(\"p\", &cfg, &db);\n1150:         assert_eq!(r.new_turns, 0);\n1151:         assert_eq!(r.errors.len(), 1);\n1152:         assert!(r.errors[0].contains(\"exited 7\"));\n1153:     }\n1154: \n1155:     #[test]\n1156:     fn turn_script_timeout_is_classified_and_does_not_persist_turns() {\n1157:         let db = db();\n1158:         let script = fixture_script(\"sleep 60\");\n1159:         let cfg = cfg_with(\"p\", &script.path);\n1160: \n1161:         let r = scan_provider_with_timeout(\"p\", &cfg, &db, 1);\n1162: \n1163:         assert_eq!(r.new_turns, 0);\n1164:         assert_eq!(db.count_assistant_turns_since(\"p\", None).unwrap(), 0);\n1165:         assert_eq!(r.errors.len(), 1);\n1166:         assert!(r.errors[0].contains(\"script_timeout\"), \"{:?}\", r.errors);\n1167:         assert!(r.errors[0].contains(\"turn script\"), \"{:?}\", r.errors);\n1168:     }\n1169: \n1170:     #[cfg(unix)]\n1171:     #[test]\n1172:     fn turn_script_timeout_kills_process_group_children() {\n1173:         let db = db();\n1174:         let dir = tempfile::tempdir().unwrap();\n1175:         let leaked_marker = dir.path().join(\"leaked\");\n1176:         let script = fixture_script(&leaked_marker_script(&leaked_marker));\n1177:         let cfg = cfg_with(\"p\", &script.path);\n1178: \n1179:         let r = scan_provider_with_timeout(\"p\", &cfg, &db, 1);\n1180:         std::thread::sleep(Duration::from_secs(3));\n1181: \n1182:         assert_eq!(r.new_turns, 0);\n1183:         assert_eq!(r.errors.len(), 1);\n1184:         assert!(r.errors[0].contains(\"script_timeout\"), \"{:?}\", r.errors);\n1185:         assert_marker_does_not_exist(&leaked_marker);\n1186:     }\n1187: \n1188:     #[test]\n1189:     fn degraded_marker_is_reported_without_malformed_turn_error() {\n1190:         let db = db();\n1191:         let script = fixture_script(r#\"printf '%s\\n' '{\"degraded\":true,\"count\":1}'\"#);\n1192:         let cfg = cfg_with(\"p\", &script.path);\n1193: \n1194:         let r = scan_provider(\"p\", &cfg, &db);\n1195: \n1196:         assert_eq!(r.new_turns, 0);\n1197:         assert_eq!(r.errors.len(), 1);\n1198:         assert!(r.errors[0].contains(\"degraded\"), \"{:?}\", r.errors);\n1199:         assert!(!r.errors[0].contains(\"malformed\"), \"{:?}\", r.errors);\n1200:     }\n1201: \n1202:     #[test]\n1203:     fn script_receives_state_dir_env() {\n1204:         let db = db();\n1205:         let script = fixture_script(\n1206:             r#\"echo \"{\\\"session_id\\\":\\\"S\\\",\\\"turn_id\\\":\\\"t1\\\",\\\"timestamp\\\":\\\"2026-04-17T08:00:00Z\\\",\\\"role\\\":\\\"assistant\\\"}\"\n1207: echo \"STATE_DIR=$STATE_DIR\" > \"$STATE_DIR/marker.txt\"\"#,\n1208:         );\n1209:         let tempdir = tempfile::tempdir().unwrap();\n1210:         let cfg = cfg_with_state_dir(\"p\", &script.path, tempdir.path().to_path_buf());\n1211:         let r = scan_provider(\"p\", &cfg, &db);\n1212:         assert_eq!(r.errors, Vec::<String>::new());\n1213:         assert_eq!(r.new_turns, 1);\n1214:         let marker = marker_contents(tempdir.path(), \"marker.txt\");\n1215:         assert_contains_path(&marker, tempdir.path());\n1216:     }\n1217: \n1218:     #[test]\n1219:     fn scan_provider_session_sets_session_id_env() {\n1220:         let db = db();\n1221:         let script = fixture_script(\n1222:             r#\"printf '{\"session_id\":\"%s\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"user\"}\\n' \"$SESSION_ID\"\n1223: printf '%s\\n' \"$SESSION_ID\" > \"$STATE_DIR/seen-session.txt\"\"#,\n1224:         );\n1225:         let tempdir = tempfile::tempdir().unwrap();\n1226:         let cfg = cfg_with_state_dir(\"p\", &script.path, tempdir.path().to_path_buf());\n1227: \n1228:         let r = scan_provider_session(\"p\", &cfg, &db, \"session-123\");\n1229: \n1230:         assert_eq!(r.errors, Vec::<String>::new());\n1231:         assert_eq!(r.new_turns, 1);\n1232:         assert_session_turn_total(&db, \"p\", \"session-123\", 1);\n1233:         let seen = marker_contents(tempdir.path(), \"seen-session.txt\");\n1234:         assert_trimmed_eq(&seen, \"session-123\");\n1235:     }\n1236: \n1237:     #[test]\n1238:     fn locate_transcript_returns_none_when_no_locator_is_configured() {\n1239:         let cfg = cfg_with(\"p\", std::path::Path::new(\"/bin/true\"));\n1240: \n1241:         let path = locate_transcript(&cfg, \"p\", \"session-123\").unwrap();\n1242: \n1243:         assert_eq!(path, None);\n1244:     }\n1245: \n1246:     #[test]\n1247:     fn locate_transcript_returns_script_stdout_path() {\n1248:         let dir = tempfile::tempdir().unwrap();\n1249:         let transcript = transcript_fixture_path(dir.path());\n1250:         write_transcript_fixture(&transcript);\n1251:         let script = fixture_script(&locator_script_for_transcript(&transcript));\n1252:         let cfg = cfg_with_locator(\"p\", &script.path, Some(dir.path().join(\"state\")));\n1253: \n1254:         let path = locate_transcript(&cfg, \"p\", \"session-123\")\n1255:             .unwrap()\n1256:             .expect(\"locator should return a path\");\n1257: \n1258:         assert_eq!(path, transcript);\n1259:         let seen = marker_contents(&dir.path().join(\"state\"), \"seen-session.txt\");\n1260:         assert_trimmed_eq(&seen, \"session-123\");\n1261:     }\n1262: \n1263:     #[test]\n1264:     fn locate_transcript_returns_error_on_nonzero_exit() {\n1265:         let script = fixture_script(\"echo missing >&2; exit 9\");\n1266:         let cfg = cfg_with_locator(\"p\", &script.path, None);\n1267: \n1268:         let err = locate_transcript(&cfg, \"p\", \"session-123\").unwrap_err();\n1269: \n1270:         assert!(err.contains(\"exited 9\"), \"{err}\");\n1271:     }\n1272: \n1273:     /// Per contract: a locator that exits 0 but emits nothing on stdout\n1274:     /// is malformed (the script's contract requires a single line). The\n1275:     /// runner must surface this as Err so trace can show the user a\n1276:     /// degraded state, not silently succeed with an empty PathBuf.\n1277:     #[test]\n1278:     fn locate_transcript_returns_error_on_empty_stdout() {\n1279:         let script = fixture_script(\"# emit nothing; exit 0\");\n1280:         let cfg = cfg_with_locator(\"p\", &script.path, None);\n1281: \n1282:         let err = locate_transcript(&cfg, \"p\", \"session-123\").unwrap_err();\n1283: \n1284:         assert!(\n1285:             err.to_lowercase().contains(\"empty\") || err.to_lowercase().contains(\"no path\"),\n1286:             \"expected 'empty' or 'no path' in error, got: {err}\"\n1287:         );\n1288:     }\n1289: \n1290:     fn cfg_from_adapter_fixture(provider: &str, fixture_name: &str) -> (Fixture, SessionsConfig) {\n1291:         let path = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n1292:             .parent()\n1293:             .and_then(std::path::Path::parent)\n1294:             .expect(\"runtime crate should live under <repo>/crates/oulipoly-runtime\")\n1295:             .join(\"src-tauri\")\n1296:             .join(\"tests\")\n1297:             .join(\"fixtures\")\n1298:             .join(\"jsonl\")\n1299:             .join(\"adapter\")\n1300:             .join(fixture_name);\n1301:         let script = fixture_script(&format!(r#\"cat \"{}\"\"#, path.display()));\n1302:         let cfg = cfg_with(provider, &script.path);\n1303:         (script, cfg)\n1304:     }\n1305: \n1306:     // risk: is_compaction_boundary ingest plumbing; level: particular-integration; source: proposal §11.1 is_compaction_boundary ingest plumbing / A3, A6.\n1307:     #[test]\n1308:     fn turn_script_optional_compaction_field_defaults_false() {\n1309:         let db = db();\n1310:         let (_script, cfg) = cfg_from_adapter_fixture(\"claude\", \"without_compaction.jsonl\");\n1311: \n1312:         let result = scan_provider(\"claude\", &cfg, &db);\n1313: \n1314:         assert_eq!(result.errors, Vec::<String>::new());\n1315:         assert_eq!(result.new_turns, 1);\n1316:         assert_eq!(\n1317:             db.latest_compaction_boundary(\"claude\", \"11111111-1111-4111-8111-111111111111\")\n1318:                 .unwrap(),\n1319:             None\n1320:         );\n1321:     }\n1322: \n1323:     // risk: is_compaction_boundary ingest plumbing; level: particular-integration; source: proposal §11.1 is_compaction_boundary ingest plumbing / A3, A6.\n1324:     #[test]\n1325:     fn turn_script_compaction_field_propagates_to_session_turns() {\n1326:         let db = db();\n1327:         let (_script, cfg) = cfg_from_adapter_fixture(\"claude\", \"with_compaction.jsonl\");\n1328: \n1329:         let result = scan_provider(\"claude\", &cfg, &db);\n1330: \n1331:         assert_eq!(result.errors, Vec::<String>::new());\n1332:         assert_eq!(result.new_turns, 1);\n1333:         let boundary = db\n1334:             .latest_compaction_boundary(\"claude\", \"11111111-1111-4111-8111-111111111111\")\n1335:             .unwrap()\n1336:             .expect(\"boundary turn should be persisted\");\n1337:         assert_eq!(boundary.0, \"boundary-1\");\n1338:     }\n1339: }\n\n(End of file - total 1339 lines)\n</content>","metadata":{"preview":"    timeout_secs: u64,\n) -> Result<(), String> {\n    kill_timed_out_pending_session_script(child);\n    Err(format_pending_session_script_timeout(\n        script_kind,\n        timeout_secs,\n    ))\n}\n\nfn kill_timed_out_pending_session_script(child: &mut Child) {\n    kill_session_script_process_group(child);\n}\n\n#[cfg(unix)]\nfn kill_session_script_process_group(child: &mut Child) {\n    let pgid = -(child.id() as libc::pid_t);\n    // SAFETY: `pgid` targets the process group created with `process_group(0)`\n    // for this child. Killing the group prevents shell grandchildren from\n    // continuing to run or holding stdout/stderr pipes after timeout.\n    let _ = unsafe { libc::kill(pgid, libc::SIGKILL) };","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-runtime/src/sessions/mod.rs","text":"    timeout_secs: u64,\n) -> Result<(), String> {\n    kill_timed_out_pending_session_script(child);\n    Err(format_pending_session_script_timeout(\n        script_kind,\n        timeout_secs,\n    ))\n}\n\nfn kill_timed_out_pending_session_script(child: &mut Child) {\n    kill_session_script_process_group(child);\n}\n\n#[cfg(unix)]\nfn kill_session_script_process_group(child: &mut Child) {\n    let pgid = -(child.id() as libc::pid_t);\n    // SAFETY: `pgid` targets the process group created with `process_group(0)`\n    // for this child. Killing the group prevents shell grandchildren from\n    // continuing to run or holding stdout/stderr pipes after timeout.\n    let _ = unsafe { libc::kill(pgid, libc::SIGKILL) };\n    let _ = child.kill();\n    let _ = child.wait();\n}\n\n#[cfg(not(unix))]\nfn kill_session_script_process_group(child: &mut Child) {\n    let _ = child.kill();\n    let _ = child.wait();\n}\n\nfn sleep_before_next_session_script_poll() {\n    std::thread::sleep(std::time::Duration::from_millis(50));\n}\n\nfn format_pending_session_script_timeout(script_kind: &str, timeout_secs: u64) -> String {\n    format!(\"script_timeout: {script_kind} timed out after {timeout_secs}s\")\n}\n\nfn format_session_script_wait_error(script_kind: &str, error: std::io::Error) -> String {\n    format!(\n        \"{} wait failed: {error}\",\n        capitalize_script_kind(script_kind)\n    )\n}\n\nfn join_script_reader(handle: JoinHandle<String>) -> String {\n    handle.join().unwrap_or_default()\n}\n\nfn format_session_script_nonzero(\n    script_kind: &str,\n    status: ExitStatus,\n    stderr_text: &str,\n) -> String {\n    format!(\n        \"{} exited {}: {}\",\n        capitalize_script_kind(script_kind),\n        status.code().unwrap_or(-1),\n        stderr_text.trim()\n    )\n}\n\nfn capitalize_script_kind(kind: &str) -> String {\n    let mut chars = kind.chars();\n    match chars.next() {\n        Some(first) => first.to_uppercase().collect::<String>() + chars.as_str(),\n        None => kind.to_string(),\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::collections::HashMap;\n    use std::os::unix::fs::PermissionsExt;\n    use std::time::Duration;\n\n    fn db() -> StateDb {\n        StateDb::open(std::path::Path::new(\":memory:\")).unwrap()\n    }\n\n    /// Tempdir + executable script inside it. Returning the dir keeps the\n    /// path alive; writing via `std::fs::write` releases the file handle so\n    /// `sh` can exec it without \"Text file busy\".\n    struct Fixture {\n        _dir: tempfile::TempDir,\n        path: std::path::PathBuf,\n    }\n\n    fn fixture_script(body: &str) -> Fixture {\n        let dir = tempfile::tempdir().unwrap();\n        let path = fixture_script_path(dir.path());\n        write_script_file(&path, &formatted_fixture_script(body));\n        make_script_executable(&path);\n        Fixture { _dir: dir, path }\n    }\n\n    fn fixture_script_path(dir: &std::path::Path) -> std::path::PathBuf {\n        dir.join(\"turn-script.sh\")\n    }\n\n    fn formatted_fixture_script(body: &str) -> String {\n        format!(\"#!/usr/bin/env bash\\n{body}\\n\")\n    }\n\n    fn write_script_file(path: &std::path::Path, contents: &str) {\n        std::fs::write(path, contents).unwrap();\n    }\n\n    fn make_script_executable(path: &std::path::Path) {\n        let permissions = executable_permissions(script_permissions(path));\n        std::fs::set_permissions(path, permissions).unwrap();\n    }\n\n    fn script_permissions(path: &std::path::Path) -> std::fs::Permissions {\n        std::fs::metadata(path).unwrap().permissions()\n    }\n\n    fn executable_permissions(mut permissions: std::fs::Permissions) -> std::fs::Permissions {\n        permissions.set_mode(0o755);\n        permissions\n    }\n\n    fn cfg_with(provider: &str, script_path: &std::path::Path) -> SessionsConfig {\n        let mut entries = HashMap::new();\n        entries.insert(\n            provider.to_string(),\n            SessionSourceEntry {\n                turn_script: script_path.to_string_lossy().into_owned(),\n                transcript_locator: None,\n                state_dir: None,\n            },\n        );\n        SessionsConfig { entries }\n    }\n\n    fn cfg_with_locator(\n        provider: &str,\n        locator_path: &std::path::Path,\n        state_dir: Option<std::path::PathBuf>,\n    ) -> SessionsConfig {\n        let mut entries = HashMap::new();\n        entries.insert(\n            provider.to_string(),\n            SessionSourceEntry {\n                turn_script: \"true\".to_string(),\n                transcript_locator: Some(locator_path.to_string_lossy().into_owned()),\n                state_dir,\n            },\n        );\n        SessionsConfig { entries }\n    }\n\n    fn cfg_with_state_dir(\n        provider: &str,\n        script_path: &std::path::Path,\n        state_dir: std::path::PathBuf,\n    ) -> SessionsConfig {\n        let mut entries = HashMap::new();\n        entries.insert(\n            provider.to_string(),\n            SessionSourceEntry {\n                turn_script: script_path.to_string_lossy().into_owned(),\n                transcript_locator: None,\n                state_dir: Some(state_dir),\n            },\n        );\n        SessionsConfig { entries }\n    }\n\n    fn stored_turn_body(\n        db: &StateDb,\n        provider_name: &str,\n        session_id: &str,\n        turn_id: &str,\n    ) -> String {\n        db.connection()\n            .query_row(\n                \"SELECT body FROM session_turns\n                 WHERE provider_name = ?1 AND session_id = ?2 AND turn_id = ?3\",\n                rusqlite::params![provider_name, session_id, turn_id],\n                |row| row.get(0),\n            )\n            .unwrap()\n    }\n\n    fn parsed_json_value(raw: &str) -> serde_json::Value {\n        serde_json::from_str(raw).unwrap()\n    }\n\n    fn assert_edge_body_preserved(body: &serde_json::Value) {\n        assert_eq!(body, &expected_edge_body());\n    }\n\n    fn expected_edge_body() -> serde_json::Value {\n        serde_json::json!([{\"type\":\"text\",\"text\":\"line one\\n日本語\\n{\\\"escaped\\\":true}\\u{0007}\"}])\n    }\n\n    fn all_invalid_body_shape_errors(errors: &[String]) -> bool {\n        errors.iter().all(|error| {\n            error.contains(\"invalid body shape\")\n                && error.contains(\"expected canonical content chunk array\")\n        })\n    }\n\n    fn stored_turn_bodies(\n        db: &StateDb,\n        provider_name: &str,\n        session_id: &str,\n    ) -> Vec<Option<String>> {\n        db.connection()\n            .prepare(\n                \"SELECT body FROM session_turns\n                 WHERE provider_name = ?1 AND session_id = ?2\n                 ORDER BY turn_id\",\n            )\n            .unwrap()\n            .query_map(rusqlite::params![provider_name, session_id], |row| {\n                row.get(0)\n            })\n            .unwrap()\n            .map(Result::unwrap)\n            .collect()\n    }\n\n    fn leaked_marker_script(marker_path: &std::path::Path) -> String {\n        format!(\n            \"(sleep 2; printf leaked > {}) & wait\",\n            marker_path.display()\n        )\n    }\n\n    fn assert_marker_does_not_exist(path: &std::path::Path) {\n        assert!(\n            path_does_not_exist(path),\n            \"timed-out turn script left a process-group child running\"\n        );\n    }\n\n    fn path_does_not_exist(path: &std::path::Path) -> bool {\n        !path.exists()\n    }\n\n    fn marker_contents(dir: &std::path::Path, name: &str) -> String {\n        std::fs::read_to_string(dir.join(name)).unwrap()\n    }\n\n    fn assert_contains_path(contents: &str, path: &std::path::Path) {\n        assert!(contents_contains_path(contents, path));\n    }\n\n    fn contents_contains_path(contents: &str, path: &std::path::Path) -> bool {\n        contents.contains(path_text(path))\n    }\n\n    fn path_text(path: &std::path::Path) -> &str {\n        path.to_str().unwrap()\n    }\n\n    fn assert_trimmed_eq(actual: &str, expected: &str) {\n        assert_eq!(trimmed_text(actual), expected);\n    }\n\n    fn trimmed_text(text: &str) -> &str {\n        text.trim()\n    }\n\n    fn session_turn_total(db: &StateDb, provider_name: &str, session_id: &str) -> u64 {\n        db.count_session_turns(provider_name, session_id)\n            .unwrap()\n            .total\n    }\n\n    fn assert_u64_eq(actual: u64, expected: u64) {\n        assert_eq!(actual, expected);\n    }\n\n    fn assert_session_turn_total(\n        db: &StateDb,\n        provider_name: &str,\n        session_id: &str,\n        expected: u64,\n    ) {\n        assert_u64_eq(session_turn_total(db, provider_name, session_id), expected);\n    }\n\n    fn transcript_fixture_path(dir: &std::path::Path) -> std::path::PathBuf {\n        dir.join(\"session.jsonl\")\n    }\n\n    fn transcript_fixture_body() -> &'static str {\n        \"{\\\"type\\\":\\\"system\\\"}\\n\"\n    }\n\n    fn write_transcript_fixture(path: &std::path::Path) {\n        std::fs::write(path, transcript_fixture_body()).unwrap();\n    }\n\n    fn locator_script_for_transcript(transcript: &std::path::Path) -> String {\n        format!(\n            r#\"printf '%s\\n' \"$SESSION_ID\" > \"$STATE_DIR/seen-session.txt\"\nprintf '%s\\n' \"{}\"\"#,\n            transcript.display()\n        )\n    }\n\n    #[test]\n    fn ingests_assistant_turns_and_advances_count() {\n        let db = db();\n        let script = fixture_script(\n            r#\"cat <<EOF\n{\"session_id\":\"S1\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"user\"}\n{\"session_id\":\"S1\",\"turn_id\":\"t2\",\"timestamp\":\"2026-04-17T08:00:01Z\",\"role\":\"assistant\"}\n{\"session_id\":\"S1\",\"turn_id\":\"t3\",\"timestamp\":\"2026-04-17T08:00:02Z\",\"role\":\"user\"}\n{\"session_id\":\"S1\",\"turn_id\":\"t4\",\"timestamp\":\"2026-04-17T08:00:03Z\",\"role\":\"assistant\"}\nEOF\"#,\n        );\n        let cfg = cfg_with(\"p\", &script.path);\n        let r = scan_provider(\"p\", &cfg, &db);\n        assert_eq!(r.errors, Vec::<String>::new());\n        assert_eq!(r.new_turns, 4);\n        assert_eq!(db.count_assistant_turns_since(\"p\", None).unwrap(), 2);\n    }\n\n    #[test]\n    fn duplicate_turns_are_idempotent_per_unique_constraint() {\n        let db = db();\n        let script = fixture_script(\n            r#\"cat <<EOF\n{\"session_id\":\"S1\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\"}\n{\"session_id\":\"S1\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\"}\nEOF\"#,\n        );\n        let cfg = cfg_with(\"p\", &script.path);\n        let r = scan_provider(\"p\", &cfg, &db);\n        assert_eq!(r.new_turns, 1, \"second emission deduped by UNIQUE\");\n        assert_eq!(r.script_lines, 2);\n    }\n\n    #[test]\n    fn script_turn_legacy_json_deserializes_with_none_defaults() {\n        let turn: ScriptTurn = serde_json::from_str(\n            r#\"{\"session_id\":\"S1\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\"}\"#,\n        )\n        .unwrap();\n\n        assert_eq!(turn.session_id, \"S1\");\n        assert_eq!(turn.turn_id, \"t1\");\n        assert_eq!(turn.role, \"assistant\");\n        assert_eq!(turn.parent_turn_id, None);\n        assert_eq!(turn.is_sidechain, None);\n        assert_eq!(turn.body, None);\n    }\n\n    #[test]\n    fn script_turn_full_json_deserializes_parent_and_sidechain_fields() {\n        let turn: ScriptTurn = serde_json::from_str(\n            r#\"{\"session_id\":\"S1\",\"turn_id\":\"t2\",\"timestamp\":\"2026-04-17T08:00:01Z\",\"role\":\"assistant\",\"parent_turn_id\":\"t1\",\"is_sidechain\":true}\"#,\n        )\n        .unwrap();\n\n        assert_eq!(turn.session_id, \"S1\");\n        assert_eq!(turn.turn_id, \"t2\");\n        assert_eq!(turn.parent_turn_id.as_deref(), Some(\"t1\"));\n        assert_eq!(turn.is_sidechain, Some(true));\n    }\n\n    #[test]\n    fn scan_provider_persists_body_encoding_edge_cases() {\n        // risk: encoding regression; level: particular-integration; source: contract §4 T6 / proposal A5,A7.\n        let db = db();\n        let script = fixture_script(\n            r#\"cat <<'EOF'\n{\"session_id\":\"S1\",\"turn_id\":\"edge-body\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\",\"body\":[{\"type\":\"text\",\"text\":\"line one\\n日本語\\n{\\\"escaped\\\":true}\\u0007\"}]}\nEOF\"#,\n        );\n        let cfg = cfg_with(\"p\", &script.path);\n\n        let report = scan_provider(\"p\", &cfg, &db);\n\n        assert_eq!(report.errors, Vec::<String>::new());\n        assert_eq!(report.new_turns, 1);\n        let raw_body = stored_turn_body(&db, \"p\", \"S1\", \"edge-body\");\n        let body = parsed_json_value(&raw_body);\n        assert_edge_body_preserved(&body);\n    }\n\n    #[test]\n    fn scan_provider_rejects_non_canonical_body_shape() {\n        // risk: invalid adapter body poisons downstream canonical export; level: unit; source: CodeRabbit R4-F05.\n        let db = db();\n        let script = fixture_script(\n            r#\"cat <<'EOF'\n{\"session_id\":\"S1\",\"turn_id\":\"bad-body\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\",\"body\":{\"type\":\"text\",\"text\":\"not an array\"}}\n{\"session_id\":\"S1\",\"turn_id\":\"bad-text\",\"timestamp\":\"2026-04-17T08:00:01Z\",\"role\":\"assistant\",\"body\":[{\"type\":\"text\",\"text\":7}]}\nEOF\"#,\n        );\n        let cfg = cfg_with(\"p\", &script.path);\n\n        let report = scan_provider(\"p\", &cfg, &db);\n\n        assert_eq!(report.new_turns, 2);\n        assert_eq!(report.errors.len(), 2);\n        assert!(all_invalid_body_shape_errors(&report.errors));\n        let stored_bodies = stored_turn_bodies(&db, \"p\", \"S1\");\n        assert_eq!(stored_bodies, vec![None, None]);\n    }\n\n    #[test]\n    fn malformed_lines_collect_as_errors_but_dont_abort() {\n        let db = db();\n        let script = fixture_script(\n            r#\"cat <<EOF\nnot-json\n{\"session_id\":\"S1\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"assistant\"}\nEOF\"#,\n        );\n        let cfg = cfg_with(\"p\", &script.path);\n        let r = scan_provider(\"p\", &cfg, &db);\n        assert_eq!(r.new_turns, 1);\n        assert_eq!(r.errors.len(), 1);\n        assert!(r.errors[0].contains(\"malformed\"));\n    }\n\n    #[test]\n    fn nonzero_exit_is_an_error() {\n        let db = db();\n        let script = fixture_script(\"echo something-bad >&2; exit 7\");\n        let cfg = cfg_with(\"p\", &script.path);\n        let r = scan_provider(\"p\", &cfg, &db);\n        assert_eq!(r.new_turns, 0);\n        assert_eq!(r.errors.len(), 1);\n        assert!(r.errors[0].contains(\"exited 7\"));\n    }\n\n    #[test]\n    fn turn_script_timeout_is_classified_and_does_not_persist_turns() {\n        let db = db();\n        let script = fixture_script(\"sleep 60\");\n        let cfg = cfg_with(\"p\", &script.path);\n\n        let r = scan_provider_with_timeout(\"p\", &cfg, &db, 1);\n\n        assert_eq!(r.new_turns, 0);\n        assert_eq!(db.count_assistant_turns_since(\"p\", None).unwrap(), 0);\n        assert_eq!(r.errors.len(), 1);\n        assert!(r.errors[0].contains(\"script_timeout\"), \"{:?}\", r.errors);\n        assert!(r.errors[0].contains(\"turn script\"), \"{:?}\", r.errors);\n    }\n\n    #[cfg(unix)]\n    #[test]\n    fn turn_script_timeout_kills_process_group_children() {\n        let db = db();\n        let dir = tempfile::tempdir().unwrap();\n        let leaked_marker = dir.path().join(\"leaked\");\n        let script = fixture_script(&leaked_marker_script(&leaked_marker));\n        let cfg = cfg_with(\"p\", &script.path);\n\n        let r = scan_provider_with_timeout(\"p\", &cfg, &db, 1);\n        std::thread::sleep(Duration::from_secs(3));\n\n        assert_eq!(r.new_turns, 0);\n        assert_eq!(r.errors.len(), 1);\n        assert!(r.errors[0].contains(\"script_timeout\"), \"{:?}\", r.errors);\n        assert_marker_does_not_exist(&leaked_marker);\n    }\n\n    #[test]\n    fn degraded_marker_is_reported_without_malformed_turn_error() {\n        let db = db();\n        let script = fixture_script(r#\"printf '%s\\n' '{\"degraded\":true,\"count\":1}'\"#);\n        let cfg = cfg_with(\"p\", &script.path);\n\n        let r = scan_provider(\"p\", &cfg, &db);\n\n        assert_eq!(r.new_turns, 0);\n        assert_eq!(r.errors.len(), 1);\n        assert!(r.errors[0].contains(\"degraded\"), \"{:?}\", r.errors);\n        assert!(!r.errors[0].contains(\"malformed\"), \"{:?}\", r.errors);\n    }\n\n    #[test]\n    fn script_receives_state_dir_env() {\n        let db = db();\n        let script = fixture_script(\n            r#\"echo \"{\\\"session_id\\\":\\\"S\\\",\\\"turn_id\\\":\\\"t1\\\",\\\"timestamp\\\":\\\"2026-04-17T08:00:00Z\\\",\\\"role\\\":\\\"assistant\\\"}\"\necho \"STATE_DIR=$STATE_DIR\" > \"$STATE_DIR/marker.txt\"\"#,\n        );\n        let tempdir = tempfile::tempdir().unwrap();\n        let cfg = cfg_with_state_dir(\"p\", &script.path, tempdir.path().to_path_buf());\n        let r = scan_provider(\"p\", &cfg, &db);\n        assert_eq!(r.errors, Vec::<String>::new());\n        assert_eq!(r.new_turns, 1);\n        let marker = marker_contents(tempdir.path(), \"marker.txt\");\n        assert_contains_path(&marker, tempdir.path());\n    }\n\n    #[test]\n    fn scan_provider_session_sets_session_id_env() {\n        let db = db();\n        let script = fixture_script(\n            r#\"printf '{\"session_id\":\"%s\",\"turn_id\":\"t1\",\"timestamp\":\"2026-04-17T08:00:00Z\",\"role\":\"user\"}\\n' \"$SESSION_ID\"\nprintf '%s\\n' \"$SESSION_ID\" > \"$STATE_DIR/seen-session.txt\"\"#,\n        );\n        let tempdir = tempfile::tempdir().unwrap();\n        let cfg = cfg_with_state_dir(\"p\", &script.path, tempdir.path().to_path_buf());\n\n        let r = scan_provider_session(\"p\", &cfg, &db, \"session-123\");\n\n        assert_eq!(r.errors, Vec::<String>::new());\n        assert_eq!(r.new_turns, 1);\n        assert_session_turn_total(&db, \"p\", \"session-123\", 1);\n        let seen = marker_contents(tempdir.path(), \"seen-session.txt\");\n        assert_trimmed_eq(&seen, \"session-123\");\n    }\n\n    #[test]\n    fn locate_transcript_returns_none_when_no_locator_is_configured() {\n        let cfg = cfg_with(\"p\", std::path::Path::new(\"/bin/true\"));\n\n        let path = locate_transcript(&cfg, \"p\", \"session-123\").unwrap();\n\n        assert_eq!(path, None);\n    }\n\n    #[test]\n    fn locate_transcript_returns_script_stdout_path() {\n        let dir = tempfile::tempdir().unwrap();\n        let transcript = transcript_fixture_path(dir.path());\n        write_transcript_fixture(&transcript);\n        let script = fixture_script(&locator_script_for_transcript(&transcript));\n        let cfg = cfg_with_locator(\"p\", &script.path, Some(dir.path().join(\"state\")));\n\n        let path = locate_transcript(&cfg, \"p\", \"session-123\")\n            .unwrap()\n            .expect(\"locator should return a path\");\n\n        assert_eq!(path, transcript);\n        let seen = marker_contents(&dir.path().join(\"state\"), \"seen-session.txt\");\n        assert_trimmed_eq(&seen, \"session-123\");\n    }\n\n    #[test]\n    fn locate_transcript_returns_error_on_nonzero_exit() {\n        let script = fixture_script(\"echo missing >&2; exit 9\");\n        let cfg = cfg_with_locator(\"p\", &script.path, None);\n\n        let err = locate_transcript(&cfg, \"p\", \"session-123\").unwrap_err();\n\n        assert!(err.contains(\"exited 9\"), \"{err}\");\n    }\n\n    /// Per contract: a locator that exits 0 but emits nothing on stdout\n    /// is malformed (the script's contract requires a single line). The\n    /// runner must surface this as Err so trace can show the user a\n    /// degraded state, not silently succeed with an empty PathBuf.\n    #[test]\n    fn locate_transcript_returns_error_on_empty_stdout() {\n        let script = fixture_script(\"# emit nothing; exit 0\");\n        let cfg = cfg_with_locator(\"p\", &script.path, None);\n\n        let err = locate_transcript(&cfg, \"p\", \"session-123\").unwrap_err();\n\n        assert!(\n            err.to_lowercase().contains(\"empty\") || err.to_lowercase().contains(\"no path\"),\n            \"expected 'empty' or 'no path' in error, got: {err}\"\n        );\n    }\n\n    fn cfg_from_adapter_fixture(provider: &str, fixture_name: &str) -> (Fixture, SessionsConfig) {\n        let path = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n            .parent()\n            .and_then(std::path::Path::parent)\n            .expect(\"runtime crate should live under <repo>/crates/oulipoly-runtime\")\n            .join(\"src-tauri\")\n            .join(\"tests\")\n            .join(\"fixtures\")\n            .join(\"jsonl\")\n            .join(\"adapter\")\n            .join(fixture_name);\n        let script = fixture_script(&format!(r#\"cat \"{}\"\"#, path.display()));\n        let cfg = cfg_with(provider, &script.path);\n        (script, cfg)\n    }\n\n    // risk: is_compaction_boundary ingest plumbing; level: particular-integration; source: proposal §11.1 is_compaction_boundary ingest plumbing / A3, A6.\n    #[test]\n    fn turn_script_optional_compaction_field_defaults_false() {\n        let db = db();\n        let (_script, cfg) = cfg_from_adapter_fixture(\"claude\", \"without_compaction.jsonl\");\n\n        let result = scan_provider(\"claude\", &cfg, &db);\n\n        assert_eq!(result.errors, Vec::<String>::new());\n        assert_eq!(result.new_turns, 1);\n        assert_eq!(\n            db.latest_compaction_boundary(\"claude\", \"11111111-1111-4111-8111-111111111111\")\n                .unwrap(),\n            None\n        );\n    }\n\n    // risk: is_compaction_boundary ingest plumbing; level: particular-integration; source: proposal §11.1 is_compaction_boundary ingest plumbing / A3, A6.\n    #[test]\n    fn turn_script_compaction_field_propagates_to_session_turns() {\n        let db = db();\n        let (_script, cfg) = cfg_from_adapter_fixture(\"claude\", \"with_compaction.jsonl\");\n\n        let result = scan_provider(\"claude\", &cfg, &db);\n\n        assert_eq!(result.errors, Vec::<String>::new());\n        assert_eq!(result.new_turns, 1);\n        let boundary = db\n            .latest_compaction_boundary(\"claude\", \"11111111-1111-4111-8111-111111111111\")\n            .unwrap()\n            .expect(\"boundary turn should be persisted\");\n        assert_eq!(boundary.0, \"boundary-1\");\n    }\n}","lineStart":720,"lineEnd":1339,"totalLines":1339,"truncated":false}},"title":"crates/oulipoly-runtime/src/sessions/mod.rs","time":{"start":1780923339138,"end":1780923339212}},"metadata":{"openai":{"itemId":"fc_097c8557e2ae93fc016a26bbcb07c481998dbe9a6b60a1a180"}},"id":"prt_ea74d917c001mpJs4FpNkTyM1M","sessionID":"ses_158b3e351ffePkuQnC9kglvomy","messageID":"msg_ea74d37e80011M2BUBcvGst7Sg"}}
{"type":"tool_use","timestamp":1780923339245,"sessionID":"ses_158b3e351ffePkuQnC9kglvomy","part":{"type":"tool","tool":"read","callID":"call_xDK70IgsQYKct6sO3MwFXxDc","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-runtime/src/sessions/mod.rs","offset":1,"limit":260},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-runtime/src/sessions/mod.rs</path>\n<type>file</type>\n<content>\n1: //! CLI session log ingestion via user-provided adapter scripts.\n2: //!\n3: //! ## Declared roles\n4: //!\n5: //! `orchestration`, `accessor`, `filter`, `parser`, `validator`, `mapper`, `formatter`, `predicate`\n6: //!\n7: //! ## Intrinsic-surface declarations\n8: //!\n9: //! ```yaml\n10: //! intrinsic_surface_declarations:\n11: //!   - component: crates/oulipoly-runtime/src/sessions/mod.rs\n12: //!     role: intrinsic-surface\n13: //!     Domain: session_turn_ingest\n14: //!     Owns:\n15: //!       - adapter-script scan/ingest\n16: //!       - ScanReport.new_turns\n17: //! ```\n18: //!\n19: //! Mirrors the `quota_script` pattern in `providers.toml`: the application\n20: //! is ignorant of any specific CLI's storage format. Each provider declares\n21: //! a `turn_script` that knows how to enumerate session turns for that CLI\n22: //! and emits them as a normalized JSONL stream.\n23: //!\n24: //! Script contract:\n25: //!   - Run as `sh -c <turn_script>` with `STATE_DIR` env set to a writable dir\n26: //!     the script may use for incremental cursor bookkeeping.\n27: //!   - Stdout: one JSON object per line per turn (in any order):\n28: //!     `{\"session_id\":\"...\",\"turn_id\":\"...\",\"timestamp\":\"<ISO8601>\",\"role\":\"user\"|\"assistant\",\"parent_turn_id\":\"...\",\"is_sidechain\":true}`\n29: //!   - Empty stdout = no new turns. Non-zero exit = error.\n30: //!   - Idempotent: re-running with no source changes outputs nothing.\n31: //!\n32: //! The unified `session_turns` table stores everything across CLIs. The\n33: //! UNIQUE constraint on `(provider, session_id, turn_id)` makes ingestion\n34: //! safe even if a script over-emits (e.g. doesn't honor its cursor).\n35: \n36: use chrono::{DateTime, Utc};\n37: use oulipoly_config::{SessionSourceEntry, SessionsConfig};\n38: use oulipoly_state::{SessionTurnIngest, StateDb};\n39: use serde::Deserialize;\n40: use serde_json::Value;\n41: use std::io::Read;\n42: use std::path::PathBuf;\n43: use std::process::{Child, ChildStderr, ChildStdout, Command, ExitStatus, Stdio};\n44: use std::thread::JoinHandle;\n45: \n46: // Turn scripts run on the pre-dispatch metrics path. Ninety seconds is long\n47: // enough for slow CLI/API startup but prevents provider selection from being\n48: // wedged by a broken adapter or an unexpectedly large history scan.\n49: const SCRIPT_TIMEOUT_SECS: u64 = 90;\n50: \n51: /// A turn as emitted by an adapter script.\n52: #[derive(Debug, Clone, Deserialize, PartialEq, Eq)]\n53: pub struct ScriptTurn {\n54:     pub session_id: String,\n55:     pub turn_id: String,\n56:     pub timestamp: String,\n57:     pub role: String,\n58:     #[serde(default)]\n59:     pub parent_turn_id: Option<String>,\n60:     #[serde(default)]\n61:     pub is_sidechain: Option<bool>,\n62:     #[serde(default)]\n63:     pub is_compaction_boundary: Option<bool>,\n64:     #[serde(default)]\n65:     pub body: Option<Value>,\n66: }\n67: \n68: /// Outcome of scanning one provider's session source.\n69: #[derive(Debug, Clone, Default)]\n70: pub struct ScanReport {\n71:     pub new_turns: u64,\n72:     pub script_lines: u64,\n73:     pub errors: Vec<String>,\n74: }\n75: \n76: pub(crate) fn is_canonical_body_shape(body: &Value) -> bool {\n77:     let Value::Array(chunks) = body else {\n78:         return false;\n79:     };\n80:     chunks.iter().all(is_canonical_body_chunk)\n81: }\n82: \n83: fn is_canonical_body_chunk(chunk: &Value) -> bool {\n84:     let Value::Object(map) = chunk else {\n85:         return false;\n86:     };\n87:     map.get(\"type\").is_some_and(Value::is_string)\n88:         && map.get(\"text\").map(Value::is_string).unwrap_or(true)\n89: }\n90: \n91: /// Run the adapter script for `provider_name` and ingest every turn it emits.\n92: ///\n93: /// Failure modes (script timeout, non-zero exit, malformed JSON) are\n94: /// captured in `report.errors` rather than propagated — the balancer should\n95: /// degrade gracefully when a script is broken, not abort the request.\n96: pub fn scan_provider(\n97:     provider_name: &str,\n98:     sessions_cfg: &SessionsConfig,\n99:     db: &StateDb,\n100: ) -> ScanReport {\n101:     scan_provider_with_timeout(provider_name, sessions_cfg, db, SCRIPT_TIMEOUT_SECS)\n102: }\n103: \n104: /// Run one provider's adapter script for a specific session and ingest every\n105: /// turn it emits. The configured script receives `SESSION_ID` in its env.\n106: pub fn scan_provider_session(\n107:     provider_name: &str,\n108:     sessions_cfg: &SessionsConfig,\n109:     db: &StateDb,\n110:     session_id: &str,\n111: ) -> ScanReport {\n112:     scan_provider_session_with_timeout(\n113:         provider_name,\n114:         sessions_cfg,\n115:         db,\n116:         session_id,\n117:         SCRIPT_TIMEOUT_SECS,\n118:     )\n119: }\n120: \n121: fn scan_provider_with_timeout(\n122:     provider_name: &str,\n123:     sessions_cfg: &SessionsConfig,\n124:     db: &StateDb,\n125:     timeout_secs: u64,\n126: ) -> ScanReport {\n127:     let mut report = ScanReport::default();\n128:     let Some(entry) = provider_session_source(sessions_cfg, provider_name) else {\n129:         return report;\n130:     };\n131: \n132:     let state_dir = resolve_state_dir(provider_name, entry);\n133:     if let Err(error) = create_session_state_dir(&state_dir) {\n134:         return scan_report_with_error(report, error);\n135:     }\n136: \n137:     let stdout = match run_turn_script(&entry.turn_script, &state_dir, timeout_secs) {\n138:         Ok(stdout) => stdout,\n139:         Err(error) => return scan_report_with_error(report, error),\n140:     };\n141: \n142:     let batch = collect_turn_script_batch(provider_name, &stdout, &mut report);\n143:     persist_scanned_turns(provider_name, db, &batch, &mut report);\n144:     report\n145: }\n146: \n147: fn scan_provider_session_with_timeout(\n148:     provider_name: &str,\n149:     sessions_cfg: &SessionsConfig,\n150:     db: &StateDb,\n151:     session_id: &str,\n152:     timeout_secs: u64,\n153: ) -> ScanReport {\n154:     let mut report = ScanReport::default();\n155:     let Some(entry) = provider_session_source(sessions_cfg, provider_name) else {\n156:         return report;\n157:     };\n158: \n159:     let state_dir = resolve_state_dir(provider_name, entry);\n160:     if let Err(error) = create_session_state_dir(&state_dir) {\n161:         return scan_report_with_error(report, error);\n162:     }\n163: \n164:     let stdout = match run_session_script_with_timeout(\n165:         &entry.turn_script,\n166:         &state_dir,\n167:         Some(session_id),\n168:         \"turn script\",\n169:         timeout_secs,\n170:     ) {\n171:         Ok(stdout) => stdout,\n172:         Err(error) => return scan_report_with_error(report, error),\n173:     };\n174: \n175:     let batch = collect_turn_script_batch(provider_name, &stdout, &mut report);\n176:     persist_scanned_turns(provider_name, db, &batch, &mut report);\n177:     report\n178: }\n179: \n180: fn provider_session_source<'a>(\n181:     sessions_cfg: &'a SessionsConfig,\n182:     provider_name: &str,\n183: ) -> Option<&'a SessionSourceEntry> {\n184:     sessions_cfg.get(provider_name)\n185: }\n186: \n187: fn scan_report_with_error(mut report: ScanReport, error: String) -> ScanReport {\n188:     report.errors.push(error);\n189:     report\n190: }\n191: \n192: fn create_session_state_dir(state_dir: &std::path::Path) -> Result<(), String> {\n193:     std::fs::create_dir_all(state_dir)\n194:         .map_err(|error| format_state_dir_create_error(state_dir, error))\n195: }\n196: \n197: fn format_state_dir_create_error(state_dir: &std::path::Path, error: std::io::Error) -> String {\n198:     format!(\n199:         \"could not create state_dir {}: {error}\",\n200:         state_dir.display()\n201:     )\n202: }\n203: \n204: fn collect_turn_script_batch(\n205:     provider_name: &str,\n206:     stdout: &str,\n207:     report: &mut ScanReport,\n208: ) -> Vec<SessionTurnIngest> {\n209:     let mut batch = Vec::new();\n210:     for line in non_empty_script_lines(stdout) {\n211:         let line_number = record_script_line_seen(report);\n212:         if let Some(error) = degraded_marker_error(line) {\n213:             record_scan_error(report, error);\n214:             continue;\n215:         }\n216:         match script_line_to_ingest(provider_name, line, line_number) {\n217:             Ok(parsed) => {\n218:                 record_optional_scan_error(report, parsed.body_error);\n219:                 push_script_turn_ingest(&mut batch, parsed.ingest);\n220:             }\n221:             Err(error) => record_scan_error(report, error),\n222:         }\n223:     }\n224:     batch\n225: }\n226: \n227: fn degraded_marker_error(trimmed: &str) -> Option<String> {\n228:     let marker = parse_degraded_marker_jsonl(trimmed)?;\n229:     if !is_degraded_marker(&marker) {\n230:         return None;\n231:     }\n232:     Some(format_degraded_marker_error(degraded_marker_count(&marker)))\n233: }\n234: \n235: fn parse_degraded_marker_jsonl(trimmed: &str) -> Option<Value> {\n236:     serde_json::from_str(trimmed).ok()\n237: }\n238: \n239: fn is_degraded_marker(value: &Value) -> bool {\n240:     match value {\n241:         Value::Object(map) => map.get(\"degraded\").and_then(Value::as_bool) == Some(true),\n242:         _ => false,\n243:     }\n244: }\n245: \n246: fn degraded_marker_count(value: &Value) -> u64 {\n247:     match value {\n248:         Value::Object(map) => map.get(\"count\").and_then(Value::as_u64).unwrap_or(0),\n249:         _ => 0,\n250:     }\n251: }\n252: \n253: fn format_degraded_marker_error(count: u64) -> String {\n254:     format!(\"turn script degraded before completing scan; best_count={count}\")\n255: }\n256: \n257: fn non_empty_script_lines(stdout: &str) -> Vec<&str> {\n258:     non_empty_trimmed_lines(trimmed_script_lines(stdout))\n259: }\n260: \n\n(Showing lines 1-260 of 1339. Use offset=261 to continue.)\n</content>","metadata":{"preview":"//! CLI session log ingestion via user-provided adapter scripts.\n//!\n//! ## Declared roles\n//!\n//! `orchestration`, `accessor`, `filter`, `parser`, `validator`, `mapper`, `formatter`, `predicate`\n//!\n//! ## Intrinsic-surface declarations\n//!\n//! ```yaml\n//! intrinsic_surface_declarations:\n//!   - component: crates/oulipoly-runtime/src/sessions/mod.rs\n//!     role: intrinsic-surface\n//!     Domain: session_turn_ingest\n//!     Owns:\n//!       - adapter-script scan/ingest\n//!       - ScanReport.new_turns\n//! ```\n//!\n//! Mirrors the `quota_script` pattern in `providers.toml`: the application\n//! is ignorant of any specific CLI's storage format. Each provider declares","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-runtime/src/sessions/mod.rs","text":"//! CLI session log ingestion via user-provided adapter scripts.\n//!\n//! ## Declared roles\n//!\n//! `orchestration`, `accessor`, `filter`, `parser`, `validator`, `mapper`, `formatter`, `predicate`\n//!\n//! ## Intrinsic-surface declarations\n//!\n//! ```yaml\n//! intrinsic_surface_declarations:\n//!   - component: crates/oulipoly-runtime/src/sessions/mod.rs\n//!     role: intrinsic-surface\n//!     Domain: session_turn_ingest\n//!     Owns:\n//!       - adapter-script scan/ingest\n//!       - ScanReport.new_turns\n//! ```\n//!\n//! Mirrors the `quota_script` pattern in `providers.toml`: the application\n//! is ignorant of any specific CLI's storage format. Each provider declares\n//! a `turn_script` that knows how to enumerate session turns for that CLI\n//! and emits them as a normalized JSONL stream.\n//!\n//! Script contract:\n//!   - Run as `sh -c <turn_script>` with `STATE_DIR` env set to a writable dir\n//!     the script may use for incremental cursor bookkeeping.\n//!   - Stdout: one JSON object per line per turn (in any order):\n//!     `{\"session_id\":\"...\",\"turn_id\":\"...\",\"timestamp\":\"<ISO8601>\",\"role\":\"user\"|\"assistant\",\"parent_turn_id\":\"...\",\"is_sidechain\":true}`\n//!   - Empty stdout = no new turns. Non-zero exit = error.\n//!   - Idempotent: re-running with no source changes outputs nothing.\n//!\n//! The unified `session_turns` table stores everything across CLIs. The\n//! UNIQUE constraint on `(provider, session_id, turn_id)` makes ingestion\n//! safe even if a script over-emits (e.g. doesn't honor its cursor).\n\nuse chrono::{DateTime, Utc};\nuse oulipoly_config::{SessionSourceEntry, SessionsConfig};\nuse oulipoly_state::{SessionTurnIngest, StateDb};\nuse serde::Deserialize;\nuse serde_json::Value;\nuse std::io::Read;\nuse std::path::PathBuf;\nuse std::process::{Child, ChildStderr, ChildStdout, Command, ExitStatus, Stdio};\nuse std::thread::JoinHandle;\n\n// Turn scripts run on the pre-dispatch metrics path. Ninety seconds is long\n// enough for slow CLI/API startup but prevents provider selection from being\n// wedged by a broken adapter or an unexpectedly large history scan.\nconst SCRIPT_TIMEOUT_SECS: u64 = 90;\n\n/// A turn as emitted by an adapter script.\n#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]\npub struct ScriptTurn {\n    pub session_id: String,\n    pub turn_id: String,\n    pub timestamp: String,\n    pub role: String,\n    #[serde(default)]\n    pub parent_turn_id: Option<String>,\n    #[serde(default)]\n    pub is_sidechain: Option<bool>,\n    #[serde(default)]\n    pub is_compaction_boundary: Option<bool>,\n    #[serde(default)]\n    pub body: Option<Value>,\n}\n\n/// Outcome of scanning one provider's session source.\n#[derive(Debug, Clone, Default)]\npub struct ScanReport {\n    pub new_turns: u64,\n    pub script_lines: u64,\n    pub errors: Vec<String>,\n}\n\npub(crate) fn is_canonical_body_shape(body: &Value) -> bool {\n    let Value::Array(chunks) = body else {\n        return false;\n    };\n    chunks.iter().all(is_canonical_body_chunk)\n}\n\nfn is_canonical_body_chunk(chunk: &Value) -> bool {\n    let Value::Object(map) = chunk else {\n        return false;\n    };\n    map.get(\"type\").is_some_and(Value::is_string)\n        && map.get(\"text\").map(Value::is_string).unwrap_or(true)\n}\n\n/// Run the adapter script for `provider_name` and ingest every turn it emits.\n///\n/// Failure modes (script timeout, non-zero exit, malformed JSON) are\n/// captured in `report.errors` rather than propagated — the balancer should\n/// degrade gracefully when a script is broken, not abort the request.\npub fn scan_provider(\n    provider_name: &str,\n    sessions_cfg: &SessionsConfig,\n    db: &StateDb,\n) -> ScanReport {\n    scan_provider_with_timeout(provider_name, sessions_cfg, db, SCRIPT_TIMEOUT_SECS)\n}\n\n/// Run one provider's adapter script for a specific session and ingest every\n/// turn it emits. The configured script receives `SESSION_ID` in its env.\npub fn scan_provider_session(\n    provider_name: &str,\n    sessions_cfg: &SessionsConfig,\n    db: &StateDb,\n    session_id: &str,\n) -> ScanReport {\n    scan_provider_session_with_timeout(\n        provider_name,\n        sessions_cfg,\n        db,\n        session_id,\n        SCRIPT_TIMEOUT_SECS,\n    )\n}\n\nfn scan_provider_with_timeout(\n    provider_name: &str,\n    sessions_cfg: &SessionsConfig,\n    db: &StateDb,\n    timeout_secs: u64,\n) -> ScanReport {\n    let mut report = ScanReport::default();\n    let Some(entry) = provider_session_source(sessions_cfg, provider_name) else {\n        return report;\n    };\n\n    let state_dir = resolve_state_dir(provider_name, entry);\n    if let Err(error) = create_session_state_dir(&state_dir) {\n        return scan_report_with_error(report, error);\n    }\n\n    let stdout = match run_turn_script(&entry.turn_script, &state_dir, timeout_secs) {\n        Ok(stdout) => stdout,\n        Err(error) => return scan_report_with_error(report, error),\n    };\n\n    let batch = collect_turn_script_batch(provider_name, &stdout, &mut report);\n    persist_scanned_turns(provider_name, db, &batch, &mut report);\n    report\n}\n\nfn scan_provider_session_with_timeout(\n    provider_name: &str,\n    sessions_cfg: &SessionsConfig,\n    db: &StateDb,\n    session_id: &str,\n    timeout_secs: u64,\n) -> ScanReport {\n    let mut report = ScanReport::default();\n    let Some(entry) = provider_session_source(sessions_cfg, provider_name) else {\n        return report;\n    };\n\n    let state_dir = resolve_state_dir(provider_name, entry);\n    if let Err(error) = create_session_state_dir(&state_dir) {\n        return scan_report_with_error(report, error);\n    }\n\n    let stdout = match run_session_script_with_timeout(\n        &entry.turn_script,\n        &state_dir,\n        Some(session_id),\n        \"turn script\",\n        timeout_secs,\n    ) {\n        Ok(stdout) => stdout,\n        Err(error) => return scan_report_with_error(report, error),\n    };\n\n    let batch = collect_turn_script_batch(provider_name, &stdout, &mut report);\n    persist_scanned_turns(provider_name, db, &batch, &mut report);\n    report\n}\n\nfn provider_session_source<'a>(\n    sessions_cfg: &'a SessionsConfig,\n    provider_name: &str,\n) -> Option<&'a SessionSourceEntry> {\n    sessions_cfg.get(provider_name)\n}\n\nfn scan_report_with_error(mut report: ScanReport, error: String) -> ScanReport {\n    report.errors.push(error);\n    report\n}\n\nfn create_session_state_dir(state_dir: &std::path::Path) -> Result<(), String> {\n    std::fs::create_dir_all(state_dir)\n        .map_err(|error| format_state_dir_create_error(state_dir, error))\n}\n\nfn format_state_dir_create_error(state_dir: &std::path::Path, error: std::io::Error) -> String {\n    format!(\n        \"could not create state_dir {}: {error}\",\n        state_dir.display()\n    )\n}\n\nfn collect_turn_script_batch(\n    provider_name: &str,\n    stdout: &str,\n    report: &mut ScanReport,\n) -> Vec<SessionTurnIngest> {\n    let mut batch = Vec::new();\n    for line in non_empty_script_lines(stdout) {\n        let line_number = record_script_line_seen(report);\n        if let Some(error) = degraded_marker_error(line) {\n            record_scan_error(report, error);\n            continue;\n        }\n        match script_line_to_ingest(provider_name, line, line_number) {\n            Ok(parsed) => {\n                record_optional_scan_error(report, parsed.body_error);\n                push_script_turn_ingest(&mut batch, parsed.ingest);\n            }\n            Err(error) => record_scan_error(report, error),\n        }\n    }\n    batch\n}\n\nfn degraded_marker_error(trimmed: &str) -> Option<String> {\n    let marker = parse_degraded_marker_jsonl(trimmed)?;\n    if !is_degraded_marker(&marker) {\n        return None;\n    }\n    Some(format_degraded_marker_error(degraded_marker_count(&marker)))\n}\n\nfn parse_degraded_marker_jsonl(trimmed: &str) -> Option<Value> {\n    serde_json::from_str(trimmed).ok()\n}\n\nfn is_degraded_marker(value: &Value) -> bool {\n    match value {\n        Value::Object(map) => map.get(\"degraded\").and_then(Value::as_bool) == Some(true),\n        _ => false,\n    }\n}\n\nfn degraded_marker_count(value: &Value) -> u64 {\n    match value {\n        Value::Object(map) => map.get(\"count\").and_then(Value::as_u64).unwrap_or(0),\n        _ => 0,\n    }\n}\n\nfn format_degraded_marker_error(count: u64) -> String {\n    format!(\"turn script degraded before completing scan; best_count={count}\")\n}\n\nfn non_empty_script_lines(stdout: &str) -> Vec<&str> {\n    non_empty_trimmed_lines(trimmed_script_lines(stdout))\n}\n","lineStart":1,"lineEnd":260,"totalLines":1339,"truncated":true}},"title":"crates/oulipoly-runtime/src/sessions/mod.rs","time":{"start":1780923339130,"end":1780923339219}},"metadata":{"openai":{"itemId":"fc_097c8557e2ae93fc016a26bbcb07b08199b6fdf95a9998bb75"}},"id":"prt_ea74d914b0011NofaHblROuflb","sessionID":"ses_158b3e351ffePkuQnC9kglvomy","messageID":"msg_ea74d37e80011M2BUBcvGst7Sg"}}
