{"type":"tool_use","timestamp":1780923316066,"sessionID":"ses_158b3e351ffePkuQnC9kglvomy","part":{"type":"tool","tool":"read","callID":"call_lFU8Ul0PP22Q79DG6OKTu23b","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/mailbox_delivery.rs","offset":1,"limit":900},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/mailbox_delivery.rs</path>\n<type>file</type>\n<content>\n1: //! ## Declared roles\n2: //!\n3: //! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `predicate`\n4: \n5: use oulipoly_state::mailbox::{\n6:     MailboxDb, MailboxRow, SessionRuntimeUpsert, WAKE_SWEEP_ABANDONED_ERROR,\n7: };\n8: use std::path::Path;\n9: use uuid::Uuid;\n10: \n11: const MAILBOX_BATCH_MAX_ROWS: usize = 20;\n12: const MAILBOX_PREFIX_MAX_BYTES: usize = 64 * 1024;\n13: const MAILBOX_DELIVERY_UNCONFIRMED: &str = \"mailbox_delivery_unconfirmed\";\n14: const MAX_UNCONFIRMED_DELIVERY_ATTEMPTS: i64 = 2;\n15: const DELIVERY_NONCE_PREFIX: &str = \"[OULIPOLY-DELIVERY \";\n16: const DELIVERY_NONCE_SUFFIX: &str = \"]\";\n17: const DELIVERY_NONCE_LENGTH_PLACEHOLDER: &str = \"00000000-0000-4000-8000-000000000000\";\n18: \n19: pub(crate) struct PreparedMailboxDelivery {\n20:     pub answer: Option<String>,\n21:     pub session_id: String,\n22:     pub seqs: Vec<i64>,\n23:     pub delivery_nonce: Option<String>,\n24: }\n25: \n26: pub(crate) struct PreparedPtyMailboxDelivery {\n27:     pub envelope: String,\n28:     pub seqs: Vec<i64>,\n29: }\n30: \n31: pub(crate) fn prepare_pty_mailbox_delivery(\n32:     db: &MailboxDb,\n33:     session_id: &str,\n34: ) -> Result<Option<PreparedPtyMailboxDelivery>, String> {\n35:     let pending = pending_mailbox_rows(db, session_id)?;\n36:     if !has_pending_rows(&pending) {\n37:         return Ok(None);\n38:     }\n39:     let batch = select_batch(&pending);\n40:     let seqs = batch_seqs(&batch);\n41:     let envelope =\n42:         render_notification_prefix(&batch.rows, batch.remaining_count, &new_delivery_nonce());\n43:     Ok(Some(PreparedPtyMailboxDelivery { envelope, seqs }))\n44: }\n45: \n46: pub(crate) fn mailbox_prefix_max_bytes() -> usize {\n47:     MAILBOX_PREFIX_MAX_BYTES\n48: }\n49: \n50: pub(crate) fn prepare_headless_resume_delivery(\n51:     resolved: &oulipoly_state::ResolvedResume,\n52:     answer: Option<String>,\n53:     models_dir: Option<&Path>,\n54: ) -> Result<PreparedMailboxDelivery, String> {\n55:     let session_id = delivery_session_id(resolved);\n56:     let Some(mut db) = open_mailbox_sidecar()? else {\n57:         return Ok(empty_delivery(answer, session_id));\n58:     };\n59:     record_headless_session_runtime(&mut db, resolved, models_dir)?;\n60:     let pending = pending_mailbox_rows(&db, &session_id)?;\n61:     Ok(delivery_for_pending(session_id, pending, answer))\n62: }\n63: \n64: pub(crate) fn deliverable_pending_count(session_id: &str) -> Result<usize, String> {\n65:     let Some(db) = open_mailbox_sidecar()? else {\n66:         return Ok(0);\n67:     };\n68:     pending_mailbox_rows(&db, session_id).map(|rows| rows.len())\n69: }\n70: \n71: fn delivery_session_id(resolved: &oulipoly_state::ResolvedResume) -> String {\n72:     resolved.active_session_id.clone()\n73: }\n74: \n75: fn pending_mailbox_rows(db: &MailboxDb, session_id: &str) -> Result<Vec<MailboxRow>, String> {\n76:     db.list_pending(session_id).map(deliverable_pending_rows)\n77: }\n78: \n79: fn deliverable_pending_rows(rows: Vec<MailboxRow>) -> Vec<MailboxRow> {\n80:     rows.into_iter()\n81:         .filter(mailbox_row_is_deliverable_pending)\n82:         .collect()\n83: }\n84: \n85: fn mailbox_row_is_deliverable_pending(row: &MailboxRow) -> bool {\n86:     row.delivery_error.as_deref() != Some(WAKE_SWEEP_ABANDONED_ERROR)\n87:         && (row.delivery_error.as_deref() != Some(MAILBOX_DELIVERY_UNCONFIRMED)\n88:             || row.delivery_attempts < MAX_UNCONFIRMED_DELIVERY_ATTEMPTS)\n89: }\n90: \n91: fn delivery_for_pending(\n92:     session_id: String,\n93:     pending: Vec<MailboxRow>,\n94:     answer: Option<String>,\n95: ) -> PreparedMailboxDelivery {\n96:     if !has_pending_rows(&pending) {\n97:         return empty_delivery(answer, session_id);\n98:     }\n99: \n100:     let batch = select_batch(&pending);\n101:     delivery_for_batch(session_id, batch, answer)\n102: }\n103: \n104: fn open_mailbox_sidecar() -> Result<Option<MailboxDb>, String> {\n105:     MailboxDb::open_default_if_exists()\n106: }\n107: \n108: fn empty_delivery(answer: Option<String>, session_id: String) -> PreparedMailboxDelivery {\n109:     PreparedMailboxDelivery {\n110:         answer,\n111:         session_id,\n112:         seqs: Vec::new(),\n113:         delivery_nonce: None,\n114:     }\n115: }\n116: \n117: fn has_pending_rows(rows: &[MailboxRow]) -> bool {\n118:     !rows.is_empty()\n119: }\n120: \n121: fn batch_seqs(batch: &MailboxBatch) -> Vec<i64> {\n122:     batch.rows.iter().map(|row| row.seq).collect()\n123: }\n124: \n125: fn delivery_for_batch(\n126:     session_id: String,\n127:     batch: MailboxBatch,\n128:     answer: Option<String>,\n129: ) -> PreparedMailboxDelivery {\n130:     let seqs = batch_seqs(&batch);\n131:     let delivery_nonce = new_delivery_nonce();\n132:     let prefix = render_notification_prefix(&batch.rows, batch.remaining_count, &delivery_nonce);\n133:     prepared_delivery(session_id, seqs, prefix, answer, delivery_nonce)\n134: }\n135: \n136: fn prepared_delivery(\n137:     session_id: String,\n138:     seqs: Vec<i64>,\n139:     prefix: String,\n140:     answer: Option<String>,\n141:     delivery_nonce: String,\n142: ) -> PreparedMailboxDelivery {\n143:     PreparedMailboxDelivery {\n144:         answer: Some(compose_answer(prefix, answer)),\n145:         session_id,\n146:         seqs,\n147:         delivery_nonce: Some(delivery_nonce),\n148:     }\n149: }\n150: \n151: pub(crate) fn mark_headless_resume_delivered(\n152:     session_id: &str,\n153:     seqs: &[i64],\n154:     delivered_by_invocation_uuid: &str,\n155: ) -> Result<(), String> {\n156:     if seqs.is_empty() {\n157:         return Ok(());\n158:     }\n159:     let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n160:         return Err(\"mailbox sidecar missing while marking delivered rows\".to_string());\n161:     };\n162:     db.mark_delivered(session_id, seqs, delivered_by_invocation_uuid)\n163: }\n164: \n165: pub(crate) fn mark_headless_resume_delivery_failed(\n166:     session_id: &str,\n167:     seqs: &[i64],\n168:     delivery_error: &str,\n169: ) -> Result<(), String> {\n170:     if seqs.is_empty() {\n171:         return Ok(());\n172:     }\n173:     let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n174:         return Err(\"mailbox sidecar missing while marking failed delivery rows\".to_string());\n175:     };\n176:     db.mark_delivery_failed(session_id, seqs, delivery_error)\n177: }\n178: \n179: struct MailboxBatch {\n180:     rows: Vec<MailboxRow>,\n181:     remaining_count: usize,\n182: }\n183: \n184: fn record_headless_session_runtime(\n185:     db: &mut MailboxDb,\n186:     resolved: &oulipoly_state::ResolvedResume,\n187:     models_dir: Option<&Path>,\n188: ) -> Result<(), String> {\n189:     let models_dir = models_dir_string(models_dir);\n190:     let input = headless_session_runtime_upsert(resolved, models_dir.as_deref());\n191:     db.upsert_session_runtime(input)\n192: }\n193: \n194: fn headless_session_runtime_upsert<'a>(\n195:     resolved: &'a oulipoly_state::ResolvedResume,\n196:     models_dir: Option<&'a str>,\n197: ) -> SessionRuntimeUpsert<'a> {\n198:     SessionRuntimeUpsert {\n199:         session_id: &resolved.active_session_id,\n200:         mode: \"headless\",\n201:         invocation_uuid: None,\n202:         provider_name: Some(&resolved.active_provider),\n203:         model_name: resolved.model_name.as_deref(),\n204:         pty_control_path: None,\n205:         models_dir,\n206:         effective_cwd: None,\n207:     }\n208: }\n209: \n210: fn models_dir_string(path: Option<&Path>) -> Option<String> {\n211:     path.map(|path| path.to_string_lossy().into_owned())\n212: }\n213: \n214: fn select_batch(pending: &[MailboxRow]) -> MailboxBatch {\n215:     let prefix_lengths = candidate_prefix_lengths(pending);\n216:     select_batch_by_prefix_lengths(pending, &prefix_lengths)\n217: }\n218: \n219: fn candidate_prefix_lengths(pending: &[MailboxRow]) -> Vec<usize> {\n220:     (1..=candidate_count(pending))\n221:         .map(|row_count| candidate_prefix_len(pending, row_count))\n222:         .collect()\n223: }\n224: \n225: fn candidate_count(pending: &[MailboxRow]) -> usize {\n226:     pending.len().min(MAILBOX_BATCH_MAX_ROWS)\n227: }\n228: \n229: fn candidate_prefix_len(pending: &[MailboxRow], row_count: usize) -> usize {\n230:     let remaining_count = pending.len().saturating_sub(row_count);\n231:     notification_prefix_len(&pending[..row_count], remaining_count)\n232: }\n233: \n234: fn select_batch_by_prefix_lengths(\n235:     pending: &[MailboxRow],\n236:     prefix_lengths: &[usize],\n237: ) -> MailboxBatch {\n238:     let selected_count = selected_batch_len(pending, prefix_lengths);\n239:     let rows = pending\n240:         .iter()\n241:         .take(selected_count)\n242:         .cloned()\n243:         .collect::<Vec<_>>();\n244:     MailboxBatch {\n245:         remaining_count: pending.len().saturating_sub(rows.len()),\n246:         rows,\n247:     }\n248: }\n249: \n250: fn selected_batch_len(pending: &[MailboxRow], prefix_lengths: &[usize]) -> usize {\n251:     if pending.is_empty() {\n252:         return 0;\n253:     }\n254:     prefix_lengths\n255:         .iter()\n256:         .position(|length| *length > MAILBOX_PREFIX_MAX_BYTES)\n257:         .map(|index| selected_len_before_limit(index + 1))\n258:         .unwrap_or(prefix_lengths.len())\n259: }\n260: \n261: fn selected_len_before_limit(row_count: usize) -> usize {\n262:     if row_count > 1 { row_count - 1 } else { 1 }\n263: }\n264: \n265: fn notification_prefix_len(rows: &[MailboxRow], remaining_count: usize) -> usize {\n266:     render_notification_prefix(rows, remaining_count, DELIVERY_NONCE_LENGTH_PLACEHOLDER).len()\n267: }\n268: \n269: fn render_notification_prefix(\n270:     rows: &[MailboxRow],\n271:     remaining_count: usize,\n272:     delivery_nonce: &str,\n273: ) -> String {\n274:     let mut rendered = String::new();\n275:     rendered.push_str(\"[OULIPOLY NOTIFICATIONS]\\n\");\n276:     rendered.push_str(\n277:         \"The following background agent-bash workloads completed while this session was inactive.\\n\\n\",\n278:     );\n279:     for (index, row) in rows.iter().enumerate() {\n280:         rendered.push_str(&format!(\n281:             \"{}. kind: {}\\n   handle: {}\\n   rc: {}\\n   state_dir: {}\\n   meta: {}\\n   log: {}\\n   rc_file: {}\\n\\n\",\n282:             index + 1,\n283:             sanitize(&row.kind),\n284:             sanitize(&row.handle),\n285:             row.rc,\n286:             quote_path(&row.state_dir),\n287:             quote_path(&row.meta_path),\n288:             quote_path(&row.log_path),\n289:             quote_path(&row.rc_path),\n290:         ));\n291:     }\n292:     if remaining_count > 0 {\n293:         rendered.push_str(&format!(\n294:             \"{remaining_count} additional notification(s) remain queued for the next resume.\\n\\n\"\n295:         ));\n296:     }\n297:     rendered.push_str(\"Use the paths above if you need details. Do not assume log content unless you inspect it.\\n\");\n298:     rendered.push_str(DELIVERY_NONCE_PREFIX);\n299:     rendered.push_str(delivery_nonce);\n300:     rendered.push_str(DELIVERY_NONCE_SUFFIX);\n301:     rendered.push('\\n');\n302:     rendered.push_str(\"[END OULIPOLY NOTIFICATIONS]\");\n303:     rendered\n304: }\n305: \n306: fn new_delivery_nonce() -> String {\n307:     Uuid::new_v4().to_string()\n308: }\n309: \n310: fn compose_answer(prefix: String, answer: Option<String>) -> String {\n311:     match answer {\n312:         Some(answer) => format!(\"{prefix}\\n\\n[USER RESUME PAYLOAD]\\n{answer}\"),\n313:         None => prefix,\n314:     }\n315: }\n316: \n317: fn quote_path(path: &str) -> String {\n318:     format!(\"\\\"{}\\\"\", sanitize(path))\n319: }\n320: \n321: fn sanitize(value: &str) -> String {\n322:     value.replace('\\\\', \"\\\\\\\\\").replace('\\n', \"\\\\n\")\n323: }\n324: \n325: #[cfg(test)]\n326: mod tests {\n327:     use super::*;\n328: \n329:     #[test]\n330:     fn compose_without_pending_preserves_answer_by_caller_contract() {\n331:         let original = Some(\"byte-identical\".to_string());\n332:         let session_id = \"5169694d-de0f-40d1-890c-6e28e55bab27\".to_string();\n333:         let prepared = PreparedMailboxDelivery {\n334:             answer: original.clone(),\n335:             session_id,\n336:             seqs: Vec::new(),\n337:             delivery_nonce: None,\n338:         };\n339: \n340:         assert_eq!(prepared.answer, original);\n341:     }\n342: \n343:     #[test]\n344:     fn notification_prefix_includes_delivery_nonce_near_end() {\n345:         let prefix = render_notification_prefix(&[], 0, \"nonce-123\");\n346: \n347:         assert!(\n348:             prefix.contains(\"[OULIPOLY-DELIVERY nonce-123]\\n[END OULIPOLY NOTIFICATIONS]\"),\n349:             \"{prefix}\"\n350:         );\n351:     }\n352: }\n\n(End of file - total 352 lines)\n</content>","metadata":{"preview":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `predicate`\n\nuse oulipoly_state::mailbox::{\n    MailboxDb, MailboxRow, SessionRuntimeUpsert, WAKE_SWEEP_ABANDONED_ERROR,\n};\nuse std::path::Path;\nuse uuid::Uuid;\n\nconst MAILBOX_BATCH_MAX_ROWS: usize = 20;\nconst MAILBOX_PREFIX_MAX_BYTES: usize = 64 * 1024;\nconst MAILBOX_DELIVERY_UNCONFIRMED: &str = \"mailbox_delivery_unconfirmed\";\nconst MAX_UNCONFIRMED_DELIVERY_ATTEMPTS: i64 = 2;\nconst DELIVERY_NONCE_PREFIX: &str = \"[OULIPOLY-DELIVERY \";\nconst DELIVERY_NONCE_SUFFIX: &str = \"]\";\nconst DELIVERY_NONCE_LENGTH_PLACEHOLDER: &str = \"00000000-0000-4000-8000-000000000000\";\n\npub(crate) struct PreparedMailboxDelivery {\n    pub answer: Option<String>,","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/mailbox_delivery.rs","text":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `predicate`\n\nuse oulipoly_state::mailbox::{\n    MailboxDb, MailboxRow, SessionRuntimeUpsert, WAKE_SWEEP_ABANDONED_ERROR,\n};\nuse std::path::Path;\nuse uuid::Uuid;\n\nconst MAILBOX_BATCH_MAX_ROWS: usize = 20;\nconst MAILBOX_PREFIX_MAX_BYTES: usize = 64 * 1024;\nconst MAILBOX_DELIVERY_UNCONFIRMED: &str = \"mailbox_delivery_unconfirmed\";\nconst MAX_UNCONFIRMED_DELIVERY_ATTEMPTS: i64 = 2;\nconst DELIVERY_NONCE_PREFIX: &str = \"[OULIPOLY-DELIVERY \";\nconst DELIVERY_NONCE_SUFFIX: &str = \"]\";\nconst DELIVERY_NONCE_LENGTH_PLACEHOLDER: &str = \"00000000-0000-4000-8000-000000000000\";\n\npub(crate) struct PreparedMailboxDelivery {\n    pub answer: Option<String>,\n    pub session_id: String,\n    pub seqs: Vec<i64>,\n    pub delivery_nonce: Option<String>,\n}\n\npub(crate) struct PreparedPtyMailboxDelivery {\n    pub envelope: String,\n    pub seqs: Vec<i64>,\n}\n\npub(crate) fn prepare_pty_mailbox_delivery(\n    db: &MailboxDb,\n    session_id: &str,\n) -> Result<Option<PreparedPtyMailboxDelivery>, String> {\n    let pending = pending_mailbox_rows(db, session_id)?;\n    if !has_pending_rows(&pending) {\n        return Ok(None);\n    }\n    let batch = select_batch(&pending);\n    let seqs = batch_seqs(&batch);\n    let envelope =\n        render_notification_prefix(&batch.rows, batch.remaining_count, &new_delivery_nonce());\n    Ok(Some(PreparedPtyMailboxDelivery { envelope, seqs }))\n}\n\npub(crate) fn mailbox_prefix_max_bytes() -> usize {\n    MAILBOX_PREFIX_MAX_BYTES\n}\n\npub(crate) fn prepare_headless_resume_delivery(\n    resolved: &oulipoly_state::ResolvedResume,\n    answer: Option<String>,\n    models_dir: Option<&Path>,\n) -> Result<PreparedMailboxDelivery, String> {\n    let session_id = delivery_session_id(resolved);\n    let Some(mut db) = open_mailbox_sidecar()? else {\n        return Ok(empty_delivery(answer, session_id));\n    };\n    record_headless_session_runtime(&mut db, resolved, models_dir)?;\n    let pending = pending_mailbox_rows(&db, &session_id)?;\n    Ok(delivery_for_pending(session_id, pending, answer))\n}\n\npub(crate) fn deliverable_pending_count(session_id: &str) -> Result<usize, String> {\n    let Some(db) = open_mailbox_sidecar()? else {\n        return Ok(0);\n    };\n    pending_mailbox_rows(&db, session_id).map(|rows| rows.len())\n}\n\nfn delivery_session_id(resolved: &oulipoly_state::ResolvedResume) -> String {\n    resolved.active_session_id.clone()\n}\n\nfn pending_mailbox_rows(db: &MailboxDb, session_id: &str) -> Result<Vec<MailboxRow>, String> {\n    db.list_pending(session_id).map(deliverable_pending_rows)\n}\n\nfn deliverable_pending_rows(rows: Vec<MailboxRow>) -> Vec<MailboxRow> {\n    rows.into_iter()\n        .filter(mailbox_row_is_deliverable_pending)\n        .collect()\n}\n\nfn mailbox_row_is_deliverable_pending(row: &MailboxRow) -> bool {\n    row.delivery_error.as_deref() != Some(WAKE_SWEEP_ABANDONED_ERROR)\n        && (row.delivery_error.as_deref() != Some(MAILBOX_DELIVERY_UNCONFIRMED)\n            || row.delivery_attempts < MAX_UNCONFIRMED_DELIVERY_ATTEMPTS)\n}\n\nfn delivery_for_pending(\n    session_id: String,\n    pending: Vec<MailboxRow>,\n    answer: Option<String>,\n) -> PreparedMailboxDelivery {\n    if !has_pending_rows(&pending) {\n        return empty_delivery(answer, session_id);\n    }\n\n    let batch = select_batch(&pending);\n    delivery_for_batch(session_id, batch, answer)\n}\n\nfn open_mailbox_sidecar() -> Result<Option<MailboxDb>, String> {\n    MailboxDb::open_default_if_exists()\n}\n\nfn empty_delivery(answer: Option<String>, session_id: String) -> PreparedMailboxDelivery {\n    PreparedMailboxDelivery {\n        answer,\n        session_id,\n        seqs: Vec::new(),\n        delivery_nonce: None,\n    }\n}\n\nfn has_pending_rows(rows: &[MailboxRow]) -> bool {\n    !rows.is_empty()\n}\n\nfn batch_seqs(batch: &MailboxBatch) -> Vec<i64> {\n    batch.rows.iter().map(|row| row.seq).collect()\n}\n\nfn delivery_for_batch(\n    session_id: String,\n    batch: MailboxBatch,\n    answer: Option<String>,\n) -> PreparedMailboxDelivery {\n    let seqs = batch_seqs(&batch);\n    let delivery_nonce = new_delivery_nonce();\n    let prefix = render_notification_prefix(&batch.rows, batch.remaining_count, &delivery_nonce);\n    prepared_delivery(session_id, seqs, prefix, answer, delivery_nonce)\n}\n\nfn prepared_delivery(\n    session_id: String,\n    seqs: Vec<i64>,\n    prefix: String,\n    answer: Option<String>,\n    delivery_nonce: String,\n) -> PreparedMailboxDelivery {\n    PreparedMailboxDelivery {\n        answer: Some(compose_answer(prefix, answer)),\n        session_id,\n        seqs,\n        delivery_nonce: Some(delivery_nonce),\n    }\n}\n\npub(crate) fn mark_headless_resume_delivered(\n    session_id: &str,\n    seqs: &[i64],\n    delivered_by_invocation_uuid: &str,\n) -> Result<(), String> {\n    if seqs.is_empty() {\n        return Ok(());\n    }\n    let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n        return Err(\"mailbox sidecar missing while marking delivered rows\".to_string());\n    };\n    db.mark_delivered(session_id, seqs, delivered_by_invocation_uuid)\n}\n\npub(crate) fn mark_headless_resume_delivery_failed(\n    session_id: &str,\n    seqs: &[i64],\n    delivery_error: &str,\n) -> Result<(), String> {\n    if seqs.is_empty() {\n        return Ok(());\n    }\n    let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n        return Err(\"mailbox sidecar missing while marking failed delivery rows\".to_string());\n    };\n    db.mark_delivery_failed(session_id, seqs, delivery_error)\n}\n\nstruct MailboxBatch {\n    rows: Vec<MailboxRow>,\n    remaining_count: usize,\n}\n\nfn record_headless_session_runtime(\n    db: &mut MailboxDb,\n    resolved: &oulipoly_state::ResolvedResume,\n    models_dir: Option<&Path>,\n) -> Result<(), String> {\n    let models_dir = models_dir_string(models_dir);\n    let input = headless_session_runtime_upsert(resolved, models_dir.as_deref());\n    db.upsert_session_runtime(input)\n}\n\nfn headless_session_runtime_upsert<'a>(\n    resolved: &'a oulipoly_state::ResolvedResume,\n    models_dir: Option<&'a str>,\n) -> SessionRuntimeUpsert<'a> {\n    SessionRuntimeUpsert {\n        session_id: &resolved.active_session_id,\n        mode: \"headless\",\n        invocation_uuid: None,\n        provider_name: Some(&resolved.active_provider),\n        model_name: resolved.model_name.as_deref(),\n        pty_control_path: None,\n        models_dir,\n        effective_cwd: None,\n    }\n}\n\nfn models_dir_string(path: Option<&Path>) -> Option<String> {\n    path.map(|path| path.to_string_lossy().into_owned())\n}\n\nfn select_batch(pending: &[MailboxRow]) -> MailboxBatch {\n    let prefix_lengths = candidate_prefix_lengths(pending);\n    select_batch_by_prefix_lengths(pending, &prefix_lengths)\n}\n\nfn candidate_prefix_lengths(pending: &[MailboxRow]) -> Vec<usize> {\n    (1..=candidate_count(pending))\n        .map(|row_count| candidate_prefix_len(pending, row_count))\n        .collect()\n}\n\nfn candidate_count(pending: &[MailboxRow]) -> usize {\n    pending.len().min(MAILBOX_BATCH_MAX_ROWS)\n}\n\nfn candidate_prefix_len(pending: &[MailboxRow], row_count: usize) -> usize {\n    let remaining_count = pending.len().saturating_sub(row_count);\n    notification_prefix_len(&pending[..row_count], remaining_count)\n}\n\nfn select_batch_by_prefix_lengths(\n    pending: &[MailboxRow],\n    prefix_lengths: &[usize],\n) -> MailboxBatch {\n    let selected_count = selected_batch_len(pending, prefix_lengths);\n    let rows = pending\n        .iter()\n        .take(selected_count)\n        .cloned()\n        .collect::<Vec<_>>();\n    MailboxBatch {\n        remaining_count: pending.len().saturating_sub(rows.len()),\n        rows,\n    }\n}\n\nfn selected_batch_len(pending: &[MailboxRow], prefix_lengths: &[usize]) -> usize {\n    if pending.is_empty() {\n        return 0;\n    }\n    prefix_lengths\n        .iter()\n        .position(|length| *length > MAILBOX_PREFIX_MAX_BYTES)\n        .map(|index| selected_len_before_limit(index + 1))\n        .unwrap_or(prefix_lengths.len())\n}\n\nfn selected_len_before_limit(row_count: usize) -> usize {\n    if row_count > 1 { row_count - 1 } else { 1 }\n}\n\nfn notification_prefix_len(rows: &[MailboxRow], remaining_count: usize) -> usize {\n    render_notification_prefix(rows, remaining_count, DELIVERY_NONCE_LENGTH_PLACEHOLDER).len()\n}\n\nfn render_notification_prefix(\n    rows: &[MailboxRow],\n    remaining_count: usize,\n    delivery_nonce: &str,\n) -> String {\n    let mut rendered = String::new();\n    rendered.push_str(\"[OULIPOLY NOTIFICATIONS]\\n\");\n    rendered.push_str(\n        \"The following background agent-bash workloads completed while this session was inactive.\\n\\n\",\n    );\n    for (index, row) in rows.iter().enumerate() {\n        rendered.push_str(&format!(\n            \"{}. kind: {}\\n   handle: {}\\n   rc: {}\\n   state_dir: {}\\n   meta: {}\\n   log: {}\\n   rc_file: {}\\n\\n\",\n            index + 1,\n            sanitize(&row.kind),\n            sanitize(&row.handle),\n            row.rc,\n            quote_path(&row.state_dir),\n            quote_path(&row.meta_path),\n            quote_path(&row.log_path),\n            quote_path(&row.rc_path),\n        ));\n    }\n    if remaining_count > 0 {\n        rendered.push_str(&format!(\n            \"{remaining_count} additional notification(s) remain queued for the next resume.\\n\\n\"\n        ));\n    }\n    rendered.push_str(\"Use the paths above if you need details. Do not assume log content unless you inspect it.\\n\");\n    rendered.push_str(DELIVERY_NONCE_PREFIX);\n    rendered.push_str(delivery_nonce);\n    rendered.push_str(DELIVERY_NONCE_SUFFIX);\n    rendered.push('\\n');\n    rendered.push_str(\"[END OULIPOLY NOTIFICATIONS]\");\n    rendered\n}\n\nfn new_delivery_nonce() -> String {\n    Uuid::new_v4().to_string()\n}\n\nfn compose_answer(prefix: String, answer: Option<String>) -> String {\n    match answer {\n        Some(answer) => format!(\"{prefix}\\n\\n[USER RESUME PAYLOAD]\\n{answer}\"),\n        None => prefix,\n    }\n}\n\nfn quote_path(path: &str) -> String {\n    format!(\"\\\"{}\\\"\", sanitize(path))\n}\n\nfn sanitize(value: &str) -> String {\n    value.replace('\\\\', \"\\\\\\\\\").replace('\\n', \"\\\\n\")\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn compose_without_pending_preserves_answer_by_caller_contract() {\n        let original = Some(\"byte-identical\".to_string());\n        let session_id = \"5169694d-de0f-40d1-890c-6e28e55bab27\".to_string();\n        let prepared = PreparedMailboxDelivery {\n            answer: original.clone(),\n            session_id,\n            seqs: Vec::new(),\n            delivery_nonce: None,\n        };\n\n        assert_eq!(prepared.answer, original);\n    }\n\n    #[test]\n    fn notification_prefix_includes_delivery_nonce_near_end() {\n        let prefix = render_notification_prefix(&[], 0, \"nonce-123\");\n\n        assert!(\n            prefix.contains(\"[OULIPOLY-DELIVERY nonce-123]\\n[END OULIPOLY NOTIFICATIONS]\"),\n            \"{prefix}\"\n        );\n    }\n}","lineStart":1,"lineEnd":352,"totalLines":352,"truncated":false}},"title":"src-tauri/src/mailbox_delivery.rs","time":{"start":1780923316017,"end":1780923316057}},"metadata":{"openai":{"itemId":"fc_0676cb86304500e2016a26bbb3f0248198a9ddd87fbd9653d9"}},"i