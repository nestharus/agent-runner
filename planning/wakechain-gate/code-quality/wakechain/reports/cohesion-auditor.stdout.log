  pub invocation_uuid: &'a str,\n98:     pub last_exit_code: Option<i32>,\n99: }\n100: \n101: #[derive(Debug, Clone, PartialEq, Eq)]\n102: pub struct SessionRuntimeRow {\n103:     pub session_id: String,\n104:     pub mode: String,\n105:     pub invocation_uuid: Option<String>,\n106:     pub provider_name: Option<String>,\n107:     pub model_name: Option<String>,\n108:     pub pty_control_path: Option<String>,\n109:     pub updated_at: String,\n110:     pub run_state: String,\n111:     pub running_invocation_uuid: Option<String>,\n112:     pub running_os_pid: Option<i64>,\n113:     pub running_os_boot_id: Option<String>,\n114:     pub running_os_pid_starttime_ticks: Option<i64>,\n115:     pub turn_started_at: Option<String>,\n116:     pub turn_ended_at: Option<String>,\n117:     pub turn_start_max_mailbox_seq: Option<i64>,\n118:     pub last_exit_code: Option<i32>,\n119:     pub models_dir: Option<String>,\n120:     pub effective_cwd: Option<String>,\n121: }\n122: \n123: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n124: pub enum SessionLiveness {\n125:     Busy,\n126:     Idle,\n127: }\n128: \n129: #[derive(Debug, Clone, PartialEq, Eq)]\n130: enum SessionRuntimeLivenessDecision {\n131:     Busy,\n132:     Idle,\n133:     Stale {\n134:         running_invocation_uuid: Option<String>,\n135:     },\n136: }\n137: \n138: #[derive(Debug, Clone, Copy)]\n139: pub struct WakeClaimRequest<'a> {\n140:     pub session_id: &'a str,\n141:     pub claim_token: &'a str,\n142:     pub reason: &'a str,\n143:     pub auto_wake_count: i64,\n144:     pub wake_invocation_uuid: Option<&'a str>,\n145:     pub stale_after_seconds: i64,\n146: }\n147: \n148: #[derive(Debug, Clone, PartialEq, Eq)]\n149: pub enum WakeClaimAcquireResult {\n150:     Acquired(WakeClaimRow),\n151:     NoPending,\n152:     Busy,\n153:     AlreadyInFlight(WakeClaimRow),\n154: }\n155: \n156: #[derive(Debug, Clone, PartialEq, Eq)]\n157: pub struct WakeClaimRow {\n158:     pub session_id: String,\n159:     pub claim_token: String,\n160:     pub claimed_at: String,\n161:     pub wake_pid: Option<i64>,\n162:     pub wake_invocation_uuid: Option<String>,\n163:     pub reason: String,\n164:     pub auto_wake_count: i64,\n165:     pub min_pending_seq_at_claim: Option<i64>,\n166:     pub max_pending_seq_at_claim: Option<i64>,\n167: }\n168: \n169: #[derive(Debug, Clone, PartialEq, Eq)]\n170: pub struct WakeSweepCandidate {\n171:     pub session_id: String,\n172:     pub auto_wake_count: i64,\n173:     pub min_pending_seq: i64,\n174:     pub max_pending_seq: i64,\n175: }\n176: \n177: pub struct MailboxDb {\n178:     conn: Connection,\n179:     path: PathBuf,\n180: }\n181: \n182: impl MailboxDb {\n183:     pub fn default_path() -> Result<PathBuf, String> {\n184:         pid_identity::default_path()\n185:     }\n186: \n187:     pub fn open_default() -> Result<Self, String> {\n188:         let path = Self::default_path()?;\n189:         Self::open(&path)\n190:     }\n191: \n192:     pub fn open_default_if_exists() -> Result<Option<Self>, String> {\n193:         let path = Self::default_path()?;\n194:         if !path.exists() {\n195:             return Ok(None);\n196:         }\n197:         Self::open(&path).map(Some)\n198:     }\n199: \n200:     pub fn open(path: &Path) -> Result<Self, String> {\n201:         ensure_parent_dir(path)?;\n202:         let conn = Connection::open(path)\n203:             .map_err(|err| format!(\"Failed to open PID mailbox sidecar: {err}\"))?;\n204:         set_wal_mode(&conn)?;\n205:         pid_identity::ensure_identity_schema(&conn)?;\n206:         ensure_mailbox_schema(&conn)?;\n207:         Ok(Self {\n208:             conn,\n209:             path: path.to_path_buf(),\n210:         })\n211:     }\n212: \n213:     pub fn open_read_only(path: &Path) -> Result<Self, String> {\n214:         let conn = Connection::open_with_flags(path, OpenFlags::SQLITE_OPEN_READ_ONLY)\n215:             .map_err(|err| format!(\"Failed to open PID mailbox sidecar read-only: {err}\"))?;\n216:         Ok(Self {\n217:             conn,\n218:             path: path.to_path_buf(),\n219:         })\n220:     }\n221: \n222:     pub fn path(&self) -> &Path {\n223:         &self.path\n224:     }\n225: \n226:     pub fn connection(&self) -> &Connection {\n227:         &self.conn\n228:     }\n229: \n230:     pub fn enqueue_agent_bash_complete(\n231:         &mut self,\n232:         input: &AgentBashCompleteEnqueue<'_>,\n233:     ) -> Result<EnqueueResult, String> {\n234:         let now = now_rfc3339();\n235:         let tx = self\n236:             .conn\n237:             .transaction()\n238:             .map_err(|err| format!(\"Failed to start mailbox enqueue transaction: {err}\"))?;\n239:         let result = enqueue_agent_bash_complete_in_tx(&tx, input, &now)?;\n240:         tx.commit()\n241:             .map_err(|err| format!(\"Failed to commit mailbox enqueue transaction: {err}\"))?;\n242:         Ok(result)\n243:     }\n244: \n245:     pub fn list_pending(&self, session_id: &str) -> Result<Vec<MailboxRow>, String> {\n246:         let mut stmt = self\n247:             .conn\n248:             .prepare(\n249:                 \"SELECT seq, session_id, kind, handle, payload_json, enqueued_at,\n250:                         delivered_at, delivered_by_invocation_uuid, delivery_attempts,\n251:                         delivery_error, owner_invocation_uuid, matched_os_pid,\n252:                         matched_os_boot_id, matched_os_pid_starttime_ticks,\n253:                         matched_chain_index, state_dir, meta_path, log_path, rc_path, rc\n254:                  FROM mailbox\n255:                  WHERE session_id = ?1 AND delivered_at IS NULL\n256:                  ORDER BY seq ASC\",\n257:             )\n258:             .map_err(|err| format!(\"Failed to prepare pending mailbox query: {err}\"))?;\n259:         let rows = stmt\n260:             .query_map(params![session_id], map_mailbox_row)\n\n(Showing lines 1-260 of 2145. Use offset=261 to continue.)\n</content>","metadata":{"preview":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n//! `predicate`, `validator`\n//!\n//! Resume-backed notification mailbox storage in the PID identity sidecar DB.\n//! This module deliberately owns only additive sidecar tables and never touches\n//! the versioned `state.db` schema.\n\nuse chrono::{DateTime, Duration, SecondsFormat, Utc};\nuse rusqlite::{Connection, OpenFlags, OptionalExtension, params};\nuse serde::Serialize;\nuse std::path::{Path, PathBuf};\n\nuse crate::pid_identity::{self, ProcessIdentity};\n\npub const AGENT_BASH_COMPLETE_KIND: &str = \"agent_bash_complete\";\npub const WAKE_SWEEP_ABANDONED_ERROR: &str = \"wake_sweep_abandoned\";\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize)]","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-state/src/mailbox.rs","text":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n//! `predicate`, `validator`\n//!\n//! Resume-backed notification mailbox storage in the PID identity sidecar DB.\n//! This module deliberately owns only additive sidecar tables and never touches\n//! the versioned `state.db` schema.\n\nuse chrono::{DateTime, Duration, SecondsFormat, Utc};\nuse rusqlite::{Connection, OpenFlags, OptionalExtension, params};\nuse serde::Serialize;\nuse std::path::{Path, PathBuf};\n\nuse crate::pid_identity::{self, ProcessIdentity};\n\npub const AGENT_BASH_COMPLETE_KIND: &str = \"agent_bash_complete\";\npub const WAKE_SWEEP_ABANDONED_ERROR: &str = \"wake_sweep_abandoned\";\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\npub struct MailboxRow {\n    pub seq: i64,\n    pub session_id: String,\n    pub kind: String,\n    pub handle: String,\n    pub payload_json: String,\n    pub enqueued_at: String,\n    pub delivered_at: Option<String>,\n    pub delivered_by_invocation_uuid: Option<String>,\n    pub delivery_attempts: i64,\n    pub delivery_error: Option<String>,\n    pub owner_invocation_uuid: Option<String>,\n    pub matched_os_pid: Option<i64>,\n    pub matched_os_boot_id: Option<String>,\n    pub matched_os_pid_starttime_ticks: Option<i64>,\n    pub matched_chain_index: Option<i64>,\n    pub state_dir: String,\n    pub meta_path: String,\n    pub log_path: String,\n    pub rc_path: String,\n    pub rc: i32,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct AgentBashCompleteEnqueue<'a> {\n    pub session_id: &'a str,\n    pub handle: &'a str,\n    pub payload_json: &'a str,\n    pub owner_invocation_uuid: Option<&'a str>,\n    pub matched_os_pid: Option<i64>,\n    pub matched_os_boot_id: Option<&'a str>,\n    pub matched_os_pid_starttime_ticks: Option<i64>,\n    pub matched_chain_index: Option<i64>,\n    pub state_dir: &'a str,\n    pub meta_path: &'a str,\n    pub log_path: &'a str,\n    pub rc_path: &'a str,\n    pub rc: i32,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum EnqueueResult {\n    Inserted(MailboxRow),\n    AlreadyEnqueued(MailboxRow),\n    Conflict { existing: MailboxRow },\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct SessionRuntimeUpsert<'a> {\n    pub session_id: &'a str,\n    pub mode: &'a str,\n    pub invocation_uuid: Option<&'a str>,\n    pub provider_name: Option<&'a str>,\n    pub model_name: Option<&'a str>,\n    pub pty_control_path: Option<&'a str>,\n    pub models_dir: Option<&'a str>,\n    pub effective_cwd: Option<&'a str>,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct SessionRuntimeRunningUpdate<'a> {\n    pub session_id: &'a str,\n    pub mode: &'a str,\n    pub invocation_uuid: &'a str,\n    pub provider_name: Option<&'a str>,\n    pub model_name: Option<&'a str>,\n    pub identity: &'a ProcessIdentity,\n    pub pty_control_path: Option<&'a str>,\n    pub turn_start_max_mailbox_seq: Option<i64>,\n    pub models_dir: Option<&'a str>,\n    pub effective_cwd: Option<&'a str>,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct SessionRuntimeIdleUpdate<'a> {\n    pub session_id: &'a str,\n    pub invocation_uuid: &'a str,\n    pub last_exit_code: Option<i32>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct SessionRuntimeRow {\n    pub session_id: String,\n    pub mode: String,\n    pub invocation_uuid: Option<String>,\n    pub provider_name: Option<String>,\n    pub model_name: Option<String>,\n    pub pty_control_path: Option<String>,\n    pub updated_at: String,\n    pub run_state: String,\n    pub running_invocation_uuid: Option<String>,\n    pub running_os_pid: Option<i64>,\n    pub running_os_boot_id: Option<String>,\n    pub running_os_pid_starttime_ticks: Option<i64>,\n    pub turn_started_at: Option<String>,\n    pub turn_ended_at: Option<String>,\n    pub turn_start_max_mailbox_seq: Option<i64>,\n    pub last_exit_code: Option<i32>,\n    pub models_dir: Option<String>,\n    pub effective_cwd: Option<String>,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum SessionLiveness {\n    Busy,\n    Idle,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\nenum SessionRuntimeLivenessDecision {\n    Busy,\n    Idle,\n    Stale {\n        running_invocation_uuid: Option<String>,\n    },\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct WakeClaimRequest<'a> {\n    pub session_id: &'a str,\n    pub claim_token: &'a str,\n    pub reason: &'a str,\n    pub auto_wake_count: i64,\n    pub wake_invocation_uuid: Option<&'a str>,\n    pub stale_after_seconds: i64,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum WakeClaimAcquireResult {\n    Acquired(WakeClaimRow),\n    NoPending,\n    Busy,\n    AlreadyInFlight(WakeClaimRow),\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct WakeClaimRow {\n    pub session_id: String,\n    pub claim_token: String,\n    pub claimed_at: String,\n    pub wake_pid: Option<i64>,\n    pub wake_invocation_uuid: Option<String>,\n    pub reason: String,\n    pub auto_wake_count: i64,\n    pub min_pending_seq_at_claim: Option<i64>,\n    pub max_pending_seq_at_claim: Option<i64>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct WakeSweepCandidate {\n    pub session_id: String,\n    pub auto_wake_count: i64,\n    pub min_pending_seq: i64,\n    pub max_pending_seq: i64,\n}\n\npub struct MailboxDb {\n    conn: Connection,\n    path: PathBuf,\n}\n\nimpl MailboxDb {\n    pub fn default_path() -> Result<PathBuf, String> {\n        pid_identity::default_path()\n    }\n\n    pub fn open_default() -> Result<Self, String> {\n        let path = Self::default_path()?;\n        Self::open(&path)\n    }\n\n    pub fn open_default_if_exists() -> Result<Option<Self>, String> {\n        let path = Self::default_path()?;\n        if !path.exists() {\n            return Ok(None);\n        }\n        Self::open(&path).map(Some)\n    }\n\n    pub fn open(path: &Path) -> Result<Self, String> {\n        ensure_parent_dir(path)?;\n        let conn = Connection::open(path)\n            .map_err(|err| format!(\"Failed to open PID mailbox sidecar: {err}\"))?;\n        set_wal_mode(&conn)?;\n        pid_identity::ensure_identity_schema(&conn)?;\n        ensure_mailbox_schema(&conn)?;\n        Ok(Self {\n            conn,\n            path: path.to_path_buf(),\n        })\n    }\n\n    pub fn open_read_only(path: &Path) -> Result<Self, String> {\n        let conn = Connection::open_with_flags(path, OpenFlags::SQLITE_OPEN_READ_ONLY)\n            .map_err(|err| format!(\"Failed to open PID mailbox sidecar read-only: {err}\"))?;\n        Ok(Self {\n            conn,\n            path: path.to_path_buf(),\n        })\n    }\n\n    pub fn path(&self) -> &Path {\n        &self.path\n    }\n\n    pub fn connection(&self) -> &Connection {\n        &self.conn\n    }\n\n    pub fn enqueue_agent_bash_complete(\n        &mut self,\n        input: &AgentBashCompleteEnqueue<'_>,\n    ) -> Result<EnqueueResult, String> {\n        let now = now_rfc3339();\n        let tx = self\n            .conn\n            .transaction()\n            .map_err(|err| format!(\"Failed to start mailbox enqueue transaction: {err}\"))?;\n        let result = enqueue_agent_bash_complete_in_tx(&tx, input, &now)?;\n        tx.commit()\n            .map_err(|err| format!(\"Failed to commit mailbox enqueue transaction: {err}\"))?;\n        Ok(result)\n    }\n\n    pub fn list_pending(&self, session_id: &str) -> Result<Vec<MailboxRow>, String> {\n        let mut stmt = self\n            .conn\n            .prepare(\n                \"SELECT seq, session_id, kind, handle, payload_json, enqueued_at,\n                        delivered_at, delivered_by_invocation_uuid, delivery_attempts,\n                        delivery_error, owner_invocation_uuid, matched_os_pid,\n                        matched_os_boot_id, matched_os_pid_starttime_ticks,\n                        matched_chain_index, state_dir, meta_path, log_path, rc_path, rc\n                 FROM mailbox\n                 WHERE session_id = ?1 AND delivered_at IS NULL\n                 ORDER BY seq ASC\",\n            )\n            .map_err(|err| format!(\"Failed to prepare pending mailbox query: {err}\"))?;\n        let rows = stmt\n            .query_map(params![session_id], map_mailbox_row)","lineStart":1,"lineEnd":260,"totalLines":2145,"truncated":true}},"title":"crates/oulipoly-state/src/mailbox.rs","time":{"start":1780923339163,"end":1780923339223}},"metadata":{"openai":{"itemId":"fc_097c8557e2ae93fc016a26bbcb07d881998a1d0bbba5dfe6f4"}},"id":"prt_ea74d9195001qEsEq92HGi8Zpv","sessionID":"ses_158b3e351ffePkuQnC9kglvomy","messageID":"msg_ea74d37e80011M2BUBcvGst7Sg"}}
{"type":"tool_use","timestamp":1780923339246,"sessionID":"ses_158b3e351ffePkuQnC9kglvomy","part":{"type":"tool","tool":"read","callID":"call_VrdgDivQBRWcsDpL45Fom0UB","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-state/src/mailbox.rs","offset":300,"limit":520},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-state/src/mailbox.rs</path>\n<type>file</type>\n<content>\n300:         }\n301:         tx.commit()\n302:             .map_err(|err| format!(\"Failed to commit mailbox delivery transaction: {err}\"))\n303:     }\n304: \n305:     pub fn mark_delivery_failed(\n306:         &mut self,\n307:         session_id: &str,\n308:         seqs: &[i64],\n309:         delivery_error: &str,\n310:     ) -> Result<(), String> {\n311:         if seqs.is_empty() {\n312:             return Ok(());\n313:         }\n314:         let tx = self.conn.transaction().map_err(|err| {\n315:             format!(\"Failed to start mailbox delivery failure transaction: {err}\")\n316:         })?;\n317:         for seq in seqs {\n318:             tx.execute(\n319:                 \"UPDATE mailbox\n320:                  SET delivery_attempts = delivery_attempts + 1,\n321:                      delivery_error = ?3\n322:                  WHERE session_id = ?1\n323:                    AND seq = ?2\n324:                    AND delivered_at IS NULL\",\n325:                 params![session_id, seq, delivery_error],\n326:             )\n327:             .map_err(|err| format!(\"Failed to mark mailbox row delivery failed: {err}\"))?;\n328:         }\n329:         tx.commit()\n330:             .map_err(|err| format!(\"Failed to commit mailbox delivery failure transaction: {err}\"))\n331:     }\n332: \n333:     pub fn mark_pending_abandoned(\n334:         &mut self,\n335:         session_id: &str,\n336:         delivery_error: &str,\n337:         limit: usize,\n338:     ) -> Result<usize, String> {\n339:         if limit == 0 {\n340:             return Ok(0);\n341:         }\n342:         let tx = self\n343:             .conn\n344:             .transaction()\n345:             .map_err(|err| format!(\"Failed to start mailbox abandonment transaction: {err}\"))?;\n346:         let changed = tx\n347:             .execute(\n348:                 \"UPDATE mailbox\n349:                  SET delivery_error = ?2\n350:                  WHERE seq IN (\n351:                     SELECT seq\n352:                     FROM mailbox\n353:                     WHERE session_id = ?1\n354:                       AND delivered_at IS NULL\n355:                       AND (delivery_error IS NULL OR delivery_error != ?2)\n356:                     ORDER BY seq ASC\n357:                     LIMIT ?3\n358:                  )\",\n359:                 params![session_id, delivery_error, limit as i64],\n360:             )\n361:             .map_err(|err| format!(\"Failed to mark mailbox rows abandoned: {err}\"))?;\n362:         if changed > 0 {\n363:             tx.execute(\n364:                 \"DELETE FROM session_wake_claim WHERE session_id = ?1\",\n365:                 params![session_id],\n366:             )\n367:             .map_err(|err| format!(\"Failed to release abandoned wake claim: {err}\"))?;\n368:         }\n369:         tx.commit()\n370:             .map_err(|err| format!(\"Failed to commit mailbox abandonment transaction: {err}\"))?;\n371:         Ok(changed)\n372:     }\n373: \n374:     pub fn upsert_session_runtime(\n375:         &mut self,\n376:         input: SessionRuntimeUpsert<'_>,\n377:     ) -> Result<(), String> {\n378:         let now = now_rfc3339();\n379:         self.conn\n380:             .execute(\n381:                 \"INSERT INTO session_runtime (\n382:                     session_id,\n383:                     mode,\n384:                     invocation_uuid,\n385:                     provider_name,\n386:                     model_name,\n387:                     pty_control_path,\n388:                     updated_at,\n389:                     models_dir,\n390:                     effective_cwd\n391:                  ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)\n392:                  ON CONFLICT(session_id)\n393:                  DO UPDATE SET\n394:                     mode = excluded.mode,\n395:                     invocation_uuid = excluded.invocation_uuid,\n396:                     provider_name = excluded.provider_name,\n397:                     model_name = excluded.model_name,\n398:                     pty_control_path = excluded.pty_control_path,\n399:                     updated_at = excluded.updated_at,\n400:                     models_dir = COALESCE(excluded.models_dir, session_runtime.models_dir),\n401:                     effective_cwd = COALESCE(excluded.effective_cwd, session_runtime.effective_cwd)\",\n402:                 params![\n403:                     input.session_id,\n404:                     input.mode,\n405:                     input.invocation_uuid,\n406:                     input.provider_name,\n407:                     input.model_name,\n408:                     input.pty_control_path,\n409:                     &now,\n410:                     input.models_dir,\n411:                     input.effective_cwd,\n412:                 ],\n413:             )\n414:             .map_err(|err| format!(\"Failed to upsert session runtime row: {err}\"))?;\n415:         Ok(())\n416:     }\n417: \n418:     pub fn mark_session_running(\n419:         &mut self,\n420:         input: SessionRuntimeRunningUpdate<'_>,\n421:     ) -> Result<(), String> {\n422:         validate_running_run_state()?;\n423:         let now = now_rfc3339();\n424:         let turn_start_max_mailbox_seq = self.running_turn_start_max_mailbox_seq(&input)?;\n425:         mark_session_running_row(&self.conn, input, &now, turn_start_max_mailbox_seq)\n426:     }\n427: \n428:     pub fn mark_session_idle(\n429:         &mut self,\n430:         input: SessionRuntimeIdleUpdate<'_>,\n431:     ) -> Result<bool, String> {\n432:         validate_idle_run_state()?;\n433:         let now = now_rfc3339();\n434:         mark_session_idle_row(&self.conn, input, &now)\n435:     }\n436: \n437:     pub fn session_runtime(&self, session_id: &str) -> Result<Option<SessionRuntimeRow>, String> {\n438:         let row = session_runtime_row(&self.conn, session_id)?;\n439:         validate_session_runtime_row(row.as_ref())?;\n440:         Ok(row)\n441:     }\n442: \n443:     pub fn session_liveness(&mut self, session_id: &str) -> Result<SessionLiveness, String> {\n444:         let row = self.session_runtime(session_id)?;\n445:         let decision = session_runtime_liveness_decision(row.as_ref())?;\n446:         self.clear_stale_running_row_for_liveness(session_id, &decision)?;\n447:         Ok(session_liveness_from_decision(&decision))\n448:     }\n449: \n450:     pub fn try_acquire_wake_claim(\n451:         &mut self,\n452:         input: WakeClaimRequest<'_>,\n453:     ) -> Result<WakeClaimAcquireResult, String> {\n454:         self.try_acquire_or_renew_wake_claim(input, None)\n455:     }\n456: \n457:     pub fn try_acquire_or_renew_wake_claim(\n458:         &mut self,\n459:         input: WakeClaimRequest<'_>,\n460:         renew_token: Option<&str>,\n461:     ) -> Result<WakeClaimAcquireResult, String> {\n462:         if !self.session_has_pending_mailbox(input.session_id)? {\n463:             return Ok(WakeClaimAcquireResult::NoPending);\n464:         }\n465:         if self.session_is_busy(input.session_id)? {\n466:             return Ok(WakeClaimAcquireResult::Busy);\n467:         }\n468:         let now = now_rfc3339();\n469:         let tx = self\n470:             .conn\n471:             .transaction()\n472:             .map_err(|err| format!(\"Failed to start wake claim transaction: {err}\"))?;\n473:         let pending_bounds = pending_seq_bounds_tx(&tx, input.session_id)?;\n474:         let Some((min_seq, max_seq)) = pending_bounds else {\n475:             tx.commit()\n476:                 .map_err(|err| format!(\"Failed to commit empty wake claim transaction: {err}\"))?;\n477:             return Ok(WakeClaimAcquireResult::NoPending);\n478:         };\n479:         if let Some(existing) = fresh_in_flight_wake_claim(\n480:             &tx,\n481:             wake_claim_tx(&tx, input.session_id)?,\n482:             input.stale_after_seconds,\n483:             renew_token,\n484:         )? {\n485:             tx.commit().map_err(|err| {\n486:                 format!(\"Failed to commit existing wake claim transaction: {err}\")\n487:             })?;\n488:             return Ok(WakeClaimAcquireResult::AlreadyInFlight(existing));\n489:         }\n490:         let claim = acquire_wake_claim_tx(&tx, input, &now, min_seq, max_seq)?;\n491:         tx.commit()\n492:             .map_err(|err| format!(\"Failed to commit wake claim transaction: {err}\"))?;\n493:         Ok(WakeClaimAcquireResult::Acquired(claim))\n494:     }\n495: \n496:     pub fn wake_claim(&self, session_id: &str) -> Result<Option<WakeClaimRow>, String> {\n497:         wake_claim(&self.conn, session_id)\n498:     }\n499: \n500:     pub fn release_wake_claim(\n501:         &mut self,\n502:         session_id: &str,\n503:         claim_token: Option<&str>,\n504:     ) -> Result<bool, String> {\n505:         let changed = match claim_token {\n506:             Some(token) => self.conn.execute(\n507:                 \"DELETE FROM session_wake_claim WHERE session_id = ?1 AND claim_token = ?2\",\n508:                 params![session_id, token],\n509:             ),\n510:             None => self.conn.execute(\n511:                 \"DELETE FROM session_wake_claim WHERE session_id = ?1\",\n512:                 params![session_id],\n513:             ),\n514:         }\n515:         .map_err(|err| format!(\"Failed to release wake claim: {err}\"))?;\n516:         Ok(changed > 0)\n517:     }\n518: \n519:     pub fn record_wake_claim_pid(\n520:         &mut self,\n521:         session_id: &str,\n522:         claim_token: &str,\n523:         wake_pid: i64,\n524:     ) -> Result<bool, String> {\n525:         let changed = self\n526:             .conn\n527:             .execute(\n528:                 \"UPDATE session_wake_claim\n529:                  SET wake_pid = ?3\n530:                  WHERE session_id = ?1\n531:                    AND claim_token = ?2\",\n532:                 params![session_id, claim_token, wake_pid],\n533:             )\n534:             .map_err(|err| format!(\"Failed to record wake claim PID: {err}\"))?;\n535:         Ok(changed > 0)\n536:     }\n537: \n538:     pub fn record_wake_claim_pid_identity(\n539:         &mut self,\n540:         session_id: &str,\n541:         claim_token: &str,\n542:         wake_pid: i64,\n543:         provider_name: Option<&str>,\n544:         model_name: Option<&str>,\n545:     ) -> Result<bool, String> {\n546:         if let Some(identity) = pid_identity::read_live_process_identity(wake_pid)? {\n547:             let recorded_at = now_rfc3339();\n548:             pid_identity::PidIdentityDb::open(self.path())?.record_identity(\n549:                 pid_identity::PidIdentityRecord {\n550:                     identity: &identity,\n551:                     os_pgid: None,\n552:                     invocation_uuid: claim_token,\n553:                     session_id: Some(session_id),\n554:                     provider_name,\n555:                     model_name,\n556:                     recorded_at: &recorded_at,\n557:                 },\n558:             )?;\n559:         }\n560:         self.record_wake_claim_pid(session_id, claim_token, wake_pid)\n561:     }\n562: \n563:     pub fn wake_sweep_candidates(\n564:         &mut self,\n565:         stale_after_seconds: i64,\n566:         limit: usize,\n567:     ) -> Result<Vec<WakeSweepCandidate>, String> {\n568:         if limit == 0 {\n569:             return Ok(Vec::new());\n570:         }\n571:         let mut candidates = Vec::new();\n572:         for session_id in self.pending_wake_session_ids(limit)? {\n573:             if candidates.len() >= limit {\n574:                 break;\n575:             }\n576:             if self.session_is_busy(&session_id)? {\n577:                 continue;\n578:             }\n579:             let Some((min_pending_seq, max_pending_seq)) = self.pending_seq_bounds(&session_id)?\n580:             else {\n581:                 continue;\n582:             };\n583:             let Some(claim) = self.wake_claim(&session_id)? else {\n584:                 candidates.push(wake_sweep_candidate(\n585:                     session_id,\n586:                     1,\n587:                     min_pending_seq,\n588:                     max_pending_seq,\n589:                 ));\n590:                 continue;\n591:             };\n592:             if wake_claim_is_reclaimable(&self.conn, &claim, stale_after_seconds)? {\n593:                 candidates.push(wake_sweep_candidate(\n594:                     session_id,\n595:                     claim.auto_wake_count.saturating_add(1),\n596:                     min_pending_seq,\n597:                     max_pending_seq,\n598:                 ));\n599:             }\n600:         }\n601:         Ok(candidates)\n602:     }\n603: \n604:     pub fn validate_wake_claim_for_child(\n605:         &mut self,\n606:         session_id: &str,\n607:         claim_token: &str,\n608:     ) -> Result<bool, String> {\n609:         let claim = self.wake_claim(session_id)?;\n610:         if !wake_claim_is_valid_for_child(claim.as_ref(), claim_token) {\n611:             return Ok(false);\n612:         }\n613:         self.release_busy_child_wake_claim(session_id, claim_token)\n614:     }\n615: \n616:     #[cfg(test)]\n617:     fn force_wake_claim_age_for_test(\n618:         &mut self,\n619:         session_id: &str,\n620:         seconds_old: i64,\n621:     ) -> Result<(), String> {\n622:         let claimed_at = (Utc::now() - Duration::seconds(seconds_old))\n623:             .to_rfc3339_opts(SecondsFormat::Secs, true);\n624:         self.conn\n625:             .execute(\n626:                 \"UPDATE session_wake_claim SET claimed_at = ?2 WHERE session_id = ?1\",\n627:                 params![session_id, &claimed_at],\n628:             )\n629:             .map_err(|err| format!(\"Failed to age wake claim for test: {err}\"))?;\n630:         Ok(())\n631:     }\n632: \n633:     fn list_mailbox_all(&self, session_id: &str) -> Result<Vec<MailboxRow>, String> {\n634:         let mut stmt = self\n635:             .conn\n636:             .prepare(\n637:                 \"SELECT seq, session_id, kind, handle, payload_json, enqueued_at,\n638:                         delivered_at, delivered_by_invocation_uuid, delivery_attempts,\n639:                         delivery_error, owner_invocation_uuid, matched_os_pid,\n640:                         matched_os_boot_id, matched_os_pid_starttime_ticks,\n641:                         matched_chain_index, state_dir, meta_path, log_path, rc_path, rc\n642:                  FROM mailbox\n643:                  WHERE session_id = ?1\n644:                  ORDER BY seq ASC\",\n645:             )\n646:             .map_err(|err| format!(\"Failed to prepare mailbox query: {err}\"))?;\n647:         let rows = stmt\n648:             .query_map(params![session_id], map_mailbox_row)\n649:             .map_err(|err| format!(\"Failed to query mailbox rows: {err}\"))?;\n650:         collect_rows(rows)\n651:     }\n652: \n653:     fn pending_wake_session_ids(&self, limit: usize) -> Result<Vec<String>, String> {\n654:         if limit == 0 {\n655:             return Ok(Vec::new());\n656:         }\n657:         let oldest_limit = limit.saturating_sub(limit / 2);\n658:         let newest_limit = limit.saturating_sub(oldest_limit);\n659:         let mut session_ids = self.oldest_pending_wake_session_ids(oldest_limit)?;\n660:         for session_i