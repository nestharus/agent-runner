on assertions\n35: //! ```\n36: \n37: use oulipoly_state::StateDb;\n38: use oulipoly_state::mailbox::{AgentBashCompleteEnqueue, MailboxDb};\n39: use rusqlite::{Connection, params};\n40: use std::fs;\n41: use std::os::unix::fs::PermissionsExt;\n42: use std::path::{Path, PathBuf};\n43: use std::process::{Command, Output};\n44: use std::sync::{Mutex, MutexGuard, OnceLock};\n45: use std::time::{Duration, Instant};\n46: \n47: const MODEL: &str = \"wake-confirm-legacy-opencode\";\n48: const PROVIDER: &str = \"opencode\";\n49: const SESSION: &str = \"ses_wakeconfirmlegacy\";\n50: const HANDLE: &str = \"h-wake-confirm-legacy\";\n51: const CHAIN_ID: &str = \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\";\n52: \n53: struct Fixture {\n54:     dir: tempfile::TempDir,\n55:     config_home: PathBuf,\n56:     data_home: PathBuf,\n57:     home_dir: PathBuf,\n58:     app_config_dir: PathBuf,\n59:     models_dir: PathBuf,\n60:     bin_dir: PathBuf,\n61:     work_dir: PathBuf,\n62:     export_dir: PathBuf,\n63: }\n64: \n65: impl Fixture {\n66:     fn new() -> Self {\n67:         let dir = tempfile::tempdir().unwrap();\n68:         let config_home = dir.path().join(\"xdg-config\");\n69:         let data_home = dir.path().join(\"xdg-data\");\n70:         let home_dir = dir.path().join(\"home\");\n71:         let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n72:         let models_dir = app_config_dir.join(\"models\");\n73:         let bin_dir = dir.path().join(\"bin\");\n74:         let work_dir = dir.path().join(\"work\");\n75:         let export_dir = dir.path().join(\"fake-opencode-export\");\n76:         fs::create_dir_all(&models_dir).unwrap();\n77:         fs::create_dir_all(&bin_dir).unwrap();\n78:         fs::create_dir_all(&work_dir).unwrap();\n79:         fs::create_dir_all(&export_dir).unwrap();\n80:         fs::create_dir_all(&home_dir).unwrap();\n81:         Self {\n82:             dir,\n83:             config_home,\n84:             data_home,\n85:             home_dir,\n86:             app_config_dir,\n87:             models_dir,\n88:             bin_dir,\n89:             work_dir,\n90:             export_dir,\n91:         }\n92:     }\n93: \n94:     fn app_data_dir(&self) -> PathBuf {\n95:         self.data_home.join(\"oulipoly-agent-runner\")\n96:     }\n97: \n98:     fn sidecar_path(&self) -> PathBuf {\n99:         self.app_data_dir().join(\"pid-identity.db\")\n100:     }\n101: \n102:     fn state_path(&self) -> PathBuf {\n103:         self.app_data_dir().join(\"state.db\")\n104:     }\n105: \n106:     fn run(&self, mut cmd: Command) -> Output {\n107:         cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n108:             .env(\"XDG_DATA_HOME\", &self.data_home)\n109:             .env(\"HOME\", &self.home_dir)\n110:             .env(\"PATH\", self.path_env())\n111:             .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n112:             .env(\"WAKE_CONFIRM_WORK_DIR\", &self.work_dir)\n113:             .env(\"WAKE_CONFIRM_EXPORT_DIR\", &self.export_dir)\n114:             .env_remove(\"OULIPOLY_DATA_DIR\")\n115:             .env_remove(\"OULIPOLY_AUTO_WAKE\")\n116:             .env_remove(\"OULIPOLY_AUTO_WAKE_SESSION_ID\")\n117:             .env_remove(\"OULIPOLY_AUTO_WAKE_TOKEN\")\n118:             .env_remove(\"OULIPOLY_AUTO_WAKE_COUNT\")\n119:             .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n120:             .current_dir(self.dir.path());\n121:         cmd.output().unwrap()\n122:     }\n123: \n124:     fn path_env(&self) -> String {\n125:         let current = std::env::var(\"PATH\").unwrap_or_default();\n126:         format!(\"{}:{current}\", self.bin_dir.display())\n127:     }\n128: \n129:     fn run_agent(&self, prompt: &str) -> Output {\n130:         let mut cmd = Command::new(runner_bin());\n131:         cmd.env(\"WAKE_CONFIRM_NO_NOTIFY\", \"1\")\n132:             .arg(\"-m\")\n133:             .arg(MODEL)\n134:             .arg(\"--models-dir\")\n135:             .arg(&self.models_dir)\n136:             .arg(prompt);\n137:         self.run(cmd)\n138:     }\n139: \n140:     fn run_resume_with_env(&self, envs: &[(&str, &str)]) -> Output {\n141:         let mut cmd = Command::new(runner_bin());\n142:         for (key, value) in envs {\n143:             cmd.env(key, value);\n144:         }\n145:         cmd.arg(\"resume\")\n146:             .arg(\"--session-id\")\n147:             .arg(SESSION)\n148:             .arg(\"-m\")\n149:             .arg(MODEL)\n150:             .arg(\"--models-dir\")\n151:             .arg(&self.models_dir);\n152:         self.run(cmd)\n153:     }\n154: \n155:     fn write_legacy_opencode(&self) {\n156:         self.write_executable(\"opencode\", fake_opencode_script());\n157:         self.write_executable(\"opencode-turns\", fake_opencode_turns_script());\n158:         fs::write(\n159:             self.models_dir.join(format!(\"{MODEL}.toml\")),\n160:             format!(\n161:                 r#\"prompt_mode = \"arg\"\n162: \n163: [[providers]]\n164: name = \"{PROVIDER}\"\n165: args = []\n166: \"#,\n167:             ),\n168:         )\n169:         .unwrap();\n170:         fs::write(\n171:             self.app_config_dir.join(\"providers.toml\"),\n172:             format!(\n173:                 r#\"[{PROVIDER}]\n174: command = \"opencode\"\n175: args = [\"run\"]\n176: prompt_mode = \"arg\"\n177: \n178: [{PROVIDER}.session_capture]\n179: kind = \"stdout_json_event\"\n180: json_args = [\"--json\"]\n181: event_type = \"step_start\"\n182: event_id_path = \"sessionID\"\n183: \n184: [{PROVIDER}.resume]\n185: kind = \"flag\"\n186: flag = \"--session\"\n187: \"#,\n188:             ),\n189:         )\n190:         .unwrap();\n191:         fs::write(\n192:             self.app_config_dir.join(\"sessions.toml\"),\n193:             format!(\n194:                 r#\"[{PROVIDER}]\n195: turn_script = \"opencode-turns\"\n196: state_dir = {}\n197: \"#,\n198:                 toml_string(&path_string(&self.work_dir.join(\"turn-state\")))\n199:             ),\n200:         )\n201:         .unwrap();\n202:     }\n203: \n204:     fn write_executable(&self, name: &str, body: &str) -> PathBuf {\n205:         let path = self.bin_dir.join(name);\n206:         fs::write(&path, body).unwrap();\n207:         let mut perms = fs::metadata(&path).unwrap().permissions();\n208:         perms.set_mode(0o755);\n209:         fs::set_permissions(&path, perms).unwrap();\n210:         path\n211:     }\n212: \n213:     fn mailbox(&self) -> MailboxDb {\n214:         MailboxDb::open(&self.sidecar_path()).unwrap()\n215:     }\n216: \n217:     fn state(&self) -> StateDb {\n218:         StateDb::open(&self.state_path()).unwrap()\n219:     }\n220: \n221:     fn ensure_active_chain_for_legacy_session(&self) {\n222:         if self\n223:             .state()\n224:             .chain_id_for_segment(PROVIDER, SESSION)\n225:             .unwrap()\n226:             .is_some()\n227:         {\n228:             return;\n229:         }\n230:         let conn = Connection::open(self.state_path()).unwrap();\n231:         conn.execute(\n232:             \"INSERT INTO session_chains (chain_id, created_at, last_used_at, model_name)\n233:              VALUES (?1, '2026-06-07T00:00:00Z', '2026-06-07T00:00:00Z', ?2)\",\n234:             params![CHAIN_ID, MODEL],\n235:         )\n236:         .unwrap();\n237:         conn.execute(\n238:             \"INSERT INTO session_chain_segments\n239:                 (chain_id, provider_name, session_id, started_at, transition_reason)\n240:              VALUES (?1, ?2, ?3, '2026-06-07T00:00:00Z', 'initial')\",\n241:             params![CHAIN_ID, PROVIDER, SESSION],\n242:         )\n243:         .unwrap();\n244:     }\n245: \n246:     fn seed_mailbox_notification(&self) {\n247:         let state_dir = self.work_dir.join(HANDLE);\n248:         fs::create_dir_all(&state_dir).unwrap();\n249:         let meta = state_dir.join(\"meta.json\");\n250:         let log = state_dir.join(\"log\");\n251:         let rc = state_dir.join(\"rc\");\n252:         fs::write(&meta, r#\"{\"caller_chain\":[]}\"#).unwrap();\n253:         fs::write(&log, \"legacy opencode workload completed\\n\").unwrap();\n254:         fs::write(&rc, \"0\\n\").unwrap();\n255:         let payload_json = serde_json::json!({\n256:             \"schema_version\": 1,\n257:             \"kind\": \"agent_bash_complete\",\n258:             \"handle\": HANDLE,\n259:             \"state_dir\": path_string(&state_dir),\n260:             \"meta_path\": path_string(&meta),\n261:             \"log_path\": path_string(&log),\n262:             \"rc_path\": path_string(&rc),\n263:             \"rc\": 0,\n264:         })\n265:         .to_string();\n266:         let mut mailbox = self.mailbox();\n267:         mailbox\n268:             .enqueue_agent_bash_complete(&AgentBashCompleteEnqueue {\n269:                 session_id: SESSION,\n270:                 handle: HANDLE,\n271:                 payload_json: &payload_json,\n272:                 owner_invocation_uuid: None,\n273:                 matched_os_pid: None,\n274:                 matched_os_boot_id: None,\n275:                 matched_os_pid_starttime_ticks: None,\n276:                 matched_chain_index: None,\n277:                 state_dir: &path_string(&state_dir),\n278:                 meta_path: &path_string(&meta),\n279:                 log_path: &path_string(&log),\n280:                 rc_path: &path_string(&rc),\n281:                 rc: 0,\n282:             })\n283:             .unwrap();\n284:     }\n285: \n286:     fn notification_prompt_path(&self) -> PathBuf {\n287:         self.work_dir.join(\"legacy-wake-resumed.txt\")\n288:     }\n289: \n290:     fn export_path(&self) -> PathBuf {\n291:         self.export_dir.join(format!(\"{SESSION}.jsonl\"))\n292:     }\n293: \n294:     fn export_text(&self) -> String {\n295:         fs::read_to_string(self.export_path()).unwrap_or_default()\n296:     }\n297: \n298:     fn unconfirmed_invocation_count(&self) -> i64 {\n299:         Connection::open(self.state_path())\n300:             .unwrap()\n301:             .query_row(\n302:                 \"SELECT COUNT(*) FROM invocations WHERE error_category = 'mailbox_delivery_unconfirmed'\",\n303:                 [],\n304:                 |row| row.get(0),\n305:             )\n306:             .unwrap()\n307:     }\n308: \n309:     fn assert_xdg_isolated(&self) {\n310:         assert!(\n311:             !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n312:             \"config must stay in isolated XDG_CONFIG_HOME\"\n313:         );\n314:         assert!(\n315:             !self\n316:                 .home_dir\n317:                 .join(\".local/share/oulipoly-agent-runner\")\n318:                 .exists(),\n319:             \"state must stay in isolated XDG_DATA_HOME\"\n320:         );\n321:     }\n322: }\n323: \n324: #[test]\n325: fn legacy_opencode_resume_confirms_delivery_after_targeted_turn_ingest() {\n326:     let _guard = integration_test_guard();\n327:     let fixture = prepared_fixture();\n328:     fixture.seed_mailbox_notification();\n329: \n330:     let output = fixture.run_resume_with_env(&[]);\n331:     let prompt = wait_for_file(&fixture.notification_prompt_path());\n332:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n333:     assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n334:     assert!(prompt.contains(\"handle: h-wake-confirm-legacy\"), \"{prompt}\");\n335:     assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n336:     wait_until(\"fake opencode export contains delivery nonce\", || {\n337:         let exported = fixture.export_text();\n338:         exported.contains(\"[OULIPOLY NOTIFICATIONS]\") && exported.contains(\"[OULIPOLY-DELIVERY \")\n339:     });\n340: \n341:     assert_success(&output);\n342:     wait_until(\"legacy opencode delivery marked delivered\", || {\n343:         let db = fixture.mailbox();\n344:         let rows = db.list_mailbox(SESSION, true).unwrap();\n345:         rows.len() == 1\n346:             && rows[0].delivered_at.is_some()\n347:             && rows[0].delivery_error.is_none()\n348:             && rows[0].delivery_attempts == 1\n349:             && rows[0].delivered_by_invocation_uuid.is_some()\n350:     });\n351:     assert!(\n352:         !fixture\n353:             .state()\n354:             .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n355:             .unwrap(),\n356:         \"fixture should quote-wrap the delivered user body so exact-text confirmation stays red\"\n357:     );\n358:     assert!(\n359:         fixture\n360:             .state()\n361:             .has_session_user_turn_containing(\n362:                 PROVIDER,\n363:                 SESSION,\n364:                 &delivery_nonce_from_prompt(&prompt)\n365:             )\n366:             .unwrap(),\n367:         \"session_turns should contain the delivery nonce in the quote-wrapped user body\"\n368:     );\n369:     assert_eq!(fixture.unconfirmed_invocation_count(), 0);\n370:     assert!(fixture.mailbox().list_pending(SESSION).unwrap().is_empty());\n371:     fixture.assert_xdg_isolated();\n372: }\n373: \n374: #[test]\n375: fn legacy_opencode_resume_leaves_mailbox_pending_when_ingested_turn_omits_delivery_nonce() {\n376:     let _guard = integration_test_guard();\n377:     let fixture = prepared_fixture();\n378:     fixture.seed_mailbox_notification();\n379: \n380:     let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\", \"1\")]);\n381:     assert_exit_code(&output, 1);\n382:     let prompt = wait_for_file(&fixture.notification_prompt_path());\n383:     assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n384:     wait_until(\n385:         \"fake opencode export contains user turn without delivery nonce\",\n386:         || {\n387:             let exported = fixture.export_text();\n388:             exported.contains(\"[OULIPOLY NOTIFICATIONS]\")\n389:                 && !exported.contains(\"[OULIPOLY-DELIVERY \")\n390:         },\n391:     );\n392:     wait_until(\n393:         \"nonce-less export leaves mailbox pending unconfirmed\",\n394:         || {\n395:             let db = fixture.mailbox();\n396:             let rows = db.list_mailbox(SESSION, true).unwrap();\n397:             rows.len() == 1\n398:                 && rows[0].delivered_at.is_none()\n399:                 && rows[0].delivery_attempts == 1\n400:                 && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n401:                 && rows[0].delivered_by_invocation_uuid.is_none()\n402:         },\n403:     );\n404:     assert!(\n405:         !fixture\n406:             .state()\n407:             .has_session_user_turn_containing(\n408:                 PROVIDER,\n409:                 SESSION,\n410:                 &delivery_nonce_from_prompt(&prompt)\n411:             )\n412:             .unwrap(),\n413:         \"stored resume turn without the delivery nonce must not confirm delivery\"\n414:     );\n415:     assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n416:     assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n417:     fixture.assert_xdg_isolated();\n418: }\n419: \n420: #[test]\n421: fn legacy_opencode_resume_leaves_mailbox_pending_when_export_omits_notification_turn() {\n422:     let _guard = integration_test_guard();\n423:     let fixture = prepared_fixture();\n424:     fixture.seed_mailbox_notification();\n425: \n426:     let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\", \"1\")]);\n427:     assert_exit_code(&output, 1);\n428:     let prompt = wait_for_file(&fixture.notification_prompt_path());\n429:     assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n430:     wait_until(\"omitted export leaves mailbox pending unconfirmed\", || {\n431:         let db = fixture.mailbox();\n432:         let rows = db.list_mailbox(SESSION, true).unwrap();\n433:         rows.len() == 1\n434:             && rows[0].delivered_at.is_none()\n435:             && rows[0].delivery_attempts == 1\n436:             && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n437:             && rows[0].delivered_by_invocation_uuid.is_none()\n438:     });\n439:     assert!(\n440:         !fixture\n441:             .state()\n442:             .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n443:             .unwrap(),\n444:         \"omitted export must not create exact user-turn confirmation evidence\"\n445:     );\n446:     assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n447:     assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n448:     fixture.assert_xdg_isolated();\n449: }\n450: \n451: fn prepared_fixture() -> Fixture {\n452:     let fixture = Fixture::new();\n453:     fixture.write_legacy_opencode();\n454:     let output = fixture.run_agent(\"launch legacy opencode parent\");\n455:     assert_success(&output);\n456:     fixture.ensure_active_chain_for_legacy_session();\n457:     wait_until(\"legacy opencode parent runtime idle\", || {\n458:         fixture\n459:             .mailbox()\n460:             .session_runtime(SESSION)\n461:             .unwrap()\n462:             .is_some_and(|runtime| runtime.run_state == \"idle\")\n463:     });\n464:     fixture\n465: }\n466: \n467: fn fake_opencode_script() -> &'static str {\n468:     r#\"#!/usr/bin/env python3\n469: import json\n470: import os\n471: import pathlib\n472: import re\n473: import sys\n474: \n475: SESSION = \"ses_wakeconfirmlegacy\"\n476: \n477: def work_dir():\n478:     return pathlib.Path(os.environ[\"WAKE_CONFIRM_WORK_DIR\"])\n479: \n480: def export_dir():\n481:     return pathlib.Path(os.environ[\"WAKE_CONFIRM_EXPORT_DIR\"])\n482: \n483: def session_path(session_id):\n484:     return export_dir() / f\"{session_id}.jsonl\"\n485: \n486: def next_turn_id(session_id, role):\n487:     path = session_path(session_id)\n488:     if not path.exists():\n489:         return f\"{role}-1\"\n490:     count = sum(1 for line in path.read_text(encoding=\"utf-8\").splitlines() if line.strip())\n491:     return f\"{role}-{count + 1}\"\n492: \n493: def append_turn(session_id, role, text):\n494:     export_dir().mkdir(parents=True, exist_ok=True)\n495:     turn = {\n496:         \"session_id\": session_id,\n497:         \"turn_id\": next_turn_id(session_id, role),\n498:         \"timestamp\": \"2026-06-07T00:00:00Z\",\n499:         \"role\": role,\n500:         \"body\": [{\"type\": \"text\", \"text\": text}],\n501:     }\n502:     with session_path(session_id).open(\"a\", encoding=\"utf-8\") as handle:\n503:         handle.write(json.dumps(turn, separators=(\",\", \":\")) + \"\\n\")\n504: \n505: def stored_resume_prompt(prompt):\n506:     if os.environ.get(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\") == \"1\":\n507:         prompt = re.sub(r\"^\\[OULIPOLY-DELIVERY [^\\n]*\\]\\n?\", \"\", prompt, flags=re.MULTILINE)\n508:     return f'\"{prompt}\"'\n509: \n510: def parse_run(argv):\n511:     session_id = SESSION\n512:     prompt = \"\"\n513:     index = 0\n514:     while index < len(argv):\n515:         arg = argv[index]\n516:         if arg == \"--session\" and index + 1 < len(argv):\n517:             session_id = argv[index + 1]\n518:             index += 2\n519:             continue\n520:         if arg == \"--json\":\n521:             index += 1\n522:             continue\n523:         prompt = arg\n524:         index += 1\n525:     return session_id, prompt\n526: \n527: def run(argv):\n528:     session_id, prompt = parse_run(argv)\n529:     if \"--session\" in argv:\n530:         (work_dir() / \"legacy-wake-resumed.txt\").write_text(prompt, encoding=\"utf-8\")\n531:         if os.environ.get(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\") != \"1\":\n532:             append_turn(session_id, \"user\", stored_resume_prompt(prompt))\n533:         append_turn(session_id, \"assistant\", \"legacy wake acknowledged\")\n534:         print(\"legacy wake acknowledged\", flush=True)\n535:         return 0\n536:     print(json.dumps({\"type\": \"step_start\", \"sessionID\": SESSION}), flush=True)\n537:     append_turn(SESSION, \"user\", prompt)\n538:     append_turn(SESSION, \"assistant\", \"legacy parent acknowledged\")\n539:     print(\"legacy parent acknowledged\", flush=True)\n540:     return 0\n541: \n542: def export_session(argv):\n543:     session_id = argv[0] if argv else SESSION\n544:     path = session_path(session_id)\n545:     if path.exists():\n546:         sys.stdout.write(path.read_text(encoding=\"utf-8\"))\n547:     return 0\n548: \n549: def main():\n550:     subcommand = sys.argv[1] if len(sys.argv) > 1 else \"\"\n551:     if subcommand == \"export\":\n552:         return export_session(sys.argv[2:])\n553:     if subcommand == \"run\":\n554:         return run(sys.argv[2:])\n555:     print(f\"unsupported fake opencode subcommand: {subcommand}\", file=sys.stderr)\n556:     return 64\n557: \n558: if __name__ == \"__main__\":\n559:     raise SystemExit(main())\n560: \"#\n561: }\n562: \n563: fn fake_opencode_turns_script() -> &'static str {\n564:     r#\"#!/usr/bin/env python3\n565: import os\n566: import subprocess\n567: import sys\n568: \n569: session_id = os.environ.get(\"SESSION_ID\")\n570: if not session_id:\n571:     raise SystemExit(0)\n572: \n573: result = subprocess.run(\n574:     [\"opencode\", \"export\", session_id],\n575:     stdout=subprocess.PIPE,\n576:     stderr=subprocess.PIPE,\n577:     text=True,\n578:     check=False,\n579: )\n580: if result.returncode != 0:\n581:     sys.stderr.write(result.stderr)\n582:     raise SystemExit(result.returncode)\n583: sys.stdout.write(result.stdout)\n584: \"#\n585: }\n586: \n587: fn assert_success(output: &Output) {\n588:     assert_exit_code(output, 0);\n589: }\n590: \n591: fn assert_exit_code(output: &Output, expected: i32) {\n592:     assert_eq!(\n593:         output.status.code(),\n594:         Some(expected),\n595:         \"stdout={}\\nstderr={}\",\n596:         String::from_utf8_lossy(&output.stdout),\n597:         String::from_utf8_lossy(&output.stderr)\n598:     );\n599: }\n600: \n601: fn wait_for_file(path: &Path) -> String {\n602:     wait_for_path_exists(path);\n603:     fs::read_to_string(path).unwrap()\n604: }\n605: \n606: fn wait_for_path_exists(path: &Path) {\n607:     wait_until(&format!(\"{} exists\", path.display()), || path.exists());\n608: }\n609: \n610: fn wait_until(label: &str, mut predicate: impl FnMut() -> bool) {\n611:     let start = Instant::now();\n612:     while start.elapsed() < Duration::from_secs(10) {\n613:         if predicate() {\n614:             return;\n615:         }\n616:         std::thread::sleep(Duration::from_millis(50));\n617:     }\n618:     panic!(\"timed out waiting for {label}\");\n619: }\n620: \n621: fn delivery_nonce_from_prompt(prompt: &str) -> String {\n622:     let prefix = \"[OULIPOLY-DELIVERY \";\n623:     let start = prompt\n624:         .find(prefix)\n625:         .unwrap_or_else(|| panic!(\"prompt missing delivery nonce: {prompt}\"))\n626:         + prefix.len();\n627:     let rest = &prompt[start..];\n628:     let end = rest\n629:         .find(']')\n630:         .unwrap_or_else(|| panic!(\"prompt has unterminated delivery nonce: {prompt}\"));\n631:     rest[..end].to_string()\n632: }\n633: \n634: fn integration_test_lock() -> &'static Mutex<()> {\n635:     static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n636:     LOCK.get_or_init(|| Mutex::new(()))\n637: }\n638: \n639: fn integration_test_guard() -> MutexGuard<'static, ()> {\n640:     integration_test_lock()\n641:         .lock()\n642:         .unwrap_or_else(|poisoned| poisoned.into_inner())\n643: }\n644: \n645: fn runner_bin() -> &'static str {\n646:     env!(\"CARGO_BIN_EXE_oulipoly-agent-runner\")\n647: }\n648: \n649: fn path_string(path: &Path) -> String {\n650:     path.to_string_lossy().into_owned()\n651: }\n652: \n653: fn toml_string(value: &str) -> String {\n654:     serde_json::to_string(value).unwrap()\n655: }\n\n(End of file - total 655 lines)\n</content>","metadata":{"preview":"#![cfg(unix)]\n\n//! ## Declared roles\n//!\n//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n//! predicate, filter.\n//!\n//! TEST: legacy opencode wake-confirmation fixtures — fake CLI script\n//! formatters, model/config mappers, state and mailbox accessors, transcript\n//! parsers, consumed-notification predicates and filters, delivery/claim row\n//! validators, and test orchestration.\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n//!     role: adapter\n//!     Translates:\n//!       - legacy-opencode-cli-contract","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/wake_confirm_legacy_opencode.rs","text":"#![cfg(unix)]\n\n//! ## Declared roles\n//!\n//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n//! predicate, filter.\n//!\n//! TEST: legacy opencode wake-confirmation fixtures — fake CLI script\n//! formatters, model/config mappers, state and mailbox accessors, transcript\n//! parsers, consumed-notification predicates and filters, delivery/claim row\n//! validators, and test orchestration.\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n//!     role: adapter\n//!     Translates:\n//!       - legacy-opencode-cli-contract\n//!       - wake-confirmation-transcript-contract\n//!       - mailbox-sidecar-contract\n//!       - invocation-state-db-contract\n//!       - test-fixture-process-contract\n//! intrinsic_surface_declarations:\n//!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n//!     role: intrinsic-surface\n//!     Domain: legacy opencode wake-confirmation regression suite\n//!     Owns:\n//!       - isolated config/data fixture materialization\n//!       - fake opencode script generation and executable setup\n//!       - transcript export fixture construction\n//!       - wake/resume command invocation and environment isolation\n//!       - delivery confirmation and consumed-notification assertions\n//! ```\n\nuse oulipoly_state::StateDb;\nuse oulipoly_state::mailbox::{AgentBashCompleteEnqueue, MailboxDb};\nuse rusqlite::{Connection, params};\nuse std::fs;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::{Path, PathBuf};\nuse std::process::{Command, Output};\nuse std::sync::{Mutex, MutexGuard, OnceLock};\nuse std::time::{Duration, Instant};\n\nconst MODEL: &str = \"wake-confirm-legacy-opencode\";\nconst PROVIDER: &str = \"opencode\";\nconst SESSION: &str = \"ses_wakeconfirmlegacy\";\nconst HANDLE: &str = \"h-wake-confirm-legacy\";\nconst CHAIN_ID: &str = \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\";\n\nstruct Fixture {\n    dir: tempfile::TempDir,\n    config_home: PathBuf,\n    data_home: PathBuf,\n    home_dir: PathBuf,\n    app_config_dir: PathBuf,\n    models_dir: PathBuf,\n    bin_dir: PathBuf,\n    work_dir: PathBuf,\n    export_dir: PathBuf,\n}\n\nimpl Fixture {\n    fn new() -> Self {\n        let dir = tempfile::tempdir().unwrap();\n        let config_home = dir.path().join(\"xdg-config\");\n        let data_home = dir.path().join(\"xdg-data\");\n        let home_dir = dir.path().join(\"home\");\n        let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n        let models_dir = app_config_dir.join(\"models\");\n        let bin_dir = dir.path().join(\"bin\");\n        let work_dir = dir.path().join(\"work\");\n        let export_dir = dir.path().join(\"fake-opencode-export\");\n        fs::create_dir_all(&models_dir).unwrap();\n        fs::create_dir_all(&bin_dir).unwrap();\n        fs::create_dir_all(&work_dir).unwrap();\n        fs::create_dir_all(&export_dir).unwrap();\n        fs::create_dir_all(&home_dir).unwrap();\n        Self {\n            dir,\n            config_home,\n            data_home,\n            home_dir,\n            app_config_dir,\n            models_dir,\n            bin_dir,\n            work_dir,\n            export_dir,\n        }\n    }\n\n    fn app_data_dir(&self) -> PathBuf {\n        self.data_home.join(\"oulipoly-agent-runner\")\n    }\n\n    fn sidecar_path(&self) -> PathBuf {\n        self.app_data_dir().join(\"pid-identity.db\")\n    }\n\n    fn state_path(&self) -> PathBuf {\n        self.app_data_dir().join(\"state.db\")\n    }\n\n    fn run(&self, mut cmd: Command) -> Output {\n        cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n            .env(\"XDG_DATA_HOME\", &self.data_home)\n            .env(\"HOME\", &self.home_dir)\n            .env(\"PATH\", self.path_env())\n            .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n            .env(\"WAKE_CONFIRM_WORK_DIR\", &self.work_dir)\n            .env(\"WAKE_CONFIRM_EXPORT_DIR\", &self.export_dir)\n            .env_remove(\"OULIPOLY_DATA_DIR\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_SESSION_ID\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_TOKEN\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_COUNT\")\n            .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n            .current_dir(self.dir.path());\n        cmd.output().unwrap()\n    }\n\n    fn path_env(&self) -> String {\n        let current = std::env::var(\"PATH\").unwrap_or_default();\n        format!(\"{}:{current}\", self.bin_dir.display())\n    }\n\n    fn run_agent(&self, prompt: &str) -> Output {\n        let mut cmd = Command::new(runner_bin());\n        cmd.env(\"WAKE_CONFIRM_NO_NOTIFY\", \"1\")\n            .arg(\"-m\")\n            .arg(MODEL)\n            .arg(\"--models-dir\")\n            .arg(&self.models_dir)\n            .arg(prompt);\n        self.run(cmd)\n    }\n\n    fn run_resume_with_env(&self, envs: &[(&str, &str)]) -> Output {\n        let mut cmd = Command::new(runner_bin());\n        for (key, value) in envs {\n            cmd.env(key, value);\n        }\n        cmd.arg(\"resume\")\n            .arg(\"--session-id\")\n            .arg(SESSION)\n            .arg(\"-m\")\n            .arg(MODEL)\n            .arg(\"--models-dir\")\n            .arg(&self.models_dir);\n        self.run(cmd)\n    }\n\n    fn write_legacy_opencode(&self) {\n        self.write_executable(\"opencode\", fake_opencode_script());\n        self.write_executable(\"opencode-turns\", fake_opencode_turns_script());\n        fs::write(\n            self.models_dir.join(format!(\"{MODEL}.toml\")),\n            format!(\n                r#\"prompt_mode = \"arg\"\n\n[[providers]]\nname = \"{PROVIDER}\"\nargs = []\n\"#,\n            ),\n        )\n        .unwrap();\n        fs::write(\n            self.app_config_dir.join(\"providers.toml\"),\n            format!(\n                r#\"[{PROVIDER}]\ncommand = \"opencode\"\nargs = [\"run\"]\nprompt_mode = \"arg\"\n\n[{PROVIDER}.session_capture]\nkind = \"stdout_json_event\"\njson_args = [\"--json\"]\nevent_type = \"step_start\"\nevent_id_path = \"sessionID\"\n\n[{PROVIDER}.resume]\nkind = \"flag\"\nflag = \"--session\"\n\"#,\n            ),\n        )\n        .unwrap();\n        fs::write(\n            self.app_config_dir.join(\"sessions.toml\"),\n            format!(\n                r#\"[{PROVIDER}]\nturn_script = \"opencode-turns\"\nstate_dir = {}\n\"#,\n                toml_string(&path_string(&self.work_dir.join(\"turn-state\")))\n            ),\n        )\n        .unwrap();\n    }\n\n    fn write_executable(&self, name: &str, body: &str) -> PathBuf {\n        let path = self.bin_dir.join(name);\n        fs::write(&path, body).unwrap();\n        let mut perms = fs::metadata(&path).unwrap().permissions();\n        perms.set_mode(0o755);\n        fs::set_permissions(&path, perms).unwrap();\n        path\n    }\n\n    fn mailbox(&self) -> MailboxDb {\n        MailboxDb::open(&self.sidecar_path()).unwrap()\n    }\n\n    fn state(&self) -> StateDb {\n        StateDb::open(&self.state_path()).unwrap()\n    }\n\n    fn ensure_active_chain_for_legacy_session(&self) {\n        if self\n            .state()\n            .chain_id_for_segment(PROVIDER, SESSION)\n            .unwrap()\n            .is_some()\n        {\n            return;\n        }\n        let conn = Connection::open(self.state_path()).unwrap();\n        conn.execute(\n            \"INSERT INTO session_chains (chain_id, created_at, last_used_at, model_name)\n             VALUES (?1, '2026-06-07T00:00:00Z', '2026-06-07T00:00:00Z', ?2)\",\n            params![CHAIN_ID, MODEL],\n        )\n        .unwrap();\n        conn.execute(\n            \"INSERT INTO session_chain_segments\n                (chain_id, provider_name, session_id, started_at, transition_reason)\n             VALUES (?1, ?2, ?3, '2026-06-07T00:00:00Z', 'initial')\",\n            params![CHAIN_ID, PROVIDER, SESSION],\n        )\n        .unwrap();\n    }\n\n    fn seed_mailbox_notification(&self) {\n        let state_dir = self.work_dir.join(HANDLE);\n        fs::create_dir_all(&state_dir).unwrap();\n        let meta = state_dir.join(\"meta.json\");\n        let log = state_dir.join(\"log\");\n        let rc = state_dir.join(\"rc\");\n        fs::write(&meta, r#\"{\"caller_chain\":[]}\"#).unwrap();\n        fs::write(&log, \"legacy opencode workload completed\\n\").unwrap();\n        fs::write(&rc, \"0\\n\").unwrap();\n        let payload_json = serde_json::json!({\n            \"schema_version\": 1,\n            \"kind\": \"agent_bash_complete\",\n            \"handle\": HANDLE,\n            \"state_dir\": path_string(&state_dir),\n            \"meta_path\": path_string(&meta),\n            \"log_path\": path_string(&log),\n            \"rc_path\": path_string(&rc),\n            \"rc\": 0,\n        })\n        .to_string();\n        let mut mailbox = self.mailbox();\n        mailbox\n            .enqueue_agent_bash_complete(&AgentBashCompleteEnqueue {\n                session_id: SESSION,\n                handle: HANDLE,\n                payload_json: &payload_json,\n                owner_invocation_uuid: None,\n                matched_os_pid: None,\n                matched_os_boot_id: None,\n                matched_os_pid_starttime_ticks: None,\n                matched_chain_index: None,\n                state_dir: &path_string(&state_dir),\n                meta_path: &path_string(&meta),\n                log_path: &path_string(&log),\n                rc_path: &path_string(&rc),\n                rc: 0,\n            })\n            .unwrap();\n    }\n\n    fn notification_prompt_path(&self) -> PathBuf {\n        self.work_dir.join(\"legacy-wake-resumed.txt\")\n    }\n\n    fn export_path(&self) -> PathBuf {\n        self.export_dir.join(format!(\"{SESSION}.jsonl\"))\n    }\n\n    fn export_text(&self) -> String {\n        fs::read_to_string(self.export_path()).unwrap_or_default()\n    }\n\n    fn unconfirmed_invocation_count(&self) -> i64 {\n        Connection::open(self.state_path())\n            .unwrap()\n            .query_row(\n                \"SELECT COUNT(*) FROM invocations WHERE error_category = 'mailbox_delivery_unconfirmed'\",\n                [],\n                |row| row.get(0),\n            )\n            .unwrap()\n    }\n\n    fn assert_xdg_isolated(&self) {\n        assert!(\n            !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n            \"config must stay in isolated XDG_CONFIG_HOME\"\n        );\n        assert!(\n            !self\n                .home_dir\n                .join(\".local/share/oulipoly-agent-runner\")\n                .exists(),\n            \"state must stay in isolated XDG_DATA_HOME\"\n        );\n    }\n}\n\n#[test]\nfn legacy_opencode_resume_confirms_delivery_after_targeted_turn_ingest() {\n    let _guard = integration_test_guard();\n    let fixture = prepared_fixture();\n    fixture.seed_mailbox_notification();\n\n    let output = fixture.run_resume_with_env(&[]);\n    let prompt = wait_for_file(&fixture.notification_prompt_path());\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n    assert!(prompt.contains(\"handle: h-wake-confirm-legacy\"), \"{prompt}\");\n    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n    wait_until(\"fake opencode export contains delivery nonce\", || {\n        let exported = fixture.export_text();\n        exported.contains(\"[OULIPOLY NOTIFICATIONS]\") && exported.contains(\"[OULIPOLY-DELIVERY \")\n    });\n\n    assert_success(&output);\n    wait_until(\"legacy opencode delivery marked delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && rows[0].delivery_error.is_none()\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivered_by_invocation_uuid.is_some()\n    });\n    assert!(\n        !fixture\n            .state()\n            .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n            .unwrap(),\n        \"fixture should quote-wrap the delivered user body so exact-text confirmation stays red\"\n    );\n    assert!(\n        fixture\n            .state()\n            .has_session_user_turn_containing(\n                PROVIDER,\n                SESSION,\n                &delivery_nonce_from_prompt(&prompt)\n            )\n            .unwrap(),\n        \"session_turns should contain the delivery nonce in the quote-wrapped user body\"\n    );\n    assert_eq!(fixture.unconfirmed_invocation_count(), 0);\n    assert!(fixture.mailbox().list_pending(SESSION).unwrap().is_empty());\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn legacy_opencode_resume_leaves_mailbox_pending_when_ingested_turn_omits_delivery_nonce() {\n    let _guard = integration_test_guard();\n    let fixture = prepared_fixture();\n    fixture.seed_mailbox_notification();\n\n    let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\", \"1\")]);\n    assert_exit_code(&output, 1);\n    let prompt = wait_for_file(&fixture.notification_prompt_path());\n    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n    wait_until(\n        \"fake opencode export contains user turn without delivery nonce\",\n        || {\n            let exported = fixture.export_text();\n            exported.contains(\"[OULIPOLY NOTIFICATIONS]\")\n                && !exported.contains(\"[OULIPOLY-DELIVERY \")\n        },\n    );\n    wait_until(\n        \"nonce-less export leaves mailbox pending unconfirmed\",\n        || {\n            let db = fixture.mailbox();\n            let rows = db.list_mailbox(SESSION, true).unwrap();\n            rows.len() == 1\n                && rows[0].delivered_at.is_none()\n                && rows[0].delivery_attempts == 1\n                && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n                && rows[0].delivered_by_invocation_uuid.is_none()\n        },\n    );\n    assert!(\n        !fixture\n            .state()\n            .has_session_user_turn_containing(\n                PROVIDER,\n                SESSION,\n                &delivery_nonce_from_prompt(&prompt)\n            )\n            .unwrap(),\n        \"stored resume turn without the delivery nonce must not confirm delivery\"\n    );\n    assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn legacy_opencode_resume_leaves_mailbox_pending_when_export_omits_notification_turn() {\n    let _guard = integration_test_guard();\n    let fixture = prepared_fixture();\n    fixture.seed_mailbox_notification();\n\n    let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\", \"1\")]);\n    assert_exit_code(&output, 1);\n    let prompt = wait_for_file(&fixture.notification_prompt_path());\n    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n    wait_until(\"omitted export leaves mailbox pending unconfirmed\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_none()\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n            && rows[0].delivered_by_invocation_uuid.is_none()\n    });\n    assert!(\n        !fixture\n            .state()\n            .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n            .unwrap(),\n        \"omitted export must not create exact user-turn confirmation evidence\"\n    );\n    assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n    fixture.assert_xdg_isolated();\n}\n\nfn prepared_fixture() -> Fixture {\n    let fixture = Fixture::new();\n    fixture.write_legacy_opencode();\n    let output = fixture.run_agent(\"launch legacy opencode parent\");\n    assert_success(&output);\n    fixture.ensure_active_chain_for_legacy_session();\n    wait_until(\"legacy opencode parent runtime idle\", || {\n        fixture\n            .mailbox()\n            .session_runtime(SESSION)\n            .unwrap()\n            .is_some_and(|runtime| runtime.run_state == \"idle\")\n    });\n    fixture\n}\n\nfn fake_opencode_script() -> &'static str {\n    r#\"#!/usr/bin/env python3\nimport json\nimport os\nimport pathlib\nimport re\nimport sys\n\nSESSION = \"ses_wakeconfirmlegacy\"\n\ndef work_dir():\n    return pathlib.Path(os.environ[\"WAKE_CONFIRM_WORK_DIR\"])\n\ndef export_dir():\n    return pathlib.Path(os.environ[\"WAKE_CONFIRM_EXPORT_DIR\"])\n\ndef session_path(session_id):\n    return export_dir() / f\"{session_id}.jsonl\"\n\ndef next_turn_id(session_id, role):\n    path = session_path(session_id)\n    if not path.exists():\n        return f\"{role}-1\"\n    count = sum(1 for line in path.read_text(encoding=\"utf-8\").splitlines() if line.strip())\n    return f\"{role}-{count + 1}\"\n\ndef append_turn(session_id, role, text):\n    export_dir().mkdir(parents=True, exist_ok=True)\n    turn = {\n        \"session_id\": session_id,\n        \"turn_id\": next_turn_id(session_id, role),\n        \"timestamp\": \"2026-06-07T00:00:00Z\",\n        \"role\": role,\n        \"body\": [{\"type\": \"text\", \"text\": text}],\n    }\n    with session_path(session_id).open(\"a\", encoding=\"utf-8\") as handle:\n        handle.write(json.dumps(turn, separators=(\",\", \":\")) + \"\\n\")\n\ndef stored_resume_prompt(prompt):\n    if os.environ.get(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\") == \"1\":\n        prompt = re.sub(r\"^\\[OULIPOLY-DELIVERY [^\\n]*\\]\\n?\", \"\", prompt, flags=re.MULTILINE)\n    return f'\"{prompt}\"'\n\ndef parse_run(argv):\n    session_id = SESSION\n    prompt = \"\"\n    index = 0\n    while index < len(argv):\n        arg = argv[index]\n        if arg == \"--session\" and index + 1 < len(argv):\n            session_id = argv[index + 1]\n            index += 2\n            continue\n        if arg == \"--json\":\n            index += 1\n            continue\n        prompt = arg\n        index += 1\n    return session_id, prompt\n\ndef run(argv):\n    session_id, prompt = parse_run(argv)\n    if \"--session\" in argv:\n        (work_dir() / \"legacy-wake-resumed.txt\").write_text(prompt, encoding=\"utf-8\")\n        if os.environ.get(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\") != \"1\":\n            append_turn(session_id, \"user\", stored_resume_prompt(prompt))\n        append_turn(session_id, \"assistant\", \"legacy wake acknowledged\")\n        print(\"legacy wake acknowledged\", flush=True)\n        return 0\n    print(json.dumps({\"type\": \"step_start\", \"sessionID\": SESSION}), flush=True)\n    append_turn(SESSION, \"user\", prompt)\n    append_turn(SESSION, \"assistant\", \"legacy parent acknowledged\")\n    print(\"legacy parent acknowledged\", flush=True)\n    return 0\n\ndef export_session(argv):\n    session_id = argv[0] if argv else SESSION\n    path = session_path(session_id)\n    if path.exists():\n        sys.stdout.write(path.read_text(encoding=\"utf-8\"))\n    return 0\n\ndef main():\n    subcommand = sys.argv[1] if len(sys.argv) > 1 else \"\"\n    if subcommand == \"export\":\n        return export_session(sys.argv[2:])\n    if subcommand == \"run\":\n        return run(sys.argv[2:])\n    print(f\"unsupported fake opencode subcommand: {subcommand}\", file=sys.stderr)\n    return 64\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\"#\n}\n\nfn fake_opencode_turns_script() -> &'static str {\n    r#\"#!/usr/bin/env python3\nimport os\nimport subprocess\nimport sys\n\nsession_id = os.environ.get(\"SESSION_ID\")\nif not session_id:\n    raise SystemExit(0)\n\nresult = subprocess.run(\n    [\"opencode\", \"export\", session_id],\n    stdout=subprocess.PIPE,\n    stderr=subprocess.PIPE,\n    text=True,\n    check=False,\n)\nif result.returncode != 0:\n    sys.stderr.write(result.stderr)\n    raise SystemExit(result.returncode)\nsys.stdout.write(result.stdout)\n\"#\n}\n\nfn assert_success(output: &Output) {\n    assert_exit_code(output, 0);\n}\n\nfn assert_exit_code(output: &Output, expected: i32) {\n    assert_eq!(\n        output.status.code(),\n        Some(expected),\n        \"stdout={}\\nstderr={}\",\n        String::from_utf8_lossy(&output.stdout),\n        String::from_utf8_lossy(&output.stderr)\n    );\n}\n\nfn wait_for_file(path: &Path) -> String {\n    wait_for_path_exists(path);\n    fs::read_to_string(path).unwrap()\n}\n\nfn wait_for_path_exists(path: &Path) {\n    wait_until(&format!(\"{} exists\", path.display()), || path.exists());\n}\n\nfn wait_until(label: &str, mut predicate: impl FnMut() -> bool) {\n    let start = Instant::now();\n    while start.elapsed() < Duration::from_secs(10) {\n        if predicate() {\n            return;\n        }\n        std::thread::sleep(Duration::from_millis(50));\n    }\n    panic!(\"timed out waiting for {label}\");\n}\n\nfn delivery_nonce_from_prompt(prompt: &str) -> String {\n    let prefix = \"[OULIPOLY-DELIVERY \";\n    let start = prompt\n        .find(prefix)\n        .unwrap_or_else(|| panic!(\"prompt missing delivery nonce: {prompt}\"))\n        + prefix.len();\n    let rest = &prompt[start..];\n    let end = rest\n        .find(']')\n        .unwrap_or_else(|| panic!(\"prompt has unterminated delivery nonce: {prompt}\"));\n    rest[..end].to_string()\n}\n\nfn integration_test_lock() -> &'static Mutex<()> {\n    static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n    LOCK.get_or_init(|| Mutex::new(()))\n}\n\nfn integration_test_guard() -> MutexGuard<'static, ()> {\n    integration_test_lock()\n        .lock()\n        .unwrap_or_else(|poisoned| poisoned.into_inner())\n}\n\nfn runner_bin() -> &'static str {\n    env!(\"CARGO_BIN_EXE_oulipoly-agent-runner\")\n}\n\nfn path_string(path: &Path) -> String {\n    path.to_string_lossy().into_owned()\n}\n\nfn toml_string(value: &str) -> String {\n    serde_json::to_string(value).unwrap()\n}","lineStart":1,"lineEnd":655,"totalLines":655,"truncated":false}},"title":"src-tauri/tests/wake_confirm_legacy_opencode.rs","time":{"start":1780923371783,"end":1780923371996}},"metadata":{"openai":{"itemId":"fc_07cd687873b1706f016a26bbebae94819bade0d7e2a25f3cc6"}},"id":"prt_ea74e11010019Dif67MRXWPnwH","sessionID":"ses_158b3e351ffePkuQnC9kglvomy","messageID":"msg_ea74db39e001OUt7IFVSrgke4f"}}
{"type":"tool_use","timestamp":1780923372006,"sessionID":"ses_158b3e351ffePkuQnC9kglvomy","part":{"type":"tool","tool":"read","callID":"call_GVbl8NIlH2hs9Eu5RMbaHsMm","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/s11_external_provider_wake.rs","offset":1,"limit":1000},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/s11_external_provider_wake.rs</path>\n<type>file</type>\n<content>\n1: #![cfg(unix)]\n2: \n3: //! ## Declared roles\n4: //!\n5: //! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n6: //! predicate, filter.\n7: //!\n8: //! TEST: external-provider wake/resume end-to-end fixtures — fake provider\n9: //! CLI script formatters, fixture model mappers, state/sidecar accessors,\n10: //! JSON/record parsers, pending-delivery predicates and filters, durable row\n11: //! validators, and test orchestration.\n12: //!\n13: //! ## Adapter declarations\n14: //!\n15: //! ```yaml\n16: //! adapter_declarations:\n17: //!   - component: src-tauri/tests/s11_external_provider_wake.rs\n18: //!     role: adapter\n19: //!     Translates:\n20: //!       - external-provider-runtime-cli-contract\n21: //!       - wake-notification-delivery-contract\n22: //!       - pid-identity-sidecar-contract\n23: //!       - invocation-state-db-contract\n24: //!       - test-fixture-process-contract\n25: //! intrinsic_surface_declarations:\n26: //!   - component: src-tauri/tests/s11_external_provider_wake.rs\n27: //!     role: intrinsic-surface\n28: //!     Domain: external-provider wake CLI regression suite\n29: //!     Owns:\n30: //!       - isolated config/data fixture materialization\n31: //!       - external provider Python script generation and executable setup\n32: //!       - wake command invocation and environment isolation\n33: //!       - provider record parsing and subcommand filtering assertions\n34: //!       - sidecar wake-claim and mailbox delivery assertions\n35: //! ```\n36: \n37: use oulipoly_state::mailbox::MailboxDb;\n38: use rusqlite::{Connection, params};\n39: use serde_json::Value;\n40: use std::fs;\n41: use std::os::unix::fs::PermissionsExt;\n42: use std::path::{Path, PathBuf};\n43: use std::process::{Command, Output};\n44: use std::time::{Duration, Instant};\n45: \n46: const MODEL: &str = \"s11-external-wake-model\";\n47: const PROVIDER: &str = \"opencode\";\n48: const SESSION: &str = \"ses_s11externalwake\";\n49: const HANDLE: &str = \"h-s11-external\";\n50: \n51: struct Fixture {\n52:     dir: tempfile::TempDir,\n53:     config_home: PathBuf,\n54:     data_home: PathBuf,\n55:     home_dir: PathBuf,\n56:     app_config_dir: PathBuf,\n57:     models_dir: PathBuf,\n58:     work_dir: PathBuf,\n59: }\n60: \n61: impl Fixture {\n62:     fn new() -> Self {\n63:         let dir = tempfile::tempdir().unwrap();\n64:         let config_home = dir.path().join(\"xdg-config\");\n65:         let data_home = dir.path().join(\"xdg-data\");\n66:         let home_dir = dir.path().join(\"home\");\n67:         let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n68:         let models_dir = app_config_dir.join(\"models\");\n69:         let work_dir = dir.path().join(\"work\");\n70:         fs::create_dir_all(&models_dir).unwrap();\n71:         fs::create_dir_all(&home_dir).unwrap();\n72:         fs::create_dir_all(&work_dir).unwrap();\n73:         Self {\n74:             dir,\n75:             config_home,\n76:             data_home,\n77:             home_dir,\n78:             app_config_dir,\n79:             models_dir,\n80:             work_dir,\n81:         }\n82:     }\n83: \n84:     fn sidecar_path(&self) -> PathBuf {\n85:         self.data_home\n86:             .join(\"oulipoly-agent-runner\")\n87:             .join(\"pid-identity.db\")\n88:     }\n89: \n90:     fn state_path(&self) -> PathBuf {\n91:         self.data_home\n92:             .join(\"oulipoly-agent-runner\")\n93:             .join(\"state.db\")\n94:     }\n95: \n96:     fn run(&self, mut cmd: Command) -> Output {\n97:         cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n98:             .env(\"XDG_DATA_HOME\", &self.data_home)\n99:             .env(\"HOME\", &self.home_dir)\n100:             .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n101:             .env(\"S11_WORK_DIR\", &self.work_dir)\n102:             .env_remove(\"OULIPOLY_DATA_DIR\")\n103:             .env_remove(\"OULIPOLY_AUTO_WAKE\")\n104:             .env_remove(\"OULIPOLY_AUTO_WAKE_SESSION_ID\")\n105:             .env_remove(\"OULIPOLY_AUTO_WAKE_TOKEN\")\n106:             .env_remove(\"OULIPOLY_AUTO_WAKE_COUNT\")\n107:             .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n108:             .current_dir(self.dir.path());\n109:         cmd.output().unwrap()\n110:     }\n111: \n112:     fn run_agent(&self, prompt: &str) -> Output {\n113:         self.run_agent_with_env(prompt, &[])\n114:     }\n115: \n116:     fn run_agent_with_env(&self, prompt: &str, envs: &[(&str, &str)]) -> Output {\n117:         let mut cmd = Command::new(runner_bin());\n118:         for (key, value) in envs {\n119:             cmd.env(key, value);\n120:         }\n121:         cmd.arg(\"-m\")\n122:             .arg(MODEL)\n123:             .arg(\"--models-dir\")\n124:             .arg(&self.models_dir)\n125:             .arg(prompt);\n126:         self.run(cmd)\n127:     }\n128: \n129:     fn write_external_provider(&self) {\n130:         let provider_path = self.write_external_provider_script();\n131:         let turn_script_path = self.write_turn_script();\n132:         fs::write(\n133:             self.models_dir.join(format!(\"{MODEL}.toml\")),\n134:             format!(\n135:                 r#\"provider = {{ path = {} }}\n136: prompt_mode = \"arg\"\n137: \n138: [[providers]]\n139: name = \"{PROVIDER}\"\n140: args = []\n141: \"#,\n142:                 toml_string(&path_string(&provider_path))\n143:             ),\n144:         )\n145:         .unwrap();\n146:         fs::write(\n147:             self.app_config_dir.join(\"providers.toml\"),\n148:             format!(\n149:                 r#\"[{PROVIDER}]\n150: command = \"fixture-opencode\"\n151: args = []\n152: prompt_mode = \"arg\"\n153: \"#\n154:             ),\n155:         )\n156:         .unwrap();\n157:         fs::write(\n158:             self.app_config_dir.join(\"sessions.toml\"),\n159:             format!(\n160:                 r#\"[{PROVIDER}]\n161: turn_script = {}\n162: \"#,\n163:                 toml_string(&path_string(&turn_script_path))\n164:             ),\n165:         )\n166:         .unwrap();\n167:     }\n168: \n169:     fn write_external_provider_script(&self) -> PathBuf {\n170:         let path = self.dir.path().join(\"external-provider.py\");\n171:         fs::write(&path, external_provider_script()).unwrap();\n172:         let mut perms = fs::metadata(&path).unwrap().permissions();\n173:         perms.set_mode(0o755);\n174:         fs::set_permissions(&path, perms).unwrap();\n175:         path\n176:     }\n177: \n178:     fn write_turn_script(&self) -> PathBuf {\n179:         let path = self.dir.path().join(\"s11-turns.py\");\n180:         fs::write(&path, turn_script()).unwrap();\n181:         let mut perms = fs::metadata(&path).unwrap().permissions();\n182:         perms.set_mode(0o755);\n183:         fs::set_permissions(&path, perms).unwrap();\n184:         path\n185:     }\n186: \n187:     fn mailbox(&self) -> MailboxDb {\n188:         MailboxDb::open(&self.sidecar_path()).unwrap()\n189:     }\n190: \n191:     fn sidecar_conn(&self) -> Connection {\n192:         Connection::open(self.sidecar_path()).unwrap()\n193:     }\n194: \n195:     fn finalized_invocation_count(&self) -> i64 {\n196:         Connection::open(self.state_path())\n197:             .unwrap()\n198:             .query_row(\n199:                 \"SELECT COUNT(*) FROM invocations WHERE finished_at IS NOT NULL\",\n200:                 [],\n201:                 |row| row.get(0),\n202:             )\n203:             .unwrap()\n204:     }\n205: \n206:     fn pid_identity_session_id_for_provider(&self, provider_name: &str) -> Option<String> {\n207:         self.sidecar_conn()\n208:             .query_row(\n209:                 \"SELECT session_id\n210:                  FROM pid_identity\n211:                  WHERE provider_name = ?1\n212:                  ORDER BY recorded_at DESC, os_pid DESC\n213:                  LIMIT 1\",\n214:                 params![provider_name],\n215:                 |row| row.get(0),\n216:             )\n217:             .ok()\n218:     }\n219: \n220:     fn prompt_file(&self, name: &str) -> PathBuf {\n221:         self.work_dir.join(name)\n222:     }\n223: \n224:     fn assert_xdg_isolated(&self) {\n225:         assert!(\n226:             !self\n227:                 .home_dir\n228:                 .join(\".local/share/oulipoly-agent-runner\")\n229:                 .exists(),\n230:             \"state must stay in isolated XDG_DATA_HOME\"\n231:         );\n232:         assert!(\n233:             !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n234:             \"config must stay in isolated XDG_CONFIG_HOME\"\n235:         );\n236:     }\n237: }\n238: \n239: #[test]\n240: fn external_provider_launch_notify_uses_captured_sidecar_owner_and_wakes() {\n241:     let fixture = Fixture::new();\n242:     fixture.write_external_provider();\n243: \n244:     let output = fixture.run_agent(\"dispatch external provider wake\");\n245:     assert_success(&output);\n246: \n247:     wait_until(\"pid identity backfilled with captured session\", || {\n248:         fixture\n249:             .pid_identity_session_id_for_provider(PROVIDER)\n250:             .as_deref()\n251:             == Some(SESSION)\n252:     });\n253:     let (notify_json, notify) =\n254:         wait_for_json_file(&fixture.work_dir.join(HANDLE).join(\"notify.json\"));\n255:     let (_, notify_env) =\n256:         wait_for_json_file(&fixture.work_dir.join(HANDLE).join(\"notify-env.json\"));\n257:     assert_eq!(\n258:         notify_env.get(\"xdg_config_home\").and_then(Value::as_str),\n259:         None\n260:     );\n261:     assert_eq!(\n262:         notify_env.get(\"xdg_data_home\").and_then(Value::as_str),\n263:         None\n264:     );\n265:     assert_eq!(\n266:         notify_env.get(\"oulipoly_data_dir\").and_then(Value::as_str),\n267:         Some(path_string(&fixture.data_home.join(\"oulipoly-agent-runner\")).as_str())\n268:     );\n269:     assert_eq!(\n270:         notify.get(\"status\").and_then(Value::as_str),\n271:         Some(\"enqueued\"),\n272:         \"notify response: {notify_json}\"\n273:     );\n274:     assert_eq!(notify.get(\"enqueued\").and_then(Value::as_bool), Some(true));\n275:     assert_eq!(\n276:         notify.get(\"owner_session_id\").and_then(Value::as_str),\n277:         Some(SESSION)\n278:     );\n279:     assert_eq!(\n280:         notify.get(\"session_source\").and_then(Value::as_str),\n281:         Some(\"sidecar_session_id\")\n282:     );\n283:     assert_eq!(\n284:         notify\n285:             .get(\"wake\")\n286:             .and_then(|wake| wake.get(\"status\"))\n287:             .and_then(Value::as_str),\n288:         Some(\"spawned\"),\n289:         \"notify response: {notify_json}\"\n290:     );\n291:     let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n292:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n293:     assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n294:     assert!(prompt.contains(\"handle: h-s11-external\"), \"{prompt}\");\n295:     wait_until(\"external provider wake delivered\", || {\n296:         let db = fixture.mailbox();\n297:         let rows = db.list_mailbox(SESSION, true).unwrap();\n298:         rows.len() == 1\n299:             && rows[0].delivered_at.is_some()\n300:             && rows[0].owner_invocation_uuid.is_some()\n301:             && rows[0].matched_os_pid.is_some()\n302:             && rows[0].matched_chain_index == Some(0)\n303:             && db.wake_claim(SESSION).unwrap().is_none()\n304:     });\n305:     let runtime = fixture.mailbox().session_runtime(SESSION).unwrap().unwrap();\n306:     assert_eq!(runtime.run_state, \"idle\");\n307:     let expected_models_dir = path_string(&fixture.models_dir);\n308:     assert_eq!(\n309:         runtime.models_dir.as_deref(),\n310:         Some(expected_models_dir.as_str()),\n311:         \"detached wake must reload the same models directory as the original external launch\"\n312:     );\n313:     fixture.assert_xdg_isolated();\n314: }\n315: \n316: #[test]\n317: fn external_provider_runtime_uses_ingested_session_when_launch_capture_missing() {\n318:     let fixture = Fixture::new();\n319:     fixture.write_external_provider();\n320: \n321:     let output = fixture.run_agent_with_env(\n322:         \"dispatch external provider without launch session capture\",\n323:         &[(\"S11_NO_NOTIFY\", \"1\"), (\"S11_OMIT_EXIT_SESSION\", \"1\")],\n324:     );\n325:     assert_success(&output);\n326: \n327:     wait_until(\"initial invocation finalized\", || {\n328:         fixture.finalized_invocation_count() >= 1\n329:     });\n330:     let runtime = fixture.mailbox().session_runtime(SESSION).unwrap().unwrap();\n331:     let expected_models_dir = path_string(&fixture.models_dir);\n332:     assert_eq!(runtime.run_state, \"idle\");\n333:     assert_eq!(runtime.provider_name.as_deref(), Some(PROVIDER));\n334:     assert_eq!(runtime.model_name.as_deref(), Some(MODEL));\n335:     assert_eq!(\n336:         runtime.models_dir.as_deref(),\n337:         Some(expected_models_dir.as_str())\n338:     );\n339:     fixture.assert_xdg_isolated();\n340: }\n341: \n342: #[test]\n343: fn external_provider_wake_does_not_mark_delivered_when_resume_produces_no_turn() {\n344:     let fixture = Fixture::new();\n345:     fixture.write_external_provider();\n346: \n347:     let output = fixture.run_agent_with_env(\n348:         \"dispatch external provider wake dropped payload\",\n349:         &[\n350:             (\"S11_DROP_RESUME_PAYLOAD\", \"1\"),\n351:             (\"OULIPOLY_AUTO_WAKE_MAX\", \"1\"),\n352:         ],\n353:     );\n354:     assert_success(&output);\n355: \n356:     let _dropped = wait_for_file(&fixture.prompt_file(\"external-wake-dropped.txt\"));\n357:     wait_until(\"failed wake released claim and recorded attempt\", || {\n358:         let db = fixture.mailbox();\n359:         let rows = db.list_mailbox(SESSION, true).unwrap();\n360:         rows.len() == 1\n361:             && rows[0].delivery_attempts == 1\n362:             && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n363:             && db.wake_claim(SESSION).unwrap().is_none()\n364:     });\n365: \n366:     let db = fixture.mailbox();\n367:     let rows = db.list_mailbox(SESSION, true).unwrap();\n368:     assert_eq!(rows.len(), 1, \"rows: {rows:?}\");\n369:     assert!(\n370:         rows[0].delivered_at.is_none(),\n371:         \"dropped resume payload must not mark mailbox delivered: {rows:?}\"\n372:     );\n373:     assert_eq!(db.list_pending(SESSION).unwrap().len(), 1);\n374:     assert!(\n375:         !fixture.prompt_file(\"external-wake-resumed.txt\").exists(),\n376:         \"drop mode must not write the payload-bearing resume file\"\n377:     );\n378:     fixture.assert_xdg_isolated();\n379: }\n380: \n381: #[test]\n382: fn external_provider_wake_confirms_delivery_from_submitted_turn_marker() {\n383:     let fixture = Fixture::new();\n384:     fixture.write_external_provider();\n385: \n386:     let output = fixture.run_agent_with_env(\n387:         \"dispatch external provider wake confirmed by marker\",\n388:         &[\n389:             (\"S11_EMIT_SUBMITTED_TURN_MARKER\", \"1\"),\n390:             (\"S11_EXPORT_REFORMATS_PROMPT\", \"1\"),\n391:             (\"S11_SKIP_SCAN_WAKE_TURN\", \"1\"),\n392:         ],\n393:     );\n394:     assert_success(&output);\n395: \n396:     let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n397:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n398:     assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n399:     let exported = wait_for_file(&fixture.prompt_file(\"external-wake-export.txt\"));\n400:     assert_ne!(exported, prompt);\n401:     assert!(exported.contains(\"[OULIPOLY-DELIVERY \"), \"{exported}\");\n402:     wait_until(\"submitted-turn marker delivered pending mailbox\", || {\n403:         let db = fixture.mailbox();\n404:         let rows = db.list_mailbox(SESSION, true).unwrap();\n405:         rows.len() == 1\n406:             && rows[0].delivered_at.is_some()\n407:             && rows[0].delivery_attempts == 1\n408:             && rows[0].delivery_error.is_none()\n409:             && db.wake_claim(SESSION).unwrap().is_none()\n410:     });\n411:     fixture.assert_xdg_isolated();\n412: }\n413: \n414: #[test]\n415: fn external_provider_wake_ignores_submitted_turn_marker_for_different_payload() {\n416:     let fixture = Fixture::new();\n417:     fixture.write_external_provider();\n418: \n419:     let output = fixture.run_agent_with_env(\n420:         \"dispatch external provider wake mismatched marker\",\n421:         &[\n422:             (\"S11_EMIT_SUBMITTED_TURN_MARKER\", \"1\"),\n423:             (\"S11_MARKER_PROMPT_SHA_MISMATCH\", \"1\"),\n424:             (\"S11_MARKER_DELIVERY_NONCE_MISMATCH\", \"1\"),\n425:             (\"S11_SKIP_SCAN_WAKE_TURN\", \"1\"),\n426:             (\"OULIPOLY_AUTO_WAKE_MAX\", \"1\"),\n427:         ],\n428:     );\n429:     assert_success(&output);\n430: \n431:     let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n432:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n433:     wait_until(\n434:         \"mismatched submitted-turn marker leaves mailbox pending\",\n435:         || {\n436:             let db = fixture.mailbox();\n437:             let rows = db.list_mailbox(SESSION, true).unwrap();\n438:             rows.len() == 1\n439:                 && rows[0].delivered_at.is_none()\n440:                 && rows[0].delivery_attempts == 1\n441:                 && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n442:                 && db.wake_claim(SESSION).unwrap().is_none()\n443:         },\n444:     );\n445:     fixture.assert_xdg_isolated();\n446: }\n447: \n448: #[test]\n449: fn external_provider_failed_wake_releases_claim_and_retries_pending_mailbox() {\n450:     let fixture = Fixture::new();\n451:     fixture.write_external_provider();\n452: \n453:     let output = fixture.run_agent_with_env(\n454:         \"dispatch external provider wake first dropped payload\",\n455:         &[\n456:             (\"S11_DROP_FIRST_RESUME_PAYLOAD\", \"1\"),\n457:             (\"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\", \"1000\"),\n458:         ],\n459:     );\n460:     assert_success(&output);\n461: \n462:     let _dropped = wait_for_file(&fixture.prompt_file(\"external-wake-dropped.txt\"));\n463:     wait_until(\"first failed wake released claim\", || {\n464:         let db = fixture.mailbox();\n465:         let rows = db.list_mailbox(SESSION, true).unwrap();\n466:         rows.len() == 1\n467:             && rows[0].delivered_at.is_none()\n468:             && rows[0].delivery_attempts == 1\n469:             && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n470:             && db.wake_claim(SESSION).unwrap().is_none()\n471:     });\n472: \n473:     let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n474:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n475:     wait_until(\"retried wake delivered pending mailbox\", || {\n476:         let db = fixture.mailbox();\n477:         let rows = db.list_mailbox(SESSION, true).unwrap();\n478:         rows.len() == 1\n479:             && rows[0].delivered_at.is_some()\n480:             && rows[0].delivery_attempts == 2\n481:             && rows[0].delivery_error.is_none()\n482:             && db.wake_claim(SESSION).unwrap().is_none()\n483:     });\n484:     fixture.assert_xdg_isolated();\n485: }\n486: \n487: #[test]\n488: fn external_provider_rate_limited_wake_records_error_and_retries_pending_mailbox() {\n489:     let fixture = Fixture::new();\n490:     fixture.write_external_provider();\n491: \n492:     let output = fixture.run_agent_with_env(\n493:         \"dispatch external provider wake first rate limited\",\n494:         &[\n495:             (\"S11_RATE_LIMIT_FIRST_RESUME\", \"1\"),\n496:             (\"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\", \"1000\"),\n497:         ],\n498:     );\n499:     assert_success(&output);\n500: \n501:     let _rate_limited = wait_for_file(&fixture.prompt_file(\"external-wake-rate-limited.txt\"));\n502:     wait_until(\"rate-limited wake released claim\", || {\n503:         let db = fixture.mailbox();\n504:         let rows = db.list_mailbox(SESSION, true).unwrap();\n505:         rows.len() == 1\n506:             && rows[0].delivered_at.is_none()\n507:             && rows[0].delivery_attempts == 1\n508:             && rows[0].delivery_error.as_deref() == Some(\"rate_limited\")\n509:             && db.wake_claim(SESSION).unwrap().is_none()\n510:     });\n511: \n512:     let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n513:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n514:     wait_until(\"rate-limited wake retry delivered pending mailbox\", || {\n515:         let db = fixture.mailbox();\n516:         let rows = db.list_mailbox(SESSION, true).unwrap();\n517:         rows.len() == 1\n518:             && rows[0].delivered_at.is_some()\n519:             && rows[0].delivery_attempts == 2\n520:             && rows[0].delivery_error.is_none()\n521:             && db.wake_claim(SESSION).unwrap().is_none()\n522:     });\n523:     fixture.assert_xdg_isolated();\n524: }\n525: \n526: #[test]\n527: fn external_provider_policy_rejection_terminal_signal_excerpt_includes_diagnostics() {\n528:     let fixture = Fixture::new();\n529:     fixture.write_external_provider();\n530: \n531:     let output = fixture.run_agent_with_env(\n532:         \"dispatch external provider reject\",\n533:         &[(\"S11_POLICY_REJECT\", \"1\")],\n534:     );\n535: \n536:     assert_ne!(output.status.code(), Some(0), \"{output:?}\");\n537:     let stderr = String::from_utf8_lossy(&output.stderr);\n538:     let marker = terminal_signal_marker(&stderr);\n539:     let excerpt = marker\n540:         .get(\"evidence\")\n541:         .and_then(|evidence| evidence.get(\"excerpt\"))\n542:         .and_then(Value::as_str)\n543:         .expect(\"terminal-signal marker should include evidence excerpt\");\n544:     assert!(excerpt.contains(\"policy rejected\"), \"{excerpt}\");\n545:     assert!(excerpt.contains(\"s11_policy_reject\"), \"{excerpt}\");\n546:     assert!(excerpt.contains(\"params.launch.argv\"), \"{excerpt}\");\n547:     assert!(excerpt.contains(\"s11 fixture rejected policy\"), \"{excerpt}\");\n548:     fixture.assert_xdg_isolated();\n549: }\n550: \n551: fn external_provider_script() -> &'static str {\n552:     r#\"#!/usr/bin/env python3\n553: import base64\n554: import hashlib\n555: import json\n556: import os\n557: import pathlib\n558: import subprocess\n559: import sys\n560: import time\n561: \n562: CONTRACT = \"oulipoly.provider/v1\"\n563: SESSION = \"ses_s11externalwake\"\n564: HANDLE = \"h-s11-external\"\n565: \n566: def request_id(request):\n567:     return request.get(\"request_id\", \"s11-request\")\n568: \n569: def envelope(request, result):\n570:     return {\n571:         \"contract\": request.get(\"contract\", CONTRACT),\n572:         \"request_id\": request_id(request),\n573:         \"ok\": True,\n574:         \"result\": result,\n575:     }\n576: \n577: def describe(request):\n578:     terminal_capability = os.environ.get(\"S11_RATE_LIMIT_FIRST_RESUME\") == \"1\"\n579:     return envelope(request, {\n580:         \"provider_id\": \"s11-external-provider-wake-fixture\",\n581:         \"display_name\": \"S11 External Provider Wake Fixture\",\n582:         \"contract_versions\": [CONTRACT],\n583:         \"preferred_contract\": CONTRACT,\n584:         \"capabilities\": {\n585:             \"launch\": True,\n586:             \"policy\": True,\n587:             \"quota\": False,\n588:             \"session\": True,\n589:             \"terminal\": terminal_capability,\n590:             \"rotation\": False,\n591:             \"discovery\": False,\n592:             \"settings\": False,\n593:             \"setup_brain\": False,\n594:             \"setup\": False,\n595:             \"migration\": False,\n596:         },\n597:     })\n598: \n599: def policy_evaluate(request):\n600:     if os.environ.get(\"S11_POLICY_REJECT\") == \"1\":\n601:         return envelope(request, {\n602:             \"accepted\": False,\n603:             \"env\": {},\n604:             \"stdin\": None,\n605:             \"prompt\": None,\n606:             \"diagnostics\": [{\n607:                 \"severity\": \"error\",\n608:                 \"code\": \"s11_policy_reject\",\n609:                 \"path\": \"params.launch.argv\",\n610:                 \"message\": \"s11 fixture rejected policy\",\n611:             }],\n612:             \"markers\": [],\n613:         })\n614:     return envelope(request, {\n615:         \"accepted\": True,\n616:         \"env\": {},\n617:         \"stdin\": None,\n618:         \"prompt\": None,\n619:         \"diagnostics\": [],\n620:         \"markers\": [],\n621:     })\n622: \n623: def emit(event):\n624:     print(json.dumps(event, separators=(\",\", \":\")), flush=True)\n625: \n626: def stdout_event(request, seq, payload):\n627:     return {\n628:         \"contract\": CONTRACT,\n629:         \"request_id\": request_id(request),\n630:         \"seq\": seq,\n631:         \"time_unix_ms\": 1000 + seq,\n632:         \"kind\": \"stdout\",\n633:         \"data_base64\": base64.b64encode(payload.encode(\"utf-8\")).decode(\"ascii\"),\n634:     }\n635: \n636: def delivery_nonce(text):\n637:     prefix = \"[OULIPOLY-DELIVERY \"\n638:     start = text.find(prefix)\n639:     if start < 0:\n640:         return None\n641:     start += len(prefix)\n642:     end = text.find(\"]\", start)\n643:     if end < 0:\n644:         return None\n645:     nonce = text[start:end].strip()\n646:     return nonce or None\n647: \n648: def delivery_marker(nonce):\n649:     return f\"[OULIPOLY-DELIVERY {nonce}]\"\n650: \n651: def simulated_export_text(prompt):\n652:     nonce = delivery_nonce(prompt)\n653:     if os.environ.get(\"S11_EXPORT_REFORMATS_PROMPT\") == \"1\" and nonce:\n654:         exported = (\n655:             \"Notifications delivered:\\n\"\n656:             f\"- agent_bash_complete {HANDLE}\\n\\n\"\n657:             f\"{delivery_marker(nonce)}\\n\"\n658:         )\n659:         target = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"external-wake-export.txt\"\n660:         target.write_text(exported, encoding=\"utf-8\")\n661:         return exported\n662:     return prompt\n663: \n664: def submitted_turn_marker_event(request, seq, session_id, prompt):\n665:     exported = simulated_export_text(prompt)\n666:     prompt_sha = hashlib.sha256(prompt.encode(\"utf-8\")).hexdigest()\n667:     if os.environ.get(\"S11_MARKER_PROMPT_SHA_MISMATCH\") == \"1\":\n668:         prompt_sha = hashlib.sha256(b\"different payload\").hexdigest()\n669:     nonce = delivery_nonce(exported)\n670:     if os.environ.get(\"S11_MARKER_DELIVERY_NONCE_MISMATCH\") == \"1\":\n671:         nonce = \"different-delivery-nonce\"\n672:     value = {\n673:         \"provider_session_id\": session_id,\n674:         \"prompt_sha256\": prompt_sha,\n675:         \"source\": \"s11.fixture\",\n676:         \"message_id\": \"msg-s11-submitted\",\n677:     }\n678:     if nonce:\n679:         value[\"delivery_nonce\"] = nonce\n680:     return {\n681:         \"contract\": CONTRACT,\n682:         \"request_id\": request_id(request),\n683:         \"seq\": seq,\n684:         \"time_unix_ms\": 1000 + seq,\n685:         \"kind\": \"marker\",\n686:         \"name\": \"oulipoly.submitted_user_turn\",\n687:         \"value\": value,\n688:     }\n689: \n690: def exit_event(request, seq, session_id):\n691:     event = {\n692:         \"contract\": CONTRACT,\n693:         \"request_id\": request_id(request),\n694:         \"seq\": seq,\n695:         \"time_unix_ms\": 1000 + seq,\n696:         \"kind\": \"exit\",\n697:         \"status\": {\"kind\": \"exited\", \"code\": 0},\n698:         \"terminal_signal\": {\n699:             \"kind\": \"clean_exit\",\n700:             \"evidence\": \"fixture clean exit\",\n701:             \"observed_at_unix_ms\": 1000 + seq,\n702:         },\n703:     }\n704:     if session_id:\n705:         event[\"session\"] = {\n706:             \"provider_session_id\": session_id,\n707:             \"state\": {\"cursor\": \"after-launch\"},\n708:         }\n709:     return event\n710: \n711: def provider_identity():\n712:     pid = os.getpid()\n713:     boot_id = pathlib.Path(\"/proc/sys/kernel/random/boot_id\").read_text(encoding=\"utf-8\").strip()\n714:     stat = pathlib.Path(f\"/proc/{pid}/stat\").read_text(encoding=\"utf-8\")\n715:     after = stat.rsplit(\") \", 1)[1]\n716:     start_ticks = int(after.split()[19])\n717:     return pid, boot_id, start_ticks\n718: \n719: def spawn_notify_workload():\n720:     pid, boot_id, start_ticks = provider_identity()\n721:     subprocess.Popen(\n722:         [sys.executable, __file__, \"notify-helper\", str(pid), boot_id, str(start_ticks)],\n723:         stdin=subprocess.DEVNULL,\n724:         stdout=subprocess.DEVNULL,\n725:         stderr=subprocess.DEVNULL,\n726:         start_new_session=True,\n727:         env=os.environ.copy(),\n728:     )\n729: \n730: def launch(request):\n731:     params = request.get(\"params\", {})\n732:     known = params.get(\"session\", {}).get(\"known_provider_session_id\")\n733:     prompt = params.get(\"model\", {}).get(\"inputs\", {}).get(\"prompt\", \"\")\n734:     if known:\n735:         if os.environ.get(\"S11_RATE_LIMIT_FIRST_RESUME\") == \"1\":\n736:             count_path = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"resume-count.txt\"\n737:             count = int(count_path.read_text(encoding=\"utf-8\")) if count_path.exists() else 0\n738:             count_path.write_text(str(count + 1), encoding=\"utf-8\")\n739:             if count == 0:\n740:                 target = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"external-wake-rate-limited.txt\"\n741:                 target.write_text(\"rate limited\\n\", encoding=\"utf-8\")\n742:                 emit(stdout_event(request, 1, \"HTTP 429 rate_limit_error\\n\"))\n743:                 emit(exit_event(request, 2, known))\n744:                 return\n745:         if os.environ.get(\"S11_DROP_FIRST_RESUME_PAYLOAD\") == \"1\":\n746:             count_path = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"resume-count.txt\"\n747:             count = int(count_path.read_text(encoding=\"utf-8\")) if count_path.exists() else 0\n748:             count_path.write_text(str(count + 1), encoding=\"utf-8\")\n749:             if count == 0:\n750:                 target = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"external-wake-dropped.txt\"\n751:                 target.write_text(\"dropped\\n\", encoding=\"utf-8\")\n752:                 emit(stdout_event(request, 1, \"dropped\\n\"))\n753:                 emit(exit_event(request, 2, known))\n754:                 return\n755:         if os.environ.get(\"S11_DROP_RESUME_PAYLOAD\") == \"1\":\n756:             target = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"external-wake-dropped.txt\"\n757:             target.write_text(\"dropped\\n\", encoding=\"utf-8\")\n758:             emit(stdout_event(request, 1, \"dropped\\n\"))\n759:             emit(exit_event(request, 2, known))\n760:             return\n761:         target = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"external-wake-resumed.txt\"\n762:         target.write_text(prompt, encoding=\"utf-8\")\n763:         emit(stdout_event(request, 1, \"resumed\\n\"))\n764:         if os.environ.get(\"S11_SKIP_SCAN_WAKE_TURN\") == \"1\":\n765:             (pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"skip-scan-wake-turn.txt\").write_text(\"skip\\n\", encoding=\"utf-8\")\n766:         if os.environ.get(\"S11_EMIT_SUBMITTED_TURN_MARKER\") == \"1\":\n767:             emit(submitted_turn_marker_event(request, 2, known, prompt))\n768:             emit(exit_event(request, 3, known))\n769:         else:\n770:             emit(exit_event(request, 2, known))\n771:         return\n772:     if os.environ.get(\"S11_NO_NOTIFY\") != \"1\":\n773:         spawn_notify_workload()\n774:     emit(stdout_event(request, 1, \"initial\\n\"))\n775:     session_id = None if os.environ.get(\"S11_OMIT_EXIT_SESSION\") == \"1\" else SESSION\n776:     emit(exit_event(request, 2, session_id))\n777: \n778: def session_id_from_request(request):\n779:     params = request.get(\"params\", {})\n780:     extra = params.get(\"extra\", {})\n781:     return params.get(\"session_id\") or extra.get(\"start_bound_provider_session_id\") or SESSION\n782: \n783: def read_turns(request):\n784:     session_id = session_id_from_request(request)\n785:     return envelope(request, {\n786:         \"turns\": [{\n787:             \"session_id\": session_id,\n788:             \"turn_id\": \"turn-s11-external-wake\",\n789:             \"role\": \"assistant\",\n790:             \"timestamp\": \"2026-06-06T00:00:00Z\",\n791:             \"body\": [{\"type\": \"text\", \"text\": \"fixture turn\"}],\n792:         }],\n793:         \"turn_count\": 1,\n794:         \"complete\": True,\n795:     })\n796: \n797: def capture(request):\n798:     return envelope(request, {\n799:         \"provider_session_id\": session_id_from_request(request),\n800:         \"state\": {\"captured\": True},\n801:         \"artifacts\": [],\n802:     })\n803: \n804: def terminal_classify(request):\n805:     count_path = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"resume-count.txt\"\n806:     first_rate_limited_resume = (\n807:         os.environ.get(\"S11_RATE_LIMIT_FIRST_RESUME\") == \"1\"\n808:         and count_path.exists()\n809:         and count_path.read_text(encoding=\"utf-8\").strip() == \"1\"\n810:     )\n811:     if first_rate_limited_resume:\n812:         kind = \"rate_limited\"\n813:         evidence = \"HTTP 429 rate_limit_error\"\n814:     else:\n815:         kind = \"clean_exit\"\n816:         evidence = \"fixture clean exit\"\n817:     return envelope(request, {\n818:         \"terminal_signal\": {\n819:             \"kind\": kind,\n820:             \"evidence\": evidence,\n821:             \"observed_at_unix_ms\": 2005,\n822:         },\n823:     })\n824: \n825: def notify_helper():\n826:     provider_pid = int(sys.argv[2])\n827:     boot_id = sys.argv[3]\n828:     start_ticks = int(sys.argv[4])\n829:     time.sleep(1.5)\n830:     work = pathlib.Path(os.environ[\"S11_WORK_DIR\"])\n831:     state = work / HANDLE\n832:     state.mkdir(parents=True, exist_ok=True)\n833:     (state / \"meta.json\").write_text(json.dumps({\n834:         \"caller_chain\": [{\n835:             \"pid\": provider_pid,\n836:             \"boot_id\": boot_id,\n837:             \"starttime_ticks\": start_ticks,\n838:         }]\n839:     }), encoding=\"utf-8\")\n840:     (state / \"log\").write_text(\"external provider workload completed\\n\", encoding=\"utf-8\")\n841:     (state / \"rc\").write_text(\"0\\n\", encoding=\"utf-8\")\n842:     runner = os.environ[\"AGENT_BASH_AGENT_RUNNER_BIN\"]\n843:     child_env = os.environ.copy()\n844:     child_env[\"OULIPOLY_DATA_DIR\"] = str(pathlib.Path(os.environ[\"XDG_DATA_HOME\"]) / \"oulipoly-agent-runner\")\n845:     child_env.pop(\"XDG_CONFIG_HOME\", None)\n846:     child_env.pop(\"XDG_DATA_HOME\", None)\n847:     (state / \"notify-env.json\").write_text(json.dumps({\n848:         \"xdg_config_home\": child_env.get(\"XDG_CONFIG_HOME\"),\n849:         \"xdg_data_home\": child_env.get(\"XDG_DATA_HOME\"),\n850:         \"oulipoly_data_dir\": child_env.get(\"OULIPOLY_DATA_DIR\"),\n851:     }, separators=(\",\", \":\")), encoding=\"utf-8\")\n852:     with (state / \"notify.json\").open(\"w\", encoding=\"utf-8\") as out, \\\n853:          (state / \"notify.err\").open(\"w\", encoding=\"utf-8\") as err:\n854:         subprocess.run([\n855:             runner, \"notify\", \"agent-bash-complete\",\n856:             \"--caller-ppid\", str(provider_pid),\n857:             \"--handle\", HANDLE,\n858:             \"--state-dir\", str(state),\n859:             \"--meta\", str(state / \"meta.json\"),\n860:             \"--log\", str(state / \"log\"),\n861:             \"--rc\", str(state / \"rc\"),\n862:             \"--json\",\n863:         ], stdout=out, stderr=err, check=False, env=child_env)\n864: \n865: def main():\n866:     subcommand = sys.argv[1] if len(sys.argv) > 1 else \"\"\n867:     if subcommand == \"notify-helper\":\n868:         notify_helper()\n869:         return 0\n870:     request = json.loads(sys.stdin.read() or \"{}\")\n871:     if subcommand == \"describe\":\n872:         print(json.dumps(describe(request)))\n873:         return 0\n874:     if subcommand == \"policy.evaluate\":\n875:         print(json.dumps(policy_evaluate(request)))\n876:         return 0\n877:     if subcommand == \"launch\":\n878:         launch(request)\n879:         return 0\n880:     if subcommand == \"session.read_turns\":\n881:         print(json.dumps(read_turns(request)))\n882:         return 0\n883:     if subcommand == \"session.capture\":\n884:         print(json.dumps(capture(request)))\n885:         return 0\n886:     if subcommand == \"terminal.classify\":\n887:         print(json.dumps(terminal_classify(request)))\n888:         return 0\n889:     print(json.dumps({\n890:         \"contract\": request.get(\"contract\", CONTRACT),\n891:         \"request_id\": request_id(request),\n892:         \"ok\": False,\n893:         \"error\": {\n894:             \"category\": \"failed\",\n895:             \"code\": \"unsupported_subcommand\",\n896:             \"message\": subcommand,\n897:             \"retryable\": False,\n898:         },\n899:     }))\n900:     return 0\n901: \n902: if __name__ == \"__main__\":\n903:     raise SystemExit(main())\n904: \"#\n905: }\n906: \n907: fn turn_script() -> &'static str {\n908:     r#\"#!/usr/bin/env python3\n909: import json\n910: import os\n911: import pathlib\n912: \n913: SESSION = \"ses_s11externalwake\"\n914: \n915: def emit(turn_id, text):\n916:     print(json.dumps({\n917:         \"session_id\": SESSION,\n918:         \"turn_id\": turn_id,\n919:         \"timestamp\": \"2026-06-06T00:00:00Z\",\n920:         \"role\": \"assistant\",\n921:         \"body\": [{\"type\": \"text\", \"text\": text}],\n922:     }, separators=(\",\", \":\")))\n923: \n924: work = pathlib.Path(os.environ[\"S11_WORK_DIR\"])\n925: emit(\"turn-s11-initial\", \"initial fixture turn\")\n926: if (work / \"external-wake-resumed.txt\").exists() and not (work / \"skip-scan-wake-turn.txt\").exists():\n927:     emit(\"turn-s11-woke\", \"WOKE reply\")\n928: \"#\n929: }\n930: \n931: fn assert_success(output: &Output) {\n932:     assert_eq!(\n933:         output.status.code(),\n934:         Some(0),\n935:         \"stdout={}\\nstderr={}\",\n936:         String::from_utf8_lossy(&output.stdout),\n937:         String::from_utf8_lossy(&output.stderr)\n938:     );\n939: }\n940: \n941: fn terminal_signal_marker(stderr: &str) -> Value {\n942:     parse_terminal_signal_marker(terminal_signal_marker_line(stderr))\n943: }\n944: \n945: fn terminal_signal_marker_line(stderr: &str) -> &str {\n946:     stderr\n947:         .lines()\n948:         .find_map(|line| line.strip_prefix(\"OULIPOLY_TERMINAL_SIGNAL=\"))\n949:         .unwrap_or_else(|| panic!(\"missing terminal-signal marker in stderr:\\n{stderr}\"))\n950: }\n951: \n952: fn parse_terminal_signal_marker(line: &str) -> Value {\n953:     serde_json::from_str(line).unwrap()\n954: }\n955: \n956: fn wait_for_file(path: &Path) -> String {\n957:     wait_for_path_exists(path);\n958:     read_file_text(path)\n959: }\n960: \n961: fn wait_for_path_exists(path: &Path) {\n962:     wait_until(&format!(\"{} exists\", path.display()), || path.exists());\n963: }\n964: \n965: fn read_file_text(path: &Path) -> String {\n966:     fs::read_to_string(path).unwrap()\n967: }\n968: \n969: fn wait_for_json_file(path: &Path) -> (String, Value) {\n970:     let text = wait_for_json_text(path);\n971:     let value = parse_json_text(&text).expect(\"wait_for_json_text should return parseable JSON\");\n972:     (text, value)\n973: }\n974: \n975: fn wait_for_json_text(path: &Path) -> String {\n976:     let mut parsed_text = None;\n977:     wait_until(&format!(\"{} contains JSON\", path.display()), || {\n978:         let Some(text) = read_optional_file_text(path) else {\n979:             return false;\n980:         };\n981:         if parse_json_text(&text).is_ok() {\n982:             parsed_text = Some(text);\n983:             true\n984:         } else {\n985:             false\n986:         }\n987:     });\n988:     parsed_text.unwrap()\n989: }\n990: \n991: fn read_optional_file_text(path: &Path) -> Option<String> {\n992:     fs::read_to_string(path).ok()\n993: }\n994: \n995: fn parse_json_text(text: &str) -> serde_json::Result<Value> {\n996:     serde_json::from_str(text)\n997: }\n998: \n999: fn wait_until(label: &str, mut predicate: impl FnMut() -> bool) {\n1000:     let start = Instant::now();\n\n(Showing lines 1-1000 of 1020. Use offset=1001 to continue.)\n</content>","metadata":{"preview":"#![cfg(unix)]\n\n//! ## Declared roles\n//!\n//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n//! predicate, filter.\n//!\n//! TEST: external-provider wake/resume end-to-end fixtures — fake provider\n//! CLI script formatters, fixture model mappers, state/sidecar accessors,\n//! JSON/record parsers, pending-delivery predicates and filters, durable row\n//! validators, and test orchestration.\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/tests/s11_external_provider_wake.rs\n//!     role: adapter\n//!     Translates:\n//!       - external-provider-runtime-cli-contract","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/s11_external_provider_wake.rs","text":"#![cfg(unix)]\n\n//! ## Declared roles\n//!\n//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n//! predicate, filter.\n//!\n//! TEST: external-provider wake/resume end-to-end fixtures — fake provider\n//! CLI script formatters, fixture model mappers, state/sidecar accessors,\n//! JSON/record parsers, pending-delivery predicates and filters, durable row\n//! validators, and test orchestration.\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/tests/s11_external_provider_wake.rs\n//!     role: adapter\n//!     Translates:\n//!       - external-provider-runtime-cli-contract\n//!       - wake-notification-delivery-contract\n//!       - pid-identity-sidecar-contract\n//!       - invocation-state-db-contract\n//!       - test-fixture-process-contract\n//! intrinsic_surface_declarations:\n//!   - component: src-tauri/tests/s11_external_provider_wake.rs\n//!     role: intrinsic-surface\n//!     Domain: external-provider wake CLI regression suite\n//!     Owns:\n//!       - isolated config/data fixture materialization\n//!       - external provider Python script generation and executable setup\n//!       - wake command invocation and environment isolation\n//!       - provider record parsing and subcommand filtering assertions\n//!       - sidecar wake-claim and mailbox delivery assertions\n//! ```\n\nuse oulipoly_state::mailbox::MailboxDb;\nuse rusqlite::{Connection, params};\nuse serde_json::Value;\nuse std::fs;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::{Path, PathBuf};\nuse std::process::{Command, Output};\nuse std::time::{Duration, Instant};\n\nconst MODEL: &str = \"s11-external-wake-model\";\nconst PROVIDER: &str = \"opencode\";\nconst SESSION: &str = \"ses_s11externalwake\";\nconst HANDLE: &str = \"h-s11-external\";\n\nstruct Fixture {\n    dir: tempfile::TempDir,\n    config_home: PathBuf,\n    data_home: PathBuf,\n    home_dir: PathBuf,\n    app_config_dir: PathBuf,\n    models_dir: PathBuf,\n    work_dir: PathBuf,\n}\n\nimpl Fixture {\n    fn new() -> Self {\n        let dir = tempfile::tempdir().unwrap();\n        let config_home = dir.path().join(\"xdg-config\");\n        let data_home = dir.path().join(\"xdg-data\");\n        let home_dir = dir.path().join(\"home\");\n        let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n        let models_dir = app_config_dir.join(\"models\");\n        let work_dir = dir.path().join(\"work\");\n        fs::create_dir_all(&models_dir).unwrap();\n        fs::create_dir_all(&home_dir).unwrap();\n        fs::create_dir_all(&work_dir).unwrap();\n        Self {\n            dir,\n            config_home,\n            data_home,\n            home_dir,\n            app_config_dir,\n            models_dir,\n            work_dir,\n        }\n    }\n\n    fn sidecar_path(&self) -> PathBuf {\n        self.data_home\n            .join(\"oulipoly-agent-runner\")\n            .join(\"pid-identity.db\")\n    }\n\n    fn state_path(&self) -> PathBuf {\n        self.data_home\n            .join(\"oulipoly-agent-runner\")\n            .join(\"state.db\")\n    }\n\n    fn run(&self, mut cmd: Command) -> Output {\n        cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n            .env(\"XDG_DATA_HOME\", &self.data_home)\n            .env(\"HOME\", &self.home_dir)\n            .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n            .env(\"S11_WORK_DIR\", &self.work_dir)\n            .env_remove(\"OULIPOLY_DATA_DIR\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_SESSION_ID\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_TOKEN\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_COUNT\")\n            .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n            .current_dir(self.dir.path());\n        cmd.output().unwrap()\n    }\n\n    fn run_agent(&self, prompt: &str) -> Output {\n        self.run_agent_with_env(prompt, &[])\n    }\n\n    fn run_agent_with_env(&self, prompt: &str, envs: &[(&str, &str)]) -> Output {\n        let mut cmd = Command::new(runner_bin());\n        for (key, value) in envs {\n            cmd.env(key, value);\n        }\n        cmd.arg(\"-m\")\n            .arg(MODEL)\n            .arg(\"--models-dir\")\n            .arg(&self.models_dir)\n            .arg(prompt);\n        self.run(cmd)\n    }\n\n    fn write_external_provider(&self) {\n        let provider_path = self.write_external_provider_script();\n        let turn_script_path = self.write_turn_script();\n        fs::write(\n            self.models_dir.join(format!(\"{MODEL}.toml\")),\n            format!(\n                r#\"provider = {{ path = {} }}\nprompt_mode = \"arg\"\n\n[[providers]]\nname = \"{PROVIDER}\"\nargs = []\n\"#,\n                toml_string(&path_string(&provider_path))\n            ),\n        )\n        .unwrap();\n        fs::write(\n            self.app_config_dir.join(\"providers.toml\"),\n            format!(\n                r#\"[{PROVIDER}]\ncommand = \"fixture-opencode\"\nargs = []\nprompt_mode = \"arg\"\n\"#\n            ),\n        )\n        .unwrap();\n        fs::write(\n            self.app_config_dir.join(\"sessions.toml\"),\n            format!(\n                r#\"[{PROVIDER}]\nturn_script = {}\n\"#,\n                toml_string(&path_string(&turn_script_path))\n            ),\n        )\n        .unwrap();\n    }\n\n    fn write_external_provider_script(&self) -> PathBuf {\n        let path = self.dir.path().join(\"external-provider.py\");\n        fs::write(&path, external_provider_script()).unwrap();\n        let mut perms = fs::metadata(&path).unwrap().permissions();\n        perms.set_mode(0o755);\n        fs::set_permissions(&path, perms).unwrap();\n        path\n    }\n\n    fn write_turn_script(&self) -> PathBuf {\n        let path = self.dir.path().join(\"s11-turns.py\");\n        fs::write(&path, turn_script()).unwrap();\n        let mut perms = fs::metadata(&path).unwrap().permissions();\n        perms.set_mode(0o755);\n        fs::set_permissions(&path, perms).unwrap();\n        path\n    }\n\n    fn mailbox(&self) -> MailboxDb {\n        MailboxDb::open(&self.sidecar_path()).unwrap()\n    }\n\n    fn sidecar_conn(&self) -> Connection {\n        Connection::open(self.sidecar_path()).unwrap()\n    }\n\n    fn finalized_invocation_count(&self) -> i64 {\n        Connection::open(self.state_path())\n            .unwrap()\n            .query_row(\n                \"SELECT COUNT(*) FROM invocations WHERE finished_at IS NOT NULL\",\n                [],\n                |row| row.get(0),\n            )\n            .unwrap()\n    }\n\n    fn pid_identity_session_id_for_provider(&self, provider_name: &str) -> Option<String> {\n        self.sidecar_conn()\n            .query_row(\n                \"SELECT session_id\n                 FROM pid_identity\n                 WHERE provider_name = ?1\n                 ORDER BY recorded_at DESC, os_pid DESC\n                 LIMIT 1\",\n                params![provider_name],\n                |row| row.get(0),\n            )\n            .ok()\n    }\n\n    fn prompt_file(&self, name: &str) -> PathBuf {\n        self.work_dir.join(name)\n    }\n\n    fn assert_xdg_isolated(&self) {\n        assert!(\n            !self\n                .home_dir\n                .join(\".local/share/oulipoly-agent-runner\")\n                .exists(),\n            \"state must stay in isolated XDG_DATA_HOME\"\n        );\n        assert!(\n            !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n            \"config must stay in isolated XDG_CONFIG_HOME\"\n        );\n    }\n}\n\n#[test]\nfn external_provider_launch_notify_uses_captured_sidecar_owner_and_wakes() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent(\"dispatch external provider wake\");\n    assert_success(&output);\n\n    wait_until(\"pid identity backfilled with captured session\", || {\n        fixture\n            .pid_identity_session_id_for_provider(PROVIDER)\n            .as_deref()\n            == Some(SESSION)\n    });\n    let (notify_json, notify) =\n        wait_for_json_file(&fixture.work_dir.join(HANDLE).join(\"notify.json\"));\n    let (_, notify_env) =\n        wait_for_json_file(&fixture.work_dir.join(HANDLE).join(\"notify-env.json\"));\n    assert_eq!(\n        notify_env.get(\"xdg_config_home\").and_then(Value::as_str),\n        None\n    );\n    assert_eq!(\n        notify_env.get(\"xdg_data_home\").and_then(Value::as_str),\n        None\n    );\n    assert_eq!(\n        notify_env.get(\"oulipoly_data_dir\").and_then(Value::as_str),\n        Some(path_string(&fixture.data_home.join(\"oulipoly-agent-runner\")).as_str())\n    );\n    assert_eq!(\n        notify.get(\"status\").and_then(Value::as_str),\n        Some(\"enqueued\"),\n        \"notify response: {notify_json}\"\n    );\n    assert_eq!(notify.get(\"enqueued\").and_then(Value::as_bool), Some(true));\n    assert_eq!(\n        notify.get(\"owner_session_id\").and_then(Value::as_str),\n        Some(SESSION)\n    );\n    assert_eq!(\n        notify.get(\"session_source\").and_then(Value::as_str),\n        Some(\"sidecar_session_id\")\n    );\n    assert_eq!(\n        notify\n            .get(\"wake\")\n            .and_then(|wake| wake.get(\"status\"))\n            .and_then(Value::as_str),\n        Some(\"spawned\"),\n        \"notify response: {notify_json}\"\n    );\n    let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n    assert!(prompt.contains(\"handle: h-s11-external\"), \"{prompt}\");\n    wait_until(\"external provider wake delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && rows[0].owner_invocation_uuid.is_some()\n            && rows[0].matched_os_pid.is_some()\n            && rows[0].matched_chain_index == Some(0)\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    let runtime = fixture.mailbox().session_runtime(SESSION).unwrap().unwrap();\n    assert_eq!(runtime.run_state, \"idle\");\n    let expected_models_dir = path_string(&fixture.models_dir);\n    assert_eq!(\n        runtime.models_dir.as_deref(),\n        Some(expected_models_dir.as_str()),\n        \"detached wake must reload the same models directory as the original external launch\"\n    );\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_runtime_uses_ingested_session_when_launch_capture_missing() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider without launch session capture\",\n        &[(\"S11_NO_NOTIFY\", \"1\"), (\"S11_OMIT_EXIT_SESSION\", \"1\")],\n    );\n    assert_success(&output);\n\n    wait_until(\"initial invocation finalized\", || {\n        fixture.finalized_invocation_count() >= 1\n    });\n    let runtime = fixture.mailbox().session_runtime(SESSION).unwrap().unwrap();\n    let expected_models_dir = path_string(&fixture.models_dir);\n    assert_eq!(runtime.run_state, \"idle\");\n    assert_eq!(runtime.provider_name.as_deref(), Some(PROVIDER));\n    assert_eq!(runtime.model_name.as_deref(), Some(MODEL));\n    assert_eq!(\n        runtime.models_dir.as_deref(),\n        Some(expected_models_dir.as_str())\n    );\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_wake_does_not_mark_delivered_when_resume_produces_no_turn() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider wake dropped payload\",\n        &[\n            (\"S11_DROP_RESUME_PAYLOAD\", \"1\"),\n            (\"OULIPOLY_AUTO_WAKE_MAX\", \"1\"),\n        ],\n    );\n    assert_success(&output);\n\n    let _dropped = wait_for_file(&fixture.prompt_file(\"external-wake-dropped.txt\"));\n    wait_until(\"failed wake released claim and recorded attempt\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n\n    let db = fixture.mailbox();\n    let rows = db.list_mailbox(SESSION, true).unwrap();\n    assert_eq!(rows.len(), 1, \"rows: {rows:?}\");\n    assert!(\n        rows[0].delivered_at.is_none(),\n        \"dropped resume payload must not mark mailbox delivered: {rows:?}\"\n    );\n    assert_eq!(db.list_pending(SESSION).unwrap().len(), 1);\n    assert!(\n        !fixture.prompt_file(\"external-wake-resumed.txt\").exists(),\n        \"drop mode must not write the payload-bearing resume file\"\n    );\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_wake_confirms_delivery_from_submitted_turn_marker() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider wake confirmed by marker\",\n        &[\n            (\"S11_EMIT_SUBMITTED_TURN_MARKER\", \"1\"),\n            (\"S11_EXPORT_REFORMATS_PROMPT\", \"1\"),\n            (\"S11_SKIP_SCAN_WAKE_TURN\", \"1\"),\n        ],\n    );\n    assert_success(&output);\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n    let exported = wait_for_file(&fixture.prompt_file(\"external-wake-export.txt\"));\n    assert_ne!(exported, prompt);\n    assert!(exported.contains(\"[OULIPOLY-DELIVERY \"), \"{exported}\");\n    wait_until(\"submitted-turn marker delivered pending mailbox\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivery_error.is_none()\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_wake_ignores_submitted_turn_marker_for_different_payload() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider wake mismatched marker\",\n        &[\n            (\"S11_EMIT_SUBMITTED_TURN_MARKER\", \"1\"),\n            (\"S11_MARKER_PROMPT_SHA_MISMATCH\", \"1\"),\n            (\"S11_MARKER_DELIVERY_NONCE_MISMATCH\", \"1\"),\n            (\"S11_SKIP_SCAN_WAKE_TURN\", \"1\"),\n            (\"OULIPOLY_AUTO_WAKE_MAX\", \"1\"),\n        ],\n    );\n    assert_success(&output);\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    wait_until(\n        \"mismatched submitted-turn marker leaves mailbox pending\",\n        || {\n            let db = fixture.mailbox();\n            let rows = db.list_mailbox(SESSION, true).unwrap();\n            rows.len() == 1\n                && rows[0].delivered_at.is_none()\n                && rows[0].delivery_attempts == 1\n                && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n                && db.wake_claim(SESSION).unwrap().is_none()\n        },\n    );\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_failed_wake_releases_claim_and_retries_pending_mailbox() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider wake first dropped payload\",\n        &[\n            (\"S11_DROP_FIRST_RESUME_PAYLOAD\", \"1\"),\n            (\"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\", \"1000\"),\n        ],\n    );\n    assert_success(&output);\n\n    let _dropped = wait_for_file(&fixture.prompt_file(\"external-wake-dropped.txt\"));\n    wait_until(\"first failed wake released claim\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_none()\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    wait_until(\"retried wake delivered pending mailbox\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && rows[0].delivery_attempts == 2\n            && rows[0].delivery_error.is_none()\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_rate_limited_wake_records_error_and_retries_pending_mailbox() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider wake first rate limited\",\n        &[\n            (\"S11_RATE_LIMIT_FIRST_RESUME\", \"1\"),\n            (\"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\", \"1000\"),\n        ],\n    );\n    assert_success(&output);\n\n    let _rate_limited = wait_for_file(&fixture.prompt_file(\"external-wake-rate-limited.txt\"));\n    wait_until(\"rate-limited wake released claim\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_none()\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivery_error.as_deref() == Some(\"rate_limited\")\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"external-wake-resumed.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    wait_until(\"rate-limited wake retry delivered pending mailbox\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && rows[0].delivery_attempts == 2\n            && rows[0].delivery_error.is_none()\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn external_provider_policy_rejection_terminal_signal_excerpt_includes_diagnostics() {\n    let fixture = Fixture::new();\n    fixture.write_external_provider();\n\n    let output = fixture.run_agent_with_env(\n        \"dispatch external provider reject\",\n        &[(\"S11_POLICY_REJECT\", \"1\")],\n    );\n\n    assert_ne!(output.status.code(), Some(0), \"{output:?}\");\n    let stderr = String::from_utf8_lossy(&output.stderr);\n    let marker = terminal_signal_marker(&stderr);\n    let excerpt = marker\n        .get(\"evidence\")\n        .and_then(|evidence| evidence.get(\"excerpt\"))\n        .and_then(Value::as_str)\n        .expect(\"terminal-signal marker should include evidence excerpt\");\n    assert!(excerpt.contains(\"policy rejected\"), \"{excerpt}\");\n    assert!(excerpt.contains(\"s11_policy_reject\"), \"{excerpt}\");\n    assert!(excerpt.contains(\"params.launch.argv\"), \"{excerpt}\");\n    assert!(excerpt.contains(\"s11 fixture rejected policy\"), \"{excerpt}\");\n    fixture.assert_xdg_isolated();\n}\n\nfn external_provider_script() -> &'static str {\n    r#\"#!/usr/bin/env python3\nimport base64\nimport hashlib\nimport json\nimport os\nimport pathlib\nimport subprocess\nimport sys\nimport time\n\nCONTRACT = \"oulipoly.provider/v1\"\nSESSION = \"ses_s11externalwake\"\nHANDLE = \"h-s11-external\"\n\ndef request_id(request):\n    return request.get(\"request_id\", \"s11-request\")\n\ndef envelope(request, result):\n    return {\n        \"contract\": request.get(\"contract\", CONTRACT),\n        \"request_id\": request_id(request),\n        \"ok\": True,\n        \"result\": result,\n    }\n\ndef describe(request):\n    terminal_capability = os.environ.get(\"S11_RATE_LIMIT_FIRST_RESUME\") == \"1\"\n    return envelope(request, {\n        \"provider_id\": \"s11-external-provider-wake-fixture\",\n        \"display_name\": \"S11 External Provider Wake Fixture\",\n        \"contract_versions\": [CONTRACT],\n        \"preferred_contract\": CONTRACT,\n        \"capabilities\": {\n            \"launch\": True,\n            \"policy\": True,\n            \"quota\": False,\n            \"session\": True,\n            \"terminal\": terminal_capability,\n            \"rotation\": False,\n            \"discovery\": False,\n            \"settings\": False,\n            \"setup_brain\": False,\n            \"setup\": False,\n            \"migration\": False,\n        },\n    })\n\ndef policy_evaluate(request):\n    if os.environ.get(\"S11_POLICY_REJECT\") == \"1\":\n        return envelope(request, {\n            \"accepted\": False,\n            \"env\": {},\n            \"stdin\": None,\n            \"prompt\": None,\n            \"diagnostics\": [{\n                \"severity\": \"error\",\n                \"code\": \"s11_policy_reject\",\n                \"path\": \"params.launch.argv\",\n                \"message\": \"s11 fixture rejected policy\",\n            }],\n            \"markers\": [],\n        })\n    return envelope(request, {\n        \"accepted\": True,\n        \"env\": {},\n        \"stdin\": None,\n        \"prompt\": None,\n        \"diagnostics\": [],\n        \"markers\": [],\n    })\n\ndef emit(event):\n    print(json.dumps(event, separators=(\",\", \":\")), flush=True)\n\ndef stdout_event(request, seq, payload):\n    return {\n        \"contract\": CONTRACT,\n        \"request_id\": request_id(request),\n        \"seq\": seq,\n        \"time_unix_ms\": 1000 + seq,\n        \"kind\": \"stdout\",\n        \"data_base64\": base64.b64encode(payload.encode(\"utf-8\")).decode(\"ascii\"),\n    }\n\ndef delivery_nonce(text):\n    prefix = \"[OULIPOLY-DELIVERY \"\n    start = text.find(prefix)\n    if start < 0:\n        return None\n    start += len(prefix)\n    end = text.find(\"]\", start)\n    if end < 0:\n        return None\n    nonce = text[start:end].strip()\n    return nonce or None\n\ndef delivery_marker(nonce):\n    return f\"[OULIPOLY-DELIVERY {nonce}]\"\n\ndef simulated_export_text(prompt):\n    nonce = delivery_nonce(prompt)\n    if os.environ.get(\"S11_EXPORT_REFORMATS_PROMPT\") == \"1\" and nonce:\n        exported = (\n            \"Notifications delivered:\\n\"\n            f\"- agent_bash_complete {HANDLE}\\n\\n\"\n            f\"{delivery_marker(nonce)}\\n\"\n        )\n        target = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"external-wake-export.txt\"\n        target.write_text(exported, encoding=\"utf-8\")\n        return exported\n    return prompt\n\ndef submitted_turn_marker_event(request, seq, session_id, prompt):\n    exported = simulated_export_text(prompt)\n    prompt_sha = hashlib.sha256(prompt.encode(\"utf-8\")).hexdigest()\n    if os.environ.get(\"S11_MARKER_PROMPT_SHA_MISMATCH\") == \"1\":\n        prompt_sha = hashlib.sha256(b\"different payload\").hexdigest()\n    nonce = delivery_nonce(exported)\n    if os.environ.get(\"S11_MARKER_DELIVERY_NONCE_MISMATCH\") == \"1\":\n        nonce = \"different-delivery-nonce\"\n    value = {\n        \"provider_session_id\": session_id,\n        \"prompt_sha256\": prompt_sha,\n        \"source\": \"s11.fixture\",\n        \"message_id\": \"msg-s11-submitted\",\n    }\n    if nonce:\n        value[\"delivery_nonce\"] = nonce\n    return {\n        \"contract\": CONTRACT,\n        \"request_id\": request_id(request),\n        \"seq\": seq,\n        \"time_unix_ms\": 1000 + seq,\n        \"kind\": \"marker\",\n        \"name\": \"oulipoly.submitted_user_turn\",\n        \"value\": value,\n    }\n\ndef exit_event(request, seq, session_id):\n    event = {\n        \"contract\": CONTRACT,\n        \"request_id\": request_id(request),\n        \"seq\": seq,\n        \"time_unix_ms\": 1000 + seq,\n        \"kind\": \"exit\",\n        \"status\": {\"kind\": \"exited\", \"code\": 0},\n        \"terminal_signal\": {\n            \"kind\": \"clean_exit\",\n            \"evidence\": \"fixture clean exit\",\n            \"observed_at_unix_ms\": 1000 + seq,\n        },\n    }\n    if session_id:\n        event[\"session\"] = {\n            \"provider_session_id\": session_id,\n            \"state\": {\"cursor\": \"after-launch\"},\n        }\n    return event\n\ndef provider_identity():\n    pid = os.getpid()\n    boot_id = pathlib.Path(\"/proc/sys/kernel/random/boot_id\").read_text(encoding=\"utf-8\").strip()\n    stat = pathlib.Path(f\"/proc/{pid}/stat\").read_text(encoding=\"utf-8\")\n    after = stat.rsplit(\") \", 1)[1]\n    start_ticks = int(after.split()[19])\n    return pid, boot_id, start_ticks\n\ndef spawn_notify_workload():\n    pid, boot_id, start_ticks = provider_identity()\n    subprocess.Popen(\n        [sys.executable, __file__, \"notify-helper\", str(pid), boot_id, str(start_ticks)],\n        stdin=subprocess.DEVNULL,\n        stdout=subprocess.DEVNULL,\n        stderr=subprocess.DEVNULL,\n        start_new_session=True,\n        env=os.environ.copy(),\n    )\n\ndef launch(request):\n    params = request.get(\"params\", {})\n    known = params.get(\"session\", {}).get(\"known_provider_session_id\")\n    prompt = params.get(\"model\", {}).get(\"inputs\", {}).get(\"prompt\", \"\")\n    if known:\n        if os.environ.get(\"S11_RATE_LIMIT_FIRST_RESUME\") == \"1\":\n            count_path = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"resume-count.txt\"\n            count = int(count_path.read_text(encoding=\"utf-8\")) if count_path.exists() else 0\n            count_path.write_text(str(count + 1), encoding=\"utf-8\")\n            if count == 0:\n                target = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"external-wake-rate-limited.txt\"\n                target.write_text(\"rate limited\\n\", encoding=\"utf-8\")\n                emit(stdout_event(request, 1, \"HTTP 429 rate_limit_error\\n\"))\n                emit(exit_event(request, 2, known))\n                return\n        if os.environ.get(\"S11_DROP_FIRST_RESUME_PAYLOAD\") == \"1\":\n            count_path = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"resume-count.txt\"\n            count = int(count_path.read_text(encoding=\"utf-8\")) if count_path.exists() else 0\n            count_path.write_text(str(count + 1), encoding=\"utf-8\")\n            if count == 0:\n                target = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"external-wake-dropped.txt\"\n                target.write_text(\"dropped\\n\", encoding=\"utf-8\")\n                emit(stdout_event(request, 1, \"dropped\\n\"))\n                emit(exit_event(request, 2, known))\n                return\n        if os.environ.get(\"S11_DROP_RESUME_PAYLOAD\") == \"1\":\n            target = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"external-wake-dropped.txt\"\n            target.write_text(\"dropped\\n\", encoding=\"utf-8\")\n            emit(stdout_event(request, 1, \"dropped\\n\"))\n            emit(exit_event(request, 2, known))\n            return\n        target = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"external-wake-resumed.txt\"\n        target.write_text(prompt, encoding=\"utf-8\")\n        emit(stdout_event(request, 1, \"resumed\\n\"))\n        if os.environ.get(\"S11_SKIP_SCAN_WAKE_TURN\") == \"1\":\n            (pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"skip-scan-wake-turn.txt\").write_text(\"skip\\n\", encoding=\"utf-8\")\n        if os.environ.get(\"S11_EMIT_SUBMITTED_TURN_MARKER\") == \"1\":\n            emit(submitted_turn_marker_event(request, 2, known, prompt))\n            emit(exit_event(request, 3, known))\n        else:\n            emit(exit_event(request, 2, known))\n        return\n    if os.environ.get(\"S11_NO_NOTIFY\") != \"1\":\n        spawn_notify_workload()\n    emit(stdout_event(request, 1, \"initial\\n\"))\n    session_id = None if os.environ.get(\"S11_OMIT_EXIT_SESSION\") == \"1\" else SESSION\n    emit(exit_event(request, 2, session_id))\n\ndef session_id_from_request(request):\n    params = request.get(\"params\", {})\n    extra = params.get(\"extra\", {})\n    return params.get(\"session_id\") or extra.get(\"start_bound_provider_session_id\") or SESSION\n\ndef read_turns(request):\n    session_id = session_id_from_request(request)\n    return envelope(request, {\n        \"turns\": [{\n            \"session_id\": session_id,\n            \"turn_id\": \"turn-s11-external-wake\",\n            \"role\": \"assistant\",\n            \"timestamp\": \"2026-06-06T00:00:00Z\",\n            \"body\": [{\"type\": \"text\", \"text\": \"fixture turn\"}],\n        }],\n        \"turn_count\": 1,\n        \"complete\": True,\n    })\n\ndef capture(request):\n    return envelope(request, {\n        \"provider_session_id\": session_id_from_request(request),\n        \"state\": {\"captured\": True},\n        \"artifacts\": [],\n    })\n\ndef terminal_classify(request):\n    count_path = pathlib.Path(os.environ[\"S11_WORK_DIR\"]) / \"resume-count.txt\"\n    first_rate_limited_resume = (\n        os.environ.get(\"S11_RATE_LIMIT_FIRST_RESUME\") == \"1\"\n        and count_path.exists()\n        and count_path.read_text(encoding=\"utf-8\").strip() == \"1\"\n    )\n    if first_rate_limited_resume:\n        kind = \"rate_limited\"\n        evidence = \"HTTP 429 rate_limit_error\"\n    else:\n        kind = \"clean_exit\"\n        evidence = \"fixture clean exit\"\n    return envelope(request, {\n        \"terminal_signal\": {\n            \"kind\": kind,\n            \"evidence\": evidence,\n            \"observed_at_unix_ms\": 2005,\n        },\n    })\n\ndef notify_helper():\n    provider_pid = int(sys.argv[2])\n    boot_id = sys.argv[3]\n    start_ticks = int(sys.argv[4])\n    time.sleep(1.5)\n    work = pathlib.Path(os.environ[\"S11_WORK_DIR\"])\n    state = work / HANDLE\n    state.mkdir(parents=True, exist_ok=True)\n    (state / \"meta.json\").write_text(json.dumps({\n        \"caller_chain\": [{\n            \"pid\": provider_pid,\n            \"boot_id\": boot_id,\n            \"starttime_ticks\": start_ticks,\n        }]\n    }), encoding=\"utf-8\")\n    (state / \"log\").write_text(\"external provider workload completed\\n\", encoding=\"utf-8\")\n    (state / \"rc\").write_text(\"0\\n\", encoding=\"utf-8\")\n    runner = os.environ[\"AGENT_BASH_AGENT_RUNNER_BIN\"]\n    child_env = os.environ.copy()\n    child_env[\"OULIPOLY_DATA_DIR\"] = str(pathlib.Path(os.environ[\"XDG_DATA_HOME\"]) / \"oulipoly-agent-runner\")\n    child_env.pop(\"XDG_CONFIG_HOME\", None)\n    child_env.pop(\"XDG_DATA_HOME\", None)\n    (state / \"notify-env.json\").write_text(json.dumps({\n        \"xdg_config_home\": child_env.get(\"XDG_CONFIG_HOME\"),\n        \"xdg_data_home\": child_env.get(\"XDG_DATA_HOME\"),\n        \"oulipoly_data_dir\": child_env.get(\"OULIPOLY_DATA_DIR\"),\n    }, separators=(\",\", \":\")), encoding=\"utf-8\")\n    with (state / \"notify.json\").open(\"w\", encoding=\"utf-8\") as out, \\\n         (state / \"notify.err\").open(\"w\", encoding=\"utf-8\") as err:\n        subprocess.run([\n            runner, \"notify\", \"agent-bash-complete\",\n            \"--caller-ppid\", str(provider_pid),\n            \"--handle\", HANDLE,\n            \"--state-dir\", str(state),\n            \"--meta\", str(state / \"meta.json\"),\n            \"--log\", str(state / \"log\"),\n            \"--rc\", str(state / \"rc\"),\n            \"--json\",\n        ], stdout=out, stderr=err, check=False, env=child_env)\n\ndef main():\n    subcommand = sys.argv[1] if len(sys.argv) > 1 else \"\"\n    if subcommand == \"notify-helper\":\n        notify_helper()\n        return 0\n    request = json.loads(sys.stdin.read() or \"{}\")\n    if subcommand == \"describe\":\n        print(json.dumps(describe(request)))\n        return 0\n    if subcommand == \"policy.evaluate\":\n        print(json.dumps(policy_evaluate(request)))\n        return 0\n    if subcommand == \"launch\":\n        launch(request)\n        return 0\n    if subcommand == \"session.read_turns\":\n        print(json.dumps(read_turns(request)))\n        return 0\n    if subcommand == \"session.capture\":\n        print(json.dumps(capture(request)))\n        return 0\n    if subcommand == \"terminal.classify\":\n        print(json.dumps(terminal_classify(request)))\n        return 0\n    print(json.dumps({\n        \"contract\": request.get(\"contract\", CONTRACT),\n        \"request_id\": request_id(request),\n        \"ok\": False,\n        \"error\": {\n            \"category\": \"failed\",\n            \"code\": \"unsupported_subcommand\",\n            \"message\": subcommand,\n            \"retryable\": False,\n        },\n    }))\n    return 0\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\"#\n}\n\nfn turn_script() -> &'static str {\n    r#\"#!/usr/bin/env python3\nimport json\nimport os\nimport pathlib\n\nSESSION = \"ses_s11externalwake\"\n\ndef emit(turn_id, text):\n    print(json.dumps({\n        \"session_id\": SESSION,\n        \"turn_id\": turn_id,\n        \"timestamp\": \"2026-06-06T00:00:00Z\",\n        \"role\": \"assistant\",\n        \"body\": [{\"type\": \"text\", \"text\": text}],\n    }, separators=(\",\", \":\")))\n\nwork = pathlib.Path(os.environ[\"S11_WORK_DIR\"])\nemit(\"turn-s11-initial\", \"initial fixture turn\")\nif (work / \"external-wake-resumed.txt\").exists() and not (work / \"skip-scan-wake-turn.txt\").exists():\n    emit(\"turn-s11-woke\", \"WOKE reply\")\n\"#\n}\n\nfn assert_success(output: &Output) {\n    assert_eq!(\n        output.status.code(),\n        Some(0),\n        \"stdout={}\\nstderr={}\",\n        String::from_utf8_lossy(&output.stdout),\n        String::from_utf8_lossy(&output.stderr)\n    );\n}\n\nfn terminal_signal_marker(stderr: &str) -> Value {\n    parse_terminal_signal_marker(terminal_signal_marker_line(stderr))\n}\n\nfn terminal_signal_marker_line(stderr: &str) -> &str {\n    stderr\n        .lines()\n        .find_map(|line| line.strip_prefix(\"OULIPOLY_TERMINAL_SIGNAL=\"))\n        .unwrap_or_else(|| panic!(\"missing terminal-signal marker in stderr:\\n{stderr}\"))\n}\n\nfn parse_terminal_signal_marker(line: &str) -> Value {\n    serde_json::from_str(line).unwrap()\n}\n\nfn wait_for_file(path: &Path) -> String {\n    wait_for_path_exists(path);\n    read_file_text(path)\n}\n\nfn wait_for_path_exists(path: &Path) {\n    wait_until(&format!(\"{} exists\", path.display()), || path.exists());\n}\n\nfn read_file_text(path: &Path) -> String {\n    fs::read_to_string(path).unwrap()\n}\n\nfn wait_for_json_file(path: &Path) -> (String, Value) {\n    let text = wait_for_json_text(path);\n    let value = parse_json_text(&text).expect(\"wait_for_json_text should return parseable JSON\");\n    (text, value)\n}\n\nfn wait_for_json_text(path: &Path) -> String {\n    let mut parsed_text = None;\n    wait_until(&format!(\"{} contains JSON\", path.display()), || {\n        let Some(text) = read_optional_file_text(path) else {\n            return false;\n        };\n        if parse_json_text(&text).is_ok() {\n            parsed_text = Some(text);\n            true\n        } else {\n            false\n        }\n    });\n    parsed_text.unwrap()\n}\n\nfn read_optional_file_text(path: &Path) -> Option<String> {\n    fs::read_to_string(path).ok()\n}\n\nfn parse_json_text(text: &str) -> serde_json::Result<Value> {\n    serde_json::from_str(text)\n}\n\nfn wait_until(label: &str, mut predicate: impl FnMut() -> bool) {\n    let start = Instant::now();","lineStart":1,"lineEnd":1000,"totalLines":1020,"truncated":true}},"title":"src-tauri/tests/s11_external_provider_wake.rs","time":{"start":1780923371775,"end":1780923372000}},"metadata":{"openai":{"itemId":"fc_07cd687873b1706f016a26bbebae88819bb04ec9fd656ca5fa"}},"id":"prt_ea74e10e2001Lk9BzE4oDzxZMi","sessionID":"ses_158b3e351ffePkuQnC9kglvomy","messageID":"msg_ea74db39e001OUt7IFVSrgke4f"}}
{"type":"tool_use","timestamp":1780923372323,"sessionID":"ses_158b3e351ffePkuQnC9kglvomy","part":{"type":"tool","tool":"read","callID":"call_0N8EE7wcAN65c6qYqXnLb2bL","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/wu_d_proactive_wake_integration.rs","offset":1,"limit":1800},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/wu_d_proactive_wake_integration.rs</path>\n<type>file</type>\n<content>\n1: #![cfg(unix)]\n2: \n3: //! ## Declared roles\n4: //!\n5: //! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n6: //! predicate, filter.\n7: //!\n8: //! TEST: proactive wake and wake-reclaim end-to-end fixtures — fake CLI script\n9: //! formatters, model/config mappers, state and mailbox accessors, JSON/record\n10: //! parsers, liveness and delivery predicates/filters, wake-claim and durable\n11: //! mailbox validators, and test orchestration.\n12: //!\n13: //! ## Adapter declarations\n14: //!\n15: //! ```yaml\n16: //! adapter_declarations:\n17: //!   - component: src-tauri/tests/wu_d_proactive_wake_integration.rs\n18: //!     role: adapter\n19: //!     Translates:\n20: //!       - runtime-cli-dispatch-contract\n21: //!       - wake-claim-sidecar-contract\n22: //!       - pid-identity-sidecar-contract\n23: //!       - mailbox-delivery-contract\n24: //!       - test-fixture-process-contract\n25: //! intrinsic_surface_declarations:\n26: //!   - component: src-tauri/tests/wu_d_proactive_wake_integration.rs\n27: //!     role: intrinsic-surface\n28: //!     Domain: proactive wake and wake-reclaim regression suite\n29: //!     Owns:\n30: //!       - isolated config/data fixture materialization\n31: //!       - fake provider script generation and executable setup\n32: //!       - auto-wake command invocation and environment isolation\n33: //!       - sidecar wake-claim fixture construction\n34: //!       - mailbox delivery, busy suppression, and consumed suppression assertions\n35: //! ```\n36: \n37: use chrono::{DateTime, Utc};\n38: use oulipoly_state::mailbox::{\n39:     AgentBashCompleteEnqueue, MailboxDb, SessionRuntimeUpsert, WAKE_SWEEP_ABANDONED_ERROR,\n40:     WakeClaimAcquireResult, WakeClaimRequest,\n41: };\n42: use oulipoly_state::pid_identity::{\n43:     PidIdentityDb, PidIdentityRecord, ProcessIdentity, read_live_process_identity,\n44: };\n45: use oulipoly_state::{SessionTurnIngest, StateDb};\n46: use rusqlite::Connection;\n47: use serde_json::{Value, json};\n48: use std::fs;\n49: use std::os::unix::fs::PermissionsExt;\n50: use std::path::{Path, PathBuf};\n51: use std::process::{Command, Output, Stdio};\n52: use std::sync::{Mutex, MutexGuard, OnceLock};\n53: use std::time::{Duration, Instant};\n54: \n55: const MODEL: &str = \"wu-d-fixture-model\";\n56: const PROVIDER: &str = \"wu-d-fixture-provider\";\n57: const SESSION: &str = \"5169694d-de0f-40d1-890c-6e28e55bab27\";\n58: const CAPTURED_OPENCODE_SESSION: &str = \"ses_capturemidturn\";\n59: const INVOCATION: &str = \"11111111-1111-4111-8111-111111111111\";\n60: \n61: struct Fixture {\n62:     dir: tempfile::TempDir,\n63:     config_home: PathBuf,\n64:     data_home: PathBuf,\n65:     home_dir: PathBuf,\n66:     app_config_dir: PathBuf,\n67:     models_dir: PathBuf,\n68:     work_dir: PathBuf,\n69: }\n70: \n71: impl Fixture {\n72:     fn new() -> Self {\n73:         let dir = tempfile::tempdir().unwrap();\n74:         let config_home = dir.path().join(\"xdg-config\");\n75:         let data_home = dir.path().join(\"xdg-data\");\n76:         let home_dir = dir.path().join(\"home\");\n77:         let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n78:         let models_dir = app_config_dir.join(\"models\");\n79:         let work_dir = dir.path().join(\"work\");\n80:         fs::create_dir_all(&models_dir).unwrap();\n81:         fs::create_dir_all(&home_dir).unwrap();\n82:         fs::create_dir_all(&work_dir).unwrap();\n83:         Self {\n84:             dir,\n85:             config_home,\n86:             data_home,\n87:             home_dir,\n88:             app_config_dir,\n89:             models_dir,\n90:             work_dir,\n91:         }\n92:     }\n93: \n94:     fn sidecar_path(&self) -> PathBuf {\n95:         self.data_home\n96:             .join(\"oulipoly-agent-runner\")\n97:             .join(\"pid-identity.db\")\n98:     }\n99: \n100:     fn state_path(&self) -> PathBuf {\n101:         self.data_home\n102:             .join(\"oulipoly-agent-runner\")\n103:             .join(\"state.db\")\n104:     }\n105: \n106:     fn pinned_data_dir(&self) -> PathBuf {\n107:         self.data_home.join(\"oulipoly-agent-runner\")\n108:     }\n109: \n110:     fn run(&self, mut cmd: Command) -> Output {\n111:         cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n112:             .env(\"XDG_DATA_HOME\", &self.data_home)\n113:             .env(\"HOME\", &self.home_dir)\n114:             .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n115:             .env(\"WU_D_WORK_DIR\", &self.work_dir)\n116:             .env_remove(\"OULIPOLY_DATA_DIR\")\n117:             .env_remove(\"OULIPOLY_AUTO_WAKE\")\n118:             .env_remove(\"OULIPOLY_AUTO_WAKE_SESSION_ID\")\n119:             .env_remove(\"OULIPOLY_AUTO_WAKE_TOKEN\")\n120:             .env_remove(\"OULIPOLY_AUTO_WAKE_COUNT\")\n121:             .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n122:             .current_dir(self.dir.path());\n123:         cmd.output().unwrap()\n124:     }\n125: \n126:     fn run_agent(&self, prompt: &str) -> Output {\n127:         let mut cmd = Command::new(runner_bin());\n128:         cmd.arg(\"-m\")\n129:             .arg(MODEL)\n130:             .arg(\"--models-dir\")\n131:             .arg(&self.models_dir)\n132:             .arg(prompt);\n133:         self.run(cmd)\n134:     }\n135: \n136:     fn run_resume(&self) -> Output {\n137:         let mut cmd = Command::new(runner_bin());\n138:         cmd.arg(\"resume\")\n139:             .arg(\"-m\")\n140:             .arg(MODEL)\n141:             .arg(\"--session-id\")\n142:             .arg(SESSION)\n143:             .arg(\"--models-dir\")\n144:             .arg(&self.models_dir);\n145:         self.run(cmd)\n146:     }\n147: \n148:     fn run_mailbox_list(&self, session_id: &str) -> Output {\n149:         let mut cmd = Command::new(runner_bin());\n150:         cmd.arg(\"mailbox\")\n151:             .arg(\"list\")\n152:             .arg(\"--session-id\")\n153:             .arg(session_id)\n154:             .arg(\"--json\");\n155:         self.run(cmd)\n156:     }\n157: \n158:     fn write_provider(&self, body: &str) {\n159:         let script = self.write_script(\"provider.sh\", body);\n160:         fs::write(\n161:             self.models_dir.join(format!(\"{MODEL}.toml\")),\n162:             format!(\n163:                 r#\"[[providers]]\n164: name = \"{PROVIDER}\"\n165: args = []\n166: \"#,\n167:             ),\n168:         )\n169:         .unwrap();\n170:         fs::write(\n171:             self.app_config_dir.join(\"providers.toml\"),\n172:             format!(\n173:                 r#\"[{PROVIDER}]\n174: command = {}\n175: args = []\n176: interactive_args = [\"interactive\"]\n177: prompt_mode = \"arg\"\n178: \n179: [{PROVIDER}.session_capture]\n180: kind = \"forced_flag_verified\"\n181: flag = \"--session-id\"\n182: \n183: [{PROVIDER}.resume]\n184: kind = \"flag\"\n185: flag = \"--resume\"\n186: \"#,\n187:                 toml_string(&path_string(&script))\n188:             ),\n189:         )\n190:         .unwrap();\n191:     }\n192: \n193:     fn write_opencode_provider(&self, body: &str) {\n194:         let script = self.write_script(\"opencode.sh\", body);\n195:         fs::write(\n196:             self.models_dir.join(format!(\"{MODEL}.toml\")),\n197:             r#\"[[providers]]\n198: name = \"opencode\"\n199: args = []\n200: \"#,\n201:         )\n202:         .unwrap();\n203:         fs::write(\n204:             self.app_config_dir.join(\"providers.toml\"),\n205:             format!(\n206:                 r#\"[opencode]\n207: command = {}\n208: args = []\n209: interactive_args = [\"interactive\"]\n210: prompt_mode = \"arg\"\n211: \n212: [opencode.resume]\n213: kind = \"flag\"\n214: flag = \"--session\"\n215: \"#,\n216:                 toml_string(&path_string(&script))\n217:             ),\n218:         )\n219:         .unwrap();\n220:     }\n221: \n222:     fn write_opencode_capture_provider(&self, body: &str) {\n223:         let script = self.write_script(\"opencode-capture.sh\", body);\n224:         fs::write(\n225:             self.models_dir.join(format!(\"{MODEL}.toml\")),\n226:             r#\"[[providers]]\n227: name = \"opencode\"\n228: args = []\n229: \"#,\n230:         )\n231:         .unwrap();\n232:         fs::write(\n233:             self.app_config_dir.join(\"providers.toml\"),\n234:             format!(\n235:                 r#\"[opencode]\n236: command = {}\n237: args = []\n238: interactive_args = [\"interactive\"]\n239: prompt_mode = \"arg\"\n240: \n241: [opencode.session_capture]\n242: kind = \"stdout_json_event\"\n243: json_args = [\"--json\"]\n244: event_type = \"step_start\"\n245: event_id_path = \"sessionID\"\n246: \n247: [opencode.resume]\n248: kind = \"flag\"\n249: flag = \"--session\"\n250: \"#,\n251:                 toml_string(&path_string(&script))\n252:             ),\n253:         )\n254:         .unwrap();\n255:     }\n256: \n257:     fn pid_identity_session_id_for_provider(&self, provider_name: &str) -> String {\n258:         self.sidecar_conn()\n259:             .query_row(\n260:                 \"SELECT session_id\n261:                  FROM pid_identity\n262:                  WHERE provider_name = ?1\n263:                  ORDER BY recorded_at DESC, os_pid DESC\n264:                  LIMIT 1\",\n265:                 rusqlite::params![provider_name],\n266:                 |row| row.get(0),\n267:             )\n268:             .unwrap()\n269:     }\n270: \n271:     fn write_script(&self, name: &str, body: &str) -> PathBuf {\n272:         let path = self.dir.path().join(name);\n273:         fs::write(\n274:             &path,\n275:             format!(\"#!/usr/bin/env bash\\nset -euo pipefail\\n{body}\\n\"),\n276:         )\n277:         .unwrap();\n278:         let mut perms = fs::metadata(&path).unwrap().permissions();\n279:         perms.set_mode(0o755);\n280:         fs::set_permissions(&path, perms).unwrap();\n281:         path\n282:     }\n283: \n284:     fn mailbox(&self) -> MailboxDb {\n285:         MailboxDb::open(&self.sidecar_path()).unwrap()\n286:     }\n287: \n288:     fn sidecar_conn(&self) -> Connection {\n289:         Connection::open(self.sidecar_path()).unwrap()\n290:     }\n291: \n292:     fn state(&self) -> StateDb {\n293:         StateDb::open(&self.state_path()).unwrap()\n294:     }\n295: \n296:     fn seed_session_turn(&self) {\n297:         self.seed_session_turn_for(PROVIDER, SESSION, \"turn-a\");\n298:     }\n299: \n300:     fn seed_session_turn_for(&self, provider_name: &str, session_id: &str, turn_id: &str) {\n301:         let db = self.state();\n302:         db.ingest_session_turns_batch(\n303:             provider_name,\n304:             &[SessionTurnIngest {\n305:                 session_id: session_id.to_string(),\n306:                 turn_id: turn_id.to_string(),\n307:                 timestamp: ts(\"2026-06-04T12:00:00Z\"),\n308:                 role: \"assistant\".to_string(),\n309:                 parent_turn_id: None,\n310:                 is_sidechain: false,\n311:                 is_compaction_boundary: false,\n312:                 body: None,\n313:             }],\n314:         )\n315:         .unwrap();\n316:     }\n317: \n318:     fn seed_consumed_notification_turn(&self, handle: &str) {\n319:         self.state()\n320:             .ingest_session_turns_batch(\n321:                 PROVIDER,\n322:                 &[SessionTurnIngest {\n323:                     session_id: SESSION.to_string(),\n324:                     turn_id: format!(\"turn-consumed-{handle}\"),\n325:                     timestamp: ts(\"2026-06-04T12:01:00Z\"),\n326:                     role: \"user\".to_string(),\n327:                     parent_turn_id: None,\n328:                     is_sidechain: false,\n329:                     is_compaction_boundary: false,\n330:                     body: Some(format!(\"[OULIPOLY NOTIFICATIONS]\\nhandle: {handle}\\n\")),\n331:                 }],\n332:             )\n333:             .unwrap();\n334:     }\n335: \n336:     fn seed_idle_runtime(&self) {\n337:         self.seed_idle_runtime_for(SESSION, PROVIDER, MODEL);\n338:     }\n339: \n340:     fn seed_idle_runtime_for(&self, session_id: &str, provider_name: &str, model_name: &str) {\n341:         let mut db = MailboxDb::open(&self.sidecar_path()).unwrap();\n342:         let models_dir = path_string(&self.models_dir);\n343:         db.upsert_session_runtime(SessionRuntimeUpsert {\n344:             session_id,\n345:             mode: \"headless\",\n346:             invocation_uuid: None,\n347:             provider_name: Some(provider_name),\n348:             model_name: Some(model_name),\n349:             pty_control_path: None,\n350:             models_dir: Some(&models_dir),\n351:             effective_cwd: None,\n352:         })\n353:         .unwrap();\n354:     }\n355: \n356:     fn seed_active_chain_for(\n357:         &self,\n358:         chain_id: &str,\n359:         provider_name: &str,\n360:         session_id: &str,\n361:         model_name: &str,\n362:     ) {\n363:         let _ = StateDb::open(&self.state_path()).unwrap();\n364:         let conn = Connection::open(self.state_path()).unwrap();\n365:         conn.execute(\n366:             \"INSERT INTO session_chains (chain_id, created_at, last_used_at, model_name)\n367:              VALUES (?1, '2026-06-04T12:00:00Z', '2026-06-04T12:00:00Z', ?2)\",\n368:             rusqlite::params![chain_id, model_name],\n369:         )\n370:         .unwrap();\n371:         conn.execute(\n372:             \"INSERT INTO session_chain_segments\n373:                 (chain_id, provider_name, session_id, started_at, transition_reason)\n374:              VALUES (?1, ?2, ?3, '2026-06-04T12:00:00Z', 'initial')\",\n375:             rusqlite::params![chain_id, provider_name, session_id],\n376:         )\n377:         .unwrap();\n378:     }\n379: \n380:     fn seed_mailbox(&self, session_id: &str, handle: &str) {\n381:         self.seed_mailbox_for(session_id, handle, Some(INVOCATION));\n382:     }\n383: \n384:     fn seed_mailbox_for(\n385:         &self,\n386:         session_id: &str,\n387:         handle: &str,\n388:         owner_invocation_uuid: Option<&str>,\n389:     ) {\n390:         let state_dir = self.work_dir.join(format!(\"seed-{handle}\"));\n391:         fs::create_dir_all(&state_dir).unwrap();\n392:         let meta = state_dir.join(\"meta.json\");\n393:         let log = state_dir.join(\"log\");\n394:         let rc = state_dir.join(\"rc\");\n395:         fs::write(&meta, r#\"{\"caller_chain\":[]}\"#).unwrap();\n396:         fs::write(&log, format!(\"log {handle}\\n\")).unwrap();\n397:         fs::write(&rc, \"0\\n\").unwrap();\n398:         let mut db = MailboxDb::open(&self.sidecar_path()).unwrap();\n399:         db.enqueue_agent_bash_complete(&AgentBashCompleteEnqueue {\n400:             session_id,\n401:             handle,\n402:             payload_json: r#\"{\"schema_version\":1,\"kind\":\"agent_bash_complete\"}\"#,\n403:             owner_invocation_uuid,\n404:             matched_os_pid: Some(9_300),\n405:             matched_os_boot_id: Some(\"boot-seeded\"),\n406:             matched_os_pid_starttime_ticks: Some(456),\n407:             matched_chain_index: Some(0),\n408:             state_dir: &path_string(&state_dir),\n409:             meta_path: &path_string(&meta),\n410:             log_path: &path_string(&log),\n411:             rc_path: &path_string(&rc),\n412:             rc: 0,\n413:         })\n414:         .unwrap();\n415:     }\n416: \n417:     fn age_mailbox_for(&self, session_id: &str, seconds_old: i64) {\n418:         let enqueued_at = (Utc::now() - chrono::Duration::seconds(seconds_old)).to_rfc3339();\n419:         self.sidecar_conn()\n420:             .execute(\n421:                 \"UPDATE mailbox SET enqueued_at = ?2 WHERE session_id = ?1\",\n422:                 rusqlite::params![session_id, enqueued_at],\n423:             )\n424:             .unwrap();\n425:     }\n426: \n427:     fn mark_mailbox_unconfirmed_twice(&self, session_id: &str, handle: &str) {\n428:         let mut db = self.mailbox();\n429:         let row = db\n430:             .list_mailbox(session_id, true)\n431:             .unwrap()\n432:             .into_iter()\n433:             .find(|row| row.handle == handle)\n434:             .unwrap_or_else(|| panic!(\"missing seeded mailbox row {handle}\"));\n435:         db.mark_delivery_failed(session_id, &[row.seq], \"mailbox_delivery_unconfirmed\")\n436:             .unwrap();\n437:         db.mark_delivery_failed(session_id, &[row.seq], \"mailbox_delivery_unconfirmed\")\n438:             .unwrap();\n439:     }\n440: \n441:     fn record_identity(&self, identity: &ProcessIdentity) {\n442:         self.record_identity_for(identity, SESSION, PROVIDER, MODEL);\n443:     }\n444: \n445:     fn record_identity_for(\n446:         &self,\n447:         identity: &ProcessIdentity,\n448:         session_id: &str,\n449:         provider_name: &str,\n450:         model_name: &str,\n451:     ) {\n452:         let sidecar = PidIdentityDb::open(&self.sidecar_path()).unwrap();\n453:         sidecar\n454:             .record_identity(PidIdentityRecord {\n455:                 identity,\n456:                 os_pgid: None,\n457:                 invocation_uuid: INVOCATION,\n458:                 session_id: Some(session_id),\n459:                 provider_name: Some(provider_name),\n460:                 model_name: Some(model_name),\n461:                 recorded_at: \"2026-06-04T12:00:00Z\",\n462:             })\n463:             .unwrap();\n464:     }\n465: \n466:     fn prompt_file(&self, name: &str) -> PathBuf {\n467:         self.work_dir.join(name)\n468:     }\n469: \n470:     fn assert_xdg_isolated(&self) {\n471:         assert!(\n472:             !self\n473:                 .home_dir\n474:                 .join(\".local/share/oulipoly-agent-runner\")\n475:                 .exists(),\n476:             \"state must stay in isolated XDG_DATA_HOME\"\n477:         );\n478:         assert!(\n479:             !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n480:             \"config must stay in isolated XDG_CONFIG_HOME\"\n481:         );\n482:     }\n483: }\n484: \n485: #[test]\n486: fn idle_wake_delivers() {\n487:     let _guard = integration_test_guard();\n488:     let fixture = Fixture::new();\n489:     fixture.write_provider(&provider_script(\n490:         r#\"( sleep 0.3; notify_handle h-idle 0 ) >/dev/null 2>&1 &\"#,\n491:         \"\",\n492:         \"resumed-input.txt\",\n493:     ));\n494: \n495:     let output = fixture.run_agent(\"dispatch background work\");\n496:     assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n497: \n498:     let prompt = wait_for_file(&fixture.prompt_file(\"resumed-input.txt\"));\n499:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n500:     assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n501:     assert!(prompt.contains(\"handle: h-idle\"), \"{prompt}\");\n502:     assert!(prompt.contains(\"rc: 0\"), \"{prompt}\");\n503:     let session_id = wait_for_mailbox_session(&fixture);\n504:     wait_until(\"mailbox delivered\", || {\n505:         let db = fixture.mailbox();\n506:         let rows = db.list_mailbox(&session_id, true).unwrap();\n507:         rows.len() == 1\n508:             && rows[0].delivered_at.is_some()\n509:             && db.wake_claim(&session_id).unwrap().is_none()\n510:     });\n511:     let mailbox = fixture.mailbox();\n512:     assert!(mailbox.list_pending(&session_id).unwrap().is_empty());\n513:     assert_eq!(\n514:         mailbox\n515:             .session_runtime(&session_id)\n516:             .unwrap()\n517:             .unwrap()\n518:             .run_state,\n519:         \"idle\"\n520:     );\n521:     assert!(mailbox.wake_claim(&session_id).unwrap().is_none());\n522:     fixture.assert_xdg_isolated();\n523: }\n524: \n525: #[test]\n526: fn busy_then_turn_end_delivers() {\n527:     let _guard = integration_test_guard();\n528:     let fixture = Fixture::new();\n529:     fixture.write_provider(&provider_script(\n530:         r#\"( sleep 0.1; notify_handle h-a 0 ) >/dev/null 2>&1 &\n531: ( sleep 0.2; notify_handle h-b 0 ) >/dev/null 2>&1 &\n532: ( sleep 0.3; notify_handle h-c 0 ) >/dev/null 2>&1 &\n533: sleep 1\"#,\n534:         \"\",\n535:         \"busy-resumed-input.txt\",\n536:     ));\n537: \n538:     let output = fixture.run_agent(\"dispatch busy work\");\n539:     assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n540: \n541:     let prompt = wait_for_file(&fixture.prompt_file(\"busy-resumed-input.txt\"));\n542:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n543:     let pos_a = prompt.find(\"handle: h-a\").unwrap();\n544:     let pos_b = prompt.find(\"handle: h-b\").unwrap();\n545:     let pos_c = prompt.find(\"handle: h-c\").unwrap();\n546:     assert!(pos_a < pos_b && pos_b < pos_c, \"{prompt}\");\n547:     let session_id = wait_for_mailbox_session(&fixture);\n548:     wait_until(\"busy rows delivered\", || {\n549:         let db = fixture.mailbox();\n550:         let rows = db.list_mailbox(&session_id, true).unwrap();\n551:         rows.len() == 3\n552:             && rows.iter().all(|row| row.delivered_at.is_some())\n553:             && db.wake_claim(&session_id).unwrap().is_none()\n554:     });\n555:     assert!(fixture.mailbox().wake_claim(&session_id).unwrap().is_none());\n556:     fixture.assert_xdg_isolated();\n557: }\n558: \n559: #[test]\n560: fn no_undelivered_no_wake_and_loop_terminates() {\n561:     let _guard = integration_test_guard();\n562:     let fixture = Fixture::new();\n563:     fixture.write_provider(&provider_script(\"\", \"\", \"no-pending-resume.txt\"));\n564: \n565:     let output = fixture.run_agent(\"no pending\");\n566:     assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n567: \n568:     let session_id = wait_for_runtime_session(&fixture);\n569:     wait_until(\"runtime idle\", || {\n570:         fixture\n571:             .mailbox()\n572:             .session_runtime(&session_id)\n573:             .unwrap()\n574:             .is_some_and(|row| row.run_state == \"idle\")\n575:     });\n576:     let mailbox = fixture.mailbox();\n577:     assert!(mailbox.list_pending(&session_id).unwrap().is_empty());\n578:     assert!(mailbox.wake_claim(&session_id).unwrap().is_none());\n579:     assert!(!fixture.prompt_file(\"no-pending-resume.txt\").exists());\n580:     fixture.assert_xdg_isolated();\n581: }\n582: \n583: #[test]\n584: fn auto_wake_cap_stops_self_replicating_session() {\n585:     let _guard = integration_test_guard();\n586:     let fixture = Fixture::new();\n587:     fixture.write_provider(&provider_script(\n588:         r#\"( sleep 0.3; notify_handle h-start 0 ) >/dev/null 2>&1 &\"#,\n589:         r#\"count=\"${OULIPOLY_AUTO_WAKE_COUNT:-0}\"\n590: notify_handle \"h-auto-${count}\" 0\"#,\n591:         \"resumed-${OULIPOLY_AUTO_WAKE_COUNT:-0}.txt\",\n592:     ));\n593:     let mut cmd = Command::new(runner_bin());\n594:     cmd.arg(\"-m\")\n595:         .arg(MODEL)\n596:         .arg(\"--models-dir\")\n597:         .arg(&fixture.models_dir)\n598:         .arg(\"self replicate\")\n599:         .env(\"OULIPOLY_AUTO_WAKE_MAX\", \"2\");\n600:     let output = fixture.run(cmd);\n601:     assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n602: \n603:     let first = wait_for_file(&fixture.prompt_file(\"resumed-1.txt\"));\n604:     let second = wait_for_file(&fixture.prompt_file(\"resumed-2.txt\"));\n605:     let session_id = wait_for_mailbox_session(&fixture);\n606:     assert!(first.contains(\"handle: h-start\"), \"{first}\");\n607:     assert!(second.contains(\"handle: h-auto-1\"), \"{second}\");\n608:     wait_until(\"cap leaves pending\", || {\n609:         let db = fixture.mailbox();\n610:         let pending = db.list_pending(&session_id).unwrap();\n611:         pending.len() == 1\n612:             && pending[0].handle == \"h-auto-2\"\n613:             && db.wake_claim(&session_id).unwrap().is_none()\n614:     });\n615:     fixture.assert_xdg_isolated();\n616: }\n617: \n618: #[test]\n619: fn concurrent_notify_single_flight() {\n620:     let _guard = integration_test_guard();\n621:     let fixture = Fixture::new();\n622:     fixture.write_provider(&provider_script(\n623:         \"\",\n624:         r#\"printf 'wake\\n' >> \"$work/concurrent-wake-launches.log\"\n625: sleep 0.2\"#,\n626:         \"concurrent-resume.txt\",\n627:     ));\n628:     fixture.seed_session_turn();\n629:     fixture.seed_idle_runtime();\n630:     let identity = identity(9_200, \"boot-concurrent\", 123);\n631:     fixture.record_identity(&identity);\n632: \n633:     let child_a = notify_command(&fixture, \"h-concurrent-a\", &identity)\n634:         .spawn()\n635:         .unwrap();\n636:     let child_b = notify_command(&fixture, \"h-concurrent-b\", &identity)\n637:         .spawn()\n638:         .unwrap();\n639:     let output_a = child_a.wait_with_output().unwrap();\n640:     let output_b = child_b.wait_with_output().unwrap();\n641:     assert_notify_success(&output_a);\n642:     assert_notify_success(&output_b);\n643:     assert_single_wake_claim_won(&[notify_wake(&output_a), notify_wake(&output_b)]);\n644: \n645:     let prompt = wait_for_file(&fixture.prompt_file(\"concurrent-resume.txt\"));\n646:     assert!(prompt.contains(\"handle: h-concurrent-\"), \"{prompt}\");\n647:     wait_until(\"concurrent rows delivered\", || {\n648:         let db = fixture.mailbox();\n649:         let rows = db.list_mailbox(SESSION, true).unwrap();\n650:         rows.len() == 2\n651:             && rows.iter().all(|row| row.delivered_at.is_some())\n652:             && db.wake_claim(SESSION).unwrap().is_none()\n653:     });\n654:     assert_single_wake_child_launch(&wait_for_file(\n655:         &fixture.prompt_file(\"concurrent-wake-launches.log\"),\n656:     ));\n657:     assert!(fixture.mailbox().wake_claim(SESSION).unwrap().is_none());\n658:     fixture.assert_xdg_isolated();\n659: }\n660: \n661: #[test]\n662: fn manual_resume_race_is_safe() {\n663:     let _guard = integration_test_guard();\n664:     let fixture = Fixture::new();\n665:     fixture.write_provider(&provider_script(\"\", \"\", \"manual-race.txt\"));\n666:     fixture.seed_session_turn();\n667:     fixture.seed_idle_runtime();\n668:     fixture.seed_mailbox(SESSION, \"h-manual-race\");\n669:     let mut db = fixture.mailbox();\n670:     assert!(matches!(\n671:         db.try_acquire_wake_claim(WakeClaimRequest {\n672:             session_id: SESSION,\n673:             claim_token: \"manual-race-token\",\n674:             reason: \"notify_idle\",\n675:             auto_wake_count: 1,\n676:             wake_invocation_uuid: None,\n677:             stale_after_seconds: 600,\n678:         })\n679:         .unwrap(),\n680:         WakeClaimAcquireResult::Acquired(_)\n681:     ));\n682:     drop(db);\n683: \n684:     let output = fixture.run_resume();\n685:     assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n686: \n687:     let prompt = wait_for_file(&fixture.prompt_file(\"manual-race.txt\"));\n688:     assert!(prompt.contains(\"handle: h-manual-race\"), \"{prompt}\");\n689:     wait_until(\"manual race delivered\", || {\n690:         let db = fixture.mailbox();\n691:         let rows = db.list_mailbox(SESSION, true).unwrap();\n692:         rows.len() == 1\n693:             && rows[0].delivered_at.is_some()\n694:             && db.wake_claim(SESSION).unwrap().is_none()\n695:     });\n696:     fixture.assert_xdg_isolated();\n697: }\n698: \n699: #[test]\n700: fn opencode_notify_idle_wakes_resume_with_ses_session() {\n701:     let _guard = integration_test_guard();\n702:     let fixture = Fixture::new();\n703:     fixture.write_opencode_provider(&provider_script(\n704:         \"\",\n705:         r#\"if [ \"$resume\" != \"ses_fixture\" ]; then\n706:   printf 'expected --session ses_fixture, got %s\\n' \"$resume\" >&2\n707:   exit 66\n708: fi\"#,\n709:         \"opencode-resumed.txt\",\n710:     ));\n711:     fixture.seed_active_chain_for(\n712:         \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n713:         \"opencode\",\n714:         \"ses_fixture\",\n715:         MODEL,\n716:     );\n717:     fixture.seed_idle_runtime_for(\"ses_fixture\", \"opencode\", MODEL);\n718:     let identity = identity(9_400, \"boot-opencode\", 789);\n719:     fixture.record_identity_for(&identity, \"ses_fixture\", \"opencode\", MODEL);\n720: \n721:     let output = notify_command(&fixture, \"h-opencode\", &identity)\n722:         .output()\n723:         .unwrap();\n724: \n725:     assert_notify_success(&output);\n726:     let prompt = wait_for_file(&fixture.prompt_file(\"opencode-resumed.txt\"));\n727:     assert!(prompt.contains(\"handle: h-opencode\"), \"{prompt}\");\n728:     wait_until(\"opencode mailbox delivered\", || {\n729:         let db = fixture.mailbox();\n730:         let rows = db.list_mailbox(\"ses_fixture\", true).unwrap();\n731:         rows.len() == 1\n732:             && rows[0].delivered_at.is_some()\n733:             && db.wake_claim(\"ses_fixture\").unwrap().is_none()\n734:     });\n735:     assert!(\n736:         fixture\n737:             .mailbox()\n738:             .list_pending(\"ses_fixture\")\n739:             .unwrap()\n740:             .is_empty()\n741:     );\n742:     fixture.assert_xdg_isolated();\n743: }\n744: \n745: #[test]\n746: fn opencode_mid_turn_notify_resolves_capture_time_sidecar_owner() {\n747:     let _guard = integration_test_guard();\n748:     let fixture = Fixture::new();\n749:     let event = json!({\n750:         \"type\": \"step_start\",\n751:         \"sessionID\": CAPTURED_OPENCODE_SESSION,\n752:     });\n753:     fixture.write_opencode_capture_provider(&provider_script(\n754:         &format!(\n755:             r#\"printf '%s\\n' '{}'\n756: sleep 0.2\n757: notify_handle h-capture-midturn 0\n758: sleep 0.2\"#,\n759:             event\n760:         ),\n761:         r#\"if [ \"$resume\" != \"ses_capturemidturn\" ]; then\n762:   printf 'expected --session ses_capturemidturn, got %s\\n' \"$resume\" >&2\n763:   exit 66\n764: fi\"#,\n765:         \"opencode-capture-resumed.txt\",\n766:     ));\n767:     fixture.seed_active_chain_for(\n768:         \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n769:         \"opencode\",\n770:         CAPTURED_OPENCODE_SESSION,\n771:         MODEL,\n772:     );\n773: \n774:     let output = fixture.run_agent(\"dispatch capture race\");\n775:     assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n776: \n777:     let notify_json = wait_for_file(&fixture.work_dir.join(\"h-capture-midturn/notify.json\"));\n778:     let notify: Value = serde_json::from_str(&notify_json).unwrap();\n779:     assert_eq!(\n780:         notify.get(\"status\").and_then(Value::as_str),\n781:         Some(\"enqueued\")\n782:     );\n783:     assert_eq!(notify.get(\"enqueued\").and_then(Value::as_bool), Some(true));\n784:     assert_eq!(\n785:         notify.get(\"owner_session_id\").and_then(Value::as_str),\n786:         Some(CAPTURED_OPENCODE_SESSION)\n787:     );\n788:     assert_eq!(\n789:         notify.get(\"session_source\").and_then(Value::as_str),\n790:         Some(\"sidecar_session_id\")\n791:     );\n792:     assert_eq!(\n793:         notify\n794:             .get(\"wake\")\n795:             .and_then(|wake| wake.get(\"status\"))\n796:             .and_then(Value::as_str),\n797:         Some(\"busy\")\n798:     );\n799: \n800:     assert_eq!(\n801:         fixture.pid_identity_session_id_for_provider(\"opencode\"),\n802:         CAPTURED_OPENCODE_SESSION\n803:     );\n804:     let prompt = wait_for_file(&fixture.prompt_file(\"opencode-capture-resumed.txt\"));\n805:     assert!(prompt.contains(\"handle: h-capture-midturn\"), \"{prompt}\");\n806:     wait_until(\"captured opencode mailbox delivered\", || {\n807:         let db = fixture.mailbox();\n808:         let rows = db.list_mailbox(CAPTURED_OPENCODE_SESSION, true).unwrap();\n809:         rows.len() == 1\n810:             && rows[0].handle == \"h-capture-midturn\"\n811:             && rows[0].delivered_at.is_some()\n812:             && rows[0].owner_invocation_uuid.is_some()\n813:             && rows[0].matched_os_pid.is_some()\n814:             && rows[0].matched_chain_index == Some(0)\n815:             && db.wake_claim(CAPTURED_OPENCODE_SESSION).unwrap().is_none()\n816:     });\n817:     assert_eq!(\n818:         fixture\n819:             .mailbox()\n820:             .session_runtime(CAPTURED_OPENCODE_SESSION)\n821:             .unwrap()\n822:             .unwrap()\n823:             .run_state,\n824:         \"idle\"\n825:     );\n826:     fixture.assert_xdg_isolated();\n827: }\n828: \n829: #[test]\n830: fn batch_cap_followup_wake() {\n831:     let _guard = integration_test_guard();\n832:     let fixture = Fixture::new();\n833:     fixture.write_provider(&provider_script(\n834:         \"\",\n835:         \"\",\n836:         \"batch-${OULIPOLY_AUTO_WAKE_COUNT:-manual}.txt\",\n837:     ));\n838:     fixture.seed_session_turn();\n839:     fixture.seed_idle_runtime();\n840:     for index in 0..25 {\n841:         fixture.seed_mailbox(SESSION, &format!(\"h-batch-{index:02}\"));\n842:     }\n843: \n844:     let output = fixture.run_resume();\n845:     assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n846: \n847:     let first = wait_for_file(&fixture.prompt_file(\"batch-manual.txt\"));\n848:     let second = wait_for_file(&fixture.prompt_file(\"batch-1.txt\"));\n849:     assert!(\n850:         first.contains(\"5 additional notification(s) remain queued\"),\n851:         \"{first}\"\n852:     );\n853:     assert!(second.contains(\"handle: h-batch-20\"), \"{second}\");\n854:     wait_until(\"batch rows delivered\", || {\n855:         let db = fixture.mailbox();\n856:         let rows = db.list_mailbox(SESSION, true).unwrap();\n857:         rows.len() == 25\n858:             && rows.iter().all(|row| row.delivered_at.is_some())\n859:             && db.list_pending(SESSION).unwrap().is_empty()\n860:             && db.wake_claim(SESSION).unwrap().is_none()\n861:     });\n862:     fixture.assert_xdg_isolated();\n863: }\n864: \n865: #[test]\n866: fn wake_sweep_reclaims_dead_claim_and_delivers_pending_mailbox() {\n867:     let _guard = integration_test_guard();\n868:     let fixture = Fixture::new();\n869:     fixture.write_provider(&provider_script(\"\", \"\", \"sweep-reclaimed.txt\"));\n870:     fixture.seed_session_turn();\n871:     fixture.seed_idle_runtime();\n872:     fixture.seed_mailbox(SESSION, \"h-sweep-reclaim\");\n873:     seed_dead_wake_claim(&fixture, \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\", 601);\n874: \n875:     let output = fixture.run_mailbox_list(SESSION);\n876:     assert_success(&output);\n877: \n878:     let prompt = wait_for_file(&fixture.prompt_file(\"sweep-reclaimed.txt\"));\n879:     assert!(prompt.contains(\"handle: h-sweep-reclaim\"), \"{prompt}\");\n880:     wait_until(\"sweep reclaimed dead claim and delivered mailbox\", || {\n881:         let db = fixture.mailbox();\n882:         let rows = db.list_mailbox(SESSION, true).unwrap();\n883:         rows.len() == 1\n884:             && rows[0].delivered_at.is_some()\n885:             && rows[0].delivery_error.is_none()\n886:             && db.wake_claim(SESSION).unwrap().is_none()\n887:     });\n888:     fixture.assert_xdg_isolated();\n889: }\n890: \n891: #[test]\n892: fn wake_sweep_does_not_disturb_live_identity_matched_claim() {\n893:     let _guard = integration_test_guard();\n894:     let fixture = Fixture::new();\n895:     fixture.write_provider(&provider_script(\"\", \"\", \"live-claim-not-disturbed.txt\"));\n896:     fixture.seed_session_turn();\n897:     fixture.seed_idle_runtime();\n898:     fixture.seed_mailbox(SESSION, \"h-live-claim\");\n899:     seed_live_wake_claim(&fixture, \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\");\n900: \n901:     let output = fixture.run_mailbox_list(SESSION);\n902:     assert_success(&output);\n903:     std::thread::sleep(Duration::from_millis(300));\n904: \n905:     assert!(!fixture.prompt_file(\"live-claim-not-disturbed.txt\").exists());\n906:     let claim = fixture.mailbox().wake_claim(SESSION).unwrap().unwrap();\n907:     assert_eq!(claim.claim_token, \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\");\n908:     assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n909:     fixture.assert_xdg_isolated();\n910: }\n911: \n912: #[test]\n913: fn wake_sweep_does_not_rewake_consumed_pending_mailbox() {\n914:     let _guard = integration_test_guard();\n915:     let fixture = Fixture::new();\n916:     fixture.write_provider(&provider_script(\"\", \"\", \"consumed-not-rewoken.txt\"));\n917:     fixture.seed_session_turn();\n918:     fixture.seed_idle_runtime();\n919:     fixture.seed_mailbox(SESSION, \"h-consumed\");\n920:     fixture.seed_consumed_notification_turn(\"h-consumed\");\n921:     seed_dead_wake_claim(&fixture, \"cccccccc-cccc-4ccc-8ccc-cccccccccccc\", 601);\n922: \n923:     let output = fixture.run_mailbox_list(SESSION);\n924:     assert_success(&output);\n925:     std::thread::sleep(Duration::from_millis(300));\n926: \n927:     assert!(!fixture.prompt_file(\"consumed-not-rewoken.txt\").exists());\n928:     assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n929:     fixture.assert_xdg_isolated();\n930: }\n931: \n932: #[test]\n933: fn wake_sweep_does_not_rewake_twice_unconfirmed_pending_mailbox() {\n934:     let _guard = integration_test_guard();\n935:     let fixture = Fixture::new();\n936:     fixture.write_provider(&provider_script(\n937:         \"\",\n938:         \"\",\n939:         \"twice-unconfirmed-not-rewoken.txt\",\n940:     ));\n941:     fixture.seed_session_turn();\n942:     fixture.seed_idle_runtime();\n943:     fixture.seed_mailbox(SESSION, \"h-unconfirmed\");\n944:     fixture.mark_mailbox_unconfirmed_twice(SESSION, \"h-unconfirmed\");\n945:     seed_dead_wake_claim(&fixture, \"dddddddd-dddd-4ddd-8ddd-dddddddddddd\", 601);\n946: \n947:     let output = fixture.run_mailbox_list(SESSION);\n948:     assert_success(&output);\n949:     std::thread::sleep(Duration::from_millis(300));\n950: \n951:     assert!(\n952:         !fixture\n953:             .prompt_file(\"twice-unconfirmed-not-rewoken.txt\")\n954:             .exists()\n955:     );\n956:     let rows = fixture.mailbox().list_pending(SESSION).unwrap();\n957:     assert_eq!(rows.len(), 1);\n958:     assert_eq!(rows[0].handle, \"h-unconfirmed\");\n959:     assert_eq!(rows[0].delivery_attempts, 2);\n960:     fixture.assert_xdg_isolated();\n961: }\n962: \n963: #[test]\n964: fn wake_sweep_skips_twice_unconfirmed_rows_and_delivers_newer_pending_mailbox() {\n965:     let _guard = integration_test_guard();\n966:     let fixture = Fixture::new();\n967:     fixture.write_provider(&provider_script(\"\", \"\", \"newer-after-unconfirmed.txt\"));\n968:     fixture.seed_session_turn();\n969:     fixture.seed_idle_runtime();\n970:     fixture.seed_mailbox(SESSION, \"h-unconfirmed-old\");\n971:     fixture.seed_mailbox(SESSION, \"h-newer\");\n972:     fixture.mark_mailbox_unconfirmed_twice(SESSION, \"h-unconfirmed-old\");\n973:     seed_dead_wake_claim(&fixture, \"eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee\", 601);\n974: \n975:     let output = fixture.run_mailbox_list(SESSION);\n976:     assert_success(&output);\n977: \n978:     let prompt = wait_for_file(&fixture.prompt_file(\"newer-after-unconfirmed.txt\"));\n979:     assert!(!prompt.contains(\"handle: h-unconfirmed-old\"), \"{prompt}\");\n980:     assert!(prompt.contains(\"handle: h-newer\"), \"{prompt}\");\n981:     wait_until(\n982:         \"newer mailbox delivered while exhausted row remains pending\",\n983:         || {\n984:             let rows = fixture.mailbox().list_mailbox(SESSION, true).unwrap();\n985:             let old = rows.iter().find(|row| row.handle == \"h-unconfirmed-old\");\n986:             let newer = rows.iter().find(|row| row.handle == \"h-newer\");\n987:             old.is_some_and(|row| row.delivered_at.is_none() && row.delivery_attempts == 2)\n988:                 && newer.is_some_and(|row| row.delivered_at.is_some())\n989:         },\n990:     );\n991:     fixture.assert_xdg_isolated();\n992: }\n993: \n994: #[test]\n995: fn wake_sweep_backlog_recovers_recent_leak_and_reaps_dead_owner_debris() {\n996:     let _guard = integration_test_guard();\n997:     let fixture = Fixture::new();\n998:     fixture.write_provider(&provider_script(\n999:         \"\",\n1000:         r#\"printf '%s' \"$last\" > \"$work/backlog-$resume.txt\"\"#,\n1001:         \"backlog-any.txt\",\n1002:     ));\n1003: \n1004:     let dead_sessions = (0..16)\n1005:         .map(|index| format!(\"00000000-0000-4000-8000-{index:012x}\"))\n1006:         .collect::<Vec<_>>();\n1007:     for (index, session_id) in dead_sessions.iter().enumerate() {\n1008:         let handle = format!(\"h-dead-owner-{index}\");\n1009:         fixture.seed_mailbox_for(session_id, &handle, None);\n1010:         fixture.age_mailbox_for(session_id, 86_400);\n1011:         seed_dead_wake_claim_for(\n1012:             &fixture,\n1013:             session_id,\n1014:             &format!(\"dead0000-0000-4000-8000-{index:012x}\"),\n1015:             601,\n1016:         );\n1017:     }\n1018: \n1019:     let idle_session = \"11111111-1111-4111-8111-000000000001\";\n1020:     fixture.seed_active_chain_for(\n1021:         \"22222222-2222-4222-8222-000000000001\",\n1022:         PROVIDER,\n1023:         idle_session,\n1024:         MODEL,\n1025:     );\n1026:     fixture.seed_session_turn_for(PROVIDER, idle_session, \"turn-idle-backlog\");\n1027:     fixture.seed_idle_runtime_for(idle_session, PROVIDER, MODEL);\n1028:     fixture.seed_mailbox(idle_session, \"h-idle-resumable-backlog\");\n1029:     fixture.age_mailbox_for(idle_session, 3_600);\n1030:     seed_dead_wake_claim_for(\n1031:         &fixture,\n1032:         idle_session,\n1033:         \"eeee0000-0000-4000-8000-000000000001\",\n1034:         601,\n1035:     );\n1036: \n1037:     let recent_session = \"11111111-1111-4111-8111-000000000002\";\n1038:     fixture.seed_active_chain_for(\n1039:         \"22222222-2222-4222-8222-000000000002\",\n1040:         PROVIDER,\n1041:         recent_session,\n1042:         MODEL,\n1043:     );\n1044:     fixture.seed_session_turn_for(PROVIDER, recent_session, \"turn-recent-backlog\");\n1045:     fixture.seed_idle_runtime_for(recent_session, PROVIDER, MODEL);\n1046:     fixture.seed_mailbox(recent_session, \"h-recent-leak-backlog\");\n1047:     seed_dead_wake_claim_for(\n1048:         &fixture,\n1049:         recent_session,\n1050:         \"eeee0000-0000-4000-8000-000000000002\",\n1051:         601,\n1052:     );\n1053: \n1054:     let output = fixture.run_mailbox_list(recent_session);\n1055:     assert_success(&output);\n1056: \n1057:     let idle_prompt = wait_for_file(&fixture.prompt_file(&format!(\"backlog-{idle_session}.txt\")));\n1058:     assert!(\n1059:         idle_prompt.contains(\"handle: h-idle-resumable-backlog\"),\n1060:         \"{idle_prompt}\"\n1061:     );\n1062:     let recent_prompt =\n1063:         wait_for_file(&fixture.prompt_file(&format!(\"backlog-{recent_session}.txt\")));\n1064:     assert!(\n1065:         recent_prompt.contains(\"handle: h-recent-leak-backlog\"),\n1066:         \"{recent_prompt}\"\n1067:     );\n1068: \n1069:     wait_until(\n1070:         \"backlog recoverable sessions delivered and debris reaped\",\n1071:         || {\n1072:             let db = fixture.mailbox();\n1073:             let idle_rows = db.list_mailbox(idle_session, true).unwrap();\n1074:             let recent_rows = db.list_mailbox(recent_session, true).unwrap();\n1075:             let recovered = idle_rows.len() == 1\n1076:                 && idle_rows[0].delivered_at.is_some()\n1077:                 && recent_rows.len() == 1\n1078:                 && recent_rows[0].delivered_at.is_some();\n1079:             let debris_reaped = dead_sessions.iter().all(|session_id| {\n1080:                 let rows = db.list_mailbox(session_id, true).unwrap();\n1081:                 rows.len() == 1\n1082:                     && rows[0].delivered_at.is_none()\n1083:                     && rows[0].delivery_error.as_deref() == Some(WAKE_SWEEP_ABANDONED_ERROR)\n1084:                     && db.wake_claim(session_id).unwrap().is_none()\n1085:             });\n1086:             recovered && debris_reaped\n1087:         },\n1088:     );\n1089:     for session_id in dead_sessions {\n1090:         assert!(\n1091:             !fixture\n1092:                 .prompt_file(&format!(\"backlog-{session_id}.txt\"))\n1093:                 .exists(),\n1094:             \"dead-owner debris must not be re-woken: {session_id}\"\n1095:         );\n1096:     }\n1097:     fixture.assert_xdg_isolated();\n1098: }\n1099: \n1100: fn notify_command(fixture: &Fixture, handle: &str, identity: &ProcessIdentity) -> Command {\n1101:     let state_dir = fixture.work_dir.join(format!(\"concurrent-{handle}\"));\n1102:     fs::create_dir_all(&state_dir).unwrap();\n1103:     let meta = state_dir.join(\"meta.json\");\n1104:     let log = state_dir.join(\"log\");\n1105:     let rc = state_dir.join(\"rc\");\n1106:     fs::write(\n1107:         &meta,\n1108:         serde_json::to_string(&caller_chain(identity)).unwrap(),\n1109:     )\n1110:     .unwrap();\n1111:     fs::write(&log, format!(\"log {handle}\\n\")).unwrap();\n1112:     fs::write(&rc, \"0\\n\").unwrap();\n1113:     let mut cmd = Command::new(runner_bin());\n1114:     cmd.arg(\"notify\")\n1115:         .arg(\"agent-bash-complete\")\n1116:         .arg(\"--caller-ppid\")\n1117:         .arg(std::process::id().to_string())\n1118:         .arg(\"--handle\")\n1119:         .arg(handle)\n1120:         .arg(\"--state-dir\")\n1121:         .arg(&state_dir)\n1122:         .arg(\"--meta\")\n1123:         .arg(&meta)\n1124:         .arg(\"--log\")\n1125:         .arg(&log)\n1126:         .arg(\"--rc\")\n1127:         .arg(&rc)\n1128:         .arg(\"--json\")\n1129:         .env(\"XDG_CONFIG_HOME\", &fixture.config_home)\n1130:         .env(\"XDG_DATA_HOME\", &fixture.data_home)\n1131:         .env(\"HOME\", &fixture.home_dir)\n1132:         .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n1133:         .env(\"WU_D_WORK_DIR\", &fixture.work_dir)\n1134:         .env_remove(\"OULIPOLY_DATA_DIR\")\n1135:         .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n1136:         .stdout(Stdio::piped())\n1137:         .stderr(Stdio::piped())\n1138:         .current_dir(fixture.dir.path());\n1139:     cmd\n1140: }\n1141: \n1142: fn seed_dead_wake_claim(fixture: &Fixture, claim_token: &str, seconds_old: i64) {\n1143:     seed_dead_wake_claim_for(fixture, SESSION, claim_token, seconds_old);\n1144: }\n1145: \n1146: fn seed_dead_wake_claim_for(\n1147:     fixture: &Fixture,\n1148:     session_id: &str,\n1149:     claim_token: &str,\n1150:     seconds_old: i64,\n1151: ) {\n1152:     acquire_seed_wake_claim_for(fixture, session_id, claim_token);\n1153:     fixture\n1154:         .mailbox()\n1155:         .record_wake_claim_pid(session_id, claim_token, 999_999_999)\n1156:         .unwrap();\n1157:     age_wake_claim_for(fixture, session_id, seconds_old);\n1158: }\n1159: \n1160: fn seed_live_wake_claim(fixture: &Fixture, claim_token: &str) {\n1161:     acquire_seed_wake_claim(fixture, claim_token);\n1162:     let identity = current_process_identity();\n1163:     PidIdentityDb::open(&fixture.sidecar_path())\n1164:         .unwrap()\n1165:         .record_identity(PidIdentityRecord {\n1166:             identity: &identity,\n1167:             os_pgid: None,\n1168:             invocation_uuid: claim_token,\n1169:             session_id: Some(SESSION),\n1170:             provider_name: Some(PROVIDER),\n1171:             model_name: Some(MODEL),\n1172:             recorded_at: \"2026-06-04T12:02:00Z\",\n1173:         })\n1174:         .unwrap();\n1175:     fixture\n1176:         .mailbox()\n1177:         .record_wake_claim_pid(SESSION, claim_token, identity.os_pid)\n1178:         .unwrap();\n1179: }\n1180: \n1181: fn acquire_seed_wake_claim(fixture: &Fixture, claim_token: &str) {\n1182:     acquire_seed_wake_claim_for(fixture, SESSION, claim_token);\n1183: }\n1184: \n1185: fn acquire_seed_wake_claim_for(fixture: &Fixture, session_id: &str, claim_token: &str) {\n1186:     let mut db = fixture.mailbox();\n1187:     assert!(matches!(\n1188:         db.try_acquire_wake_claim(WakeClaimRequest {\n1189:             session_id,\n1190:             claim_token,\n1191:             reason: \"notify_idle\",\n1192:             auto_wake_count: 1,\n1193:             wake_invocation_uuid: None,\n1194:             stale_after_seconds: 600,\n1195:         })\n1196:         .unwrap(),\n1197:         WakeClaimAcquireResult::Acquired(_)\n1198:     ));\n1199: }\n1200: \n1201: fn age_wake_claim_for(fixture: &Fixture, session_id: &str, seconds_old: i64) {\n1202:     let claimed_at = (Utc::now() - chrono::Duration::seconds(seconds_old)).to_rfc3339();\n1203:     fixture\n1204:         .sidecar_conn()\n1205:         .execute(\n1206:             \"UPDATE session_wake_claim SET claimed_at = ?2 WHERE session_id = ?1\",\n1207:             rusqlite::params![session_id, claimed_at],\n1208:         )\n1209:         .unwrap();\n1210: }\n1211: \n1212: fn current_process_identity() -> ProcessIdentity {\n1213:     read_live_process_identity(i64::from(std::process::id()))\n1214:         .unwrap()\n1215:         .expect(\"test process should have a live identity\")\n1216: }\n1217: \n1218: #[test]\n1219: fn provider_shadow_xdg_notify_uses_pinned_data_dir_and_wakes() {\n1220:     let _guard = integration_test_guard();\n1221:     let fixture = Fixture::new();\n1222:     fixture.write_provider(&provider_script(\n1223:         r#\"if [ -z \"${OULIPOLY_DATA_DIR:-}\" ]; then\n1224:   printf 'missing OULIPOLY_DATA_DIR\\n' >&2\n1225:   exit 65\n1226: fi\n1227: export XDG_DATA_HOME=\"$work/shadow-xdg\"\n1228: ( sleep 0.3; notify_handle h-shadow-xdg 0 ) >/dev/null 2>&1 &\"#,\n1229:         r#\"printf '%s\\n' \"${OULIPOLY_DATA_DIR:-}\" > \"$work/shadow-resumed-data-dir.txt\"\"#,\n1230:         \"shadow-resumed-input.txt\",\n1231:     ));\n1232: \n1233:     let output = fixture.run_agent(\"dispatch from shadowed provider\");\n1234:     assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n1235: \n1236:     let prompt = wait_for_file(&fixture.prompt_file(\"shadow-resumed-input.txt\"));\n1237:     assert!(prompt.contains(\"handle: h-shadow-xdg\"), \"{prompt}\");\n1238:     let resumed_data_dir = wait_for_file(&fixture.prompt_file(\"shadow-resumed-data-dir.txt\"));\n1239:     let expected_data_dir = fixture.pinned_data_dir();\n1240:     let expected_data_dir = expected_data_dir.to_string_lossy();\n1241:     assert_eq!(resumed_data_dir.trim_end(), expected_data_dir.as_ref());\n1242:     let session_id = wait_for_mailbox_session(&fixture);\n1243:     wait_until(\"shadow-xdg mailbox delivered\", || {\n1244:         let db = fixture.mailbox();\n1245:         let rows = db.list_mailbox(&session_id, true).unwrap();\n1246:         rows.len() == 1\n1247:             && rows[0].handle == \"h-shadow-xdg\"\n1248:             && rows[0].delivered_at.is_some()\n1249:             && db.wake_claim(&session_id).unwrap().is_none()\n1250:     });\n1251:     assert!(\n1252:         !fixture\n1253:             .work_dir\n1254:             .join(\"shadow-xdg\")\n1255:             .join(\"oulipoly-agent-runner\")\n1256:             .exists(),\n1257:         \"shadow XDG_DATA_HOME must not receive agent-runner state\"\n1258:     );\n1259:     fixture.assert_xdg_isolated();\n1260: }\n1261: \n1262: fn assert_notify_success(output: &Output) {\n1263:     assert_success(output);\n1264: }\n1265: \n1266: fn assert_success(output: &Output) {\n1267:     assert!(\n1268:         output.status.success(),\n1269:         \"stdout={} stderr={}\",\n1270:         String::from_utf8_lossy(&output.stdout),\n1271:         String::from_utf8_lossy(&output.stderr)\n1272:     );\n1273: }\n1274: \n1275: fn notify_wake(output: &Output) -> Value {\n1276:     let response: Value = serde_json::from_slice(&output.stdout).unwrap();\n1277:     response.get(\"wake\").cloned().unwrap_or(Value::Null)\n1278: }\n1279: \n1280: fn assert_single_wake_claim_won(wakes: &[Value]) {\n1281:     let statuses = wakes\n1282:         .iter()\n1283:         .filter_map(|wake| wake.get(\"status\").and_then(Value::as_str))\n1284:         .collect::<Vec<_>>();\n1285:     let spawned_count = statuses\n1286:         .iter()\n1287:         .filter(|status| **status == \"spawned\")\n1288:         .count();\n1289:     assert_eq!(spawned_count, 1, \"wake statuses: {statuses:?}\");\n1290: \n1291:     let mut claim_tokens = wakes\n1292:         .iter()\n1293:         .filter_map(|wake| wake.get(\"claim_token\").and_then(Value::as_str))\n1294:         .collect::<Vec<_>>();\n1295:     claim_tokens.sort_unstable();\n1296:     claim_tokens.dedup();\n1297:     assert_eq!(claim_tokens.len(), 1, \"wake diagnostics: {wakes:?}\");\n1298: }\n1299: \n1300: fn assert_single_wake_child_launch(log: &str) {\n1301:     let launches = log.lines().filter(|line| *line == \"wake\").count();\n1302:     assert_eq!(launches, 1, \"wake launch log: {log:?}\");\n1303: }\n1304: \n1305: fn integration_test_lock() -> &'static Mutex<()> {\n1306:     static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n1307:     LOCK.get_or_init(|| Mutex::new(()))\n1308: }\n1309: \n1310: fn integration_test_guard() -> MutexGuard<'static, ()> {\n1311:     integration_test_lock()\n1312:         .lock()\n1313:         .unwrap_or_else(|poisoned| poisoned.into_inner())\n1314: }\n1315: \n1316: fn provider_script(on_initial: &str, on_resume: &str, prompt_file: &str) -> String {\n1317:     let prompt_file = prompt_file.replace('\"', \"\\\\\\\"\");\n1318:     format!(\n1319:         r#\"runner=\"${{AGENT_BASH_AGENT_RUNNER_BIN:?missing}}\"\n1320: work=\"${{WU_D_WORK_DIR:?missing}}\"\n1321: session=\"\"\n1322: resume=\"\"\n1323: for ((i=1; i <= $#; i++)); do\n1324:   arg=\"${{!i}}\"\n1325:   if [ \"$arg\" = \"--session-id\" ]; then\n1326:     j=$((i + 1))\n1327:     session=\"${{!j}}\"\n1328:   fi\n1329:   if [ \"$arg\" = \"--resume\" ]; then\n1330:     j=$((i + 1))\n1331:     resume=\"${{!j}}\"\n1332:   fi\n1333:   if [ \"$arg\" = \"--session\" ]; then\n1334:     j=$((i + 1))\n1335:     resume=\"${{!j}}\"\n1336:   fi\n1337: done\n1338: last=\"${{@: -1}}\"\n1339: provider_pid=\"$$\"\n1340: boot_id=\"$(< /proc/sys/kernel/random/boot_id)\"\n1341: stat_line=\"$(< \"/proc/${{provider_pid}}/stat\")\"\n1342: after=\n1343: after=\"${{stat_line##*) }}\"\n1344: read -r -a stat_fields <<< \"$after\"\n1345: start_ticks=\"${{stat_fields[19]}}\"\n1346: notify_handle() {{\n1347:   handle=\"$1\"\n1348:   rc_value=\"$2\"\n1349:   state=\"$work/$handle\"\n1350:   mkdir -p \"$state\"\n1351:   printf '{{\"caller_chain\":[{{\"pid\":%s,\"boot_id\":\"%s\",\"starttime_ticks\":%s}}]}}\\n' \"$provider_pid\" \"$boot_id\" \"$start_ticks\" > \"$state/meta.json\"\n1352:   printf 'log for %s\\n' \"$handle\" > \"$state/log\"\n1353:   printf '%s\\n' \"$rc_value\" > \"$state/rc\"\n1354:   \"$runner\" notify agent-bash-complete \\\n1355:     --caller-ppid \"$provider_pid\" \\\n1356:     --handle \"$handle\" \\\n1357:     --state-dir \"$state\" \\\n1358:     --meta \"$state/meta.json\" \\\n1359:     --log \"$state/log\" \\\n1360:     --rc \"$state/rc\" \\\n1361:     --json > \"$state/notify.json\" 2> \"$state/notify.err\" || true\n1362: }}\n1363: if [ -n \"$resume\" ]; then\n1364:   target=\"$work/{prompt_file}\"\n1365:   mkdir -p \"$(dirname \"$target\")\"\n1366:   printf '%s' \"$last\" > \"$target\"\n1367:   {on_resume}\n1368:   exit 0\n1369: fi\n1370: {on_initial}\n1371: exit 0\n1372: \"#\n1373:     )\n1374: }\n1375: \n1376: fn wait_for_file(path: &Path) -> String {\n1377:     wait_until(&format!(\"{} exists\", path.display()), || path.exists());\n1378:     fs::read_to_string(path).unwrap()\n1379: }\n1380: \n1381: fn wait_for_mailbox_session(fixture: &Fixture) -> String {\n1382:     wait_for_sidecar_session(fixture, \"mailbox\")\n1383: }\n1384: \n1385: fn wait_for_runtime_session(fixture: &Fixture) -> String {\n1386:     wait_for_sidecar_session(fixture, \"session_runtime\")\n1387: }\n1388: \n1389: fn wait_for_sidecar_session(fixture: &Fixture, table: &str) -> String {\n1390:     let mut found = None;\n1391:     wait_until(&format!(\"{table} session id\"), || {\n1392:         found = sidecar_session_id(fixture, table);\n1393:         found.is_some()\n1394:     });\n1395:     found.unwrap()\n1396: }\n1397: \n1398: fn sidecar_session_id(fixture: &Fixture, table: &str) -> Option<String> {\n1399:     let conn = fixture.sidecar_conn();\n1400:     conn.query_row(\n1401:         &format!(\"SELECT session_id FROM {table} ORDER BY session_id LIMIT 1\"),\n1402:         [],\n1403:         |row| row.get(0),\n1404:     )\n1405:     .ok()\n1406: }\n1407: \n1408: fn wait_until(label: &str, mut predicate: impl FnMut() -> bool) {\n1409:     let start = Instant::now();\n1410:     while start.elapsed() < Duration::from_secs(10) {\n1411:         if predicate() {\n1412:             return;\n1413:         }\n1414:         std::thread::sleep(Duration::from_millis(50));\n1415:     }\n1416:     panic!(\"timed out waiting for {label}\");\n1417: }\n1418: \n1419: fn caller_chain(identity: &ProcessIdentity) -> Value {\n1420:     json!({\n1421:         \"caller_chain\": [{\n1422:             \"pid\": identity.os_pid,\n1423:             \"boot_id\": identity.os_boot_id,\n1424:             \"starttime_ticks\": identity.os_pid_starttime_ticks,\n1425:         }]\n1426:     })\n1427: }\n1428: \n1429: fn identity(os_pid: i64, os_boot_id: &str, os_pid_starttime_ticks: i64) -> ProcessIdentity {\n1430:     ProcessIdentity {\n1431:         os_pid,\n1432:         os_boot_id: os_boot_id.to_string(),\n1433:         os_pid_starttime_ticks,\n1434:     }\n1435: }\n1436: \n1437: fn runner_bin() -> &'static str {\n1438:     env!(\"CARGO_BIN_EXE_oulipoly-agent-runner\")\n1439: }\n1440: \n1441: fn ts(value: &str) -> DateTime<Utc> {\n1442:     DateTime::parse_from_rfc3339(value)\n1443:         .unwrap()\n1444:         .with_timezone(&Utc)\n1445: }\n1446: \n1447: fn path_string(path: &Path) -> String {\n1448:     path.to_string_lossy().into_owned()\n1449: }\n1450: \n1451: fn toml_string(value: &str) -> String {\n1452:     serde_json::to_string(value).unwrap()\n1453: }\n\n(End of file - total 1453 lines)\n</content>","metadata":{"preview":"#![cfg(unix)]\n\n//! ## Declared roles\n//!\n//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n//! predicate, filter.\n//!\n//! TEST: proactive wake and wake-reclaim end-to-end fixtures — fake CLI script\n//! formatters, model/config mappers, state and mailbox accessors, JSON/record\n//! parsers, liveness and delivery predicates/filters, wake-claim and durable\n//! mailbox validators, and test orchestration.\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/tests/wu_d_proactive_wake_integration.rs\n//!     role: adapter\n//!     Translates:\n//!       - runtime-cli-dispatch-contract","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/wu_d_proactive_wake_integration.rs","text":"#![cfg(unix)]\n\n//! ## Declared roles\n//!\n//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n//! predicate, filter.\n//!\n//! TEST: proactive wake and wake-reclaim end-to-end fixtures — fake CLI script\n//! formatters, model/config mappers, state and mailbox accessors, JSON/record\n//! parsers, liveness and delivery predicates/filters, wake-claim and durable\n//! mailbox validators, and test orchestration.\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/tests/wu_d_proactive_wake_integration.rs\n//!     role: adapter\n//!     Translates:\n//!       - runtime-cli-dispatch-contract\n//!       - wake-claim-sidecar-contract\n//!       - pid-identity-sidecar-contract\n//!       - mailbox-delivery-contract\n//!       - test-fixture-process-contract\n//! intrinsic_surface_declarations:\n//!   - component: src-tauri/tests/wu_d_proactive_wake_integration.rs\n//!     role: intrinsic-surface\n//!     Domain: proactive wake and wake-reclaim regression suite\n//!     Owns:\n//!       - isolated config/data fixture materialization\n//!       - fake provider script generation and executable setup\n//!       - auto-wake command invocation and environment isolation\n//!       - sidecar wake-claim fixture construction\n//!       - mailbox delivery, busy suppression, and consumed suppression assertions\n//! ```\n\nuse chrono::{DateTime, Utc};\nuse oulipoly_state::mailbox::{\n    AgentBashCompleteEnqueue, MailboxDb, SessionRuntimeUpsert, WAKE_SWEEP_ABANDONED_ERROR,\n    WakeClaimAcquireResult, WakeClaimRequest,\n};\nuse oulipoly_state::pid_identity::{\n    PidIdentityDb, PidIdentityRecord, ProcessIdentity, read_live_process_identity,\n};\nuse oulipoly_state::{SessionTurnIngest, StateDb};\nuse rusqlite::Connection;\nuse serde_json::{Value, json};\nuse std::fs;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::{Path, PathBuf};\nuse std::process::{Command, Output, Stdio};\nuse std::sync::{Mutex, MutexGuard, OnceLock};\nuse std::time::{Duration, Instant};\n\nconst MODEL: &str = \"wu-d-fixture-model\";\nconst PROVIDER: &str = \"wu-d-fixture-provider\";\nconst SESSION: &str = \"5169694d-de0f-40d1-890c-6e28e55bab27\";\nconst CAPTURED_OPENCODE_SESSION: &str = \"ses_capturemidturn\";\nconst INVOCATION: &str = \"11111111-1111-4111-8111-111111111111\";\n\nstruct Fixture {\n    dir: tempfile::TempDir,\n    config_home: PathBuf,\n    data_home: PathBuf,\n    home_dir: PathBuf,\n    app_config_dir: PathBuf,\n    models_dir: PathBuf,\n    work_dir: PathBuf,\n}\n\nimpl Fixture {\n    fn new() -> Self {\n        let dir = tempfile::tempdir().unwrap();\n        let config_home = dir.path().join(\"xdg-config\");\n        let data_home = dir.path().join(\"xdg-data\");\n        let home_dir = dir.path().join(\"home\");\n        let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n        let models_dir = app_config_dir.join(\"models\");\n        let work_dir = dir.path().join(\"work\");\n        fs::create_dir_all(&models_dir).unwrap();\n        fs::create_dir_all(&home_dir).unwrap();\n        fs::create_dir_all(&work_dir).unwrap();\n        Self {\n            dir,\n            config_home,\n            data_home,\n            home_dir,\n            app_config_dir,\n            models_dir,\n            work_dir,\n        }\n    }\n\n    fn sidecar_path(&self) -> PathBuf {\n        self.data_home\n            .join(\"oulipoly-agent-runner\")\n            .join(\"pid-identity.db\")\n    }\n\n    fn state_path(&self) -> PathBuf {\n        self.data_home\n            .join(\"oulipoly-agent-runner\")\n            .join(\"state.db\")\n    }\n\n    fn pinned_data_dir(&self) -> PathBuf {\n        self.data_home.join(\"oulipoly-agent-runner\")\n    }\n\n    fn run(&self, mut cmd: Command) -> Output {\n        cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n            .env(\"XDG_DATA_HOME\", &self.data_home)\n            .env(\"HOME\", &self.home_dir)\n            .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n            .env(\"WU_D_WORK_DIR\", &self.work_dir)\n            .env_remove(\"OULIPOLY_DATA_DIR\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_SESSION_ID\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_TOKEN\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_COUNT\")\n            .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n            .current_dir(self.dir.path());\n        cmd.output().unwrap()\n    }\n\n    fn run_agent(&self, prompt: &str) -> Output {\n        let mut cmd = Command::new(runner_bin());\n        cmd.arg(\"-m\")\n            .arg(MODEL)\n            .arg(\"--models-dir\")\n            .arg(&self.models_dir)\n            .arg(prompt);\n        self.run(cmd)\n    }\n\n    fn run_resume(&self) -> Output {\n        let mut cmd = Command::new(runner_bin());\n        cmd.arg(\"resume\")\n            .arg(\"-m\")\n            .arg(MODEL)\n            .arg(\"--session-id\")\n            .arg(SESSION)\n            .arg(\"--models-dir\")\n            .arg(&self.models_dir);\n        self.run(cmd)\n    }\n\n    fn run_mailbox_list(&self, session_id: &str) -> Output {\n        let mut cmd = Command::new(runner_bin());\n        cmd.arg(\"mailbox\")\n            .arg(\"list\")\n            .arg(\"--session-id\")\n            .arg(session_id)\n            .arg(\"--json\");\n        self.run(cmd)\n    }\n\n    fn write_provider(&self, body: &str) {\n        let script = self.write_script(\"provider.sh\", body);\n        fs::write(\n            self.models_dir.join(format!(\"{MODEL}.toml\")),\n            format!(\n                r#\"[[providers]]\nname = \"{PROVIDER}\"\nargs = []\n\"#,\n            ),\n        )\n        .unwrap();\n        fs::write(\n            self.app_config_dir.join(\"providers.toml\"),\n            format!(\n                r#\"[{PROVIDER}]\ncommand = {}\nargs = []\ninteractive_args = [\"interactive\"]\nprompt_mode = \"arg\"\n\n[{PROVIDER}.session_capture]\nkind = \"forced_flag_verified\"\nflag = \"--session-id\"\n\n[{PROVIDER}.resume]\nkind = \"flag\"\nflag = \"--resume\"\n\"#,\n                toml_string(&path_string(&script))\n            ),\n        )\n        .unwrap();\n    }\n\n    fn write_opencode_provider(&self, body: &str) {\n        let script = self.write_script(\"opencode.sh\", body);\n        fs::write(\n            self.models_dir.join(format!(\"{MODEL}.toml\")),\n            r#\"[[providers]]\nname = \"opencode\"\nargs = []\n\"#,\n        )\n        .unwrap();\n        fs::write(\n            self.app_config_dir.join(\"providers.toml\"),\n            format!(\n                r#\"[opencode]\ncommand = {}\nargs = []\ninteractive_args = [\"interactive\"]\nprompt_mode = \"arg\"\n\n[opencode.resume]\nkind = \"flag\"\nflag = \"--session\"\n\"#,\n                toml_string(&path_string(&script))\n            ),\n        )\n        .unwrap();\n    }\n\n    fn write_opencode_capture_provider(&self, body: &str) {\n        let script = self.write_script(\"opencode-capture.sh\", body);\n        fs::write(\n            self.models_dir.join(format!(\"{MODEL}.toml\")),\n            r#\"[[providers]]\nname = \"opencode\"\nargs = []\n\"#,\n        )\n        .unwrap();\n        fs::write(\n            self.app_config_dir.join(\"providers.toml\"),\n            format!(\n                r#\"[opencode]\ncommand = {}\nargs = []\ninteractive_args = [\"interactive\"]\nprompt_mode = \"arg\"\n\n[opencode.session_capture]\nkind = \"stdout_json_event\"\njson_args = [\"--json\"]\nevent_type = \"step_start\"\nevent_id_path = \"sessionID\"\n\n[opencode.resume]\nkind = \"flag\"\nflag = \"--session\"\n\"#,\n                toml_string(&path_string(&script))\n            ),\n        )\n        .unwrap();\n    }\n\n    fn pid_identity_session_id_for_provider(&self, provider_name: &str) -> String {\n        self.sidecar_conn()\n            .query_row(\n                \"SELECT session_id\n                 FROM pid_identity\n                 WHERE provider_name = ?1\n                 ORDER BY recorded_at DESC, os_pid DESC\n                 LIMIT 1\",\n                rusqlite::params![provider_name],\n                |row| row.get(0),\n            )\n            .unwrap()\n    }\n\n    fn write_script(&self, name: &str, body: &str) -> PathBuf {\n        let path = self.dir.path().join(name);\n        fs::write(\n            &path,\n            format!(\"#!/usr/bin/env bash\\nset -euo pipefail\\n{body}\\n\"),\n        )\n        .unwrap();\n        let mut perms = fs::metadata(&path).unwrap().permissions();\n        perms.set_mode(0o755);\n        fs::set_permissions(&path, perms).unwrap();\n        path\n    }\n\n    fn mailbox(&self) -> MailboxDb {\n        MailboxDb::open(&self.sidecar_path()).unwrap()\n    }\n\n    fn sidecar_conn(&self) -> Connection {\n        Connection::open(self.sidecar_path()).unwrap()\n    }\n\n    fn state(&self) -> StateDb {\n        StateDb::open(&self.state_path()).unwrap()\n    }\n\n    fn seed_session_turn(&self) {\n        self.seed_session_turn_for(PROVIDER, SESSION, \"turn-a\");\n    }\n\n    fn seed_session_turn_for(&self, provider_name: &str, session_id: &str, turn_id: &str) {\n        let db = self.state();\n        db.ingest_session_turns_batch(\n            provider_name,\n            &[SessionTurnIngest {\n                session_id: session_id.to_string(),\n                turn_id: turn_id.to_string(),\n                timestamp: ts(\"2026-06-04T12:00:00Z\"),\n                role: \"assistant\".to_string(),\n                parent_turn_id: None,\n                is_sidechain: false,\n                is_compaction_boundary: false,\n                body: None,\n            }],\n        )\n        .unwrap();\n    }\n\n    fn seed_consumed_notification_turn(&self, handle: &str) {\n        self.state()\n            .ingest_session_turns_batch(\n                PROVIDER,\n                &[SessionTurnIngest {\n                    session_id: SESSION.to_string(),\n                    turn_id: format!(\"turn-consumed-{handle}\"),\n                    timestamp: ts(\"2026-06-04T12:01:00Z\"),\n                    role: \"user\".to_string(),\n                    parent_turn_id: None,\n                    is_sidechain: false,\n                    is_compaction_boundary: false,\n                    body: Some(format!(\"[OULIPOLY NOTIFICATIONS]\\nhandle: {handle}\\n\")),\n                }],\n            )\n            .unwrap();\n    }\n\n    fn seed_idle_runtime(&self) {\n        self.seed_idle_runtime_for(SESSION, PROVIDER, MODEL);\n    }\n\n    fn seed_idle_runtime_for(&self, session_id: &str, provider_name: &str, model_name: &str) {\n        let mut db = MailboxDb::open(&self.sidecar_path()).unwrap();\n        let models_dir = path_string(&self.models_dir);\n        db.upsert_session_runtime(SessionRuntimeUpsert {\n            session_id,\n            mode: \"headless\",\n            invocation_uuid: None,\n            provider_name: Some(provider_name),\n            model_name: Some(model_name),\n            pty_control_path: None,\n            models_dir: Some(&models_dir),\n            effective_cwd: None,\n        })\n        .unwrap();\n    }\n\n    fn seed_active_chain_for(\n        &self,\n        chain_id: &str,\n        provider_name: &str,\n        session_id: &str,\n        model_name: &str,\n    ) {\n        let _ = StateDb::open(&self.state_path()).unwrap();\n        let conn = Connection::open(self.state_path()).unwrap();\n        conn.execute(\n            \"INSERT INTO session_chains (chain_id, created_at, last_used_at, model_name)\n             VALUES (?1, '2026-06-04T12:00:00Z', '2026-06-04T12:00:00Z', ?2)\",\n            rusqlite::params![chain_id, model_name],\n        )\n        .unwrap();\n        conn.execute(\n            \"INSERT INTO session_chain_segments\n                (chain_id, provider_name, session_id, started_at, transition_reason)\n             VALUES (?1, ?2, ?3, '2026-06-04T12:00:00Z', 'initial')\",\n            rusqlite::params![chain_id, provider_name, session_id],\n        )\n        .unwrap();\n    }\n\n    fn seed_mailbox(&self, session_id: &str, handle: &str) {\n        self.seed_mailbox_for(session_id, handle, Some(INVOCATION));\n    }\n\n    fn seed_mailbox_for(\n        &self,\n        session_id: &str,\n        handle: &str,\n        owner_invocation_uuid: Option<&str>,\n    ) {\n        let state_dir = self.work_dir.join(format!(\"seed-{handle}\"));\n        fs::create_dir_all(&state_dir).unwrap();\n        let meta = state_dir.join(\"meta.json\");\n        let log = state_dir.join(\"log\");\n        let rc = state_dir.join(\"rc\");\n        fs::write(&meta, r#\"{\"caller_chain\":[]}\"#).unwrap();\n        fs::write(&log, format!(\"log {handle}\\n\")).unwrap();\n        fs::write(&rc, \"0\\n\").unwrap();\n        let mut db = MailboxDb::open(&self.sidecar_path()).unwrap();\n        db.enqueue_agent_bash_complete(&AgentBashCompleteEnqueue {\n            session_id,\n            handle,\n            payload_json: r#\"{\"schema_version\":1,\"kind\":\"agent_bash_complete\"}\"#,\n            owner_invocation_uuid,\n            matched_os_pid: Some(9_300),\n            matched_os_boot_id: Some(\"boot-seeded\"),\n            matched_os_pid_starttime_ticks: Some(456),\n            matched_chain_index: Some(0),\n            state_dir: &path_string(&state_dir),\n            meta_path: &path_string(&meta),\n            log_path: &path_string(&log),\n            rc_path: &path_string(&rc),\n            rc: 0,\n        })\n        .unwrap();\n    }\n\n    fn age_mailbox_for(&self, session_id: &str, seconds_old: i64) {\n        let enqueued_at = (Utc::now() - chrono::Duration::seconds(seconds_old)).to_rfc3339();\n        self.sidecar_conn()\n            .execute(\n                \"UPDATE mailbox SET enqueued_at = ?2 WHERE session_id = ?1\",\n                rusqlite::params![session_id, enqueued_at],\n            )\n            .unwrap();\n    }\n\n    fn mark_mailbox_unconfirmed_twice(&self, session_id: &str, handle: &str) {\n        let mut db = self.mailbox();\n        let row = db\n            .list_mailbox(session_id, true)\n            .unwrap()\n            .into_iter()\n            .find(|row| row.handle == handle)\n            .unwrap_or_else(|| panic!(\"missing seeded mailbox row {handle}\"));\n        db.mark_delivery_failed(session_id, &[row.seq], \"mailbox_delivery_unconfirmed\")\n            .unwrap();\n        db.mark_delivery_failed(session_id, &[row.seq], \"mailbox_delivery_unconfirmed\")\n            .unwrap();\n    }\n\n    fn record_identity(&self, identity: &ProcessIdentity) {\n        self.record_identity_for(identity, SESSION, PROVIDER, MODEL);\n    }\n\n    fn record_identity_for(\n        &self,\n        identity: &ProcessIdentity,\n        session_id: &str,\n        provider_name: &str,\n        model_name: &str,\n    ) {\n        let sidecar = PidIdentityDb::open(&self.sidecar_path()).unwrap();\n        sidecar\n            .record_identity(PidIdentityRecord {\n                identity,\n                os_pgid: None,\n                invocation_uuid: INVOCATION,\n                session_id: Some(session_id),\n                provider_name: Some(provider_name),\n                model_name: Some(model_name),\n                recorded_at: \"2026-06-04T12:00:00Z\",\n            })\n            .unwrap();\n    }\n\n    fn prompt_file(&self, name: &str) -> PathBuf {\n        self.work_dir.join(name)\n    }\n\n    fn assert_xdg_isolated(&self) {\n        assert!(\n            !self\n                .home_dir\n                .join(\".local/share/oulipoly-agent-runner\")\n                .exists(),\n            \"state must stay in isolated XDG_DATA_HOME\"\n        );\n        assert!(\n            !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n            \"config must stay in isolated XDG_CONFIG_HOME\"\n        );\n    }\n}\n\n#[test]\nfn idle_wake_delivers() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\n        r#\"( sleep 0.3; notify_handle h-idle 0 ) >/dev/null 2>&1 &\"#,\n        \"\",\n        \"resumed-input.txt\",\n    ));\n\n    let output = fixture.run_agent(\"dispatch background work\");\n    assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"resumed-input.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n    assert!(prompt.contains(\"handle: h-idle\"), \"{prompt}\");\n    assert!(prompt.contains(\"rc: 0\"), \"{prompt}\");\n    let session_id = wait_for_mailbox_session(&fixture);\n    wait_until(\"mailbox delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(&session_id, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && db.wake_claim(&session_id).unwrap().is_none()\n    });\n    let mailbox = fixture.mailbox();\n    assert!(mailbox.list_pending(&session_id).unwrap().is_empty());\n    assert_eq!(\n        mailbox\n            .session_runtime(&session_id)\n            .unwrap()\n            .unwrap()\n            .run_state,\n        \"idle\"\n    );\n    assert!(mailbox.wake_claim(&session_id).unwrap().is_none());\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn busy_then_turn_end_delivers() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\n        r#\"( sleep 0.1; notify_handle h-a 0 ) >/dev/null 2>&1 &\n( sleep 0.2; notify_handle h-b 0 ) >/dev/null 2>&1 &\n( sleep 0.3; notify_handle h-c 0 ) >/dev/null 2>&1 &\nsleep 1\"#,\n        \"\",\n        \"busy-resumed-input.txt\",\n    ));\n\n    let output = fixture.run_agent(\"dispatch busy work\");\n    assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"busy-resumed-input.txt\"));\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    let pos_a = prompt.find(\"handle: h-a\").unwrap();\n    let pos_b = prompt.find(\"handle: h-b\").unwrap();\n    let pos_c = prompt.find(\"handle: h-c\").unwrap();\n    assert!(pos_a < pos_b && pos_b < pos_c, \"{prompt}\");\n    let session_id = wait_for_mailbox_session(&fixture);\n    wait_until(\"busy rows delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(&session_id, true).unwrap();\n        rows.len() == 3\n            && rows.iter().all(|row| row.delivered_at.is_some())\n            && db.wake_claim(&session_id).unwrap().is_none()\n    });\n    assert!(fixture.mailbox().wake_claim(&session_id).unwrap().is_none());\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn no_undelivered_no_wake_and_loop_terminates() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\"\", \"\", \"no-pending-resume.txt\"));\n\n    let output = fixture.run_agent(\"no pending\");\n    assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n\n    let session_id = wait_for_runtime_session(&fixture);\n    wait_until(\"runtime idle\", || {\n        fixture\n            .mailbox()\n            .session_runtime(&session_id)\n            .unwrap()\n            .is_some_and(|row| row.run_state == \"idle\")\n    });\n    let mailbox = fixture.mailbox();\n    assert!(mailbox.list_pending(&session_id).unwrap().is_empty());\n    assert!(mailbox.wake_claim(&session_id).unwrap().is_none());\n    assert!(!fixture.prompt_file(\"no-pending-resume.txt\").exists());\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn auto_wake_cap_stops_self_replicating_session() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\n        r#\"( sleep 0.3; notify_handle h-start 0 ) >/dev/null 2>&1 &\"#,\n        r#\"count=\"${OULIPOLY_AUTO_WAKE_COUNT:-0}\"\nnotify_handle \"h-auto-${count}\" 0\"#,\n        \"resumed-${OULIPOLY_AUTO_WAKE_COUNT:-0}.txt\",\n    ));\n    let mut cmd = Command::new(runner_bin());\n    cmd.arg(\"-m\")\n        .arg(MODEL)\n        .arg(\"--models-dir\")\n        .arg(&fixture.models_dir)\n        .arg(\"self replicate\")\n        .env(\"OULIPOLY_AUTO_WAKE_MAX\", \"2\");\n    let output = fixture.run(cmd);\n    assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n\n    let first = wait_for_file(&fixture.prompt_file(\"resumed-1.txt\"));\n    let second = wait_for_file(&fixture.prompt_file(\"resumed-2.txt\"));\n    let session_id = wait_for_mailbox_session(&fixture);\n    assert!(first.contains(\"handle: h-start\"), \"{first}\");\n    assert!(second.contains(\"handle: h-auto-1\"), \"{second}\");\n    wait_until(\"cap leaves pending\", || {\n        let db = fixture.mailbox();\n        let pending = db.list_pending(&session_id).unwrap();\n        pending.len() == 1\n            && pending[0].handle == \"h-auto-2\"\n            && db.wake_claim(&session_id).unwrap().is_none()\n    });\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn concurrent_notify_single_flight() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\n        \"\",\n        r#\"printf 'wake\\n' >> \"$work/concurrent-wake-launches.log\"\nsleep 0.2\"#,\n        \"concurrent-resume.txt\",\n    ));\n    fixture.seed_session_turn();\n    fixture.seed_idle_runtime();\n    let identity = identity(9_200, \"boot-concurrent\", 123);\n    fixture.record_identity(&identity);\n\n    let child_a = notify_command(&fixture, \"h-concurrent-a\", &identity)\n        .spawn()\n        .unwrap();\n    let child_b = notify_command(&fixture, \"h-concurrent-b\", &identity)\n        .spawn()\n        .unwrap();\n    let output_a = child_a.wait_with_output().unwrap();\n    let output_b = child_b.wait_with_output().unwrap();\n    assert_notify_success(&output_a);\n    assert_notify_success(&output_b);\n    assert_single_wake_claim_won(&[notify_wake(&output_a), notify_wake(&output_b)]);\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"concurrent-resume.txt\"));\n    assert!(prompt.contains(\"handle: h-concurrent-\"), \"{prompt}\");\n    wait_until(\"concurrent rows delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 2\n            && rows.iter().all(|row| row.delivered_at.is_some())\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    assert_single_wake_child_launch(&wait_for_file(\n        &fixture.prompt_file(\"concurrent-wake-launches.log\"),\n    ));\n    assert!(fixture.mailbox().wake_claim(SESSION).unwrap().is_none());\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn manual_resume_race_is_safe() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\"\", \"\", \"manual-race.txt\"));\n    fixture.seed_session_turn();\n    fixture.seed_idle_runtime();\n    fixture.seed_mailbox(SESSION, \"h-manual-race\");\n    let mut db = fixture.mailbox();\n    assert!(matches!(\n        db.try_acquire_wake_claim(WakeClaimRequest {\n            session_id: SESSION,\n            claim_token: \"manual-race-token\",\n            reason: \"notify_idle\",\n            auto_wake_count: 1,\n            wake_invocation_uuid: None,\n            stale_after_seconds: 600,\n        })\n        .unwrap(),\n        WakeClaimAcquireResult::Acquired(_)\n    ));\n    drop(db);\n\n    let output = fixture.run_resume();\n    assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"manual-race.txt\"));\n    assert!(prompt.contains(\"handle: h-manual-race\"), \"{prompt}\");\n    wait_until(\"manual race delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn opencode_notify_idle_wakes_resume_with_ses_session() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_opencode_provider(&provider_script(\n        \"\",\n        r#\"if [ \"$resume\" != \"ses_fixture\" ]; then\n  printf 'expected --session ses_fixture, got %s\\n' \"$resume\" >&2\n  exit 66\nfi\"#,\n        \"opencode-resumed.txt\",\n    ));\n    fixture.seed_active_chain_for(\n        \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n        \"opencode\",\n        \"ses_fixture\",\n        MODEL,\n    );\n    fixture.seed_idle_runtime_for(\"ses_fixture\", \"opencode\", MODEL);\n    let identity = identity(9_400, \"boot-opencode\", 789);\n    fixture.record_identity_for(&identity, \"ses_fixture\", \"opencode\", MODEL);\n\n    let output = notify_command(&fixture, \"h-opencode\", &identity)\n        .output()\n        .unwrap();\n\n    assert_notify_success(&output);\n    let prompt = wait_for_file(&fixture.prompt_file(\"opencode-resumed.txt\"));\n    assert!(prompt.contains(\"handle: h-opencode\"), \"{prompt}\");\n    wait_until(\"opencode mailbox delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(\"ses_fixture\", true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && db.wake_claim(\"ses_fixture\").unwrap().is_none()\n    });\n    assert!(\n        fixture\n            .mailbox()\n            .list_pending(\"ses_fixture\")\n            .unwrap()\n            .is_empty()\n    );\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn opencode_mid_turn_notify_resolves_capture_time_sidecar_owner() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    let event = json!({\n        \"type\": \"step_start\",\n        \"sessionID\": CAPTURED_OPENCODE_SESSION,\n    });\n    fixture.write_opencode_capture_provider(&provider_script(\n        &format!(\n            r#\"printf '%s\\n' '{}'\nsleep 0.2\nnotify_handle h-capture-midturn 0\nsleep 0.2\"#,\n            event\n        ),\n        r#\"if [ \"$resume\" != \"ses_capturemidturn\" ]; then\n  printf 'expected --session ses_capturemidturn, got %s\\n' \"$resume\" >&2\n  exit 66\nfi\"#,\n        \"opencode-capture-resumed.txt\",\n    ));\n    fixture.seed_active_chain_for(\n        \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n        \"opencode\",\n        CAPTURED_OPENCODE_SESSION,\n        MODEL,\n    );\n\n    let output = fixture.run_agent(\"dispatch capture race\");\n    assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n\n    let notify_json = wait_for_file(&fixture.work_dir.join(\"h-capture-midturn/notify.json\"));\n    let notify: Value = serde_json::from_str(&notify_json).unwrap();\n    assert_eq!(\n        notify.get(\"status\").and_then(Value::as_str),\n        Some(\"enqueued\")\n    );\n    assert_eq!(notify.get(\"enqueued\").and_then(Value::as_bool), Some(true));\n    assert_eq!(\n        notify.get(\"owner_session_id\").and_then(Value::as_str),\n        Some(CAPTURED_OPENCODE_SESSION)\n    );\n    assert_eq!(\n        notify.get(\"session_source\").and_then(Value::as_str),\n        Some(\"sidecar_session_id\")\n    );\n    assert_eq!(\n        notify\n            .get(\"wake\")\n            .and_then(|wake| wake.get(\"status\"))\n            .and_then(Value::as_str),\n        Some(\"busy\")\n    );\n\n    assert_eq!(\n        fixture.pid_identity_session_id_for_provider(\"opencode\"),\n        CAPTURED_OPENCODE_SESSION\n    );\n    let prompt = wait_for_file(&fixture.prompt_file(\"opencode-capture-resumed.txt\"));\n    assert!(prompt.contains(\"handle: h-capture-midturn\"), \"{prompt}\");\n    wait_until(\"captured opencode mailbox delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(CAPTURED_OPENCODE_SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].handle == \"h-capture-midturn\"\n            && rows[0].delivered_at.is_some()\n            && rows[0].owner_invocation_uuid.is_some()\n            && rows[0].matched_os_pid.is_some()\n            && rows[0].matched_chain_index == Some(0)\n            && db.wake_claim(CAPTURED_OPENCODE_SESSION).unwrap().is_none()\n    });\n    assert_eq!(\n        fixture\n            .mailbox()\n            .session_runtime(CAPTURED_OPENCODE_SESSION)\n            .unwrap()\n            .unwrap()\n            .run_state,\n        \"idle\"\n    );\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn batch_cap_followup_wake() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\n        \"\",\n        \"\",\n        \"batch-${OULIPOLY_AUTO_WAKE_COUNT:-manual}.txt\",\n    ));\n    fixture.seed_session_turn();\n    fixture.seed_idle_runtime();\n    for index in 0..25 {\n        fixture.seed_mailbox(SESSION, &format!(\"h-batch-{index:02}\"));\n    }\n\n    let output = fixture.run_resume();\n    assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n\n    let first = wait_for_file(&fixture.prompt_file(\"batch-manual.txt\"));\n    let second = wait_for_file(&fixture.prompt_file(\"batch-1.txt\"));\n    assert!(\n        first.contains(\"5 additional notification(s) remain queued\"),\n        \"{first}\"\n    );\n    assert!(second.contains(\"handle: h-batch-20\"), \"{second}\");\n    wait_until(\"batch rows delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 25\n            && rows.iter().all(|row| row.delivered_at.is_some())\n            && db.list_pending(SESSION).unwrap().is_empty()\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn wake_sweep_reclaims_dead_claim_and_delivers_pending_mailbox() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\"\", \"\", \"sweep-reclaimed.txt\"));\n    fixture.seed_session_turn();\n    fixture.seed_idle_runtime();\n    fixture.seed_mailbox(SESSION, \"h-sweep-reclaim\");\n    seed_dead_wake_claim(&fixture, \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\", 601);\n\n    let output = fixture.run_mailbox_list(SESSION);\n    assert_success(&output);\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"sweep-reclaimed.txt\"));\n    assert!(prompt.contains(\"handle: h-sweep-reclaim\"), \"{prompt}\");\n    wait_until(\"sweep reclaimed dead claim and delivered mailbox\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && rows[0].delivery_error.is_none()\n            && db.wake_claim(SESSION).unwrap().is_none()\n    });\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn wake_sweep_does_not_disturb_live_identity_matched_claim() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\"\", \"\", \"live-claim-not-disturbed.txt\"));\n    fixture.seed_session_turn();\n    fixture.seed_idle_runtime();\n    fixture.seed_mailbox(SESSION, \"h-live-claim\");\n    seed_live_wake_claim(&fixture, \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\");\n\n    let output = fixture.run_mailbox_list(SESSION);\n    assert_success(&output);\n    std::thread::sleep(Duration::from_millis(300));\n\n    assert!(!fixture.prompt_file(\"live-claim-not-disturbed.txt\").exists());\n    let claim = fixture.mailbox().wake_claim(SESSION).unwrap().unwrap();\n    assert_eq!(claim.claim_token, \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\");\n    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn wake_sweep_does_not_rewake_consumed_pending_mailbox() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\"\", \"\", \"consumed-not-rewoken.txt\"));\n    fixture.seed_session_turn();\n    fixture.seed_idle_runtime();\n    fixture.seed_mailbox(SESSION, \"h-consumed\");\n    fixture.seed_consumed_notification_turn(\"h-consumed\");\n    seed_dead_wake_claim(&fixture, \"cccccccc-cccc-4ccc-8ccc-cccccccccccc\", 601);\n\n    let output = fixture.run_mailbox_list(SESSION);\n    assert_success(&output);\n    std::thread::sleep(Duration::from_millis(300));\n\n    assert!(!fixture.prompt_file(\"consumed-not-rewoken.txt\").exists());\n    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn wake_sweep_does_not_rewake_twice_unconfirmed_pending_mailbox() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\n        \"\",\n        \"\",\n        \"twice-unconfirmed-not-rewoken.txt\",\n    ));\n    fixture.seed_session_turn();\n    fixture.seed_idle_runtime();\n    fixture.seed_mailbox(SESSION, \"h-unconfirmed\");\n    fixture.mark_mailbox_unconfirmed_twice(SESSION, \"h-unconfirmed\");\n    seed_dead_wake_claim(&fixture, \"dddddddd-dddd-4ddd-8ddd-dddddddddddd\", 601);\n\n    let output = fixture.run_mailbox_list(SESSION);\n    assert_success(&output);\n    std::thread::sleep(Duration::from_millis(300));\n\n    assert!(\n        !fixture\n            .prompt_file(\"twice-unconfirmed-not-rewoken.txt\")\n            .exists()\n    );\n    let rows = fixture.mailbox().list_pending(SESSION).unwrap();\n    assert_eq!(rows.len(), 1);\n    assert_eq!(rows[0].handle, \"h-unconfirmed\");\n    assert_eq!(rows[0].delivery_attempts, 2);\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn wake_sweep_skips_twice_unconfirmed_rows_and_delivers_newer_pending_mailbox() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\"\", \"\", \"newer-after-unconfirmed.txt\"));\n    fixture.seed_session_turn();\n    fixture.seed_idle_runtime();\n    fixture.seed_mailbox(SESSION, \"h-unconfirmed-old\");\n    fixture.seed_mailbox(SESSION, \"h-newer\");\n    fixture.mark_mailbox_unconfirmed_twice(SESSION, \"h-unconfirmed-old\");\n    seed_dead_wake_claim(&fixture, \"eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee\", 601);\n\n    let output = fixture.run_mailbox_list(SESSION);\n    assert_success(&output);\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"newer-after-unconfirmed.txt\"));\n    assert!(!prompt.contains(\"handle: h-unconfirmed-old\"), \"{prompt}\");\n    assert!(prompt.contains(\"handle: h-newer\"), \"{prompt}\");\n    wait_until(\n        \"newer mailbox delivered while exhausted row remains pending\",\n        || {\n            let rows = fixture.mailbox().list_mailbox(SESSION, true).unwrap();\n            let old = rows.iter().find(|row| row.handle == \"h-unconfirmed-old\");\n            let newer = rows.iter().find(|row| row.handle == \"h-newer\");\n            old.is_some_and(|row| row.delivered_at.is_none() && row.delivery_attempts == 2)\n                && newer.is_some_and(|row| row.delivered_at.is_some())\n        },\n    );\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn wake_sweep_backlog_recovers_recent_leak_and_reaps_dead_owner_debris() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\n        \"\",\n        r#\"printf '%s' \"$last\" > \"$work/backlog-$resume.txt\"\"#,\n        \"backlog-any.txt\",\n    ));\n\n    let dead_sessions = (0..16)\n        .map(|index| format!(\"00000000-0000-4000-8000-{index:012x}\"))\n        .collect::<Vec<_>>();\n    for (index, session_id) in dead_sessions.iter().enumerate() {\n        let handle = format!(\"h-dead-owner-{index}\");\n        fixture.seed_mailbox_for(session_id, &handle, None);\n        fixture.age_mailbox_for(session_id, 86_400);\n        seed_dead_wake_claim_for(\n            &fixture,\n            session_id,\n            &format!(\"dead0000-0000-4000-8000-{index:012x}\"),\n            601,\n        );\n    }\n\n    let idle_session = \"11111111-1111-4111-8111-000000000001\";\n    fixture.seed_active_chain_for(\n        \"22222222-2222-4222-8222-000000000001\",\n        PROVIDER,\n        idle_session,\n        MODEL,\n    );\n    fixture.seed_session_turn_for(PROVIDER, idle_session, \"turn-idle-backlog\");\n    fixture.seed_idle_runtime_for(idle_session, PROVIDER, MODEL);\n    fixture.seed_mailbox(idle_session, \"h-idle-resumable-backlog\");\n    fixture.age_mailbox_for(idle_session, 3_600);\n    seed_dead_wake_claim_for(\n        &fixture,\n        idle_session,\n        \"eeee0000-0000-4000-8000-000000000001\",\n        601,\n    );\n\n    let recent_session = \"11111111-1111-4111-8111-000000000002\";\n    fixture.seed_active_chain_for(\n        \"22222222-2222-4222-8222-000000000002\",\n        PROVIDER,\n        recent_session,\n        MODEL,\n    );\n    fixture.seed_session_turn_for(PROVIDER, recent_session, \"turn-recent-backlog\");\n    fixture.seed_idle_runtime_for(recent_session, PROVIDER, MODEL);\n    fixture.seed_mailbox(recent_session, \"h-recent-leak-backlog\");\n    seed_dead_wake_claim_for(\n        &fixture,\n        recent_session,\n        \"eeee0000-0000-4000-8000-000000000002\",\n        601,\n    );\n\n    let output = fixture.run_mailbox_list(recent_session);\n    assert_success(&output);\n\n    let idle_prompt = wait_for_file(&fixture.prompt_file(&format!(\"backlog-{idle_session}.txt\")));\n    assert!(\n        idle_prompt.contains(\"handle: h-idle-resumable-backlog\"),\n        \"{idle_prompt}\"\n    );\n    let recent_prompt =\n        wait_for_file(&fixture.prompt_file(&format!(\"backlog-{recent_session}.txt\")));\n    assert!(\n        recent_prompt.contains(\"handle: h-recent-leak-backlog\"),\n        \"{recent_prompt}\"\n    );\n\n    wait_until(\n        \"backlog recoverable sessions delivered and debris reaped\",\n        || {\n            let db = fixture.mailbox();\n            let idle_rows = db.list_mailbox(idle_session, true).unwrap();\n            let recent_rows = db.list_mailbox(recent_session, true).unwrap();\n            let recovered = idle_rows.len() == 1\n                && idle_rows[0].delivered_at.is_some()\n                && recent_rows.len() == 1\n                && recent_rows[0].delivered_at.is_some();\n            let debris_reaped = dead_sessions.iter().all(|session_id| {\n                let rows = db.list_mailbox(session_id, true).unwrap();\n                rows.len() == 1\n                    && rows[0].delivered_at.is_none()\n                    && rows[0].delivery_error.as_deref() == Some(WAKE_SWEEP_ABANDONED_ERROR)\n                    && db.wake_claim(session_id).unwrap().is_none()\n            });\n            recovered && debris_reaped\n        },\n    );\n    for session_id in dead_sessions {\n        assert!(\n            !fixture\n                .prompt_file(&format!(\"backlog-{session_id}.txt\"))\n                .exists(),\n            \"dead-owner debris must not be re-woken: {session_id}\"\n        );\n    }\n    fixture.assert_xdg_isolated();\n}\n\nfn notify_command(fixture: &Fixture, handle: &str, identity: &ProcessIdentity) -> Command {\n    let state_dir = fixture.work_dir.join(format!(\"concurrent-{handle}\"));\n    fs::create_dir_all(&state_dir).unwrap();\n    let meta = state_dir.join(\"meta.json\");\n    let log = state_dir.join(\"log\");\n    let rc = state_dir.join(\"rc\");\n    fs::write(\n        &meta,\n        serde_json::to_string(&caller_chain(identity)).unwrap(),\n    )\n    .unwrap();\n    fs::write(&log, format!(\"log {handle}\\n\")).unwrap();\n    fs::write(&rc, \"0\\n\").unwrap();\n    let mut cmd = Command::new(runner_bin());\n    cmd.arg(\"notify\")\n        .arg(\"agent-bash-complete\")\n        .arg(\"--caller-ppid\")\n        .arg(std::process::id().to_string())\n        .arg(\"--handle\")\n        .arg(handle)\n        .arg(\"--state-dir\")\n        .arg(&state_dir)\n        .arg(\"--meta\")\n        .arg(&meta)\n        .arg(\"--log\")\n        .arg(&log)\n        .arg(\"--rc\")\n        .arg(&rc)\n        .arg(\"--json\")\n        .env(\"XDG_CONFIG_HOME\", &fixture.config_home)\n        .env(\"XDG_DATA_HOME\", &fixture.data_home)\n        .env(\"HOME\", &fixture.home_dir)\n        .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n        .env(\"WU_D_WORK_DIR\", &fixture.work_dir)\n        .env_remove(\"OULIPOLY_DATA_DIR\")\n        .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n        .stdout(Stdio::piped())\n        .stderr(Stdio::piped())\n        .current_dir(fixture.dir.path());\n    cmd\n}\n\nfn seed_dead_wake_claim(fixture: &Fixture, claim_token: &str, seconds_old: i64) {\n    seed_dead_wake_claim_for(fixture, SESSION, claim_token, seconds_old);\n}\n\nfn seed_dead_wake_claim_for(\n    fixture: &Fixture,\n    session_id: &str,\n    claim_token: &str,\n    seconds_old: i64,\n) {\n    acquire_seed_wake_claim_for(fixture, session_id, claim_token);\n    fixture\n        .mailbox()\n        .record_wake_claim_pid(session_id, claim_token, 999_999_999)\n        .unwrap();\n    age_wake_claim_for(fixture, session_id, seconds_old);\n}\n\nfn seed_live_wake_claim(fixture: &Fixture, claim_token: &str) {\n    acquire_seed_wake_claim(fixture, claim_token);\n    let identity = current_process_identity();\n    PidIdentityDb::open(&fixture.sidecar_path())\n        .unwrap()\n        .record_identity(PidIdentityRecord {\n            identity: &identity,\n            os_pgid: None,\n            invocation_uuid: claim_token,\n            session_id: Some(SESSION),\n            provider_name: Some(PROVIDER),\n            model_name: Some(MODEL),\n            recorded_at: \"2026-06-04T12:02:00Z\",\n        })\n        .unwrap();\n    fixture\n        .mailbox()\n        .record_wake_claim_pid(SESSION, claim_token, identity.os_pid)\n        .unwrap();\n}\n\nfn acquire_seed_wake_claim(fixture: &Fixture, claim_token: &str) {\n    acquire_seed_wake_claim_for(fixture, SESSION, claim_token);\n}\n\nfn acquire_seed_wake_claim_for(fixture: &Fixture, session_id: &str, claim_token: &str) {\n    let mut db = fixture.mailbox();\n    assert!(matches!(\n        db.try_acquire_wake_claim(WakeClaimRequest {\n            session_id,\n            claim_token,\n            reason: \"notify_idle\",\n            auto_wake_count: 1,\n            wake_invocation_uuid: None,\n            stale_after_seconds: 600,\n        })\n        .unwrap(),\n        WakeClaimAcquireResult::Acquired(_)\n    ));\n}\n\nfn age_wake_claim_for(fixture: &Fixture, session_id: &str, seconds_old: i64) {\n    let claimed_at = (Utc::now() - chrono::Duration::seconds(seconds_old)).to_rfc3339();\n    fixture\n        .sidecar_conn()\n        .execute(\n            \"UPDATE session_wake_claim SET claimed_at = ?2 WHERE session_id = ?1\",\n            rusqlite::params![session_id, claimed_at],\n        )\n        .unwrap();\n}\n\nfn current_process_identity() -> ProcessIdentity {\n    read_live_process_identity(i64::from(std::process::id()))\n        .unwrap()\n        .expect(\"test process should have a live identity\")\n}\n\n#[test]\nfn provider_shadow_xdg_notify_uses_pinned_data_dir_and_wakes() {\n    let _guard = integration_test_guard();\n    let fixture = Fixture::new();\n    fixture.write_provider(&provider_script(\n        r#\"if [ -z \"${OULIPOLY_DATA_DIR:-}\" ]; then\n  printf 'missing OULIPOLY_DATA_DIR\\n' >&2\n  exit 65\nfi\nexport XDG_DATA_HOME=\"$work/shadow-xdg\"\n( sleep 0.3; notify_handle h-shadow-xdg 0 ) >/dev/null 2>&1 &\"#,\n        r#\"printf '%s\\n' \"${OULIPOLY_DATA_DIR:-}\" > \"$work/shadow-resumed-data-dir.txt\"\"#,\n        \"shadow-resumed-input.txt\",\n    ));\n\n    let output = fixture.run_agent(\"dispatch from shadowed provider\");\n    assert_eq!(output.status.code(), Some(0), \"{output:?}\");\n\n    let prompt = wait_for_file(&fixture.prompt_file(\"shadow-resumed-input.txt\"));\n    assert!(prompt.contains(\"handle: h-shadow-xdg\"), \"{prompt}\");\n    let resumed_data_dir = wait_for_file(&fixture.prompt_file(\"shadow-resumed-data-dir.txt\"));\n    let expected_data_dir = fixture.pinned_data_dir();\n    let expected_data_dir = expected_data_dir.to_string_lossy();\n    assert_eq!(resumed_data_dir.trim_end(), expected_data_dir.as_ref());\n    let session_id = wait_for_mailbox_session(&fixture);\n    wait_until(\"shadow-xdg mailbox delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(&session_id, true).unwrap();\n        rows.len() == 1\n            && rows[0].handle == \"h-shadow-xdg\"\n            && rows[0].delivered_at.is_some()\n            && db.wake_claim(&session_id).unwrap().is_none()\n    });\n    assert!(\n        !fixture\n            .work_dir\n            .join(\"shadow-xdg\")\n            .join(\"oulipoly-agent-runner\")\n            .exists(),\n        \"shadow XDG_DATA_HOME must not receive agent-runner state\"\n    );\n    fixture.assert_xdg_isolated();\n}\n\nfn assert_notify_success(output: &Output) {\n    assert_success(output);\n}\n\nfn assert_success(output: &Output) {\n    assert!(\n        output.status.success(),\n        \"stdout={} stderr={}\",\n        String::from_utf8_lossy(&output.stdout),\n        String::from_utf8_lossy(&output.stderr)\n    );\n}\n\nfn notify_wake(output: &Output) -> Value {\n    let response: Value = serde_json::from_slice(&output.stdout).unwrap();\n    response.get(\"wake\").cloned().unwrap_or(Value::Null)\n}\n\nfn assert_single_wake_claim_won(wakes: &[Value]) {\n    let statuses = wakes\n        .iter()\n        .filter_map(|wake| wake.get(\"status\").and_then(Value::as_str))\n        .collect::<Vec<_>>();\n    let spawned_count = statuses\n        .iter()\n        .filter(|status| **status == \"spawned\")\n        .count();\n    assert_eq!(spawned_count, 1, \"wake statuses: {statuses:?}\");\n\n    let mut claim_tokens = wakes\n        .iter()\n        .filter_map(|wake| wake.get(\"claim_token\").and_then(Value::as_str))\n        .collect::<Vec<_>>();\n    claim_tokens.sort_unstable();\n    claim_tokens.dedup();\n    assert_eq!(claim_tokens.len(), 1, \"wake diagnostics: {wakes:?}\");\n}\n\nfn assert_single_wake_child_launch(log: &str) {\n    let launches = log.lines().filter(|line| *line == \"wake\").count();\n    assert_eq!(launches, 1, \"wake launch log: {log:?}\");\n}\n\nfn integration_test_lock() -> &'static Mutex<()> {\n    static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n    LOCK.get_or_init(|| Mutex::new(()))\n}\n\nfn integration_test_guard() -> MutexGuard<'static, ()> {\n    integration_test_lock()\n        .lock()\n        .unwrap_or_else(|poisoned| poisoned.into_inner())\n}\n\nfn provider_script(on_initial: &str, on_resume: &str, prompt_file: &str) -> String {\n    let prompt_file = prompt_file.replace('\"', \"\\\\\\\"\");\n    format!(\n        r#\"runner=\"${{AGENT_BASH_AGENT_RUNNER_BIN:?missing}}\"\nwork=\"${{WU_D_WORK_DIR:?missing}}\"\nsession=\"\"\nresume=\"\"\nfor ((i=1; i <= $#; i++)); do\n  arg=\"${{!i}}\"\n  if [ \"$arg\" = \"--session-id\" ]; then\n    j=$((i + 1))\n    session=\"${{!j}}\"\n  fi\n  if [ \"$arg\" = \"--resume\" ]; then\n    j=$((i + 1))\n    resume=\"${{!j}}\"\n  fi\n  if [ \"$arg\" = \"--session\" ]; then\n    j=$((i + 1))\n    resume=\"${{!j}}\"\n  fi\ndone\nlast=\"${{@: -1}}\"\nprovider_pid=\"$$\"\nboot_id=\"$(< /proc/sys/kernel/random/boot_id)\"\nstat_line=\"$(< \"/proc/${{provider_pid}}/stat\")\"\nafter=\nafter=\"${{stat_line##*) }}\"\nread -r -a stat_fields <<< \"$after\"\nstart_ticks=\"${{stat_fields[19]}}\"\nnotify_handle() {{\n  handle=\"$1\"\n  rc_value=\"$2\"\n  state=\"$work/$handle\"\n  mkdir -p \"$state\"\n  printf '{{\"caller_chain\":[{{\"pid\":%s,\"boot_id\":\"%s\",\"starttime_ticks\":%s}}]}}\\n' \"$provider_pid\" \"$boot_id\" \"$start_ticks\" > \"$state/meta.json\"\n  printf 'log for %s\\n' \"$handle\" > \"$state/log\"\n  printf '%s\\n' \"$rc_value\" > \"$state/rc\"\n  \"$runner\" notify agent-bash-complete \\\n    --caller-ppid \"$provider_pid\" \\\n    --handle \"$handle\" \\\n    --state-dir \"$state\" \\\n    --meta \"$state/meta.json\" \\\n    --log \"$state/log\" \\\n    --rc \"$state/rc\" \\\n    --json > \"$state/notify.json\" 2> \"$state/notify.err\" || true\n}}\nif [ -n \"$resume\" ]; then\n  target=\"$work/{prompt_file}\"\n  mkdir -p \"$(dirname \"$target\")\"\n  printf '%s' \"$last\" > \"$target\"\n  {on_resume}\n  exit 0\nfi\n{on_initial}\nexit 0\n\"#\n    )\n}\n\nfn wait_for_file(path: &Path) -> String {\n    wait_until(&format!(\"{} exists\", path.display()), || path.exists());\n    fs::read_to_string(path).unwrap()\n}\n\nfn wait_for_mailbox_session(fixture: &Fixture) -> String {\n    wait_for_sidecar_session(fixture, \"mailbox\")\n}\n\nfn wait_for_runtime_session(fixture: &Fixture) -> String {\n    wait_for_sidecar_session(fixture, \"session_runtime\")\n}\n\nfn wait_for_sidecar_session(fixture: &Fixture, table: &str) -> String {\n    let mut found = None;\n    wait_until(&format!(\"{table} session id\"), || {\n        found = sidecar_session_id(fixture, table);\n        found.is_some()\n    });\n    found.unwrap()\n}\n\nfn sidecar_session_id(fixture: &Fixture, table: &str) -> Option<String> {\n    let conn = fixture.sidecar_conn();\n    conn.query_row(\n        &format!(\"SELECT session_id FROM {table} ORDER BY session_id LIMIT 1\"),\n        [],\n        |row| row.get(0),\n    )\n    .ok()\n}\n\nfn wait_until(label: &str, mut predicate: impl FnMut() -> bool) {\n    let start = Instant::now();\n    while start.elapsed() < Duration::from_secs(10) {\n        if predicate() {\n            return;\n        }\n        std::thread::sleep(Duration::from_millis(50));\n    }\n    panic!(\"timed out waiting for {label}\");\n}\n\nfn caller_chain(identity: &ProcessIdentity) -> Value {\n    json!({\n        \"caller_chain\": [{\n            \"pid\": identity.os_pid,\n            \"boot_id\": identity.os_boot_id,\n            \"starttime_ticks\": identity.os_pid_starttime_ticks,\n        }]\n    })\n}\n\nfn identity(os_pid: i64, os_boot_id: &str, os_pid_starttime_ticks: i64) -> ProcessIdentity {\n    ProcessIdentity {\n        os_pid,\n        os_boot_id: os_boot_id.to_string(),\n        os_pid_starttime_ticks,\n    }\n}\n\nfn runner_bin() -> &'static str {\n    env!(\"CARGO_BIN_EXE_oulipoly-agent-runner\")\n}\n\nfn ts(value: &str) -> DateTime<Utc> {\n    DateTime::parse_from_rfc3339(value)\n        .unwrap()\n        .with_timezone(&Utc)\n}\n\nfn path_string(path: &Path) -> String {\n    path.to_string_lossy().into_owned()\n}\n\nfn toml_string(value: &str) -> String {\n    serde_json::to_string(value).unwrap()\n}","lineStart":1,"lineEnd":1453,"totalLines":1453,"truncated":false}},"title":"src-tauri/tests/wu_d_proactive_wake_integration.rs","time":{"start":1780923371969,"end":1780923372310}},"metadata":{"openai":{"itemId":"fc_07cd687873b1706f016a26bbebae9c819b9483404f5232b2b2"}},"id":"prt_ea74e110a001kDlih4PMHVSXSO","sessionID":"ses_158b3e351ffePkuQnC9kglvomy","messageID":"msg_ea74db39e001OUt7IFVSrgke4f"}}
