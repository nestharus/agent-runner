.as_deref(),\n1615:             Some(\"mailbox_delivery_unconfirmed\")\n1616:         );\n1617:     }\n1618: \n1619:     #[test]\n1620:     fn list_pending_excludes_delivered() {\n1621:         let dir = tempfile::tempdir().unwrap();\n1622:         let mut db = MailboxDb::open(&dir.path().join(\"pid-identity.db\")).unwrap();\n1623:         let delivered =\n1624:             inserted_row(db.enqueue_agent_bash_complete(&input(\"handle-a\", \"session-a\")));\n1625:         let pending = inserted_row(db.enqueue_agent_bash_complete(&input(\"handle-b\", \"session-a\")));\n1626: \n1627:         db.mark_delivered(\"session-a\", &[delivered.seq], \"resume-1\")\n1628:             .unwrap();\n1629: \n1630:         let pending_rows = db.list_pending(\"session-a\").unwrap();\n1631:         assert_eq!(pending_rows.len(), 1);\n1632:         assert_eq!(pending_rows[0].seq, pending.seq);\n1633:         assert_eq!(pending_rows[0].handle, \"handle-b\");\n1634:     }\n1635: \n1636:     #[test]\n1637:     fn pending_list_does_not_mutate_rows_for_crash_redelivery() {\n1638:         let dir = tempfile::tempdir().unwrap();\n1639:         let mut db = MailboxDb::open(&dir.path().join(\"pid-identity.db\")).unwrap();\n1640:         let row = inserted_row(db.enqueue_agent_bash_complete(&input(\"handle-a\", \"session-a\")));\n1641: \n1642:         let first = db.list_pending(\"session-a\").unwrap();\n1643:         let second = db.list_pending(\"session-a\").unwrap();\n1644: \n1645:         assert_eq!(first[0].seq, row.seq);\n1646:         assert_eq!(second[0].seq, row.seq);\n1647:         assert!(second[0].delivered_at.is_none());\n1648:         assert_eq!(second[0].delivery_attempts, 0);\n1649:     }\n1650: \n1651:     #[test]\n1652:     fn runtime_mark_running_records_pid_identity() {\n1653:         let dir = tempfile::tempdir().unwrap();\n1654:         let mut db = MailboxDb::open(&dir.path().join(\"pid-identity.db\")).unwrap();\n1655:         let identity = current_identity();\n1656: \n1657