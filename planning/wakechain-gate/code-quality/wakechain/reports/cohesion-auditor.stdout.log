{"type":"tool_use","timestamp":1780923316091,"sessionID":"ses_158b3e351ffePkuQnC9kglvomy","part":{"type":"tool","tool":"read","callID":"call_jeGdt9Rl7jyNhMmV30DrG1xi","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/wake_coordinator.rs","offset":1,"limit":1400},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/wake_coordinator.rs</path>\n<type>file</type>\n<content>\n1: //! ## Declared roles\n2: //!\n3: //! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n4: //! `predicate`, `validator`\n5: \n6: use oulipoly_state::StateDb;\n7: use oulipoly_state::mailbox::{\n8:     MailboxDb, MailboxRow, SessionLiveness, SessionRuntimeIdleUpdate, SessionRuntimeRow,\n9:     WAKE_SWEEP_ABANDONED_ERROR, WakeClaimAcquireResult, WakeClaimRequest, WakeClaimRow,\n10:     WakeSweepCandidate,\n11: };\n12: use oulipoly_state::pid_identity::{ProcessIdentity, read_live_process_identity};\n13: use serde::Serialize;\n14: use std::path::PathBuf;\n15: use std::process::{Child, Command, Stdio};\n16: use std::sync::OnceLock;\n17: use std::time::Duration;\n18: use uuid::Uuid;\n19: \n20: #[cfg(unix)]\n21: use oulipoly_runtime::executor::cli::pty_broker;\n22: #[cfg(unix)]\n23: use std::os::unix::process::CommandExt;\n24: \n25: const AUTO_WAKE_ENV: &str = \"OULIPOLY_AUTO_WAKE\";\n26: const AUTO_WAKE_SESSION_ID_ENV: &str = \"OULIPOLY_AUTO_WAKE_SESSION_ID\";\n27: const AUTO_WAKE_TOKEN_ENV: &str = \"OULIPOLY_AUTO_WAKE_TOKEN\";\n28: const AUTO_WAKE_COUNT_ENV: &str = \"OULIPOLY_AUTO_WAKE_COUNT\";\n29: const AUTO_WAKE_MAX_ENV: &str = \"OULIPOLY_AUTO_WAKE_MAX\";\n30: const AUTO_WAKE_RETRY_BASE_MS_ENV: &str = \"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\";\n31: const PARENT_INVOCATION_ENV: &str = \"OULIPOLY_PARENT_INVOCATION\";\n32: const DEFAULT_AUTO_WAKE_MAX: i64 = 5;\n33: const DEFAULT_AUTO_WAKE_RETRY_BASE_MS: u64 = 1_000;\n34: const AUTO_WAKE_RETRY_MAX_MS: u64 = 30_000;\n35: const WAKE_CLAIM_STALE_AFTER_SECONDS: i64 = 10 * 60;\n36: const WAKE_RECLAIM_SWEEP_LIMIT: usize = 8;\n37: const WAKE_RECLAIM_SWEEP_SCAN_LIMIT: usize = WAKE_RECLAIM_SWEEP_LIMIT * 32;\n38: const WAKE_RECLAIM_REAP_SESSION_LIMIT: usize = 32;\n39: const WAKE_RECLAIM_REAP_ROWS_PER_SESSION: usize = 20;\n40: #[allow(dead_code)]\n41: const WAKE_RECLAIM_SWEEP_INTERVAL_SECONDS: u64 = 60;\n42: const CONSUMED_NOTIFICATION_MARKER: &str = \"[OULIPOLY NOTIFICATIONS]\";\n43: \n44: #[derive(Debug, Clone, Serialize)]\n45: pub(crate) struct WakeDiagnostic {\n46:     pub(crate) attempted: bool,\n47:     pub(crate) status: String,\n48:     pub(crate) claim_token: Option<String>,\n49:     pub(crate) wake_pid: Option<i64>,\n50:     pub(crate) auto_wake_count: Option<i64>,\n51:     pub(crate) message: Option<String>,\n52: }\n53: \n54: impl WakeDiagnostic {\n55:     fn status(status: &str) -> Self {\n56:         Self {\n57:             attempted: false,\n58:             status: status.to_string(),\n59:             claim_token: None,\n60:             wake_pid: None,\n61:             auto_wake_count: None,\n62:             message: None,\n63:         }\n64:     }\n65: \n66:     fn with_message(status: &str, message: String) -> Self {\n67:         Self {\n68:             attempted: false,\n69:             status: status.to_string(),\n70:             claim_token: None,\n71:             wake_pid: None,\n72:             auto_wake_count: None,\n73:             message: Some(message),\n74:         }\n75:     }\n76: }\n77: \n78: pub(crate) fn mark_session_idle_after_turn(\n79:     session_id: &str,\n80:     invocation_uuid: &str,\n81:     exit_code: Option<i32>,\n82: ) -> Result<(), String> {\n83:     let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n84:         return Ok(());\n85:     };\n86:     db.mark_session_idle(SessionRuntimeIdleUpdate {\n87:         session_id,\n88:         invocation_uuid,\n89:         last_exit_code: exit_code,\n90:     })?;\n91:     Ok(())\n92: }\n93: \n94: pub(crate) fn trigger_notify_wake(session_id: &str) -> WakeDiagnostic {\n95:     start_wake_chain(StartWakeInput {\n96:         session_id,\n97:         reason: \"notify_idle\",\n98:         auto_wake_count: 1,\n99:         renew_token: None,\n100:     })\n101: }\n102: \n103: pub(crate) fn run_startup_wake_reclaim_sweep() {\n104:     if is_auto_wake_invocation() {\n105:         return;\n106:     }\n107:     run_wake_reclaim_sweep_or_warn(\"process_start\");\n108: }\n109: \n110: #[allow(dead_code)]\n111: pub(crate) fn start_wake_reclaim_maintenance_driver() {\n112:     static DRIVER: OnceLock<()> = OnceLock::new();\n113:     DRIVER.get_or_init(spawn_wake_reclaim_maintenance_driver);\n114: }\n115: \n116: #[allow(dead_code)]\n117: fn spawn_wake_reclaim_maintenance_driver() {\n118:     let result = std::thread::Builder::new()\n119:         .name(\"oulipoly-wake-reclaim-sweep\".to_string())\n120:         .spawn(wake_reclaim_maintenance_loop);\n121:     if let Err(err) = result {\n122:         tracing::warn!(\"Failed to start wake reclaim sweep driver: {err}\");\n123:     }\n124: }\n125: \n126: #[allow(dead_code)]\n127: fn wake_reclaim_maintenance_loop() {\n128:     run_wake_reclaim_sweep_or_warn(\"maintenance_start\");\n129:     loop {\n130:         std::thread::sleep(Duration::from_secs(WAKE_RECLAIM_SWEEP_INTERVAL_SECONDS));\n131:         run_wake_reclaim_sweep_or_warn(\"maintenance_tick\");\n132:     }\n133: }\n134: \n135: fn run_wake_reclaim_sweep_or_warn(trigger: &str) {\n136:     if let Err(err) = run_wake_reclaim_sweep(trigger) {\n137:         tracing::warn!(trigger, \"Wake reclaim sweep failed: {err}\");\n138:     }\n139: }\n140: \n141: fn run_wake_reclaim_sweep(trigger: &str) -> Result<(), String> {\n142:     let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n143:         return Ok(());\n144:     };\n145:     let candidates = db.wake_sweep_candidates(\n146:         WAKE_CLAIM_STALE_AFTER_SECONDS,\n147:         WAKE_RECLAIM_SWEEP_SCAN_LIMIT,\n148:     )?;\n149:     let plan = wake_sweep_plan(&mut db, candidates)?;\n150:     reap_abandoned_sweep_candidates(&mut db, &plan.reap)?;\n151:     drop(db);\n152:     for candidate in plan.start {\n153:         let diagnostic = start_wake_chain(StartWakeInput {\n154:             session_id: &candidate.session_id,\n155:             reason: trigger,\n156:             auto_wake_count: candidate.auto_wake_count,\n157:             renew_token: None,\n158:         });\n159:         trace_wake_sweep_candidate(&candidate.session_id, &diagnostic);\n160:     }\n161:     Ok(())\n162: }\n163: \n164: struct WakeSweepPlan {\n165:     start: Vec<WakeSweepCandidate>,\n166:     reap: Vec<WakeSweepCandidate>,\n167: }\n168: \n169: fn wake_sweep_plan(\n170:     db: &mut MailboxDb,\n171:     candidates: Vec<WakeSweepCandidate>,\n172: ) -> Result<WakeSweepPlan, String> {\n173:     let (recoverable, reap) = partition_wake_sweep_candidates(db, candidates)?;\n174:     let start = select_recoverable_sweep_candidates(recoverable);\n175:     Ok(wake_sweep_plan_from_selected(start, reap))\n176: }\n177: \n178: fn partition_wake_sweep_candidates(\n179:     db: &mut MailboxDb,\n180:     candidates: Vec<WakeSweepCandidate>,\n181: ) -> Result<(Vec<WakeSweepCandidate>, Vec<WakeSweepCandidate>), String> {\n182:     let state = open_default_state_read_only();\n183:     let mut recoverable = Vec::new();\n184:     let mut reap = Vec::new();\n185:     for candidate in candidates {\n186:         match wake_sweep_candidate_disposition(db, state.as_ref(), &candidate)? {\n187:             WakeSweepDisposition::Recoverable => {\n188:                 recoverable.push(candidate);\n189:             }\n190:             WakeSweepDisposition::Abandoned => {\n191:                 if reap.len() < WAKE_RECLAIM_REAP_SESSION_LIMIT {\n192:                     reap.push(candidate);\n193:                 }\n194:             }\n195:             WakeSweepDisposition::Skip => {}\n196:         }\n197:     }\n198:     Ok((recoverable, reap))\n199: }\n200: \n201: fn wake_sweep_plan_from_selected(\n202:     start: Vec<WakeSweepCandidate>,\n203:     reap: Vec<WakeSweepCandidate>,\n204: ) -> WakeSweepPlan {\n205:     WakeSweepPlan { start, reap }\n206: }\n207: \n208: fn select_recoverable_sweep_candidates(\n209:     mut candidates: Vec<WakeSweepCandidate>,\n210: ) -> Vec<WakeSweepCandidate> {\n211:     if candidates.len() <= WAKE_RECLAIM_SWEEP_LIMIT {\n212:         return candidates;\n213:     }\n214:     candidates.sort_by_key(|candidate| candidate.min_pending_seq);\n215:     let oldest_slots = WAKE_RECLAIM_SWEEP_LIMIT.div_ceil(2);\n216:     let newest_slots = WAKE_RECLAIM_SWEEP_LIMIT.saturating_sub(oldest_slots);\n217:     let mut selected = candidates\n218:         .iter()\n219:         .take(oldest_slots)\n220:         .cloned()\n221:         .collect::<Vec<_>>();\n222:     for candidate in candidates.iter().rev().take(newest_slots) {\n223:         if !selected\n224:             .iter()\n225:             .any(|existing| existing.session_id == candidate.session_id)\n226:         {\n227:             selected.push(candidate.clone());\n228:         }\n229:     }\n230:     selected\n231: }\n232: \n233: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n234: enum WakeSweepDisposition {\n235:     Recoverable,\n236:     Abandoned,\n237:     Skip,\n238: }\n239: \n240: fn wake_sweep_candidate_disposition(\n241:     db: &MailboxDb,\n242:     state: Option<&StateDb>,\n243:     candidate: &WakeSweepCandidate,\n244: ) -> Result<WakeSweepDisposition, String> {\n245:     // Recoverable means either an idle headless runtime with durable resume\n246:     // evidence, or a live owner PID identity that must not be reaped. Missing\n247:     // runtime/history with no live owner is abandoned debris, not resumable work.\n248:     if pending_mailbox_consumed_marker_present(db, &candidate.session_id) {\n249:         return Ok(WakeSweepDisposition::Skip);\n250:     }\n251:     if wake_sweep_candidate_is_resumable(db, state, candidate)? {\n252:         return Ok(resumable_wake_sweep_disposition(candidate));\n253:     }\n254:     if wake_sweep_candidate_has_live_owner(db, &candidate.session_id)? {\n255:         return Ok(WakeSweepDisposition::Skip);\n256:     }\n257:     Ok(WakeSweepDisposition::Abandoned)\n258: }\n259: \n260: fn resumable_wake_sweep_disposition(candidate: &WakeSweepCandidate) -> WakeSweepDisposition {\n261:     if wake_sweep_candidate_reached_cap(candidate)\n262:         || !wake_sweep_candidate_has_deliverable_pending(&candidate.session_id)\n263:     {\n264:         return WakeSweepDisposition::Skip;\n265:     }\n266:     WakeSweepDisposition::Recoverable\n267: }\n268: \n269: fn reap_abandoned_sweep_candidates(\n270:     db: &mut MailboxDb,\n271:     candidates: &[WakeSweepCandidate],\n272: ) -> Result<(), String> {\n273:     for candidate in candidates {\n274:         db.mark_pending_abandoned(\n275:             &candidate.session_id,\n276:             WAKE_SWEEP_ABANDONED_ERROR,\n277:             WAKE_RECLAIM_REAP_ROWS_PER_SESSION,\n278:         )?;\n279:     }\n280:     Ok(())\n281: }\n282: \n283: fn wake_sweep_candidate_has_deliverable_pending(session_id: &str) -> bool {\n284:     crate::mailbox_delivery::deliverable_pending_count(session_id)\n285:         .map(|count| count > 0)\n286:         .unwrap_or(false)\n287: }\n288: \n289: fn wake_sweep_candidate_is_resumable(\n290:     db: &MailboxDb,\n291:     state: Option<&StateDb>,\n292:     candidate: &WakeSweepCandidate,\n293: ) -> Result<bool, String> {\n294:     let Some(runtime) = db.session_runtime(&candidate.session_id)? else {\n295:         return Ok(false);\n296:     };\n297:     if !wake_sweep_runtime_can_resume(&runtime) {\n298:         return Ok(false);\n299:     }\n300:     wake_sweep_runtime_has_resume_evidence(state, &runtime)\n301: }\n302: \n303: fn wake_sweep_runtime_can_resume(runtime: &SessionRuntimeRow) -> bool {\n304:     runtime.mode == \"headless\"\n305:         && runtime.run_state != \"running\"\n306:         && runtime\n307:             .provider_name\n308:             .as_deref()\n309:             .is_some_and(|provider| !provider.is_empty())\n310: }\n311: \n312: fn wake_sweep_runtime_has_resume_evidence(\n313:     state: Option<&StateDb>,\n314:     runtime: &SessionRuntimeRow,\n315: ) -> Result<bool, String> {\n316:     let Some(state) = state else {\n317:         return Ok(false);\n318:     };\n319:     let Some(provider_name) = runtime.provider_name.as_deref() else {\n320:         return Ok(false);\n321:     };\n322:     if state\n323:         .chain_id_for_segment(provider_name, &runtime.session_id)\n324:         .map_err(|err| err.to_string())?\n325:         .is_some()\n326:     {\n327:         return Ok(true);\n328:     }\n329:     state\n330:         .count_session_turns(provider_name, &runtime.session_id)\n331:         .map(|counts| counts.total > 0)\n332: }\n333: \n334: fn wake_sweep_candidate_has_live_owner(db: &MailboxDb, session_id: &str) -> Result<bool, String> {\n335:     for row in db.list_pending(session_id)? {\n336:         if mailbox_row_has_live_owner_identity(&row)? {\n337:             return Ok(true);\n338:         }\n339:     }\n340:     Ok(false)\n341: }\n342: \n343: fn mailbox_row_has_live_owner_identity(row: &MailboxRow) -> Result<bool, String> {\n344:     let Some(recorded) = mailbox_row_owner_identity(row) else {\n345:         return Ok(false);\n346:     };\n347:     read_live_process_identity(recorded.os_pid).map(|live| live.as_ref() == Some(&recorded))\n348: }\n349: \n350: fn mailbox_row_owner_identity(row: &MailboxRow) -> Option<ProcessIdentity> {\n351:     Some(ProcessIdentity {\n352:         os_pid: row.matched_os_pid?,\n353:         os_boot_id: row.matched_os_boot_id.clone()?,\n354:         os_pid_starttime_ticks: row.matched_os_pid_starttime_ticks?,\n355:     })\n356: }\n357: \n358: fn wake_sweep_candidate_reached_cap(candidate: &WakeSweepCandidate) -> bool {\n359:     auto_wake_cap_reached(candidate.auto_wake_count.saturating_sub(1), auto_wake_max())\n360: }\n361: \n362: fn pending_mailbox_consumed_marker_present(db: &MailboxDb, session_id: &str) -> bool {\n363:     let Ok(pending) = db.list_pending(session_id) else {\n364:         return false;\n365:     };\n366:     if pending.is_empty() {\n367:         return true;\n368:     }\n369:     let Some(provider_name) = pending_mailbox_provider_name(db, session_id) else {\n370:         return false;\n371:     };\n372:     let Some(state) = open_default_state_read_only() else {\n373:         return false;\n374:     };\n375:     session_has_consumed_notification_marker(&state, &provider_name, session_id)\n376:         && pending.iter().all(|row| {\n377:             state\n378:                 .has_session_user_turn_containing(\n379:                     &provider_name,\n380:                     session_id,\n381:                     &mailbox_handle_marker(row),\n382:                 )\n383:                 .unwrap_or(false)\n384:         })\n385: }\n386: \n387: fn mailbox_handle_marker(row: &MailboxRow) -> String {\n388:     format!(\"handle: {}\", row.handle)\n389: }\n390: \n391: fn open_default_state_read_only() -> Option<StateDb> {\n392:     let path = StateDb::default_path().ok()?;\n393:     if !path.exists() {\n394:         return None;\n395:     }\n396:     StateDb::open_read_only(&path).ok()\n397: }\n398: \n399: fn pending_mailbox_provider_name(db: &MailboxDb, session_id: &str) -> Option<String> {\n400:     db.session_runtime(session_id)\n401:         .ok()\n402:         .flatten()\n403:         .and_then(|runtime| runtime.provider_name)\n404: }\n405: \n406: fn session_has_consumed_notification_marker(\n407:     state: &StateDb,\n408:     provider_name: &str,\n409:     session_id: &str,\n410: ) -> bool {\n411:     state\n412:         .has_session_user_turn_containing(provider_name, session_id, CONSUMED_NOTIFICATION_MARKER)\n413:         .unwrap_or(false)\n414: }\n415: \n416: fn trace_wake_sweep_candidate(session_id: &str, diagnostic: &WakeDiagnostic) {\n417:     tracing::debug!(\n418:         session_id,\n419:         status = diagnostic.status.as_str(),\n420:         \"Wake reclaim sweep candidate evaluated\"\n421:     );\n422: }\n423: \n424: pub(crate) fn mark_successful_turn_idle_and_recheck(\n425:     session_id: &str,\n426:     invocation_uuid: &str,\n427:     exit_code: i32,\n428: ) -> Result<WakeDiagnostic, String> {\n429:     mark_session_idle_after_turn(session_id, invocation_uuid, Some(exit_code))?;\n430:     Ok(successful_turn_recheck(session_id))\n431: }\n432: \n433: fn successful_turn_recheck(session_id: &str) -> WakeDiagnostic {\n434:     trigger_turn_end_recheck(session_id)\n435: }\n436: \n437: pub(crate) fn validate_auto_wake_child(session_id: &str) -> Result<Option<i32>, String> {\n438:     if !auto_wake_marker_present() {\n439:         return Ok(None);\n440:     }\n441:     let marker = auto_wake_child_marker();\n442:     if !auto_wake_child_marker_matches(session_id, &marker) {\n443:         return Ok(Some(0));\n444:     }\n445:     validate_auto_wake_child_claim(session_id, &marker.claim_token)\n446: }\n447: \n448: struct AutoWakeChildMarker {\n449:     expected_session: String,\n450:     claim_token: String,\n451: }\n452: \n453: fn auto_wake_marker_present() -> bool {\n454:     std::env::var_os(AUTO_WAKE_ENV).is_some()\n455: }\n456: \n457: fn auto_wake_child_marker() -> AutoWakeChildMarker {\n458:     auto_wake_child_marker_from_parts(auto_wake_expected_session(), auto_wake_child_claim_token())\n459: }\n460: \n461: fn auto_wake_expected_session() -> String {\n462:     std::env::var(AUTO_WAKE_SESSION_ID_ENV).unwrap_or_default()\n463: }\n464: \n465: fn auto_wake_child_claim_token() -> String {\n466:     std::env::var(AUTO_WAKE_TOKEN_ENV).unwrap_or_default()\n467: }\n468: \n469: fn auto_wake_child_marker_from_parts(\n470:     expected_session: String,\n471:     claim_token: String,\n472: ) -> AutoWakeChildMarker {\n473:     AutoWakeChildMarker {\n474:         expected_session,\n475:         claim_token,\n476:     }\n477: }\n478: \n479: fn auto_wake_child_marker_matches(session_id: &str, marker: &AutoWakeChildMarker) -> bool {\n480:     marker.expected_session == session_id && !marker.claim_token.is_empty()\n481: }\n482: \n483: fn validate_auto_wake_child_claim(\n484:     session_id: &str,\n485:     claim_token: &str,\n486: ) -> Result<Option<i32>, String> {\n487:     let Some(mut db) = open_optional_wake_mailbox()? else {\n488:         return Ok(Some(0));\n489:     };\n490:     validate_auto_wake_claim_with_db(&mut db, session_id, claim_token)\n491: }\n492: \n493: fn open_optional_wake_mailbox() -> Result<Option<MailboxDb>, String> {\n494:     MailboxDb::open_default_if_exists()\n495: }\n496: \n497: fn validate_auto_wake_claim_with_db(\n498:     db: &mut MailboxDb,\n499:     session_id: &str,\n500:     claim_token: &str,\n501: ) -> Result<Option<i32>, String> {\n502:     db.validate_wake_claim_for_child(session_id, claim_token)\n503:         .map(auto_wake_child_validation_result)\n504: }\n505: \n506: fn auto_wake_child_validation_result(valid: bool) -> Option<i32> {\n507:     if valid { None } else { Some(0) }\n508: }\n509: \n510: pub(crate) fn is_auto_wake_invocation() -> bool {\n511:     auto_wake_marker_present()\n512: }\n513: \n514: pub(crate) fn reset_manual_resume_wake_claim(session_id: &str) -> Result<(), String> {\n515:     let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n516:         return Ok(());\n517:     };\n518:     db.release_wake_claim(session_id, None)?;\n519:     Ok(())\n520: }\n521: \n522: pub(crate) fn release_current_auto_wake_claim_for_session(session_id: &str) {\n523:     let auto_wake = current_auto_wake();\n524:     release_current_auto_wake_claim(session_id, auto_wake.as_ref());\n525: }\n526: \n527: pub(crate) fn recheck_after_failed_auto_wake(session_id: &str) -> WakeDiagnostic {\n528:     let Some(auto_wake) = current_auto_wake() else {\n529:         return WakeDiagnostic::status(\"not_auto_wake\");\n530:     };\n531:     release_current_auto_wake_claim(session_id, Some(&auto_wake));\n532:     failed_auto_wake_recheck(session_id, &auto_wake)\n533: }\n534: \n535: fn trigger_turn_end_recheck(session_id: &str) -> WakeDiagnostic {\n536:     let pending_count = match turn_end_pending_count(session_id) {\n537:         Ok(count) => count,\n538:         Err(err) => return storage_error_diagnostic(err),\n539:     };\n540:     let auto_wake = current_auto_wake();\n541:     apply_turn_end_recheck_decision(\n542:         session_id,\n543:         auto_wake.as_ref(),\n544:         turn_end_recheck_decision(session_id, pending_count, auto_wake.as_ref()),\n545:     )\n546: }\n547: \n548: fn failed_auto_wake_recheck(session_id: &str, auto_wake: &AutoWakeEnv) -> WakeDiagnostic {\n549:     let pending_count = match turn_end_pending_count(session_id) {\n550:         Ok(count) => count,\n551:         Err(err) => return storage_error_diagnostic(err),\n552:     };\n553:     apply_failed_auto_wake_recheck_decision(\n554:         session_id,\n555:         auto_wake,\n556:         failed_auto_wake_recheck_decision(session_id, pending_count, auto_wake),\n557:     )\n558: }\n559: \n560: enum TurnEndRecheckDecision<'a> {\n561:     NoPending,\n562:     CapReached { current_count: i64, max_count: i64 },\n563:     Start(StartWakeInput<'a>),\n564: }\n565: \n566: fn turn_end_recheck_decision<'a>(\n567:     session_id: &'a str,\n568:     pending_count: usize,\n569:     auto_wake: Option<&'a AutoWakeEnv>,\n570: ) -> TurnEndRecheckDecision<'a> {\n571:     if no_pending(pending_count) {\n572:         return TurnEndRecheckDecision::NoPending;\n573:     }\n574:     let current_count = current_auto_wake_count(auto_wake);\n575:     let max_count = auto_wake_max();\n576:     if auto_wake_cap_reached(current_count, max_count) {\n577:         return TurnEndRecheckDecision::CapReached {\n578:             current_count,\n579:             max_count,\n580:         };\n581:     }\n582:     TurnEndRecheckDecision::Start(StartWakeInput {\n583:         session_id,\n584:         reason: \"turn_end_recheck\",\n585:         auto_wake_count: current_count + 1,\n586:         renew_token: auto_wake.map(|wake| wake.token.as_str()),\n587:     })\n588: }\n589: \n590: fn apply_turn_end_recheck_decision(\n591:     session_id: &str,\n592:     auto_wake: Option<&AutoWakeEnv>,\n593:     decision: TurnEndRecheckDecision<'_>,\n594: ) -> WakeDiagnostic {\n595:     match decision {\n596:         TurnEndRecheckDecision::NoPending => {\n597:             release_current_auto_wake_claim(session_id, auto_wake);\n598:             WakeDiagnostic::status(\"no_pending\")\n599:         }\n600:         TurnEndRecheckDecision::CapReached {\n601:             current_count,\n602:             max_count,\n603:         } => {\n604:             release_current_auto_wake_claim(session_id, auto_wake);\n605:             emit_auto_wake_cap_reached(session_id, current_count, max_count);\n606:             auto_wake_cap_diagnostic(current_count)\n607:         }\n608:         TurnEndRecheckDecision::Start(input) => start_wake_chain(input),\n609:     }\n610: }\n611: \n612: enum FailedAutoWakeRecheckDecision<'a> {\n613:     NoPending,\n614:     CapReached { current_count: i64, max_count: i64 },\n615:     Retry(StartWakeInput<'a>),\n616: }\n617: \n618: fn failed_auto_wake_recheck_decision<'a>(\n619:     session_id: &'a str,\n620:     pending_count: usize,\n621:     auto_wake: &'a AutoWakeEnv,\n622: ) -> FailedAutoWakeRecheckDecision<'a> {\n623:     if no_pending(pending_count) {\n624:         return FailedAutoWakeRecheckDecision::NoPending;\n625:     }\n626:     let max_count = auto_wake_max();\n627:     if auto_wake_cap_reached(auto_wake.count, max_count) {\n628:         return FailedAutoWakeRecheckDecision::CapReached {\n629:             current_count: auto_wake.count,\n630:             max_count,\n631:         };\n632:     }\n633:     FailedAutoWakeRecheckDecision::Retry(StartWakeInput {\n634:         session_id,\n635:         reason: \"wake_failure_retry\",\n636:         auto_wake_count: auto_wake.count + 1,\n637:         renew_token: None,\n638:     })\n639: }\n640: \n641: fn apply_failed_auto_wake_recheck_decision(\n642:     session_id: &str,\n643:     auto_wake: &AutoWakeEnv,\n644:     decision: FailedAutoWakeRecheckDecision<'_>,\n645: ) -> WakeDiagnostic {\n646:     match decision {\n647:         FailedAutoWakeRecheckDecision::NoPending => WakeDiagnostic::status(\"no_pending\"),\n648:         FailedAutoWakeRecheckDecision::CapReached {\n649:             current_count,\n650:             max_count,\n651:         } => {\n652:             emit_auto_wake_cap_reached(session_id, current_count, max_count);\n653:             auto_wake_cap_diagnostic(current_count)\n654:         }\n655:         FailedAutoWakeRecheckDecision::Retry(input) => {\n656:             sleep_before_failed_auto_wake_retry(auto_wake.count);\n657:             start_wake_chain(input)\n658:         }\n659:     }\n660: }\n661: \n662: fn sleep_before_failed_auto_wake_retry(auto_wake_count: i64) {\n663:     std::thread::sleep(auto_wake_retry_delay(auto_wake_count));\n664: }\n665: \n666: fn auto_wake_retry_delay(auto_wake_count: i64) -> Duration {\n667:     Duration::from_millis(auto_wake_retry_delay_ms(auto_wake_count))\n668: }\n669: \n670: fn auto_wake_retry_delay_ms(auto_wake_count: i64) -> u64 {\n671:     let base_ms = auto_wake_retry_base_ms();\n672:     let exponent = auto_wake_count.saturating_sub(1).clamp(0, 10) as u32;\n673:     base_ms\n674:         .saturating_mul(2_u64.saturating_pow(exponent))\n675:         .min(AUTO_WAKE_RETRY_MAX_MS)\n676: }\n677: \n678: fn auto_wake_retry_base_ms() -> u64 {\n679:     parsed_auto_wake_retry_base_ms()\n680:         .filter(|value| *value > 0)\n681:         .unwrap_or(DEFAULT_AUTO_WAKE_RETRY_BASE_MS)\n682: }\n683: \n684: fn parsed_auto_wake_retry_base_ms() -> Option<u64> {\n685:     std::env::var(AUTO_WAKE_RETRY_BASE_MS_ENV)\n686:         .ok()\n687:         .and_then(|value| value.parse::<u64>().ok())\n688: }\n689: \n690: fn current_auto_wake_count(auto_wake: Option<&AutoWakeEnv>) -> i64 {\n691:     auto_wake.map(|wake| wake.count).unwrap_or(0)\n692: }\n693: \n694: fn turn_end_pending_count(session_id: &str) -> Result<usize, String> {\n695:     pending_count(session_id)\n696: }\n697: \n698: fn no_pending(pending_count: usize) -> bool {\n699:     pending_count == 0\n700: }\n701: \n702: fn auto_wake_cap_reached(current_count: i64, max_count: i64) -> bool {\n703:     current_count >= max_count\n704: }\n705: \n706: fn emit_auto_wake_cap_reached(session_id: &str, current_count: i64, max_count: i64) {\n707:     eprintln!(\n708:         \"auto_wake_cap_reached session_id={session_id} count={current_count} max={max_count}\"\n709:     );\n710: }\n711: \n712: fn auto_wake_cap_diagnostic(current_count: i64) -> WakeDiagnostic {\n713:     let mut diagnostic = WakeDiagnostic::status(\"auto_wake_cap_reached\");\n714:     diagnostic.auto_wake_count = Some(current_count);\n715:     diagnostic\n716: }\n717: \n718: fn storage_error_diagnostic(err: String) -> WakeDiagnostic {\n719:     WakeDiagnostic::with_message(\"storage_error\", err)\n720: }\n721: \n722: struct AutoWakeEnv {\n723:     token: String,\n724:     count: i64,\n725: }\n726: \n727: #[derive(Clone, Copy)]\n728: struct StartWakeInput<'a> {\n729:     session_id: &'a str,\n730:     reason: &'a str,\n731:     auto_wake_count: i64,\n732:     renew_token: Option<&'a str>,\n733: }\n734: \n735: fn start_wake_chain(input: StartWakeInput<'_>) -> WakeDiagnostic {\n736:     let claim_token = Uuid::new_v4().to_string();\n737:     let mut context = match prepare_wake_start_context(input, &claim_token) {\n738:         Ok(context) => context,\n739:         Err(diagnostic) => return diagnostic,\n740:     };\n741:     let spawn = spawn_detached_resume(\n742:         input.session_id,\n743:         context.runtime.as_ref(),\n744:         &context.claim.claim_token,\n745:         input.auto_wake_count,\n746:     );\n747:     wake_spawn_diagnostic(\n748:         &mut context.db,\n749:         input,\n750:         context.runtime.as_ref(),\n751:         context.claim,\n752:         spawn,\n753:     )\n754: }\n755: \n756: struct WakeStartContext {\n757:     db: MailboxDb,\n758:     runtime: Option<SessionRuntimeRow>,\n759:     claim: WakeClaimRow,\n760: }\n761: \n762: fn prepare_wake_start_context(\n763:     input: StartWakeInput<'_>,\n764:     claim_token: &str,\n765: ) -> Result<WakeStartContext, WakeDiagnostic> {\n766:     let mut db = open_wake_mailbox().map_err(storage_error_diagnostic)?;\n767:     let runtime =\n768:         session_runtime_for_wake(&db, input.session_id).map_err(storage_error_diagnostic)?;\n769:     if wake_runtime_busy(&mut db, input.session_id, runtime.as_ref())? {\n770:         return Err(WakeDiagnostic::status(\"busy\"));\n771:     }\n772:     let claim = acquire_startable_wake_claim(&mut db, input, claim_token)?;\n773:     Ok(WakeStartContext { db, runtime, claim })\n774: }\n775: \n776: fn wake_runtime_busy(\n777:     db: &mut MailboxDb,\n778:     session_id: &str,\n779:     runtime: Option<&SessionRuntimeRow>,\n780: ) -> Result<bool, WakeDiagnostic> {\n781:     let liveness =\n782:         pty_runtime_liveness(db, session_id, runtime).map_err(storage_error_diagnostic)?;\n783:     cleanup_idle_runtime(runtime, liveness);\n784:     Ok(optional_pty_liveness_is_busy(liveness))\n785: }\n786: \n787: fn acquire_startable_wake_claim(\n788:     db: &mut MailboxDb,\n789:     input: StartWakeInput<'_>,\n790:     claim_token: &str,\n791: ) -> Result<WakeClaimRow, WakeDiagnostic> {\n792:     let claim_result =\n793:         acquire_wake_claim(db, input, claim_token).map_err(storage_error_diagnostic)?;\n794:     wake_claim_to_start(claim_result)\n795: }\n796: \n797: fn wake_claim_to_start(result: WakeClaimAcquireResult) -> Result<WakeClaimRow, WakeDiagnostic> {\n798:     match result {\n799:         WakeClaimAcquireResult::Acquired(claim) => Ok(claim),\n800:         WakeClaimAcquireResult::NoPending => Err(WakeDiagnostic::status(\"no_pending\")),\n801:         WakeClaimAcquireResult::Busy => Err(WakeDiagnostic::status(\"busy\")),\n802:         WakeClaimAcquireResult::AlreadyInFlight(claim) => Err(already_in_flight_diagnostic(claim)),\n803:     }\n804: }\n805: \n806: fn wake_spawn_diagnostic(\n807:     db: &mut MailboxDb,\n808:     input: StartWakeInput<'_>,\n809:     runtime: Option<&SessionRuntimeRow>,\n810:     claim: WakeClaimRow,\n811:     spawn: Result<i64, String>,\n812: ) -> WakeDiagnostic {\n813:     match spawn {\n814:         Ok(wake_pid) => successful_wake_spawn_diagnostic(db, input, runtime, claim, wake_pid),\n815:         Err(err) => failed_wake_spawn_diagnostic(db, input, claim, err),\n816:     }\n817: }\n818: \n819: fn successful_wake_spawn_diagnostic(\n820:     db: &mut MailboxDb,\n821:     input: StartWakeInput<'_>,\n822:     runtime: Option<&SessionRuntimeRow>,\n823:     claim: WakeClaimRow,\n824:     wake_pid: i64,\n825: ) -> WakeDiagnostic {\n826:     record_wake_pid_or_warn(db, input.session_id, &claim.claim_token, wake_pid, runtime);\n827:     spawned_wake_diagnostic(claim.claim_token, wake_pid, input.auto_wake_count)\n828: }\n829: \n830: fn failed_wake_spawn_diagnostic(\n831:     db: &mut MailboxDb,\n832:     input: StartWakeInput<'_>,\n833:     claim: WakeClaimRow,\n834:     err: String,\n835: ) -> WakeDiagnostic {\n836:     let _ = db.release_wake_claim(input.session_id, Some(&claim.claim_token));\n837:     spawn_error_diagnostic(claim.claim_token, input.auto_wake_count, err)\n838: }\n839: \n840: fn open_wake_mailbox() -> Result<MailboxDb, String> {\n841:     MailboxDb::open_default()\n842: }\n843: \n844: fn session_runtime_for_wake(\n845:     db: &MailboxDb,\n846:     session_id: &str,\n847: ) -> Result<Option<SessionRuntimeRow>, String> {\n848:     db.session_runtime(session_id)\n849: }\n850: \n851: fn pty_runtime_liveness(\n852:     db: &mut MailboxDb,\n853:     session_id: &str,\n854:     runtime: Option<&SessionRuntimeRow>,\n855: ) -> Result<Option<SessionLiveness>, String> {\n856:     if running_pty_runtime(runtime).is_none() {\n857:         return Ok(None);\n858:     };\n859:     session_liveness_for_runtime(db, session_id).map(Some)\n860: }\n861: \n862: fn running_pty_runtime(runtime: Option<&SessionRuntimeRow>) -> Option<&SessionRuntimeRow> {\n863:     runtime.filter(|row| row.mode == \"pty_interactive\" && row.run_state == \"running\")\n864: }\n865: \n866: fn session_liveness_for_runtime(\n867:     db: &mut MailboxDb,\n868:     session_id: &str,\n869: ) -> Result<SessionLiveness, String> {\n870:     db.session_liveness(session_id)\n871: }\n872: \n873: fn cleanup_idle_runtime(runtime: Option<&SessionRuntimeRow>, liveness: Option<SessionLiveness>) {\n874:     if let (Some(row), Some(SessionLiveness::Idle)) = (running_pty_runtime(runtime), liveness) {\n875:         unlink_stale_pty_socket(row.pty_control_path.as_deref());\n876:     }\n877: }\n878: \n879: fn optional_pty_liveness_is_busy(liveness: Option<SessionLiveness>) -> bool {\n880:     liveness.is_some_and(pty_liveness_is_busy)\n881: }\n882: \n883: fn pty_liveness_is_busy(liveness: SessionLiveness) -> bool {\n884:     liveness == SessionLiveness::Busy\n885: }\n886: \n887: #[cfg(unix)]\n888: fn unlink_stale_pty_socket(path: Option<&str>) {\n889:     if let Some(path) = path {\n890:         let _ = pty_broker::unlink_control_socket_if_owned(path);\n891:     }\n892: }\n893: \n894: #[cfg(not(unix))]\n895: fn unlink_stale_pty_socket(_path: Option<&str>) {}\n896: \n897: fn acquire_wake_claim(\n898:     db: &mut MailboxDb,\n899:     input: StartWakeInput<'_>,\n900:     claim_token: &str,\n901: ) -> Result<WakeClaimAcquireResult, String> {\n902:     db.try_acquire_or_renew_wake_claim(wake_claim_request(input, claim_token), input.renew_token)\n903: }\n904: \n905: fn wake_claim_request<'a>(input: StartWakeInput<'a>, claim_token: &'a str) -> WakeClaimRequest<'a> {\n906:     WakeClaimRequest {\n907:         session_id: input.session_id,\n908:         claim_token,\n909:         reason: input.reason,\n910:         auto_wake_count: input.auto_wake_count,\n911:         wake_invocation_uuid: None,\n912:         stale_after_seconds: WAKE_CLAIM_STALE_AFTER_SECONDS,\n913:     }\n914: }\n915: \n916: fn already_in_flight_diagnostic(claim: WakeClaimRow) -> WakeDiagnostic {\n917:     let mut diagnostic = WakeDiagnostic::status(\"already_in_flight\");\n918:     diagnostic.claim_token = Some(claim.claim_token);\n919:     diagnostic.wake_pid = claim.wake_pid;\n920:     diagnostic.auto_wake_count = Some(claim.auto_wake_count);\n921:     diagnostic\n922: }\n923: \n924: fn record_wake_pid_or_warn(\n925:     db: &mut MailboxDb,\n926:     session_id: &str,\n927:     claim_token: &str,\n928:     wake_pid: i64,\n929:     runtime: Option<&SessionRuntimeRow>,\n930: ) {\n931:     let provider_name = runtime.and_then(|row| row.provider_name.as_deref());\n932:     let model_name = runtime.and_then(|row| row.model_name.as_deref());\n933:     if let Err(err) = db.record_wake_claim_pid_identity(\n934:         session_id,\n935:         claim_token,\n936:         wake_pid,\n937:         provider_name,\n938:         model_name,\n939:     ) {\n940:         tracing::warn!(session_id, claim_token, \"Failed to record wake PID: {err}\");\n941:     }\n942: }\n943: \n944: fn spawned_wake_diagnostic(\n945:     claim_token: String,\n946:     wake_pid: i64,\n947:     auto_wake_count: i64,\n948: ) -> WakeDiagnostic {\n949:     WakeDiagnostic {\n950:         attempted: true,\n951:         status: \"spawned\".to_string(),\n952:         claim_token: Some(claim_token),\n953:         wake_pid: Some(wake_pid),\n954:         auto_wake_count: Some(auto_wake_count),\n955:         message: None,\n956:     }\n957: }\n958: \n959: fn spawn_error_diagnostic(\n960:     claim_token: String,\n961:     auto_wake_count: i64,\n962:     err: String,\n963: ) -> WakeDiagnostic {\n964:     WakeDiagnostic {\n965:         attempted: true,\n966:         status: \"spawn_error\".to_string(),\n967:         claim_token: Some(claim_token),\n968:         wake_pid: None,\n969:         auto_wake_count: Some(auto_wake_count),\n970:         message: Some(err),\n971:     }\n972: }\n973: \n974: fn spawn_detached_resume(\n975:     session_id: &str,\n976:     runtime: Option<&SessionRuntimeRow>,\n977:     claim_token: &str,\n978:     auto_wake_count: i64,\n979: ) -> Result<i64, String> {\n980:     let exe = current_agents_exe()?;\n981:     let cmd = detached_resume_command(exe, session_id, runtime, claim_token, auto_wake_count);\n982:     spawn_detached_child(cmd)\n983: }\n984: \n985: fn current_agents_exe() -> Result<PathBuf, String> {\n986:     std::env::current_exe().map_err(current_agents_exe_error)\n987: }\n988: \n989: fn current_agents_exe_error(err: std::io::Error) -> String {\n990:     format!(\"Failed to resolve current agents binary: {err}\")\n991: }\n992: \n993: fn spawn_detached_child(mut cmd: Command) -> Result<i64, String> {\n994:     cmd.spawn().map(child_pid).map_err(detached_spawn_error)\n995: }\n996: \n997: fn child_pid(child: Child) -> i64 {\n998:     i64::from(child.id())\n999: }\n1000: \n1001: fn detached_spawn_error(err: std::io::Error) -> String {\n1002:     format!(\"Failed to spawn detached wake resume: {err}\")\n1003: }\n1004: \n1005: fn detached_resume_command(\n1006:     exe: PathBuf,\n1007:     session_id: &str,\n1008:     runtime: Option<&SessionRuntimeRow>,\n1009:     claim_token: &str,\n1010:     auto_wake_count: i64,\n1011: ) -> Command {\n1012:     let mut cmd = Command::new(exe);\n1013:     configure_resume_args(&mut cmd, session_id, runtime);\n1014:     configure_wake_stdio_and_env(&mut cmd, session_id, claim_token, auto_wake_count);\n1015:     configure_detached(&mut cmd);\n1016:     cmd\n1017: }\n1018: \n1019: fn configure_resume_args(cmd: &mut Command, session_id: &str, runtime: Option<&SessionRuntimeRow>) {\n1020:     cmd.arg(\"resume\").arg(\"--session-id\").arg(session_id);\n1021:     append_non_empty_arg(cmd, \"-m\", runtime.and_then(|row| row.model_name.as_deref()));\n1022:     append_non_empty_arg(\n1023:         cmd,\n1024:         \"--models-dir\",\n1025:         runtime.and_then(|row| row.models_dir.as_deref()),\n1026:     );\n1027: }\n1028: \n1029: fn append_non_empty_arg(cmd: &mut Command, flag: &str, value: Option<&str>) {\n1030:     let Some(value) = value.filter(|value| !value.is_empty()) else {\n1031:         return;\n1032:     };\n1033:     cmd.arg(flag).arg(value);\n1034: }\n1035: \n1036: fn configure_wake_stdio_and_env(\n1037:     cmd: &mut Command,\n1038:     session_id: &str,\n1039:     claim_token: &str,\n1040:     auto_wake_count: i64,\n1041: ) {\n1042:     cmd.stdin(Stdio::null())\n1043:         .stdout(Stdio::null())\n1044:         .stderr(Stdio::null())\n1045:         .env(AUTO_WAKE_ENV, \"1\")\n1046:         .env(AUTO_WAKE_SESSION_ID_ENV, session_id)\n1047:         .env(AUTO_WAKE_TOKEN_ENV, claim_token)\n1048:         .env(AUTO_WAKE_COUNT_ENV, auto_wake_count.to_string())\n1049:         .env_remove(PARENT_INVOCATION_ENV);\n1050: }\n1051: \n1052: #[cfg(unix)]\n1053: fn configure_detached(cmd: &mut Command) {\n1054:     unsafe {\n1055:         cmd.pre_exec(|| {\n1056:             if libc::setsid() == -1 {\n1057:                 return Err(std::io::Error::last_os_error());\n1058:             }\n1059:             Ok(())\n1060:         });\n1061:     }\n1062: }\n1063: \n1064: #[cfg(not(unix))]\n1065: fn configure_detached(_cmd: &mut Command) {}\n1066: \n1067: fn pending_count(session_id: &str) -> Result<usize, String> {\n1068:     crate::mailbox_delivery::deliverable_pending_count(session_id)\n1069: }\n1070: \n1071: fn current_auto_wake() -> Option<AutoWakeEnv> {\n1072:     auto_wake_marker_present()\n1073:         .then(current_auto_wake_env)\n1074:         .flatten()\n1075: }\n1076: \n1077: fn auto_wake_max() -> i64 {\n1078:     validated_auto_wake_max(parsed_auto_wake_max())\n1079: }\n1080: \n1081: fn current_auto_wake_env() -> Option<AutoWakeEnv> {\n1082:     Some(auto_wake_env(auto_wake_token()?, auto_wake_count()))\n1083: }\n1084: \n1085: fn auto_wake_count() -> i64 {\n1086:     parse_auto_wake_count(auto_wake_count_value())\n1087: }\n1088: \n1089: fn parsed_auto_wake_max() -> Option<i64> {\n1090:     parse_auto_wake_max(auto_wake_max_value())\n1091: }\n1092: \n1093: fn auto_wake_token() -> Option<String> {\n1094:     std::env::var(AUTO_WAKE_TOKEN_ENV).ok()\n1095: }\n1096: \n1097: fn auto_wake_count_value() -> Option<String> {\n1098:     std::env::var(AUTO_WAKE_COUNT_ENV).ok()\n1099: }\n1100: \n1101: fn auto_wake_max_value() -> Option<String> {\n1102:     std::env::var(AUTO_WAKE_MAX_ENV).ok()\n1103: }\n1104: \n1105: fn parse_auto_wake_count(value: Option<String>) -> i64 {\n1106:     value.and_then(|value| value.parse().ok()).unwrap_or(1)\n1107: }\n1108: \n1109: fn parse_auto_wake_max(value: Option<String>) -> Option<i64> {\n1110:     value.and_then(|value| value.parse::<i64>().ok())\n1111: }\n1112: \n1113: fn validated_auto_wake_max(value: Option<i64>) -> i64 {\n1114:     value\n1115:         .filter(|value| *value > 0)\n1116:         .unwrap_or(DEFAULT_AUTO_WAKE_MAX)\n1117: }\n1118: \n1119: fn auto_wake_env(token: String, count: i64) -> AutoWakeEnv {\n1120:     AutoWakeEnv { token, count }\n1121: }\n1122: \n1123: fn release_current_auto_wake_claim(session_id: &str, auto_wake: Option<&AutoWakeEnv>) {\n1124:     let Some(auto_wake) = auto_wake else {\n1125:         return;\n1126:     };\n1127:     match MailboxDb::open_default_if_exists() {\n1128:         Ok(Some(mut db)) => release_wake_claim_or_warn(&mut db, session_id, &auto_wake.token),\n1129:         Ok(None) => {}\n1130:         Err(err) => warn_open_sidecar_for_release_failed(session_id, err),\n1131:     }\n1132: }\n1133: \n1134: fn release_wake_claim_or_warn(db: &mut MailboxDb, session_id: &str, token: &str) {\n1135:     if let Err(err) = db.release_wake_claim(session_id, Some(token)) {\n1136:         warn_release_wake_claim_failed(session_id, err);\n1137:     }\n1138: }\n1139: \n1140: fn warn_release_wake_claim_failed(session_id: &str, err: String) {\n1141:     tracing::warn!(session_id, \"Failed to release wake claim: {err}\");\n1142: }\n1143: \n1144: fn warn_open_sidecar_for_release_failed(session_id: &str, err: String) {\n1145:     tracing::warn!(\n1146:         session_id,\n1147:         \"Failed to open sidecar to release wake claim: {err}\"\n1148:     );\n1149: }\n\n(End of file - total 1149 lines)\n</content>","metadata":{"preview":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n//! `predicate`, `validator`\n\nuse oulipoly_state::StateDb;\nuse oulipoly_state::mailbox::{\n    MailboxDb, MailboxRow, SessionLiveness, SessionRuntimeIdleUpdate, SessionRuntimeRow,\n    WAKE_SWEEP_ABANDONED_ERROR, WakeClaimAcquireResult, WakeClaimRequest, WakeClaimRow,\n    WakeSweepCandidate,\n};\nuse oulipoly_state::pid_identity::{ProcessIdentity, read_live_process_identity};\nuse serde::Serialize;\nuse std::path::PathBuf;\nuse std::process::{Child, Command, Stdio};\nuse std::sync::OnceLock;\nuse std::time::Duration;\nuse uuid::Uuid;\n\n#[cfg(unix)]","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/wake_coordinator.rs","text":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n//! `predicate`, `validator`\n\nuse oulipoly_state::StateDb;\nuse oulipoly_state::mailbox::{\n    MailboxDb, MailboxRow, SessionLiveness, SessionRuntimeIdleUpdate, SessionRuntimeRow,\n    WAKE_SWEEP_ABANDONED_ERROR, WakeClaimAcquireResult, WakeClaimRequest, WakeClaimRow,\n    WakeSweepCandidate,\n};\nuse oulipoly_state::pid_identity::{ProcessIdentity, read_live_process_identity};\nuse serde::Serialize;\nuse std::path::PathBuf;\nuse std::process::{Child, Command, Stdio};\nuse std::sync::OnceLock;\nuse std::time::Duration;\nuse uuid::Uuid;\n\n#[cfg(unix)]\nuse oulipoly_runtime::executor::cli::pty_broker;\n#[cfg(unix)]\nuse std::os::unix::process::CommandExt;\n\nconst AUTO_WAKE_ENV: &str = \"OULIPOLY_AUTO_WAKE\";\nconst AUTO_WAKE_SESSION_ID_ENV: &str = \"OULIPOLY_AUTO_WAKE_SESSION_ID\";\nconst AUTO_WAKE_TOKEN_ENV: &str = \"OULIPOLY_AUTO_WAKE_TOKEN\";\nconst AUTO_WAKE_COUNT_ENV: &str = \"OULIPOLY_AUTO_WAKE_COUNT\";\nconst AUTO_WAKE_MAX_ENV: &str = \"OULIPOLY_AUTO_WAKE_MAX\";\nconst AUTO_WAKE_RETRY_BASE_MS_ENV: &str = \"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\";\nconst PARENT_INVOCATION_ENV: &str = \"OULIPOLY_PARENT_INVOCATION\";\nconst DEFAULT_AUTO_WAKE_MAX: i64 = 5;\nconst DEFAULT_AUTO_WAKE_RETRY_BASE_MS: u64 = 1_000;\nconst AUTO_WAKE_RETRY_MAX_MS: u64 = 30_000;\nconst WAKE_CLAIM_STALE_AFTER_SECONDS: i64 = 10 * 60;\nconst WAKE_RECLAIM_SWEEP_LIMIT: usize = 8;\nconst WAKE_RECLAIM_SWEEP_SCAN_LIMIT: usize = WAKE_RECLAIM_SWEEP_LIMIT * 32;\nconst WAKE_RECLAIM_REAP_SESSION_LIMIT: usize = 32;\nconst WAKE_RECLAIM_REAP_ROWS_PER_SESSION: usize = 20;\n#[allow(dead_code)]\nconst WAKE_RECLAIM_SWEEP_INTERVAL_SECONDS: u64 = 60;\nconst CONSUMED_NOTIFICATION_MARKER: &str = \"[OULIPOLY NOTIFICATIONS]\";\n\n#[derive(Debug, Clone, Serialize)]\npub(crate) struct WakeDiagnostic {\n    pub(crate) attempted: bool,\n    pub(crate) status: String,\n    pub(crate) claim_token: Option<String>,\n    pub(crate) wake_pid: Option<i64>,\n    pub(crate) auto_wake_count: Option<i64>,\n    pub(crate) message: Option<String>,\n}\n\nimpl WakeDiagnostic {\n    fn status(status: &str) -> Self {\n        Self {\n            attempted: false,\n            status: status.to_string(),\n            claim_token: None,\n            wake_pid: None,\n            auto_wake_count: None,\n            message: None,\n        }\n    }\n\n    fn with_message(status: &str, message: String) -> Self {\n        Self {\n            attempted: false,\n            status: status.to_string(),\n            claim_token: None,\n            wake_pid: None,\n            auto_wake_count: None,\n            message: Some(message),\n        }\n    }\n}\n\npub(crate) fn mark_session_idle_after_turn(\n    session_id: &str,\n    invocation_uuid: &str,\n    exit_code: Option<i32>,\n) -> Result<(), String> {\n    let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n        return Ok(());\n    };\n    db.mark_session_idle(SessionRuntimeIdleUpdate {\n        session_id,\n        invocation_uuid,\n        last_exit_code: exit_code,\n    })?;\n    Ok(())\n}\n\npub(crate) fn trigger_notify_wake(session_id: &str) -> WakeDiagnostic {\n    start_wake_chain(StartWakeInput {\n        session_id,\n        reason: \"notify_idle\",\n        auto_wake_count: 1,\n        renew_token: None,\n    })\n}\n\npub(crate) fn run_startup_wake_reclaim_sweep() {\n    if is_auto_wake_invocation() {\n        return;\n    }\n    run_wake_reclaim_sweep_or_warn(\"process_start\");\n}\n\n#[allow(dead_code)]\npub(crate) fn start_wake_reclaim_maintenance_driver() {\n    static DRIVER: OnceLock<()> = OnceLock::new();\n    DRIVER.get_or_init(spawn_wake_reclaim_maintenance_driver);\n}\n\n#[allow(dead_code)]\nfn spawn_wake_reclaim_maintenance_driver() {\n    let result = std::thread::Builder::new()\n        .name(\"oulipoly-wake-reclaim-sweep\".to_string())\n        .spawn(wake_reclaim_maintenance_loop);\n    if let Err(err) = result {\n        tracing::warn!(\"Failed to start wake reclaim sweep driver: {err}\");\n    }\n}\n\n#[allow(dead_code)]\nfn wake_reclaim_maintenance_loop() {\n    run_wake_reclaim_sweep_or_warn(\"maintenance_start\");\n    loop {\n        std::thread::sleep(Duration::from_secs(WAKE_RECLAIM_SWEEP_INTERVAL_SECONDS));\n        run_wake_reclaim_sweep_or_warn(\"maintenance_tick\");\n    }\n}\n\nfn run_wake_reclaim_sweep_or_warn(trigger: &str) {\n    if let Err(err) = run_wake_reclaim_sweep(trigger) {\n        tracing::warn!(trigger, \"Wake reclaim sweep failed: {err}\");\n    }\n}\n\nfn run_wake_reclaim_sweep(trigger: &str) -> Result<(), String> {\n    let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n        return Ok(());\n    };\n    let candidates = db.wake_sweep_candidates(\n        WAKE_CLAIM_STALE_AFTER_SECONDS,\n        WAKE_RECLAIM_SWEEP_SCAN_LIMIT,\n    )?;\n    let plan = wake_sweep_plan(&mut db, candidates)?;\n    reap_abandoned_sweep_candidates(&mut db, &plan.reap)?;\n    drop(db);\n    for candidate in plan.start {\n        let diagnostic = start_wake_chain(StartWakeInput {\n            session_id: &candidate.session_id,\n            reason: trigger,\n            auto_wake_count: candidate.auto_wake_count,\n            renew_token: None,\n        });\n        trace_wake_sweep_candidate(&candidate.session_id, &diagnostic);\n    }\n    Ok(())\n}\n\nstruct WakeSweepPlan {\n    start: Vec<WakeSweepCandidate>,\n    reap: Vec<WakeSweepCandidate>,\n}\n\nfn wake_sweep_plan(\n    db: &mut MailboxDb,\n    candidates: Vec<WakeSweepCandidate>,\n) -> Result<WakeSweepPlan, String> {\n    let (recoverable, reap) = partition_wake_sweep_candidates(db, candidates)?;\n    let start = select_recoverable_sweep_candidates(recoverable);\n    Ok(wake_sweep_plan_from_selected(start, reap))\n}\n\nfn partition_wake_sweep_candidates(\n    db: &mut MailboxDb,\n    candidates: Vec<WakeSweepCandidate>,\n) -> Result<(Vec<WakeSweepCandidate>, Vec<WakeSweepCandidate>), String> {\n    let state = open_default_state_read_only();\n    let mut recoverable = Vec::new();\n    let mut reap = Vec::new();\n    for candidate in candidates {\n        match wake_sweep_candidate_disposition(db, state.as_ref(), &candidate)? {\n            WakeSweepDisposition::Recoverable => {\n                recoverable.push(candidate);\n            }\n            WakeSweepDisposition::Abandoned => {\n                if reap.len() < WAKE_RECLAIM_REAP_SESSION_LIMIT {\n                    reap.push(candidate);\n                }\n            }\n            WakeSweepDisposition::Skip => {}\n        }\n    }\n    Ok((recoverable, reap))\n}\n\nfn wake_sweep_plan_from_selected(\n    start: Vec<WakeSweepCandidate>,\n    reap: Vec<WakeSweepCandidate>,\n) -> WakeSweepPlan {\n    WakeSweepPlan { start, reap }\n}\n\nfn select_recoverable_sweep_candidates(\n    mut candidates: Vec<WakeSweepCandidate>,\n) -> Vec<WakeSweepCandidate> {\n    if candidates.len() <= WAKE_RECLAIM_SWEEP_LIMIT {\n        return candidates;\n    }\n    candidates.sort_by_key(|candidate| candidate.min_pending_seq);\n    let oldest_slots = WAKE_RECLAIM_SWEEP_LIMIT.div_ceil(2);\n    let newest_slots = WAKE_RECLAIM_SWEEP_LIMIT.saturating_sub(oldest_slots);\n    let mut selected = candidates\n        .iter()\n        .take(oldest_slots)\n        .cloned()\n        .collect::<Vec<_>>();\n    for candidate in candidates.iter().rev().take(newest_slots) {\n        if !selected\n            .iter()\n            .any(|existing| existing.session_id == candidate.session_id)\n        {\n            selected.push(candidate.clone());\n        }\n    }\n    selected\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\nenum WakeSweepDisposition {\n    Recoverable,\n    Abandoned,\n    Skip,\n}\n\nfn wake_sweep_candidate_disposition(\n    db: &MailboxDb,\n    state: Option<&StateDb>,\n    candidate: &WakeSweepCandidate,\n) -> Result<WakeSweepDisposition, String> {\n    // Recoverable means either an idle headless runtime with durable resume\n    // evidence, or a live owner PID identity that must not be reaped. Missing\n    // runtime/history with no live owner is abandoned debris, not resumable work.\n    if pending_mailbox_consumed_marker_present(db, &candidate.session_id) {\n        return Ok(WakeSweepDisposition::Skip);\n    }\n    if wake_sweep_candidate_is_resumable(db, state, candidate)? {\n        return Ok(resumable_wake_sweep_disposition(candidate));\n    }\n    if wake_sweep_candidate_has_live_owner(db, &candidate.session_id)? {\n        return Ok(WakeSweepDisposition::Skip);\n    }\n    Ok(WakeSweepDisposition::Abandoned)\n}\n\nfn resumable_wake_sweep_disposition(candidate: &WakeSweepCandidate) -> WakeSweepDisposition {\n    if wake_sweep_candidate_reached_cap(candidate)\n        || !wake_sweep_candidate_has_deliverable_pending(&candidate.session_id)\n    {\n        return WakeSweepDisposition::Skip;\n    }\n    WakeSweepDisposition::Recoverable\n}\n\nfn reap_abandoned_sweep_candidates(\n    db: &mut MailboxDb,\n    candidates: &[WakeSweepCandidate],\n) -> Result<(), String> {\n    for candidate in candidates {\n        db.mark_pending_abandoned(\n            &candidate.session_id,\n            WAKE_SWEEP_ABANDONED_ERROR,\n            WAKE_RECLAIM_REAP_ROWS_PER_SESSION,\n        )?;\n    }\n    Ok(())\n}\n\nfn wake_sweep_candidate_has_deliverable_pending(session_id: &str) -> bool {\n    crate::mailbox_delivery::deliverable_pending_count(session_id)\n        .map(|count| count > 0)\n        .unwrap_or(false)\n}\n\nfn wake_sweep_candidate_is_resumable(\n    db: &MailboxDb,\n    state: Option<&StateDb>,\n    candidate: &WakeSweepCandidate,\n) -> Result<bool, String> {\n    let Some(runtime) = db.session_runtime(&candidate.session_id)? else {\n        return Ok(false);\n    };\n    if !wake_sweep_runtime_can_resume(&runtime) {\n        return Ok(false);\n    }\n    wake_sweep_runtime_has_resume_evidence(state, &runtime)\n}\n\nfn wake_sweep_runtime_can_resume(runtime: &SessionRuntimeRow) -> bool {\n    runtime.mode == \"headless\"\n        && runtime.run_state != \"running\"\n        && runtime\n            .provider_name\n            .as_deref()\n            .is_some_and(|provider| !provider.is_empty())\n}\n\nfn wake_sweep_runtime_has_resume_evidence(\n    state: Option<&StateDb>,\n    runtime: &SessionRuntimeRow,\n) -> Result<bool, String> {\n    let Some(state) = state else {\n        return Ok(false);\n    };\n    let Some(provider_name) = runtime.provider_name.as_deref() else {\n        return Ok(false);\n    };\n    if state\n        .chain_id_for_segment(provider_name, &runtime.session_id)\n        .map_err(|err| err.to_string())?\n        .is_some()\n    {\n        return Ok(true);\n    }\n    state\n        .count_session_turns(provider_name, &runtime.session_id)\n        .map(|counts| counts.total > 0)\n}\n\nfn wake_sweep_candidate_has_live_owner(db: &MailboxDb, session_id: &str) -> Result<bool, String> {\n    for row in db.list_pending(session_id)? {\n        if mailbox_row_has_live_owner_identity(&row)? {\n            return Ok(true);\n        }\n    }\n    Ok(false)\n}\n\nfn mailbox_row_has_live_owner_identity(row: &MailboxRow) -> Result<bool, String> {\n    let Some(recorded) = mailbox_row_owner_identity(row) else {\n        return Ok(false);\n    };\n    read_live_process_identity(recorded.os_pid).map(|live| live.as_ref() == Some(&recorded))\n}\n\nfn mailbox_row_owner_identity(row: &MailboxRow) -> Option<ProcessIdentity> {\n    Some(ProcessIdentity {\n        os_pid: row.matched_os_pid?,\n        os_boot_id: row.matched_os_boot_id.clone()?,\n        os_pid_starttime_ticks: row.matched_os_pid_starttime_ticks?,\n    })\n}\n\nfn wake_sweep_candidate_reached_cap(candidate: &WakeSweepCandidate) -> bool {\n    auto_wake_cap_reached(candidate.auto_wake_count.saturating_sub(1), auto_wake_max())\n}\n\nfn pending_mailbox_consumed_marker_present(db: &MailboxDb, session_id: &str) -> bool {\n    let Ok(pending) = db.list_pending(session_id) else {\n        return false;\n    };\n    if pending.is_empty() {\n        return true;\n    }\n    let Some(provider_name) = pending_mailbox_provider_name(db, session_id) else {\n        return false;\n    };\n    let Some(state) = open_default_state_read_only() else {\n        return false;\n    };\n    session_has_consumed_notification_marker(&state, &provider_name, session_id)\n        && pending.iter().all(|row| {\n            state\n                .has_session_user_turn_containing(\n                    &provider_name,\n                    session_id,\n                    &mailbox_handle_marker(row),\n                )\n                .unwrap_or(false)\n        })\n}\n\nfn mailbox_handle_marker(row: &MailboxRow) -> String {\n    format!(\"handle: {}\", row.handle)\n}\n\nfn open_default_state_read_only() -> Option<StateDb> {\n    let path = StateDb::default_path().ok()?;\n    if !path.exists() {\n        return None;\n    }\n    StateDb::open_read_only(&path).ok()\n}\n\nfn pending_mailbox_provider_name(db: &MailboxDb, session_id: &str) -> Option<String> {\n    db.session_runtime(session_id)\n        .ok()\n        .flatten()\n        .and_then(|runtime| runtime.provider_name)\n}\n\nfn session_has_consumed_notification_marker(\n    state: &StateDb,\n    provider_name: &str,\n    session_id: &str,\n) -> bool {\n    state\n        .has_session_user_turn_containing(provider_name, session_id, CONSUMED_NOTIFICATION_MARKER)\n        .unwrap_or(false)\n}\n\nfn trace_wake_sweep_candidate(session_id: &str, diagnostic: &WakeDiagnostic) {\n    tracing::debug!(\n        session_id,\n        status = diagnostic.status.as_str(),\n        \"Wake reclaim sweep candidate evaluated\"\n    );\n}\n\npub(crate) fn mark_successful_turn_idle_and_recheck(\n    session_id: &str,\n    invocation_uuid: &str,\n    exit_code: i32,\n) -> Result<WakeDiagnostic, String> {\n    mark_session_idle_after_turn(session_id, invocation_uuid, Some(exit_code))?;\n    Ok(successful_turn_recheck(session_id))\n}\n\nfn successful_turn_recheck(session_id: &str) -> WakeDiagnostic {\n    trigger_turn_end_recheck(session_id)\n}\n\npub(crate) fn validate_auto_wake_child(session_id: &str) -> Result<Option<i32>, String> {\n    if !auto_wake_marker_present() {\n        return Ok(None);\n    }\n    let marker = auto_wake_child_marker();\n    if !auto_wake_child_marker_matches(session_id, &marker) {\n        return Ok(Some(0));\n    }\n    validate_auto_wake_child_claim(session_id, &marker.claim_token)\n}\n\nstruct AutoWakeChildMarker {\n    expected_session: String,\n    claim_token: String,\n}\n\nfn auto_wake_marker_present() -> bool {\n    std::env::var_os(AUTO_WAKE_ENV).is_some()\n}\n\nfn auto_wake_child_marker() -> AutoWakeChildMarker {\n    auto_wake_child_marker_from_parts(auto_wake_expected_session(), auto_wake_child_claim_token())\n}\n\nfn auto_wake_expected_session() -> String {\n    std::env::var(AUTO_WAKE_SESSION_ID_ENV).unwrap_or_default()\n}\n\nfn auto_wake_child_claim_token() -> String {\n    std::env::var(AUTO_WAKE_TOKEN_ENV).unwrap_or_default()\n}\n\nfn auto_wake_child_marker_from_parts(\n    expected_session: String,\n    claim_token: String,\n) -> AutoWakeChildMarker {\n    AutoWakeChildMarker {\n        expected_session,\n        claim_token,\n    }\n}\n\nfn auto_wake_child_marker_matches(session_id: &str, marker: &AutoWakeChildMarker) -> bool {\n    marker.expected_session == session_id && !marker.claim_token.is_empty()\n}\n\nfn validate_auto_wake_child_claim(\n    session_id: &str,\n    claim_token: &str,\n) -> Result<Option<i32>, String> {\n    let Some(mut db) = open_optional_wake_mailbox()? else {\n        return Ok(Some(0));\n    };\n    validate_auto_wake_claim_with_db(&mut db, session_id, claim_token)\n}\n\nfn open_optional_wake_mailbox() -> Result<Option<MailboxDb>, String> {\n    MailboxDb::open_default_if_exists()\n}\n\nfn validate_auto_wake_claim_with_db(\n    db: &mut MailboxDb,\n    session_id: &str,\n    claim_token: &str,\n) -> Result<Option<i32>, String> {\n    db.validate_wake_claim_for_child(session_id, claim_token)\n        .map(auto_wake_child_validation_result)\n}\n\nfn auto_wake_child_validation_result(valid: bool) -> Option<i32> {\n    if valid { None } else { Some(0) }\n}\n\npub(crate) fn is_auto_wake_invocation() -> bool {\n    auto_wake_marker_present()\n}\n\npub(crate) fn reset_manual_resume_wake_claim(session_id: &str) -> Result<(), String> {\n    let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n        return Ok(());\n    };\n    db.release_wake_claim(session_id, None)?;\n    Ok(())\n}\n\npub(crate) fn release_current_auto_wake_claim_for_session(session_id: &str) {\n    let auto_wake = current_auto_wake();\n    release_current_auto_wake_claim(session_id, auto_wake.as_ref());\n}\n\npub(crate) fn recheck_after_failed_auto_wake(session_id: &str) -> WakeDiagnostic {\n    let Some(auto_wake) = current_auto_wake() else {\n        return WakeDiagnostic::status(\"not_auto_wake\");\n    };\n    release_current_auto_wake_claim(session_id, Some(&auto_wake));\n    failed_auto_wake_recheck(session_id, &auto_wake)\n}\n\nfn trigger_turn_end_recheck(session_id: &str) -> WakeDiagnostic {\n    let pending_count = match turn_end_pending_count(session_id) {\n        Ok(count) => count,\n        Err(err) => return storage_error_diagnostic(err),\n    };\n    let auto_wake = current_auto_wake();\n    apply_turn_end_recheck_decision(\n        session_id,\n        auto_wake.as_ref(),\n        turn_end_recheck_decision(session_id, pending_count, auto_wake.as_ref()),\n    )\n}\n\nfn failed_auto_wake_recheck(session_id: &str, auto_wake: &AutoWakeEnv) -> WakeDiagnostic {\n    let pending_count = match turn_end_pending_count(session_id) {\n        Ok(count) => count,\n        Err(err) => return storage_error_diagnostic(err),\n    };\n    apply_failed_auto_wake_recheck_decision(\n        session_id,\n        auto_wake,\n        failed_auto_wake_recheck_decision(session_id, pending_count, auto_wake),\n    )\n}\n\nenum TurnEndRecheckDecision<'a> {\n    NoPending,\n    CapReached { current_count: i64, max_count: i64 },\n    Start(StartWakeInput<'a>),\n}\n\nfn turn_end_recheck_decision<'a>(\n    session_id: &'a str,\n    pending_count: usize,\n    auto_wake: Option<&'a AutoWakeEnv>,\n) -> TurnEndRecheckDecision<'a> {\n    if no_pending(pending_count) {\n        return TurnEndRecheckDecision::NoPending;\n    }\n    let current_count = current_auto_wake_count(auto_wake);\n    let max_count = auto_wake_max();\n    if auto_wake_cap_reached(current_count, max_count) {\n        return TurnEndRecheckDecision::CapReached {\n            current_count,\n            max_count,\n        };\n    }\n    TurnEndRecheckDecision::Start(StartWakeInput {\n        session_id,\n        reason: \"turn_end_recheck\",\n        auto_wake_count: current_count + 1,\n        renew_token: auto_wake.map(|wake| wake.token.as_str()),\n    })\n}\n\nfn apply_turn_end_recheck_decision(\n    session_id: &str,\n    auto_wake: Option<&AutoWakeEnv>,\n    decision: TurnEndRecheckDecision<'_>,\n) -> WakeDiagnostic {\n    match decision {\n        TurnEndRecheckDecision::NoPending => {\n            release_current_auto_wake_claim(session_id, auto_wake);\n            WakeDiagnostic::status(\"no_pending\")\n        }\n        TurnEndRecheckDecision::CapReached {\n            current_count,\n            max_count,\n        } => {\n            release_current_auto_wake_claim(session_id, auto_wake);\n            emit_auto_wake_cap_reached(session_id, current_count, max_count);\n            auto_wake_cap_diagnostic(current_count)\n        }\n        TurnEndRecheckDecision::Start(input) => start_wake_chain(input),\n    }\n}\n\nenum FailedAutoWakeRecheckDecision<'a> {\n    NoPending,\n    CapReached { current_count: i64, max_count: i64 },\n    Retry(StartWakeInput<'a>),\n}\n\nfn failed_auto_wake_recheck_decision<'a>(\n    session_id: &'a str,\n    pending_count: usize,\n    auto_wake: &'a AutoWakeEnv,\n) -> FailedAutoWakeRecheckDecision<'a> {\n    if no_pending(pending_count) {\n        return FailedAutoWakeRecheckDecision::NoPending;\n    }\n    let max_count = auto_wake_max();\n    if auto_wake_cap_reached(auto_wake.count, max_count) {\n        return FailedAutoWakeRecheckDecision::CapReached {\n            current_count: auto_wake.count,\n            max_count,\n        };\n    }\n    FailedAutoWakeRecheckDecision::Retry(StartWakeInput {\n        session_id,\n        reason: \"wake_failure_retry\",\n        auto_wake_count: auto_wake.count + 1,\n        renew_token: None,\n    })\n}\n\nfn apply_failed_auto_wake_recheck_decision(\n    session_id: &str,\n    auto_wake: &AutoWakeEnv,\n    decision: FailedAutoWakeRecheckDecision<'_>,\n) -> WakeDiagnostic {\n    match decision {\n        FailedAutoWakeRecheckDecision::NoPending => WakeDiagnostic::status(\"no_pending\"),\n        FailedAutoWakeRecheckDecision::CapReached {\n            current_count,\n            max_count,\n        } => {\n            emit_auto_wake_cap_reached(session_id, current_count, max_count);\n            auto_wake_cap_diagnostic(current_count)\n        }\n        FailedAutoWakeRecheckDecision::Retry(input) => {\n            sleep_before_failed_auto_wake_retry(auto_wake.count);\n            start_wake_chain(input)\n        }\n    }\n}\n\nfn sleep_before_failed_auto_wake_retry(auto_wake_count: i64) {\n    std::thread::sleep(auto_wake_retry_delay(auto_wake_count));\n}\n\nfn auto_wake_retry_delay(auto_wake_count: i64) -> Duration {\n    Duration::from_millis(auto_wake_retry_delay_ms(auto_wake_count))\n}\n\nfn auto_wake_retry_delay_ms(auto_wake_count: i64) -> u64 {\n    let base_ms = auto_wake_retry_base_ms();\n    let exponent = auto_wake_count.saturating_sub(1).clamp(0, 10) as u32;\n    base_ms\n        .saturating_mul(2_u64.saturating_pow(exponent))\n        .min(AUTO_WAKE_RETRY_MAX_MS)\n}\n\nfn auto_wake_retry_base_ms() -> u64 {\n    parsed_auto_wake_retry_base_ms()\n        .filter(|value| *value > 0)\n        .unwrap_or(DEFAULT_AUTO_WAKE_RETRY_BASE_MS)\n}\n\nfn parsed_auto_wake_retry_base_ms() -> Option<u64> {\n    std::env::var(AUTO_WAKE_RETRY_BASE_MS_ENV)\n        .ok()\n        .and_then(|value| value.parse::<u64>().ok())\n}\n\nfn current_auto_wake_count(auto_wake: Option<&AutoWakeEnv>) -> i64 {\n    auto_wake.map(|wake| wake.count).unwrap_or(0)\n}\n\nfn turn_end_pending_count(session_id: &str) -> Result<usize, String> {\n    pending_count(session_id)\n}\n\nfn no_pending(pending_count: usize) -> bool {\n    pending_count == 0\n}\n\nfn auto_wake_cap_reached(current_count: i64, max_count: i64) -> bool {\n    current_count >= max_count\n}\n\nfn emit_auto_wake_cap_reached(session_id: &str, current_count: i64, max_count: i64) {\n    eprintln!(\n        \"auto_wake_cap_reached session_id={session_id} count={current_count} max={max_count}\"\n    );\n}\n\nfn auto_wake_cap_diagnostic(current_count: i64) -> WakeDiagnostic {\n    let mut diagnostic = WakeDiagnostic::status(\"auto_wake_cap_reached\");\n    diagnostic.auto_wake_count = Some(current_count);\n    diagnostic\n}\n\nfn storage_error_diagnostic(err: String) -> WakeDiagnostic {\n    WakeDiagnostic::with_message(\"storage_error\", err)\n}\n\nstruct AutoWakeEnv {\n    token: String,\n    count: i64,\n}\n\n#[derive(Clone, Copy)]\nstruct StartWakeInput<'a> {\n    session_id: &'a str,\n    reason: &'a str,\n    auto_wake_count: i64,\n    renew_token: Option<&'a str>,\n}\n\nfn start_wake_chain(input: StartWakeInput<'_>) -> WakeDiagnostic {\n    let claim_token = Uuid::new_v4().to_string();\n    let mut context = match prepare_wake_start_context(input, &claim_token) {\n        Ok(context) => context,\n        Err(diagnostic) => return diagnostic,\n    };\n    let spawn = spawn_detached_resume(\n        input.session_id,\n        context.runtime.as_ref(),\n        &context.claim.claim_token,\n        input.auto_wake_count,\n    );\n    wake_spawn_diagnostic(\n        &mut context.db,\n        input,\n        context.runtime.as_ref(),\n        context.claim,\n        spawn,\n    )\n}\n\nstruct WakeStartContext {\n    db: MailboxDb,\n    runtime: Option<SessionRuntimeRow>,\n    claim: WakeClaimRow,\n}\n\nfn prepare_wake_start_context(\n    input: StartWakeInput<'_>,\n    claim_token: &str,\n) -> Result<WakeStartContext, WakeDiagnostic> {\n    let mut db = open_wake_mailbox().map_err(storage_error_diagnostic)?;\n    let runtime =\n        session_runtime_for_wake(&db, input.session_id).map_err(storage_error_diagnostic)?;\n    if wake_runtime_busy(&mut db, input.session_id, runtime.as_ref())? {\n        return Err(WakeDiagnostic::status(\"busy\"));\n    }\n    let claim = acquire_startable_wake_claim(&mut db, input, claim_token)?;\n    Ok(WakeStartContext { db, runtime, claim })\n}\n\nfn wake_runtime_busy(\n    db: &mut MailboxDb,\n    session_id: &str,\n    runtime: Option<&SessionRuntimeRow>,\n) -> Result<bool, WakeDiagnostic> {\n    let liveness =\n        pty_runtime_liveness(db, session_id, runtime).map_err(storage_error_diagnostic)?;\n    cleanup_idle_runtime(runtime, liveness);\n    Ok(optional_pty_liveness_is_busy(liveness))\n}\n\nfn acquire_startable_wake_claim(\n    db: &mut MailboxDb,\n    input: StartWakeInput<'_>,\n    claim_token: &str,\n) -> Result<WakeClaimRow, WakeDiagnostic> {\n    let claim_result =\n        acquire_wake_claim(db, input, claim_token).map_err(storage_error_diagnostic)?;\n    wake_claim_to_start(claim_result)\n}\n\nfn wake_claim_to_start(result: WakeClaimAcquireResult) -> Result<WakeClaimRow, WakeDiagnostic> {\n    match result {\n        WakeClaimAcquireResult::Acquired(claim) => Ok(claim),\n        WakeClaimAcquireResult::NoPending => Err(WakeDiagnostic::status(\"no_pending\")),\n        WakeClaimAcquireResult::Busy => Err(WakeDiagnostic::status(\"busy\")),\n        WakeClaimAcquireResult::AlreadyInFlight(claim) => Err(already_in_flight_diagnostic(claim)),\n    }\n}\n\nfn wake_spawn_diagnostic(\n    db: &mut MailboxDb,\n    input: StartWakeInput<'_>,\n    runtime: Option<&SessionRuntimeRow>,\n    claim: WakeClaimRow,\n    spawn: Result<i64, String>,\n) -> WakeDiagnostic {\n    match spawn {\n        Ok(wake_pid) => successful_wake_spawn_diagnostic(db, input, runtime, claim, wake_pid),\n        Err(err) => failed_wake_spawn_diagnostic(db, input, claim, err),\n    }\n}\n\nfn successful_wake_spawn_diagnostic(\n    db: &mut MailboxDb,\n    input: StartWakeInput<'_>,\n    runtime: Option<&SessionRuntimeRow>,\n    claim: WakeClaimRow,\n    wake_pid: i64,\n) -> WakeDiagnostic {\n    record_wake_pid_or_warn(db, input.session_id, &claim.claim_token, wake_pid, runtime);\n    spawned_wake_diagnostic(claim.claim_token, wake_pid, input.auto_wake_count)\n}\n\nfn failed_wake_spawn_diagnostic(\n    db: &mut MailboxDb,\n    input: StartWakeInput<'_>,\n    claim: WakeClaimRow,\n    err: String,\n) -> WakeDiagnostic {\n    let _ = db.release_wake_claim(input.session_id, Some(&claim.claim_token));\n    spawn_error_diagnostic(claim.claim_token, input.auto_wake_count, err)\n}\n\nfn open_wake_mailbox() -> Result<MailboxDb, String> {\n    MailboxDb::open_default()\n}\n\nfn session_runtime_for_wake(\n    db: &MailboxDb,\n    session_id: &str,\n) -> Result<Option<SessionRuntimeRow>, String> {\n    db.session_runtime(session_id)\n}\n\nfn pty_runtime_liveness(\n    db: &mut MailboxDb,\n    session_id: &str,\n    runtime: Option<&SessionRuntimeRow>,\n) -> Result<Option<SessionLiveness>, String> {\n    if running_pty_runtime(runtime).is_none() {\n        return Ok(None);\n    };\n    session_liveness_for_runtime(db, session_id).map(Some)\n}\n\nfn running_pty_runtime(runtime: Option<&SessionRuntimeRow>) -> Option<&SessionRuntimeRow> {\n    runtime.filter(|row| row.mode == \"pty_interactive\" && row.run_state == \"running\")\n}\n\nfn session_liveness_for_runtime(\n    db: &mut MailboxDb,\n    session_id: &str,\n) -> Result<SessionLiveness, String> {\n    db.session_liveness(session_id)\n}\n\nfn cleanup_idle_runtime(runtime: Option<&SessionRuntimeRow>, liveness: Option<SessionLiveness>) {\n    if let (Some(row), Some(SessionLiveness::Idle)) = (running_pty_runtime(runtime), liveness) {\n        unlink_stale_pty_socket(row.pty_control_path.as_deref());\n    }\n}\n\nfn optional_pty_liveness_is_busy(liveness: Option<SessionLiveness>) -> bool {\n    liveness.is_some_and(pty_liveness_is_busy)\n}\n\nfn pty_liveness_is_busy(liveness: SessionLiveness) -> bool {\n    liveness == SessionLiveness::Busy\n}\n\n#[cfg(unix)]\nfn unlink_stale_pty_socket(path: Option<&str>) {\n    if let Some(path) = path {\n        let _ = pty_broker::unlink_control_socket_if_owned(path);\n    }\n}\n\n#[cfg(not(unix))]\nfn unlink_stale_pty_socket(_path: Option<&str>) {}\n\nfn acquire_wake_claim(\n    db: &mut MailboxDb,\n    input: StartWakeInput<'_>,\n    claim_token: &str,\n) -> Result<WakeClaimAcquireResult, String> {\n    db.try_acquire_or_renew_wake_claim(wake_claim_request(input, claim_token), input.renew_token)\n}\n\nfn wake_claim_request<'a>(input: StartWakeInput<'a>, claim_token: &'a str) -> WakeClaimRequest<'a> {\n    WakeClaimRequest {\n        session_id: input.session_id,\n        claim_token,\n        reason: input.reason,\n        auto_wake_count: input.auto_wake_count,\n        wake_invocation_uuid: None,\n        stale_after_seconds: WAKE_CLAIM_STALE_AFTER_SECONDS,\n    }\n}\n\nfn already_in_flight_diagnostic(claim: WakeClaimRow) -> WakeDiagnostic {\n    let mut diagnostic = WakeDiagnostic::status(\"already_in_flight\");\n    diagnostic.claim_token = Some(claim.claim_token);\n    diagnostic.wake_pid = claim.wake_pid;\n    diagnostic.auto_wake_count = Some(claim.auto_wake_count);\n    diagnostic\n}\n\nfn record_wake_pid_or_warn(\n    db: &mut MailboxDb,\n    session_id: &str,\n    claim_token: &str,\n    wake_pid: i64,\n    runtime: Option<&SessionRuntimeRow>,\n) {\n    let provider_name = runtime.and_then(|row| row.provider_name.as_deref());\n    let model_name = runtime.and_then(|row| row.model_name.as_deref());\n    if let Err(err) = db.record_wake_claim_pid_identity(\n        session_id,\n        claim_token,\n        wake_pid,\n        provider_name,\n        model_name,\n    ) {\n        tracing::warn!(session_id, claim_token, \"Failed to record wake PID: {err}\");\n    }\n}\n\nfn spawned_wake_diagnostic(\n    claim_token: String,\n    wake_pid: i64,\n    auto_wake_count: i64,\n) -> WakeDiagnostic {\n    WakeDiagnostic {\n        attempted: true,\n        status: \"spawned\".to_string(),\n        claim_token: Some(claim_token),\n        wake_pid: Some(wake_pid),\n        auto_wake_count: Some(auto_wake_count),\n        message: None,\n    }\n}\n\nfn spawn_error_diagnostic(\n    claim_token: String,\n    auto_wake_count: i64,\n    err: String,\n) -> WakeDiagnostic {\n    WakeDiagnostic {\n        attempted: true,\n        status: \"spawn_error\".to_string(),\n        claim_token: Some(claim_token),\n        wake_pid: None,\n        auto_wake_count: Some(auto_wake_count),\n        message: Some(err),\n    }\n}\n\nfn spawn_detached_resume(\n    session_id: &str,\n    runtime: Option<&SessionRuntimeRow>,\n    claim_token: &str,\n    auto_wake_count: i64,\n) -> Result<i64, String> {\n    let exe = current_agents_exe()?;\n    let cmd = detached_resume_command(exe, session_id, runtime, claim_token, auto_wake_count);\n    spawn_detached_child(cmd)\n}\n\nfn current_agents_exe() -> Result<PathBuf, String> {\n    std::env::current_exe().map_err(current_agents_exe_error)\n}\n\nfn current_agents_exe_error(err: std::io::Error) -> String {\n    format!(\"Failed to resolve current agents binary: {err}\")\n}\n\nfn spawn_detached_child(mut cmd: Command) -> Result<i64, String> {\n    cmd.spawn().map(child_pid).map_err(detached_spawn_error)\n}\n\nfn child_pid(child: Child) -> i64 {\n    i64::from(child.id())\n}\n\nfn detached_spawn_error(err: std::io::Error) -> String {\n    format!(\"Failed to spawn detached wake resume: {err}\")\n}\n\nfn detached_resume_command(\n    exe: PathBuf,\n    session_id: &str,\n    runtime: Option<&SessionRuntimeRow>,\n    claim_token: &str,\n    auto_wake_count: i64,\n) -> Command {\n    let mut cmd = Command::new(exe);\n    configure_resume_args(&mut cmd, session_id, runtime);\n    configure_wake_stdio_and_env(&mut cmd, session_id, claim_token, auto_wake_count);\n    configure_detached(&mut cmd);\n    cmd\n}\n\nfn configure_resume_args(cmd: &mut Command, session_id: &str, runtime: Option<&SessionRuntimeRow>) {\n    cmd.arg(\"resume\").arg(\"--session-id\").arg(session_id);\n    append_non_empty_arg(cmd, \"-m\", runtime.and_then(|row| row.model_name.as_deref()));\n    append_non_empty_arg(\n        cmd,\n        \"--models-dir\",\n        runtime.and_then(|row| row.models_dir.as_deref()),\n    );\n}\n\nfn append_non_empty_arg(cmd: &mut Command, flag: &str, value: Option<&str>) {\n    let Some(value) = value.filter(|value| !value.is_empty()) else {\n        return;\n    };\n    cmd.arg(flag).arg(value);\n}\n\nfn configure_wake_stdio_and_env(\n    cmd: &mut Command,\n    session_id: &str,\n    claim_token: &str,\n    auto_wake_count: i64,\n) {\n    cmd.stdin(Stdio::null())\n        .stdout(Stdio::null())\n        .stderr(Stdio::null())\n        .env(AUTO_WAKE_ENV, \"1\")\n        .env(AUTO_WAKE_SESSION_ID_ENV, session_id)\n        .env(AUTO_WAKE_TOKEN_ENV, claim_token)\n        .env(AUTO_WAKE_COUNT_ENV, auto_wake_count.to_string())\n        .env_remove(PARENT_INVOCATION_ENV);\n}\n\n#[cfg(unix)]\nfn configure_detached(cmd: &mut Command) {\n    unsafe {\n        cmd.pre_exec(|| {\n            if libc::setsid() == -1 {\n                return Err(std::io::Error::last_os_error());\n            }\n            Ok(())\n        });\n    }\n}\n\n#[cfg(not(unix))]\nfn configure_detached(_cmd: &mut Command) {}\n\nfn pending_count(session_id: &str) -> Result<usize, String> {\n    crate::mailbox_delivery::deliverable_pending_count(session_id)\n}\n\nfn current_auto_wake() -> Option<AutoWakeEnv> {\n    auto_wake_marker_present()\n        .then(current_auto_wake_env)\n        .flatten()\n}\n\nfn auto_wake_max() -> i64 {\n    validated_auto_wake_max(parsed_auto_wake_max())\n}\n\nfn current_auto_wake_env() -> Option<AutoWakeEnv> {\n    Some(auto_wake_env(auto_wake_token()?, auto_wake_count()))\n}\n\nfn auto_wake_count() -> i64 {\n    parse_auto_wake_count(auto_wake_count_value())\n}\n\nfn parsed_auto_wake_max() -> Option<i64> {\n    parse_auto_wake_max(auto_wake_max_value())\n}\n\nfn auto_wake_token() -> Option<String> {\n    std::env::var(AUTO_WAKE_TOKEN_ENV).ok()\n}\n\nfn auto_wake_count_value() -> Option<String> {\n    std::env::var(AUTO_WAKE_COUNT_ENV).ok()\n}\n\nfn auto_wake_max_value() -> Option<String> {\n    std::env::var(AUTO_WAKE_MAX_ENV).ok()\n}\n\nfn parse_auto_wake_count(value: Option<String>) -> i64 {\n    value.and_then(|value| value.parse().ok()).unwrap_or(1)\n}\n\nfn parse_auto_wake_max(value: Option<String>) -> Option<i64> {\n    value.and_then(|value| value.parse::<i64>().ok())\n}\n\nfn validated_auto_wake_max(value: Option<i64>) -> i64 {\n    value\n        .filter(|value| *value > 0)\n        .unwrap_or(DEFAULT_AUTO_WAKE_MAX)\n}\n\nfn auto_wake_env(token: String, count: i64) -> AutoWakeEnv {\n    AutoWakeEnv { token, count }\n}\n\nfn release_current_auto_wake_claim(session_id: &str, auto_wake: Option<&AutoWakeEnv>) {\n    let Some(auto_wake) = auto_wake else {\n        return;\n    };\n    match MailboxDb::open_default_if_exists() {\n        Ok(Some(mut db)) => release_wake_claim_or_warn(&mut db, session_id, &auto_wake.token),\n        Ok(None) => {}\n        Err(err) => warn_open_sidecar_for_release_failed(session_id, err),\n    }\n}\n\nfn release_wake_claim_or_warn(db: &mut MailboxDb, session_id: &str, token: &str) {\n    if let Err(err) = db.release_wake_claim(session_id, Some(token)) {\n        warn_release_wake_claim_failed(session_id, err);\n    }\n}\n\nfn warn_release_wake_claim_failed(session_id: &str, err: String) {\n    tracing::warn!(session_id, \"Failed to release wake claim: {err}\");\n}\n\nfn warn_open_sidecar_for_release_failed(session_id: &str, err: String) {\n    tracing::warn!(\n        session_id,\n        \"Failed to open sidecar to release wake claim: {err}\"\n    );\n}","lineStart":1,"lineEnd":1149,"totalLines":1149,"truncated":false}},"title":"src-tauri/src/wake_coordinator.rs","time":{"start":1780923316008,"end":1780923316079}},"metadata":{"openai":{"itemId":"fc_0676cb86304500e2016a26bbb3f0148198981ade8212902962"}},"id":"prt_ea74d370d001UDx4WpKFgokrp0","sessionID":"ses_158b3e351ffePkuQnC9kglvomy","messageID":"msg_ea74d17ab001lJna4YkNrsywkk"}}
{"type":"tool_use","timestamp":1780923316092,"sessionID":"ses_158b3e351ffePkuQnC9kglvomy","part":{"type":"tool","tool":"read","callID":"call_9NYh1OhrK3jyIRwLlsq1n9QU","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/dispatch.rs","offset":1,"limit":700},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/dispatch.rs</path>\n<type>file</type>\n<content>\n1: //! Top-level CLI routing and dispatch.\n2: //!\n3: //! ## Declared roles\n4: //!\n5: //! `orchestration`, `parser`, `validator`, `accessor`, `formatter`, `mapper`, `predicate`, `filter`\n6: //!\n7: //! ## Adapter declarations\n8: //!\n9: //! ```yaml\n10: //! adapter_declarations:\n11: //!   - component: src-tauri/src/dispatch.rs::dispatch_to_runtime_services\n12: //!     role: adapter\n13: //!     Translates:\n14: //!       - oulipoly_runtime::services ports and DTOs consumed by CLI dispatch\n15: //!   - component: src-tauri/src/dispatch.rs::dispatch_to_state\n16: //!     role: adapter\n17: //!     Translates:\n18: //!       - oulipoly_state DB, schema, quota, invocation row, session row, acceptance row\n19: //!   - component: src-tauri/src/dispatch.rs::dispatch_to_runtime_modules\n20: //!     role: adapter\n21: //!     Translates:\n22: //!       - oulipoly_runtime modules outside services consumed by CLI dispatch\n23: //! ```\n24: //!\n25: //! ## Intrinsic-surface declarations\n26: //!\n27: //! ```yaml\n28: //! intrinsic_surface_declarations:\n29: //!   - component: src-tauri/src/dispatch.rs\n30: //!     role: intrinsic-surface\n31: //!     Domain: cli_lifecycle_orchestration\n32: //!     Owns:\n33: //!       - lifecycle loops\n34: //!       - run_with_balancing lifecycle loop\n35: //!       - run_resume lifecycle loop\n36: //!       - run_repl lifecycle loop\n37: //!       - top-level --resume dispatch\n38: //!       - invocation finalization sequencing\n39: //!       - terminal signal outcome sequencing\n40: //!       - provider retry and migration sequencing\n41: //!   - component: src-tauri/src/dispatch.rs::pre_invocation_failure_marker\n42: //!     role: intrinsic-surface\n43: //!     Domain: pre_invocation_failure_marker\n44: //!     Owns:\n45: //!       - emit_pre_invocation_failure\n46: //!       - pre_invocation_failure_payload\n47: //!       - pre_invocation_failure_message\n48: //!       - emit_pool_exhausted_pre_invocation_failure\n49: //!       - emit_provider_selection_pre_invocation_failure\n50: //!       - emit_provider_resolution_pre_invocation_failure\n51: //!       - OULIPOLY_FAILURE marker line\n52: //!       - OULIPOLY_FAILURE payload field set\n53: //!       - model_provider_names\n54: //! ```\n55: \n56: use oulipoly_runtime::session_replace;\n57: \n58: use crate::cli::inputs::{TopLevelResumePromptSource, resolve_top_level_resume_prompt_source};\n59: use crate::resume_cli::format_resume_error;\n60: use crate::usage::cli::{\n61:     Cli, MailboxSubcommands, NotifySubcommands, SessionSubcommands, Subcommands,\n62: };\n63: use crate::{commands, run, usage, wiring};\n64: \n65: mod clock;\n66: mod formatter;\n67: mod parent_invocation;\n68: mod parser;\n69: mod pre_invocation_failure;\n70: mod predicate;\n71: mod usage_context;\n72: \n73: pub(crate) use clock::utc_now;\n74: pub(crate) use formatter::format_timestamp_rfc3339;\n75: pub(crate) use parent_invocation::resolve_parent_invocation_id;\n76: pub(crate) use parser::provider_session_marker_uuid;\n77: use parser::resume_target_arg;\n78: pub(crate) use pre_invocation_failure::emit_pre_invocation_failure;\n79: pub(crate) use predicate::{\n80:     diagnostics_model_configured, execution_succeeded, should_emit_resume_short_line,\n81: };\n82: \n83: pub(crate) fn run(cli: Cli) -> Result<i32, String> {\n84:     if let Err(err) = recover_pending_session_replaces() {\n85:         return Ok(handle_pending_session_replace_error(&err));\n86:     }\n87:     if startup_wake_reclaim_sweep_enabled(&cli) {\n88:         crate::wake_coordinator::run_startup_wake_reclaim_sweep();\n89:     }\n90: \n91:     if cli.new {\n92:         return run_default_provider_repl(&cli);\n93:     }\n94: \n95:     let agent_runtime_services = wiring::AgentRuntimeServices::cli_defaults();\n96: \n97:     if cli.usage {\n98:         return run_usage_command(&cli, &agent_runtime_services);\n99:     }\n100: \n101:     if let Some(command) = cli.command.clone() {\n102:         return dispatch_subcommand(command, &agent_runtime_services);\n103:     }\n104: \n105:     if let Some(ref session_id) = cli.resume {\n106:         return dispatch_top_level_resume(&cli, session_id, &agent_runtime_services);\n107:     }\n108: \n109:     if let Some(ref model_name) = cli.model {\n110:         return crate::commands::direct_model::run_direct_model_cli(\n111:             &cli,\n112:             model_name,\n113:             &agent_runtime_services,\n114:         );\n115:     }\n116: \n117:     crate::commands::direct_model::run_agent_cli(&cli, &agent_runtime_services)\n118: }\n119: \n120: fn startup_wake_reclaim_sweep_enabled(cli: &Cli) -> bool {\n121:     if cli.resume.is_some() {\n122:         return false;\n123:     }\n124:     !matches!(\n125:         &cli.command,\n126:         Some(Subcommands::Resume { .. })\n127:             | Some(Subcommands::Repl {\n128:                 resume: Some(_),\n129:                 ..\n130:             })\n131:     )\n132: }\n133: \n134: fn recover_pending_session_replaces() -> Result<(), session_replace::ReplaceError> {\n135:     session_replace::recover_pending_replaces()\n136: }\n137: \n138: fn handle_pending_session_replace_error(err: &session_replace::ReplaceError) -> i32 {\n139:     emit_pending_session_replace_error(err);\n140:     pending_session_replace_exit_code(err)\n141: }\n142: \n143: fn emit_pending_session_replace_error(err: &session_replace::ReplaceError) {\n144:     formatter::emit_stderr_line(&err.to_json().to_string());\n145: }\n146: \n147: fn pending_session_replace_exit_code(err: &session_replace::ReplaceError) -> i32 {\n148:     err.exit_code()\n149: }\n150: \n151: fn run_default_provider_repl(cli: &Cli) -> Result<i32, String> {\n152:     let services =\n153:         oulipoly_runtime::repl_default_provider::RuntimeServices::production(cli.project.clone())?;\n154:     oulipoly_runtime::repl_default_provider::run_repl_with_default_provider(services)\n155: }\n156: \n157: fn run_usage_command(\n158:     cli: &Cli,\n159:     agent_runtime_services: &wiring::AgentRuntimeServices,\n160: ) -> Result<i32, String> {\n161:     let context = usage_context::load_usage_context(cli)?;\n162:     let mut stdout = std::io::stdout().lock();\n163:     usage::dispatch::run_usage(\n164:         agent_runtime_services,\n165:         &context.providers_cfg,\n166:         &context.models,\n167:         &mut stdout,\n168:     )\n169: }\n170: \n171: fn dispatch_subcommand(\n172:     command: Subcommands,\n173:     agent_runtime_services: &wiring::AgentRuntimeServices,\n174: ) -> Result<i32, String> {\n175:     match command {\n176:         Subcommands::Trace {\n177:             invocation_uuid,\n178:             json,\n179:             inline_transcript,\n180:             transcript,\n181:             max_depth,\n182:         } => dispatch_trace_subcommand(\n183:             &invocation_uuid,\n184:             json,\n185:             inline_transcript,\n186:             transcript,\n187:             max_depth,\n188:             agent_runtime_services,\n189:         ),\n190:         Subcommands::Repl {\n191:             model,\n192:             resume,\n193:             rotate_provider,\n194:             project,\n195:             models_dir,\n196:         } => run::run_repl(\n197:             agent_runtime_services,\n198:             model.as_deref(),\n199:             resume.as_deref(),\n200:             rotate_provider.as_deref(),\n201:             project.as_deref(),\n202:             models_dir.as_deref(),\n203:         ),\n204:         Subcommands::Resume {\n205:             model,\n206:             session_id,\n207:             chain_id,\n208:             rotate_provider,\n209:             prompt,\n210:             file,\n211:             project,\n212:             models_dir,\n213:         } => dispatch_resume_subcommand(\n214:             ResumeDispatchArgs {\n215:                 model: model.as_deref(),\n216:                 session_id: session_id.as_deref(),\n217:                 chain_id: chain_id.as_deref(),\n218:                 rotate_provider: rotate_provider.as_deref(),\n219:                 prompt: prompt.as_deref(),\n220:                 file: file.as_deref(),\n221:                 project: project.as_deref(),\n222:                 models_dir: models_dir.as_deref(),\n223:             },\n224:             agent_runtime_services,\n225:         ),\n226:         Subcommands::Session { command } => {\n227:             dispatch_session_subcommand(command, agent_runtime_services)\n228:         }\n229:         Subcommands::Notify { command } => dispatch_notify_subcommand(command),\n230:         Subcommands::Mailbox { command } => dispatch_mailbox_subcommand(command),\n231:         Subcommands::ResumeList { uuid } => crate::commands::resume_list::run_resume_list(&uuid),\n232:         Subcommands::MigrateDb => commands::migrate::run_migrate_db(),\n233:         Subcommands::Migrate { rebuild } => commands::migrate::run_migrate(rebuild),\n234:         Subcommands::MigrateConfig { models_dir } => {\n235:             commands::config_migration::run_migrate_config(models_dir.as_deref())\n236:         }\n237:     }\n238: }\n239: \n240: fn dispatch_notify_subcommand(command: NotifySubcommands) -> Result<i32, String> {\n241:     match command {\n242:         NotifySubcommands::AgentBashComplete {\n243:             caller_ppid,\n244:             handle,\n245:             state_dir,\n246:             meta,\n247:             log,\n248:             rc,\n249:             json,\n250:         } => crate::commands::notify::run_agent_bash_complete(\n251:             crate::commands::notify::AgentBashCompleteArgs {\n252:                 caller_ppid,\n253:                 handle: &handle,\n254:                 state_dir: &state_dir,\n255:                 meta: &meta,\n256:                 log: &log,\n257:                 rc: &rc,\n258:                 json,\n259:             },\n260:         ),\n261:     }\n262: }\n263: \n264: fn dispatch_mailbox_subcommand(command: MailboxSubcommands) -> Result<i32, String> {\n265:     match command {\n266:         MailboxSubcommands::List {\n267:             session_id,\n268:             all,\n269:             json,\n270:         } => crate::commands::mailbox::run_list(&session_id, all, json),\n271:     }\n272: }\n273: \n274: fn dispatch_trace_subcommand(\n275:     invocation_uuid: &str,\n276:     json: bool,\n277:     inline_transcript: bool,\n278:     transcript: bool,\n279:     max_depth: usize,\n280:     agent_runtime_services: &wiring::AgentRuntimeServices,\n281: ) -> Result<i32, String> {\n282:     commands::trace::run_trace_command(\n283:         commands::trace::trace_options(max_depth, json, inline_transcript, transcript),\n284:         invocation_uuid,\n285:         agent_runtime_services,\n286:     )\n287: }\n288: \n289: struct ResumeDispatchArgs<'a> {\n290:     model: Option<&'a str>,\n291:     session_id: Option<&'a str>,\n292:     chain_id: Option<&'a str>,\n293:     rotate_provider: Option<&'a str>,\n294:     prompt: Option<&'a str>,\n295:     file: Option<&'a std::path::Path>,\n296:     project: Option<&'a std::path::Path>,\n297:     models_dir: Option<&'a std::path::Path>,\n298: }\n299: \n300: fn dispatch_resume_subcommand(\n301:     args: ResumeDispatchArgs<'_>,\n302:     agent_runtime_services: &wiring::AgentRuntimeServices,\n303: ) -> Result<i32, String> {\n304:     run::run_resume(\n305:         agent_runtime_services,\n306:         args.model,\n307:         resume_target_arg(args.session_id, args.chain_id),\n308:         args.rotate_provider,\n309:         args.prompt,\n310:         args.file,\n311:         args.project,\n312:         args.models_dir,\n313:     )\n314: }\n315: \n316: fn dispatch_session_subcommand(\n317:     command: SessionSubcommands,\n318:     agent_runtime_services: &wiring::AgentRuntimeServices,\n319: ) -> Result<i32, String> {\n320:     match command {\n321:         SessionSubcommands::Locate { session_id, json } => {\n322:             dispatch_session_locate_subcommand(&session_id, json)\n323:         }\n324:         SessionSubcommands::SchemaProbe => {\n325:             crate::commands::schema_probe::run_session_schema_probe()\n326:         }\n327:         SessionSubcommands::Export { session_id, format } => {\n328:             dispatch_session_export_subcommand(&session_id, &format, agent_runtime_services)\n329:         }\n330:         SessionSubcommands::PauseHandshake { session_id, ttl_ms } => {\n331:             crate::commands::handshake::run_pause_handshake(\n332:                 &session_id,\n333:                 ttl_ms,\n334:                 agent_runtime_services,\n335:             )\n336:         }\n337:         SessionSubcommands::OfPid { pid, json } => {\n338:             crate::commands::pid_session::run_of_pid(pid, json)\n339:         }\n340:         SessionSubcommands::Alive { pid, json } => {\n341:             crate::commands::pid_session::run_alive(pid, json)\n342:         }\n343:         SessionSubcommands::Subtree {\n344:             pid,\n345:             json,\n346:             max_depth,\n347:         } => crate::commands::pid_session::run_subtree(pid, json, max_depth),\n348:         SessionSubcommands::ResumeHandshake { session_id, token } => {\n349:             crate::commands::handshake::run_resume_handshake(\n350:                 &session_id,\n351:                 &token,\n352:                 agent_runtime_services,\n353:             )\n354:         }\n355:         SessionSubcommands::ImportReplace {\n356:             session_id,\n357:             from_file,\n358:             preimage_sha256,\n359:         } => crate::commands::session_import_replace::run_session_import_replace(\n360:             &session_id,\n361:             from_file.as_deref(),\n362:             preimage_sha256.as_deref(),\n363:             agent_runtime_services,\n364:         ),\n365:     }\n366: }\n367: \n368: fn dispatch_session_locate_subcommand(session_id: &str, json: bool) -> Result<i32, String> {\n369:     commands::session_locate_export::run_session_locate(session_id, json)\n370: }\n371: \n372: fn dispatch_session_export_subcommand(\n373:     session_id: &str,\n374:     format: &str,\n375:     agent_runtime_services: &wiring::AgentRuntimeServices,\n376: ) -> Result<i32, String> {\n377:     commands::session_locate_export::run_session_export(session_id, format, agent_runtime_services)\n378: }\n379: \n380: fn dispatch_top_level_resume(\n381:     cli: &Cli,\n382:     session_id: &str,\n383:     agent_runtime_services: &wiring::AgentRuntimeServices,\n384: ) -> Result<i32, String> {\n385:     validate_top_level_resume_cli(cli)?;\n386:     match resolve_top_level_resume_prompt_source(cli)? {\n387:         TopLevelResumePromptSource::Headless {\n388:             positional_or_stdin_prompt,\n389:         } => dispatch_headless_top_level_resume(\n390:             cli,\n391:             session_id,\n392:             positional_or_stdin_prompt.as_deref(),\n393:             agent_runtime_services,\n394:         ),\n395:         TopLevelResumePromptSource::Interactive => {\n396:             dispatch_interactive_top_level_resume(cli, session_id, agent_runtime_services)\n397:         }\n398:     }\n399: }\n400: \n401: fn dispatch_headless_top_level_resume(\n402:     cli: &Cli,\n403:     session_id: &str,\n404:     positional_or_stdin_prompt: Option<&str>,\n405:     agent_runtime_services: &wiring::AgentRuntimeServices,\n406: ) -> Result<i32, String> {\n407:     run::run_resume(\n408:         agent_runtime_services,\n409:         cli.model.as_deref(),\n410:         session_id,\n411:         cli.rotate_provider.as_deref(),\n412:         positional_or_stdin_prompt,\n413:         cli.file.as_deref(),\n414:         cli.project.as_deref(),\n415:         cli.models_dir.as_deref(),\n416:     )\n417: }\n418: \n419: fn dispatch_interactive_top_level_resume(\n420:     cli: &Cli,\n421:     session_id: &str,\n422:     agent_runtime_services: &wiring::AgentRuntimeServices,\n423: ) -> Result<i32, String> {\n424:     run::run_repl(\n425:         agent_runtime_services,\n426:         cli.model.as_deref(),\n427:         Some(session_id),\n428:         cli.rotate_provider.as_deref(),\n429:         cli.project.as_deref(),\n430:         cli.models_dir.as_deref(),\n431:     )\n432: }\n433: \n434: fn validate_top_level_resume_cli(cli: &Cli) -> Result<(), String> {\n435:     if cli.agent_file.is_some() {\n436:         Err(formatter::format_resume_agent_file_incompatible_error())\n437:     } else {\n438:         Ok(())\n439:     }\n440: }\n441: \n442: pub(crate) fn render_resume_error(error: oulipoly_state::ResumeError) {\n443:     formatter::emit_stderr_line(&format_resume_error(error));\n444: }\n445: \n446: pub(crate) fn resume_session_mismatch_category() -> String {\n447:     oulipoly_runtime::diagnostics::ErrorCategory::ResumeSessionMismatch\n448:         .as_str()\n449:         .to_string()\n450: }\n451: \n452: pub(crate) fn diagnose_execution_error(\n453:     agent_runtime_services: &wiring::AgentRuntimeServices,\n454:     result: &oulipoly_runtime::executor::ExecutionResult,\n455:     models: &std::collections::HashMap<String, oulipoly_config::ModelConfig>,\n456:     working_dir: Option<&std::path::Path>,\n457: ) -> Option<String> {\n458:     let input = crate::redaction::diagnostic_input(&result.stderr, &result.stdout);\n459:     crate::commands::diagnostics::run_diagnostics(\n460:         agent_runtime_services,\n461:         &input,\n462:         result.exit_code,\n463:         models,\n464:         working_dir,\n465:     )\n466: }\n467: \n468: #[cfg(test)]\n469: mod tests {\n470:     use super::*;\n471:     use clap::Parser;\n472:     use oulipoly_state::{CompositeInvocationId, InvocationStart, StateDb};\n473:     use std::panic::{AssertUnwindSafe, catch_unwind};\n474:     use std::path::{Path, PathBuf};\n475:     use std::sync::{Mutex, OnceLock};\n476:     use uuid::Uuid;\n477: \n478:     const REPL_MODEL: &str = \"fixture-model\";\n479: \n480:     trait ResumeSessionField {\n481:         fn as_optional_str(&self) -> Option<&str>;\n482:     }\n483: \n484:     impl ResumeSessionField for String {\n485:         fn as_optional_str(&self) -> Option<&str> {\n486:             Some(self.as_str())\n487:         }\n488:     }\n489: \n490:     impl ResumeSessionField for Option<String> {\n491:         fn as_optional_str(&self) -> Option<&str> {\n492:             self.as_deref()\n493:         }\n494:     }\n495: \n496:     fn resume_session_field_as_deref(field: &impl ResumeSessionField) -> Option<&str> {\n497:         field.as_optional_str()\n498:     }\n499: \n500:     fn parse_resume_subcommand<const N: usize>(argv: [&str; N]) -> Subcommands {\n501:         Cli::try_parse_from(argv)\n502:             .unwrap()\n503:             .command\n504:             .expect(\"resume argv should produce a subcommand\")\n505:     }\n506: \n507:     fn assert_resume_debug_contains_option_field(\n508:         command: Subcommands,\n509:         field_name: &str,\n510:         expected: &str,\n511:     ) {\n512:         assert_resume_subcommand(&command);\n513: \n514:         let rendered = render_subcommand_debug(&command);\n515:         let expected_fragment = expected_option_field_fragment(field_name, expected);\n516:         assert!(\n517:             rendered.contains(&expected_fragment),\n518:             \"expected `{expected_fragment}` in parsed Resume variant: {rendered}\"\n519:         );\n520:     }\n521: \n522:     fn assert_resume_subcommand(command: &Subcommands) {\n523:         match command {\n524:             Subcommands::Resume { .. } => {}\n525:             _ => panic!(\"expected resume subcommand\"),\n526:         }\n527:     }\n528: \n529:     fn render_subcommand_debug(command: &Subcommands) -> String {\n530:         format!(\"{command:?}\")\n531:     }\n532: \n533:     fn expected_option_field_fragment(field_name: &str, expected: &str) -> String {\n534:         format!(\"{field_name}: Some(\\\"{expected}\\\")\")\n535:     }\n536: \n537:     fn env_lock() -> &'static Mutex<()> {\n538:         static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n539:         LOCK.get_or_init(|| Mutex::new(()))\n540:     }\n541: \n542:     fn with_parent_invocation_env(value: Option<&str>, test: impl FnOnce()) {\n543:         let _guard = env_lock().lock().unwrap();\n544:         let previous = read_parent_invocation_env();\n545:         set_parent_invocation_env(value);\n546: \n547:         let result = catch_unwind(AssertUnwindSafe(test));\n548: \n549:         restore_parent_invocation_env(previous);\n550: \n551:         if let Err(payload) = result {\n552:             std::panic::resume_unwind(payload);\n553:         }\n554:     }\n555: \n556:     fn read_parent_invocation_env() -> Option<std::ffi::OsString> {\n557:         std::env::var_os(\"OULIPOLY_PARENT_INVOCATION\")\n558:     }\n559: \n560:     fn set_parent_invocation_env(value: Option<&str>) {\n561:         match value {\n562:             Some(value) => set_parent_invocation_env_value(value),\n563:             None => remove_parent_invocation_env(),\n564:         }\n565:     }\n566: \n567:     fn restore_parent_invocation_env(value: Option<std::ffi::OsString>) {\n568:         match value {\n569:             Some(value) => set_parent_invocation_env_os_value(value),\n570:             None => remove_parent_invocation_env(),\n571:         }\n572:     }\n573: \n574:     fn set_parent_invocation_env_value(value: &str) {\n575:         unsafe {\n576:             std::env::set_var(\"OULIPOLY_PARENT_INVOCATION\", value);\n577:         }\n578:     }\n579: \n580:     fn set_parent_invocation_env_os_value(value: std::ffi::OsString) {\n581:         unsafe {\n582:             std::env::set_var(\"OULIPOLY_PARENT_INVOCATION\", value);\n583:         }\n584:     }\n585: \n586:     fn remove_parent_invocation_env() {\n587:         unsafe {\n588:             std::env::remove_var(\"OULIPOLY_PARENT_INVOCATION\");\n589:         }\n590:     }\n591: \n592:     fn test_db() -> StateDb {\n593:         open_test_db(Path::new(\":memory:\"))\n594:     }\n595: \n596:     fn open_test_db(path: &Path) -> StateDb {\n597:         StateDb::open(path).unwrap()\n598:     }\n599: \n600:     #[test]\n601:     fn no_subcommand_still_parses_existing_model_flow() {\n602:         // `agent` is the first positional in `Cli`, so a single bare arg\n603:         // (`ping`) lands there — `prompt_args` only captures any *additional*\n604:         // trailing args. The existing `collect_positional_prompt(_, true)`\n605:         // path joins agent + prompt_args, so the runtime prompt still\n606:         // becomes \"ping\". Exercised end-to-end by the integration test\n607:         // `default_cli_flow_still_runs_without_subcommand`.\n608:         let cli =\n609:             Cli::try_parse_from([\"oulipoly-agent-runner\", \"--model\", \"fixture\", \"ping\"]).unwrap();\n610: \n611:         assert!(cli.command.is_none());\n612:         assert_eq!(cli.model.as_deref(), Some(\"fixture\"));\n613:         assert_eq!(cli.agent.as_deref(), Some(\"ping\"));\n614:         assert!(cli.prompt_args.is_empty());\n615: \n616:         // Two trailing args: the first goes to `agent`, the rest into\n617:         // `prompt_args`. This is the existing PR-A behavior preserved\n618:         // under subcommand dispatch.\n619:         let cli = Cli::try_parse_from([\n620:             \"oulipoly-agent-runner\",\n621:             \"--model\",\n622:             \"fixture\",\n623:             \"ping\",\n624:             \"pong\",\n625:         ])\n626:         .unwrap();\n627:         assert_eq!(cli.agent.as_deref(), Some(\"ping\"));\n628:         assert_eq!(cli.prompt_args, vec![\"pong\"]);\n629:     }\n630: \n631:     #[test]\n632:     fn parser_accepts_long_new() {\n633:         let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"--new\"]).unwrap();\n634: \n635:         assert!(cli.new);\n636:         assert!(cli.command.is_none());\n637:         assert!(cli.agent.is_none());\n638:         assert!(cli.prompt_args.is_empty());\n639:         assert!(cli.model.is_none());\n640:         assert!(cli.resume.is_none());\n641:     }\n642: \n643:     #[test]\n644:     fn parser_accepts_short_n() {\n645:         let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"-n\"]).unwrap();\n646: \n647:         assert!(cli.new);\n648:         assert!(cli.command.is_none());\n649:         assert!(cli.agent.is_none());\n650:         assert!(cli.prompt_args.is_empty());\n651:         assert!(cli.model.is_none());\n652:         assert!(cli.resume.is_none());\n653:     }\n654: \n655:     #[test]\n656:     fn parser_rejects_resume_then_new() {\n657:         let err = match Cli::try_parse_from([\n658:             \"oulipoly-agent-runner\",\n659:             \"--resume\",\n660:             \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n661:             \"--new\",\n662:         ]) {\n663:             Ok(_) => panic!(\"--resume and --new should conflict\"),\n664:             Err(err) => err,\n665:         };\n666: \n667:         assert_eq!(err.kind(), clap::error::ErrorKind::ArgumentConflict);\n668:         let rendered = err.to_string();\n669:         assert!(rendered.contains(\"--resume\"), \"{rendered}\");\n670:         assert!(rendered.contains(\"--new\"), \"{rendered}\");\n671:     }\n672: \n673:     #[test]\n674:     fn parser_rejects_new_then_resume() {\n675:         let err = match Cli::try_parse_from([\n676:             \"oulipoly-agent-runner\",\n677:             \"--new\",\n678:             \"--resume\",\n679:             \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n680:         ]) {\n681:             Ok(_) => panic!(\"--new and --resume should conflict\"),\n682:             Err(err) => err,\n683:         };\n684: \n685:         assert_eq!(err.kind(), clap::error::ErrorKind::ArgumentConflict);\n686:         let rendered = err.to_string();\n687:         assert!(rendered.contains(\"--new\"), \"{rendered}\");\n688:         assert!(rendered.contains(\"--resume\"), \"{rendered}\");\n689:     }\n690: \n691:     #[test]\n692:     fn repl_subcommand_parses_required_model_without_optional_paths() {\n693:         let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"repl\", REPL_MODEL]).unwrap();\n694: \n695:         match cli.command {\n696:             Some(Subcommands::Repl {\n697:                 model,\n698:                 resume,\n699:                 rotate_provider: _,\n700:                 project,\n\n(Showing lines 1-700 of 1106. Use offset=701 to continue.)\n</content>","metadata":{"preview":"//! Top-level CLI routing and dispatch.\n//!\n//! ## Declared roles\n//!\n//! `orchestration`, `parser`, `validator`, `accessor`, `formatter`, `mapper`, `predicate`, `filter`\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_runtime_services\n//!     role: adapter\n//!     Translates:\n//!       - oulipoly_runtime::services ports and DTOs consumed by CLI dispatch\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_state\n//!     role: adapter\n//!     Translates:\n//!       - oulipoly_state DB, schema, quota, invocation row, session row, acceptance row\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_runtime_modules\n//!     role: adapter","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/dispatch.rs","text":"//! Top-level CLI routing and dispatch.\n//!\n//! ## Declared roles\n//!\n//! `orchestration`, `parser`, `validator`, `accessor`, `formatter`, `mapper`, `predicate`, `filter`\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_runtime_services\n//!     role: adapter\n//!     Translates:\n//!       - oulipoly_runtime::services ports and DTOs consumed by CLI dispatch\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_state\n//!     role: adapter\n//!     Translates:\n//!       - oulipoly_state DB, schema, quota, invocation row, session row, acceptance row\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_runtime_modules\n//!     role: adapter\n//!     Translates:\n//!       - oulipoly_runtime modules outside services consumed by CLI dispatch\n//! ```\n//!\n//! ## Intrinsic-surface declarations\n//!\n//! ```yaml\n//! intrinsic_surface_declarations:\n//!   - component: src-tauri/src/dispatch.rs\n//!     role: intrinsic-surface\n//!     Domain: cli_lifecycle_orchestration\n//!     Owns:\n//!       - lifecycle loops\n//!       - run_with_balancing lifecycle loop\n//!       - run_resume lifecycle loop\n//!       - run_repl lifecycle loop\n//!       - top-level --resume dispatch\n//!       - invocation finalization sequencing\n//!       - terminal signal outcome sequencing\n//!       - provider retry and migration sequencing\n//!   - component: src-tauri/src/dispatch.rs::pre_invocation_failure_marker\n//!     role: intrinsic-surface\n//!     Domain: pre_invocation_failure_marker\n//!     Owns:\n//!       - emit_pre_invocation_failure\n//!       - pre_invocation_failure_payload\n//!       - pre_invocation_failure_message\n//!       - emit_pool_exhausted_pre_invocation_failure\n//!       - emit_provider_selection_pre_invocation_failure\n//!       - emit_provider_resolution_pre_invocation_failure\n//!       - OULIPOLY_FAILURE marker line\n//!       - OULIPOLY_FAILURE payload field set\n//!       - model_provider_names\n//! ```\n\nuse oulipoly_runtime::session_replace;\n\nuse crate::cli::inputs::{TopLevelResumePromptSource, resolve_top_level_resume_prompt_source};\nuse crate::resume_cli::format_resume_error;\nuse crate::usage::cli::{\n    Cli, MailboxSubcommands, NotifySubcommands, SessionSubcommands, Subcommands,\n};\nuse crate::{commands, run, usage, wiring};\n\nmod clock;\nmod formatter;\nmod parent_invocation;\nmod parser;\nmod pre_invocation_failure;\nmod predicate;\nmod usage_context;\n\npub(crate) use clock::utc_now;\npub(crate) use formatter::format_timestamp_rfc3339;\npub(crate) use parent_invocation::resolve_parent_invocation_id;\npub(crate) use parser::provider_session_marker_uuid;\nuse parser::resume_target_arg;\npub(crate) use pre_invocation_failure::emit_pre_invocation_failure;\npub(crate) use predicate::{\n    diagnostics_model_configured, execution_succeeded, should_emit_resume_short_line,\n};\n\npub(crate) fn run(cli: Cli) -> Result<i32, String> {\n    if let Err(err) = recover_pending_session_replaces() {\n        return Ok(handle_pending_session_replace_error(&err));\n    }\n    if startup_wake_reclaim_sweep_enabled(&cli) {\n        crate::wake_coordinator::run_startup_wake_reclaim_sweep();\n    }\n\n    if cli.new {\n        return run_default_provider_repl(&cli);\n    }\n\n    let agent_runtime_services = wiring::AgentRuntimeServices::cli_defaults();\n\n    if cli.usage {\n        return run_usage_command(&cli, &agent_runtime_services);\n    }\n\n    if let Some(command) = cli.command.clone() {\n        return dispatch_subcommand(command, &agent_runtime_services);\n    }\n\n    if let Some(ref session_id) = cli.resume {\n        return dispatch_top_level_resume(&cli, session_id, &agent_runtime_services);\n    }\n\n    if let Some(ref model_name) = cli.model {\n        return crate::commands::direct_model::run_direct_model_cli(\n            &cli,\n            model_name,\n            &agent_runtime_services,\n        );\n    }\n\n    crate::commands::direct_model::run_agent_cli(&cli, &agent_runtime_services)\n}\n\nfn startup_wake_reclaim_sweep_enabled(cli: &Cli) -> bool {\n    if cli.resume.is_some() {\n        return false;\n    }\n    !matches!(\n        &cli.command,\n        Some(Subcommands::Resume { .. })\n            | Some(Subcommands::Repl {\n                resume: Some(_),\n                ..\n            })\n    )\n}\n\nfn recover_pending_session_replaces() -> Result<(), session_replace::ReplaceError> {\n    session_replace::recover_pending_replaces()\n}\n\nfn handle_pending_session_replace_error(err: &session_replace::ReplaceError) -> i32 {\n    emit_pending_session_replace_error(err);\n    pending_session_replace_exit_code(err)\n}\n\nfn emit_pending_session_replace_error(err: &session_replace::ReplaceError) {\n    formatter::emit_stderr_line(&err.to_json().to_string());\n}\n\nfn pending_session_replace_exit_code(err: &session_replace::ReplaceError) -> i32 {\n    err.exit_code()\n}\n\nfn run_default_provider_repl(cli: &Cli) -> Result<i32, String> {\n    let services =\n        oulipoly_runtime::repl_default_provider::RuntimeServices::production(cli.project.clone())?;\n    oulipoly_runtime::repl_default_provider::run_repl_with_default_provider(services)\n}\n\nfn run_usage_command(\n    cli: &Cli,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    let context = usage_context::load_usage_context(cli)?;\n    let mut stdout = std::io::stdout().lock();\n    usage::dispatch::run_usage(\n        agent_runtime_services,\n        &context.providers_cfg,\n        &context.models,\n        &mut stdout,\n    )\n}\n\nfn dispatch_subcommand(\n    command: Subcommands,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    match command {\n        Subcommands::Trace {\n            invocation_uuid,\n            json,\n            inline_transcript,\n            transcript,\n            max_depth,\n        } => dispatch_trace_subcommand(\n            &invocation_uuid,\n            json,\n            inline_transcript,\n            transcript,\n            max_depth,\n            agent_runtime_services,\n        ),\n        Subcommands::Repl {\n            model,\n            resume,\n            rotate_provider,\n            project,\n            models_dir,\n        } => run::run_repl(\n            agent_runtime_services,\n            model.as_deref(),\n            resume.as_deref(),\n            rotate_provider.as_deref(),\n            project.as_deref(),\n            models_dir.as_deref(),\n        ),\n        Subcommands::Resume {\n            model,\n            session_id,\n            chain_id,\n            rotate_provider,\n            prompt,\n            file,\n            project,\n            models_dir,\n        } => dispatch_resume_subcommand(\n            ResumeDispatchArgs {\n                model: model.as_deref(),\n                session_id: session_id.as_deref(),\n                chain_id: chain_id.as_deref(),\n                rotate_provider: rotate_provider.as_deref(),\n                prompt: prompt.as_deref(),\n                file: file.as_deref(),\n                project: project.as_deref(),\n                models_dir: models_dir.as_deref(),\n            },\n            agent_runtime_services,\n        ),\n        Subcommands::Session { command } => {\n            dispatch_session_subcommand(command, agent_runtime_services)\n        }\n        Subcommands::Notify { command } => dispatch_notify_subcommand(command),\n        Subcommands::Mailbox { command } => dispatch_mailbox_subcommand(command),\n        Subcommands::ResumeList { uuid } => crate::commands::resume_list::run_resume_list(&uuid),\n        Subcommands::MigrateDb => commands::migrate::run_migrate_db(),\n        Subcommands::Migrate { rebuild } => commands::migrate::run_migrate(rebuild),\n        Subcommands::MigrateConfig { models_dir } => {\n            commands::config_migration::run_migrate_config(models_dir.as_deref())\n        }\n    }\n}\n\nfn dispatch_notify_subcommand(command: NotifySubcommands) -> Result<i32, String> {\n    match command {\n        NotifySubcommands::AgentBashComplete {\n            caller_ppid,\n            handle,\n            state_dir,\n            meta,\n            log,\n            rc,\n            json,\n        } => crate::commands::notify::run_agent_bash_complete(\n            crate::commands::notify::AgentBashCompleteArgs {\n                caller_ppid,\n                handle: &handle,\n                state_dir: &state_dir,\n                meta: &meta,\n                log: &log,\n                rc: &rc,\n                json,\n            },\n        ),\n    }\n}\n\nfn dispatch_mailbox_subcommand(command: MailboxSubcommands) -> Result<i32, String> {\n    match command {\n        MailboxSubcommands::List {\n            session_id,\n            all,\n            json,\n        } => crate::commands::mailbox::run_list(&session_id, all, json),\n    }\n}\n\nfn dispatch_trace_subcommand(\n    invocation_uuid: &str,\n    json: bool,\n    inline_transcript: bool,\n    transcript: bool,\n    max_depth: usize,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    commands::trace::run_trace_command(\n        commands::trace::trace_options(max_depth, json, inline_transcript, transcript),\n        invocation_uuid,\n        agent_runtime_services,\n    )\n}\n\nstruct ResumeDispatchArgs<'a> {\n    model: Option<&'a str>,\n    session_id: Option<&'a str>,\n    chain_id: Option<&'a str>,\n    rotate_provider: Option<&'a str>,\n    prompt: Option<&'a str>,\n    file: Option<&'a std::path::Path>,\n    project: Option<&'a std::path::Path>,\n    models_dir: Option<&'a std::path::Path>,\n}\n\nfn dispatch_resume_subcommand(\n    args: ResumeDispatchArgs<'_>,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    run::run_resume(\n        agent_runtime_services,\n        args.model,\n        resume_target_arg(args.session_id, args.chain_id),\n        args.rotate_provider,\n        args.prompt,\n        args.file,\n        args.project,\n        args.models_dir,\n    )\n}\n\nfn dispatch_session_subcommand(\n    command: SessionSubcommands,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    match command {\n        SessionSubcommands::Locate { session_id, json } => {\n            dispatch_session_locate_subcommand(&session_id, json)\n        }\n        SessionSubcommands::SchemaProbe => {\n            crate::commands::schema_probe::run_session_schema_probe()\n        }\n        SessionSubcommands::Export { session_id, format } => {\n            dispatch_session_export_subcommand(&session_id, &format, agent_runtime_services)\n        }\n        SessionSubcommands::PauseHandshake { session_id, ttl_ms } => {\n            crate::commands::handshake::run_pause_handshake(\n                &session_id,\n                ttl_ms,\n                agent_runtime_services,\n            )\n        }\n        SessionSubcommands::OfPid { pid, json } => {\n            crate::commands::pid_session::run_of_pid(pid, json)\n        }\n        SessionSubcommands::Alive { pid, json } => {\n            crate::commands::pid_session::run_alive(pid, json)\n        }\n        SessionSubcommands::Subtree {\n            pid,\n            json,\n            max_depth,\n        } => crate::commands::pid_session::run_subtree(pid, json, max_depth),\n        SessionSubcommands::ResumeHandshake { session_id, token } => {\n            crate::commands::handshake::run_resume_handshake(\n                &session_id,\n                &token,\n                agent_runtime_services,\n            )\n        }\n        SessionSubcommands::ImportReplace {\n            session_id,\n            from_file,\n            preimage_sha256,\n        } => crate::commands::session_import_replace::run_session_import_replace(\n            &session_id,\n            from_file.as_deref(),\n            preimage_sha256.as_deref(),\n            agent_runtime_services,\n        ),\n    }\n}\n\nfn dispatch_session_locate_subcommand(session_id: &str, json: bool) -> Result<i32, String> {\n    commands::session_locate_export::run_session_locate(session_id, json)\n}\n\nfn dispatch_session_export_subcommand(\n    session_id: &str,\n    format: &str,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    commands::session_locate_export::run_session_export(session_id, format, agent_runtime_services)\n}\n\nfn dispatch_top_level_resume(\n    cli: &Cli,\n    session_id: &str,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    validate_top_level_resume_cli(cli)?;\n    match resolve_top_level_resume_prompt_source(cli)? {\n        TopLevelResumePromptSource::Headless {\n            positional_or_stdin_prompt,\n        } => dispatch_headless_top_level_resume(\n            cli,\n            session_id,\n            positional_or_stdin_prompt.as_deref(),\n            agent_runtime_services,\n        ),\n        TopLevelResumePromptSource::Interactive => {\n            dispatch_interactive_top_level_resume(cli, session_id, agent_runtime_services)\n        }\n    }\n}\n\nfn dispatch_headless_top_level_resume(\n    cli: &Cli,\n    session_id: &str,\n    positional_or_stdin_prompt: Option<&str>,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    run::run_resume(\n        agent_runtime_services,\n        cli.model.as_deref(),\n        session_id,\n        cli.rotate_provider.as_deref(),\n        positional_or_stdin_prompt,\n        cli.file.as_deref(),\n        cli.project.as_deref(),\n        cli.models_dir.as_deref(),\n    )\n}\n\nfn dispatch_interactive_top_level_resume(\n    cli: &Cli,\n    session_id: &str,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    run::run_repl(\n        agent_runtime_services,\n        cli.model.as_deref(),\n        Some(session_id),\n        cli.rotate_provider.as_deref(),\n        cli.project.as_deref(),\n        cli.models_dir.as_deref(),\n    )\n}\n\nfn validate_top_level_resume_cli(cli: &Cli) -> Result<(), String> {\n    if cli.agent_file.is_some() {\n        Err(formatter::format_resume_agent_file_incompatible_error())\n    } else {\n        Ok(())\n    }\n}\n\npub(crate) fn render_resume_error(error: oulipoly_state::ResumeError) {\n    formatter::emit_stderr_line(&format_resume_error(error));\n}\n\npub(crate) fn resume_session_mismatch_category() -> String {\n    oulipoly_runtime::diagnostics::ErrorCategory::ResumeSessionMismatch\n        .as_str()\n        .to_string()\n}\n\npub(crate) fn diagnose_execution_error(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    result: &oulipoly_runtime::executor::ExecutionResult,\n    models: &std::collections::HashMap<String, oulipoly_config::ModelConfig>,\n    working_dir: Option<&std::path::Path>,\n) -> Option<String> {\n    let input = crate::redaction::diagnostic_input(&result.stderr, &result.stdout);\n    crate::commands::diagnostics::run_diagnostics(\n        agent_runtime_services,\n        &input,\n        result.exit_code,\n        models,\n        working_dir,\n    )\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use clap::Parser;\n    use oulipoly_state::{CompositeInvocationId, InvocationStart, StateDb};\n    use std::panic::{AssertUnwindSafe, catch_unwind};\n    use std::path::{Path, PathBuf};\n    use std::sync::{Mutex, OnceLock};\n    use uuid::Uuid;\n\n    const REPL_MODEL: &str = \"fixture-model\";\n\n    trait ResumeSessionField {\n        fn as_optional_str(&self) -> Option<&str>;\n    }\n\n    impl ResumeSessionField for String {\n        fn as_optional_str(&self) -> Option<&str> {\n            Some(self.as_str())\n        }\n    }\n\n    impl ResumeSessionField for Option<String> {\n        fn as_optional_str(&self) -> Option<&str> {\n            self.as_deref()\n        }\n    }\n\n    fn resume_session_field_as_deref(field: &impl ResumeSessionField) -> Option<&str> {\n        field.as_optional_str()\n    }\n\n    fn parse_resume_subcommand<const N: usize>(argv: [&str; N]) -> Subcommands {\n        Cli::try_parse_from(argv)\n            .unwrap()\n            .command\n            .expect(\"resume argv should produce a subcommand\")\n    }\n\n    fn assert_resume_debug_contains_option_field(\n        command: Subcommands,\n        field_name: &str,\n        expected: &str,\n    ) {\n        assert_resume_subcommand(&command);\n\n        let rendered = render_subcommand_debug(&command);\n        let expected_fragment = expected_option_field_fragment(field_name, expected);\n        assert!(\n            rendered.contains(&expected_fragment),\n            \"expected `{expected_fragment}` in parsed Resume variant: {rendered}\"\n        );\n    }\n\n    fn assert_resume_subcommand(command: &Subcommands) {\n        match command {\n            Subcommands::Resume { .. } => {}\n            _ => panic!(\"expected resume subcommand\"),\n        }\n    }\n\n    fn render_subcommand_debug(command: &Subcommands) -> String {\n        format!(\"{command:?}\")\n    }\n\n    fn expected_option_field_fragment(field_name: &str, expected: &str) -> String {\n        format!(\"{field_name}: Some(\\\"{expected}\\\")\")\n    }\n\n    fn env_lock() -> &'static Mutex<()> {\n        static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n        LOCK.get_or_init(|| Mutex::new(()))\n    }\n\n    fn with_parent_invocation_env(value: Option<&str>, test: impl FnOnce()) {\n        let _guard = env_lock().lock().unwrap();\n        let previous = read_parent_invocation_env();\n        set_parent_invocation_env(value);\n\n        let result = catch_unwind(AssertUnwindSafe(test));\n\n        restore_parent_invocation_env(previous);\n\n        if let Err(payload) = result {\n            std::panic::resume_unwind(payload);\n        }\n    }\n\n    fn read_parent_invocation_env() -> Option<std::ffi::OsString> {\n        std::env::var_os(\"OULIPOLY_PARENT_INVOCATION\")\n    }\n\n    fn set_parent_invocation_env(value: Option<&str>) {\n        match value {\n            Some(value) => set_parent_invocation_env_value(value),\n            None => remove_parent_invocation_env(),\n        }\n    }\n\n    fn restore_parent_invocation_env(value: Option<std::ffi::OsString>) {\n        match value {\n            Some(value) => set_parent_invocation_env_os_value(value),\n            None => remove_parent_invocation_env(),\n        }\n    }\n\n    fn set_parent_invocation_env_value(value: &str) {\n        unsafe {\n            std::env::set_var(\"OULIPOLY_PARENT_INVOCATION\", value);\n        }\n    }\n\n    fn set_parent_invocation_env_os_value(value: std::ffi::OsString) {\n        unsafe {\n            std::env::set_var(\"OULIPOLY_PARENT_INVOCATION\", value);\n        }\n    }\n\n    fn remove_parent_invocation_env() {\n        unsafe {\n            std::env::remove_var(\"OULIPOLY_PARENT_INVOCATION\");\n        }\n    }\n\n    fn test_db() -> StateDb {\n        open_test_db(Path::new(\":memory:\"))\n    }\n\n    fn open_test_db(path: &Path) -> StateDb {\n        StateDb::open(path).unwrap()\n    }\n\n    #[test]\n    fn no_subcommand_still_parses_existing_model_flow() {\n        // `agent` is the first positional in `Cli`, so a single bare arg\n        // (`ping`) lands there — `prompt_args` only captures any *additional*\n        // trailing args. The existing `collect_positional_prompt(_, true)`\n        // path joins agent + prompt_args, so the runtime prompt still\n        // becomes \"ping\". Exercised end-to-end by the integration test\n        // `default_cli_flow_still_runs_without_subcommand`.\n        let cli =\n            Cli::try_parse_from([\"oulipoly-agent-runner\", \"--model\", \"fixture\", \"ping\"]).unwrap();\n\n        assert!(cli.command.is_none());\n        assert_eq!(cli.model.as_deref(), Some(\"fixture\"));\n        assert_eq!(cli.agent.as_deref(), Some(\"ping\"));\n        assert!(cli.prompt_args.is_empty());\n\n        // Two trailing args: the first goes to `agent`, the rest into\n        // `prompt_args`. This is the existing PR-A behavior preserved\n        // under subcommand dispatch.\n        let cli = Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"--model\",\n            \"fixture\",\n            \"ping\",\n            \"pong\",\n        ])\n        .unwrap();\n        assert_eq!(cli.agent.as_deref(), Some(\"ping\"));\n        assert_eq!(cli.prompt_args, vec![\"pong\"]);\n    }\n\n    #[test]\n    fn parser_accepts_long_new() {\n        let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"--new\"]).unwrap();\n\n        assert!(cli.new);\n        assert!(cli.command.is_none());\n        assert!(cli.agent.is_none());\n        assert!(cli.prompt_args.is_empty());\n        assert!(cli.model.is_none());\n        assert!(cli.resume.is_none());\n    }\n\n    #[test]\n    fn parser_accepts_short_n() {\n        let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"-n\"]).unwrap();\n\n        assert!(cli.new);\n        assert!(cli.command.is_none());\n        assert!(cli.agent.is_none());\n        assert!(cli.prompt_args.is_empty());\n        assert!(cli.model.is_none());\n        assert!(cli.resume.is_none());\n    }\n\n    #[test]\n    fn parser_rejects_resume_then_new() {\n        let err = match Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"--resume\",\n            \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n            \"--new\",\n        ]) {\n            Ok(_) => panic!(\"--resume and --new should conflict\"),\n            Err(err) => err,\n        };\n\n        assert_eq!(err.kind(), clap::error::ErrorKind::ArgumentConflict);\n        let rendered = err.to_string();\n        assert!(rendered.contains(\"--resume\"), \"{rendered}\");\n        assert!(rendered.contains(\"--new\"), \"{rendered}\");\n    }\n\n    #[test]\n    fn parser_rejects_new_then_resume() {\n        let err = match Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"--new\",\n            \"--resume\",\n            \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n        ]) {\n            Ok(_) => panic!(\"--new and --resume should conflict\"),\n            Err(err) => err,\n        };\n\n        assert_eq!(err.kind(), clap::error::ErrorKind::ArgumentConflict);\n        let rendered = err.to_string();\n        assert!(rendered.contains(\"--new\"), \"{rendered}\");\n        assert!(rendered.contains(\"--resume\"), \"{rendered}\");\n    }\n\n    #[test]\n    fn repl_subcommand_parses_required_model_without_optional_paths() {\n        let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"repl\", REPL_MODEL]).unwrap();\n\n        match cli.command {\n            Some(Subcommands::Repl {\n                model,\n                resume,\n                rotate_provider: _,\n                project,","lineStart":1,"lineEnd":700,"totalLines":1106,"truncated":true}},"title":"src-tauri/src/dispatch.rs","time":{"start":1780923316022,"end":1780923316085}},"metadata":{"openai":{"itemId":"fc_0676cb86304500e2016a26bbb3f02c819895c77f494435012d"}},"id":"prt_ea74d3732001Pcnh7PasU7WAMx","sessionID":"ses_158b3e351ffePkuQnC9kglvomy","messageID":"msg_ea74d17ab001lJna4YkNrsywkk"}}
{"type":"tool_use","timestamp":1780923316109,"sessionID":"ses_158b3e351ffePkuQnC9kglvomy","part":{"type":"tool","tool":"read","callID":"call_oIOc7pr804rQfOFJvlGkKDfG","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/run/resume/orchestration.rs","offset":1,"limit":1300},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/run/resume/orchestration.rs</path>\n<type>file</type>\n<content>\n1: //! ## Declared roles\n2: //!\n3: //! `orchestration`, `validator`, `accessor`, `mapper`, `filter`, `predicate`, `formatter`\n4: \n5: use std::collections::HashMap;\n6: use std::io::IsTerminal;\n7: use std::path::Path;\n8: use std::sync::Arc;\n9: \n10: use oulipoly_runtime::provider_registry::{ProviderRegistry, ProviderRegistryOptions};\n11: use oulipoly_runtime::services::{\n12:     ExecutorServiceRequest, InvocationLifecycleServicePort, MigrationServiceOutput,\n13:     ResumeServiceOutput, ServiceError,\n14: };\n15: use oulipoly_runtime::{executor, sessions};\n16: use sha2::{Digest, Sha256};\n17: \n18: use super::disposition::{\n19:     ResumeLoopControl, ResumeTerminalDispositionInput, confirmed_zero_turn_maybe_quota,\n20:     handle_terminal_signal_disposition,\n21: };\n22: use super::finalization::{\n23:     CompletedAttemptControl, CompletedAttemptInput, finalize_completed_attempt,\n24: };\n25: use super::{formatter, mapper, validator};\n26: use crate::captured_child::emit_captured_child_marker_lines;\n27: use crate::cli::inputs::resolve_resume_answer;\n28: use crate::invocation::finalize::FinalizerGuard;\n29: use crate::migration_providers::load_resume_execution_environment;\n30: use crate::quota_zero_turn::{\n31:     apply_zero_turn_classification_to_result, filter_quota_exhausted_migration_candidates,\n32:     zero_turn_classification_for_action, zero_turn_classify_after_completion,\n33:     zero_turn_record_baseline,\n34: };\n35: use crate::resume_cli::{\n36:     format_resume_error, render_resume_model_pool_mismatch, renderable_resume_execution_target,\n37:     resume_migration_pool,\n38: };\n39: use crate::spawn_cwd::effective_resume_spawn_cwd;\n40: use crate::terminal_outcome_adapter::{\n41:     TerminalSignalDisposition, apply_age153_terminal_signal_fixture_override,\n42:     confirm_maybe_quota_exhausted, resume_terminal_signal_for_outcome, terminal_signal_reason,\n43: };\n44: use crate::wiring;\n45: use crate::zero_turn_orchestration::{ZeroTurnAction, ZeroTurnConfirmationState, next_action};\n46: \n47: #[allow(clippy::too_many_arguments)]\n48: pub(crate) fn run_resume(\n49:     agent_runtime_services: &wiring::AgentRuntimeServices,\n50:     model_name: Option<&str>,\n51:     session_id: &str,\n52:     manual_migrate: Option<&str>,\n53:     prompt: Option<&str>,\n54:     file: Option<&Path>,\n55:     working_dir: Option<&Path>,\n56:     models_dir_override: Option<&Path>,\n57: ) -> Result<i32, String> {\n58:     if let Some(exit_code) = reject_invalid_resume_input(session_id) {\n59:         return Ok(exit_code);\n60:     }\n61:     if let Some(exit_code) = crate::wake_coordinator::validate_auto_wake_child(session_id)? {\n62:         return Ok(exit_code);\n63:     }\n64:     if !crate::wake_coordinator::is_auto_wake_invocation() {\n65:         crate::wake_coordinator::reset_manual_resume_wake_claim(session_id)?;\n66:     }\n67:     // Source guard marker: agent_runtime_services.resume_service.resolve_resume(ResumeServiceRequest)\n68: \n69:     let mut prepared = match prepare_headless_resume_execution(\n70:         agent_runtime_services,\n71:         model_name,\n72:         session_id,\n73:         prompt,\n74:         file,\n75:         working_dir,\n76:         models_dir_override,\n77:     )? {\n78:         Ok(prepared) => prepared,\n79:         Err(exit_code) => {\n80:             crate::wake_coordinator::release_current_auto_wake_claim_for_session(session_id);\n81:             return Ok(exit_code);\n82:         }\n83:     };\n84:     let result = run_resume_loop(ResumeLoopInput {\n85:         agent_runtime_services,\n86:         prepared: &mut prepared,\n87:         manual_migrate,\n88:         session_id,\n89:         working_dir,\n90:     });\n91:     if failed_auto_wake_exit(&result) {\n92:         let _ = crate::wake_coordinator::recheck_after_failed_auto_wake(session_id);\n93:     }\n94:     result\n95: }\n96: \n97: fn failed_auto_wake_exit(result: &Result<i32, String>) -> bool {\n98:     crate::wake_coordinator::is_auto_wake_invocation() && !matches!(result, Ok(0))\n99: }\n100: \n101: fn reject_invalid_resume_input(session_id: &str) -> Option<i32> {\n102:     match validator::validate_resume_input(session_id) {\n103:         Ok(()) => None,\n104:         Err(message) => {\n105:             formatter::emit_stderr(&message);\n106:             Some(1)\n107:         }\n108:     }\n109: }\n110: \n111: struct PreparedHeadlessResumeExecution {\n112:     answer: Option<String>,\n113:     mailbox_session_id: String,\n114:     mailbox_delivery_seqs: Vec<i64>,\n115:     mailbox_delivery_nonce: Option<String>,\n116:     env: crate::migration_providers::ResumeExecutionEnvironment,\n117:     resolved: oulipoly_state::ResolvedResume,\n118:     effective_spawn_cwd: std::path::PathBuf,\n119:     parent_invocation_id: Option<i64>,\n120:     max_attempts: usize,\n121: }\n122: \n123: #[allow(clippy::too_many_arguments)]\n124: fn prepare_headless_resume_execution(\n125:     agent_runtime_services: &wiring::AgentRuntimeServices,\n126:     model_name: Option<&str>,\n127:     session_id: &str,\n128:     prompt: Option<&str>,\n129:     file: Option<&Path>,\n130:     working_dir: Option<&Path>,\n131:     models_dir_override: Option<&Path>,\n132: ) -> Result<Result<PreparedHeadlessResumeExecution, i32>, String> {\n133:     let answer = resolve_resume_answer(prompt, file)?;\n134:     let env = load_resume_execution_environment(models_dir_override)?;\n135:     refresh_resume_provider_registry(agent_runtime_services, &env)?;\n136:     let resolved = match resolve_resume_for_headless_execution(\n137:         agent_runtime_services,\n138:         &env,\n139:         session_id,\n140:         model_name,\n141:     ) {\n142:         Ok(resolved) => resolved,\n143:         Err(exit_code) => return Ok(Err(exit_code)),\n144:     };\n145:     if let Err(exit_code) = prepare_initial_headless_resume_target(\n146:         &resolved,\n147:         &env.providers_cfg,\n148:         std::io::stderr().is_terminal(),\n149:     ) {\n150:         return Ok(Err(exit_code));\n151:     }\n152:     let effective_spawn_cwd = effective_resume_execution_cwd(&env, session_id, working_dir)?;\n153:     let parent_invocation_id = crate::dispatch::resolve_parent_invocation_id(&env.state);\n154:     let max_attempts = headless_resume_retry_budget(&resolved);\n155:     let mailbox_delivery = crate::mailbox_delivery::prepare_headless_resume_delivery(\n156:         &resolved,\n157:         answer,\n158:         Some(&env.models_dir),\n159:     )?;\n160:     Ok(Ok(PreparedHeadlessResumeExecution {\n161:         answer: mailbox_delivery.answer,\n162:         mailbox_session_id: mailbox_delivery.session_id,\n163:         mailbox_delivery_seqs: mailbox_delivery.seqs,\n164:         mailbox_delivery_nonce: mailbox_delivery.delivery_nonce,\n165:         env,\n166:         resolved,\n167:         effective_spawn_cwd,\n168:         parent_invocation_id,\n169:         max_attempts,\n170:     }))\n171: }\n172: \n173: fn refresh_resume_provider_registry(\n174:     agent_runtime_services: &wiring::AgentRuntimeServices,\n175:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n176: ) -> Result<(), String> {\n177:     let models = env.models.values().cloned().collect::<Vec<_>>();\n178:     let registry =\n179:         ProviderRegistry::from_model_configs(&models, resume_provider_registry_options(env))\n180:             .map_err(|err| format!(\"failed to build resume provider registry: {err}\"))?;\n181:     agent_runtime_services\n182:         .provider_registry_handle\n183:         .replace(Arc::new(registry));\n184:     Ok(())\n185: }\n186: \n187: fn resume_provider_registry_options(\n188:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n189: ) -> ProviderRegistryOptions {\n190:     ProviderRegistryOptions::default()\n191:         .with_path_entries_from_process_path()\n192:         .with_config_root(env.config_root.clone())\n193:         .with_data_root(resume_provider_registry_data_root(env))\n194: }\n195: \n196: fn resume_provider_registry_data_root(\n197:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n198: ) -> std::path::PathBuf {\n199:     oulipoly_state::paths::data_dir().unwrap_or_else(|_| env.config_root.clone())\n200: }\n201: \n202: fn effective_resume_execution_cwd(\n203:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n204:     session_id: &str,\n205:     working_dir: Option<&Path>,\n206: ) -> Result<std::path::PathBuf, String> {\n207:     effective_resume_spawn_cwd(\n208:         &env.state,\n209:         &env.models,\n210:         &env.providers_cfg,\n211:         &env.sessions_cfg,\n212:         session_id,\n213:         working_dir,\n214:     )\n215: }\n216: \n217: fn headless_resume_retry_budget(resolved: &oulipoly_state::ResolvedResume) -> usize {\n218:     resolved\n219:         .model\n220:         .as_ref()\n221:         .map(|model| model.providers.len())\n222:         .unwrap_or(1)\n223:         .max(1)\n224:         + 1\n225: }\n226: \n227: struct ResumeLoopInput<'a> {\n228:     agent_runtime_services: &'a wiring::AgentRuntimeServices,\n229:     prepared: &'a mut PreparedHeadlessResumeExecution,\n230:     manual_migrate: Option<&'a str>,\n231:     session_id: &'a str,\n232:     working_dir: Option<&'a Path>,\n233: }\n234: \n235: fn run_resume_loop(input: ResumeLoopInput<'_>) -> Result<i32, String> {\n236:     let mut attempts = 0usize;\n237:     let mut last_exit_code = 1;\n238:     let mut zero_turn_confirmation = ZeroTurnConfirmationState::new();\n239: \n240:     loop {\n241:         if resume_attempts_exhausted(attempts, input.prepared.max_attempts) {\n242:             return Ok(resume_attempts_exhausted_exit_code(last_exit_code));\n243:         }\n244:         attempts += 1;\n245: \n246:         match run_resume_attempt(ResumeAttemptInput {\n247:             agent_runtime_services: input.agent_runtime_services,\n248:             env: &input.prepared.env,\n249:             resolved: &mut input.prepared.resolved,\n250:             answer: input.prepared.answer.as_deref(),\n251:             mailbox_session_id: &input.prepared.mailbox_session_id,\n252:             mailbox_delivery_seqs: &input.prepared.mailbox_delivery_seqs,\n253:             mailbox_delivery_nonce: input.prepared.mailbox_delivery_nonce.as_deref(),\n254:             manual_migrate: input.manual_migrate,\n255:             session_id: input.session_id,\n256:             working_dir: input.working_dir,\n257:             attempts,\n258:             max_attempts: input.prepared.max_attempts,\n259:             parent_invocation_id: input.prepared.parent_invocation_id,\n260:             effective_spawn_cwd: &input.prepared.effective_spawn_cwd,\n261:             zero_turn_confirmation: &mut zero_turn_confirmation,\n262:         })? {\n263:             ResumeAttemptLoopControl::Continue(exit_code) => {\n264:                 last_exit_code = exit_code;\n265:                 continue;\n266:             }\n267:             ResumeAttemptLoopControl::Return(exit_code) => return Ok(exit_code),\n268:         }\n269:     }\n270: }\n271: \n272: fn resume_attempts_exhausted(attempts: usize, max_attempts: usize) -> bool {\n273:     attempts >= max_attempts\n274: }\n275: \n276: fn resume_attempts_exhausted_exit_code(last_exit_code: i32) -> i32 {\n277:     formatter::emit_stderr(\"BLOCKED:all-providers-exhausted\");\n278:     normalized_resume_exhausted_exit_code(last_exit_code)\n279: }\n280: \n281: fn normalized_resume_exhausted_exit_code(last_exit_code: i32) -> i32 {\n282:     if last_exit_code == 0 {\n283:         1\n284:     } else {\n285:         last_exit_code\n286:     }\n287: }\n288: \n289: struct ResumeAttemptInput<'a> {\n290:     agent_runtime_services: &'a wiring::AgentRuntimeServices,\n291:     env: &'a crate::migration_providers::ResumeExecutionEnvironment,\n292:     resolved: &'a mut oulipoly_state::ResolvedResume,\n293:     answer: Option<&'a str>,\n294:     mailbox_session_id: &'a str,\n295:     mailbox_delivery_seqs: &'a [i64],\n296:     mailbox_delivery_nonce: Option<&'a str>,\n297:     manual_migrate: Option<&'a str>,\n298:     session_id: &'a str,\n299:     working_dir: Option<&'a Path>,\n300:     attempts: usize,\n301:     max_attempts: usize,\n302:     parent_invocation_id: Option<i64>,\n303:     effective_spawn_cwd: &'a Path,\n304:     zero_turn_confirmation: &'a mut ZeroTurnConfirmationState,\n305: }\n306: \n307: enum ResumeAttemptLoopControl {\n308:     Continue(i32),\n309:     Return(i32),\n310: }\n311: \n312: fn run_resume_attempt(\n313:     mut input: ResumeAttemptInput<'_>,\n314: ) -> Result<ResumeAttemptLoopControl, String> {\n315:     let target = match prepare_resume_attempt_target(&mut input)? {\n316:         Ok(target) => target,\n317:         Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n318:     };\n319:     let provider_index = target.provider_index;\n320:     let provider = target.provider;\n321:     let strategy = match resume_attempt_strategy_for_target(input.resolved, &provider) {\n322:         Ok(strategy) => strategy,\n323:         Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n324:     };\n325: \n326:     let mut bound_attempt = setup_bound_resume_attempt(&input, &provider, provider_index)?;\n327: \n328:     let mut result = match execute_resume_attempt_command(\n329:         &input,\n330:         &provider,\n331:         provider_index,\n332:         target.prompt_mode,\n333:         &bound_attempt.invocation_env,\n334:         strategy,\n335:     ) {\n336:         Ok(result) => result,\n337:         Err(_spawn_err) => return handle_resume_attempt_spawn_error(&input, &mut bound_attempt),\n338:     };\n339: \n340:     handle_resume_attempt_result(&mut input, &mut bound_attempt, &provider, &mut result)\n341: }\n342: \n343: fn handle_resume_attempt_spawn_error(\n344:     input: &ResumeAttemptInput<'_>,\n345:     bound_attempt: &mut BoundResumeAttempt<'_>,\n346: ) -> Result<ResumeAttemptLoopControl, String> {\n347:     record_failed_mailbox_delivery_attempt(input, \"resume_spawn_error\")?;\n348:     finalize_resume_spawn_error(input, &mut bound_attempt.attempt)?;\n349:     Ok(ResumeAttemptLoopControl::Return(1))\n350: }\n351: \n352: fn handle_resume_attempt_result(\n353:     input: &mut ResumeAttemptInput<'_>,\n354:     bound_attempt: &mut BoundResumeAttempt<'_>,\n355:     provider: &oulipoly_config::ProviderConfig,\n356:     result: &mut executor::ExecutionResult,\n357: ) -> Result<ResumeAttemptLoopControl, String> {\n358:     apply_resume_attempt_classification(\n359:         input.env,\n360:         &provider.name,\n361:         &bound_attempt.provider_session_id,\n362:         &bound_attempt.zero_turn_baseline,\n363:         input.zero_turn_confirmation,\n364:         result,\n365:     )\n366:     .and_then(|zero_turn_action| {\n367:         record_resume_acceptance_if_present(\n368:             input,\n369:             bound_attempt.attempt.invocation_row_id,\n370:             result,\n371:         )?;\n372:         emit_captured_child_marker_lines(&result.captured_child_invocations);\n373:         handle_resume_attempt_terminal_signal(\n374:             input,\n375:             &mut bound_attempt.attempt,\n376:             provider,\n377:             &bound_attempt.provider_session_id,\n378:             result,\n379:             zero_turn_action,\n380:         )\n381:     })\n382: }\n383: \n384: fn resume_attempt_strategy_for_target<'a>(\n385:     resolved: &oulipoly_state::ResolvedResume,\n386:     provider: &'a oulipoly_config::ProviderConfig,\n387: ) -> Result<Option<&'a oulipoly_config::ResumeStrategy>, i32> {\n388:     if resolved_uses_provider_ref(resolved) {\n389:         return Ok(None);\n390:     }\n391:     resume_attempt_strategy(provider).map(Some)\n392: }\n393: \n394: fn resume_attempt_strategy(\n395:     provider: &oulipoly_config::ProviderConfig,\n396: ) -> Result<&oulipoly_config::ResumeStrategy, i32> {\n397:     provider\n398:         .resume\n399:         .as_ref()\n400:         .ok_or_else(|| missing_resume_block_exit_code(&provider.name))\n401: }\n402: \n403: fn missing_resume_block_exit_code(provider_name: &str) -> i32 {\n404:     formatter::emit_missing_resume_block(provider_name);\n405:     1\n406: }\n407: \n408: fn execute_resume_attempt_command(\n409:     input: &ResumeAttemptInput<'_>,\n410:     provider: &oulipoly_config::ProviderConfig,\n411:     provider_index: usize,\n412:     prompt_mode: oulipoly_config::PromptMode,\n413:     invocation_env: &str,\n414:     strategy: Option<&oulipoly_config::ResumeStrategy>,\n415: ) -> Result<executor::ExecutionResult, String> {\n416:     if let Some(request) = provider_ref_resume_executor_request(\n417:         input,\n418:         provider,\n419:         provider_index,\n420:         prompt_mode,\n421:         invocation_env,\n422:     ) {\n423:         return input\n424:             .agent_runtime_services\n425:             .executor_service\n426:             .execute(request)\n427:             .map(|output| output.result)\n428:             .map_err(|err| err.to_string());\n429:     }\n430:     executor::cli::execute_resume_optional_prompt_with_model_identity(\n431:         provider,\n432:         provider_index,\n433:         prompt_mode,\n434:         input.answer,\n435:         Some(input.effective_spawn_cwd),\n436:         Some(invocation_env),\n437:         executor::cli::ResumePayload {\n438:             session_id: &input.resolved.active_session_id,\n439:             strategy: strategy.expect(\"legacy resume target must have a resume strategy\"),\n440:         },\n441:         input.resolved.model_name.as_deref().unwrap_or(\"<unknown>\"),\n442:     )\n443: }\n444: \n445: fn provider_ref_resume_executor_request(\n446:     input: &ResumeAttemptInput<'_>,\n447:     provider: &oulipoly_config::ProviderConfig,\n448:     provider_index: usize,\n449:     prompt_mode: oulipoly_config::PromptMode,\n450:     invocation_env: &str,\n451: ) -> Option<ExecutorServiceRequest> {\n452:     let model = input.resolved.model.as_ref()?;\n453:     model.provider.as_ref()?;\n454:     Some(\n455:         ExecutorServiceRequest::EffectiveWithStartKnownProviderSessionId {\n456:             model: model.clone(),\n457:             provider: provider.clone(),\n458:             provider_index,\n459:             prompt_mode,\n460:             prompt: input.answer.unwrap_or_default().to_string(),\n461:             working_dir: Some(input.effective_spawn_cwd.to_path_buf()),\n462:             extra_inputs: HashMap::new(),\n463:             parent_invocation_env: Some(invocation_env.to_string()),\n464:             start_known_provider_session_id: input.resolved.active_session_id.clone(),\n465:         },\n466:     )\n467: }\n468: \n469: fn finalize_resume_spawn_error(\n470:     input: &ResumeAttemptInput<'_>,\n471:     attempt: &mut ResumeInvocationAttempt<'_>,\n472: ) -> Result<(), String> {\n473:     input\n474:         .agent_runtime_services\n475:         .invocation_lifecycle_service\n476:         .finalize_invocation(mapper::spawn_error_finalize_request(\n477:             &input.env.state,\n478:             attempt.invocation_row_id,\n479:         ))\n480:         .map_err(|err| err.to_string())?;\n481:     attempt.guard.mark_finalized();\n482:     mark_resume_attempt_idle(\n483:         &input.resolved.active_session_id,\n484:         &attempt.invocation.id,\n485:         Some(1),\n486:     )?;\n487:     Ok(())\n488: }\n489: \n490: fn prepare_resume_attempt_target(\n491:     input: &mut ResumeAttemptInput<'_>,\n492: ) -> Result<Result<crate::resume_cli::ResumeExecutionTarget, i32>, String> {\n493:     let mut target =\n494:         match renderable_resume_execution_target(input.resolved, &input.env.providers_cfg) {\n495:             Ok(target) => target,\n496:             Err(exit_code) => return Ok(Err(exit_code)),\n497:         };\n498:     if let Err(exit_code) = migrate_resume_target(\n499:         input.agent_runtime_services,\n500:         input.env,\n501:         input.resolved,\n502:         &mut target,\n503:         input.manual_migrate,\n504:         input.attempts,\n505:         input.effective_spawn_cwd,\n506:     ) {\n507:         return Ok(Err(exit_code));\n508:     }\n509:     Ok(Ok(target))\n510: }\n511: \n512: struct ResumeInvocationAttempt<'state> {\n513:     invocation: oulipoly_state::CompositeInvocationId,\n514:     invocation_row_id: i64,\n515:     guard: FinalizerGuard<'state>,\n516: }\n517: \n518: struct BoundResumeAttempt<'state> {\n519:     attempt: ResumeInvocationAttempt<'state>,\n520:     provider_session_id: String,\n521:     zero_turn_baseline: crate::zero_turn_orchestration::ZeroTurnBaseline,\n522:     invocation_env: String,\n523: }\n524: \n525: fn setup_bound_resume_attempt<'state>(\n526:     input: &ResumeAttemptInput<'state>,\n527:     provider: &oulipoly_config::ProviderConfig,\n528:     provider_index: usize,\n529: ) -> Result<BoundResumeAttempt<'state>, String> {\n530:     let attempt = start_resume_invocation(input, provider, provider_index)?;\n531:     let provider_session_id = input.resolved.active_session_id.clone();\n532:     bind_resume_attempt_session(\n533:         input,\n534:         provider,\n535:         attempt.invocation_row_id,\n536:         &provider_session_id,\n537:     )?;\n538:     let zero_turn_baseline = zero_turn_record_baseline(\n539:         &input.env.state,\n540:         &input.env.sessions_cfg,\n541:         &provider.name,\n542:         Some(&provider_session_id),\n543:     );\n544:     let invocation_env = resume_invocation_env(&attempt.invocation)?;\n545:     formatter::emit_stderr(&attempt.invocation.stderr_line());\n546:     Ok(BoundResumeAttempt {\n547:         attempt,\n548:         provider_session_id,\n549:         zero_turn_baseline,\n550:         invocation_env,\n551:     })\n552: }\n553: \n554: fn start_resume_invocation<'state>(\n555:     input: &ResumeAttemptInput<'state>,\n556:     provider: &oulipoly_config::ProviderConfig,\n557:     provider_index: usize,\n558: ) -> Result<ResumeInvocationAttempt<'state>, String> {\n559:     let invocation = mapper::composite_invocation_id(&provider.name);\n560:     let invocation_start = mapper::resume_invocation_start(\n561:         &invocation,\n562:         input.resolved.model_name.as_deref(),\n563:         &provider.name,\n564:         provider_index,\n565:         input.parent_invocation_id,\n566:     );\n567:     let invocation_row_id = input\n568:         .agent_runtime_services\n569:         .invocation_lifecycle_service\n570:         .start_invocation(mapper::invocation_lifecycle_start_request(\n571:             &input.env.state,\n572:             &invocation_start,\n573:         ))\n574:         .map_err(|err| err.to_string())?\n575:         .invocation_row_id;\n576:     let guard = FinalizerGuard::new(&input.env.state, invocation_row_id);\n577:     Ok(ResumeInvocationAttempt {\n578:         invocation,\n579:         invocation_row_id,\n580:         guard,\n581:     })\n582: }\n583: \n584: fn bind_resume_attempt_session(\n585:     input: &ResumeAttemptInput<'_>,\n586:     provider: &oulipoly_config::ProviderConfig,\n587:     invocation_row_id: i64,\n588:     provider_session_id: &str,\n589: ) -> Result<(), String> {\n590:     input.env.state.bind_invocation_provider_session_start(\n591:         invocation_row_id,\n592:         &mapper::resumed_provider_session_binding(\n593:             provider,\n594:             provider_session_id,\n595:             Some(input.session_id.to_string()),\n596:         ),\n597:     )?;\n598:     if should_record_legacy_resume_input(input.manual_migrate) {\n599:         record_legacy_resume_input_session_id(input, invocation_row_id)?;\n600:     }\n601:     Ok(())\n602: }\n603: \n604: fn should_record_legacy_resume_input(manual_migrate: Option<&str>) -> bool {\n605:     manual_migrate.is_some()\n606: }\n607: \n608: fn record_legacy_resume_input_session_id(\n609:     input: &ResumeAttemptInput<'_>,\n610:     invocation_row_id: i64,\n611: ) -> Result<(), String> {\n612:     input\n613:         .env\n614:         .state\n615:         .record_legacy_resume_input_session_id(invocation_row_id, input.session_id)\n616: }\n617: \n618: fn resume_invocation_env(\n619:     invocation: &oulipoly_state::CompositeInvocationId,\n620: ) -> Result<String, String> {\n621:     serde_json::to_string(invocation).map_err(|e| format!(\"Failed to serialize invocation id: {e}\"))\n622: }\n623: \n624: fn apply_resume_attempt_classification(\n625:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n626:     provider_name: &str,\n627:     provider_session_id: &str,\n628:     zero_turn_baseline: &crate::zero_turn_orchestration::ZeroTurnBaseline,\n629:     zero_turn_confirmation: &mut ZeroTurnConfirmationState,\n630:     result: &mut executor::ExecutionResult,\n631: ) -> Result<crate::zero_turn_orchestration::ZeroTurnAction, String> {\n632:     apply_age153_terminal_signal_fixture_override(result);\n633:     let zero_turn_classification =\n634:         zero_turn_classify_after_completion(&env.state, &env.sessions_cfg, zero_turn_baseline);\n635:     apply_zero_turn_classification_to_result(result, provider_name, &zero_turn_classification);\n636:     Ok(next_action(\n637:         zero_turn_confirmation,\n638:         zero_turn_classification_for_action(\n639:             zero_turn_classification,\n640:             result,\n641:             provider_name,\n642:             Some(provider_session_id),\n643:         ),\n644:     ))\n645: }\n646: \n647: fn record_resume_acceptance_if_present(\n648:     input: &ResumeAttemptInput<'_>,\n649:     invocation_row_id: i64,\n650:     result: &executor::ExecutionResult,\n651: ) -> Result<(), String> {\n652:     let Some(acceptance) = resume_acceptance_result(result) else {\n653:         return Ok(());\n654:     };\n655:     record_resume_acceptance(input, invocation_row_id, acceptance)\n656: }\n657: \n658: fn resume_acceptance_result(\n659:     result: &executor::ExecutionResult,\n660: ) -> Option<&oulipoly_runtime::executor::ResumeAcceptanceResult> {\n661:     result.resume_acceptance.as_ref()\n662: }\n663: \n664: fn record_resume_acceptance(\n665:     input: &ResumeAttemptInput<'_>,\n666:     invocation_row_id: i64,\n667:     acceptance: &oulipoly_runtime::executor::ResumeAcceptanceResult,\n668: ) -> Result<(), String> {\n669:     input\n670:         .agent_runtime_services\n671:         .resume_service\n672:         .record_acceptance(mapper::resume_acceptance_request(\n673:             &input.env.state,\n674:             invocation_row_id,\n675:             acceptance,\n676:         ))\n677:         .map_err(format_resume_acceptance_service_error)?;\n678:     Ok(())\n679: }\n680: \n681: fn format_resume_acceptance_service_error(err: oulipoly_runtime::services::ServiceError) -> String {\n682:     format!(\"resume acceptance service failed: {err}\")\n683: }\n684: \n685: fn handle_resume_attempt_terminal_signal(\n686:     input: &ResumeAttemptInput<'_>,\n687:     attempt: &mut ResumeInvocationAttempt<'_>,\n688:     provider: &oulipoly_config::ProviderConfig,\n689:     provider_session_id: &str,\n690:     result: &executor::ExecutionResult,\n691:     zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n692: ) -> Result<ResumeAttemptLoopControl, String> {\n693:     let terminal_signal_disposition = terminal_signal_disposition_for_result(\n694:         &input.env.state,\n695:         &attempt.invocation.id,\n696:         &provider.name,\n697:         provider_session_id,\n698:         result,\n699:         zero_turn_action,\n700:     );\n701: \n702:     let disposition_control = handle_terminal_signal_disposition(ResumeTerminalDispositionInput {\n703:         agent_runtime_services: input.agent_runtime_services,\n704:         env: input.env,\n705:         invocation_row_id: attempt.invocation_row_id,\n706:         guard: &mut attempt.guard,\n707:         result,\n708:         terminal_signal_disposition,\n709:         zero_turn_action,\n710:     })?;\n711:     if let Some(control) = apply_resume_terminal_disposition_outcome(\n712:         input,\n713:         attempt,\n714:         provider_session_id,\n715:         result,\n716:         terminal_disposition_outcome(disposition_control, result),\n717:     )? {\n718:         return Ok(control);\n719:     }\n720: \n721:     ingest_mailbox_delivery_confirmation_turn_if_needed(input, provider, result, zero_turn_action);\n722: \n723:     if let Some(control) = handle_unconfirmed_mailbox_delivery_if_needed(\n724:         input,\n725:         attempt,\n726:         provider,\n727:         provider_session_id,\n728:         result,\n729:         zero_turn_action,\n730:     )? {\n731:         return Ok(control);\n732:     }\n733: \n734:     finalize_completed_attempt_for_resume(input, attempt, provider, provider_session_id, result)\n735: }\n736: \n737: fn ingest_mailbox_delivery_confirmation_turn_if_needed(\n738:     input: &ResumeAttemptInput<'_>,\n739:     provider: &oulipoly_config::ProviderConfig,\n740:     result: &executor::ExecutionResult,\n741:     zero_turn_action: ZeroTurnAction,\n742: ) {\n743:     if !mailbox_delivery_requires_turn_confirmation(input, &provider.name, result) {\n744:         return;\n745:     }\n746:     if mailbox_delivery_turn_confirmed(input, &provider.name, result, zero_turn_action) {\n747:         return;\n748:     }\n749:     let report = sessions::scan_provider_session(\n750:         &provider.name,\n751:         &input.env.sessions_cfg,\n752:         &input.env.state,\n753:         &input.resolved.active_session_id,\n754:     );\n755:     emit_pre_confirmation_session_scan_errors(&provider.name, report.errors);\n756: }\n757: \n758: fn emit_pre_confirmation_session_scan_errors(provider_name: &str, errors: Vec<String>) {\n759:     for error in errors {\n760:         formatter::emit_stderr(&format!(\n761:             \"Warning: Session ingest failed for {provider_name}: {error}\"\n762:         ));\n763:     }\n764: }\n765: \n766: enum ResumeTerminalDispositionOutcome {\n767:     Continue(i32),\n768:     Return(i32),\n769:     CompletedAttempt,\n770: }\n771: \n772: fn terminal_disposition_outcome(\n773:     control: ResumeLoopControl,\n774:     result: &executor::ExecutionResult,\n775: ) -> ResumeTerminalDispositionOutcome {\n776:     match control {\n777:         ResumeLoopControl::Continue => ResumeTerminalDispositionOutcome::Continue(result.exit_code),\n778:         ResumeLoopControl::Return(exit_code) => ResumeTerminalDispositionOutcome::Return(exit_code),\n779:         ResumeLoopControl::CompletedAttempt => ResumeTerminalDispositionOutcome::CompletedAttempt,\n780:     }\n781: }\n782: \n783: fn apply_resume_terminal_disposition_outcome(\n784:     input: &ResumeAttemptInput<'_>,\n785:     attempt: &ResumeInvocationAttempt<'_>,\n786:     provider_session_id: &str,\n787:     result: &executor::ExecutionResult,\n788:     outcome: ResumeTerminalDispositionOutcome,\n789: ) -> Result<Option<ResumeAttemptLoopControl>, String> {\n790:     match outcome {\n791:         ResumeTerminalDispositionOutcome::Continue(exit_code) => {\n792:             record_failed_mailbox_delivery_attempt(\n793:                 input,\n794:                 &failed_delivery_error(result, \"resume_retry\"),\n795:             )?;\n796:             mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n797:             Ok(Some(ResumeAttemptLoopControl::Continue(exit_code)))\n798:         }\n799:         ResumeTerminalDispositionOutcome::Return(exit_code) => {\n800:             record_failed_mailbox_delivery_attempt(\n801:                 input,\n802:                 &failed_delivery_error(result, \"resume_failed\"),\n803:             )?;\n804:             mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n805:             Ok(Some(ResumeAttemptLoopControl::Return(exit_code)))\n806:         }\n807:         ResumeTerminalDispositionOutcome::CompletedAttempt => Ok(None),\n808:     }\n809: }\n810: \n811: fn handle_unconfirmed_mailbox_delivery_if_needed(\n812:     input: &ResumeAttemptInput<'_>,\n813:     attempt: &mut ResumeInvocationAttempt<'_>,\n814:     provider: &oulipoly_config::ProviderConfig,\n815:     provider_session_id: &str,\n816:     result: &executor::ExecutionResult,\n817:     zero_turn_action: ZeroTurnAction,\n818: ) -> Result<Option<ResumeAttemptLoopControl>, String> {\n819:     if !mailbox_delivery_unconfirmed(input, &provider.name, result, zero_turn_action) {\n820:         return Ok(None);\n821:     }\n822:     record_failed_mailbox_delivery_attempt(input, \"mailbox_delivery_unconfirmed\")?;\n823:     finalize_unconfirmed_mailbox_delivery(input, attempt, result)?;\n824:     mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(1))?;\n825:     Ok(Some(ResumeAttemptLoopControl::Return(1)))\n826: }\n827: \n828: fn finalize_completed_attempt_for_resume(\n829:     input: &ResumeAttemptInput<'_>,\n830:     attempt: &mut ResumeInvocationAttempt<'_>,\n831:     provider: &oulipoly_config::ProviderConfig,\n832:     provider_session_id: &str,\n833:     result: &executor::ExecutionResult,\n834: ) -> Result<ResumeAttemptLoopControl, String> {\n835:     match finalize_completed_attempt(CompletedAttemptInput {\n836:         agent_runtime_services: input.agent_runtime_services,\n837:         env: input.env,\n838:         invocation: &attempt.invocation,\n839:         invocation_row_id: attempt.invocation_row_id,\n840:         guard: &mut attempt.guard,\n841:         provider_name: &provider.name,\n842:         model: input.resolved.model.as_ref(),\n843:         result,\n844:         working_dir: input.working_dir,\n845:         manual_migrate: input.manual_migrate,\n846:         session_id: input.session_id,\n847:         active_session_id: &input.resolved.active_session_id,\n848:         effective_spawn_cwd: input.effective_spawn_cwd,\n849:         attempts: input.attempts,\n850:         max_attempts: input.max_attempts,\n851:     })? {\n852:         CompletedAttemptControl::Continue => {\n853:             record_failed_mailbox_delivery_attempt(\n854:                 input,\n855:                 &failed_delivery_error(result, \"quota_exhausted\"),\n856:             )?;\n857:             mark_resume_attempt_idle(\n858:                 provider_session_id,\n859:                 &attempt.invocation.id,\n860:                 Some(result.exit_code),\n861:             )?;\n862:             Ok(ResumeAttemptLoopControl::Continue(result.exit_code))\n863:         }\n864:         CompletedAttemptControl::Return(exit_code) => {\n865:             if exit_code == 0 {\n866:                 crate::mailbox_delivery::mark_headless_resume_delivered(\n867:                     input.mailbox_session_id,\n868:                     input.mailbox_delivery_seqs,\n869:                     &attempt.invocation.id,\n870:                 )?;\n871:                 let _ = crate::wake_coordinator::mark_successful_turn_idle_and_recheck(\n872:                     provider_session_id,\n873:                     &attempt.invocation.id,\n874:                     exit_code,\n875:                 )?;\n876:             } else {\n877:                 record_failed_mailbox_delivery_attempt(\n878:                     input,\n879:                     &failed_delivery_error(result, \"resume_failed\"),\n880:                 )?;\n881:                 mark_resume_attempt_idle(\n882:                     provider_session_id,\n883:                     &attempt.invocation.id,\n884:                     Some(exit_code),\n885:                 )?;\n886:             }\n887:             Ok(ResumeAttemptLoopControl::Return(exit_code))\n888:         }\n889:     }\n890: }\n891: \n892: fn mailbox_delivery_unconfirmed(\n893:     input: &ResumeAttemptInput<'_>,\n894:     provider_name: &str,\n895:     result: &executor::ExecutionResult,\n896:     zero_turn_action: ZeroTurnAction,\n897: ) -> bool {\n898:     mailbox_delivery_requires_turn_confirmation(input, provider_name, result)\n899:         && !mailbox_delivery_turn_confirmed(input, provider_name, result, zero_turn_action)\n900: }\n901: \n902: fn mailbox_delivery_requires_turn_confirmation(\n903:     input: &ResumeAttemptInput<'_>,\n904:     provider_name: &str,\n905:     result: &executor::ExecutionResult,\n906: ) -> bool {\n907:     result.exit_code == 0\n908:         && !input.mailbox_delivery_seqs.is_empty()\n909:         && input.answer.is_some_and(|answer| !answer.trim().is_empty())\n910:         && input.env.sessions_cfg.get(provider_name).is_some()\n911: }\n912: \n913: fn mailbox_delivery_turn_confirmed(\n914:     input: &ResumeAttemptInput<'_>,\n915:     provider_name: &str,\n916:     result: &executor::ExecutionResult,\n917:     zero_turn_action: ZeroTurnAction,\n918: ) -> bool {\n919:     matches!(zero_turn_action, ZeroTurnAction::Continue)\n920:         || submitted_user_turn_confirms_mailbox_delivery(input, result)\n921:         || ingested_user_turn_confirms_mailbox_delivery(input, provider_name)\n922: }\n923: \n924: fn submitted_user_turn_confirms_mailbox_delivery(\n925:     input: &ResumeAttemptInput<'_>,\n926:     result: &executor::ExecutionResult,\n927: ) -> bool {\n928:     let Some(submitted) = result.submitted_user_turn.as_ref() else {\n929:         return false;\n930:     };\n931:     let Some(answer) = input.answer else {\n932:         return false;\n933:     };\n934:     submitted.provider_session_id == input.resolved.active_session_id\n935:         && submitted_user_turn_payload_confirms_mailbox_delivery(input, submitted, answer)\n936: }\n937: \n938: fn submitted_user_turn_payload_confirms_mailbox_delivery(\n939:     input: &ResumeAttemptInput<'_>,\n940:     submitted: &executor::SubmittedUserTurn,\n941:     answer: &str,\n942: ) -> bool {\n943:     if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n944:         return submitted.delivery_nonce.as_deref() == Some(delivery_nonce);\n945:     }\n946:     submitted.prompt_sha256 == sha256_hex(answer.as_bytes())\n947: }\n948: \n949: fn ingested_user_turn_confirms_mailbox_delivery(\n950:     input: &ResumeAttemptInput<'_>,\n951:     provider_name: &str,\n952: ) -> bool {\n953:     if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n954:         return input\n955:             .env\n956:             .state\n957:             .has_session_user_turn_containing(\n958:                 provider_name,\n959:                 &input.resolved.active_session_id,\n960:                 delivery_nonce,\n961:             )\n962:             .unwrap_or(false);\n963:     }\n964: \n965:     let Some(answer) = input.answer else {\n966:         return false;\n967:     };\n968:     input\n969:         .env\n970:         .state\n971:         .has_session_user_text_turn(provider_name, &input.resolved.active_session_id, answer)\n972:         .unwrap_or(false)\n973: }\n974: \n975: fn sha256_hex(bytes: &[u8]) -> String {\n976:     let digest = Sha256::digest(bytes);\n977:     digest.iter().map(|byte| format!(\"{byte:02x}\")).collect()\n978: }\n979: \n980: fn finalize_unconfirmed_mailbox_delivery(\n981:     input: &ResumeAttemptInput<'_>,\n982:     attempt: &mut ResumeInvocationAttempt<'_>,\n983:     result: &executor::ExecutionResult,\n984: ) -> Result<(), String> {\n985:     formatter::emit_stderr(\n986:         \"resume mailbox delivery was not confirmed by a new session turn; leaving mailbox rows pending\",\n987:     );\n988:     input\n989:         .agent_runtime_services\n990:         .invocation_lifecycle_service\n991:         .finalize_invocation(mapper::finalize_request(\n992:             &input.env.state,\n993:             attempt.invocation_row_id,\n994:             false,\n995:             1,\n996:             Some(\"mailbox_delivery_unconfirmed\"),\n997:             result.terminal_reason.as_deref(),\n998:         ))\n999:         .map_err(|err| err.to_string())?;\n1000:     attempt.guard.mark_finalized();\n1001:     Ok(())\n1002: }\n1003: \n1004: fn record_failed_mailbox_delivery_attempt(\n1005:     input: &ResumeAttemptInput<'_>,\n1006:     delivery_error: &str,\n1007: ) -> Result<(), String> {\n1008:     crate::mailbox_delivery::mark_headless_resume_delivery_failed(\n1009:         input.mailbox_session_id,\n1010:         input.mailbox_delivery_seqs,\n1011:         delivery_error,\n1012:     )\n1013: }\n1014: \n1015: fn failed_delivery_error(result: &executor::ExecutionResult, fallback: &str) -> String {\n1016:     terminal_signal_reason(&result.terminal_signal, result.terminal_reason.as_deref())\n1017:         .or(result.terminal_reason.as_deref())\n1018:         .unwrap_or(fallback)\n1019:         .to_string()\n1020: }\n1021: \n1022: fn mark_resume_attempt_idle(\n1023:     provider_session_id: &str,\n1024:     invocation_uuid: &str,\n1025:     exit_code: Option<i32>,\n1026: ) -> Result<(), String> {\n1027:     crate::wake_coordinator::mark_session_idle_after_turn(\n1028:         provider_session_id,\n1029:         invocation_uuid,\n1030:         exit_code,\n1031:     )\n1032: }\n1033: \n1034: fn resolve_resume_for_headless_execution(\n1035:     agent_runtime_services: &wiring::AgentRuntimeServices,\n1036:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n1037:     session_id: &str,\n1038:     model_name: Option<&str>,\n1039: ) -> Result<oulipoly_state::ResolvedResume, i32> {\n1040:     let output = agent_runtime_services\n1041:         .resume_service\n1042:         .resolve_resume(mapper::resume_service_request(env, session_id, model_name))\n1043:         .map_err(|err| err.to_string());\n1044:     headless_resume_resolution_result(output, env, session_id, model_name)\n1045: }\n1046: \n1047: fn headless_resume_resolution_result(\n1048:     output: Result<ResumeServiceOutput, String>,\n1049:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n1050:     session_id: &str,\n1051:     model_name: Option<&str>,\n1052: ) -> Result<oulipoly_state::ResolvedResume, i32> {\n1053:     match map_headless_resume_resolution(output) {\n1054:         HeadlessResumeResolution::Resolved(resolved) => Ok(resolved),\n1055:         resolution => {\n1056:             render_headless_resume_resolution_error(resolution, env, session_id, model_name);\n1057:             Err(1)\n1058:         }\n1059:     }\n1060: }\n1061: \n1062: enum HeadlessResumeResolution {\n1063:     Resolved(oulipoly_state::ResolvedResume),\n1064:     ProviderModelMismatch { active_provider: String },\n1065:     Rejected(oulipoly_state::ResumeError),\n1066:     ServiceFailure(String),\n1067: }\n1068: \n1069: fn map_headless_resume_resolution(\n1070:     output: Result<ResumeServiceOutput, String>,\n1071: ) -> HeadlessResumeResolution {\n1072:     match output {\n1073:         Ok(ResumeServiceOutput::ResumeResolved { resolved }) => {\n1074:             HeadlessResumeResolution::Resolved(resolved)\n1075:         }\n1076:         Ok(ResumeServiceOutput::ResumeRejected {\n1077:             error:\n1078:                 oulipoly_state::ResumeError::ProviderModelMismatch {\n1079:                     active_provider, ..\n1080:                 },\n1081:         }) => HeadlessResumeResolution::ProviderModelMismatch { active_provider },\n1082:         Ok(ResumeServiceOutput::ResumeRejected { error }) => {\n1083:             HeadlessResumeResolution::Rejected(error)\n1084:         }\n1085:         Err(err) => HeadlessResumeResolution::ServiceFailure(err),\n1086:     }\n1087: }\n1088: \n1089: fn render_headless_resume_resolution_error(\n1090:     resolution: HeadlessResumeResolution,\n1091:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n1092:     session_id: &str,\n1093:     model_name: Option<&str>,\n1094: ) {\n1095:     match resolution {\n1096:         HeadlessResumeResolution::ProviderModelMismatch { active_provider } => {\n1097:             render_resume_model_pool_mismatch(\n1098:                 &env.models,\n1099:                 model_name.unwrap_or(\"<unknown>\"),\n1100:                 session_id,\n1101:                 &active_provider,\n1102:             );\n1103:         }\n1104:         HeadlessResumeResolution::Rejected(error) => render_resume_error(error),\n1105:         HeadlessResumeResolution::ServiceFailure(err) => render_resume_service_failure(&err),\n1106:         HeadlessResumeResolution::Resolved(_) => {}\n1107:     }\n1108: }\n1109: \n1110: fn render_resume_error(error: oulipoly_state::ResumeError) {\n1111:     formatter::emit_stderr(&format_resume_error(error));\n1112: }\n1113: \n1114: fn render_resume_service_failure(error: &str) {\n1115:     formatter::emit_stderr(&format!(\"resume service failed: {error}\"));\n1116: }\n1117: \n1118: fn prepare_initial_headless_resume_target(\n1119:     resolved: &oulipoly_state::ResolvedResume,\n1120:     providers_cfg: &oulipoly_config::ProvidersConfig,\n1121:     stderr_is_terminal: bool,\n1122: ) -> Result<(), i32> {\n1123:     let target = renderable_resume_execution_target(resolved, providers_cfg)?;\n1124:     render_resume_short_line_if_needed(stderr_is_terminal, &resolved.active_provider);\n1125:     validate_headless_resume_target(resolved, &target, &resolved.active_provider)\n1126: }\n1127: \n1128: fn render_resume_short_line_if_needed(stderr_is_terminal: bool, selected_provider: &str) {\n1129:     if crate::dispatch::should_emit_resume_short_line(stderr_is_terminal) {\n1130:         formatter::emit_resume_short_line(selected_provider);\n1131:     }\n1132: }\n1133: \n1134: fn validate_headless_resume_target(\n1135:     resolved: &oulipoly_state::ResolvedResume,\n1136:     target: &crate::resume_cli::ResumeExecutionTarget,\n1137:     selected_provider: &str,\n1138: ) -> Result<(), i32> {\n1139:     if resolved_uses_provider_ref(resolved) {\n1140:         return validate_provider_ref_headless_resume_target(resolved, target, selected_provider)\n1141:             .map_err(|message| provider_ref_resume_block_exit_code(&message));\n1142:     }\n1143:     if headless_resume_target_has_resume(target) {\n1144:         Ok(())\n1145:     } else {\n1146:         Err(headless_missing_resume_block_exit_code(selected_provider))\n1147:     }\n1148: }\n1149: \n1150: fn validate_provider_ref_headless_resume_target(\n1151:     resolved: &oulipoly_state::ResolvedResume,\n1152:     target: &crate::resume_cli::ResumeExecutionTarget,\n1153:     selected_provider: &str,\n1154: ) -> Result<(), String> {\n1155:     let model = require_provider_ref_resolved_model(\n1156:         provider_ref_resolved_model(resolved),\n1157:         selected_provider,\n1158:     )?;\n1159:     require_provider_ref_model_implementation(model, selected_provider)?;\n1160:     let target_member_name = require_provider_ref_target_member_name(\n1161:         provider_ref_target_member_name(model, target.provider_index),\n1162:         selected_provider,\n1163:         target.provider_index,\n1164:     )?;\n1165:     require_provider_ref_resolved_provider(selected_provider, target_member_name)?;\n1166:     require_provider_ref_loaded_provider(\n1167:         selected_provider,\n1168:         provider_ref_loaded_provider_name(target),\n1169:     )\n1170: }\n1171: \n1172: fn require_provider_ref_resolved_model<'a>(\n1173:     model: Option<&'a oulipoly_config::ModelConfig>,\n1174:     selected_provider: &str,\n1175: ) -> Result<&'a oulipoly_config::ModelConfig, String> {\n1176:     model.ok_or_else(|| provider_ref_missing_model_message(selected_provider))\n1177: }\n1178: \n1179: fn require_provider_ref_model_implementation(\n1180:     model: &oulipoly_config::ModelConfig,\n1181:     selected_provider: &str,\n1182: ) -> Result<(), String> {\n1183:     if provider_ref_model_has_implementation(model) {\n1184:         Ok(())\n1185:     } else {\n1186:         Err(provider_ref_missing_implementation_message(\n1187:             selected_provider,\n1188:         ))\n1189:     }\n1190: }\n1191: \n1192: fn require_provider_ref_target_member_name<'a>(\n1193:     target_member_name: Option<&'a str>,\n1194:     selected_provider: &str,\n1195:     provider_index: usize,\n1196: ) -> Result<&'a str, String> {\n1197:     target_member_name\n1198:         .ok_or_else(|| provider_ref_invalid_index_message(selected_provider, provider_index))\n1199: }\n1200: \n1201: fn require_provider_ref_resolved_provider(\n1202:     selected_provider: &str,\n1203:     target_member_name: &str,\n1204: ) -> Result<(), String> {\n1205:     if target_member_name == selected_provider {\n1206:         Ok(())\n1207:     } else {\n1208:         Err(provider_ref_resolved_provider_message(\n1209:             selected_provider,\n1210:             target_member_name,\n1211:         ))\n1212:     }\n1213: }\n1214: \n1215: fn require_provider_ref_loaded_provider(\n1216:     selected_provider: &str,\n1217:     loaded_provider_name: &str,\n1218: ) -> Result<(), String> {\n1219:     if loaded_provider_name == selected_provider {\n1220:         Ok(())\n1221:     } else {\n1222:         Err(provider_ref_loaded_provider_message(\n1223:             selected_provider,\n1224:             loaded_provider_name,\n1225:         ))\n1226:     }\n1227: }\n1228: \n1229: fn provider_ref_resolved_model(\n1230:     resolved: &oulipoly_state::ResolvedResume,\n1231: ) -> Option<&oulipoly_config::ModelConfig> {\n1232:     resolved.model.as_ref()\n1233: }\n1234: \n1235: fn provider_ref_model_has_implementation(model: &oulipoly_config::ModelConfig) -> bool {\n1236:     model.provider.is_some()\n1237: }\n1238: \n1239: fn provider_ref_target_member_name(\n1240:     model: &oulipoly_config::ModelConfig,\n1241:     provider_index: usize,\n1242: ) -> Option<&str> {\n1243:     model\n1244:         .providers\n1245:         .get(provider_index)\n1246:         .map(|provider| provider.name.as_str())\n1247: }\n1248: \n1249: fn provider_ref_loaded_provider_name(target: &crate::resume_cli::ResumeExecutionTarget) -> &str {\n1250:     &target.provider.name\n1251: }\n1252: \n1253: fn provider_ref_missing_model_message(selected_provider: &str) -> String {\n1254:     format!(\"provider-ref resume target {selected_provider} has no model config\")\n1255: }\n1256: \n1257: fn provider_ref_missing_implementation_message(selected_provider: &str) -> String {\n1258:     format!(\"provider-ref resume target {selected_provider} has no provider implementation\")\n1259: }\n1260: \n1261: fn provider_ref_invalid_index_message(selected_provider: &str, provider_index: usize) -> String {\n1262:     format!(\n1263:         \"provider-ref resume target {selected_provider} has invalid provider index {provider_index}\"\n1264:     )\n1265: }\n1266: \n1267: fn provider_ref_resolved_provider_message(\n1268:     selected_provider: &str,\n1269:     resolved_provider: &str,\n1270: ) -> String {\n1271:     format!(\"provider-ref resume target {selected_provider} resolved provider {resolved_provider}\")\n1272: }\n1273: \n1274: fn provider_ref_loaded_provider_message(selected_provider: &str, loaded_provider: &str) -> String {\n1275:     format!(\"provider-ref resume target {selected_provider} loaded provider {loaded_provider}\")\n1276: }\n1277: \n1278: fn headless_resume_target_has_resume(target: &crate::resume_cli::ResumeExecutionTarget) -> bool {\n1279:     target.provider.resume.is_some()\n1280: }\n1281: \n1282: fn headless_missing_resume_block_exit_code(selected_provider: &str) -> i32 {\n1283:     formatter::emit_missing_resume_block(selected_provider);\n1284:     1\n1285: }\n1286: \n1287: fn provider_ref_resume_block_exit_code(message: &str) -> i32 {\n1288:     formatter::emit_stderr(message);\n1289:     1\n1290: }\n1291: \n1292: fn migrate_resume_target(\n1293:     agent_runtime_services: &wiring::AgentRuntimeServices,\n1294:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n1295:     resolved: &mut oulipoly_state::ResolvedResume,\n1296:     target: &mut crate::resume_cli::ResumeExecutionTarget,\n1297:     manual_migrate: Option<&str>,\n1298:     attempts: usize,\n1299:     effective_spawn_cwd: &Path,\n1300: ) -> Result<(), i32> {\n\n(Showing lines 1-1300 of 1545. Use offset=1301 to continue.)\n</content>","metadata":{"preview":"//! ## Declared roles\n//!\n//! `orchestration`, `validator`, `accessor`, `mapper`, `filter`, `predicate`, `formatter`\n\nuse std::collections::HashMap;\nuse std::io::IsTerminal;\nuse std::path::Path;\nuse std::sync::Arc;\n\nuse oulipoly_runtime::provider_registry::{ProviderRegistry, ProviderRegistryOptions};\nuse oulipoly_runtime::services::{\n    ExecutorServiceRequest, InvocationLifecycleServicePort, MigrationServiceOutput,\n    ResumeServiceOutput, ServiceError,\n};\nuse oulipoly_runtime::{executor, sessions};\nuse sha2::{Digest, Sha256};\n\nuse super::disposition::{\n    ResumeLoopControl, ResumeTerminalDispositionInput, confirmed_zero_turn_maybe_quota,\n    handle_terminal_signal_disposition,","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/run/resume/orchestration.rs","text":"//! ## Declared roles\n//!\n//! `orchestration`, `validator`, `accessor`, `mapper`, `filter`, `predicate`, `formatter`\n\nuse std::collections::HashMap;\nuse std::io::IsTerminal;\nuse std::path::Path;\nuse std::sync::Arc;\n\nuse oulipoly_runtime::provider_registry::{ProviderRegistry, ProviderRegistryOptions};\nuse oulipoly_runtime::services::{\n    ExecutorServiceRequest, InvocationLifecycleServicePort, MigrationServiceOutput,\n    ResumeServiceOutput, ServiceError,\n};\nuse oulipoly_runtime::{executor, sessions};\nuse sha2::{Digest, Sha256};\n\nuse super::disposition::{\n    ResumeLoopControl, ResumeTerminalDispositionInput, confirmed_zero_turn_maybe_quota,\n    handle_terminal_signal_disposition,\n};\nuse super::finalization::{\n    CompletedAttemptControl, CompletedAttemptInput, finalize_completed_attempt,\n};\nuse super::{formatter, mapper, validator};\nuse crate::captured_child::emit_captured_child_marker_lines;\nuse crate::cli::inputs::resolve_resume_answer;\nuse crate::invocation::finalize::FinalizerGuard;\nuse crate::migration_providers::load_resume_execution_environment;\nuse crate::quota_zero_turn::{\n    apply_zero_turn_classification_to_result, filter_quota_exhausted_migration_candidates,\n    zero_turn_classification_for_action, zero_turn_classify_after_completion,\n    zero_turn_record_baseline,\n};\nuse crate::resume_cli::{\n    format_resume_error, render_resume_model_pool_mismatch, renderable_resume_execution_target,\n    resume_migration_pool,\n};\nuse crate::spawn_cwd::effective_resume_spawn_cwd;\nuse crate::terminal_outcome_adapter::{\n    TerminalSignalDisposition, apply_age153_terminal_signal_fixture_override,\n    confirm_maybe_quota_exhausted, resume_terminal_signal_for_outcome, terminal_signal_reason,\n};\nuse crate::wiring;\nuse crate::zero_turn_orchestration::{ZeroTurnAction, ZeroTurnConfirmationState, next_action};\n\n#[allow(clippy::too_many_arguments)]\npub(crate) fn run_resume(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    model_name: Option<&str>,\n    session_id: &str,\n    manual_migrate: Option<&str>,\n    prompt: Option<&str>,\n    file: Option<&Path>,\n    working_dir: Option<&Path>,\n    models_dir_override: Option<&Path>,\n) -> Result<i32, String> {\n    if let Some(exit_code) = reject_invalid_resume_input(session_id) {\n        return Ok(exit_code);\n    }\n    if let Some(exit_code) = crate::wake_coordinator::validate_auto_wake_child(session_id)? {\n        return Ok(exit_code);\n    }\n    if !crate::wake_coordinator::is_auto_wake_invocation() {\n        crate::wake_coordinator::reset_manual_resume_wake_claim(session_id)?;\n    }\n    // Source guard marker: agent_runtime_services.resume_service.resolve_resume(ResumeServiceRequest)\n\n    let mut prepared = match prepare_headless_resume_execution(\n        agent_runtime_services,\n        model_name,\n        session_id,\n        prompt,\n        file,\n        working_dir,\n        models_dir_override,\n    )? {\n        Ok(prepared) => prepared,\n        Err(exit_code) => {\n            crate::wake_coordinator::release_current_auto_wake_claim_for_session(session_id);\n            return Ok(exit_code);\n        }\n    };\n    let result = run_resume_loop(ResumeLoopInput {\n        agent_runtime_services,\n        prepared: &mut prepared,\n        manual_migrate,\n        session_id,\n        working_dir,\n    });\n    if failed_auto_wake_exit(&result) {\n        let _ = crate::wake_coordinator::recheck_after_failed_auto_wake(session_id);\n    }\n    result\n}\n\nfn failed_auto_wake_exit(result: &Result<i32, String>) -> bool {\n    crate::wake_coordinator::is_auto_wake_invocation() && !matches!(result, Ok(0))\n}\n\nfn reject_invalid_resume_input(session_id: &str) -> Option<i32> {\n    match validator::validate_resume_input(session_id) {\n        Ok(()) => None,\n        Err(message) => {\n            formatter::emit_stderr(&message);\n            Some(1)\n        }\n    }\n}\n\nstruct PreparedHeadlessResumeExecution {\n    answer: Option<String>,\n    mailbox_session_id: String,\n    mailbox_delivery_seqs: Vec<i64>,\n    mailbox_delivery_nonce: Option<String>,\n    env: crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: oulipoly_state::ResolvedResume,\n    effective_spawn_cwd: std::path::PathBuf,\n    parent_invocation_id: Option<i64>,\n    max_attempts: usize,\n}\n\n#[allow(clippy::too_many_arguments)]\nfn prepare_headless_resume_execution(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    model_name: Option<&str>,\n    session_id: &str,\n    prompt: Option<&str>,\n    file: Option<&Path>,\n    working_dir: Option<&Path>,\n    models_dir_override: Option<&Path>,\n) -> Result<Result<PreparedHeadlessResumeExecution, i32>, String> {\n    let answer = resolve_resume_answer(prompt, file)?;\n    let env = load_resume_execution_environment(models_dir_override)?;\n    refresh_resume_provider_registry(agent_runtime_services, &env)?;\n    let resolved = match resolve_resume_for_headless_execution(\n        agent_runtime_services,\n        &env,\n        session_id,\n        model_name,\n    ) {\n        Ok(resolved) => resolved,\n        Err(exit_code) => return Ok(Err(exit_code)),\n    };\n    if let Err(exit_code) = prepare_initial_headless_resume_target(\n        &resolved,\n        &env.providers_cfg,\n        std::io::stderr().is_terminal(),\n    ) {\n        return Ok(Err(exit_code));\n    }\n    let effective_spawn_cwd = effective_resume_execution_cwd(&env, session_id, working_dir)?;\n    let parent_invocation_id = crate::dispatch::resolve_parent_invocation_id(&env.state);\n    let max_attempts = headless_resume_retry_budget(&resolved);\n    let mailbox_delivery = crate::mailbox_delivery::prepare_headless_resume_delivery(\n        &resolved,\n        answer,\n        Some(&env.models_dir),\n    )?;\n    Ok(Ok(PreparedHeadlessResumeExecution {\n        answer: mailbox_delivery.answer,\n        mailbox_session_id: mailbox_delivery.session_id,\n        mailbox_delivery_seqs: mailbox_delivery.seqs,\n        mailbox_delivery_nonce: mailbox_delivery.delivery_nonce,\n        env,\n        resolved,\n        effective_spawn_cwd,\n        parent_invocation_id,\n        max_attempts,\n    }))\n}\n\nfn refresh_resume_provider_registry(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n) -> Result<(), String> {\n    let models = env.models.values().cloned().collect::<Vec<_>>();\n    let registry =\n        ProviderRegistry::from_model_configs(&models, resume_provider_registry_options(env))\n            .map_err(|err| format!(\"failed to build resume provider registry: {err}\"))?;\n    agent_runtime_services\n        .provider_registry_handle\n        .replace(Arc::new(registry));\n    Ok(())\n}\n\nfn resume_provider_registry_options(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n) -> ProviderRegistryOptions {\n    ProviderRegistryOptions::default()\n        .with_path_entries_from_process_path()\n        .with_config_root(env.config_root.clone())\n        .with_data_root(resume_provider_registry_data_root(env))\n}\n\nfn resume_provider_registry_data_root(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n) -> std::path::PathBuf {\n    oulipoly_state::paths::data_dir().unwrap_or_else(|_| env.config_root.clone())\n}\n\nfn effective_resume_execution_cwd(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    session_id: &str,\n    working_dir: Option<&Path>,\n) -> Result<std::path::PathBuf, String> {\n    effective_resume_spawn_cwd(\n        &env.state,\n        &env.models,\n        &env.providers_cfg,\n        &env.sessions_cfg,\n        session_id,\n        working_dir,\n    )\n}\n\nfn headless_resume_retry_budget(resolved: &oulipoly_state::ResolvedResume) -> usize {\n    resolved\n        .model\n        .as_ref()\n        .map(|model| model.providers.len())\n        .unwrap_or(1)\n        .max(1)\n        + 1\n}\n\nstruct ResumeLoopInput<'a> {\n    agent_runtime_services: &'a wiring::AgentRuntimeServices,\n    prepared: &'a mut PreparedHeadlessResumeExecution,\n    manual_migrate: Option<&'a str>,\n    session_id: &'a str,\n    working_dir: Option<&'a Path>,\n}\n\nfn run_resume_loop(input: ResumeLoopInput<'_>) -> Result<i32, String> {\n    let mut attempts = 0usize;\n    let mut last_exit_code = 1;\n    let mut zero_turn_confirmation = ZeroTurnConfirmationState::new();\n\n    loop {\n        if resume_attempts_exhausted(attempts, input.prepared.max_attempts) {\n            return Ok(resume_attempts_exhausted_exit_code(last_exit_code));\n        }\n        attempts += 1;\n\n        match run_resume_attempt(ResumeAttemptInput {\n            agent_runtime_services: input.agent_runtime_services,\n            env: &input.prepared.env,\n            resolved: &mut input.prepared.resolved,\n            answer: input.prepared.answer.as_deref(),\n            mailbox_session_id: &input.prepared.mailbox_session_id,\n            mailbox_delivery_seqs: &input.prepared.mailbox_delivery_seqs,\n            mailbox_delivery_nonce: input.prepared.mailbox_delivery_nonce.as_deref(),\n            manual_migrate: input.manual_migrate,\n            session_id: input.session_id,\n            working_dir: input.working_dir,\n            attempts,\n            max_attempts: input.prepared.max_attempts,\n            parent_invocation_id: input.prepared.parent_invocation_id,\n            effective_spawn_cwd: &input.prepared.effective_spawn_cwd,\n            zero_turn_confirmation: &mut zero_turn_confirmation,\n        })? {\n            ResumeAttemptLoopControl::Continue(exit_code) => {\n                last_exit_code = exit_code;\n                continue;\n            }\n            ResumeAttemptLoopControl::Return(exit_code) => return Ok(exit_code),\n        }\n    }\n}\n\nfn resume_attempts_exhausted(attempts: usize, max_attempts: usize) -> bool {\n    attempts >= max_attempts\n}\n\nfn resume_attempts_exhausted_exit_code(last_exit_code: i32) -> i32 {\n    formatter::emit_stderr(\"BLOCKED:all-providers-exhausted\");\n    normalized_resume_exhausted_exit_code(last_exit_code)\n}\n\nfn normalized_resume_exhausted_exit_code(last_exit_code: i32) -> i32 {\n    if last_exit_code == 0 {\n        1\n    } else {\n        last_exit_code\n    }\n}\n\nstruct ResumeAttemptInput<'a> {\n    agent_runtime_services: &'a wiring::AgentRuntimeServices,\n    env: &'a crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: &'a mut oulipoly_state::ResolvedResume,\n    answer: Option<&'a str>,\n    mailbox_session_id: &'a str,\n    mailbox_delivery_seqs: &'a [i64],\n    mailbox_delivery_nonce: Option<&'a str>,\n    manual_migrate: Option<&'a str>,\n    session_id: &'a str,\n    working_dir: Option<&'a Path>,\n    attempts: usize,\n    max_attempts: usize,\n    parent_invocation_id: Option<i64>,\n    effective_spawn_cwd: &'a Path,\n    zero_turn_confirmation: &'a mut ZeroTurnConfirmationState,\n}\n\nenum ResumeAttemptLoopControl {\n    Continue(i32),\n    Return(i32),\n}\n\nfn run_resume_attempt(\n    mut input: ResumeAttemptInput<'_>,\n) -> Result<ResumeAttemptLoopControl, String> {\n    let target = match prepare_resume_attempt_target(&mut input)? {\n        Ok(target) => target,\n        Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n    };\n    let provider_index = target.provider_index;\n    let provider = target.provider;\n    let strategy = match resume_attempt_strategy_for_target(input.resolved, &provider) {\n        Ok(strategy) => strategy,\n        Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n    };\n\n    let mut bound_attempt = setup_bound_resume_attempt(&input, &provider, provider_index)?;\n\n    let mut result = match execute_resume_attempt_command(\n        &input,\n        &provider,\n        provider_index,\n        target.prompt_mode,\n        &bound_attempt.invocation_env,\n        strategy,\n    ) {\n        Ok(result) => result,\n        Err(_spawn_err) => return handle_resume_attempt_spawn_error(&input, &mut bound_attempt),\n    };\n\n    handle_resume_attempt_result(&mut input, &mut bound_attempt, &provider, &mut result)\n}\n\nfn handle_resume_attempt_spawn_error(\n    input: &ResumeAttemptInput<'_>,\n    bound_attempt: &mut BoundResumeAttempt<'_>,\n) -> Result<ResumeAttemptLoopControl, String> {\n    record_failed_mailbox_delivery_attempt(input, \"resume_spawn_error\")?;\n    finalize_resume_spawn_error(input, &mut bound_attempt.attempt)?;\n    Ok(ResumeAttemptLoopControl::Return(1))\n}\n\nfn handle_resume_attempt_result(\n    input: &mut ResumeAttemptInput<'_>,\n    bound_attempt: &mut BoundResumeAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    result: &mut executor::ExecutionResult,\n) -> Result<ResumeAttemptLoopControl, String> {\n    apply_resume_attempt_classification(\n        input.env,\n        &provider.name,\n        &bound_attempt.provider_session_id,\n        &bound_attempt.zero_turn_baseline,\n        input.zero_turn_confirmation,\n        result,\n    )\n    .and_then(|zero_turn_action| {\n        record_resume_acceptance_if_present(\n            input,\n            bound_attempt.attempt.invocation_row_id,\n            result,\n        )?;\n        emit_captured_child_marker_lines(&result.captured_child_invocations);\n        handle_resume_attempt_terminal_signal(\n            input,\n            &mut bound_attempt.attempt,\n            provider,\n            &bound_attempt.provider_session_id,\n            result,\n            zero_turn_action,\n        )\n    })\n}\n\nfn resume_attempt_strategy_for_target<'a>(\n    resolved: &oulipoly_state::ResolvedResume,\n    provider: &'a oulipoly_config::ProviderConfig,\n) -> Result<Option<&'a oulipoly_config::ResumeStrategy>, i32> {\n    if resolved_uses_provider_ref(resolved) {\n        return Ok(None);\n    }\n    resume_attempt_strategy(provider).map(Some)\n}\n\nfn resume_attempt_strategy(\n    provider: &oulipoly_config::ProviderConfig,\n) -> Result<&oulipoly_config::ResumeStrategy, i32> {\n    provider\n        .resume\n        .as_ref()\n        .ok_or_else(|| missing_resume_block_exit_code(&provider.name))\n}\n\nfn missing_resume_block_exit_code(provider_name: &str) -> i32 {\n    formatter::emit_missing_resume_block(provider_name);\n    1\n}\n\nfn execute_resume_attempt_command(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_index: usize,\n    prompt_mode: oulipoly_config::PromptMode,\n    invocation_env: &str,\n    strategy: Option<&oulipoly_config::ResumeStrategy>,\n) -> Result<executor::ExecutionResult, String> {\n    if let Some(request) = provider_ref_resume_executor_request(\n        input,\n        provider,\n        provider_index,\n        prompt_mode,\n        invocation_env,\n    ) {\n        return input\n            .agent_runtime_services\n            .executor_service\n            .execute(request)\n            .map(|output| output.result)\n            .map_err(|err| err.to_string());\n    }\n    executor::cli::execute_resume_optional_prompt_with_model_identity(\n        provider,\n        provider_index,\n        prompt_mode,\n        input.answer,\n        Some(input.effective_spawn_cwd),\n        Some(invocation_env),\n        executor::cli::ResumePayload {\n            session_id: &input.resolved.active_session_id,\n            strategy: strategy.expect(\"legacy resume target must have a resume strategy\"),\n        },\n        input.resolved.model_name.as_deref().unwrap_or(\"<unknown>\"),\n    )\n}\n\nfn provider_ref_resume_executor_request(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_index: usize,\n    prompt_mode: oulipoly_config::PromptMode,\n    invocation_env: &str,\n) -> Option<ExecutorServiceRequest> {\n    let model = input.resolved.model.as_ref()?;\n    model.provider.as_ref()?;\n    Some(\n        ExecutorServiceRequest::EffectiveWithStartKnownProviderSessionId {\n            model: model.clone(),\n            provider: provider.clone(),\n            provider_index,\n            prompt_mode,\n            prompt: input.answer.unwrap_or_default().to_string(),\n            working_dir: Some(input.effective_spawn_cwd.to_path_buf()),\n            extra_inputs: HashMap::new(),\n            parent_invocation_env: Some(invocation_env.to_string()),\n            start_known_provider_session_id: input.resolved.active_session_id.clone(),\n        },\n    )\n}\n\nfn finalize_resume_spawn_error(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n) -> Result<(), String> {\n    input\n        .agent_runtime_services\n        .invocation_lifecycle_service\n        .finalize_invocation(mapper::spawn_error_finalize_request(\n            &input.env.state,\n            attempt.invocation_row_id,\n        ))\n        .map_err(|err| err.to_string())?;\n    attempt.guard.mark_finalized();\n    mark_resume_attempt_idle(\n        &input.resolved.active_session_id,\n        &attempt.invocation.id,\n        Some(1),\n    )?;\n    Ok(())\n}\n\nfn prepare_resume_attempt_target(\n    input: &mut ResumeAttemptInput<'_>,\n) -> Result<Result<crate::resume_cli::ResumeExecutionTarget, i32>, String> {\n    let mut target =\n        match renderable_resume_execution_target(input.resolved, &input.env.providers_cfg) {\n            Ok(target) => target,\n            Err(exit_code) => return Ok(Err(exit_code)),\n        };\n    if let Err(exit_code) = migrate_resume_target(\n        input.agent_runtime_services,\n        input.env,\n        input.resolved,\n        &mut target,\n        input.manual_migrate,\n        input.attempts,\n        input.effective_spawn_cwd,\n    ) {\n        return Ok(Err(exit_code));\n    }\n    Ok(Ok(target))\n}\n\nstruct ResumeInvocationAttempt<'state> {\n    invocation: oulipoly_state::CompositeInvocationId,\n    invocation_row_id: i64,\n    guard: FinalizerGuard<'state>,\n}\n\nstruct BoundResumeAttempt<'state> {\n    attempt: ResumeInvocationAttempt<'state>,\n    provider_session_id: String,\n    zero_turn_baseline: crate::zero_turn_orchestration::ZeroTurnBaseline,\n    invocation_env: String,\n}\n\nfn setup_bound_resume_attempt<'state>(\n    input: &ResumeAttemptInput<'state>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_index: usize,\n) -> Result<BoundResumeAttempt<'state>, String> {\n    let attempt = start_resume_invocation(input, provider, provider_index)?;\n    let provider_session_id = input.resolved.active_session_id.clone();\n    bind_resume_attempt_session(\n        input,\n        provider,\n        attempt.invocation_row_id,\n        &provider_session_id,\n    )?;\n    let zero_turn_baseline = zero_turn_record_baseline(\n        &input.env.state,\n        &input.env.sessions_cfg,\n        &provider.name,\n        Some(&provider_session_id),\n    );\n    let invocation_env = resume_invocation_env(&attempt.invocation)?;\n    formatter::emit_stderr(&attempt.invocation.stderr_line());\n    Ok(BoundResumeAttempt {\n        attempt,\n        provider_session_id,\n        zero_turn_baseline,\n        invocation_env,\n    })\n}\n\nfn start_resume_invocation<'state>(\n    input: &ResumeAttemptInput<'state>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_index: usize,\n) -> Result<ResumeInvocationAttempt<'state>, String> {\n    let invocation = mapper::composite_invocation_id(&provider.name);\n    let invocation_start = mapper::resume_invocation_start(\n        &invocation,\n        input.resolved.model_name.as_deref(),\n        &provider.name,\n        provider_index,\n        input.parent_invocation_id,\n    );\n    let invocation_row_id = input\n        .agent_runtime_services\n        .invocation_lifecycle_service\n        .start_invocation(mapper::invocation_lifecycle_start_request(\n            &input.env.state,\n            &invocation_start,\n        ))\n        .map_err(|err| err.to_string())?\n        .invocation_row_id;\n    let guard = FinalizerGuard::new(&input.env.state, invocation_row_id);\n    Ok(ResumeInvocationAttempt {\n        invocation,\n        invocation_row_id,\n        guard,\n    })\n}\n\nfn bind_resume_attempt_session(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    invocation_row_id: i64,\n    provider_session_id: &str,\n) -> Result<(), String> {\n    input.env.state.bind_invocation_provider_session_start(\n        invocation_row_id,\n        &mapper::resumed_provider_session_binding(\n            provider,\n            provider_session_id,\n            Some(input.session_id.to_string()),\n        ),\n    )?;\n    if should_record_legacy_resume_input(input.manual_migrate) {\n        record_legacy_resume_input_session_id(input, invocation_row_id)?;\n    }\n    Ok(())\n}\n\nfn should_record_legacy_resume_input(manual_migrate: Option<&str>) -> bool {\n    manual_migrate.is_some()\n}\n\nfn record_legacy_resume_input_session_id(\n    input: &ResumeAttemptInput<'_>,\n    invocation_row_id: i64,\n) -> Result<(), String> {\n    input\n        .env\n        .state\n        .record_legacy_resume_input_session_id(invocation_row_id, input.session_id)\n}\n\nfn resume_invocation_env(\n    invocation: &oulipoly_state::CompositeInvocationId,\n) -> Result<String, String> {\n    serde_json::to_string(invocation).map_err(|e| format!(\"Failed to serialize invocation id: {e}\"))\n}\n\nfn apply_resume_attempt_classification(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    provider_name: &str,\n    provider_session_id: &str,\n    zero_turn_baseline: &crate::zero_turn_orchestration::ZeroTurnBaseline,\n    zero_turn_confirmation: &mut ZeroTurnConfirmationState,\n    result: &mut executor::ExecutionResult,\n) -> Result<crate::zero_turn_orchestration::ZeroTurnAction, String> {\n    apply_age153_terminal_signal_fixture_override(result);\n    let zero_turn_classification =\n        zero_turn_classify_after_completion(&env.state, &env.sessions_cfg, zero_turn_baseline);\n    apply_zero_turn_classification_to_result(result, provider_name, &zero_turn_classification);\n    Ok(next_action(\n        zero_turn_confirmation,\n        zero_turn_classification_for_action(\n            zero_turn_classification,\n            result,\n            provider_name,\n            Some(provider_session_id),\n        ),\n    ))\n}\n\nfn record_resume_acceptance_if_present(\n    input: &ResumeAttemptInput<'_>,\n    invocation_row_id: i64,\n    result: &executor::ExecutionResult,\n) -> Result<(), String> {\n    let Some(acceptance) = resume_acceptance_result(result) else {\n        return Ok(());\n    };\n    record_resume_acceptance(input, invocation_row_id, acceptance)\n}\n\nfn resume_acceptance_result(\n    result: &executor::ExecutionResult,\n) -> Option<&oulipoly_runtime::executor::ResumeAcceptanceResult> {\n    result.resume_acceptance.as_ref()\n}\n\nfn record_resume_acceptance(\n    input: &ResumeAttemptInput<'_>,\n    invocation_row_id: i64,\n    acceptance: &oulipoly_runtime::executor::ResumeAcceptanceResult,\n) -> Result<(), String> {\n    input\n        .agent_runtime_services\n        .resume_service\n        .record_acceptance(mapper::resume_acceptance_request(\n            &input.env.state,\n            invocation_row_id,\n            acceptance,\n        ))\n        .map_err(format_resume_acceptance_service_error)?;\n    Ok(())\n}\n\nfn format_resume_acceptance_service_error(err: oulipoly_runtime::services::ServiceError) -> String {\n    format!(\"resume acceptance service failed: {err}\")\n}\n\nfn handle_resume_attempt_terminal_signal(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n) -> Result<ResumeAttemptLoopControl, String> {\n    let terminal_signal_disposition = terminal_signal_disposition_for_result(\n        &input.env.state,\n        &attempt.invocation.id,\n        &provider.name,\n        provider_session_id,\n        result,\n        zero_turn_action,\n    );\n\n    let disposition_control = handle_terminal_signal_disposition(ResumeTerminalDispositionInput {\n        agent_runtime_services: input.agent_runtime_services,\n        env: input.env,\n        invocation_row_id: attempt.invocation_row_id,\n        guard: &mut attempt.guard,\n        result,\n        terminal_signal_disposition,\n        zero_turn_action,\n    })?;\n    if let Some(control) = apply_resume_terminal_disposition_outcome(\n        input,\n        attempt,\n        provider_session_id,\n        result,\n        terminal_disposition_outcome(disposition_control, result),\n    )? {\n        return Ok(control);\n    }\n\n    ingest_mailbox_delivery_confirmation_turn_if_needed(input, provider, result, zero_turn_action);\n\n    if let Some(control) = handle_unconfirmed_mailbox_delivery_if_needed(\n        input,\n        attempt,\n        provider,\n        provider_session_id,\n        result,\n        zero_turn_action,\n    )? {\n        return Ok(control);\n    }\n\n    finalize_completed_attempt_for_resume(input, attempt, provider, provider_session_id, result)\n}\n\nfn ingest_mailbox_delivery_confirmation_turn_if_needed(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) {\n    if !mailbox_delivery_requires_turn_confirmation(input, &provider.name, result) {\n        return;\n    }\n    if mailbox_delivery_turn_confirmed(input, &provider.name, result, zero_turn_action) {\n        return;\n    }\n    let report = sessions::scan_provider_session(\n        &provider.name,\n        &input.env.sessions_cfg,\n        &input.env.state,\n        &input.resolved.active_session_id,\n    );\n    emit_pre_confirmation_session_scan_errors(&provider.name, report.errors);\n}\n\nfn emit_pre_confirmation_session_scan_errors(provider_name: &str, errors: Vec<String>) {\n    for error in errors {\n        formatter::emit_stderr(&format!(\n            \"Warning: Session ingest failed for {provider_name}: {error}\"\n        ));\n    }\n}\n\nenum ResumeTerminalDispositionOutcome {\n    Continue(i32),\n    Return(i32),\n    CompletedAttempt,\n}\n\nfn terminal_disposition_outcome(\n    control: ResumeLoopControl,\n    result: &executor::ExecutionResult,\n) -> ResumeTerminalDispositionOutcome {\n    match control {\n        ResumeLoopControl::Continue => ResumeTerminalDispositionOutcome::Continue(result.exit_code),\n        ResumeLoopControl::Return(exit_code) => ResumeTerminalDispositionOutcome::Return(exit_code),\n        ResumeLoopControl::CompletedAttempt => ResumeTerminalDispositionOutcome::CompletedAttempt,\n    }\n}\n\nfn apply_resume_terminal_disposition_outcome(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &ResumeInvocationAttempt<'_>,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    outcome: ResumeTerminalDispositionOutcome,\n) -> Result<Option<ResumeAttemptLoopControl>, String> {\n    match outcome {\n        ResumeTerminalDispositionOutcome::Continue(exit_code) => {\n            record_failed_mailbox_delivery_attempt(\n                input,\n                &failed_delivery_error(result, \"resume_retry\"),\n            )?;\n            mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n            Ok(Some(ResumeAttemptLoopControl::Continue(exit_code)))\n        }\n        ResumeTerminalDispositionOutcome::Return(exit_code) => {\n            record_failed_mailbox_delivery_attempt(\n                input,\n                &failed_delivery_error(result, \"resume_failed\"),\n            )?;\n            mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n            Ok(Some(ResumeAttemptLoopControl::Return(exit_code)))\n        }\n        ResumeTerminalDispositionOutcome::CompletedAttempt => Ok(None),\n    }\n}\n\nfn handle_unconfirmed_mailbox_delivery_if_needed(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) -> Result<Option<ResumeAttemptLoopControl>, String> {\n    if !mailbox_delivery_unconfirmed(input, &provider.name, result, zero_turn_action) {\n        return Ok(None);\n    }\n    record_failed_mailbox_delivery_attempt(input, \"mailbox_delivery_unconfirmed\")?;\n    finalize_unconfirmed_mailbox_delivery(input, attempt, result)?;\n    mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(1))?;\n    Ok(Some(ResumeAttemptLoopControl::Return(1)))\n}\n\nfn finalize_completed_attempt_for_resume(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n) -> Result<ResumeAttemptLoopControl, String> {\n    match finalize_completed_attempt(CompletedAttemptInput {\n        agent_runtime_services: input.agent_runtime_services,\n        env: input.env,\n        invocation: &attempt.invocation,\n        invocation_row_id: attempt.invocation_row_id,\n        guard: &mut attempt.guard,\n        provider_name: &provider.name,\n        model: input.resolved.model.as_ref(),\n        result,\n        working_dir: input.working_dir,\n        manual_migrate: input.manual_migrate,\n        session_id: input.session_id,\n        active_session_id: &input.resolved.active_session_id,\n        effective_spawn_cwd: input.effective_spawn_cwd,\n        attempts: input.attempts,\n        max_attempts: input.max_attempts,\n    })? {\n        CompletedAttemptControl::Continue => {\n            record_failed_mailbox_delivery_attempt(\n                input,\n                &failed_delivery_error(result, \"quota_exhausted\"),\n            )?;\n            mark_resume_attempt_idle(\n                provider_session_id,\n                &attempt.invocation.id,\n                Some(result.exit_code),\n            )?;\n            Ok(ResumeAttemptLoopControl::Continue(result.exit_code))\n        }\n        CompletedAttemptControl::Return(exit_code) => {\n            if exit_code == 0 {\n                crate::mailbox_delivery::mark_headless_resume_delivered(\n                    input.mailbox_session_id,\n                    input.mailbox_delivery_seqs,\n                    &attempt.invocation.id,\n                )?;\n                let _ = crate::wake_coordinator::mark_successful_turn_idle_and_recheck(\n                    provider_session_id,\n                    &attempt.invocation.id,\n                    exit_code,\n                )?;\n            } else {\n                record_failed_mailbox_delivery_attempt(\n                    input,\n                    &failed_delivery_error(result, \"resume_failed\"),\n                )?;\n                mark_resume_attempt_idle(\n                    provider_session_id,\n                    &attempt.invocation.id,\n                    Some(exit_code),\n                )?;\n            }\n            Ok(ResumeAttemptLoopControl::Return(exit_code))\n        }\n    }\n}\n\nfn mailbox_delivery_unconfirmed(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) -> bool {\n    mailbox_delivery_requires_turn_confirmation(input, provider_name, result)\n        && !mailbox_delivery_turn_confirmed(input, provider_name, result, zero_turn_action)\n}\n\nfn mailbox_delivery_requires_turn_confirmation(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n    result: &executor::ExecutionResult,\n) -> bool {\n    result.exit_code == 0\n        && !input.mailbox_delivery_seqs.is_empty()\n        && input.answer.is_some_and(|answer| !answer.trim().is_empty())\n        && input.env.sessions_cfg.get(provider_name).is_some()\n}\n\nfn mailbox_delivery_turn_confirmed(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) -> bool {\n    matches!(zero_turn_action, ZeroTurnAction::Continue)\n        || submitted_user_turn_confirms_mailbox_delivery(input, result)\n        || ingested_user_turn_confirms_mailbox_delivery(input, provider_name)\n}\n\nfn submitted_user_turn_confirms_mailbox_delivery(\n    input: &ResumeAttemptInput<'_>,\n    result: &executor::ExecutionResult,\n) -> bool {\n    let Some(submitted) = result.submitted_user_turn.as_ref() else {\n        return false;\n    };\n    let Some(answer) = input.answer else {\n        return false;\n    };\n    submitted.provider_session_id == input.resolved.active_session_id\n        && submitted_user_turn_payload_confirms_mailbox_delivery(input, submitted, answer)\n}\n\nfn submitted_user_turn_payload_confirms_mailbox_delivery(\n    input: &ResumeAttemptInput<'_>,\n    submitted: &executor::SubmittedUserTurn,\n    answer: &str,\n) -> bool {\n    if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n        return submitted.delivery_nonce.as_deref() == Some(delivery_nonce);\n    }\n    submitted.prompt_sha256 == sha256_hex(answer.as_bytes())\n}\n\nfn ingested_user_turn_confirms_mailbox_delivery(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n) -> bool {\n    if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n        return input\n            .env\n            .state\n            .has_session_user_turn_containing(\n                provider_name,\n                &input.resolved.active_session_id,\n                delivery_nonce,\n            )\n            .unwrap_or(false);\n    }\n\n    let Some(answer) = input.answer else {\n        return false;\n    };\n    input\n        .env\n        .state\n        .has_session_user_text_turn(provider_name, &input.resolved.active_session_id, answer)\n        .unwrap_or(false)\n}\n\nfn sha256_hex(bytes: &[u8]) -> String {\n    let digest = Sha256::digest(bytes);\n    digest.iter().map(|byte| format!(\"{byte:02x}\")).collect()\n}\n\nfn finalize_unconfirmed_mailbox_delivery(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    result: &executor::ExecutionResult,\n) -> Result<(), String> {\n    formatter::emit_stderr(\n        \"resume mailbox delivery was not confirmed by a new session turn; leaving mailbox rows pending\",\n    );\n    input\n        .agent_runtime_services\n        .invocation_lifecycle_service\n        .finalize_invocation(mapper::finalize_request(\n            &input.env.state,\n            attempt.invocation_row_id,\n            false,\n            1,\n            Some(\"mailbox_delivery_unconfirmed\"),\n            result.terminal_reason.as_deref(),\n        ))\n        .map_err(|err| err.to_string())?;\n    attempt.guard.mark_finalized();\n    Ok(())\n}\n\nfn record_failed_mailbox_delivery_attempt(\n    input: &ResumeAttemptInput<'_>,\n    delivery_error: &str,\n) -> Result<(), String> {\n    crate::mailbox_delivery::mark_headless_resume_delivery_failed(\n        input.mailbox_session_id,\n        input.mailbox_delivery_seqs,\n        delivery_error,\n    )\n}\n\nfn failed_delivery_error(result: &executor::ExecutionResult, fallback: &str) -> String {\n    terminal_signal_reason(&result.terminal_signal, result.terminal_reason.as_deref())\n        .or(result.terminal_reason.as_deref())\n        .unwrap_or(fallback)\n        .to_string()\n}\n\nfn mark_resume_attempt_idle(\n    provider_session_id: &str,\n    invocation_uuid: &str,\n    exit_code: Option<i32>,\n) -> Result<(), String> {\n    crate::wake_coordinator::mark_session_idle_after_turn(\n        provider_session_id,\n        invocation_uuid,\n        exit_code,\n    )\n}\n\nfn resolve_resume_for_headless_execution(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    session_id: &str,\n    model_name: Option<&str>,\n) -> Result<oulipoly_state::ResolvedResume, i32> {\n    let output = agent_runtime_services\n        .resume_service\n        .resolve_resume(mapper::resume_service_request(env, session_id, model_name))\n        .map_err(|err| err.to_string());\n    headless_resume_resolution_result(output, env, session_id, model_name)\n}\n\nfn headless_resume_resolution_result(\n    output: Result<ResumeServiceOutput, String>,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    session_id: &str,\n    model_name: Option<&str>,\n) -> Result<oulipoly_state::ResolvedResume, i32> {\n    match map_headless_resume_resolution(output) {\n        HeadlessResumeResolution::Resolved(resolved) => Ok(resolved),\n        resolution => {\n            render_headless_resume_resolution_error(resolution, env, session_id, model_name);\n            Err(1)\n        }\n    }\n}\n\nenum HeadlessResumeResolution {\n    Resolved(oulipoly_state::ResolvedResume),\n    ProviderModelMismatch { active_provider: String },\n    Rejected(oulipoly_state::ResumeError),\n    ServiceFailure(String),\n}\n\nfn map_headless_resume_resolution(\n    output: Result<ResumeServiceOutput, String>,\n) -> HeadlessResumeResolution {\n    match output {\n        Ok(ResumeServiceOutput::ResumeResolved { resolved }) => {\n            HeadlessResumeResolution::Resolved(resolved)\n        }\n        Ok(ResumeServiceOutput::ResumeRejected {\n            error:\n                oulipoly_state::ResumeError::ProviderModelMismatch {\n                    active_provider, ..\n                },\n        }) => HeadlessResumeResolution::ProviderModelMismatch { active_provider },\n        Ok(ResumeServiceOutput::ResumeRejected { error }) => {\n            HeadlessResumeResolution::Rejected(error)\n        }\n        Err(err) => HeadlessResumeResolution::ServiceFailure(err),\n    }\n}\n\nfn render_headless_resume_resolution_error(\n    resolution: HeadlessResumeResolution,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    session_id: &str,\n    model_name: Option<&str>,\n) {\n    match resolution {\n        HeadlessResumeResolution::ProviderModelMismatch { active_provider } => {\n            render_resume_model_pool_mismatch(\n                &env.models,\n                model_name.unwrap_or(\"<unknown>\"),\n                session_id,\n                &active_provider,\n            );\n        }\n        HeadlessResumeResolution::Rejected(error) => render_resume_error(error),\n        HeadlessResumeResolution::ServiceFailure(err) => render_resume_service_failure(&err),\n        HeadlessResumeResolution::Resolved(_) => {}\n    }\n}\n\nfn render_resume_error(error: oulipoly_state::ResumeError) {\n    formatter::emit_stderr(&format_resume_error(error));\n}\n\nfn render_resume_service_failure(error: &str) {\n    formatter::emit_stderr(&format!(\"resume service failed: {error}\"));\n}\n\nfn prepare_initial_headless_resume_target(\n    resolved: &oulipoly_state::ResolvedResume,\n    providers_cfg: &oulipoly_config::ProvidersConfig,\n    stderr_is_terminal: bool,\n) -> Result<(), i32> {\n    let target = renderable_resume_execution_target(resolved, providers_cfg)?;\n    render_resume_short_line_if_needed(stderr_is_terminal, &resolved.active_provider);\n    validate_headless_resume_target(resolved, &target, &resolved.active_provider)\n}\n\nfn render_resume_short_line_if_needed(stderr_is_terminal: bool, selected_provider: &str) {\n    if crate::dispatch::should_emit_resume_short_line(stderr_is_terminal) {\n        formatter::emit_resume_short_line(selected_provider);\n    }\n}\n\nfn validate_headless_resume_target(\n    resolved: &oulipoly_state::ResolvedResume,\n    target: &crate::resume_cli::ResumeExecutionTarget,\n    selected_provider: &str,\n) -> Result<(), i32> {\n    if resolved_uses_provider_ref(resolved) {\n        return validate_provider_ref_headless_resume_target(resolved, target, selected_provider)\n            .map_err(|message| provider_ref_resume_block_exit_code(&message));\n    }\n    if headless_resume_target_has_resume(target) {\n        Ok(())\n    } else {\n        Err(headless_missing_resume_block_exit_code(selected_provider))\n    }\n}\n\nfn validate_provider_ref_headless_resume_target(\n    resolved: &oulipoly_state::ResolvedResume,\n    target: &crate::resume_cli::ResumeExecutionTarget,\n    selected_provider: &str,\n) -> Result<(), String> {\n    let model = require_provider_ref_resolved_model(\n        provider_ref_resolved_model(resolved),\n        selected_provider,\n    )?;\n    require_provider_ref_model_implementation(model, selected_provider)?;\n    let target_member_name = require_provider_ref_target_member_name(\n        provider_ref_target_member_name(model, target.provider_index),\n        selected_provider,\n        target.provider_index,\n    )?;\n    require_provider_ref_resolved_provider(selected_provider, target_member_name)?;\n    require_provider_ref_loaded_provider(\n        selected_provider,\n        provider_ref_loaded_provider_name(target),\n    )\n}\n\nfn require_provider_ref_resolved_model<'a>(\n    model: Option<&'a oulipoly_config::ModelConfig>,\n    selected_provider: &str,\n) -> Result<&'a oulipoly_config::ModelConfig, String> {\n    model.ok_or_else(|| provider_ref_missing_model_message(selected_provider))\n}\n\nfn require_provider_ref_model_implementation(\n    model: &oulipoly_config::ModelConfig,\n    selected_provider: &str,\n) -> Result<(), String> {\n    if provider_ref_model_has_implementation(model) {\n        Ok(())\n    } else {\n        Err(provider_ref_missing_implementation_message(\n            selected_provider,\n        ))\n    }\n}\n\nfn require_provider_ref_target_member_name<'a>(\n    target_member_name: Option<&'a str>,\n    selected_provider: &str,\n    provider_index: usize,\n) -> Result<&'a str, String> {\n    target_member_name\n        .ok_or_else(|| provider_ref_invalid_index_message(selected_provider, provider_index))\n}\n\nfn require_provider_ref_resolved_provider(\n    selected_provider: &str,\n    target_member_name: &str,\n) -> Result<(), String> {\n    if target_member_name == selected_provider {\n        Ok(())\n    } else {\n        Err(provider_ref_resolved_provider_message(\n            selected_provider,\n            target_member_name,\n        ))\n    }\n}\n\nfn require_provider_ref_loaded_provider(\n    selected_provider: &str,\n    loaded_provider_name: &str,\n) -> Result<(), String> {\n    if loaded_provider_name == selected_provider {\n        Ok(())\n    } else {\n        Err(provider_ref_loaded_provider_message(\n            selected_provider,\n            loaded_provider_name,\n        ))\n    }\n}\n\nfn provider_ref_resolved_model(\n    resolved: &oulipoly_state::ResolvedResume,\n) -> Option<&oulipoly_config::ModelConfig> {\n    resolved.model.as_ref()\n}\n\nfn provider_ref_model_has_implementation(model: &oulipoly_config::ModelConfig) -> bool {\n    model.provider.is_some()\n}\n\nfn provider_ref_target_member_name(\n    model: &oulipoly_config::ModelConfig,\n    provider_index: usize,\n) -> Option<&str> {\n    model\n        .providers\n        .get(provider_index)\n        .map(|provider| provider.name.as_str())\n}\n\nfn provider_ref_loaded_provider_name(target: &crate::resume_cli::ResumeExecutionTarget) -> &str {\n    &target.provider.name\n}\n\nfn provider_ref_missing_model_message(selected_provider: &str) -> String {\n    format!(\"provider-ref resume target {selected_provider} has no model config\")\n}\n\nfn provider_ref_missing_implementation_message(selected_provider: &str) -> String {\n    format!(\"provider-ref resume target {selected_provider} has no provider implementation\")\n}\n\nfn provider_ref_invalid_index_message(selected_provider: &str, provider_index: usize) -> String {\n    format!(\n        \"provider-ref resume target {selected_provider} has invalid provider index {provider_index}\"\n    )\n}\n\nfn provider_ref_resolved_provider_message(\n    selected_provider: &str,\n    resolved_provider: &str,\n) -> String {\n    format!(\"provider-ref resume target {selected_provider} resolved provider {resolved_provider}\")\n}\n\nfn provider_ref_loaded_provider_message(selected_provider: &str, loaded_provider: &str) -> String {\n    format!(\"provider-ref resume target {selected_provider} loaded provider {loaded_provider}\")\n}\n\nfn headless_resume_target_has_resume(target: &crate::resume_cli::ResumeExecutionTarget) -> bool {\n    target.provider.resume.is_some()\n}\n\nfn headless_missing_resume_block_exit_code(selected_provider: &str) -> i32 {\n    formatter::emit_missing_resume_block(selected_provider);\n    1\n}\n\nfn provider_ref_resume_block_exit_code(message: &str) -> i32 {\n    formatter::emit_stderr(message);\n    1\n}\n\nfn migrate_resume_target(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: &mut oulipoly_state::ResolvedResume,\n    target: &mut crate::resume_cli::ResumeExecutionTarget,\n    manual_migrate: Option<&str>,\n    attempts: usize,\n    effective_spawn_cwd: &Path,\n) -> Result<(), i32> {","lineStart":1,"lineEnd":1300,"totalLines":1545,"truncated":true}},"title":"src-tauri/src/run/resume/orchestration.rs","time":{"start":1780923316041,"end":1780923316106}},"metadata":{"openai":{"itemId":"fc_0676cb86304500e2016a26bbb3f040819886afffa5886d28c6"}},"id":"prt_ea74d3745001wOfShhk8WeqZaE","sessionID":"ses_158b3e351ffePkuQnC9kglvomy","messageID":"msg_ea74d17ab001lJna4YkNrsywkk"}}
