{"type":"tool_use","timestamp":1780923347764,"sessionID":"ses_158b3e351ffePkuQnC9kglvomy","part":{"type":"tool","tool":"read","callID":"call_cvOI5XTEHcxoVpDd9mVGAi9g","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/scripts/opencode-turns","offset":1,"limit":920},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/scripts/opencode-turns</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: Reference adapter: emit OpenCode exported sessions as normalized JSONL.\n4: \n5: Usage: opencode-turns BASE_DIR [SESSION_ID ...]\n6:    e.g. opencode-turns ~/.local/share/opencode ses_abc123\n7: \n8: Session IDs and message content are read through the public OpenCode CLI.\n9: The command defaults to `opencode`, or to `opencodeN` when BASE_DIR contains\n10: `.opencodeN`; `OPENCODE_BIN` overrides this:\n11:   opencode session list --json\n12:   opencode export <sessionID>\n13: \n14: When SESSION_ID arguments are supplied, they are used directly. If no\n15: SESSION_ID arguments are supplied, the SESSION_ID environment variable is used\n16: as the direct target list. BASE_DIR is accepted for compatibility with existing\n17: session source configuration; implicit discovery uses `opencode session list\n18: --json`, not OpenCode's private storage layout.\n19: \n20: Implicit discovery is bounded to the recent quota-balancing window. If the\n21: session list does not expose timestamps, the adapter falls back to a small cap\n22: of most-recent CLI-listed sessions.\n23: \n24: Emits one JSON object per line on stdout:\n25:   {\"session_id\":\"ses_...\",\"turn_id\":\"msg_...\",\"timestamp\":\"<rfc3339>\",\"role\":\"user|assistant\",\"body\":[{\"type\":\"text\",\"text\":\"...\"}]}\n26: \n27: If an OpenCode CLI call times out, the adapter emits every turn collected so far\n28: and then appends:\n29:   {\"degraded\":true,\"count\":<assistant-turns-collected>}\n30: The process still exits 0 so a partial turn count never hangs provider\n31: selection.\n32: \"\"\"\n33: \n34: import json\n35: import os\n36: import re\n37: import shlex\n38: import signal\n39: import subprocess\n40: import sys\n41: import time\n42: from datetime import datetime, timedelta, timezone\n43: from typing import Any\n44: \n45: \n46: MESSAGE_LIST_KEYS = (\"messages\", \"turns\", \"items\", \"entries\")\n47: CONTENT_NESTED_KEYS = (\"parts\", \"content\", \"message\")\n48: SESSION_ID_RE = re.compile(r\"\\bses_[A-Za-z0-9_-]+\\b\")\n49: SESSION_ID_KEYS = (\"sessionID\", \"sessionId\", \"session_id\", \"id\")\n50: TURN_ID_KEYS = (\"id\", \"messageID\", \"messageId\", \"message_id\")\n51: SESSION_TIMESTAMP_KEYS = (\n52:     \"updatedAt\",\n53:     \"updated_at\",\n54:     \"updated\",\n55:     \"createdAt\",\n56:     \"created_at\",\n57:     \"created\",\n58:     \"timestamp\",\n59:     \"time\",\n60: )\n61: \n62: DEFAULT_WINDOW_HOURS = 6.0\n63: DEFAULT_MAX_SESSIONS = 25\n64: DEFAULT_CALL_TIMEOUT_SECS = 20.0\n65: DEFAULT_DEADLINE_SECS = 60.0\n66: JSON_PARSE_FAILED = object()\n67: \n68: \n69: class Options:\n70:     def __init__(self) -> None:\n71:         self.window_hours = env_float(\"OPENCODE_TURNS_WINDOW_HOURS\", DEFAULT_WINDOW_HOURS)\n72:         self.max_sessions = env_int(\"OPENCODE_TURNS_MAX_SESSIONS\", DEFAULT_MAX_SESSIONS)\n73:         self.call_timeout = env_float(\"OPENCODE_TURNS_CALL_TIMEOUT\", DEFAULT_CALL_TIMEOUT_SECS)\n74:         self.deadline = env_float(\"OPENCODE_TURNS_DEADLINE\", DEFAULT_DEADLINE_SECS)\n75: \n76: \n77: class Deadline:\n78:     def __init__(self, seconds: float) -> None:\n79:         self.started_at = time.monotonic()\n80:         self.seconds = seconds\n81: \n82:     def remaining(self) -> float:\n83:         return max(0.0, self.seconds - (time.monotonic() - self.started_at))\n84: \n85:     def call_timeout(self, max_call_timeout: float) -> float:\n86:         remaining = self.remaining()\n87:         if remaining <= 0:\n88:             return 0.0\n89:         return min(max_call_timeout, remaining)\n90: \n91: \n92: def env_float(name: str, default: float) -> float:\n93:     return positive_float_or_default(parsed_env_float(name), default)\n94: \n95: \n96: def parsed_env_float(name: str) -> float | None:\n97:     return parsed_float_or_none(env_value(name))\n98: \n99: \n100: def env_value(name: str) -> str | None:\n101:     return os.environ.get(name)\n102: \n103: \n104: def parsed_float_or_none(value: str | None) -> float | None:\n105:     if value is None:\n106:         return None\n107:     try:\n108:         return float(value)\n109:     except ValueError:\n110:         return None\n111: \n112: \n113: def positive_float_or_default(value: float | None, default: float) -> float:\n114:     if value is None:\n115:         return default\n116:     return value if value > 0 else default\n117: \n118: \n119: def env_int(name: str, default: int) -> int:\n120:     return positive_int_or_default(parsed_env_int(name), default)\n121: \n122: \n123: def parsed_env_int(name: str) -> int | None:\n124:     return parsed_int_or_none(env_value(name))\n125: \n126: \n127: def parsed_int_or_none(value: str | None) -> int | None:\n128:     if value is None:\n129:         return None\n130:     try:\n131:         return int(value)\n132:     except ValueError:\n133:         return None\n134: \n135: \n136: def positive_int_or_default(value: int | None, default: int) -> int:\n137:     if value is None:\n138:         return default\n139:     return value if value > 0 else default\n140: \n141: \n142: def text_chunk(text: str) -> dict:\n143:     return {\"type\": \"text\", \"text\": text}\n144: \n145: \n146: def canonical_chunk_type(native_type) -> str:\n147:     if not isinstance(native_type, str):\n148:         return \"text\"\n149:     if native_type in (\"input_text\", \"output_text\", \"markdown\"):\n150:         return \"text\"\n151:     return native_type\n152: \n153: \n154: def extract_content_chunks(value) -> list:\n155:     if isinstance(value, str):\n156:         return content_chunks_from_text(value)\n157:     if isinstance(value, list):\n158:         return content_chunks_from_items(value)\n159:     if isinstance(value, dict):\n160:         return content_chunks_from_obj(value)\n161:     return []\n162: \n163: \n164: def content_chunks_from_text(value: str) -> list:\n165:     return [text_chunk(value)]\n166: \n167: \n168: def content_chunks_from_items(values: list) -> list:\n169:     chunks = []\n170:     for item in values:\n171:         chunks.extend(extract_content_chunks(item))\n172:     return chunks\n173: \n174: \n175: def content_chunks_from_obj(obj: dict) -> list:\n176:     chunks = direct_content_chunks_from_obj(obj)\n177:     if chunks:\n178:         return chunks\n179:     return nested_content_chunks_from_obj(obj)\n180: \n181: \n182: def direct_content_chunks_from_obj(obj: dict) -> list:\n183:     candidate = direct_content_candidate_from_obj(obj)\n184:     if candidate is None:\n185:         return []\n186:     return direct_content_chunks_from_candidate(candidate)\n187: \n188: \n189: def direct_content_candidate_from_obj(obj: dict) -> dict | None:\n190:     text = obj.get(\"text\")\n191:     if text is None:\n192:         text = obj.get(\"content\")\n193:     if not isinstance(text, str):\n194:         return None\n195:     return {\"text\": text, \"type\": obj.get(\"type\") or \"text\"}\n196: \n197: \n198: def direct_content_chunks_from_candidate(candidate: dict) -> list:\n199:     return [{\"type\": canonical_chunk_type(candidate[\"type\"]), \"text\": candidate[\"text\"]}]\n200: \n201: \n202: def nested_content_chunks_from_obj(obj: dict) -> list:\n203:     for key in CONTENT_NESTED_KEYS:\n204:         chunks = extract_content_chunks(obj.get(key))\n205:         if chunks:\n206:             return chunks\n207:     return []\n208: \n209: \n210: def unique_values(values: list[str]) -> list[str]:\n211:     seen = set()\n212:     unique = []\n213:     for value in values:\n214:         if value and value not in seen:\n215:             seen.add(value)\n216:             unique.append(value)\n217:     return unique\n218: \n219: \n220: def session_ids_from_value(value: Any) -> list[str]:\n221:     if isinstance(value, str):\n222:         return SESSION_ID_RE.findall(value)\n223:     if isinstance(value, list):\n224:         session_ids = []\n225:         for item in value:\n226:             session_ids.extend(session_ids_from_value(item))\n227:         return session_ids\n228:     if isinstance(value, dict):\n229:         session_ids = []\n230:         for item in value.values():\n231:             session_ids.extend(session_ids_from_value(item))\n232:         return session_ids\n233:     return []\n234: \n235: \n236: def parse_session_list_stdout(stdout: str, options: Options) -> list[str]:\n237:     parsed = parse_session_list_json(stdout)\n238:     if parsed is JSON_PARSE_FAILED:\n239:         return capped_session_ids_from_value(stdout, options.max_sessions)\n240: \n241:     candidates = unique_session_candidates(session_candidates_from_value(parsed))\n242:     if not candidates:\n243:         return capped_session_ids_from_value(parsed, options.max_sessions)\n244: \n245:     return session_ids_from_candidates(candidates, options)\n246: \n247: \n248: def parse_session_list_json(stdout: str):\n249:     try:\n250:         return json.loads(stdout)\n251:     except json.JSONDecodeError:\n252:         return JSON_PARSE_FAILED\n253: \n254: \n255: def capped_session_ids_from_value(value: Any, max_sessions: int) -> list[str]:\n256:     return unique_values(session_ids_from_value(value))[:max_sessions]\n257: \n258: \n259: def session_ids_from_candidates(candidates: list[dict], options: Options) -> list[str]:\n260:     if candidates_have_timestamps(candidates):\n261:         return recent_session_ids(candidates, options.window_hours)\n262:     return capped_candidate_session_ids(candidates, options.max_sessions)\n263: \n264: \n265: def candidates_have_timestamps(candidates: list[dict]) -> bool:\n266:     return any(candidate.get(\"timestamp\") is not None for candidate in candidates)\n267: \n268: \n269: def recent_session_ids(candidates: list[dict], window_hours: float) -> list[str]:\n270:     return session_ids_from_candidates_rows(\n271:         recent_session_candidates(candidates, window_hours)\n272:     )\n273: \n274: \n275: def recent_session_candidates(candidates: list[dict], window_hours: float) -> list[dict]:\n276:     cutoff = datetime.now(timezone.utc) - timedelta(hours=window_hours)\n277:     return [\n278:         candidate\n279:         for candidate in candidates\n280:         if candidate.get(\"timestamp\") is not None and candidate[\"timestamp\"] >= cutoff\n281:     ]\n282: \n283: \n284: def capped_candidate_session_ids(candidates: list[dict], max_sessions: int) -> list[str]:\n285:     return session_ids_from_candidates_rows(\n286:         capped_session_candidates(candidates, max_sessions)\n287:     )\n288: \n289: \n290: def capped_session_candidates(candidates: list[dict], max_sessions: int) -> list[dict]:\n291:     return candidates[:max_sessions]\n292: \n293: \n294: def session_ids_from_candidates_rows(candidates: list[dict]) -> list[str]:\n295:     return [candidate[\"session_id\"] for candidate in candidates]\n296: \n297: \n298: def unique_session_candidates(candidates: list[dict]) -> list[dict]:\n299:     seen = set()\n300:     unique = []\n301:     for candidate in candidates:\n302:         session_id = candidate.get(\"session_id\")\n303:         if not session_id or session_id in seen:\n304:             continue\n305:         seen.add(session_id)\n306:         unique.append(candidate)\n307:     return unique\n308: \n309: \n310: def session_candidates_from_value(value: Any) -> list[dict]:\n311:     if isinstance(value, list):\n312:         return session_candidates_from_items(value)\n313:     if isinstance(value, dict):\n314:         return session_candidates_from_obj(value)\n315:     return []\n316: \n317: \n318: def session_candidates_from_items(values) -> list[dict]:\n319:     candidates = []\n320:     for item in values:\n321:         candidates.extend(session_candidates_from_value(item))\n322:     return candidates\n323: \n324: \n325: def session_candidates_from_obj(obj: dict) -> list[dict]:\n326:     if has_session_candidate_shape(obj):\n327:         return [session_candidate_from_obj(obj)]\n328:     return session_candidates_from_items(obj.values())\n329: \n330: \n331: def has_session_candidate_shape(obj: dict) -> bool:\n332:     return session_list_session_id(obj) is not None\n333: \n334: \n335: def session_candidate_from_obj(obj: dict) -> dict:\n336:     return {\n337:         \"session_id\": session_list_session_id(obj),\n338:         \"timestamp\": session_list_timestamp(obj),\n339:     }\n340: \n341: \n342: def session_list_session_id(obj: dict) -> str | None:\n343:     for value in session_list_session_id_candidates(obj):\n344:         session_id = parsed_session_id(value)\n345:         if session_id:\n346:             return session_id\n347:     return None\n348: \n349: \n350: def session_list_session_id_candidates(obj: dict) -> list[str]:\n351:     candidates = []\n352:     for mapping in info_unwrapped_mappings(obj):\n353:         for key in SESSION_ID_KEYS:\n354:             value = mapping.get(key)\n355:             if not isinstance(value, str):\n356:                 continue\n357:             candidates.append(value)\n358:     return candidates\n359: \n360: \n361: def parsed_session_id(value: str) -> str | None:\n362:     match = SESSION_ID_RE.search(value)\n363:     if match:\n364:         return match.group(0)\n365:     return None\n366: \n367: \n368: def session_list_timestamp(obj: dict) -> datetime | None:\n369:     for value in timestamp_candidate_values(obj, SESSION_TIMESTAMP_KEYS):\n370:         converted = timestamp_datetime(value)\n371:         if converted:\n372:             return converted\n373:     return None\n374: \n375: \n376: def info_unwrapped_mappings(obj: dict) -> list[dict]:\n377:     mappings = [obj]\n378:     info = obj.get(\"info\")\n379:     if isinstance(info, dict):\n380:         mappings.append(info)\n381:     return mappings\n382: \n383: \n384: def metadata_mappings_from_obj(obj: dict) -> list[dict]:\n385:     mappings = info_unwrapped_mappings(obj)\n386:     message = obj.get(\"message\")\n387:     if isinstance(message, dict):\n388:         mappings.extend(info_unwrapped_mappings(message))\n389:     return mappings\n390: \n391: \n392: def timestamp_candidate_mappings(obj: dict) -> list[dict]:\n393:     mappings = []\n394:     for mapping in metadata_mappings_from_obj(obj):\n395:         mappings.append(mapping)\n396:         time_value = mapping.get(\"time\")\n397:         if isinstance(time_value, dict):\n398:             mappings.append(time_value)\n399:     return mappings\n400: \n401: \n402: def timestamp_candidate_values(obj: dict, keys: tuple[str, ...]) -> list:\n403:     values = []\n404:     for mapping in timestamp_candidate_mappings(obj):\n405:         for key in keys:\n406:             values.append(mapping.get(key))\n407:     return values\n408: \n409: \n410: def timestamp_datetime(value) -> datetime | None:\n411:     if isinstance(value, (int, float)):\n412:         return numeric_timestamp_datetime(value)\n413:     if not isinstance(value, str) or not value.strip():\n414:         return None\n415:     stripped = value.strip()\n416:     if re.fullmatch(r\"\\d+(\\.\\d+)?\", stripped):\n417:         return numeric_timestamp_datetime(float(stripped))\n418:     parsed = parsed_iso_timestamp(stripped)\n419:     if parsed is None:\n420:         return None\n421:     return normalized_timestamp_datetime(parsed)\n422: \n423: \n424: def parsed_iso_timestamp(value: str) -> datetime | None:\n425:     normalized = value.replace(\"Z\", \"+00:00\")\n426:     try:\n427:         return datetime.fromisoformat(normalized)\n428:     except ValueError:\n429:         return None\n430: \n431: \n432: def normalized_timestamp_datetime(parsed: datetime) -> datetime:\n433:     if parsed.tzinfo is None:\n434:         parsed = parsed.replace(tzinfo=timezone.utc)\n435:     return parsed.astimezone(timezone.utc)\n436: \n437: \n438: def numeric_timestamp_datetime(value: int | float) -> datetime | None:\n439:     seconds = value / 1000 if value > 10_000_000_000 else value\n440:     try:\n441:         return datetime.fromtimestamp(seconds, tz=timezone.utc)\n442:     except (OverflowError, OSError, ValueError):\n443:         return None\n444: \n445: \n446: def discover_session_ids(options: Options, deadline: Deadline) -> tuple[list[str], bool]:\n447:     stdout, timed_out = run_opencode([\"session\", \"list\", \"--json\"], options, deadline)\n448:     if timed_out:\n449:         return [], True\n450:     if stdout is None:\n451:         return [], False\n452:     return parse_session_list_stdout(stdout, options), False\n453: \n454: \n455: def requested_session_ids(\n456:     args: list[str], options: Options, deadline: Deadline\n457: ) -> tuple[list[str], bool]:\n458:     if args:\n459:         return unique_values(args), False\n460:     env_session_ids = session_ids_from_env()\n461:     if env_session_ids:\n462:         return env_session_ids, False\n463:     return discover_session_ids(options, deadline)\n464: \n465: \n466: def session_ids_from_env() -> list[str]:\n467:     value = os.environ.get(\"SESSION_ID\")\n468:     if value is None:\n469:         return []\n470:     return unique_values(split_env_session_ids(value))\n471: \n472: \n473: def split_env_session_ids(value: str) -> list[str]:\n474:     return [item for item in re.split(r\"[\\s,]+\", value.strip()) if item]\n475: \n476: \n477: def numeric_timestamp(value) -> str | None:\n478:     accepted = accepted_numeric_timestamp(value)\n479:     if accepted is None:\n480:         return None\n481:     return formatted_numeric_timestamp(accepted)\n482: \n483: \n484: def accepted_numeric_timestamp(value) -> int | float | None:\n485:     if not isinstance(value, (int, float)):\n486:         return None\n487:     return value\n488: \n489: \n490: def formatted_numeric_timestamp(value: int | float) -> str:\n491:     seconds = value / 1000 if value > 10_000_000_000 else value\n492:     return datetime.fromtimestamp(seconds, tz=timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\n493: \n494: \n495: def timestamp_from_obj(obj: dict) -> str | None:\n496:     for value in timestamp_candidate_values(\n497:         obj, (\"timestamp\", \"createdAt\", \"created_at\", \"time\", \"created\")\n498:     ):\n499:         converted = timestamp_string(value)\n500:         if converted:\n501:             return converted\n502:     return None\n503: \n504: \n505: def timestamp_string(value) -> str | None:\n506:     if isinstance(value, str) and value:\n507:         return value\n508:     return numeric_timestamp(value)\n509: \n510: \n511: def session_id_from_obj(obj: dict) -> str | None:\n512:     for mapping in metadata_mappings_from_obj(obj):\n513:         for key in (\"sessionID\", \"sessionId\", \"session_id\"):\n514:             value = mapping.get(key)\n515:             if isinstance(value, str) and value:\n516:                 return value\n517:     return None\n518: \n519: \n520: def role_from_obj(obj: dict) -> str | None:\n521:     for mapping in metadata_mappings_from_obj(obj):\n522:         value = mapping.get(\"role\")\n523:         if value in (\"user\", \"assistant\"):\n524:             return value\n525:     return None\n526: \n527: \n528: def turn_id_from_obj(obj: dict, default_session_id: str, index: int) -> str:\n529:     return turn_id_field_from_obj(obj) or fallback_turn_id(default_session_id, index)\n530: \n531: \n532: def turn_id_field_from_obj(obj: dict) -> str | None:\n533:     for mapping in metadata_mappings_from_obj(obj):\n534:         value = turn_id_field_from_mapping(mapping)\n535:         if value:\n536:             return value\n537:     return None\n538: \n539: \n540: def turn_id_field_from_mapping(obj: dict) -> str | None:\n541:     for key in TURN_ID_KEYS:\n542:         value = obj.get(key)\n543:         if isinstance(value, str) and value:\n544:             return value\n545:     return None\n546: \n547: \n548: def fallback_turn_id(default_session_id: str, index: int) -> str:\n549:     return f\"{default_session_id}:{index}\"\n550: \n551: \n552: def opencode_command() -> list[str]:\n553:     configured = configured_opencode_command()\n554:     if configured is None:\n555:         return default_opencode_command(sys.argv)\n556:     return command_tokens_or_default(configured_command_tokens(configured))\n557: \n558: \n559: def configured_opencode_command() -> str | None:\n560:     return os.environ.get(\"OPENCODE_BIN\")\n561: \n562: \n563: def configured_command_tokens(configured: str) -> list[str]:\n564:     return shlex.split(configured)\n565: \n566: \n567: def command_tokens_or_default(tokens: list[str]) -> list[str]:\n568:     return tokens or [\"opencode\"]\n569: \n570: \n571: def default_opencode_command(argv: list[str]) -> list[str]:\n572:     return [opencode_command_name_from_base_dir(base_dir_arg(argv))]\n573: \n574: \n575: def opencode_command_name_from_base_dir(base_dir: str) -> str:\n576:     return formatted_opencode_command_name(opencode_base_dir_suffix(base_dir))\n577: \n578: \n579: def opencode_base_dir_suffix(base_dir: str) -> str | None:\n580:     match = re.search(r\"(?:^|/)\\.opencode([0-9]+)(?:/|$)\", os.path.expanduser(base_dir))\n581:     if match:\n582:         return match.group(1)\n583:     return None\n584: \n585: \n586: def formatted_opencode_command_name(suffix: str | None) -> str:\n587:     if suffix is None:\n588:         return \"opencode\"\n589:     return f\"opencode{suffix}\"\n590: \n591: \n592: def run_opencode(\n593:     args: list[str], options: Options, deadline: Deadline\n594: ) -> tuple[str | None, bool]:\n595:     timeout = deadline.call_timeout(options.call_timeout)\n596:     if opencode_deadline_expired(timeout):\n597:         return degraded_opencode_result()\n598:     try:\n599:         process = spawn_opencode_process(args)\n600:     except OSError:\n601:         return failed_opencode_result()\n602: \n603:     stdout, timed_out = communicate_opencode_process(process, timeout)\n604:     if timed_out:\n605:         kill_process_group(process)\n606:         return degraded_opencode_result()\n607: \n608:     if opencode_process_failed(process):\n609:         return failed_opencode_result()\n610:     return successful_opencode_result(stdout)\n611: \n612: \n613: def opencode_deadline_expired(timeout: float) -> bool:\n614:     return timeout <= 0\n615: \n616: \n617: def spawn_opencode_process(args: list[str]) -> subprocess.Popen:\n618:     return subprocess.Popen(\n619:         opencode_command() + args,\n620:         stdout=subprocess.PIPE,\n621:         stderr=subprocess.PIPE,\n622:         stdin=subprocess.DEVNULL,\n623:         text=True,\n624:         start_new_session=True,\n625:     )\n626: \n627: \n628: def communicate_opencode_process(\n629:     process: subprocess.Popen, timeout: float\n630: ) -> tuple[str | None, bool]:\n631:     try:\n632:         stdout, _stderr = process.communicate(timeout=timeout)\n633:     except subprocess.TimeoutExpired:\n634:         return None, True\n635:     return stdout, False\n636: \n637: \n638: def opencode_process_failed(process: subprocess.Popen) -> bool:\n639:     return process.returncode != 0\n640: \n641: \n642: def degraded_opencode_result() -> tuple[str | None, bool]:\n643:     return None, True\n644: \n645: \n646: def failed_opencode_result() -> tuple[str | None, bool]:\n647:     return None, False\n648: \n649: \n650: def successful_opencode_result(stdout: str | None) -> tuple[str | None, bool]:\n651:     return stdout, False\n652: \n653: \n654: def kill_process_group(process: subprocess.Popen) -> None:\n655:     try:\n656:         os.killpg(process.pid, signal.SIGKILL)\n657:     except (OSError, ProcessLookupError):\n658:         try:\n659:             process.kill()\n660:         except OSError:\n661:             pass\n662:     try:\n663:         process.communicate(timeout=1)\n664:     except subprocess.TimeoutExpired:\n665:         try:\n666:             process.kill()\n667:         except OSError:\n668:             pass\n669:         process.communicate()\n670: \n671: \n672: def parse_export_stdout(stdout: str) -> Any | None:\n673:     try:\n674:         return json.loads(stdout)\n675:     except json.JSONDecodeError:\n676:         return None\n677: \n678: \n679: def export_session(\n680:     session_id: str, options: Options, deadline: Deadline\n681: ) -> tuple[Any | None, bool]:\n682:     stdout, timed_out = run_opencode([\"export\", session_id], options, deadline)\n683:     if timed_out:\n684:         return None, True\n685:     if stdout is None:\n686:         return None, False\n687:     return parse_export_stdout(stdout), False\n688: \n689: \n690: def exported_message_items(exported: Any) -> list[dict]:\n691:     items = exported_message_item_values(exported)\n692:     if items is None:\n693:         return []\n694:     return dict_items(items)\n695: \n696: \n697: def exported_message_item_values(exported: Any) -> list | None:\n698:     if isinstance(exported, list):\n699:         return exported\n700:     if not isinstance(exported, dict):\n701:         return None\n702:     for key in MESSAGE_LIST_KEYS:\n703:         value = exported.get(key)\n704:         if isinstance(value, list):\n705:             return value\n706:     if role_from_obj(exported):\n707:         return [exported]\n708:     return None\n709: \n710: \n711: def dict_items(items: list) -> list[dict]:\n712:     return [item for item in items if isinstance(item, dict)]\n713: \n714: \n715: def record_from_message(default_session_id: str, index: int, obj: dict) -> dict | None:\n716:     fields = message_record_fields(default_session_id, obj)\n717:     if not has_required_message_record_fields(fields):\n718:         return None\n719:     record = message_record_from_fields(\n720:         fields, turn_id_from_obj(obj, default_session_id, index)\n721:     )\n722:     return record_with_optional_body(record, message_body_chunks(obj))\n723: \n724: \n725: def message_record_fields(default_session_id: str, obj: dict) -> dict:\n726:     return {\n727:         \"session_id\": session_id_from_obj(obj) or default_session_id,\n728:         \"role\": role_from_obj(obj),\n729:         \"timestamp\": timestamp_from_obj(obj),\n730:     }\n731: \n732: \n733: def has_required_message_record_fields(fields: dict) -> bool:\n734:     return bool(fields.get(\"session_id\") and fields.get(\"role\") and fields.get(\"timestamp\"))\n735: \n736: \n737: def message_record_from_fields(fields: dict, turn_id: str) -> dict:\n738:     return {\n739:         \"session_id\": fields[\"session_id\"],\n740:         \"turn_id\": turn_id,\n741:         \"timestamp\": fields[\"timestamp\"],\n742:         \"role\": fields[\"role\"],\n743:     }\n744: \n745: \n746: def record_with_optional_body(record: dict, body: list) -> dict:\n747:     if not body:\n748:         return record\n749:     return {**record, \"body\": body}\n750: \n751: \n752: def message_body_chunks(obj: dict) -> list:\n753:     return (\n754:         extract_content_chunks(obj.get(\"parts\"))\n755:         or extract_content_chunks(obj.get(\"content\"))\n756:         or extract_content_chunks(obj.get(\"message\"))\n757:     )\n758: \n759: \n760: def records_from_exported_session(session_id: str, exported: Any) -> list[dict]:\n761:     return present_records(optional_records_from_exported_session(session_id, exported))\n762: \n763: \n764: def optional_records_from_exported_session(\n765:     session_id: str, exported: Any\n766: ) -> list[dict | None]:\n767:     records = []\n768:     for index, obj in enumerate(exported_message_items(exported), start=1):\n769:         records.append(record_from_message(session_id, index, obj))\n770:     return records\n771: \n772: \n773: def present_records(records: list[dict | None]) -> list[dict]:\n774:     return [record for record in records if record]\n775: \n776: \n777: def collect_records(\n778:     session_ids: list[str], options: Options, deadline: Deadline\n779: ) -> tuple[list[dict], bool]:\n780:     records = []\n781:     degraded = False\n782:     for session_id in session_ids:\n783:         exported, timed_out = export_session(session_id, options, deadline)\n784:         if timed_out:\n785:             degraded = True\n786:             break\n787:         if exported is None:\n788:             continue\n789:         records.extend(records_from_exported_session(session_id, exported))\n790:     return records, degraded\n791: \n792: \n793: def emit_record(record: dict, out) -> None:\n794:     out.write(json.dumps(record, separators=(\",\", \":\")))\n795:     out.write(\"\\n\")\n796: \n797: \n798: def assistant_record_count(records: list[dict]) -> int:\n799:     return sum(1 for record in records if record.get(\"role\") == \"assistant\")\n800: \n801: \n802: def emit_degraded_marker(count: int, out) -> None:\n803:     emit_record({\"degraded\": True, \"count\": count}, out)\n804: \n805: \n806: def has_base_dir_arg(argv: list[str]) -> bool:\n807:     return len(argv) >= 2\n808: \n809: \n810: def base_dir_arg(argv: list[str]) -> str:\n811:     return argv[1] if has_base_dir_arg(argv) else \"\"\n812: \n813: \n814: def usage_message() -> str:\n815:     return \"usage: opencode-turns BASE_DIR [SESSION_ID ...]\"\n816: \n817: \n818: def emit_usage(out) -> None:\n819:     print(usage_message(), file=out)\n820: \n821: \n822: def session_args_from_argv(argv: list[str]) -> list[str]:\n823:     return argv[2:]\n824: \n825: \n826: def main() -> int:\n827:     if not has_base_dir_arg(sys.argv):\n828:         emit_usage(sys.stderr)\n829:         return 2\n830:     options = Options()\n831:     deadline = Deadline(options.deadline)\n832:     out = sys.stdout\n833: \n834:     session_ids, discovery_degraded = requested_session_ids(\n835:         session_args_from_argv(sys.argv), options, deadline\n836:     )\n837:     records, export_degraded = collect_records(session_ids, options, deadline)\n838:     for record in records:\n839:         emit_record(record, out)\n840:     if discovery_degraded or export_degraded:\n841:         emit_degraded_marker(assistant_record_count(records), out)\n842:     return 0\n843: \n844: \n845: if __name__ == \"__main__\":\n846:     sys.exit(main())\n\n(End of file - total 846 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"\nReference adapter: emit OpenCode exported sessions as normalized JSONL.\n\nUsage: opencode-turns BASE_DIR [SESSION_ID ...]\n   e.g. opencode-turns ~/.local/share/opencode ses_abc123\n\nSession IDs and message content are read through the public OpenCode CLI.\nThe command defaults to `opencode`, or to `opencodeN` when BASE_DIR contains\n`.opencodeN`; `OPENCODE_BIN` overrides this:\n  opencode session list --json\n  opencode export <sessionID>\n\nWhen SESSION_ID arguments are supplied, they are used directly. If no\nSESSION_ID arguments are supplied, the SESSION_ID environment variable is used\nas the direct target list. BASE_DIR is accepted for compatibility with existing\nsession source configuration; implicit discovery uses `opencode session list\n--json`, not OpenCode's private storage layout.\n\nImplicit discovery is bounded to the recent quota-balancing window. If the","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/scripts/opencode-turns","text":"#!/usr/bin/env python3\n\"\"\"\nReference adapter: emit OpenCode exported sessions as normalized JSONL.\n\nUsage: opencode-turns BASE_DIR [SESSION_ID ...]\n   e.g. opencode-turns ~/.local/share/opencode ses_abc123\n\nSession IDs and message content are read through the public OpenCode CLI.\nThe command defaults to `opencode`, or to `opencodeN` when BASE_DIR contains\n`.opencodeN`; `OPENCODE_BIN` overrides this:\n  opencode session list --json\n  opencode export <sessionID>\n\nWhen SESSION_ID arguments are supplied, they are used directly. If no\nSESSION_ID arguments are supplied, the SESSION_ID environment variable is used\nas the direct target list. BASE_DIR is accepted for compatibility with existing\nsession source configuration; implicit discovery uses `opencode session list\n--json`, not OpenCode's private storage layout.\n\nImplicit discovery is bounded to the recent quota-balancing window. If the\nsession list does not expose timestamps, the adapter falls back to a small cap\nof most-recent CLI-listed sessions.\n\nEmits one JSON object per line on stdout:\n  {\"session_id\":\"ses_...\",\"turn_id\":\"msg_...\",\"timestamp\":\"<rfc3339>\",\"role\":\"user|assistant\",\"body\":[{\"type\":\"text\",\"text\":\"...\"}]}\n\nIf an OpenCode CLI call times out, the adapter emits every turn collected so far\nand then appends:\n  {\"degraded\":true,\"count\":<assistant-turns-collected>}\nThe process still exits 0 so a partial turn count never hangs provider\nselection.\n\"\"\"\n\nimport json\nimport os\nimport re\nimport shlex\nimport signal\nimport subprocess\nimport sys\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Any\n\n\nMESSAGE_LIST_KEYS = (\"messages\", \"turns\", \"items\", \"entries\")\nCONTENT_NESTED_KEYS = (\"parts\", \"content\", \"message\")\nSESSION_ID_RE = re.compile(r\"\\bses_[A-Za-z0-9_-]+\\b\")\nSESSION_ID_KEYS = (\"sessionID\", \"sessionId\", \"session_id\", \"id\")\nTURN_ID_KEYS = (\"id\", \"messageID\", \"messageId\", \"message_id\")\nSESSION_TIMESTAMP_KEYS = (\n    \"updatedAt\",\n    \"updated_at\",\n    \"updated\",\n    \"createdAt\",\n    \"created_at\",\n    \"created\",\n    \"timestamp\",\n    \"time\",\n)\n\nDEFAULT_WINDOW_HOURS = 6.0\nDEFAULT_MAX_SESSIONS = 25\nDEFAULT_CALL_TIMEOUT_SECS = 20.0\nDEFAULT_DEADLINE_SECS = 60.0\nJSON_PARSE_FAILED = object()\n\n\nclass Options:\n    def __init__(self) -> None:\n        self.window_hours = env_float(\"OPENCODE_TURNS_WINDOW_HOURS\", DEFAULT_WINDOW_HOURS)\n        self.max_sessions = env_int(\"OPENCODE_TURNS_MAX_SESSIONS\", DEFAULT_MAX_SESSIONS)\n        self.call_timeout = env_float(\"OPENCODE_TURNS_CALL_TIMEOUT\", DEFAULT_CALL_TIMEOUT_SECS)\n        self.deadline = env_float(\"OPENCODE_TURNS_DEADLINE\", DEFAULT_DEADLINE_SECS)\n\n\nclass Deadline:\n    def __init__(self, seconds: float) -> None:\n        self.started_at = time.monotonic()\n        self.seconds = seconds\n\n    def remaining(self) -> float:\n        return max(0.0, self.seconds - (time.monotonic() - self.started_at))\n\n    def call_timeout(self, max_call_timeout: float) -> float:\n        remaining = self.remaining()\n        if remaining <= 0:\n            return 0.0\n        return min(max_call_timeout, remaining)\n\n\ndef env_float(name: str, default: float) -> float:\n    return positive_float_or_default(parsed_env_float(name), default)\n\n\ndef parsed_env_float(name: str) -> float | None:\n    return parsed_float_or_none(env_value(name))\n\n\ndef env_value(name: str) -> str | None:\n    return os.environ.get(name)\n\n\ndef parsed_float_or_none(value: str | None) -> float | None:\n    if value is None:\n        return None\n    try:\n        return float(value)\n    except ValueError:\n        return None\n\n\ndef positive_float_or_default(value: float | None, default: float) -> float:\n    if value is None:\n        return default\n    return value if value > 0 else default\n\n\ndef env_int(name: str, default: int) -> int:\n    return positive_int_or_default(parsed_env_int(name), default)\n\n\ndef parsed_env_int(name: str) -> int | None:\n    return parsed_int_or_none(env_value(name))\n\n\ndef parsed_int_or_none(value: str | None) -> int | None:\n    if value is None:\n        return None\n    try:\n        return int(value)\n    except ValueError:\n        return None\n\n\ndef positive_int_or_default(value: int | None, default: int) -> int:\n    if value is None:\n        return default\n    return value if value > 0 else default\n\n\ndef text_chunk(text: str) -> dict:\n    return {\"type\": \"text\", \"text\": text}\n\n\ndef canonical_chunk_type(native_type) -> str:\n    if not isinstance(native_type, str):\n        return \"text\"\n    if native_type in (\"input_text\", \"output_text\", \"markdown\"):\n        return \"text\"\n    return native_type\n\n\ndef extract_content_chunks(value) -> list:\n    if isinstance(value, str):\n        return content_chunks_from_text(value)\n    if isinstance(value, list):\n        return content_chunks_from_items(value)\n    if isinstance(value, dict):\n        return content_chunks_from_obj(value)\n    return []\n\n\ndef content_chunks_from_text(value: str) -> list:\n    return [text_chunk(value)]\n\n\ndef content_chunks_from_items(values: list) -> list:\n    chunks = []\n    for item in values:\n        chunks.extend(extract_content_chunks(item))\n    return chunks\n\n\ndef content_chunks_from_obj(obj: dict) -> list:\n    chunks = direct_content_chunks_from_obj(obj)\n    if chunks:\n        return chunks\n    return nested_content_chunks_from_obj(obj)\n\n\ndef direct_content_chunks_from_obj(obj: dict) -> list:\n    candidate = direct_content_candidate_from_obj(obj)\n    if candidate is None:\n        return []\n    return direct_content_chunks_from_candidate(candidate)\n\n\ndef direct_content_candidate_from_obj(obj: dict) -> dict | None:\n    text = obj.get(\"text\")\n    if text is None:\n        text = obj.get(\"content\")\n    if not isinstance(text, str):\n        return None\n    return {\"text\": text, \"type\": obj.get(\"type\") or \"text\"}\n\n\ndef direct_content_chunks_from_candidate(candidate: dict) -> list:\n    return [{\"type\": canonical_chunk_type(candidate[\"type\"]), \"text\": candidate[\"text\"]}]\n\n\ndef nested_content_chunks_from_obj(obj: dict) -> list:\n    for key in CONTENT_NESTED_KEYS:\n        chunks = extract_content_chunks(obj.get(key))\n        if chunks:\n            return chunks\n    return []\n\n\ndef unique_values(values: list[str]) -> list[str]:\n    seen = set()\n    unique = []\n    for value in values:\n        if value and value not in seen:\n            seen.add(value)\n            unique.append(value)\n    return unique\n\n\ndef session_ids_from_value(value: Any) -> list[str]:\n    if isinstance(value, str):\n        return SESSION_ID_RE.findall(value)\n    if isinstance(value, list):\n        session_ids = []\n        for item in value:\n            session_ids.extend(session_ids_from_value(item))\n        return session_ids\n    if isinstance(value, dict):\n        session_ids = []\n        for item in value.values():\n            session_ids.extend(session_ids_from_value(item))\n        return session_ids\n    return []\n\n\ndef parse_session_list_stdout(stdout: str, options: Options) -> list[str]:\n    parsed = parse_session_list_json(stdout)\n    if parsed is JSON_PARSE_FAILED:\n        return capped_session_ids_from_value(stdout, options.max_sessions)\n\n    candidates = unique_session_candidates(session_candidates_from_value(parsed))\n    if not candidates:\n        return capped_session_ids_from_value(parsed, options.max_sessions)\n\n    return session_ids_from_candidates(candidates, options)\n\n\ndef parse_session_list_json(stdout: str):\n    try:\n        return json.loads(stdout)\n    except json.JSONDecodeError:\n        return JSON_PARSE_FAILED\n\n\ndef capped_session_ids_from_value(value: Any, max_sessions: int) -> list[str]:\n    return unique_values(session_ids_from_value(value))[:max_sessions]\n\n\ndef session_ids_from_candidates(candidates: list[dict], options: Options) -> list[str]:\n    if candidates_have_timestamps(candidates):\n        return recent_session_ids(candidates, options.window_hours)\n    return capped_candidate_session_ids(candidates, options.max_sessions)\n\n\ndef candidates_have_timestamps(candidates: list[dict]) -> bool:\n    return any(candidate.get(\"timestamp\") is not None for candidate in candidates)\n\n\ndef recent_session_ids(candidates: list[dict], window_hours: float) -> list[str]:\n    return session_ids_from_candidates_rows(\n        recent_session_candidates(candidates, window_hours)\n    )\n\n\ndef recent_session_candidates(candidates: list[dict], window_hours: float) -> list[dict]:\n    cutoff = datetime.now(timezone.utc) - timedelta(hours=window_hours)\n    return [\n        candidate\n        for candidate in candidates\n        if candidate.get(\"timestamp\") is not None and candidate[\"timestamp\"] >= cutoff\n    ]\n\n\ndef capped_candidate_session_ids(candidates: list[dict], max_sessions: int) -> list[str]:\n    return session_ids_from_candidates_rows(\n        capped_session_candidates(candidates, max_sessions)\n    )\n\n\ndef capped_session_candidates(candidates: list[dict], max_sessions: int) -> list[dict]:\n    return candidates[:max_sessions]\n\n\ndef session_ids_from_candidates_rows(candidates: list[dict]) -> list[str]:\n    return [candidate[\"session_id\"] for candidate in candidates]\n\n\ndef unique_session_candidates(candidates: list[dict]) -> list[dict]:\n    seen = set()\n    unique = []\n    for candidate in candidates:\n        session_id = candidate.get(\"session_id\")\n        if not session_id or session_id in seen:\n            continue\n        seen.add(session_id)\n        unique.append(candidate)\n    return unique\n\n\ndef session_candidates_from_value(value: Any) -> list[dict]:\n    if isinstance(value, list):\n        return session_candidates_from_items(value)\n    if isinstance(value, dict):\n        return session_candidates_from_obj(value)\n    return []\n\n\ndef session_candidates_from_items(values) -> list[dict]:\n    candidates = []\n    for item in values:\n        candidates.extend(session_candidates_from_value(item))\n    return candidates\n\n\ndef session_candidates_from_obj(obj: dict) -> list[dict]:\n    if has_session_candidate_shape(obj):\n        return [session_candidate_from_obj(obj)]\n    return session_candidates_from_items(obj.values())\n\n\ndef has_session_candidate_shape(obj: dict) -> bool:\n    return session_list_session_id(obj) is not None\n\n\ndef session_candidate_from_obj(obj: dict) -> dict:\n    return {\n        \"session_id\": session_list_session_id(obj),\n        \"timestamp\": session_list_timestamp(obj),\n    }\n\n\ndef session_list_session_id(obj: dict) -> str | None:\n    for value in session_list_session_id_candidates(obj):\n        session_id = parsed_session_id(value)\n        if session_id:\n            return session_id\n    return None\n\n\ndef session_list_session_id_candidates(obj: dict) -> list[str]:\n    candidates = []\n    for mapping in info_unwrapped_mappings(obj):\n        for key in SESSION_ID_KEYS:\n            value = mapping.get(key)\n            if not isinstance(value, str):\n                continue\n            candidates.append(value)\n    return candidates\n\n\ndef parsed_session_id(value: str) -> str | None:\n    match = SESSION_ID_RE.search(value)\n    if match:\n        return match.group(0)\n    return None\n\n\ndef session_list_timestamp(obj: dict) -> datetime | None:\n    for value in timestamp_candidate_values(obj, SESSION_TIMESTAMP_KEYS):\n        converted = timestamp_datetime(value)\n        if converted:\n            return converted\n    return None\n\n\ndef info_unwrapped_mappings(obj: dict) -> list[dict]:\n    mappings = [obj]\n    info = obj.get(\"info\")\n    if isinstance(info, dict):\n        mappings.append(info)\n    return mappings\n\n\ndef metadata_mappings_from_obj(obj: dict) -> list[dict]:\n    mappings = info_unwrapped_mappings(obj)\n    message = obj.get(\"message\")\n    if isinstance(message, dict):\n        mappings.extend(info_unwrapped_mappings(message))\n    return mappings\n\n\ndef timestamp_candidate_mappings(obj: dict) -> list[dict]:\n    mappings = []\n    for mapping in metadata_mappings_from_obj(obj):\n        mappings.append(mapping)\n        time_value = mapping.get(\"time\")\n        if isinstance(time_value, dict):\n            mappings.append(time_value)\n    return mappings\n\n\ndef timestamp_candidate_values(obj: dict, keys: tuple[str, ...]) -> list:\n    values = []\n    for mapping in timestamp_candidate_mappings(obj):\n        for key in keys:\n            values.append(mapping.get(key))\n    return values\n\n\ndef timestamp_datetime(value) -> datetime | None:\n    if isinstance(value, (int, float)):\n        return numeric_timestamp_datetime(value)\n    if not isinstance(value, str) or not value.strip():\n        return None\n    stripped = value.strip()\n    if re.fullmatch(r\"\\d+(\\.\\d+)?\", stripped):\n        return numeric_timestamp_datetime(float(stripped))\n    parsed = parsed_iso_timestamp(stripped)\n    if parsed is None:\n        return None\n    return normalized_timestamp_datetime(parsed)\n\n\ndef parsed_iso_timestamp(value: str) -> datetime | None:\n    normalized = value.replace(\"Z\", \"+00:00\")\n    try:\n        return datetime.fromisoformat(normalized)\n    except ValueError:\n        return None\n\n\ndef normalized_timestamp_datetime(parsed: datetime) -> datetime:\n    if parsed.tzinfo is None:\n        parsed = parsed.replace(tzinfo=timezone.utc)\n    return parsed.astimezone(timezone.utc)\n\n\ndef numeric_timestamp_datetime(value: int | float) -> datetime | None:\n    seconds = value / 1000 if value > 10_000_000_000 else value\n    try:\n        return datetime.fromtimestamp(seconds, tz=timezone.utc)\n    except (OverflowError, OSError, ValueError):\n        return None\n\n\ndef discover_session_ids(options: Options, deadline: Deadline) -> tuple[list[str], bool]:\n    stdout, timed_out = run_opencode([\"session\", \"list\", \"--json\"], options, deadline)\n    if timed_out:\n        return [], True\n    if stdout is None:\n        return [], False\n    return parse_session_list_stdout(stdout, options), False\n\n\ndef requested_session_ids(\n    args: list[str], options: Options, deadline: Deadline\n) -> tuple[list[str], bool]:\n    if args:\n        return unique_values(args), False\n    env_session_ids = session_ids_from_env()\n    if env_session_ids:\n        return env_session_ids, False\n    return discover_session_ids(options, deadline)\n\n\ndef session_ids_from_env() -> list[str]:\n    value = os.environ.get(\"SESSION_ID\")\n    if value is None:\n        return []\n    return unique_values(split_env_session_ids(value))\n\n\ndef split_env_session_ids(value: str) -> list[str]:\n    return [item for item in re.split(r\"[\\s,]+\", value.strip()) if item]\n\n\ndef numeric_timestamp(value) -> str | None:\n    accepted = accepted_numeric_timestamp(value)\n    if accepted is None:\n        return None\n    return formatted_numeric_timestamp(accepted)\n\n\ndef accepted_numeric_timestamp(value) -> int | float | None:\n    if not isinstance(value, (int, float)):\n        return None\n    return value\n\n\ndef formatted_numeric_timestamp(value: int | float) -> str:\n    seconds = value / 1000 if value > 10_000_000_000 else value\n    return datetime.fromtimestamp(seconds, tz=timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\n\n\ndef timestamp_from_obj(obj: dict) -> str | None:\n    for value in timestamp_candidate_values(\n        obj, (\"timestamp\", \"createdAt\", \"created_at\", \"time\", \"created\")\n    ):\n        converted = timestamp_string(value)\n        if converted:\n            return converted\n    return None\n\n\ndef timestamp_string(value) -> str | None:\n    if isinstance(value, str) and value:\n        return value\n    return numeric_timestamp(value)\n\n\ndef session_id_from_obj(obj: dict) -> str | None:\n    for mapping in metadata_mappings_from_obj(obj):\n        for key in (\"sessionID\", \"sessionId\", \"session_id\"):\n            value = mapping.get(key)\n            if isinstance(value, str) and value:\n                return value\n    return None\n\n\ndef role_from_obj(obj: dict) -> str | None:\n    for mapping in metadata_mappings_from_obj(obj):\n        value = mapping.get(\"role\")\n        if value in (\"user\", \"assistant\"):\n            return value\n    return None\n\n\ndef turn_id_from_obj(obj: dict, default_session_id: str, index: int) -> str:\n    return turn_id_field_from_obj(obj) or fallback_turn_id(default_session_id, index)\n\n\ndef turn_id_field_from_obj(obj: dict) -> str | None:\n    for mapping in metadata_mappings_from_obj(obj):\n        value = turn_id_field_from_mapping(mapping)\n        if value:\n            return value\n    return None\n\n\ndef turn_id_field_from_mapping(obj: dict) -> str | None:\n    for key in TURN_ID_KEYS:\n        value = obj.get(key)\n        if isinstance(value, str) and value:\n            return value\n    return None\n\n\ndef fallback_turn_id(default_session_id: str, index: int) -> str:\n    return f\"{default_session_id}:{index}\"\n\n\ndef opencode_command() -> list[str]:\n    configured = configured_opencode_command()\n    if configured is None:\n        return default_opencode_command(sys.argv)\n    return command_tokens_or_default(configured_command_tokens(configured))\n\n\ndef configured_opencode_command() -> str | None:\n    return os.environ.get(\"OPENCODE_BIN\")\n\n\ndef configured_command_tokens(configured: str) -> list[str]:\n    return shlex.split(configured)\n\n\ndef command_tokens_or_default(tokens: list[str]) -> list[str]:\n    return tokens or [\"opencode\"]\n\n\ndef default_opencode_command(argv: list[str]) -> list[str]:\n    return [opencode_command_name_from_base_dir(base_dir_arg(argv))]\n\n\ndef opencode_command_name_from_base_dir(base_dir: str) -> str:\n    return formatted_opencode_command_name(opencode_base_dir_suffix(base_dir))\n\n\ndef opencode_base_dir_suffix(base_dir: str) -> str | None:\n    match = re.search(r\"(?:^|/)\\.opencode([0-9]+)(?:/|$)\", os.path.expanduser(base_dir))\n    if match:\n        return match.group(1)\n    return None\n\n\ndef formatted_opencode_command_name(suffix: str | None) -> str:\n    if suffix is None:\n        return \"opencode\"\n    return f\"opencode{suffix}\"\n\n\ndef run_opencode(\n    args: list[str], options: Options, deadline: Deadline\n) -> tuple[str | None, bool]:\n    timeout = deadline.call_timeout(options.call_timeout)\n    if opencode_deadline_expired(timeout):\n        return degraded_opencode_result()\n    try:\n        process = spawn_opencode_process(args)\n    except OSError:\n        return failed_opencode_result()\n\n    stdout, timed_out = communicate_opencode_process(process, timeout)\n    if timed_out:\n        kill_process_group(process)\n        return degraded_opencode_result()\n\n    if opencode_process_failed(process):\n        return failed_opencode_result()\n    return successful_opencode_result(stdout)\n\n\ndef opencode_deadline_expired(timeout: float) -> bool:\n    return timeout <= 0\n\n\ndef spawn_opencode_process(args: list[str]) -> subprocess.Popen:\n    return subprocess.Popen(\n        opencode_command() + args,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        stdin=subprocess.DEVNULL,\n        text=True,\n        start_new_session=True,\n    )\n\n\ndef communicate_opencode_process(\n    process: subprocess.Popen, timeout: float\n) -> tuple[str | None, bool]:\n    try:\n        stdout, _stderr = process.communicate(timeout=timeout)\n    except subprocess.TimeoutExpired:\n        return None, True\n    return stdout, False\n\n\ndef opencode_process_failed(process: subprocess.Popen) -> bool:\n    return process.returncode != 0\n\n\ndef degraded_opencode_result() -> tuple[str | None, bool]:\n    return None, True\n\n\ndef failed_opencode_result() -> tuple[str | None, bool]:\n    return None, False\n\n\ndef successful_opencode_result(stdout: str | None) -> tuple[str | None, bool]:\n    return stdout, False\n\n\ndef kill_process_group(process: subprocess.Popen) -> None:\n    try:\n        os.killpg(process.pid, signal.SIGKILL)\n    except (OSError, ProcessLookupError):\n        try:\n            process.kill()\n        except OSError:\n            pass\n    try:\n        process.communicate(timeout=1)\n    except subprocess.TimeoutExpired:\n        try:\n            process.kill()\n        except OSError:\n            pass\n        process.communicate()\n\n\ndef parse_export_stdout(stdout: str) -> Any | None:\n    try:\n        return json.loads(stdout)\n    except json.JSONDecodeError:\n        return None\n\n\ndef export_session(\n    session_id: str, options: Options, deadline: Deadline\n) -> tuple[Any | None, bool]:\n    stdout, timed_out = run_opencode([\"export\", session_id], options, deadline)\n    if timed_out:\n        return None, True\n    if stdout is None:\n        return None, False\n    return parse_export_stdout(stdout), False\n\n\ndef exported_message_items(exported: Any) -> list[dict]:\n    items = exported_message_item_values(exported)\n    if items is None:\n        return []\n    return dict_items(items)\n\n\ndef exported_message_item_values(exported: Any) -> list | None:\n    if isinstance(exported, list):\n        return exported\n    if not isinstance(exported, dict):\n        return None\n    for key in MESSAGE_LIST_KEYS:\n        value = exported.get(key)\n        if isinstance(value, list):\n            return value\n    if role_from_obj(exported):\n        return [exported]\n    return None\n\n\ndef dict_items(items: list) -> list[dict]:\n    return [item for item in items if isinstance(item, dict)]\n\n\ndef record_from_message(default_session_id: str, index: int, obj: dict) -> dict | None:\n    fields = message_record_fields(default_session_id, obj)\n    if not has_required_message_record_fields(fields):\n        return None\n    record = message_record_from_fields(\n        fields, turn_id_from_obj(obj, default_session_id, index)\n    )\n    return record_with_optional_body(record, message_body_chunks(obj))\n\n\ndef message_record_fields(default_session_id: str, obj: dict) -> dict:\n    return {\n        \"session_id\": session_id_from_obj(obj) or default_session_id,\n        \"role\": role_from_obj(obj),\n        \"timestamp\": timestamp_from_obj(obj),\n    }\n\n\ndef has_required_message_record_fields(fields: dict) -> bool:\n    return bool(fields.get(\"session_id\") and fields.get(\"role\") and fields.get(\"timestamp\"))\n\n\ndef message_record_from_fields(fields: dict, turn_id: str) -> dict:\n    return {\n        \"session_id\": fields[\"session_id\"],\n        \"turn_id\": turn_id,\n        \"timestamp\": fields[\"timestamp\"],\n        \"role\": fields[\"role\"],\n    }\n\n\ndef record_with_optional_body(record: dict, body: list) -> dict:\n    if not body:\n        return record\n    return {**record, \"body\": body}\n\n\ndef message_body_chunks(obj: dict) -> list:\n    return (\n        extract_content_chunks(obj.get(\"parts\"))\n        or extract_content_chunks(obj.get(\"content\"))\n        or extract_content_chunks(obj.get(\"message\"))\n    )\n\n\ndef records_from_exported_session(session_id: str, exported: Any) -> list[dict]:\n    return present_records(optional_records_from_exported_session(session_id, exported))\n\n\ndef optional_records_from_exported_session(\n    session_id: str, exported: Any\n) -> list[dict | None]:\n    records = []\n    for index, obj in enumerate(exported_message_items(exported), start=1):\n        records.append(record_from_message(session_id, index, obj))\n    return records\n\n\ndef present_records(records: list[dict | None]) -> list[dict]:\n    return [record for record in records if record]\n\n\ndef collect_records(\n    session_ids: list[str], options: Options, deadline: Deadline\n) -> tuple[list[dict], bool]:\n    records = []\n    degraded = False\n    for session_id in session_ids:\n        exported, timed_out = export_session(session_id, options, deadline)\n        if timed_out:\n            degraded = True\n            break\n        if exported is None:\n            continue\n        records.extend(records_from_exported_session(session_id, exported))\n    return records, degraded\n\n\ndef emit_record(record: dict, out) -> None:\n    out.write(json.dumps(record, separators=(\",\", \":\")))\n    out.write(\"\\n\")\n\n\ndef assistant_record_count(records: list[dict]) -> int:\n    return sum(1 for record in records if record.get(\"role\") == \"assistant\")\n\n\ndef emit_degraded_marker(count: int, out) -> None:\n    emit_record({\"degraded\": True, \"count\": count}, out)\n\n\ndef has_base_dir_arg(argv: list[str]) -> bool:\n    return len(argv) >= 2\n\n\ndef base_dir_arg(argv: list[str]) -> str:\n    return argv[1] if has_base_dir_arg(argv) else \"\"\n\n\ndef usage_message() -> str:\n    return \"usage: opencode-turns BASE_DIR [SESSION_ID ...]\"\n\n\ndef emit_usage(out) -> None:\n    print(usage_message(), file=out)\n\n\ndef session_args_from_argv(argv: list[str]) -> list[str]:\n    return argv[2:]\n\n\ndef main() -> int:\n    if not has_base_dir_arg(sys.argv):\n        emit_usage(sys.stderr)\n        return 2\n    options = Options()\n    deadline = Deadline(options.deadline)\n    out = sys.stdout\n\n    session_ids, discovery_degraded = requested_session_ids(\n        session_args_from_argv(sys.argv), options, deadline\n    )\n    records, export_degraded = collect_records(session_ids, options, deadline)\n    for record in records:\n        emit_record(record, out)\n    if discovery_degraded or export_degraded:\n        emit_degraded_marker(assistant_record_count(records), out)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","lineStart":1,"lineEnd":846,"totalLines":846,"truncated":false}},"title":"scripts/opencode-turns","time":{"start":1780923347718,"end":1780923347754}},"metadata":{"openai":{"itemId":"fc_07781fe4d4f117d5016a26bbd395848199b05fd31a97760fdd"}},"id":"prt_ea74db300001zrRVLT7nZXgoNQ","sessionID":"ses_158b3e351ffePkuQnC9kglvomy","messageID":"msg_ea74d9280001VU6kcb3poex61l"}}
