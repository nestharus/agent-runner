\n368:         }\n369:         tx.commit()\n370:             .map_err(|err| format!(\"Failed to commit mailbox abandonment transaction: {err}\"))?;\n371:         Ok(changed)\n372:     }\n373: \n374:     pub fn upsert_session_runtime(\n375:         &mut self,\n376:         input: SessionRuntimeUpsert<'_>,\n377:     ) -> Result<(), String> {\n378:         let now = now_rfc3339();\n379:         self.conn\n380:             .execute(\n381:                 \"INSERT INTO session_runtime (\n382:                     session_id,\n383:                     mode,\n384:                     invocation_uuid,\n385:                     provider_name,\n386:                     model_name,\n387:                     pty_control_path,\n388:                     updated_at,\n389:                     models_dir,\n390:                     effective_cwd\n391:                  ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)\n392:                  ON CONFLICT(session_id)\n393:                  DO UPDATE SET\n394:                     mode = excluded.mode,\n395:                     invocation_uuid = excluded.invocation_uuid,\n396:                     provider_name = excluded.provider_name,\n397:                     model_name = excluded.model_name,\n398:                     pty_control_path = excluded.pty_control_path,\n399:                     updated_at = excluded.updated_at,\n400:                     models_dir = COALESCE(excluded.models_dir, session_runtime.models_dir),\n401:                     effective_cwd = COALESCE(excluded.effective_cwd, session_runtime.effective_cwd)\",\n402:                 params![\n403:                     input.session_id,\n404:                     input.mode,\n405:                     input.invocation_uuid,\n406:                     input.provider_name,\n407:                     input.model_name,\n408:                     input.pty_control_path,\n409:                     &now,\n410:                     input.models_dir,\n411:                     input.effective_cwd,\n412:                 ],\n413:             )\n414:             .map_err(|err| format!(\"Failed to upsert session runtime row: {err}\"))?;\n415:         Ok(())\n416:     }\n417: \n418:     pub fn mark_session_running(\n419:         &mut self,\n420:         input: SessionRuntimeRunningUpdate<'_>,\n421:     ) -> Result<(), String> {\n422:         validate_running_run_state()?;\n423:         let now = now_rfc3339();\n424:         let turn_start_max_mailbox_seq = self.running_turn_start_max_mailbox_seq(&input)?;\n425:         mark_session_running_row(&self.conn, input, &now, turn_start_max_mailbox_seq)\n426:     }\n427: \n428:     pub fn mark_session_idle(\n429:         &mut self,\n430:         input: SessionRuntimeIdleUpdate<'_>,\n431:     ) -> Result<bool, String> {\n432:         validate_idle_run_state()?;\n433:         let now = now_rfc3339();\n434:         mark_session_idle_row(&self.conn, input, &now)\n435:     }\n436: \n437:     pub fn session_runtime(&self, session_id: &str) -> Result<Option<SessionRuntimeRow>, String> {\n438:         let row = session_runtime_row(&self.conn, session_id)?;\n439:         validate_session_runtime_row(row.as_ref())?;\n440:         Ok(row)\n441:     }\n442: \n443:     pub fn session_liveness(&mut self, session_id: &str) -> Result<SessionLiveness, String> {\n444:         let row = self.session_runtime(session_id)?;\n445:         let decision = session_runtime_liveness_decision(row.as_ref())?;\n446:         self.clear_stale_running_row_for_liveness(session_id, &decision)?;\n447:         Ok(session_liveness_from_decision(&decision))\n448:     }\n449: \n450:     pub fn try_acquire_wake_claim(\n451:         &mut self,\n452:         input: WakeClaimRequest<'_>,\n453:     ) -> Result<WakeClaimAcquireResult, String> {\n454:         self.try_acquire_or_renew_wake_claim(input, None)\n455:     }\n456: \n457:     pub fn try_acquire_or_renew_wake_claim(\n458:         &mut self,\n459:         input: WakeClaimRequest<'_>,\n460:         renew_token: Option<&str>,\n461:     ) -> Result<WakeClaimAcquireResult, String> {\n462:         if !self.session_has_pending_mailbox(input.session_id)? {\n463:             return Ok(WakeClaimAcquireResult::NoPending);\n464:         }\n465:         if self.session_is_busy(input.session_id)? {\n466:             return Ok(WakeClaimAcquireResult::Busy);\n467:         }\n468:         let now = now_rfc3339();\n469:         let tx = self\n470:             .conn\n471:             .transaction()\n472:             .map_err(|err| format!(\"Failed to start wake claim transaction: {err}\"))?;\n473:         let pending_bounds = pending_seq_bounds_tx(&tx, input.session_id)?;\n474:         let Some((min_seq, max_seq)) = pending_bounds else {\n475:             tx.commit()\n476:                 .map_err(|err| format!(\"Failed to commit empty wake claim transaction: {err}\"))?;\n477:             return Ok(WakeClaimAcquireResult::NoPending);\n478:         };\n479:         if let Some(existing) = fresh_in_flight_wake_claim(\n480:             &tx,\n481:             wake_claim_tx(&tx, input.session_id)?,\n482:             input.stale_after_seconds,\n483:             renew_token,\n484:         )? {\n485:             tx.commit().map_err(|err| {\n486:                 format!(\"Failed to commit existing wake claim transaction: {err}\")\n487:             })?;\n488:             return Ok(WakeClaimAcquireResult::AlreadyInFlight(existing));\n489:         }\n490:         let claim = acquire_wake_claim_tx(&tx, input, &now, min_seq, max_seq)?;\n491:         tx.commit()\n492:             .map_err(|err| format!(\"Failed to commit wake claim transaction: {err}\"))?;\n493:         Ok(WakeClaimAcquireResult::Acquired(claim))\n494:     }\n495: \n496:     pub fn wake_claim(&self, session_id: &str) -> Result<Option<WakeClaimRow>, String> {\n497:         wake_claim(&self.conn, session_id)\n498:     }\n499: \n500:     pub fn release_wake_claim(\n501:         &mut self,\n502:         session_id: &str,\n503:         claim_token: Option<&str>,\n504:     ) -> Result<bool, String> {\n505:         let changed = match claim_token {\n506:             Some(token) => self.conn.execute(\n507:                 \"DELETE FROM session_wake_claim WHERE session_id = ?1 AND claim_token = ?2\",\n508:                 params![session_id, token],\n509:             ),\n510:             None => self.conn.execute(\n511:                 \"DELETE FROM session_wake_claim WHERE session_id = ?1\",\n512:                 params![session_id],\n513:             ),\n514:         }\n515:         .map_err(|err| format!(\"Failed to release wake claim: {err}\"))?;\n516:         Ok(changed > 0)\n517:     }\n518: \n519:     pub fn record_wake_claim_pid(\n520:         &mut self,\n521:         session_id: &str,\n522:         claim_token: &str,\n523:         wake_pid: i64,\n524:     ) -> Result<bool, String> {\n525:         let changed = self\n526:             .conn\n527:             .execute(\n528:                 \"UPDATE session_wake_claim\n529:                  SET wake_pid = ?3\n530:                  WHERE session_id = ?1\n531:                    AND claim_token = ?2\",\n532:                 params![session_id, claim_token, wake_pid],\n533:             )\n534:             .map_err(|err| format!(\"Failed to record wake claim PID: {err}\"))?;\n535:         Ok(changed > 0)\n536:     }\n537: \n538:     pub fn record_wake_claim_pid_identity(\n539:         &mut self,\n540:         session_id: &str,\n541:         claim_token: &str,\n542:         wake_pid: i64,\n543:         provider_name: Option<&str>,\n544:         model_name: Option<&str>,\n545:     ) -> Result<bool, String> {\n546:         if let Some(identity) = pid_identity::read_live_process_identity(wake_pid)? {\n547:             let recorded_at = now_rfc3339();\n548:             pid_identity::PidIdentityDb::open(self.path())?.record_identity(\n549:                 pid_identity::PidIdentityRecord {\n550:                     identity: &identity,\n551:                   