n565: \n566: fn run_session_script_with_timeout(\n567:     script: &str,\n568:     state_dir: &std::path::Path,\n569:     session_id: Option<&str>,\n570:     script_kind: &str,\n571:     timeout_secs: u64,\n572: ) -> Result<String, String> {\n573:     let mut cmd = session_script_command(script, state_dir, session_id);\n574:     let mut child = spawn_session_script_child(&mut cmd, script_kind)?;\n575: \n576:     // Drain stdout/stderr concurrently. A naive `try_wait` loop deadlocks\n577:     // for scripts that produce more than ~64KB on stdout: the kernel pipe\n578:     // fills up, the script blocks on write, the loop waits for exit forever.\n579:     let stdout_handle = spawn_stdout_reader(take_child_stdout(&mut child));\n580:     let stderr_handle = spawn_stderr_reader(take_child_stderr(&mut child));\n581:     let status = wait_for_session_script(&mut child, script_kind, timeout_secs)?;\n582:     let stdout_text = join_script_reader(stdout_handle);\n583:     let stderr_text = join_script_reader(stderr_handle);\n584: \n585:     validate_session_script_success(script_kind, status, &stderr_text)?;\n586:     Ok(stdout_text)\n587: }\n588: \n589: fn validate_session_script_success(\n590:     script_kind: &str,\n591:     status: ExitStatus,\n592:     stderr_text: &str,\n593: ) -> Result<(), String> {\n594:     if status.success() {\n595:         Ok(())\n596:     } else {\n597:         Err(format_session_script_nonzero(\n598:             script_kind,\n599:             status,\n600:             stderr_text,\n601:         ))\n602:     }\n603: }\n604: \n605: fn session_script_command(\n606:     script: &str,\n607:     state_dir: &std::path::Path,\n608:     session_id: Option<&str>,\n609: ) -> Command {\n610:     let mut cmd = Command::new(\"sh\");\n611:     cmd.arg(\"-c\").arg(script);\n612:     cmd.env(\"STATE_DIR\", state_dir);\n613:     if let Some(session_id) = session_id {\n614:         cmd.env(\"SESSION_ID\", session_id);\n615:     }\n616:     cmd.stdin(Stdio::null()