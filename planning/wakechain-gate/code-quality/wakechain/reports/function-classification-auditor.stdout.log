time::Duration::from_secs(timeout_secs);\n680:     let start = std::time::Instant::now();\n681:     loop {\n682:         match poll_session_script(child) {\n683:             Ok(Some(status)) => return Ok(status),\n684:             Ok(None) => {\n685:                 wait_for_pending_session_script(child, start, timeout, script_kind, timeout_secs)?\n686:             }\n687:             Err(error) => return Err(format_session_script_wait_error(script_kind, error)),\n688:         }\n689:     }\n690: }\n691: \n692: fn poll_session_script(child: &mut Child) -> Result<Option<ExitStatus>, std::io::Error> {\n693:     child.try_wait()\n694: }\n695: \n696: fn wait_for_pending_session_script(\n697:     child: &mut Child,\n698:     start: std::time::Instant,\n699:     timeout: std::time::Duration,\n700:     script_kind: &str,\n701:     timeout_secs: u64,\n702: ) -> Result<(), String> {\n703:     if pending_session_script_timed_out(start, timeout) {\n704:         return fail_timed_out_pending_session_script(child, script_kind, timeout_secs);\n705:     }\n706:     sleep_before_next_session_script_poll();\n707:     Ok(())\n708: }\n709: \n710: fn pending_session_script_timed_out(\n711:     start: std::time::Instant,\n712:     timeout: std::time::Duration,\n713: ) -> bool {\n714:     start.elapsed() >= timeout\n715: }\n716: \n717: fn fail_timed_out_pending_session_script(\n718:     child: &mut Child,\n719:     script_kind: &str,\n720:     timeout_secs: u64,\n721: ) -> Result<(), String> {\n722:     kill_timed_out_pending_session_script(child);\n723:     Err(format_pending_session_script_timeout(\n724:         script_kind,\n725:         timeout_secs,\n726:     ))\n727: }\n728: \n729: fn kill_timed_out_pending_session_script(child: &mut Child) {\n730:     kill_session_script_process_group(child);\n731: }\n732: \n733: #[cfg(unix)]\n734: fn kill_session_script_process_group(child: &mut Child) {\n735:     let pgid = -(child.id() as libc::pid_t);\n736:     // SAFETY: `pgid` targets the process group created with `process_group(0)`\n737:     // for this child. Killing the group prevents shell grandchildren from\n738:     // continuing to run or holding stdout/stderr pipes after timeout.\n739:     let _ = unsafe { libc::kill(pgid, libc::SIGKILL) };\n740:     let _ = child.kill();\n741:     let _ = child.wait();\n742: }\n743: \n744: #[cfg(not(unix))]\n745: fn kill_session_script_process_group(child: &mut Child) {\n746:     let _ = child.kill();\n747:     let _ = child.wait();\n748: }\n749: \n750: fn sleep_before_next_session_script_poll() {\n751:     std::thread::sleep(std::time::Duration::from_millis(50));\n752: }\n753: \n754: fn format_pending_session_script_timeout(script_kind: &str, timeout_secs: u64) -> String {\n755:     format!(\"script_timeout: {script_kind} timed out after {timeout_secs}s\")\n756: }\n757: \n758: fn format_session_script_wait_error(script_kind: &str, error: std::io::Error) -> String {\n759:     format!(\n760:         \"{} wait failed: {error}\",\n761:         capitalize_script_kind(script_kind)\n762:     )\n763: }\n764: \n765: fn join_script_reader(handle: JoinHandle<String>) -> String {\n766:     handle.join().unwrap_or_default()\n767: }\n768: \n769: fn format_session_script_nonzero(\n770:     script_kind: &str,\n771:     status: ExitStatus,\n772:     stderr_text: &str,\n773: ) -> String {\n774:     format!(\n775:         \"{} exited {}: {}\",\n776:         capitalize_script_kind(script_kind),\n777:         status.code().unwrap_or(-1),\n778:         stderr_text.trim()\n779:     )\n780: }\n781: \n782: fn capitalize_script_kind(kind: &str) -> String {\n783:     let mut chars = kind.chars();\n784:     match chars.next() {\n785:         Some(first) => first.to_uppercase().collect::<String>() + chars.as_str(),\n786:         None => kind.to_string(),\n787:     }\n788: }\n789: \n790: #[cfg(test)]\n791: mod tests {\n792:     use super::*;\n793:     use std::collections::HashMap;\n794:     use std::os::unix::fs::PermissionsExt;\n795:  