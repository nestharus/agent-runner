     turn, timestamp, body, body_error,\n304:     ))\n305: }\n306: \n307: struct ParsedScriptTurnIngest {\n308:     ingest: SessionTurnIngest,\n309:     body_error: Option<String>,\n310: }\n311: \n312: enum ValidatedScriptTurnBody<'a> {\n313:     Accepted(Option<&'a Value>),\n314:     Rejected(String),\n315: }\n316: \n317: fn parsed_script_turn_ingest(\n318:     ingest: SessionTurnIngest,\n319:     body_error: Option<String>,\n320: ) -> ParsedScriptTurnIngest {\n321:     ParsedScriptTurnIngest { ingest, body_error }\n322: }\n323: \n324: fn parse_script_turn_line(trimmed: &str) -> Result<ScriptTurn, String> {\n325:     serde_json::from_str(trimmed).map_err(|error| format_malformed_turn_line(error, trimmed))\n326: }\n327: \n328: fn format_malformed_turn_line(error: serde_json::Error, trimmed: &str) -> String {\n329:     format!(\"malformed turn line ({error}): {trimmed}\")\n330: }\n331: \n332: fn parse_script_turn_timestamp(timestamp: &str) -> Result<DateTime<Utc>, String> {\n333:     DateTime::parse_from_rfc3339(timestamp)\n334:         .map(|timestamp| timestamp.with_timezone(&Utc))\n335:         .map_err(|error| format_bad_timestamp(timestamp, error))\n336: }\n337: \n338: fn format_bad_timestamp(timestamp: &str, error: chrono::ParseError) -> String {\n339:     format!(\"bad timestamp {timestamp}: {error}\")\n340: }\n341: \n342: fn validate_script_turn_body<'a>(\n343:     provider_name: &str,\n344:     line_number: u64,\n345:     body: &'a Option<Value>,\n346: ) -> ValidatedScriptTurnBody<'a> {\n347:     let Some(body) = body else {\n348:         return ValidatedScriptTurnBody::Accepted(None);\n349:     };\n350:     match validate_script_turn_body_shape(provider_name, line_number, body) {\n351:         Ok(()) => ValidatedScriptTurnBody::Accepted(Some(body)),\n352:         Err(error) => ValidatedScriptTurnBody::Rejected(error),\n353:     }\n354: }\n355: \n356: fn validate_script_turn_body_shape(\n357:     provider_name: &str,\n358:     line_number: u64,\n359:     bod