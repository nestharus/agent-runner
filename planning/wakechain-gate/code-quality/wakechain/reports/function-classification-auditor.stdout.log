{\n138:         Ok(stdout) => stdout,\n139:         Err(error) => return scan_report_with_error(report, error),\n140:     };\n141: \n142:     let batch = collect_turn_script_batch(provider_name, &stdout, &mut report);\n143:     persist_scanned_turns(provider_name, db, &batch, &mut report);\n144:     report\n145: }\n146: \n147: fn scan_provider_session_with_timeout(\n148:     provider_name: &str,\n149:     sessions_cfg: &SessionsConfig,\n150:     db: &StateDb,\n151:     session_id: &str,\n152:     timeout_secs: u64,\n153: ) -> ScanReport {\n154:     let mut report = ScanReport::default();\n155:     let Some(entry) = provider_session_source(sessions_cfg, provider_name) else {\n156:         return report;\n157:     };\n158: \n159:     let state_dir = resolve_state_dir(provider_name, entry);\n160:     if let Err(error) = create_session_state_dir(&state_dir) {\n161:         return scan_report_with_error(report, error);\n162:     }\n163: \n164:     let stdout = match run_session_script_with_timeout(\n165:         &entry.turn_script,\n166:         &state_dir,\n167:         Some(session_id),\n168:         \"turn script\",\n169:         timeout_secs,\n170:     ) {\n171:         Ok(stdout) => stdout,\n172:         Err(error) => return scan_report_with_error(report, error),\n173:     };\n174: \n175:     let batch = collect_turn_script_batch(provider_name, &stdout, &mut report);\n176:     persist_scanned_turns(provider_name, db, &batch, &mut report);\n177:     report\n178: }\n179: \n180: fn provider_session_source<'a>(\n181:     sessions_cfg: &'a SessionsConfig,\n182:     provider_name: &str,\n183: ) -> Option<&'a SessionSourceEntry> {\n184:     sessions_cfg.get(provider_name)\n185: }\n186: \n187: fn scan_report_with_error(mut report: ScanReport, error: String) -> ScanReport {\n188:     report.errors.push(error);\n189:     report\n190: }\n191: \n192: fn create_session_state_dir(state_dir: &std::path::Path) -> Result<(), String> {\n193:     std::fs::create_dir_all(state_dir)\n194:         .map_err(|error| format_state_dir_create_error(state_dir, error))\n195: }\n196: \n197: fn format_state_dir_create_error(state_dir: &std::path::Path, error: std::io::Error) -> String {\n198:     format!(\n199:         \"could not create state_dir {}: {error}\",\n200:         state_dir.display()\n201:     )\n202: }\n203: \n204: fn collect_turn_script_batch(\n205:     provider_name: &str,\n206:     stdout: &str,\n207:     report: &mut ScanReport,\n208: ) -> Vec<SessionTurnIngest> {\n209:     let mut batch = Vec::new();\n210:     for line in non_empty_script_lines(stdout) {\n211:         let line_number = record_script_line_seen(report);\n212:         if let Some(error) = degraded_marker_error(line) {\n213:             record_scan_error(report, error);\n214:             continue;\n215:         }\n216:         match script_line_to_ingest(provider_name, line, line_number) {\n217:             Ok(parsed) => {\n218:                 record_optional_scan_error(report, parsed.body_error);\n219:                 push_script_turn_ingest(&mut batch, parsed.ingest);\n220:             }\n221:             Err(error) => record_scan_error(report, error),\n222:         }\n223:     }\n224:     batch\n225: }\n226: \n227: fn degraded_marker_error(trimmed: &str) -> Option<String> {\n228:     let marker = parse_degraded_marker_jsonl(trimmed)?;\n229:     if !is_degraded_marker(&marker) {\n230:         return None;\n231:     }\n232:     Some(format_degraded_marker_error(degraded_marker_count(&marker)))\n233: }\n234: \n235: fn parse_degraded_marker_jsonl(trimmed: &str) -> Option<Value> {\n236:     serde_json::from_str(trimmed).ok()\n237: }\n238: \n239: fn is_degraded_marker(value: &Value) -> bool {\n240:     match value {\n241:         Value::Object(map) => map.get(\"degraded\").and_then(Value::as_bool) == Some(true),\n242:         _ => false,\n243:     }\n244: }\n245: \n246: fn degraded_marker_count(value: &Value) -> u64 {\n247:     match value {\n248:         Value::Object(map) => m