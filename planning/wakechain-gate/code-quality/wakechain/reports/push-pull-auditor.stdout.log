{"type":"tool_use","timestamp":1780923557765,"sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","part":{"type":"tool","tool":"read","callID":"call_M46l9dlkAbfg0q5abbjziHPi","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/scripts/opencode-turns","offset":1,"limit":760},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/scripts/opencode-turns</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: Reference adapter: emit OpenCode exported sessions as normalized JSONL.\n4: \n5: Usage: opencode-turns BASE_DIR [SESSION_ID ...]\n6:    e.g. opencode-turns ~/.local/share/opencode ses_abc123\n7: \n8: Session IDs and message content are read through the public OpenCode CLI.\n9: The command defaults to `opencode`, or to `opencodeN` when BASE_DIR contains\n10: `.opencodeN`; `OPENCODE_BIN` overrides this:\n11:   opencode session list --json\n12:   opencode export <sessionID>\n13: \n14: When SESSION_ID arguments are supplied, they are used directly. If no\n15: SESSION_ID arguments are supplied, the SESSION_ID environment variable is used\n16: as the direct target list. BASE_DIR is accepted for compatibility with existing\n17: session source configuration; implicit discovery uses `opencode session list\n18: --json`, not OpenCode's private storage layout.\n19: \n20: Implicit discovery is bounded to the recent quota-balancing window. If the\n21: session list does not expose timestamps, the adapter falls back to a small cap\n22: of most-recent CLI-listed sessions.\n23: \n24: Emits one JSON object per line on stdout:\n25:   {\"session_id\":\"ses_...\",\"turn_id\":\"msg_...\",\"timestamp\":\"<rfc3339>\",\"role\":\"user|assistant\",\"body\":[{\"type\":\"text\",\"text\":\"...\"}]}\n26: \n27: If an OpenCode CLI call times out, the adapter emits every turn collected so far\n28: and then appends:\n29:   {\"degraded\":true,\"count\":<assistant-turns-collected>}\n30: The process still exits 0 so a partial turn count never hangs provider\n31: selection.\n32: \"\"\"\n33: \n34: import json\n35: import os\n36: import re\n37: import shlex\n38: import signal\n39: import subprocess\n40: import sys\n41: import time\n42: from datetime import datetime, timedelta, timezone\n43: from typing import Any\n44: \n45: \n46: MESSAGE_LIST_KEYS = (\"messages\", \"turns\", \"items\", \"entries\")\n47: CONTENT_NESTED_KEYS = (\"parts\", \"content\", \"message\")\n48: SESSION_ID_RE = re.compile(r\"\\bses_[A-Za-z0-9_-]+\\b\")\n49: SESSION_ID_KEYS = (\"sessionID\", \"sessionId\", \"session_id\", \"id\")\n50: TURN_ID_KEYS = (\"id\", \"messageID\", \"messageId\", \"message_id\")\n51: SESSION_TIMESTAMP_KEYS = (\n52:     \"updatedAt\",\n53:     \"updated_at\",\n54:     \"updated\",\n55:     \"createdAt\",\n56:     \"created_at\",\n57:     \"created\",\n58:     \"timestamp\",\n59:     \"time\",\n60: )\n61: \n62: DEFAULT_WINDOW_HOURS = 6.0\n63: DEFAULT_MAX_SESSIONS = 25\n64: DEFAULT_CALL_TIMEOUT_SECS = 20.0\n65: DEFAULT_DEADLINE_SECS = 60.0\n66: JSON_PARSE_FAILED = object()\n67: \n68: \n69: class Options:\n70:     def __init__(self) -> None:\n71:         self.window_hours = env_float(\"OPENCODE_TURNS_WINDOW_HOURS\", DEFAULT_WINDOW_HOURS)\n72:         self.max_sessions = env_int(\"OPENCODE_TURNS_MAX_SESSIONS\", DEFAULT_MAX_SESSIONS)\n73:         self.call_timeout = env_float(\"OPENCODE_TURNS_CALL_TIMEOUT\", DEFAULT_CALL_TIMEOUT_SECS)\n74:         self.deadline = env_float(\"OPENCODE_TURNS_DEADLINE\", DEFAULT_DEADLINE_SECS)\n75: \n76: \n77: class Deadline:\n78:     def __init__(self, seconds: float) -> None:\n79:         self.started_at = time.monotonic()\n80:         self.seconds = seconds\n81: \n82:     def remaining(self) -> float:\n83:         return max(0.0, self.seconds - (time.monotonic() - self.started_at))\n84: \n85:     def call_timeout(self, max_call_timeout: float) -> float:\n86:         remaining = self.remaining()\n87:         if remaining <= 0:\n88:             return 0.0\n89:         return min(max_call_timeout, remaining)\n90: \n91: \n92: def env_float(name: str, default: float) -> float:\n93:     return positive_float_or_default(parsed_env_float(name), default)\n94: \n95: \n96: def parsed_env_float(name: str) -> float | None:\n97:     return parsed_float_or_none(env_value(name))\n98: \n99: \n100: def env_value(name: str) -> str | None:\n101:     return os.environ.get(name)\n102: \n103: \n104: def parsed_float_or_none(value: str | None) -> float | None:\n105:     if value is None:\n106:         return None\n107:     try:\n108:         return float(value)\n109:     except ValueError:\n110:         return None\n111: \n112: \n113: def positive_float_or_default(value: float | None, default: float) -> float:\n114:     if value is None:\n115:         return default\n116:     return value if value > 0 else default\n117: \n118: \n119: def env_int(name: str, default: int) -> int:\n120:     return positive_int_or_default(parsed_env_int(name), default)\n121: \n122: \n123: def parsed_env_int(name: str) -> int | None:\n124:     return parsed_int_or_none(env_value(name))\n125: \n126: \n127: def parsed_int_or_none(value: str | None) -> int | None:\n128:     if value is None:\n129:         return None\n130:     try:\n131:         return int(value)\n132:     except ValueError:\n133:         return None\n134: \n135: \n136: def positive_int_or_default(value: int | None, default: int) -> int:\n137:     if value is None:\n138:         return default\n139:     return value if value > 0 else default\n140: \n141: \n142: def text_chunk(text: str) -> dict:\n143:     return {\"type\": \"text\", \"text\": text}\n144: \n145: \n146: def canonical_chunk_type(native_type) -> str:\n147:     if not isinstance(native_type, str):\n148:         return \"text\"\n149:     if native_type in (\"input_text\", \"output_text\", \"markdown\"):\n150:         return \"text\"\n151:     return native_type\n152: \n153: \n154: def extract_content_chunks(value) -> list:\n155:     if isinstance(value, str):\n156:         return content_chunks_from_text(value)\n157:     if isinstance(value, list):\n158:         return content_chunks_from_items(value)\n159:     if isinstance(value, dict):\n160:         return content_chunks_from_obj(value)\n161:     return []\n162: \n163: \n164: def content_chunks_from_text(value: str) -> list:\n165:     return [text_chunk(value)]\n166: \n167: \n168: def content_chunks_from_items(values: list) -> list:\n169:     chunks = []\n170:     for item in values:\n171:         chunks.extend(extract_content_chunks(item))\n172:     return chunks\n173: \n174: \n175: def content_chunks_from_obj(obj: dict) -> list:\n176:     chunks = direct_content_chunks_from_obj(obj)\n177:     if chunks:\n178:         return chunks\n179:     return nested_content_chunks_from_obj(obj)\n180: \n181: \n182: def direct_content_chunks_from_obj(obj: dict) -> list:\n183:     candidate = direct_content_candidate_from_obj(obj)\n184:     if candidate is None:\n185:         return []\n186:     return direct_content_chunks_from_candidate(candidate)\n187: \n188: \n189: def direct_content_candidate_from_obj(obj: dict) -> dict | None:\n190:     text = obj.get(\"text\")\n191:     if text is None:\n192:         text = obj.get(\"content\")\n193:     if not isinstance(text, str):\n194:         return None\n195:     return {\"text\": text, \"type\": obj.get(\"type\") or \"text\"}\n196: \n197: \n198: def direct_content_chunks_from_candidate(candidate: dict) -> list:\n199:     return [{\"type\": canonical_chunk_type(candidate[\"type\"]), \"text\": candidate[\"text\"]}]\n200: \n201: \n202: def nested_content_chunks_from_obj(obj: dict) -> list:\n203:     for key in CONTENT_NESTED_KEYS:\n204:         chunks = extract_content_chunks(obj.get(key))\n205:         if chunks:\n206:             return chunks\n207:     return []\n208: \n209: \n210: def unique_values(values: list[str]) -> list[str]:\n211:     seen = set()\n212:     unique = []\n213:     for value in values:\n214:         if value and value not in seen:\n215:             seen.add(value)\n216:             unique.append(value)\n217:     return unique\n218: \n219: \n220: def session_ids_from_value(value: Any) -> list[str]:\n221:     if isinstance(value, str):\n222:         return SESSION_ID_RE.findall(value)\n223:     if isinstance(value, list):\n224:         session_ids = []\n225:         for item in value:\n226:             session_ids.extend(session_ids_from_value(item))\n227:         return session_ids\n228:     if isinstance(value, dict):\n229:         session_ids = []\n230:         for item in value.values():\n231:             session_ids.extend(session_ids_from_value(item))\n232:         return session_ids\n233:     return []\n234: \n235: \n236: def parse_session_list_stdout(stdout: str, options: Options) -> list[str]:\n237:     parsed = parse_session_list_json(stdout)\n238:     if parsed is JSON_PARSE_FAILED:\n239:         return capped_session_ids_from_value(stdout, options.max_sessions)\n240: \n241:     candidates = unique_session_candidates(session_candidates_from_value(parsed))\n242:     if not candidates:\n243:         return capped_session_ids_from_value(parsed, options.max_sessions)\n244: \n245:     return session_ids_from_candidates(candidates, options)\n246: \n247: \n248: def parse_session_list_json(stdout: str):\n249:     try:\n250:         return json.loads(stdout)\n251:     except json.JSONDecodeError:\n252:         return JSON_PARSE_FAILED\n253: \n254: \n255: def capped_session_ids_from_value(value: Any, max_sessions: int) -> list[str]:\n256:     return unique_values(session_ids_from_value(value))[:max_sessions]\n257: \n258: \n259: def session_ids_from_candidates(candidates: list[dict], options: Options) -> list[str]:\n260:     if candidates_have_timestamps(candidates):\n261:         return recent_session_ids(candidates, options.window_hours)\n262:     return capped_candidate_session_ids(candidates, options.max_sessions)\n263: \n264: \n265: def candidates_have_timestamps(candidates: list[dict]) -> bool:\n266:     return any(candidate.get(\"timestamp\") is not None for candidate in candidates)\n267: \n268: \n269: def recent_session_ids(candidates: list[dict], window_hours: float) -> list[str]:\n270:     return session_ids_from_candidates_rows(\n271:         recent_session_candidates(candidates, window_hours)\n272:     )\n273: \n274: \n275: def recent_session_candidates(candidates: list[dict], window_hours: float) -> list[dict]:\n276:     cutoff = datetime.now(timezone.utc) - timedelta(hours=window_hours)\n277:     return [\n278:         candidate\n279:         for candidate in candidates\n280:         if candidate.get(\"timestamp\") is not None and candidate[\"timestamp\"] >= cutoff\n281:     ]\n282: \n283: \n284: def capped_candidate_session_ids(candidates: list[dict], max_sessions: int) -> list[str]:\n285:     return session_ids_from_candidates_rows(\n286:         capped_session_candidates(candidates, max_sessions)\n287:     )\n288: \n289: \n290: def capped_session_candidates(candidates: list[dict], max_sessions: int) -> list[dict]:\n291:     return candidates[:max_sessions]\n292: \n293: \n294: def session_ids_from_candidates_rows(candidates: list[dict]) -> list[str]:\n295:     return [candidate[\"session_id\"] for candidate in candidates]\n296: \n297: \n298: def unique_session_candidates(candidates: list[dict]) -> list[dict]:\n299:     seen = set()\n300:     unique = []\n301:     for candidate in candidates:\n302:         session_id = candidate.get(\"session_id\")\n303:         if not session_id or session_id in seen:\n304:             continue\n305:         seen.add(session_id)\n306:         unique.append(candidate)\n307:     return unique\n308: \n309: \n310: def session_candidates_from_value(value: Any) -> list[dict]:\n311:     if isinstance(value, list):\n312:         return session_candidates_from_items(value)\n313:     if isinstance(value, dict):\n314:         return session_candidates_from_obj(value)\n315:     return []\n316: \n317: \n318: def session_candidates_from_items(values) -> list[dict]:\n319:     candidates = []\n320:     for item in values:\n321:         candidates.extend(session_candidates_from_value(item))\n322:     return candidates\n323: \n324: \n325: def session_candidates_from_obj(obj: dict) -> list[dict]:\n326:     if has_session_candidate_shape(obj):\n327:         return [session_candidate_from_obj(obj)]\n328:     return session_candidates_from_items(obj.values())\n329: \n330: \n331: def has_session_candidate_shape(obj: dict) -> bool:\n332:     return session_list_session_id(obj) is not None\n333: \n334: \n335: def session_candidate_from_obj(obj: dict) -> dict:\n336:     return {\n337:         \"session_id\": session_list_session_id(obj),\n338:         \"timestamp\": session_list_timestamp(obj),\n339:     }\n340: \n341: \n342: def session_list_session_id(obj: dict) -> str | None:\n343:     for value in session_list_session_id_candidates(obj):\n344:         session_id = parsed_session_id(value)\n345:         if session_id:\n346:             return session_id\n347:     return None\n348: \n349: \n350: def session_list_session_id_candidates(obj: dict) -> list[str]:\n351:     candidates = []\n352:     for mapping in info_unwrapped_mappings(obj):\n353:         for key in SESSION_ID_KEYS:\n354:             value = mapping.get(key)\n355:             if not isinstance(value, str):\n356:                 continue\n357:             candidates.append(value)\n358:     return candidates\n359: \n360: \n361: def parsed_session_id(value: str) -> str | None:\n362:     match = SESSION_ID_RE.search(value)\n363:     if match:\n364:         return match.group(0)\n365:     return None\n366: \n367: \n368: def session_list_timestamp(obj: dict) -> datetime | None:\n369:     for value in timestamp_candidate_values(obj, SESSION_TIMESTAMP_KEYS):\n370:         converted = timestamp_datetime(value)\n371:         if converted:\n372:             return converted\n373:     return None\n374: \n375: \n376: def info_unwrapped_mappings(obj: dict) -> list[dict]:\n377:     mappings = [obj]\n378:     info = obj.get(\"info\")\n379:     if isinstance(info, dict):\n380:         mappings.append(info)\n381:     return mappings\n382: \n383: \n384: def metadata_mappings_from_obj(obj: dict) -> list[dict]:\n385:     mappings = info_unwrapped_mappings(obj)\n386:     message = obj.get(\"message\")\n387:     if isinstance(message, dict):\n388:         mappings.extend(info_unwrapped_mappings(message))\n389:     return mappings\n390: \n391: \n392: def timestamp_candidate_mappings(obj: dict) -> list[dict]:\n393:     mappings = []\n394:     for mapping in metadata_mappings_from_obj(obj):\n395:         mappings.append(mapping)\n396:         time_value = mapping.get(\"time\")\n397:         if isinstance(time_value, dict):\n398:             mappings.append(time_value)\n399:     return mappings\n400: \n401: \n402: def timestamp_candidate_values(obj: dict, keys: tuple[str, ...]) -> list:\n403:     values = []\n404:     for mapping in timestamp_candidate_mappings(obj):\n405:         for key in keys:\n406:             values.append(mapping.get(key))\n407:     return values\n408: \n409: \n410: def timestamp_datetime(value) -> datetime | None:\n411:     if isinstance(value, (int, float)):\n412:         return numeric_timestamp_datetime(value)\n413:     if not isinstance(value, str) or not value.strip():\n414:         return None\n415:     stripped = value.strip()\n416:     if re.fullmatch(r\"\\d+(\\.\\d+)?\", stripped):\n417:         return numeric_timestamp_datetime(float(stripped))\n418:     parsed = parsed_iso_timestamp(stripped)\n419:     if parsed is None:\n420:         return None\n421:     return normalized_timestamp_datetime(parsed)\n422: \n423: \n424: def parsed_iso_timestamp(value: str) -> datetime | None:\n425:     normalized = value.replace(\"Z\", \"+00:00\")\n426:     try:\n427:         return datetime.fromisoformat(normalized)\n428:     except ValueError:\n429:         return None\n430: \n431: \n432: def normalized_timestamp_datetime(parsed: datetime) -> datetime:\n433:     if parsed.tzinfo is None:\n434:         parsed = parsed.replace(tzinfo=timezone.utc)\n435:     return parsed.astimezone(timezone.utc)\n436: \n437: \n438: def numeric_timestamp_datetime(value: int | float) -> datetime | None:\n439:     seconds = value / 1000 if value > 10_000_000_000 else value\n440:     try:\n441:         return datetime.fromtimestamp(seconds, tz=timezone.utc)\n442:     except (OverflowError, OSError, ValueError):\n443:         return None\n444: \n445: \n446: def discover_session_ids(options: Options, deadline: Deadline) -> tuple[list[str], bool]:\n447:     stdout, timed_out = run_opencode([\"session\", \"list\", \"--json\"], options, deadline)\n448:     if timed_out:\n449:         return [], True\n450:     if stdout is None:\n451:         return [], False\n452:     return parse_session_list_stdout(stdout, options), False\n453: \n454: \n455: def requested_session_ids(\n456:     args: list[str], options: Options, deadline: Deadline\n457: ) -> tuple[list[str], bool]:\n458:     if args:\n459:         return unique_values(args), False\n460:     env_session_ids = session_ids_from_env()\n461:     if env_session_ids:\n462:         return env_session_ids, False\n463:     return discover_session_ids(options, deadline)\n464: \n465: \n466: def session_ids_from_env() -> list[str]:\n467:     value = os.environ.get(\"SESSION_ID\")\n468:     if value is None:\n469:         return []\n470:     return unique_values(split_env_session_ids(value))\n471: \n472: \n473: def split_env_session_ids(value: str) -> list[str]:\n474:     return [item for item in re.split(r\"[\\s,]+\", value.strip()) if item]\n475: \n476: \n477: def numeric_timestamp(value) -> str | None:\n478:     accepted = accepted_numeric_timestamp(value)\n479:     if accepted is None:\n480:         return None\n481:     return formatted_numeric_timestamp(accepted)\n482: \n483: \n484: def accepted_numeric_timestamp(value) -> int | float | None:\n485:     if not isinstance(value, (int, float)):\n486:         return None\n487:     return value\n488: \n489: \n490: def formatted_numeric_timestamp(value: int | float) -> str:\n491:     seconds = value / 1000 if value > 10_000_000_000 else value\n492:     return datetime.fromtimestamp(seconds, tz=timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\n493: \n494: \n495: def timestamp_from_obj(obj: dict) -> str | None:\n496:     for value in timestamp_candidate_values(\n497:         obj, (\"timestamp\", \"createdAt\", \"created_at\", \"time\", \"created\")\n498:     ):\n499:         converted = timestamp_string(value)\n500:         if converted:\n501:             return converted\n502:     return None\n503: \n504: \n505: def timestamp_string(value) -> str | None:\n506:     if isinstance(value, str) and value:\n507:         return value\n508:     return numeric_timestamp(value)\n509: \n510: \n511: def session_id_from_obj(obj: dict) -> str | None:\n512:     for mapping in metadata_mappings_from_obj(obj):\n513:         for key in (\"sessionID\", \"sessionId\", \"session_id\"):\n514:             value = mapping.get(key)\n515:             if isinstance(value, str) and value:\n516:                 return value\n517:     return None\n518: \n519: \n520: def role_from_obj(obj: dict) -> str | None:\n521:     for mapping in metadata_mappings_from_obj(obj):\n522:         value = mapping.get(\"role\")\n523:         if value in (\"user\", \"assistant\"):\n524:             return value\n525:     return None\n526: \n527: \n528: def turn_id_from_obj(obj: dict, default_session_id: str, index: int) -> str:\n529:     return turn_id_field_from_obj(obj) or fallback_turn_id(default_session_id, index)\n530: \n531: \n532: def turn_id_field_from_obj(obj: dict) -> str | None:\n533:     for mapping in metadata_mappings_from_obj(obj):\n534:         value = turn_id_field_from_mapping(mapping)\n535:         if value:\n536:             return value\n537:     return None\n538: \n539: \n540: def turn_id_field_from_mapping(obj: dict) -> str | None:\n541:     for key in TURN_ID_KEYS:\n542:         value = obj.get(key)\n543:         if isinstance(value, str) and value:\n544:             return value\n545:     return None\n546: \n547: \n548: def fallback_turn_id(default_session_id: str, index: int) -> str:\n549:     return f\"{default_session_id}:{index}\"\n550: \n551: \n552: def opencode_command() -> list[str]:\n553:     configured = configured_opencode_command()\n554:     if configured is None:\n555:         return default_opencode_command(sys.argv)\n556:     return command_tokens_or_default(configured_command_tokens(configured))\n557: \n558: \n559: def configured_opencode_command() -> str | None:\n560:     return os.environ.get(\"OPENCODE_BIN\")\n561: \n562: \n563: def configured_command_tokens(configured: str) -> list[str]:\n564:     return shlex.split(configured)\n565: \n566: \n567: def command_tokens_or_default(tokens: list[str]) -> list[str]:\n568:     return tokens or [\"opencode\"]\n569: \n570: \n571: def default_opencode_command(argv: list[str]) -> list[str]:\n572:     return [opencode_command_name_from_base_dir(base_dir_arg(argv))]\n573: \n574: \n575: def opencode_command_name_from_base_dir(base_dir: str) -> str:\n576:     return formatted_opencode_command_name(opencode_base_dir_suffix(base_dir))\n577: \n578: \n579: def opencode_base_dir_suffix(base_dir: str) -> str | None:\n580:     match = re.search(r\"(?:^|/)\\.opencode([0-9]+)(?:/|$)\", os.path.expanduser(base_dir))\n581:     if match:\n582:         return match.group(1)\n583:     return None\n584: \n585: \n586: def formatted_opencode_command_name(suffix: str | None) -> str:\n587:     if suffix is None:\n588:         return \"opencode\"\n589:     return f\"opencode{suffix}\"\n590: \n591: \n592: def run_opencode(\n593:     args: list[str], options: Options, deadline: Deadline\n594: ) -> tuple[str | None, bool]:\n595:     timeout = deadline.call_timeout(options.call_timeout)\n596:     if opencode_deadline_expired(timeout):\n597:         return degraded_opencode_result()\n598:     try:\n599:         process = spawn_opencode_process(args)\n600:     except OSError:\n601:         return failed_opencode_result()\n602: \n603:     stdout, timed_out = communicate_opencode_process(process, timeout)\n604:     if timed_out:\n605:         kill_process_group(process)\n606:         return degraded_opencode_result()\n607: \n608:     if opencode_process_failed(process):\n609:         return failed_opencode_result()\n610:     return successful_opencode_result(stdout)\n611: \n612: \n613: def opencode_deadline_expired(timeout: float) -> bool:\n614:     return timeout <= 0\n615: \n616: \n617: def spawn_opencode_process(args: list[str]) -> subprocess.Popen:\n618:     return subprocess.Popen(\n619:         opencode_command() + args,\n620:         stdout=subprocess.PIPE,\n621:         stderr=subprocess.PIPE,\n622:         stdin=subprocess.DEVNULL,\n623:         text=True,\n624:         start_new_session=True,\n625:     )\n626: \n627: \n628: def communicate_opencode_process(\n629:     process: subprocess.Popen, timeout: float\n630: ) -> tuple[str | None, bool]:\n631:     try:\n632:         stdout, _stderr = process.communicate(timeout=timeout)\n633:     except subprocess.TimeoutExpired:\n634:         return None, True\n635:     return stdout, False\n636: \n637: \n638: def opencode_process_failed(process: subprocess.Popen) -> bool:\n639:     return process.returncode != 0\n640: \n641: \n642: def degraded_opencode_result() -> tuple[str | None, bool]:\n643:     return None, True\n644: \n645: \n646: def failed_opencode_result() -> tuple[str | None, bool]:\n647:     return None, False\n648: \n649: \n650: def successful_opencode_result(stdout: str | None) -> tuple[str | None, bool]:\n651:     return stdout, False\n652: \n653: \n654: def kill_process_group(process: subprocess.Popen) -> None:\n655:     try:\n656:         os.killpg(process.pid, signal.SIGKILL)\n657:     except (OSError, ProcessLookupError):\n658:         try:\n659:             process.kill()\n660:         except OSError:\n661:             pass\n662:     try:\n663:         process.communicate(timeout=1)\n664:     except subprocess.TimeoutExpired:\n665:         try:\n666:             process.kill()\n667:         except OSError:\n668:             pass\n669:         process.communicate()\n670: \n671: \n672: def parse_export_stdout(stdout: str) -> Any | None:\n673:     try:\n674:         return json.loads(stdout)\n675:     except json.JSONDecodeError:\n676:         return None\n677: \n678: \n679: def export_session(\n680:     session_id: str, options: Options, deadline: Deadline\n681: ) -> tuple[Any | None, bool]:\n682:     stdout, timed_out = run_opencode([\"export\", session_id], options, deadline)\n683:     if timed_out:\n684:         return None, True\n685:     if stdout is None:\n686:         return None, False\n687:     return parse_export_stdout(stdout), False\n688: \n689: \n690: def exported_message_items(exported: Any) -> list[dict]:\n691:     items = exported_message_item_values(exported)\n692:     if items is None:\n693:         return []\n694:     return dict_items(items)\n695: \n696: \n697: def exported_message_item_values(exported: Any) -> list | None:\n698:     if isinstance(exported, list):\n699:         return exported\n700:     if not isinstance(exported, dict):\n701:         return None\n702:     for key in MESSAGE_LIST_KEYS:\n703:         value = exported.get(key)\n704:         if isinstance(value, list):\n705:             return value\n706:     if role_from_obj(exported):\n707:         return [exported]\n708:     return None\n709: \n710: \n711: def dict_items(items: list) -> list[dict]:\n712:     return [item for item in items if isinstance(item, dict)]\n713: \n714: \n715: def record_from_message(default_session_id: str, index: int, obj: dict) -> dict | None:\n716:     fields = message_record_fields(default_session_id, obj)\n717:     if not has_required_message_record_fields(fields):\n718:         return None\n719:     record = message_record_from_fields(\n720:         fields, turn_id_from_obj(obj, default_session_id, index)\n721:     )\n722:     return record_with_optional_body(record, message_body_chunks(obj))\n723: \n724: \n725: def message_record_fields(default_session_id: str, obj: dict) -> dict:\n726:     return {\n727:         \"session_id\": session_id_from_obj(obj) or default_session_id,\n728:         \"role\": role_from_obj(obj),\n729:         \"timestamp\": timestamp_from_obj(obj),\n730:     }\n731: \n732: \n733: def has_required_message_record_fields(fields: dict) -> bool:\n734:     return bool(fields.get(\"session_id\") and fields.get(\"role\") and fields.get(\"timestamp\"))\n735: \n736: \n737: def message_record_from_fields(fields: dict, turn_id: str) -> dict:\n738:     return {\n739:         \"session_id\": fields[\"session_id\"],\n740:         \"turn_id\": turn_id,\n741:         \"timestamp\": fields[\"timestamp\"],\n742:         \"role\": fields[\"role\"],\n743:     }\n744: \n745: \n746: def record_with_optional_body(record: dict, body: list) -> dict:\n747:     if not body:\n748:         return record\n749:     return {**record, \"body\": body}\n750: \n751: \n752: def message_body_chunks(obj: dict) -> list:\n753:     return (\n754:         extract_content_chunks(obj.get(\"parts\"))\n755:         or extract_content_chunks(obj.get(\"content\"))\n756:         or extract_content_chunks(obj.get(\"message\"))\n757:     )\n758: \n759: \n760: def records_from_exported_session(session_id: str, exported: Any) -> list[dict]:\n\n(Showing lines 1-760 of 846. Use offset=761 to continue.)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"\nReference adapter: emit OpenCode exported sessions as normalized JSONL.\n\nUsage: opencode-turns BASE_DIR [SESSION_ID ...]\n   e.g. opencode-turns ~/.local/share/opencode ses_abc123\n\nSession IDs and message content are read through the public OpenCode CLI.\nThe command defaults to `opencode`, or to `opencodeN` when BASE_DIR contains\n`.opencodeN`; `OPENCODE_BIN` overrides this:\n  opencode session list --json\n  opencode export <sessionID>\n\nWhen SESSION_ID arguments are supplied, they are used directly. If no\nSESSION_ID arguments are supplied, the SESSION_ID environment variable is used\nas the direct target list. BASE_DIR is accepted for compatibility with existing\nsession source configuration; implicit discovery uses `opencode session list\n--json`, not OpenCode's private storage layout.\n\nImplicit discovery is bounded to the recent quota-balancing window. If the","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/scripts/opencode-turns","text":"#!/usr/bin/env python3\n\"\"\"\nReference adapter: emit OpenCode exported sessions as normalized JSONL.\n\nUsage: opencode-turns BASE_DIR [SESSION_ID ...]\n   e.g. opencode-turns ~/.local/share/opencode ses_abc123\n\nSession IDs and message content are read through the public OpenCode CLI.\nThe command defaults to `opencode`, or to `opencodeN` when BASE_DIR contains\n`.opencodeN`; `OPENCODE_BIN` overrides this:\n  opencode session list --json\n  opencode export <sessionID>\n\nWhen SESSION_ID arguments are supplied, they are used directly. If no\nSESSION_ID arguments are supplied, the SESSION_ID environment variable is used\nas the direct target list. BASE_DIR is accepted for compatibility with existing\nsession source configuration; implicit discovery uses `opencode session list\n--json`, not OpenCode's private storage layout.\n\nImplicit discovery is bounded to the recent quota-balancing window. If the\nsession list does not expose timestamps, the adapter falls back to a small cap\nof most-recent CLI-listed sessions.\n\nEmits one JSON object per line on stdout:\n  {\"session_id\":\"ses_...\",\"turn_id\":\"msg_...\",\"timestamp\":\"<rfc3339>\",\"role\":\"user|assistant\",\"body\":[{\"type\":\"text\",\"text\":\"...\"}]}\n\nIf an OpenCode CLI call times out, the adapter emits every turn collected so far\nand then appends:\n  {\"degraded\":true,\"count\":<assistant-turns-collected>}\nThe process still exits 0 so a partial turn count never hangs provider\nselection.\n\"\"\"\n\nimport json\nimport os\nimport re\nimport shlex\nimport signal\nimport subprocess\nimport sys\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Any\n\n\nMESSAGE_LIST_KEYS = (\"messages\", \"turns\", \"items\", \"entries\")\nCONTENT_NESTED_KEYS = (\"parts\", \"content\", \"message\")\nSESSION_ID_RE = re.compile(r\"\\bses_[A-Za-z0-9_-]+\\b\")\nSESSION_ID_KEYS = (\"sessionID\", \"sessionId\", \"session_id\", \"id\")\nTURN_ID_KEYS = (\"id\", \"messageID\", \"messageId\", \"message_id\")\nSESSION_TIMESTAMP_KEYS = (\n    \"updatedAt\",\n    \"updated_at\",\n    \"updated\",\n    \"createdAt\",\n    \"created_at\",\n    \"created\",\n    \"timestamp\",\n    \"time\",\n)\n\nDEFAULT_WINDOW_HOURS = 6.0\nDEFAULT_MAX_SESSIONS = 25\nDEFAULT_CALL_TIMEOUT_SECS = 20.0\nDEFAULT_DEADLINE_SECS = 60.0\nJSON_PARSE_FAILED = object()\n\n\nclass Options:\n    def __init__(self) -> None:\n        self.window_hours = env_float(\"OPENCODE_TURNS_WINDOW_HOURS\", DEFAULT_WINDOW_HOURS)\n        self.max_sessions = env_int(\"OPENCODE_TURNS_MAX_SESSIONS\", DEFAULT_MAX_SESSIONS)\n        self.call_timeout = env_float(\"OPENCODE_TURNS_CALL_TIMEOUT\", DEFAULT_CALL_TIMEOUT_SECS)\n        self.deadline = env_float(\"OPENCODE_TURNS_DEADLINE\", DEFAULT_DEADLINE_SECS)\n\n\nclass Deadline:\n    def __init__(self, seconds: float) -> None:\n        self.started_at = time.monotonic()\n        self.seconds = seconds\n\n    def remaining(self) -> float:\n        return max(0.0, self.seconds - (time.monotonic() - self.started_at))\n\n    def call_timeout(self, max_call_timeout: float) -> float:\n        remaining = self.remaining()\n        if remaining <= 0:\n            return 0.0\n        return min(max_call_timeout, remaining)\n\n\ndef env_float(name: str, default: float) -> float:\n    return positive_float_or_default(parsed_env_float(name), default)\n\n\ndef parsed_env_float(name: str) -> float | None:\n    return parsed_float_or_none(env_value(name))\n\n\ndef env_value(name: str) -> str | None:\n    return os.environ.get(name)\n\n\ndef parsed_float_or_none(value: str | None) -> float | None:\n    if value is None:\n        return None\n    try:\n        return float(value)\n    except ValueError:\n        return None\n\n\ndef positive_float_or_default(value: float | None, default: float) -> float:\n    if value is None:\n        return default\n    return value if value > 0 else default\n\n\ndef env_int(name: str, default: int) -> int:\n    return positive_int_or_default(parsed_env_int(name), default)\n\n\ndef parsed_env_int(name: str) -> int | None:\n    return parsed_int_or_none(env_value(name))\n\n\ndef parsed_int_or_none(value: str | None) -> int | None:\n    if value is None:\n        return None\n    try:\n        return int(value)\n    except ValueError:\n        return None\n\n\ndef positive_int_or_default(value: int | None, default: int) -> int:\n    if value is None:\n        return default\n    return value if value > 0 else default\n\n\ndef text_chunk(text: str) -> dict:\n    return {\"type\": \"text\", \"text\": text}\n\n\ndef canonical_chunk_type(native_type) -> str:\n    if not isinstance(native_type, str):\n        return \"text\"\n    if native_type in (\"input_text\", \"output_text\", \"markdown\"):\n        return \"text\"\n    return native_type\n\n\ndef extract_content_chunks(value) -> list:\n    if isinstance(value, str):\n        return content_chunks_from_text(value)\n    if isinstance(value, list):\n        return content_chunks_from_items(value)\n    if isinstance(value, dict):\n        return content_chunks_from_obj(value)\n    return []\n\n\ndef content_chunks_from_text(value: str) -> list:\n    return [text_chunk(value)]\n\n\ndef content_chunks_from_items(values: list) -> list:\n    chunks = []\n    for item in values:\n        chunks.extend(extract_content_chunks(item))\n    return chunks\n\n\ndef content_chunks_from_obj(obj: dict) -> list:\n    chunks = direct_content_chunks_from_obj(obj)\n    if chunks:\n        return chunks\n    return nested_content_chunks_from_obj(obj)\n\n\ndef direct_content_chunks_from_obj(obj: dict) -> list:\n    candidate = direct_content_candidate_from_obj(obj)\n    if candidate is None:\n        return []\n    return direct_content_chunks_from_candidate(candidate)\n\n\ndef direct_content_candidate_from_obj(obj: dict) -> dict | None:\n    text = obj.get(\"text\")\n    if text is None:\n        text = obj.get(\"content\")\n    if not isinstance(text, str):\n        return None\n    return {\"text\": text, \"type\": obj.get(\"type\") or \"text\"}\n\n\ndef direct_content_chunks_from_candidate(candidate: dict) -> list:\n    return [{\"type\": canonical_chunk_type(candidate[\"type\"]), \"text\": candidate[\"text\"]}]\n\n\ndef nested_content_chunks_from_obj(obj: dict) -> list:\n    for key in CONTENT_NESTED_KEYS:\n        chunks = extract_content_chunks(obj.get(key))\n        if chunks:\n            return chunks\n    return []\n\n\ndef unique_values(values: list[str]) -> list[str]:\n    seen = set()\n    unique = []\n    for value in values:\n        if value and value not in seen:\n            seen.add(value)\n            unique.append(value)\n    return unique\n\n\ndef session_ids_from_value(value: Any) -> list[str]:\n    if isinstance(value, str):\n        return SESSION_ID_RE.findall(value)\n    if isinstance(value, list):\n        session_ids = []\n        for item in value:\n            session_ids.extend(session_ids_from_value(item))\n        return session_ids\n    if isinstance(value, dict):\n        session_ids = []\n        for item in value.values():\n            session_ids.extend(session_ids_from_value(item))\n        return session_ids\n    return []\n\n\ndef parse_session_list_stdout(stdout: str, options: Options) -> list[str]:\n    parsed = parse_session_list_json(stdout)\n    if parsed is JSON_PARSE_FAILED:\n        return capped_session_ids_from_value(stdout, options.max_sessions)\n\n    candidates = unique_session_candidates(session_candidates_from_value(parsed))\n    if not candidates:\n        return capped_session_ids_from_value(parsed, options.max_sessions)\n\n    return session_ids_from_candidates(candidates, options)\n\n\ndef parse_session_list_json(stdout: str):\n    try:\n        return json.loads(stdout)\n    except json.JSONDecodeError:\n        return JSON_PARSE_FAILED\n\n\ndef capped_session_ids_from_value(value: Any, max_sessions: int) -> list[str]:\n    return unique_values(session_ids_from_value(value))[:max_sessions]\n\n\ndef session_ids_from_candidates(candidates: list[dict], options: Options) -> list[str]:\n    if candidates_have_timestamps(candidates):\n        return recent_session_ids(candidates, options.window_hours)\n    return capped_candidate_session_ids(candidates, options.max_sessions)\n\n\ndef candidates_have_timestamps(candidates: list[dict]) -> bool:\n    return any(candidate.get(\"timestamp\") is not None for candidate in candidates)\n\n\ndef recent_session_ids(candidates: list[dict], window_hours: float) -> list[str]:\n    return session_ids_from_candidates_rows(\n        recent_session_candidates(candidates, window_hours)\n    )\n\n\ndef recent_session_candidates(candidates: list[dict], window_hours: float) -> list[dict]:\n    cutoff = datetime.now(timezone.utc) - timedelta(hours=window_hours)\n    return [\n        candidate\n        for candidate in candidates\n        if candidate.get(\"timestamp\") is not None and candidate[\"timestamp\"] >= cutoff\n    ]\n\n\ndef capped_candidate_session_ids(candidates: list[dict], max_sessions: int) -> list[str]:\n    return session_ids_from_candidates_rows(\n        capped_session_candidates(candidates, max_sessions)\n    )\n\n\ndef capped_session_candidates(candidates: list[dict], max_sessions: int) -> list[dict]:\n    return candidates[:max_sessions]\n\n\ndef session_ids_from_candidates_rows(candidates: list[dict]) -> list[str]:\n    return [candidate[\"session_id\"] for candidate in candidates]\n\n\ndef unique_session_candidates(candidates: list[dict]) -> list[dict]:\n    seen = set()\n    unique = []\n    for candidate in candidates:\n        session_id = candidate.get(\"session_id\")\n        if not session_id or session_id in seen:\n            continue\n        seen.add(session_id)\n        unique.append(candidate)\n    return unique\n\n\ndef session_candidates_from_value(value: Any) -> list[dict]:\n    if isinstance(value, list):\n        return session_candidates_from_items(value)\n    if isinstance(value, dict):\n        return session_candidates_from_obj(value)\n    return []\n\n\ndef session_candidates_from_items(values) -> list[dict]:\n    candidates = []\n    for item in values:\n        candidates.extend(session_candidates_from_value(item))\n    return candidates\n\n\ndef session_candidates_from_obj(obj: dict) -> list[dict]:\n    if has_session_candidate_shape(obj):\n        return [session_candidate_from_obj(obj)]\n    return session_candidates_from_items(obj.values())\n\n\ndef has_session_candidate_shape(obj: dict) -> bool:\n    return session_list_session_id(obj) is not None\n\n\ndef session_candidate_from_obj(obj: dict) -> dict:\n    return {\n        \"session_id\": session_list_session_id(obj),\n        \"timestamp\": session_list_timestamp(obj),\n    }\n\n\ndef session_list_session_id(obj: dict) -> str | None:\n    for value in session_list_session_id_candidates(obj):\n        session_id = parsed_session_id(value)\n        if session_id:\n            return session_id\n    return None\n\n\ndef session_list_session_id_candidates(obj: dict) -> list[str]:\n    candidates = []\n    for mapping in info_unwrapped_mappings(obj):\n        for key in SESSION_ID_KEYS:\n            value = mapping.get(key)\n            if not isinstance(value, str):\n                continue\n            candidates.append(value)\n    return candidates\n\n\ndef parsed_session_id(value: str) -> str | None:\n    match = SESSION_ID_RE.search(value)\n    if match:\n        return match.group(0)\n    return None\n\n\ndef session_list_timestamp(obj: dict) -> datetime | None:\n    for value in timestamp_candidate_values(obj, SESSION_TIMESTAMP_KEYS):\n        converted = timestamp_datetime(value)\n        if converted:\n            return converted\n    return None\n\n\ndef info_unwrapped_mappings(obj: dict) -> list[dict]:\n    mappings = [obj]\n    info = obj.get(\"info\")\n    if isinstance(info, dict):\n        mappings.append(info)\n    return mappings\n\n\ndef metadata_mappings_from_obj(obj: dict) -> list[dict]:\n    mappings = info_unwrapped_mappings(obj)\n    message = obj.get(\"message\")\n    if isinstance(message, dict):\n        mappings.extend(info_unwrapped_mappings(message))\n    return mappings\n\n\ndef timestamp_candidate_mappings(obj: dict) -> list[dict]:\n    mappings = []\n    for mapping in metadata_mappings_from_obj(obj):\n        mappings.append(mapping)\n        time_value = mapping.get(\"time\")\n        if isinstance(time_value, dict):\n            mappings.append(time_value)\n    return mappings\n\n\ndef timestamp_candidate_values(obj: dict, keys: tuple[str, ...]) -> list:\n    values = []\n    for mapping in timestamp_candidate_mappings(obj):\n        for key in keys:\n            values.append(mapping.get(key))\n    return values\n\n\ndef timestamp_datetime(value) -> datetime | None:\n    if isinstance(value, (int, float)):\n        return numeric_timestamp_datetime(value)\n    if not isinstance(value, str) or not value.strip():\n        return None\n    stripped = value.strip()\n    if re.fullmatch(r\"\\d+(\\.\\d+)?\", stripped):\n        return numeric_timestamp_datetime(float(stripped))\n    parsed = parsed_iso_timestamp(stripped)\n    if parsed is None:\n        return None\n    return normalized_timestamp_datetime(parsed)\n\n\ndef parsed_iso_timestamp(value: str) -> datetime | None:\n    normalized = value.replace(\"Z\", \"+00:00\")\n    try:\n        return datetime.fromisoformat(normalized)\n    except ValueError:\n        return None\n\n\ndef normalized_timestamp_datetime(parsed: datetime) -> datetime:\n    if parsed.tzinfo is None:\n        parsed = parsed.replace(tzinfo=timezone.utc)\n    return parsed.astimezone(timezone.utc)\n\n\ndef numeric_timestamp_datetime(value: int | float) -> datetime | None:\n    seconds = value / 1000 if value > 10_000_000_000 else value\n    try:\n        return datetime.fromtimestamp(seconds, tz=timezone.utc)\n    except (OverflowError, OSError, ValueError):\n        return None\n\n\ndef discover_session_ids(options: Options, deadline: Deadline) -> tuple[list[str], bool]:\n    stdout, timed_out = run_opencode([\"session\", \"list\", \"--json\"], options, deadline)\n    if timed_out:\n        return [], True\n    if stdout is None:\n        return [], False\n    return parse_session_list_stdout(stdout, options), False\n\n\ndef requested_session_ids(\n    args: list[str], options: Options, deadline: Deadline\n) -> tuple[list[str], bool]:\n    if args:\n        return unique_values(args), False\n    env_session_ids = session_ids_from_env()\n    if env_session_ids:\n        return env_session_ids, False\n    return discover_session_ids(options, deadline)\n\n\ndef session_ids_from_env() -> list[str]:\n    value = os.environ.get(\"SESSION_ID\")\n    if value is None:\n        return []\n    return unique_values(split_env_session_ids(value))\n\n\ndef split_env_session_ids(value: str) -> list[str]:\n    return [item for item in re.split(r\"[\\s,]+\", value.strip()) if item]\n\n\ndef numeric_timestamp(value) -> str | None:\n    accepted = accepted_numeric_timestamp(value)\n    if accepted is None:\n        return None\n    return formatted_numeric_timestamp(accepted)\n\n\ndef accepted_numeric_timestamp(value) -> int | float | None:\n    if not isinstance(value, (int, float)):\n        return None\n    return value\n\n\ndef formatted_numeric_timestamp(value: int | float) -> str:\n    seconds = value / 1000 if value > 10_000_000_000 else value\n    return datetime.fromtimestamp(seconds, tz=timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\n\n\ndef timestamp_from_obj(obj: dict) -> str | None:\n    for value in timestamp_candidate_values(\n        obj, (\"timestamp\", \"createdAt\", \"created_at\", \"time\", \"created\")\n    ):\n        converted = timestamp_string(value)\n        if converted:\n            return converted\n    return None\n\n\ndef timestamp_string(value) -> str | None:\n    if isinstance(value, str) and value:\n        return value\n    return numeric_timestamp(value)\n\n\ndef session_id_from_obj(obj: dict) -> str | None:\n    for mapping in metadata_mappings_from_obj(obj):\n        for key in (\"sessionID\", \"sessionId\", \"session_id\"):\n            value = mapping.get(key)\n            if isinstance(value, str) and value:\n                return value\n    return None\n\n\ndef role_from_obj(obj: dict) -> str | None:\n    for mapping in metadata_mappings_from_obj(obj):\n        value = mapping.get(\"role\")\n        if value in (\"user\", \"assistant\"):\n            return value\n    return None\n\n\ndef turn_id_from_obj(obj: dict, default_session_id: str, index: int) -> str:\n    return turn_id_field_from_obj(obj) or fallback_turn_id(default_session_id, index)\n\n\ndef turn_id_field_from_obj(obj: dict) -> str | None:\n    for mapping in metadata_mappings_from_obj(obj):\n        value = turn_id_field_from_mapping(mapping)\n        if value:\n            return value\n    return None\n\n\ndef turn_id_field_from_mapping(obj: dict) -> str | None:\n    for key in TURN_ID_KEYS:\n        value = obj.get(key)\n        if isinstance(value, str) and value:\n            return value\n    return None\n\n\ndef fallback_turn_id(default_session_id: str, index: int) -> str:\n    return f\"{default_session_id}:{index}\"\n\n\ndef opencode_command() -> list[str]:\n    configured = configured_opencode_command()\n    if configured is None:\n        return default_opencode_command(sys.argv)\n    return command_tokens_or_default(configured_command_tokens(configured))\n\n\ndef configured_opencode_command() -> str | None:\n    return os.environ.get(\"OPENCODE_BIN\")\n\n\ndef configured_command_tokens(configured: str) -> list[str]:\n    return shlex.split(configured)\n\n\ndef command_tokens_or_default(tokens: list[str]) -> list[str]:\n    return tokens or [\"opencode\"]\n\n\ndef default_opencode_command(argv: list[str]) -> list[str]:\n    return [opencode_command_name_from_base_dir(base_dir_arg(argv))]\n\n\ndef opencode_command_name_from_base_dir(base_dir: str) -> str:\n    return formatted_opencode_command_name(opencode_base_dir_suffix(base_dir))\n\n\ndef opencode_base_dir_suffix(base_dir: str) -> str | None:\n    match = re.search(r\"(?:^|/)\\.opencode([0-9]+)(?:/|$)\", os.path.expanduser(base_dir))\n    if match:\n        return match.group(1)\n    return None\n\n\ndef formatted_opencode_command_name(suffix: str | None) -> str:\n    if suffix is None:\n        return \"opencode\"\n    return f\"opencode{suffix}\"\n\n\ndef run_opencode(\n    args: list[str], options: Options, deadline: Deadline\n) -> tuple[str | None, bool]:\n    timeout = deadline.call_timeout(options.call_timeout)\n    if opencode_deadline_expired(timeout):\n        return degraded_opencode_result()\n    try:\n        process = spawn_opencode_process(args)\n    except OSError:\n        return failed_opencode_result()\n\n    stdout, timed_out = communicate_opencode_process(process, timeout)\n    if timed_out:\n        kill_process_group(process)\n        return degraded_opencode_result()\n\n    if opencode_process_failed(process):\n        return failed_opencode_result()\n    return successful_opencode_result(stdout)\n\n\ndef opencode_deadline_expired(timeout: float) -> bool:\n    return timeout <= 0\n\n\ndef spawn_opencode_process(args: list[str]) -> subprocess.Popen:\n    return subprocess.Popen(\n        opencode_command() + args,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        stdin=subprocess.DEVNULL,\n        text=True,\n        start_new_session=True,\n    )\n\n\ndef communicate_opencode_process(\n    process: subprocess.Popen, timeout: float\n) -> tuple[str | None, bool]:\n    try:\n        stdout, _stderr = process.communicate(timeout=timeout)\n    except subprocess.TimeoutExpired:\n        return None, True\n    return stdout, False\n\n\ndef opencode_process_failed(process: subprocess.Popen) -> bool:\n    return process.returncode != 0\n\n\ndef degraded_opencode_result() -> tuple[str | None, bool]:\n    return None, True\n\n\ndef failed_opencode_result() -> tuple[str | None, bool]:\n    return None, False\n\n\ndef successful_opencode_result(stdout: str | None) -> tuple[str | None, bool]:\n    return stdout, False\n\n\ndef kill_process_group(process: subprocess.Popen) -> None:\n    try:\n        os.killpg(process.pid, signal.SIGKILL)\n    except (OSError, ProcessLookupError):\n        try:\n            process.kill()\n        except OSError:\n            pass\n    try:\n        process.communicate(timeout=1)\n    except subprocess.TimeoutExpired:\n        try:\n            process.kill()\n        except OSError:\n            pass\n        process.communicate()\n\n\ndef parse_export_stdout(stdout: str) -> Any | None:\n    try:\n        return json.loads(stdout)\n    except json.JSONDecodeError:\n        return None\n\n\ndef export_session(\n    session_id: str, options: Options, deadline: Deadline\n) -> tuple[Any | None, bool]:\n    stdout, timed_out = run_opencode([\"export\", session_id], options, deadline)\n    if timed_out:\n        return None, True\n    if stdout is None:\n        return None, False\n    return parse_export_stdout(stdout), False\n\n\ndef exported_message_items(exported: Any) -> list[dict]:\n    items = exported_message_item_values(exported)\n    if items is None:\n        return []\n    return dict_items(items)\n\n\ndef exported_message_item_values(exported: Any) -> list | None:\n    if isinstance(exported, list):\n        return exported\n    if not isinstance(exported, dict):\n        return None\n    for key in MESSAGE_LIST_KEYS:\n        value = exported.get(key)\n        if isinstance(value, list):\n            return value\n    if role_from_obj(exported):\n        return [exported]\n    return None\n\n\ndef dict_items(items: list) -> list[dict]:\n    return [item for item in items if isinstance(item, dict)]\n\n\ndef record_from_message(default_session_id: str, index: int, obj: dict) -> dict | None:\n    fields = message_record_fields(default_session_id, obj)\n    if not has_required_message_record_fields(fields):\n        return None\n    record = message_record_from_fields(\n        fields, turn_id_from_obj(obj, default_session_id, index)\n    )\n    return record_with_optional_body(record, message_body_chunks(obj))\n\n\ndef message_record_fields(default_session_id: str, obj: dict) -> dict:\n    return {\n        \"session_id\": session_id_from_obj(obj) or default_session_id,\n        \"role\": role_from_obj(obj),\n        \"timestamp\": timestamp_from_obj(obj),\n    }\n\n\ndef has_required_message_record_fields(fields: dict) -> bool:\n    return bool(fields.get(\"session_id\") and fields.get(\"role\") and fields.get(\"timestamp\"))\n\n\ndef message_record_from_fields(fields: dict, turn_id: str) -> dict:\n    return {\n        \"session_id\": fields[\"session_id\"],\n        \"turn_id\": turn_id,\n        \"timestamp\": fields[\"timestamp\"],\n        \"role\": fields[\"role\"],\n    }\n\n\ndef record_with_optional_body(record: dict, body: list) -> dict:\n    if not body:\n        return record\n    return {**record, \"body\": body}\n\n\ndef message_body_chunks(obj: dict) -> list:\n    return (\n        extract_content_chunks(obj.get(\"parts\"))\n        or extract_content_chunks(obj.get(\"content\"))\n        or extract_content_chunks(obj.get(\"message\"))\n    )\n\n\ndef records_from_exported_session(session_id: str, exported: Any) -> list[dict]:","lineStart":1,"lineEnd":760,"totalLines":846,"truncated":true}},"title":"scripts/opencode-turns","time":{"start":1780923557624,"end":1780923557752}},"metadata":{"openai":{"itemId":"fc_0daa145c665b7f61016a26bca58b40819a8bfd1a39680620fe"}},"id":"prt_ea750e6d7001AzrqA2R5jgGyZM","sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","messageID":"msg_ea750c80b001UUynyyVLgp2Oka"}}
{"type":"tool_use","timestamp":1780923557801,"sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","part":{"type":"tool","tool":"read","callID":"call_yS3nbMx1FMnkMQKyukTH06l6","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/wake_confirm_legacy_opencode.rs","offset":1,"limit":760},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/wake_confirm_legacy_opencode.rs</path>\n<type>file</type>\n<content>\n1: #![cfg(unix)]\n2: \n3: //! ## Declared roles\n4: //!\n5: //! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n6: //! predicate, filter.\n7: //!\n8: //! TEST: legacy opencode wake-confirmation fixtures — fake CLI script\n9: //! formatters, model/config mappers, state and mailbox accessors, transcript\n10: //! parsers, consumed-notification predicates and filters, delivery/claim row\n11: //! validators, and test orchestration.\n12: //!\n13: //! ## Adapter declarations\n14: //!\n15: //! ```yaml\n16: //! adapter_declarations:\n17: //!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n18: //!     role: adapter\n19: //!     Translates:\n20: //!       - legacy-opencode-cli-contract\n21: //!       - wake-confirmation-transcript-contract\n22: //!       - mailbox-sidecar-contract\n23: //!       - invocation-state-db-contract\n24: //!       - test-fixture-process-contract\n25: //! intrinsic_surface_declarations:\n26: //!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n27: //!     role: intrinsic-surface\n28: //!     Domain: legacy opencode wake-confirmation regression suite\n29: //!     Owns:\n30: //!       - isolated config/data fixture materialization\n31: //!       - fake opencode script generation and executable setup\n32: //!       - transcript export fixture construction\n33: //!       - wake/resume command invocation and environment isolation\n34: //!       - delivery confirmation and consumed-notification assertions\n35: //! ```\n36: \n37: use oulipoly_state::StateDb;\n38: use oulipoly_state::mailbox::{AgentBashCompleteEnqueue, MailboxDb};\n39: use rusqlite::{Connection, params};\n40: use std::fs;\n41: use std::os::unix::fs::PermissionsExt;\n42: use std::path::{Path, PathBuf};\n43: use std::process::{Command, Output};\n44: use std::sync::{Mutex, MutexGuard, OnceLock};\n45: use std::time::{Duration, Instant};\n46: \n47: const MODEL: &str = \"wake-confirm-legacy-opencode\";\n48: const PROVIDER: &str = \"opencode\";\n49: const SESSION: &str = \"ses_wakeconfirmlegacy\";\n50: const HANDLE: &str = \"h-wake-confirm-legacy\";\n51: const CHAIN_ID: &str = \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\";\n52: \n53: struct Fixture {\n54:     dir: tempfile::TempDir,\n55:     config_home: PathBuf,\n56:     data_home: PathBuf,\n57:     home_dir: PathBuf,\n58:     app_config_dir: PathBuf,\n59:     models_dir: PathBuf,\n60:     bin_dir: PathBuf,\n61:     work_dir: PathBuf,\n62:     export_dir: PathBuf,\n63: }\n64: \n65: impl Fixture {\n66:     fn new() -> Self {\n67:         let dir = tempfile::tempdir().unwrap();\n68:         let config_home = dir.path().join(\"xdg-config\");\n69:         let data_home = dir.path().join(\"xdg-data\");\n70:         let home_dir = dir.path().join(\"home\");\n71:         let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n72:         let models_dir = app_config_dir.join(\"models\");\n73:         let bin_dir = dir.path().join(\"bin\");\n74:         let work_dir = dir.path().join(\"work\");\n75:         let export_dir = dir.path().join(\"fake-opencode-export\");\n76:         fs::create_dir_all(&models_dir).unwrap();\n77:         fs::create_dir_all(&bin_dir).unwrap();\n78:         fs::create_dir_all(&work_dir).unwrap();\n79:         fs::create_dir_all(&export_dir).unwrap();\n80:         fs::create_dir_all(&home_dir).unwrap();\n81:         Self {\n82:             dir,\n83:             config_home,\n84:             data_home,\n85:             home_dir,\n86:             app_config_dir,\n87:             models_dir,\n88:             bin_dir,\n89:             work_dir,\n90:             export_dir,\n91:         }\n92:     }\n93: \n94:     fn app_data_dir(&self) -> PathBuf {\n95:         self.data_home.join(\"oulipoly-agent-runner\")\n96:     }\n97: \n98:     fn sidecar_path(&self) -> PathBuf {\n99:         self.app_data_dir().join(\"pid-identity.db\")\n100:     }\n101: \n102:     fn state_path(&self) -> PathBuf {\n103:         self.app_data_dir().join(\"state.db\")\n104:     }\n105: \n106:     fn run(&self, mut cmd: Command) -> Output {\n107:         cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n108:             .env(\"XDG_DATA_HOME\", &self.data_home)\n109:             .env(\"HOME\", &self.home_dir)\n110:             .env(\"PATH\", self.path_env())\n111:             .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n112:             .env(\"WAKE_CONFIRM_WORK_DIR\", &self.work_dir)\n113:             .env(\"WAKE_CONFIRM_EXPORT_DIR\", &self.export_dir)\n114:             .env_remove(\"OULIPOLY_DATA_DIR\")\n115:             .env_remove(\"OULIPOLY_AUTO_WAKE\")\n116:             .env_remove(\"OULIPOLY_AUTO_WAKE_SESSION_ID\")\n117:             .env_remove(\"OULIPOLY_AUTO_WAKE_TOKEN\")\n118:             .env_remove(\"OULIPOLY_AUTO_WAKE_COUNT\")\n119:             .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n120:             .current_dir(self.dir.path());\n121:         cmd.output().unwrap()\n122:     }\n123: \n124:     fn path_env(&self) -> String {\n125:         let current = std::env::var(\"PATH\").unwrap_or_default();\n126:         format!(\"{}:{current}\", self.bin_dir.display())\n127:     }\n128: \n129:     fn run_agent(&self, prompt: &str) -> Output {\n130:         let mut cmd = Command::new(runner_bin());\n131:         cmd.env(\"WAKE_CONFIRM_NO_NOTIFY\", \"1\")\n132:             .arg(\"-m\")\n133:             .arg(MODEL)\n134:             .arg(\"--models-dir\")\n135:             .arg(&self.models_dir)\n136:             .arg(prompt);\n137:         self.run(cmd)\n138:     }\n139: \n140:     fn run_resume_with_env(&self, envs: &[(&str, &str)]) -> Output {\n141:         let mut cmd = Command::new(runner_bin());\n142:         for (key, value) in envs {\n143:             cmd.env(key, value);\n144:         }\n145:         cmd.arg(\"resume\")\n146:             .arg(\"--session-id\")\n147:             .arg(SESSION)\n148:             .arg(\"-m\")\n149:             .arg(MODEL)\n150:             .arg(\"--models-dir\")\n151:             .arg(&self.models_dir);\n152:         self.run(cmd)\n153:     }\n154: \n155:     fn write_legacy_opencode(&self) {\n156:         self.write_executable(\"opencode\", fake_opencode_script());\n157:         self.write_executable(\"opencode-turns\", fake_opencode_turns_script());\n158:         fs::write(\n159:             self.models_dir.join(format!(\"{MODEL}.toml\")),\n160:             format!(\n161:                 r#\"prompt_mode = \"arg\"\n162: \n163: [[providers]]\n164: name = \"{PROVIDER}\"\n165: args = []\n166: \"#,\n167:             ),\n168:         )\n169:         .unwrap();\n170:         fs::write(\n171:             self.app_config_dir.join(\"providers.toml\"),\n172:             format!(\n173:                 r#\"[{PROVIDER}]\n174: command = \"opencode\"\n175: args = [\"run\"]\n176: prompt_mode = \"arg\"\n177: \n178: [{PROVIDER}.session_capture]\n179: kind = \"stdout_json_event\"\n180: json_args = [\"--json\"]\n181: event_type = \"step_start\"\n182: event_id_path = \"sessionID\"\n183: \n184: [{PROVIDER}.resume]\n185: kind = \"flag\"\n186: flag = \"--session\"\n187: \"#,\n188:             ),\n189:         )\n190:         .unwrap();\n191:         fs::write(\n192:             self.app_config_dir.join(\"sessions.toml\"),\n193:             format!(\n194:                 r#\"[{PROVIDER}]\n195: turn_script = \"opencode-turns\"\n196: state_dir = {}\n197: \"#,\n198:                 toml_string(&path_string(&self.work_dir.join(\"turn-state\")))\n199:             ),\n200:         )\n201:         .unwrap();\n202:     }\n203: \n204:     fn write_executable(&self, name: &str, body: &str) -> PathBuf {\n205:         let path = self.bin_dir.join(name);\n206:         fs::write(&path, body).unwrap();\n207:         let mut perms = fs::metadata(&path).unwrap().permissions();\n208:         perms.set_mode(0o755);\n209:         fs::set_permissions(&path, perms).unwrap();\n210:         path\n211:     }\n212: \n213:     fn mailbox(&self) -> MailboxDb {\n214:         MailboxDb::open(&self.sidecar_path()).unwrap()\n215:     }\n216: \n217:     fn state(&self) -> StateDb {\n218:         StateDb::open(&self.state_path()).unwrap()\n219:     }\n220: \n221:     fn ensure_active_chain_for_legacy_session(&self) {\n222:         if self\n223:             .state()\n224:             .chain_id_for_segment(PROVIDER, SESSION)\n225:             .unwrap()\n226:             .is_some()\n227:         {\n228:             return;\n229:         }\n230:         let conn = Connection::open(self.state_path()).unwrap();\n231:         conn.execute(\n232:             \"INSERT INTO session_chains (chain_id, created_at, last_used_at, model_name)\n233:              VALUES (?1, '2026-06-07T00:00:00Z', '2026-06-07T00:00:00Z', ?2)\",\n234:             params![CHAIN_ID, MODEL],\n235:         )\n236:         .unwrap();\n237:         conn.execute(\n238:             \"INSERT INTO session_chain_segments\n239:                 (chain_id, provider_name, session_id, started_at, transition_reason)\n240:              VALUES (?1, ?2, ?3, '2026-06-07T00:00:00Z', 'initial')\",\n241:             params![CHAIN_ID, PROVIDER, SESSION],\n242:         )\n243:         .unwrap();\n244:     }\n245: \n246:     fn seed_mailbox_notification(&self) {\n247:         let state_dir = self.work_dir.join(HANDLE);\n248:         fs::create_dir_all(&state_dir).unwrap();\n249:         let meta = state_dir.join(\"meta.json\");\n250:         let log = state_dir.join(\"log\");\n251:         let rc = state_dir.join(\"rc\");\n252:         fs::write(&meta, r#\"{\"caller_chain\":[]}\"#).unwrap();\n253:         fs::write(&log, \"legacy opencode workload completed\\n\").unwrap();\n254:         fs::write(&rc, \"0\\n\").unwrap();\n255:         let payload_json = serde_json::json!({\n256:             \"schema_version\": 1,\n257:             \"kind\": \"agent_bash_complete\",\n258:             \"handle\": HANDLE,\n259:             \"state_dir\": path_string(&state_dir),\n260:             \"meta_path\": path_string(&meta),\n261:             \"log_path\": path_string(&log),\n262:             \"rc_path\": path_string(&rc),\n263:             \"rc\": 0,\n264:         })\n265:         .to_string();\n266:         let mut mailbox = self.mailbox();\n267:         mailbox\n268:             .enqueue_agent_bash_complete(&AgentBashCompleteEnqueue {\n269:                 session_id: SESSION,\n270:                 handle: HANDLE,\n271:                 payload_json: &payload_json,\n272:                 owner_invocation_uuid: None,\n273:                 matched_os_pid: None,\n274:                 matched_os_boot_id: None,\n275:                 matched_os_pid_starttime_ticks: None,\n276:                 matched_chain_index: None,\n277:                 state_dir: &path_string(&state_dir),\n278:                 meta_path: &path_string(&meta),\n279:                 log_path: &path_string(&log),\n280:                 rc_path: &path_string(&rc),\n281:                 rc: 0,\n282:             })\n283:             .unwrap();\n284:     }\n285: \n286:     fn notification_prompt_path(&self) -> PathBuf {\n287:         self.work_dir.join(\"legacy-wake-resumed.txt\")\n288:     }\n289: \n290:     fn export_path(&self) -> PathBuf {\n291:         self.export_dir.join(format!(\"{SESSION}.jsonl\"))\n292:     }\n293: \n294:     fn export_text(&self) -> String {\n295:         fs::read_to_string(self.export_path()).unwrap_or_default()\n296:     }\n297: \n298:     fn unconfirmed_invocation_count(&self) -> i64 {\n299:         Connection::open(self.state_path())\n300:             .unwrap()\n301:             .query_row(\n302:                 \"SELECT COUNT(*) FROM invocations WHERE error_category = 'mailbox_delivery_unconfirmed'\",\n303:                 [],\n304:                 |row| row.get(0),\n305:             )\n306:             .unwrap()\n307:     }\n308: \n309:     fn assert_xdg_isolated(&self) {\n310:         assert!(\n311:             !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n312:             \"config must stay in isolated XDG_CONFIG_HOME\"\n313:         );\n314:         assert!(\n315:             !self\n316:                 .home_dir\n317:                 .join(\".local/share/oulipoly-agent-runner\")\n318:                 .exists(),\n319:             \"state must stay in isolated XDG_DATA_HOME\"\n320:         );\n321:     }\n322: }\n323: \n324: #[test]\n325: fn legacy_opencode_resume_confirms_delivery_after_targeted_turn_ingest() {\n326:     let _guard = integration_test_guard();\n327:     let fixture = prepared_fixture();\n328:     fixture.seed_mailbox_notification();\n329: \n330:     let output = fixture.run_resume_with_env(&[]);\n331:     let prompt = wait_for_file(&fixture.notification_prompt_path());\n332:     assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n333:     assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n334:     assert!(prompt.contains(\"handle: h-wake-confirm-legacy\"), \"{prompt}\");\n335:     assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n336:     wait_until(\"fake opencode export contains delivery nonce\", || {\n337:         let exported = fixture.export_text();\n338:         exported.contains(\"[OULIPOLY NOTIFICATIONS]\") && exported.contains(\"[OULIPOLY-DELIVERY \")\n339:     });\n340: \n341:     assert_success(&output);\n342:     wait_until(\"legacy opencode delivery marked delivered\", || {\n343:         let db = fixture.mailbox();\n344:         let rows = db.list_mailbox(SESSION, true).unwrap();\n345:         rows.len() == 1\n346:             && rows[0].delivered_at.is_some()\n347:             && rows[0].delivery_error.is_none()\n348:             && rows[0].delivery_attempts == 1\n349:             && rows[0].delivered_by_invocation_uuid.is_some()\n350:     });\n351:     assert!(\n352:         !fixture\n353:             .state()\n354:             .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n355:             .unwrap(),\n356:         \"fixture should quote-wrap the delivered user body so exact-text confirmation stays red\"\n357:     );\n358:     assert!(\n359:         fixture\n360:             .state()\n361:             .has_session_user_turn_containing(\n362:                 PROVIDER,\n363:                 SESSION,\n364:                 &delivery_nonce_from_prompt(&prompt)\n365:             )\n366:             .unwrap(),\n367:         \"session_turns should contain the delivery nonce in the quote-wrapped user body\"\n368:     );\n369:     assert_eq!(fixture.unconfirmed_invocation_count(), 0);\n370:     assert!(fixture.mailbox().list_pending(SESSION).unwrap().is_empty());\n371:     fixture.assert_xdg_isolated();\n372: }\n373: \n374: #[test]\n375: fn legacy_opencode_resume_leaves_mailbox_pending_when_ingested_turn_omits_delivery_nonce() {\n376:     let _guard = integration_test_guard();\n377:     let fixture = prepared_fixture();\n378:     fixture.seed_mailbox_notification();\n379: \n380:     let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\", \"1\")]);\n381:     assert_exit_code(&output, 1);\n382:     let prompt = wait_for_file(&fixture.notification_prompt_path());\n383:     assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n384:     wait_until(\n385:         \"fake opencode export contains user turn without delivery nonce\",\n386:         || {\n387:             let exported = fixture.export_text();\n388:             exported.contains(\"[OULIPOLY NOTIFICATIONS]\")\n389:                 && !exported.contains(\"[OULIPOLY-DELIVERY \")\n390:         },\n391:     );\n392:     wait_until(\n393:         \"nonce-less export leaves mailbox pending unconfirmed\",\n394:         || {\n395:             let db = fixture.mailbox();\n396:             let rows = db.list_mailbox(SESSION, true).unwrap();\n397:             rows.len() == 1\n398:                 && rows[0].delivered_at.is_none()\n399:                 && rows[0].delivery_attempts == 1\n400:                 && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n401:                 && rows[0].delivered_by_invocation_uuid.is_none()\n402:         },\n403:     );\n404:     assert!(\n405:         !fixture\n406:             .state()\n407:             .has_session_user_turn_containing(\n408:                 PROVIDER,\n409:                 SESSION,\n410:                 &delivery_nonce_from_prompt(&prompt)\n411:             )\n412:             .unwrap(),\n413:         \"stored resume turn without the delivery nonce must not confirm delivery\"\n414:     );\n415:     assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n416:     assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n417:     fixture.assert_xdg_isolated();\n418: }\n419: \n420: #[test]\n421: fn legacy_opencode_resume_leaves_mailbox_pending_when_export_omits_notification_turn() {\n422:     let _guard = integration_test_guard();\n423:     let fixture = prepared_fixture();\n424:     fixture.seed_mailbox_notification();\n425: \n426:     let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\", \"1\")]);\n427:     assert_exit_code(&output, 1);\n428:     let prompt = wait_for_file(&fixture.notification_prompt_path());\n429:     assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n430:     wait_until(\"omitted export leaves mailbox pending unconfirmed\", || {\n431:         let db = fixture.mailbox();\n432:         let rows = db.list_mailbox(SESSION, true).unwrap();\n433:         rows.len() == 1\n434:             && rows[0].delivered_at.is_none()\n435:             && rows[0].delivery_attempts == 1\n436:             && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n437:             && rows[0].delivered_by_invocation_uuid.is_none()\n438:     });\n439:     assert!(\n440:         !fixture\n441:             .state()\n442:             .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n443:             .unwrap(),\n444:         \"omitted export must not create exact user-turn confirmation evidence\"\n445:     );\n446:     assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n447:     assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n448:     fixture.assert_xdg_isolated();\n449: }\n450: \n451: fn prepared_fixture() -> Fixture {\n452:     let fixture = Fixture::new();\n453:     fixture.write_legacy_opencode();\n454:     let output = fixture.run_agent(\"launch legacy opencode parent\");\n455:     assert_success(&output);\n456:     fixture.ensure_active_chain_for_legacy_session();\n457:     wait_until(\"legacy opencode parent runtime idle\", || {\n458:         fixture\n459:             .mailbox()\n460:             .session_runtime(SESSION)\n461:             .unwrap()\n462:             .is_some_and(|runtime| runtime.run_state == \"idle\")\n463:     });\n464:     fixture\n465: }\n466: \n467: fn fake_opencode_script() -> &'static str {\n468:     r#\"#!/usr/bin/env python3\n469: import json\n470: import os\n471: import pathlib\n472: import re\n473: import sys\n474: \n475: SESSION = \"ses_wakeconfirmlegacy\"\n476: \n477: def work_dir():\n478:     return pathlib.Path(os.environ[\"WAKE_CONFIRM_WORK_DIR\"])\n479: \n480: def export_dir():\n481:     return pathlib.Path(os.environ[\"WAKE_CONFIRM_EXPORT_DIR\"])\n482: \n483: def session_path(session_id):\n484:     return export_dir() / f\"{session_id}.jsonl\"\n485: \n486: def next_turn_id(session_id, role):\n487:     path = session_path(session_id)\n488:     if not path.exists():\n489:         return f\"{role}-1\"\n490:     count = sum(1 for line in path.read_text(encoding=\"utf-8\").splitlines() if line.strip())\n491:     return f\"{role}-{count + 1}\"\n492: \n493: def append_turn(session_id, role, text):\n494:     export_dir().mkdir(parents=True, exist_ok=True)\n495:     turn = {\n496:         \"session_id\": session_id,\n497:         \"turn_id\": next_turn_id(session_id, role),\n498:         \"timestamp\": \"2026-06-07T00:00:00Z\",\n499:         \"role\": role,\n500:         \"body\": [{\"type\": \"text\", \"text\": text}],\n501:     }\n502:     with session_path(session_id).open(\"a\", encoding=\"utf-8\") as handle:\n503:         handle.write(json.dumps(turn, separators=(\",\", \":\")) + \"\\n\")\n504: \n505: def stored_resume_prompt(prompt):\n506:     if os.environ.get(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\") == \"1\":\n507:         prompt = re.sub(r\"^\\[OULIPOLY-DELIVERY [^\\n]*\\]\\n?\", \"\", prompt, flags=re.MULTILINE)\n508:     return f'\"{prompt}\"'\n509: \n510: def parse_run(argv):\n511:     session_id = SESSION\n512:     prompt = \"\"\n513:     index = 0\n514:     while index < len(argv):\n515:         arg = argv[index]\n516:         if arg == \"--session\" and index + 1 < len(argv):\n517:             session_id = argv[index + 1]\n518:             index += 2\n519:             continue\n520:         if arg == \"--json\":\n521:             index += 1\n522:             continue\n523:         prompt = arg\n524:         index += 1\n525:     return session_id, prompt\n526: \n527: def run(argv):\n528:     session_id, prompt = parse_run(argv)\n529:     if \"--session\" in argv:\n530:         (work_dir() / \"legacy-wake-resumed.txt\").write_text(prompt, encoding=\"utf-8\")\n531:         if os.environ.get(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\") != \"1\":\n532:             append_turn(session_id, \"user\", stored_resume_prompt(prompt))\n533:         append_turn(session_id, \"assistant\", \"legacy wake acknowledged\")\n534:         print(\"legacy wake acknowledged\", flush=True)\n535:         return 0\n536:     print(json.dumps({\"type\": \"step_start\", \"sessionID\": SESSION}), flush=True)\n537:     append_turn(SESSION, \"user\", prompt)\n538:     append_turn(SESSION, \"assistant\", \"legacy parent acknowledged\")\n539:     print(\"legacy parent acknowledged\", flush=True)\n540:     return 0\n541: \n542: def export_session(argv):\n543:     session_id = argv[0] if argv else SESSION\n544:     path = session_path(session_id)\n545:     if path.exists():\n546:         sys.stdout.write(path.read_text(encoding=\"utf-8\"))\n547:     return 0\n548: \n549: def main():\n550:     subcommand = sys.argv[1] if len(sys.argv) > 1 else \"\"\n551:     if subcommand == \"export\":\n552:         return export_session(sys.argv[2:])\n553:     if subcommand == \"run\":\n554:         return run(sys.argv[2:])\n555:     print(f\"unsupported fake opencode subcommand: {subcommand}\", file=sys.stderr)\n556:     return 64\n557: \n558: if __name__ == \"__main__\":\n559:     raise SystemExit(main())\n560: \"#\n561: }\n562: \n563: fn fake_opencode_turns_script() -> &'static str {\n564:     r#\"#!/usr/bin/env python3\n565: import os\n566: import subprocess\n567: import sys\n568: \n569: session_id = os.environ.get(\"SESSION_ID\")\n570: if not session_id:\n571:     raise SystemExit(0)\n572: \n573: result = subprocess.run(\n574:     [\"opencode\", \"export\", session_id],\n575:     stdout=subprocess.PIPE,\n576:     stderr=subprocess.PIPE,\n577:     text=True,\n578:     check=False,\n579: )\n580: if result.returncode != 0:\n581:     sys.stderr.write(result.stderr)\n582:     raise SystemExit(result.returncode)\n583: sys.stdout.write(result.stdout)\n584: \"#\n585: }\n586: \n587: fn assert_success(output: &Output) {\n588:     assert_exit_code(output, 0);\n589: }\n590: \n591: fn assert_exit_code(output: &Output, expected: i32) {\n592:     assert_eq!(\n593:         output.status.code(),\n594:         Some(expected),\n595:         \"stdout={}\\nstderr={}\",\n596:         String::from_utf8_lossy(&output.stdout),\n597:         String::from_utf8_lossy(&output.stderr)\n598:     );\n599: }\n600: \n601: fn wait_for_file(path: &Path) -> String {\n602:     wait_for_path_exists(path);\n603:     fs::read_to_string(path).unwrap()\n604: }\n605: \n606: fn wait_for_path_exists(path: &Path) {\n607:     wait_until(&format!(\"{} exists\", path.display()), || path.exists());\n608: }\n609: \n610: fn wait_until(label: &str, mut predicate: impl FnMut() -> bool) {\n611:     let start = Instant::now();\n612:     while start.elapsed() < Duration::from_secs(10) {\n613:         if predicate() {\n614:             return;\n615:         }\n616:         std::thread::sleep(Duration::from_millis(50));\n617:     }\n618:     panic!(\"timed out waiting for {label}\");\n619: }\n620: \n621: fn delivery_nonce_from_prompt(prompt: &str) -> String {\n622:     let prefix = \"[OULIPOLY-DELIVERY \";\n623:     let start = prompt\n624:         .find(prefix)\n625:         .unwrap_or_else(|| panic!(\"prompt missing delivery nonce: {prompt}\"))\n626:         + prefix.len();\n627:     let rest = &prompt[start..];\n628:     let end = rest\n629:         .find(']')\n630:         .unwrap_or_else(|| panic!(\"prompt has unterminated delivery nonce: {prompt}\"));\n631:     rest[..end].to_string()\n632: }\n633: \n634: fn integration_test_lock() -> &'static Mutex<()> {\n635:     static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n636:     LOCK.get_or_init(|| Mutex::new(()))\n637: }\n638: \n639: fn integration_test_guard() -> MutexGuard<'static, ()> {\n640:     integration_test_lock()\n641:         .lock()\n642:         .unwrap_or_else(|poisoned| poisoned.into_inner())\n643: }\n644: \n645: fn runner_bin() -> &'static str {\n646:     env!(\"CARGO_BIN_EXE_oulipoly-agent-runner\")\n647: }\n648: \n649: fn path_string(path: &Path) -> String {\n650:     path.to_string_lossy().into_owned()\n651: }\n652: \n653: fn toml_string(value: &str) -> String {\n654:     serde_json::to_string(value).unwrap()\n655: }\n\n(End of file - total 655 lines)\n</content>","metadata":{"preview":"#![cfg(unix)]\n\n//! ## Declared roles\n//!\n//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n//! predicate, filter.\n//!\n//! TEST: legacy opencode wake-confirmation fixtures — fake CLI script\n//! formatters, model/config mappers, state and mailbox accessors, transcript\n//! parsers, consumed-notification predicates and filters, delivery/claim row\n//! validators, and test orchestration.\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n//!     role: adapter\n//!     Translates:\n//!       - legacy-opencode-cli-contract","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/wake_confirm_legacy_opencode.rs","text":"#![cfg(unix)]\n\n//! ## Declared roles\n//!\n//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n//! predicate, filter.\n//!\n//! TEST: legacy opencode wake-confirmation fixtures — fake CLI script\n//! formatters, model/config mappers, state and mailbox accessors, transcript\n//! parsers, consumed-notification predicates and filters, delivery/claim row\n//! validators, and test orchestration.\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n//!     role: adapter\n//!     Translates:\n//!       - legacy-opencode-cli-contract\n//!       - wake-confirmation-transcript-contract\n//!       - mailbox-sidecar-contract\n//!       - invocation-state-db-contract\n//!       - test-fixture-process-contract\n//! intrinsic_surface_declarations:\n//!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n//!     role: intrinsic-surface\n//!     Domain: legacy opencode wake-confirmation regression suite\n//!     Owns:\n//!       - isolated config/data fixture materialization\n//!       - fake opencode script generation and executable setup\n//!       - transcript export fixture construction\n//!       - wake/resume command invocation and environment isolation\n//!       - delivery confirmation and consumed-notification assertions\n//! ```\n\nuse oulipoly_state::StateDb;\nuse oulipoly_state::mailbox::{AgentBashCompleteEnqueue, MailboxDb};\nuse rusqlite::{Connection, params};\nuse std::fs;\nuse std::os::unix::fs::PermissionsExt;\nuse std::path::{Path, PathBuf};\nuse std::process::{Command, Output};\nuse std::sync::{Mutex, MutexGuard, OnceLock};\nuse std::time::{Duration, Instant};\n\nconst MODEL: &str = \"wake-confirm-legacy-opencode\";\nconst PROVIDER: &str = \"opencode\";\nconst SESSION: &str = \"ses_wakeconfirmlegacy\";\nconst HANDLE: &str = \"h-wake-confirm-legacy\";\nconst CHAIN_ID: &str = \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\";\n\nstruct Fixture {\n    dir: tempfile::TempDir,\n    config_home: PathBuf,\n    data_home: PathBuf,\n    home_dir: PathBuf,\n    app_config_dir: PathBuf,\n    models_dir: PathBuf,\n    bin_dir: PathBuf,\n    work_dir: PathBuf,\n    export_dir: PathBuf,\n}\n\nimpl Fixture {\n    fn new() -> Self {\n        let dir = tempfile::tempdir().unwrap();\n        let config_home = dir.path().join(\"xdg-config\");\n        let data_home = dir.path().join(\"xdg-data\");\n        let home_dir = dir.path().join(\"home\");\n        let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n        let models_dir = app_config_dir.join(\"models\");\n        let bin_dir = dir.path().join(\"bin\");\n        let work_dir = dir.path().join(\"work\");\n        let export_dir = dir.path().join(\"fake-opencode-export\");\n        fs::create_dir_all(&models_dir).unwrap();\n        fs::create_dir_all(&bin_dir).unwrap();\n        fs::create_dir_all(&work_dir).unwrap();\n        fs::create_dir_all(&export_dir).unwrap();\n        fs::create_dir_all(&home_dir).unwrap();\n        Self {\n            dir,\n            config_home,\n            data_home,\n            home_dir,\n            app_config_dir,\n            models_dir,\n            bin_dir,\n            work_dir,\n            export_dir,\n        }\n    }\n\n    fn app_data_dir(&self) -> PathBuf {\n        self.data_home.join(\"oulipoly-agent-runner\")\n    }\n\n    fn sidecar_path(&self) -> PathBuf {\n        self.app_data_dir().join(\"pid-identity.db\")\n    }\n\n    fn state_path(&self) -> PathBuf {\n        self.app_data_dir().join(\"state.db\")\n    }\n\n    fn run(&self, mut cmd: Command) -> Output {\n        cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n            .env(\"XDG_DATA_HOME\", &self.data_home)\n            .env(\"HOME\", &self.home_dir)\n            .env(\"PATH\", self.path_env())\n            .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n            .env(\"WAKE_CONFIRM_WORK_DIR\", &self.work_dir)\n            .env(\"WAKE_CONFIRM_EXPORT_DIR\", &self.export_dir)\n            .env_remove(\"OULIPOLY_DATA_DIR\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_SESSION_ID\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_TOKEN\")\n            .env_remove(\"OULIPOLY_AUTO_WAKE_COUNT\")\n            .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n            .current_dir(self.dir.path());\n        cmd.output().unwrap()\n    }\n\n    fn path_env(&self) -> String {\n        let current = std::env::var(\"PATH\").unwrap_or_default();\n        format!(\"{}:{current}\", self.bin_dir.display())\n    }\n\n    fn run_agent(&self, prompt: &str) -> Output {\n        let mut cmd = Command::new(runner_bin());\n        cmd.env(\"WAKE_CONFIRM_NO_NOTIFY\", \"1\")\n            .arg(\"-m\")\n            .arg(MODEL)\n            .arg(\"--models-dir\")\n            .arg(&self.models_dir)\n            .arg(prompt);\n        self.run(cmd)\n    }\n\n    fn run_resume_with_env(&self, envs: &[(&str, &str)]) -> Output {\n        let mut cmd = Command::new(runner_bin());\n        for (key, value) in envs {\n            cmd.env(key, value);\n        }\n        cmd.arg(\"resume\")\n            .arg(\"--session-id\")\n            .arg(SESSION)\n            .arg(\"-m\")\n            .arg(MODEL)\n            .arg(\"--models-dir\")\n            .arg(&self.models_dir);\n        self.run(cmd)\n    }\n\n    fn write_legacy_opencode(&self) {\n        self.write_executable(\"opencode\", fake_opencode_script());\n        self.write_executable(\"opencode-turns\", fake_opencode_turns_script());\n        fs::write(\n            self.models_dir.join(format!(\"{MODEL}.toml\")),\n            format!(\n                r#\"prompt_mode = \"arg\"\n\n[[providers]]\nname = \"{PROVIDER}\"\nargs = []\n\"#,\n            ),\n        )\n        .unwrap();\n        fs::write(\n            self.app_config_dir.join(\"providers.toml\"),\n            format!(\n                r#\"[{PROVIDER}]\ncommand = \"opencode\"\nargs = [\"run\"]\nprompt_mode = \"arg\"\n\n[{PROVIDER}.session_capture]\nkind = \"stdout_json_event\"\njson_args = [\"--json\"]\nevent_type = \"step_start\"\nevent_id_path = \"sessionID\"\n\n[{PROVIDER}.resume]\nkind = \"flag\"\nflag = \"--session\"\n\"#,\n            ),\n        )\n        .unwrap();\n        fs::write(\n            self.app_config_dir.join(\"sessions.toml\"),\n            format!(\n                r#\"[{PROVIDER}]\nturn_script = \"opencode-turns\"\nstate_dir = {}\n\"#,\n                toml_string(&path_string(&self.work_dir.join(\"turn-state\")))\n            ),\n        )\n        .unwrap();\n    }\n\n    fn write_executable(&self, name: &str, body: &str) -> PathBuf {\n        let path = self.bin_dir.join(name);\n        fs::write(&path, body).unwrap();\n        let mut perms = fs::metadata(&path).unwrap().permissions();\n        perms.set_mode(0o755);\n        fs::set_permissions(&path, perms).unwrap();\n        path\n    }\n\n    fn mailbox(&self) -> MailboxDb {\n        MailboxDb::open(&self.sidecar_path()).unwrap()\n    }\n\n    fn state(&self) -> StateDb {\n        StateDb::open(&self.state_path()).unwrap()\n    }\n\n    fn ensure_active_chain_for_legacy_session(&self) {\n        if self\n            .state()\n            .chain_id_for_segment(PROVIDER, SESSION)\n            .unwrap()\n            .is_some()\n        {\n            return;\n        }\n        let conn = Connection::open(self.state_path()).unwrap();\n        conn.execute(\n            \"INSERT INTO session_chains (chain_id, created_at, last_used_at, model_name)\n             VALUES (?1, '2026-06-07T00:00:00Z', '2026-06-07T00:00:00Z', ?2)\",\n            params![CHAIN_ID, MODEL],\n        )\n        .unwrap();\n        conn.execute(\n            \"INSERT INTO session_chain_segments\n                (chain_id, provider_name, session_id, started_at, transition_reason)\n             VALUES (?1, ?2, ?3, '2026-06-07T00:00:00Z', 'initial')\",\n            params![CHAIN_ID, PROVIDER, SESSION],\n        )\n        .unwrap();\n    }\n\n    fn seed_mailbox_notification(&self) {\n        let state_dir = self.work_dir.join(HANDLE);\n        fs::create_dir_all(&state_dir).unwrap();\n        let meta = state_dir.join(\"meta.json\");\n        let log = state_dir.join(\"log\");\n        let rc = state_dir.join(\"rc\");\n        fs::write(&meta, r#\"{\"caller_chain\":[]}\"#).unwrap();\n        fs::write(&log, \"legacy opencode workload completed\\n\").unwrap();\n        fs::write(&rc, \"0\\n\").unwrap();\n        let payload_json = serde_json::json!({\n            \"schema_version\": 1,\n            \"kind\": \"agent_bash_complete\",\n            \"handle\": HANDLE,\n            \"state_dir\": path_string(&state_dir),\n            \"meta_path\": path_string(&meta),\n            \"log_path\": path_string(&log),\n            \"rc_path\": path_string(&rc),\n            \"rc\": 0,\n        })\n        .to_string();\n        let mut mailbox = self.mailbox();\n        mailbox\n            .enqueue_agent_bash_complete(&AgentBashCompleteEnqueue {\n                session_id: SESSION,\n                handle: HANDLE,\n                payload_json: &payload_json,\n                owner_invocation_uuid: None,\n                matched_os_pid: None,\n                matched_os_boot_id: None,\n                matched_os_pid_starttime_ticks: None,\n                matched_chain_index: None,\n                state_dir: &path_string(&state_dir),\n                meta_path: &path_string(&meta),\n                log_path: &path_string(&log),\n                rc_path: &path_string(&rc),\n                rc: 0,\n            })\n            .unwrap();\n    }\n\n    fn notification_prompt_path(&self) -> PathBuf {\n        self.work_dir.join(\"legacy-wake-resumed.txt\")\n    }\n\n    fn export_path(&self) -> PathBuf {\n        self.export_dir.join(format!(\"{SESSION}.jsonl\"))\n    }\n\n    fn export_text(&self) -> String {\n        fs::read_to_string(self.export_path()).unwrap_or_default()\n    }\n\n    fn unconfirmed_invocation_count(&self) -> i64 {\n        Connection::open(self.state_path())\n            .unwrap()\n            .query_row(\n                \"SELECT COUNT(*) FROM invocations WHERE error_category = 'mailbox_delivery_unconfirmed'\",\n                [],\n                |row| row.get(0),\n            )\n            .unwrap()\n    }\n\n    fn assert_xdg_isolated(&self) {\n        assert!(\n            !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n            \"config must stay in isolated XDG_CONFIG_HOME\"\n        );\n        assert!(\n            !self\n                .home_dir\n                .join(\".local/share/oulipoly-agent-runner\")\n                .exists(),\n            \"state must stay in isolated XDG_DATA_HOME\"\n        );\n    }\n}\n\n#[test]\nfn legacy_opencode_resume_confirms_delivery_after_targeted_turn_ingest() {\n    let _guard = integration_test_guard();\n    let fixture = prepared_fixture();\n    fixture.seed_mailbox_notification();\n\n    let output = fixture.run_resume_with_env(&[]);\n    let prompt = wait_for_file(&fixture.notification_prompt_path());\n    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n    assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n    assert!(prompt.contains(\"handle: h-wake-confirm-legacy\"), \"{prompt}\");\n    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n    wait_until(\"fake opencode export contains delivery nonce\", || {\n        let exported = fixture.export_text();\n        exported.contains(\"[OULIPOLY NOTIFICATIONS]\") && exported.contains(\"[OULIPOLY-DELIVERY \")\n    });\n\n    assert_success(&output);\n    wait_until(\"legacy opencode delivery marked delivered\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_some()\n            && rows[0].delivery_error.is_none()\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivered_by_invocation_uuid.is_some()\n    });\n    assert!(\n        !fixture\n            .state()\n            .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n            .unwrap(),\n        \"fixture should quote-wrap the delivered user body so exact-text confirmation stays red\"\n    );\n    assert!(\n        fixture\n            .state()\n            .has_session_user_turn_containing(\n                PROVIDER,\n                SESSION,\n                &delivery_nonce_from_prompt(&prompt)\n            )\n            .unwrap(),\n        \"session_turns should contain the delivery nonce in the quote-wrapped user body\"\n    );\n    assert_eq!(fixture.unconfirmed_invocation_count(), 0);\n    assert!(fixture.mailbox().list_pending(SESSION).unwrap().is_empty());\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn legacy_opencode_resume_leaves_mailbox_pending_when_ingested_turn_omits_delivery_nonce() {\n    let _guard = integration_test_guard();\n    let fixture = prepared_fixture();\n    fixture.seed_mailbox_notification();\n\n    let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\", \"1\")]);\n    assert_exit_code(&output, 1);\n    let prompt = wait_for_file(&fixture.notification_prompt_path());\n    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n    wait_until(\n        \"fake opencode export contains user turn without delivery nonce\",\n        || {\n            let exported = fixture.export_text();\n            exported.contains(\"[OULIPOLY NOTIFICATIONS]\")\n                && !exported.contains(\"[OULIPOLY-DELIVERY \")\n        },\n    );\n    wait_until(\n        \"nonce-less export leaves mailbox pending unconfirmed\",\n        || {\n            let db = fixture.mailbox();\n            let rows = db.list_mailbox(SESSION, true).unwrap();\n            rows.len() == 1\n                && rows[0].delivered_at.is_none()\n                && rows[0].delivery_attempts == 1\n                && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n                && rows[0].delivered_by_invocation_uuid.is_none()\n        },\n    );\n    assert!(\n        !fixture\n            .state()\n            .has_session_user_turn_containing(\n                PROVIDER,\n                SESSION,\n                &delivery_nonce_from_prompt(&prompt)\n            )\n            .unwrap(),\n        \"stored resume turn without the delivery nonce must not confirm delivery\"\n    );\n    assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n    fixture.assert_xdg_isolated();\n}\n\n#[test]\nfn legacy_opencode_resume_leaves_mailbox_pending_when_export_omits_notification_turn() {\n    let _guard = integration_test_guard();\n    let fixture = prepared_fixture();\n    fixture.seed_mailbox_notification();\n\n    let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\", \"1\")]);\n    assert_exit_code(&output, 1);\n    let prompt = wait_for_file(&fixture.notification_prompt_path());\n    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n    wait_until(\"omitted export leaves mailbox pending unconfirmed\", || {\n        let db = fixture.mailbox();\n        let rows = db.list_mailbox(SESSION, true).unwrap();\n        rows.len() == 1\n            && rows[0].delivered_at.is_none()\n            && rows[0].delivery_attempts == 1\n            && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n            && rows[0].delivered_by_invocation_uuid.is_none()\n    });\n    assert!(\n        !fixture\n            .state()\n            .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n            .unwrap(),\n        \"omitted export must not create exact user-turn confirmation evidence\"\n    );\n    assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n    fixture.assert_xdg_isolated();\n}\n\nfn prepared_fixture() -> Fixture {\n    let fixture = Fixture::new();\n    fixture.write_legacy_opencode();\n    let output = fixture.run_agent(\"launch legacy opencode parent\");\n    assert_success(&output);\n    fixture.ensure_active_chain_for_legacy_session();\n    wait_until(\"legacy opencode parent runtime idle\", || {\n        fixture\n            .mailbox()\n            .session_runtime(SESSION)\n            .unwrap()\n            .is_some_and(|runtime| runtime.run_state == \"idle\")\n    });\n    fixture\n}\n\nfn fake_opencode_script() -> &'static str {\n    r#\"#!/usr/bin/env python3\nimport json\nimport os\nimport pathlib\nimport re\nimport sys\n\nSESSION = \"ses_wakeconfirmlegacy\"\n\ndef work_dir():\n    return pathlib.Path(os.environ[\"WAKE_CONFIRM_WORK_DIR\"])\n\ndef export_dir():\n    return pathlib.Path(os.environ[\"WAKE_CONFIRM_EXPORT_DIR\"])\n\ndef session_path(session_id):\n    return export_dir() / f\"{session_id}.jsonl\"\n\ndef next_turn_id(session_id, role):\n    path = session_path(session_id)\n    if not path.exists():\n        return f\"{role}-1\"\n    count = sum(1 for line in path.read_text(encoding=\"utf-8\").splitlines() if line.strip())\n    return f\"{role}-{count + 1}\"\n\ndef append_turn(session_id, role, text):\n    export_dir().mkdir(parents=True, exist_ok=True)\n    turn = {\n        \"session_id\": session_id,\n        \"turn_id\": next_turn_id(session_id, role),\n        \"timestamp\": \"2026-06-07T00:00:00Z\",\n        \"role\": role,\n        \"body\": [{\"type\": \"text\", \"text\": text}],\n    }\n    with session_path(session_id).open(\"a\", encoding=\"utf-8\") as handle:\n        handle.write(json.dumps(turn, separators=(\",\", \":\")) + \"\\n\")\n\ndef stored_resume_prompt(prompt):\n    if os.environ.get(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\") == \"1\":\n        prompt = re.sub(r\"^\\[OULIPOLY-DELIVERY [^\\n]*\\]\\n?\", \"\", prompt, flags=re.MULTILINE)\n    return f'\"{prompt}\"'\n\ndef parse_run(argv):\n    session_id = SESSION\n    prompt = \"\"\n    index = 0\n    while index < len(argv):\n        arg = argv[index]\n        if arg == \"--session\" and index + 1 < len(argv):\n            session_id = argv[index + 1]\n            index += 2\n            continue\n        if arg == \"--json\":\n            index += 1\n            continue\n        prompt = arg\n        index += 1\n    return session_id, prompt\n\ndef run(argv):\n    session_id, prompt = parse_run(argv)\n    if \"--session\" in argv:\n        (work_dir() / \"legacy-wake-resumed.txt\").write_text(prompt, encoding=\"utf-8\")\n        if os.environ.get(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\") != \"1\":\n            append_turn(session_id, \"user\", stored_resume_prompt(prompt))\n        append_turn(session_id, \"assistant\", \"legacy wake acknowledged\")\n        print(\"legacy wake acknowledged\", flush=True)\n        return 0\n    print(json.dumps({\"type\": \"step_start\", \"sessionID\": SESSION}), flush=True)\n    append_turn(SESSION, \"user\", prompt)\n    append_turn(SESSION, \"assistant\", \"legacy parent acknowledged\")\n    print(\"legacy parent acknowledged\", flush=True)\n    return 0\n\ndef export_session(argv):\n    session_id = argv[0] if argv else SESSION\n    path = session_path(session_id)\n    if path.exists():\n        sys.stdout.write(path.read_text(encoding=\"utf-8\"))\n    return 0\n\ndef main():\n    subcommand = sys.argv[1] if len(sys.argv) > 1 else \"\"\n    if subcommand == \"export\":\n        return export_session(sys.argv[2:])\n    if subcommand == \"run\":\n        return run(sys.argv[2:])\n    print(f\"unsupported fake opencode subcommand: {subcommand}\", file=sys.stderr)\n    return 64\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\"#\n}\n\nfn fake_opencode_turns_script() -> &'static str {\n    r#\"#!/usr/bin/env python3\nimport os\nimport subprocess\nimport sys\n\nsession_id = os.environ.get(\"SESSION_ID\")\nif not session_id:\n    raise SystemExit(0)\n\nresult = subprocess.run(\n    [\"opencode\", \"export\", session_id],\n    stdout=subprocess.PIPE,\n    stderr=subprocess.PIPE,\n    text=True,\n    check=False,\n)\nif result.returncode != 0:\n    sys.stderr.write(result.stderr)\n    raise SystemExit(result.returncode)\nsys.stdout.write(result.stdout)\n\"#\n}\n\nfn assert_success(output: &Output) {\n    assert_exit_code(output, 0);\n}\n\nfn assert_exit_code(output: &Output, expected: i32) {\n    assert_eq!(\n        output.status.code(),\n        Some(expected),\n        \"stdout={}\\nstderr={}\",\n        String::from_utf8_lossy(&output.stdout),\n        String::from_utf8_lossy(&output.stderr)\n    );\n}\n\nfn wait_for_file(path: &Path) -> String {\n    wait_for_path_exists(path);\n    fs::read_to_string(path).unwrap()\n}\n\nfn wait_for_path_exists(path: &Path) {\n    wait_until(&format!(\"{} exists\", path.display()), || path.exists());\n}\n\nfn wait_until(label: &str, mut predicate: impl FnMut() -> bool) {\n    let start = Instant::now();\n    while start.elapsed() < Duration::from_secs(10) {\n        if predicate() {\n            return;\n        }\n        std::thread::sleep(Duration::from_millis(50));\n    }\n    panic!(\"timed out waiting for {label}\");\n}\n\nfn delivery_nonce_from_prompt(prompt: &str) -> String {\n    let prefix = \"[OULIPOLY-DELIVERY \";\n    let start = prompt\n        .find(prefix)\n        .unwrap_or_else(|| panic!(\"prompt missing delivery nonce: {prompt}\"))\n        + prefix.len();\n    let rest = &prompt[start..];\n    let end = rest\n        .find(']')\n        .unwrap_or_else(|| panic!(\"prompt has unterminated delivery nonce: {prompt}\"));\n    rest[..end].to_string()\n}\n\nfn integration_test_lock() -> &'static Mutex<()> {\n    static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n    LOCK.get_or_init(|| Mutex::new(()))\n}\n\nfn integration_test_guard() -> MutexGuard<'static, ()> {\n    integration_test_lock()\n        .lock()\n        .unwrap_or_else(|poisoned| poisoned.into_inner())\n}\n\nfn runner_bin() -> &'static str {\n    env!(\"CARGO_BIN_EXE_oulipoly-agent-runner\")\n}\n\nfn path_string(path: &Path) -> String {\n    path.to_string_lossy().into_owned()\n}\n\nfn toml_string(value: &str) -> String {\n    serde_json::to_string(value).unwrap()\n}","lineStart":1,"lineEnd":655,"totalLines":655,"truncated":false}},"title":"src-tauri/tests/wake_confirm_legacy_opencode.rs","time":{"start":1780923557650,"end":1780923557793}},"metadata":{"openai":{"itemId":"fc_0daa145c665b7f61016a26bca58b5c819aa3af83c22997a1b9"}},"id":"prt_ea750e70c001D6SU5le1tVfMoc","sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","messageID":"msg_ea750c80b001UUynyyVLgp2Oka"}}
{"type":"tool_use","timestamp":1780923557837,"sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","part":{"type":"tool","tool":"read","callID":"call_UQlRdiJ9lCUWzNTNqunPl7Wx","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/scripts/tests/opencode-turns.test.sh","offset":1,"limit":850},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/scripts/tests/opencode-turns.test.sh</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env bash\n2: #\n3: # Run from the repo root:\n4: #   cd <repo-root> && scripts/tests/opencode-turns.test.sh\n5: \n6: set -euo pipefail\n7: \n8: SCRIPT=\"$PWD/scripts/opencode-turns\"\n9: \n10: fail() {\n11:   echo \"$*\" >&2\n12:   exit 1\n13: }\n14: \n15: values_equal() {\n16:   [[ \"$1\" == \"$2\" ]]\n17: }\n18: \n19: assert_eq_failure_message() {\n20:   local label=\"$1\"\n21:   local expected=\"$2\"\n22:   local actual=\"$3\"\n23: \n24:   printf '%s: expected <%s>, got <%s>' \"$label\" \"$expected\" \"$actual\"\n25: }\n26: \n27: assert_eq() {\n28:   local actual=\"$1\"\n29:   local expected=\"$2\"\n30:   local label=\"$3\"\n31: \n32:   if ! values_equal \"$actual\" \"$expected\"; then\n33:     fail \"$(assert_eq_failure_message \"$label\" \"$expected\" \"$actual\")\"\n34:   fi\n35: }\n36: \n37: status_zero() {\n38:   [[ \"$1\" -eq 0 ]]\n39: }\n40: \n41: status_zero_failure_message() {\n42:   local label=\"$1\"\n43:   local status=\"$2\"\n44: \n45:   printf '%s: expected exit 0, got %s; stderr: %s' \"$label\" \"$status\" \"$(cat \"$RUN_STDERR\")\"\n46: }\n47: \n48: assert_status_zero() {\n49:   local status=\"$1\"\n50:   local label=\"$2\"\n51: \n52:   if ! status_zero \"$status\"; then\n53:     fail \"$(status_zero_failure_message \"$label\" \"$status\")\"\n54:   fi\n55: }\n56: \n57: stdout_contains_pattern() {\n58:   grep -Fq \"$1\" \"$RUN_STDOUT\"\n59: }\n60: \n61: stdout_contains_failure_message() {\n62:   local label=\"$1\"\n63:   local pattern=\"$2\"\n64: \n65:   printf '%s: stdout did not contain <%s>; stdout: %s' \"$label\" \"$pattern\" \"$(cat \"$RUN_STDOUT\")\"\n66: }\n67: \n68: assert_stdout_contains() {\n69:   local pattern=\"$1\"\n70:   local label=\"$2\"\n71: \n72:   if ! stdout_contains_pattern \"$pattern\"; then\n73:     fail \"$(stdout_contains_failure_message \"$label\" \"$pattern\")\"\n74:   fi\n75: }\n76: \n77: stdout_excludes_pattern() {\n78:   ! grep -Fq \"$1\" \"$RUN_STDOUT\"\n79: }\n80: \n81: stdout_unexpected_failure_message() {\n82:   local label=\"$1\"\n83:   local pattern=\"$2\"\n84: \n85:   printf '%s: stdout unexpectedly contained <%s>; stdout: %s' \"$label\" \"$pattern\" \"$(cat \"$RUN_STDOUT\")\"\n86: }\n87: \n88: assert_stdout_not_contains() {\n89:   local pattern=\"$1\"\n90:   local label=\"$2\"\n91: \n92:   if ! stdout_excludes_pattern \"$pattern\"; then\n93:     fail \"$(stdout_unexpected_failure_message \"$label\" \"$pattern\")\"\n94:   fi\n95: }\n96: \n97: assert_current_export_records() {\n98:   local label=\"$1\"\n99: \n100:   python3 - \"$RUN_STDOUT\" <<'PY' || fail \"$label: current-format export records did not match\"\n101: import json\n102: import sys\n103: \n104: path = sys.argv[1]\n105: with open(path, encoding=\"utf-8\") as handle:\n106:     records = [json.loads(line) for line in handle if line.strip()]\n107: \n108: expected = [\n109:     {\n110:         \"session_id\": \"ses_current_info\",\n111:         \"turn_id\": \"msg_user_current\",\n112:         \"timestamp\": \"2023-11-14T22:13:20Z\",\n113:         \"role\": \"user\",\n114:         \"body\": [\n115:             {\n116:                 \"type\": \"text\",\n117:                 \"text\": \"[OULIPOLY-DELIVERY 123e4567-e89b-12d3-a456-426614174000] wake please\",\n118:             }\n119:         ],\n120:     },\n121:     {\n122:         \"session_id\": \"ses_current_info\",\n123:         \"turn_id\": \"msg_assistant_current\",\n124:         \"timestamp\": \"2023-11-14T22:13:25Z\",\n125:         \"role\": \"assistant\",\n126:         \"body\": [{\"type\": \"text\", \"text\": \"confirmed\"}],\n127:     },\n128: ]\n129: \n130: if records != expected:\n131:     print(\"expected:\", json.dumps(expected, indent=2), file=sys.stderr)\n132:     print(\"actual:\", json.dumps(records, indent=2), file=sys.stderr)\n133:     raise SystemExit(1)\n134: PY\n135: }\n136: \n137: assert_session_id_env_export_records() {\n138:   local label=\"$1\"\n139: \n140:   python3 - \"$RUN_STDOUT\" <<'PY' || fail \"$label: SESSION_ID-env export records did not match\"\n141: import json\n142: import sys\n143: \n144: path = sys.argv[1]\n145: with open(path, encoding=\"utf-8\") as handle:\n146:     records = [json.loads(line) for line in handle if line.strip()]\n147: \n148: expected = [\n149:     {\n150:         \"session_id\": \"ses_env_requested\",\n151:         \"turn_id\": \"msg_user_env\",\n152:         \"timestamp\": \"2023-11-14T22:13:20Z\",\n153:         \"role\": \"user\",\n154:         \"body\": [{\"type\": \"text\", \"text\": \"wake via SESSION_ID env\"}],\n155:     },\n156:     {\n157:         \"session_id\": \"ses_env_requested\",\n158:         \"turn_id\": \"msg_assistant_env\",\n159:         \"timestamp\": \"2023-11-14T22:13:25Z\",\n160:         \"role\": \"assistant\",\n161:         \"body\": [{\"type\": \"text\", \"text\": \"confirmed via env\"}],\n162:     },\n163: ]\n164: \n165: if records != expected:\n166:     print(\"expected:\", json.dumps(expected, indent=2), file=sys.stderr)\n167:     print(\"actual:\", json.dumps(records, indent=2), file=sys.stderr)\n168:     raise SystemExit(1)\n169: PY\n170: }\n171: \n172: file_size_bytes() {\n173:   local path=\"$1\"\n174: \n175:   if [[ ! -f \"$path\" ]]; then\n176:     missing_file_size_bytes\n177:     return\n178:   fi\n179:   existing_file_size_bytes \"$path\"\n180: }\n181: \n182: existing_file_size_bytes() {\n183:   local path=\"$1\"\n184: \n185:   wc -c <\"$path\" | tr -d ' '\n186: }\n187: \n188: missing_file_size_bytes() {\n189:   echo 0\n190: }\n191: \n192: marker_size_sample() {\n193:   local marker=\"$1\"\n194: \n195:   file_size_bytes \"$marker\"\n196:   sleep 1\n197:   file_size_bytes \"$marker\"\n198: }\n199: \n200: marker_size_stable() {\n201:   [[ \"$1\" == \"$2\" ]]\n202: }\n203: \n204: marker_growth_failure_message() {\n205:   local label=\"$1\"\n206:   local before=\"$2\"\n207:   local after=\"$3\"\n208: \n209:   printf '%s: descendant marker kept growing after timeout kill (%s -> %s bytes)' \"$label\" \"$before\" \"$after\"\n210: }\n211: \n212: assert_marker_stopped_growing() {\n213:   local marker=\"$1\"\n214:   local label=\"$2\"\n215:   local -a sizes\n216:   local before after\n217: \n218:   mapfile -t sizes < <(marker_size_sample \"$marker\")\n219:   before=\"${sizes[0]}\"\n220:   after=\"${sizes[1]}\"\n221:   if ! marker_size_stable \"$before\" \"$after\"; then\n222:     fail \"$(marker_growth_failure_message \"$label\" \"$before\" \"$after\")\"\n223:   fi\n224: }\n225: \n226: process_state() {\n227:   local pid=\"$1\"\n228: \n229:   if ! process_exists \"$pid\"; then\n230:     absent_process_state\n231:     return\n232:   fi\n233:   read_process_state \"$pid\"\n234: }\n235: \n236: process_exists() {\n237:   local pid=\"$1\"\n238: \n239:   kill -0 \"$pid\" 2>/dev/null\n240: }\n241: \n242: read_process_state() {\n243:   local pid=\"$1\"\n244: \n245:   ps -o stat= -p \"$pid\" 2>/dev/null | tr -d ' ' || true\n246: }\n247: \n248: absent_process_state() {\n249:   echo absent\n250: }\n251: \n252: process_state_allowed() {\n253:   local state=\"$1\"\n254: \n255:   [[ \"$state\" == absent || \"$state\" == Z* ]]\n256: }\n257: \n258: process_running_failure_message() {\n259:   local label=\"$1\"\n260:   local pid=\"$2\"\n261:   local state=\"$3\"\n262: \n263:   printf '%s: descendant process %s survived timeout kill with state <%s>' \"$label\" \"$pid\" \"$state\"\n264: }\n265: \n266: assert_process_not_running() {\n267:   local pid=\"$1\"\n268:   local label=\"$2\"\n269:   local state\n270: \n271:   state=\"$(process_state \"$pid\")\"\n272:   if process_state_allowed \"$state\"; then\n273:     return\n274:   fi\n275:   fail \"$(process_running_failure_message \"$label\" \"$pid\" \"$state\")\"\n276: }\n277: \n278: write_executable_mock() {\n279:   local path=\"$1\"\n280:   local body_writer=\"$2\"\n281: \n282:   \"$body_writer\" >\"$path\"\n283:   chmod +x \"$path\"\n284: }\n285: \n286: emit_timestampless_cap_mock_body() {\n287:   cat <<'MOCK_OPENCODE'\n288: #!/usr/bin/env bash\n289: set -euo pipefail\n290: \n291: if [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n292:   cat <<'JSON'\n293: [\n294:   {\"id\":\"ses_cap_one\"},\n295:   {\"id\":\"ses_cap_two\"},\n296:   {\"id\":\"ses_cap_three\"},\n297:   {\"id\":\"ses_cap_four\"},\n298:   {\"id\":\"ses_cap_five\"}\n299: ]\n300: JSON\n301:   exit 0\n302: fi\n303: \n304: if [[ \"$1\" == \"export\" ]]; then\n305:   session_id=\"$2\"\n306:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n307:   printf '[{\"sessionID\":\"%s\",\"messageID\":\"turn-%s\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"role\":\"assistant\",\"content\":\"ok\"}]\\n' \"$session_id\" \"$session_id\"\n308:   exit 0\n309: fi\n310: \n311: echo \"unexpected opencode args: $*\" >&2\n312: exit 64\n313: MOCK_OPENCODE\n314: }\n315: \n316: write_timestampless_cap_mock() {\n317:   local path=\"$1\"\n318: \n319:   write_executable_mock \"$path\" emit_timestampless_cap_mock_body\n320: }\n321: \n322: emit_window_filter_mock_body() {\n323:   cat <<'MOCK_OPENCODE'\n324: #!/usr/bin/env bash\n325: set -euo pipefail\n326: \n327: if [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n328:   python3 - <<'PY'\n329: import json\n330: from datetime import datetime, timedelta, timezone\n331: \n332: now = datetime.now(timezone.utc)\n333: sessions = [\n334:     {\"id\": \"ses_recent_one\", \"updatedAt\": (now - timedelta(hours=1)).isoformat().replace(\"+00:00\", \"Z\")},\n335:     {\"sessionID\": \"ses_recent_two\", \"createdAt\": (now - timedelta(hours=5)).isoformat().replace(\"+00:00\", \"Z\")},\n336:     {\"sessionId\": \"ses_old\", \"updatedAt\": (now - timedelta(hours=9)).isoformat().replace(\"+00:00\", \"Z\")},\n337:     {\"id\": \"ses_without_timestamp\"},\n338: ]\n339: print(json.dumps(sessions))\n340: PY\n341:   exit 0\n342: fi\n343: \n344: if [[ \"$1\" == \"export\" ]]; then\n345:   session_id=\"$2\"\n346:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n347:   printf '[{\"sessionID\":\"%s\",\"messageID\":\"turn-%s\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"role\":\"assistant\",\"content\":\"ok\"}]\\n' \"$session_id\" \"$session_id\"\n348:   exit 0\n349: fi\n350: \n351: echo \"unexpected opencode args: $*\" >&2\n352: exit 64\n353: MOCK_OPENCODE\n354: }\n355: \n356: write_window_filter_mock() {\n357:   local path=\"$1\"\n358: \n359:   write_executable_mock \"$path\" emit_window_filter_mock_body\n360: }\n361: \n362: emit_timeout_mock_body() {\n363:   cat <<'MOCK_OPENCODE'\n364: #!/usr/bin/env bash\n365: set -euo pipefail\n366: \n367: if [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n368:   cat <<'JSON'\n369: [\n370:   {\"id\":\"ses_fast\"},\n371:   {\"id\":\"ses_slow\"}\n372: ]\n373: JSON\n374:   exit 0\n375: fi\n376: \n377: if [[ \"$1\" == \"export\" ]]; then\n378:   session_id=\"$2\"\n379:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n380:   if [[ \"$session_id\" == \"ses_slow\" ]]; then\n381:     sleep 5\n382:   fi\n383:   printf '[{\"sessionID\":\"%s\",\"messageID\":\"turn-%s\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"role\":\"assistant\",\"content\":\"ok\"}]\\n' \"$session_id\" \"$session_id\"\n384:   exit 0\n385: fi\n386: \n387: echo \"unexpected opencode args: $*\" >&2\n388: exit 64\n389: MOCK_OPENCODE\n390: }\n391: \n392: write_timeout_mock() {\n393:   local path=\"$1\"\n394: \n395:   write_executable_mock \"$path\" emit_timeout_mock_body\n396: }\n397: \n398: emit_descendant_timeout_mock_body() {\n399:   cat <<'MOCK_OPENCODE'\n400: #!/usr/bin/env bash\n401: set -euo pipefail\n402: \n403: if [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n404:   printf '[{\"id\":\"ses_descendant\"}]\\n'\n405:   exit 0\n406: fi\n407: \n408: if [[ \"$1\" == \"export\" ]]; then\n409:   session_id=\"$2\"\n410:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n411:   (\n412:     printf tick >>\"$OPENCODE_TURNS_DESCENDANT_MARKER\"\n413:     while true; do\n414:       sleep 0.2\n415:       printf tick >>\"$OPENCODE_TURNS_DESCENDANT_MARKER\"\n416:     done\n417:   ) &\n418:   printf '%s\\n' \"$!\" >\"$OPENCODE_TURNS_DESCENDANT_PID\"\n419:   sleep 30\n420:   exit 0\n421: fi\n422: \n423: echo \"unexpected opencode args: $*\" >&2\n424: exit 64\n425: MOCK_OPENCODE\n426: }\n427: \n428: write_descendant_timeout_mock() {\n429:   local path=\"$1\"\n430: \n431:   write_executable_mock \"$path\" emit_descendant_timeout_mock_body\n432: }\n433: \n434: emit_command_derivation_mock_body() {\n435:   cat <<'MOCK_OPENCODE'\n436: #!/usr/bin/env bash\n437: set -euo pipefail\n438: \n439: printf '%s\\n' \"$(basename \"$0\")\" >>\"$OPENCODE_TURNS_COMMAND_LOG\"\n440: \n441: if [[ \"$1\" == \"export\" ]]; then\n442:   session_id=\"$2\"\n443:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n444:   printf '[{\"sessionID\":\"%s\",\"messageID\":\"turn-%s\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"role\":\"user\",\"content\":\"submitted\"}]\\n' \"$session_id\" \"$session_id\"\n445:   exit 0\n446: fi\n447: \n448: echo \"unexpected opencode args: $*\" >&2\n449: exit 64\n450: MOCK_OPENCODE\n451: }\n452: \n453: write_command_derivation_mock() {\n454:   local path=\"$1\"\n455: \n456:   write_executable_mock \"$path\" emit_command_derivation_mock_body\n457: }\n458: \n459: emit_current_export_mock_body() {\n460:   cat <<'MOCK_OPENCODE'\n461: #!/usr/bin/env bash\n462: set -euo pipefail\n463: \n464: if [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n465:   cat <<'JSON'\n466: [\n467:   {\"id\":\"ses_current_requested\"}\n468: ]\n469: JSON\n470:   exit 0\n471: fi\n472: \n473: if [[ \"$1\" == \"export\" ]]; then\n474:   session_id=\"$2\"\n475:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n476:   cat <<'JSON'\n477: {\n478:   \"info\": {\n479:     \"id\": \"ses_current_info\",\n480:     \"time\": {\"created\": 1700000000000}\n481:   },\n482:   \"messages\": [\n483:     {\n484:       \"info\": {\n485:         \"role\": \"user\",\n486:         \"time\": {\"created\": 1700000000000},\n487:         \"id\": \"msg_user_current\",\n488:         \"sessionID\": \"ses_current_info\"\n489:       },\n490:       \"parts\": [\n491:         {\n492:           \"type\": \"text\",\n493:           \"text\": \"[OULIPOLY-DELIVERY 123e4567-e89b-12d3-a456-426614174000] wake please\"\n494:         }\n495:       ]\n496:     },\n497:     {\n498:       \"info\": {\n499:         \"role\": \"assistant\",\n500:         \"time\": {\"created\": 1700000005000},\n501:         \"id\": \"msg_assistant_current\",\n502:         \"sessionID\": \"ses_current_info\"\n503:       },\n504:       \"parts\": [{\"type\": \"text\", \"text\": \"confirmed\"}]\n505:     }\n506:   ]\n507: }\n508: JSON\n509:   exit 0\n510: fi\n511: \n512: echo \"unexpected opencode args: $*\" >&2\n513: exit 64\n514: MOCK_OPENCODE\n515: }\n516: \n517: write_current_export_mock() {\n518:   local path=\"$1\"\n519: \n520:   write_executable_mock \"$path\" emit_current_export_mock_body\n521: }\n522: \n523: emit_session_id_env_mock_body() {\n524:   cat <<'MOCK_OPENCODE'\n525: #!/usr/bin/env bash\n526: set -euo pipefail\n527: \n528: if [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n529:   printf '[]\\n'\n530:   exit 0\n531: fi\n532: \n533: if [[ \"$1\" == \"export\" ]]; then\n534:   session_id=\"$2\"\n535:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n536:   if [[ \"$session_id\" != \"ses_env_requested\" ]]; then\n537:     printf '[]\\n'\n538:     exit 0\n539:   fi\n540:   cat <<'JSON'\n541: {\n542:   \"info\": {\n543:     \"id\": \"ses_env_requested\",\n544:     \"time\": {\"created\": 1700000000000}\n545:   },\n546:   \"messages\": [\n547:     {\n548:       \"info\": {\n549:         \"role\": \"user\",\n550:         \"time\": {\"created\": 1700000000000},\n551:         \"id\": \"msg_user_env\",\n552:         \"sessionID\": \"ses_env_requested\"\n553:       },\n554:       \"parts\": [{\"type\": \"text\", \"text\": \"wake via SESSION_ID env\"}]\n555:     },\n556:     {\n557:       \"info\": {\n558:         \"role\": \"assistant\",\n559:         \"time\": {\"created\": 1700000005000},\n560:         \"id\": \"msg_assistant_env\",\n561:         \"sessionID\": \"ses_env_requested\"\n562:       },\n563:       \"parts\": [{\"type\": \"text\", \"text\": \"confirmed via env\"}]\n564:     }\n565:   ]\n566: }\n567: JSON\n568:   exit 0\n569: fi\n570: \n571: echo \"unexpected opencode args: $*\" >&2\n572: exit 64\n573: MOCK_OPENCODE\n574: }\n575: \n576: write_session_id_env_mock() {\n577:   local path=\"$1\"\n578: \n579:   write_executable_mock \"$path\" emit_session_id_env_mock_body\n580: }\n581: \n582: run_opencode_turns() {\n583:   local tmpdir=\"$1\"\n584:   local opencode_bin=\"$2\"\n585: \n586:   RUN_STDOUT=\"$tmpdir/stdout.jsonl\"\n587:   RUN_STDERR=\"$tmpdir/stderr.txt\"\n588:   OPENCODE_TURNS_EXPORT_LOG=\"$tmpdir/exports.log\"\n589:   export OPENCODE_TURNS_EXPORT_LOG\n590:   : >\"$OPENCODE_TURNS_EXPORT_LOG\"\n591: \n592:   set +e\n593:   OPENCODE_BIN=\"$opencode_bin\" \\\n594:     OPENCODE_TURNS_WINDOW_HOURS=\"${OPENCODE_TURNS_WINDOW_HOURS:-6}\" \\\n595:     OPENCODE_TURNS_MAX_SESSIONS=\"${OPENCODE_TURNS_MAX_SESSIONS:-25}\" \\\n596:     OPENCODE_TURNS_CALL_TIMEOUT=\"${OPENCODE_TURNS_CALL_TIMEOUT:-20}\" \\\n597:     OPENCODE_TURNS_DEADLINE=\"${OPENCODE_TURNS_DEADLINE:-60}\" \\\n598:     \"$SCRIPT\" \"$tmpdir/opencode-root\" >\"$RUN_STDOUT\" 2>\"$RUN_STDERR\"\n599:   RUN_STATUS=$?\n600:   set -e\n601: }\n602: \n603: run_opencode_turns_with_session_id_env_on_path() {\n604:   local tmpdir=\"$1\"\n605:   local session_id=\"$2\"\n606: \n607:   RUN_STDOUT=\"$tmpdir/stdout.jsonl\"\n608:   RUN_STDERR=\"$tmpdir/stderr.txt\"\n609:   OPENCODE_TURNS_EXPORT_LOG=\"$tmpdir/exports.log\"\n610:   export OPENCODE_TURNS_EXPORT_LOG\n611:   : >\"$OPENCODE_TURNS_EXPORT_LOG\"\n612: \n613:   set +e\n614:   env -u OPENCODE_BIN \\\n615:     PATH=\"$tmpdir/bin:$PATH\" \\\n616:     SESSION_ID=\"$session_id\" \\\n617:     OPENCODE_TURNS_WINDOW_HOURS=6 \\\n618:     OPENCODE_TURNS_MAX_SESSIONS=25 \\\n619:     OPENCODE_TURNS_CALL_TIMEOUT=20 \\\n620:     OPENCODE_TURNS_DEADLINE=60 \\\n621:     \"$SCRIPT\" \"$tmpdir/opencode-root\" >\"$RUN_STDOUT\" 2>\"$RUN_STDERR\"\n622:   RUN_STATUS=$?\n623:   set -e\n624: }\n625: \n626: test_timestampless_session_list_applies_max_sessions_cap() {\n627:   local tmpdir\n628:   tmpdir=\"$(mktemp -d)\"\n629:   trap \"rm -rf '$tmpdir'\" RETURN\n630: \n631:   mkdir -p \"$tmpdir/bin\"\n632:   write_timestampless_cap_mock \"$tmpdir/bin/opencode\"\n633: \n634:   OPENCODE_TURNS_MAX_SESSIONS=3 run_opencode_turns \"$tmpdir\" \"$tmpdir/bin/opencode\"\n635: \n636:   assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n637:   assert_eq \"$(cat \"$OPENCODE_TURNS_EXPORT_LOG\")\" $'ses_cap_one\\nses_cap_two\\nses_cap_three' \"$FUNCNAME exports\"\n638:   assert_eq \"$(wc -l <\"$OPENCODE_TURNS_EXPORT_LOG\" | tr -d ' ')\" \"3\" \"$FUNCNAME export count\"\n639:   assert_stdout_contains '\"session_id\":\"ses_cap_one\"' \"$FUNCNAME cap one\"\n640:   assert_stdout_contains '\"session_id\":\"ses_cap_three\"' \"$FUNCNAME cap three\"\n641:   assert_stdout_not_contains 'ses_cap_four' \"$FUNCNAME cap excludes fourth\"\n642:   assert_stdout_not_contains 'ses_cap_five' \"$FUNCNAME cap excludes fifth\"\n643: }\n644: \n645: test_exports_only_recent_window_sessions() {\n646:   local tmpdir\n647:   tmpdir=\"$(mktemp -d)\"\n648:   trap \"rm -rf '$tmpdir'\" RETURN\n649: \n650:   mkdir -p \"$tmpdir/bin\"\n651:   write_window_filter_mock \"$tmpdir/bin/opencode\"\n652: \n653:   run_opencode_turns \"$tmpdir\" \"$tmpdir/bin/opencode\"\n654: \n655:   assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n656:   assert_eq \"$(cat \"$OPENCODE_TURNS_EXPORT_LOG\")\" $'ses_recent_one\\nses_recent_two' \"$FUNCNAME exports\"\n657:   assert_stdout_contains '\"session_id\":\"ses_recent_one\"' \"$FUNCNAME recent one\"\n658:   assert_stdout_contains '\"session_id\":\"ses_recent_two\"' \"$FUNCNAME recent two\"\n659:   assert_stdout_not_contains 'ses_old' \"$FUNCNAME old excluded\"\n660:   assert_stdout_not_contains 'ses_without_timestamp' \"$FUNCNAME timestampless excluded when list has timestamps\"\n661:   assert_stdout_not_contains '\"degraded\":true' \"$FUNCNAME not degraded\"\n662: }\n663: \n664: test_timeout_emits_degraded_best_effort_and_exits_zero() {\n665:   local tmpdir\n666:   tmpdir=\"$(mktemp -d)\"\n667:   trap \"rm -rf '$tmpdir'\" RETURN\n668: \n669:   mkdir -p \"$tmpdir/bin\"\n670:   write_timeout_mock \"$tmpdir/bin/opencode\"\n671: \n672:   local start end elapsed\n673:   start=\"$(date +%s)\"\n674:   OPENCODE_TURNS_CALL_TIMEOUT=1 OPENCODE_TURNS_DEADLINE=3 run_opencode_turns \"$tmpdir\" \"$tmpdir/bin/opencode\"\n675:   end=\"$(date +%s)\"\n676:   elapsed=$((end - start))\n677: \n678:   assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n679:   assert_stdout_contains '\"session_id\":\"ses_fast\"' \"$FUNCNAME fast record\"\n680:   assert_stdout_contains '\"degraded\":true' \"$FUNCNAME degraded marker\"\n681:   assert_stdout_contains '\"count\":1' \"$FUNCNAME best count\"\n682:   if [[ \"$elapsed\" -gt 4 ]]; then\n683:     fail \"$FUNCNAME: expected deadline-bounded execution, took ${elapsed}s\"\n684:   fi\n685: }\n686: \n687: test_timeout_kills_opencode_process_group_descendant() {\n688:   local tmpdir\n689:   tmpdir=\"$(mktemp -d)\"\n690:   trap \"rm -rf '$tmpdir'\" RETURN\n691: \n692:   mkdir -p \"$tmpdir/bin\"\n693:   write_descendant_timeout_mock \"$tmpdir/bin/opencode\"\n694:   OPENCODE_TURNS_DESCENDANT_MARKER=\"$tmpdir/descendant-marker\"\n695:   OPENCODE_TURNS_DESCENDANT_PID=\"$tmpdir/descendant.pid\"\n696:   export OPENCODE_TURNS_DESCENDANT_MARKER OPENCODE_TURNS_DESCENDANT_PID\n697: \n698:   OPENCODE_TURNS_CALL_TIMEOUT=1 OPENCODE_TURNS_DEADLINE=3 run_opencode_turns \"$tmpdir\" \"$tmpdir/bin/opencode\"\n699: \n700:   assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n701:   assert_stdout_contains '\"degraded\":true' \"$FUNCNAME degraded marker\"\n702:   assert_stdout_contains '\"count\":0' \"$FUNCNAME no completed assistant records\"\n703:   [[ -s \"$OPENCODE_TURNS_DESCENDANT_PID\" ]] || fail \"$FUNCNAME: descendant pid file was not written\"\n704:   [[ -s \"$OPENCODE_TURNS_DESCENDANT_MARKER\" ]] || fail \"$FUNCNAME: descendant marker was not written\"\n705: \n706:   local descendant_pid\n707:   descendant_pid=\"$(cat \"$OPENCODE_TURNS_DESCENDANT_PID\")\"\n708:   assert_marker_stopped_growing \"$OPENCODE_TURNS_DESCENDANT_MARKER\" \"$FUNCNAME\"\n709:   assert_process_not_running \"$descendant_pid\" \"$FUNCNAME\"\n710: }\n711: \n712: test_base_dir_suffix_selects_matching_opencode_command() {\n713:   local tmpdir\n714:   tmpdir=\"$(mktemp -d)\"\n715:   trap \"rm -rf '$tmpdir'\" RETURN\n716: \n717:   mkdir -p \"$tmpdir/bin\" \"$tmpdir/.opencode3/opencode\"\n718:   write_command_derivation_mock \"$tmpdir/bin/opencode3\"\n719:   RUN_STDOUT=\"$tmpdir/stdout.jsonl\"\n720:   RUN_STDERR=\"$tmpdir/stderr.txt\"\n721:   OPENCODE_TURNS_EXPORT_LOG=\"$tmpdir/exports.log\"\n722:   OPENCODE_TURNS_COMMAND_LOG=\"$tmpdir/commands.log\"\n723:   export OPENCODE_TURNS_EXPORT_LOG OPENCODE_TURNS_COMMAND_LOG\n724:   : >\"$OPENCODE_TURNS_EXPORT_LOG\"\n725:   : >\"$OPENCODE_TURNS_COMMAND_LOG\"\n726: \n727:   set +e\n728:   env -u OPENCODE_BIN \\\n729:     PATH=\"$tmpdir/bin:$PATH\" \\\n730:     SESSION_ID=ses_env_ignored \\\n731:     OPENCODE_TURNS_WINDOW_HOURS=6 \\\n732:     OPENCODE_TURNS_MAX_SESSIONS=25 \\\n733:     OPENCODE_TURNS_CALL_TIMEOUT=20 \\\n734:     OPENCODE_TURNS_DEADLINE=60 \\\n735:     \"$SCRIPT\" \"$tmpdir/.opencode3/opencode\" ses_account >\"$RUN_STDOUT\" 2>\"$RUN_STDERR\"\n736:   RUN_STATUS=$?\n737:   set -e\n738: \n739:   assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n740:   assert_eq \"$(cat \"$OPENCODE_TURNS_COMMAND_LOG\")\" \"opencode3\" \"$FUNCNAME command\"\n741:   assert_eq \"$(cat \"$OPENCODE_TURNS_EXPORT_LOG\")\" \"ses_account\" \"$FUNCNAME export\"\n742:   assert_stdout_contains '\"role\":\"user\"' \"$FUNCNAME user record\"\n743: }\n744: \n745: test_current_export_info_metadata_emits_turns() {\n746:   local tmpdir\n747:   tmpdir=\"$(mktemp -d)\"\n748:   trap \"rm -rf '$tmpdir'\" RETURN\n749: \n750:   mkdir -p \"$tmpdir/bin\"\n751:   write_current_export_mock \"$tmpdir/bin/opencode\"\n752: \n753:   run_opencode_turns \"$tmpdir\" \"$tmpdir/bin/opencode\"\n754: \n755:   assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n756:   assert_eq \"$(cat \"$OPENCODE_TURNS_EXPORT_LOG\")\" \"ses_current_requested\" \"$FUNCNAME export\"\n757:   assert_current_export_records \"$FUNCNAME\"\n758: }\n759: \n760: test_session_id_env_used_when_no_positional_sessions() {\n761:   local tmpdir\n762:   tmpdir=\"$(mktemp -d)\"\n763:   trap \"rm -rf '$tmpdir'\" RETURN\n764: \n765:   mkdir -p \"$tmpdir/bin\"\n766:   write_session_id_env_mock \"$tmpdir/bin/opencode\"\n767: \n768:   run_opencode_turns_with_session_id_env_on_path \"$tmpdir\" \"ses_env_requested\"\n769: \n770:   assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n771:   assert_eq \"$(cat \"$OPENCODE_TURNS_EXPORT_LOG\")\" \"ses_env_requested\" \"$FUNCNAME export\"\n772:   assert_session_id_env_export_records \"$FUNCNAME\"\n773: }\n774: \n775: test_timestampless_session_list_applies_max_sessions_cap\n776: test_exports_only_recent_window_sessions\n777: test_timeout_emits_degraded_best_effort_and_exits_zero\n778: test_timeout_kills_opencode_process_group_descendant\n779: test_base_dir_suffix_selects_matching_opencode_command\n780: test_current_export_info_metadata_emits_turns\n781: test_session_id_env_used_when_no_positional_sessions\n782: \n783: echo \"opencode-turns tests passed\"\n\n(End of file - total 783 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env bash\n#\n# Run from the repo root:\n#   cd <repo-root> && scripts/tests/opencode-turns.test.sh\n\nset -euo pipefail\n\nSCRIPT=\"$PWD/scripts/opencode-turns\"\n\nfail() {\n  echo \"$*\" >&2\n  exit 1\n}\n\nvalues_equal() {\n  [[ \"$1\" == \"$2\" ]]\n}\n\nassert_eq_failure_message() {\n  local label=\"$1\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/scripts/tests/opencode-turns.test.sh","text":"#!/usr/bin/env bash\n#\n# Run from the repo root:\n#   cd <repo-root> && scripts/tests/opencode-turns.test.sh\n\nset -euo pipefail\n\nSCRIPT=\"$PWD/scripts/opencode-turns\"\n\nfail() {\n  echo \"$*\" >&2\n  exit 1\n}\n\nvalues_equal() {\n  [[ \"$1\" == \"$2\" ]]\n}\n\nassert_eq_failure_message() {\n  local label=\"$1\"\n  local expected=\"$2\"\n  local actual=\"$3\"\n\n  printf '%s: expected <%s>, got <%s>' \"$label\" \"$expected\" \"$actual\"\n}\n\nassert_eq() {\n  local actual=\"$1\"\n  local expected=\"$2\"\n  local label=\"$3\"\n\n  if ! values_equal \"$actual\" \"$expected\"; then\n    fail \"$(assert_eq_failure_message \"$label\" \"$expected\" \"$actual\")\"\n  fi\n}\n\nstatus_zero() {\n  [[ \"$1\" -eq 0 ]]\n}\n\nstatus_zero_failure_message() {\n  local label=\"$1\"\n  local status=\"$2\"\n\n  printf '%s: expected exit 0, got %s; stderr: %s' \"$label\" \"$status\" \"$(cat \"$RUN_STDERR\")\"\n}\n\nassert_status_zero() {\n  local status=\"$1\"\n  local label=\"$2\"\n\n  if ! status_zero \"$status\"; then\n    fail \"$(status_zero_failure_message \"$label\" \"$status\")\"\n  fi\n}\n\nstdout_contains_pattern() {\n  grep -Fq \"$1\" \"$RUN_STDOUT\"\n}\n\nstdout_contains_failure_message() {\n  local label=\"$1\"\n  local pattern=\"$2\"\n\n  printf '%s: stdout did not contain <%s>; stdout: %s' \"$label\" \"$pattern\" \"$(cat \"$RUN_STDOUT\")\"\n}\n\nassert_stdout_contains() {\n  local pattern=\"$1\"\n  local label=\"$2\"\n\n  if ! stdout_contains_pattern \"$pattern\"; then\n    fail \"$(stdout_contains_failure_message \"$label\" \"$pattern\")\"\n  fi\n}\n\nstdout_excludes_pattern() {\n  ! grep -Fq \"$1\" \"$RUN_STDOUT\"\n}\n\nstdout_unexpected_failure_message() {\n  local label=\"$1\"\n  local pattern=\"$2\"\n\n  printf '%s: stdout unexpectedly contained <%s>; stdout: %s' \"$label\" \"$pattern\" \"$(cat \"$RUN_STDOUT\")\"\n}\n\nassert_stdout_not_contains() {\n  local pattern=\"$1\"\n  local label=\"$2\"\n\n  if ! stdout_excludes_pattern \"$pattern\"; then\n    fail \"$(stdout_unexpected_failure_message \"$label\" \"$pattern\")\"\n  fi\n}\n\nassert_current_export_records() {\n  local label=\"$1\"\n\n  python3 - \"$RUN_STDOUT\" <<'PY' || fail \"$label: current-format export records did not match\"\nimport json\nimport sys\n\npath = sys.argv[1]\nwith open(path, encoding=\"utf-8\") as handle:\n    records = [json.loads(line) for line in handle if line.strip()]\n\nexpected = [\n    {\n        \"session_id\": \"ses_current_info\",\n        \"turn_id\": \"msg_user_current\",\n        \"timestamp\": \"2023-11-14T22:13:20Z\",\n        \"role\": \"user\",\n        \"body\": [\n            {\n                \"type\": \"text\",\n                \"text\": \"[OULIPOLY-DELIVERY 123e4567-e89b-12d3-a456-426614174000] wake please\",\n            }\n        ],\n    },\n    {\n        \"session_id\": \"ses_current_info\",\n        \"turn_id\": \"msg_assistant_current\",\n        \"timestamp\": \"2023-11-14T22:13:25Z\",\n        \"role\": \"assistant\",\n        \"body\": [{\"type\": \"text\", \"text\": \"confirmed\"}],\n    },\n]\n\nif records != expected:\n    print(\"expected:\", json.dumps(expected, indent=2), file=sys.stderr)\n    print(\"actual:\", json.dumps(records, indent=2), file=sys.stderr)\n    raise SystemExit(1)\nPY\n}\n\nassert_session_id_env_export_records() {\n  local label=\"$1\"\n\n  python3 - \"$RUN_STDOUT\" <<'PY' || fail \"$label: SESSION_ID-env export records did not match\"\nimport json\nimport sys\n\npath = sys.argv[1]\nwith open(path, encoding=\"utf-8\") as handle:\n    records = [json.loads(line) for line in handle if line.strip()]\n\nexpected = [\n    {\n        \"session_id\": \"ses_env_requested\",\n        \"turn_id\": \"msg_user_env\",\n        \"timestamp\": \"2023-11-14T22:13:20Z\",\n        \"role\": \"user\",\n        \"body\": [{\"type\": \"text\", \"text\": \"wake via SESSION_ID env\"}],\n    },\n    {\n        \"session_id\": \"ses_env_requested\",\n        \"turn_id\": \"msg_assistant_env\",\n        \"timestamp\": \"2023-11-14T22:13:25Z\",\n        \"role\": \"assistant\",\n        \"body\": [{\"type\": \"text\", \"text\": \"confirmed via env\"}],\n    },\n]\n\nif records != expected:\n    print(\"expected:\", json.dumps(expected, indent=2), file=sys.stderr)\n    print(\"actual:\", json.dumps(records, indent=2), file=sys.stderr)\n    raise SystemExit(1)\nPY\n}\n\nfile_size_bytes() {\n  local path=\"$1\"\n\n  if [[ ! -f \"$path\" ]]; then\n    missing_file_size_bytes\n    return\n  fi\n  existing_file_size_bytes \"$path\"\n}\n\nexisting_file_size_bytes() {\n  local path=\"$1\"\n\n  wc -c <\"$path\" | tr -d ' '\n}\n\nmissing_file_size_bytes() {\n  echo 0\n}\n\nmarker_size_sample() {\n  local marker=\"$1\"\n\n  file_size_bytes \"$marker\"\n  sleep 1\n  file_size_bytes \"$marker\"\n}\n\nmarker_size_stable() {\n  [[ \"$1\" == \"$2\" ]]\n}\n\nmarker_growth_failure_message() {\n  local label=\"$1\"\n  local before=\"$2\"\n  local after=\"$3\"\n\n  printf '%s: descendant marker kept growing after timeout kill (%s -> %s bytes)' \"$label\" \"$before\" \"$after\"\n}\n\nassert_marker_stopped_growing() {\n  local marker=\"$1\"\n  local label=\"$2\"\n  local -a sizes\n  local before after\n\n  mapfile -t sizes < <(marker_size_sample \"$marker\")\n  before=\"${sizes[0]}\"\n  after=\"${sizes[1]}\"\n  if ! marker_size_stable \"$before\" \"$after\"; then\n    fail \"$(marker_growth_failure_message \"$label\" \"$before\" \"$after\")\"\n  fi\n}\n\nprocess_state() {\n  local pid=\"$1\"\n\n  if ! process_exists \"$pid\"; then\n    absent_process_state\n    return\n  fi\n  read_process_state \"$pid\"\n}\n\nprocess_exists() {\n  local pid=\"$1\"\n\n  kill -0 \"$pid\" 2>/dev/null\n}\n\nread_process_state() {\n  local pid=\"$1\"\n\n  ps -o stat= -p \"$pid\" 2>/dev/null | tr -d ' ' || true\n}\n\nabsent_process_state() {\n  echo absent\n}\n\nprocess_state_allowed() {\n  local state=\"$1\"\n\n  [[ \"$state\" == absent || \"$state\" == Z* ]]\n}\n\nprocess_running_failure_message() {\n  local label=\"$1\"\n  local pid=\"$2\"\n  local state=\"$3\"\n\n  printf '%s: descendant process %s survived timeout kill with state <%s>' \"$label\" \"$pid\" \"$state\"\n}\n\nassert_process_not_running() {\n  local pid=\"$1\"\n  local label=\"$2\"\n  local state\n\n  state=\"$(process_state \"$pid\")\"\n  if process_state_allowed \"$state\"; then\n    return\n  fi\n  fail \"$(process_running_failure_message \"$label\" \"$pid\" \"$state\")\"\n}\n\nwrite_executable_mock() {\n  local path=\"$1\"\n  local body_writer=\"$2\"\n\n  \"$body_writer\" >\"$path\"\n  chmod +x \"$path\"\n}\n\nemit_timestampless_cap_mock_body() {\n  cat <<'MOCK_OPENCODE'\n#!/usr/bin/env bash\nset -euo pipefail\n\nif [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n  cat <<'JSON'\n[\n  {\"id\":\"ses_cap_one\"},\n  {\"id\":\"ses_cap_two\"},\n  {\"id\":\"ses_cap_three\"},\n  {\"id\":\"ses_cap_four\"},\n  {\"id\":\"ses_cap_five\"}\n]\nJSON\n  exit 0\nfi\n\nif [[ \"$1\" == \"export\" ]]; then\n  session_id=\"$2\"\n  printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n  printf '[{\"sessionID\":\"%s\",\"messageID\":\"turn-%s\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"role\":\"assistant\",\"content\":\"ok\"}]\\n' \"$session_id\" \"$session_id\"\n  exit 0\nfi\n\necho \"unexpected opencode args: $*\" >&2\nexit 64\nMOCK_OPENCODE\n}\n\nwrite_timestampless_cap_mock() {\n  local path=\"$1\"\n\n  write_executable_mock \"$path\" emit_timestampless_cap_mock_body\n}\n\nemit_window_filter_mock_body() {\n  cat <<'MOCK_OPENCODE'\n#!/usr/bin/env bash\nset -euo pipefail\n\nif [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n  python3 - <<'PY'\nimport json\nfrom datetime import datetime, timedelta, timezone\n\nnow = datetime.now(timezone.utc)\nsessions = [\n    {\"id\": \"ses_recent_one\", \"updatedAt\": (now - timedelta(hours=1)).isoformat().replace(\"+00:00\", \"Z\")},\n    {\"sessionID\": \"ses_recent_two\", \"createdAt\": (now - timedelta(hours=5)).isoformat().replace(\"+00:00\", \"Z\")},\n    {\"sessionId\": \"ses_old\", \"updatedAt\": (now - timedelta(hours=9)).isoformat().replace(\"+00:00\", \"Z\")},\n    {\"id\": \"ses_without_timestamp\"},\n]\nprint(json.dumps(sessions))\nPY\n  exit 0\nfi\n\nif [[ \"$1\" == \"export\" ]]; then\n  session_id=\"$2\"\n  printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n  printf '[{\"sessionID\":\"%s\",\"messageID\":\"turn-%s\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"role\":\"assistant\",\"content\":\"ok\"}]\\n' \"$session_id\" \"$session_id\"\n  exit 0\nfi\n\necho \"unexpected opencode args: $*\" >&2\nexit 64\nMOCK_OPENCODE\n}\n\nwrite_window_filter_mock() {\n  local path=\"$1\"\n\n  write_executable_mock \"$path\" emit_window_filter_mock_body\n}\n\nemit_timeout_mock_body() {\n  cat <<'MOCK_OPENCODE'\n#!/usr/bin/env bash\nset -euo pipefail\n\nif [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n  cat <<'JSON'\n[\n  {\"id\":\"ses_fast\"},\n  {\"id\":\"ses_slow\"}\n]\nJSON\n  exit 0\nfi\n\nif [[ \"$1\" == \"export\" ]]; then\n  session_id=\"$2\"\n  printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n  if [[ \"$session_id\" == \"ses_slow\" ]]; then\n    sleep 5\n  fi\n  printf '[{\"sessionID\":\"%s\",\"messageID\":\"turn-%s\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"role\":\"assistant\",\"content\":\"ok\"}]\\n' \"$session_id\" \"$session_id\"\n  exit 0\nfi\n\necho \"unexpected opencode args: $*\" >&2\nexit 64\nMOCK_OPENCODE\n}\n\nwrite_timeout_mock() {\n  local path=\"$1\"\n\n  write_executable_mock \"$path\" emit_timeout_mock_body\n}\n\nemit_descendant_timeout_mock_body() {\n  cat <<'MOCK_OPENCODE'\n#!/usr/bin/env bash\nset -euo pipefail\n\nif [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n  printf '[{\"id\":\"ses_descendant\"}]\\n'\n  exit 0\nfi\n\nif [[ \"$1\" == \"export\" ]]; then\n  session_id=\"$2\"\n  printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n  (\n    printf tick >>\"$OPENCODE_TURNS_DESCENDANT_MARKER\"\n    while true; do\n      sleep 0.2\n      printf tick >>\"$OPENCODE_TURNS_DESCENDANT_MARKER\"\n    done\n  ) &\n  printf '%s\\n' \"$!\" >\"$OPENCODE_TURNS_DESCENDANT_PID\"\n  sleep 30\n  exit 0\nfi\n\necho \"unexpected opencode args: $*\" >&2\nexit 64\nMOCK_OPENCODE\n}\n\nwrite_descendant_timeout_mock() {\n  local path=\"$1\"\n\n  write_executable_mock \"$path\" emit_descendant_timeout_mock_body\n}\n\nemit_command_derivation_mock_body() {\n  cat <<'MOCK_OPENCODE'\n#!/usr/bin/env bash\nset -euo pipefail\n\nprintf '%s\\n' \"$(basename \"$0\")\" >>\"$OPENCODE_TURNS_COMMAND_LOG\"\n\nif [[ \"$1\" == \"export\" ]]; then\n  session_id=\"$2\"\n  printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n  printf '[{\"sessionID\":\"%s\",\"messageID\":\"turn-%s\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"role\":\"user\",\"content\":\"submitted\"}]\\n' \"$session_id\" \"$session_id\"\n  exit 0\nfi\n\necho \"unexpected opencode args: $*\" >&2\nexit 64\nMOCK_OPENCODE\n}\n\nwrite_command_derivation_mock() {\n  local path=\"$1\"\n\n  write_executable_mock \"$path\" emit_command_derivation_mock_body\n}\n\nemit_current_export_mock_body() {\n  cat <<'MOCK_OPENCODE'\n#!/usr/bin/env bash\nset -euo pipefail\n\nif [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n  cat <<'JSON'\n[\n  {\"id\":\"ses_current_requested\"}\n]\nJSON\n  exit 0\nfi\n\nif [[ \"$1\" == \"export\" ]]; then\n  session_id=\"$2\"\n  printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n  cat <<'JSON'\n{\n  \"info\": {\n    \"id\": \"ses_current_info\",\n    \"time\": {\"created\": 1700000000000}\n  },\n  \"messages\": [\n    {\n      \"info\": {\n        \"role\": \"user\",\n        \"time\": {\"created\": 1700000000000},\n        \"id\": \"msg_user_current\",\n        \"sessionID\": \"ses_current_info\"\n      },\n      \"parts\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"[OULIPOLY-DELIVERY 123e4567-e89b-12d3-a456-426614174000] wake please\"\n        }\n      ]\n    },\n    {\n      \"info\": {\n        \"role\": \"assistant\",\n        \"time\": {\"created\": 1700000005000},\n        \"id\": \"msg_assistant_current\",\n        \"sessionID\": \"ses_current_info\"\n      },\n      \"parts\": [{\"type\": \"text\", \"text\": \"confirmed\"}]\n    }\n  ]\n}\nJSON\n  exit 0\nfi\n\necho \"unexpected opencode args: $*\" >&2\nexit 64\nMOCK_OPENCODE\n}\n\nwrite_current_export_mock() {\n  local path=\"$1\"\n\n  write_executable_mock \"$path\" emit_current_export_mock_body\n}\n\nemit_session_id_env_mock_body() {\n  cat <<'MOCK_OPENCODE'\n#!/usr/bin/env bash\nset -euo pipefail\n\nif [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n  printf '[]\\n'\n  exit 0\nfi\n\nif [[ \"$1\" == \"export\" ]]; then\n  session_id=\"$2\"\n  printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n  if [[ \"$session_id\" != \"ses_env_requested\" ]]; then\n    printf '[]\\n'\n    exit 0\n  fi\n  cat <<'JSON'\n{\n  \"info\": {\n    \"id\": \"ses_env_requested\",\n    \"time\": {\"created\": 1700000000000}\n  },\n  \"messages\": [\n    {\n      \"info\": {\n        \"role\": \"user\",\n        \"time\": {\"created\": 1700000000000},\n        \"id\": \"msg_user_env\",\n        \"sessionID\": \"ses_env_requested\"\n      },\n      \"parts\": [{\"type\": \"text\", \"text\": \"wake via SESSION_ID env\"}]\n    },\n    {\n      \"info\": {\n        \"role\": \"assistant\",\n        \"time\": {\"created\": 1700000005000},\n        \"id\": \"msg_assistant_env\",\n        \"sessionID\": \"ses_env_requested\"\n      },\n      \"parts\": [{\"type\": \"text\", \"text\": \"confirmed via env\"}]\n    }\n  ]\n}\nJSON\n  exit 0\nfi\n\necho \"unexpected opencode args: $*\" >&2\nexit 64\nMOCK_OPENCODE\n}\n\nwrite_session_id_env_mock() {\n  local path=\"$1\"\n\n  write_executable_mock \"$path\" emit_session_id_env_mock_body\n}\n\nrun_opencode_turns() {\n  local tmpdir=\"$1\"\n  local opencode_bin=\"$2\"\n\n  RUN_STDOUT=\"$tmpdir/stdout.jsonl\"\n  RUN_STDERR=\"$tmpdir/stderr.txt\"\n  OPENCODE_TURNS_EXPORT_LOG=\"$tmpdir/exports.log\"\n  export OPENCODE_TURNS_EXPORT_LOG\n  : >\"$OPENCODE_TURNS_EXPORT_LOG\"\n\n  set +e\n  OPENCODE_BIN=\"$opencode_bin\" \\\n    OPENCODE_TURNS_WINDOW_HOURS=\"${OPENCODE_TURNS_WINDOW_HOURS:-6}\" \\\n    OPENCODE_TURNS_MAX_SESSIONS=\"${OPENCODE_TURNS_MAX_SESSIONS:-25}\" \\\n    OPENCODE_TURNS_CALL_TIMEOUT=\"${OPENCODE_TURNS_CALL_TIMEOUT:-20}\" \\\n    OPENCODE_TURNS_DEADLINE=\"${OPENCODE_TURNS_DEADLINE:-60}\" \\\n    \"$SCRIPT\" \"$tmpdir/opencode-root\" >\"$RUN_STDOUT\" 2>\"$RUN_STDERR\"\n  RUN_STATUS=$?\n  set -e\n}\n\nrun_opencode_turns_with_session_id_env_on_path() {\n  local tmpdir=\"$1\"\n  local session_id=\"$2\"\n\n  RUN_STDOUT=\"$tmpdir/stdout.jsonl\"\n  RUN_STDERR=\"$tmpdir/stderr.txt\"\n  OPENCODE_TURNS_EXPORT_LOG=\"$tmpdir/exports.log\"\n  export OPENCODE_TURNS_EXPORT_LOG\n  : >\"$OPENCODE_TURNS_EXPORT_LOG\"\n\n  set +e\n  env -u OPENCODE_BIN \\\n    PATH=\"$tmpdir/bin:$PATH\" \\\n    SESSION_ID=\"$session_id\" \\\n    OPENCODE_TURNS_WINDOW_HOURS=6 \\\n    OPENCODE_TURNS_MAX_SESSIONS=25 \\\n    OPENCODE_TURNS_CALL_TIMEOUT=20 \\\n    OPENCODE_TURNS_DEADLINE=60 \\\n    \"$SCRIPT\" \"$tmpdir/opencode-root\" >\"$RUN_STDOUT\" 2>\"$RUN_STDERR\"\n  RUN_STATUS=$?\n  set -e\n}\n\ntest_timestampless_session_list_applies_max_sessions_cap() {\n  local tmpdir\n  tmpdir=\"$(mktemp -d)\"\n  trap \"rm -rf '$tmpdir'\" RETURN\n\n  mkdir -p \"$tmpdir/bin\"\n  write_timestampless_cap_mock \"$tmpdir/bin/opencode\"\n\n  OPENCODE_TURNS_MAX_SESSIONS=3 run_opencode_turns \"$tmpdir\" \"$tmpdir/bin/opencode\"\n\n  assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n  assert_eq \"$(cat \"$OPENCODE_TURNS_EXPORT_LOG\")\" $'ses_cap_one\\nses_cap_two\\nses_cap_three' \"$FUNCNAME exports\"\n  assert_eq \"$(wc -l <\"$OPENCODE_TURNS_EXPORT_LOG\" | tr -d ' ')\" \"3\" \"$FUNCNAME export count\"\n  assert_stdout_contains '\"session_id\":\"ses_cap_one\"' \"$FUNCNAME cap one\"\n  assert_stdout_contains '\"session_id\":\"ses_cap_three\"' \"$FUNCNAME cap three\"\n  assert_stdout_not_contains 'ses_cap_four' \"$FUNCNAME cap excludes fourth\"\n  assert_stdout_not_contains 'ses_cap_five' \"$FUNCNAME cap excludes fifth\"\n}\n\ntest_exports_only_recent_window_sessions() {\n  local tmpdir\n  tmpdir=\"$(mktemp -d)\"\n  trap \"rm -rf '$tmpdir'\" RETURN\n\n  mkdir -p \"$tmpdir/bin\"\n  write_window_filter_mock \"$tmpdir/bin/opencode\"\n\n  run_opencode_turns \"$tmpdir\" \"$tmpdir/bin/opencode\"\n\n  assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n  assert_eq \"$(cat \"$OPENCODE_TURNS_EXPORT_LOG\")\" $'ses_recent_one\\nses_recent_two' \"$FUNCNAME exports\"\n  assert_stdout_contains '\"session_id\":\"ses_recent_one\"' \"$FUNCNAME recent one\"\n  assert_stdout_contains '\"session_id\":\"ses_recent_two\"' \"$FUNCNAME recent two\"\n  assert_stdout_not_contains 'ses_old' \"$FUNCNAME old excluded\"\n  assert_stdout_not_contains 'ses_without_timestamp' \"$FUNCNAME timestampless excluded when list has timestamps\"\n  assert_stdout_not_contains '\"degraded\":true' \"$FUNCNAME not degraded\"\n}\n\ntest_timeout_emits_degraded_best_effort_and_exits_zero() {\n  local tmpdir\n  tmpdir=\"$(mktemp -d)\"\n  trap \"rm -rf '$tmpdir'\" RETURN\n\n  mkdir -p \"$tmpdir/bin\"\n  write_timeout_mock \"$tmpdir/bin/opencode\"\n\n  local start end elapsed\n  start=\"$(date +%s)\"\n  OPENCODE_TURNS_CALL_TIMEOUT=1 OPENCODE_TURNS_DEADLINE=3 run_opencode_turns \"$tmpdir\" \"$tmpdir/bin/opencode\"\n  end=\"$(date +%s)\"\n  elapsed=$((end - start))\n\n  assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n  assert_stdout_contains '\"session_id\":\"ses_fast\"' \"$FUNCNAME fast record\"\n  assert_stdout_contains '\"degraded\":true' \"$FUNCNAME degraded marker\"\n  assert_stdout_contains '\"count\":1' \"$FUNCNAME best count\"\n  if [[ \"$elapsed\" -gt 4 ]]; then\n    fail \"$FUNCNAME: expected deadline-bounded execution, took ${elapsed}s\"\n  fi\n}\n\ntest_timeout_kills_opencode_process_group_descendant() {\n  local tmpdir\n  tmpdir=\"$(mktemp -d)\"\n  trap \"rm -rf '$tmpdir'\" RETURN\n\n  mkdir -p \"$tmpdir/bin\"\n  write_descendant_timeout_mock \"$tmpdir/bin/opencode\"\n  OPENCODE_TURNS_DESCENDANT_MARKER=\"$tmpdir/descendant-marker\"\n  OPENCODE_TURNS_DESCENDANT_PID=\"$tmpdir/descendant.pid\"\n  export OPENCODE_TURNS_DESCENDANT_MARKER OPENCODE_TURNS_DESCENDANT_PID\n\n  OPENCODE_TURNS_CALL_TIMEOUT=1 OPENCODE_TURNS_DEADLINE=3 run_opencode_turns \"$tmpdir\" \"$tmpdir/bin/opencode\"\n\n  assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n  assert_stdout_contains '\"degraded\":true' \"$FUNCNAME degraded marker\"\n  assert_stdout_contains '\"count\":0' \"$FUNCNAME no completed assistant records\"\n  [[ -s \"$OPENCODE_TURNS_DESCENDANT_PID\" ]] || fail \"$FUNCNAME: descendant pid file was not written\"\n  [[ -s \"$OPENCODE_TURNS_DESCENDANT_MARKER\" ]] || fail \"$FUNCNAME: descendant marker was not written\"\n\n  local descendant_pid\n  descendant_pid=\"$(cat \"$OPENCODE_TURNS_DESCENDANT_PID\")\"\n  assert_marker_stopped_growing \"$OPENCODE_TURNS_DESCENDANT_MARKER\" \"$FUNCNAME\"\n  assert_process_not_running \"$descendant_pid\" \"$FUNCNAME\"\n}\n\ntest_base_dir_suffix_selects_matching_opencode_command() {\n  local tmpdir\n  tmpdir=\"$(mktemp -d)\"\n  trap \"rm -rf '$tmpdir'\" RETURN\n\n  mkdir -p \"$tmpdir/bin\" \"$tmpdir/.opencode3/opencode\"\n  write_command_derivation_mock \"$tmpdir/bin/opencode3\"\n  RUN_STDOUT=\"$tmpdir/stdout.jsonl\"\n  RUN_STDERR=\"$tmpdir/stderr.txt\"\n  OPENCODE_TURNS_EXPORT_LOG=\"$tmpdir/exports.log\"\n  OPENCODE_TURNS_COMMAND_LOG=\"$tmpdir/commands.log\"\n  export OPENCODE_TURNS_EXPORT_LOG OPENCODE_TURNS_COMMAND_LOG\n  : >\"$OPENCODE_TURNS_EXPORT_LOG\"\n  : >\"$OPENCODE_TURNS_COMMAND_LOG\"\n\n  set +e\n  env -u OPENCODE_BIN \\\n    PATH=\"$tmpdir/bin:$PATH\" \\\n    SESSION_ID=ses_env_ignored \\\n    OPENCODE_TURNS_WINDOW_HOURS=6 \\\n    OPENCODE_TURNS_MAX_SESSIONS=25 \\\n    OPENCODE_TURNS_CALL_TIMEOUT=20 \\\n    OPENCODE_TURNS_DEADLINE=60 \\\n    \"$SCRIPT\" \"$tmpdir/.opencode3/opencode\" ses_account >\"$RUN_STDOUT\" 2>\"$RUN_STDERR\"\n  RUN_STATUS=$?\n  set -e\n\n  assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n  assert_eq \"$(cat \"$OPENCODE_TURNS_COMMAND_LOG\")\" \"opencode3\" \"$FUNCNAME command\"\n  assert_eq \"$(cat \"$OPENCODE_TURNS_EXPORT_LOG\")\" \"ses_account\" \"$FUNCNAME export\"\n  assert_stdout_contains '\"role\":\"user\"' \"$FUNCNAME user record\"\n}\n\ntest_current_export_info_metadata_emits_turns() {\n  local tmpdir\n  tmpdir=\"$(mktemp -d)\"\n  trap \"rm -rf '$tmpdir'\" RETURN\n\n  mkdir -p \"$tmpdir/bin\"\n  write_current_export_mock \"$tmpdir/bin/opencode\"\n\n  run_opencode_turns \"$tmpdir\" \"$tmpdir/bin/opencode\"\n\n  assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n  assert_eq \"$(cat \"$OPENCODE_TURNS_EXPORT_LOG\")\" \"ses_current_requested\" \"$FUNCNAME export\"\n  assert_current_export_records \"$FUNCNAME\"\n}\n\ntest_session_id_env_used_when_no_positional_sessions() {\n  local tmpdir\n  tmpdir=\"$(mktemp -d)\"\n  trap \"rm -rf '$tmpdir'\" RETURN\n\n  mkdir -p \"$tmpdir/bin\"\n  write_session_id_env_mock \"$tmpdir/bin/opencode\"\n\n  run_opencode_turns_with_session_id_env_on_path \"$tmpdir\" \"ses_env_requested\"\n\n  assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n  assert_eq \"$(cat \"$OPENCODE_TURNS_EXPORT_LOG\")\" \"ses_env_requested\" \"$FUNCNAME export\"\n  assert_session_id_env_export_records \"$FUNCNAME\"\n}\n\ntest_timestampless_session_list_applies_max_sessions_cap\ntest_exports_only_recent_window_sessions\ntest_timeout_emits_degraded_best_effort_and_exits_zero\ntest_timeout_kills_opencode_process_group_descendant\ntest_base_dir_suffix_selects_matching_opencode_command\ntest_current_export_info_metadata_emits_turns\ntest_session_id_env_used_when_no_positional_sessions\n\necho \"opencode-turns tests passed\"","lineStart":1,"lineEnd":783,"totalLines":783,"truncated":false}},"title":"scripts/tests/opencode-turns.test.sh","time":{"start":1780923557638,"end":1780923557819}},"metadata":{"openai":{"itemId":"fc_0daa145c665b7f61016a26bca58b54819aa8a6ffcdff3805ee"}},"id":"prt_ea750e6fc001y4I3dqBC4TldUe","sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","messageID":"msg_ea750c80b001UUynyyVLgp2Oka"}}
{"type":"tool_use","timestamp":1780923557838,"sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","part":{"type":"tool","tool":"read","callID":"call_I9LOnknhMIM49Cr9ptijAuUQ","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/s11_external_provider_wake.rs","offset":1,"limit":260},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/tests/s11_external_provider_wake.rs</path>\n<type>file</type>\n<content>\n1: #![cfg(unix)]\n2: \n3: //! ## Declared roles\n4: //!\n5: //! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n6: //! predicate, filter.\n7: //!\n8: //! TEST: external-provider wake/resume end-to-end fixtures — fake provider\n9: //! CLI script formatters, fixture model mappers, state/sidecar accessors,\n10: //! JSON/record parsers, pending-delivery predicates and filters, durable row\n11: //! validators, and test orchestration.\n12: //!\n13: //! ## Adapter declarations\n14: //!\n15: //! ```yaml\n16: //! adapter_declarations:\n17: //!   - component: src-tauri/tests/s11_external_provider_wake.rs\n18: //!     role: adapter\n19: //!     Translates:\n20: //!       - external-provider-runtime-cli-contract\n21: //!       - wake-notification-delivery-contract\n22: //!       - pid-identity-sidecar-contract\n23: //!       - invocation-state-db-contract\n24: //!       - test-fixture-process-contract\n25: //! intrinsic_surface_declarations:\n26: //!   - component: src-tauri/tests/s11_external_provider_wake.rs\n27: //!     role: intrinsic-surface\n28: //!     Domain: external-provider wake CLI regression suite\n29: //!     Owns:\n30: //!       - isolated config/data fixture materialization\n31: //!       - external provider Python script generation and executable setup\n32: //!       - wake command invocation and environment isolation\n33: //!       - provider record parsing and subcommand filtering assertions\n34: //!       - sidecar wake-claim and mailbox delivery assertions\n35: //! ```\n36: \n37: use oulipoly_state::mailbox::MailboxDb;\n38: use rusqlite::{Connection, params};\n39: use serde_json::Value;\n40: use std::fs;\n41: use std::os::unix::fs::PermissionsExt;\n42: use std::path::{Path, PathBuf};\n43: use std::process::{Command, Output};\n44: use std::time::{Duration, Instant};\n45: \n46: const MODEL: &str = \"s11-external-wake-model\";\n47: const PROVIDER: &str = \"opencode\";\n48: const SESSION: &str = \"ses_s11externalwake\";\n49: const HANDLE: &str = \"h-s11-external\";\n50: \n51: struct Fixture {\n52:     dir: tempfile::TempDir,\n53:     config_home: PathBuf,\n54:     data_home: PathBuf,\n55:     home_dir: PathBuf,\n56:     app_config_dir: PathBuf,\n57:     models_dir: PathBuf,\n58:     work_dir: PathBuf,\n59: }\n60: \n61: impl Fixture {\n62:     fn new() -> Self {\n63:         let dir = tempfile::tempdir().unwrap();\n64:         let config_home = dir.path().join(\"xdg-config\");\n65:         let data_home = dir.path().join(\"xdg-data\");\n66:         let home_dir = dir.path().join(\"home\");\n67:         let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n68:         let models_dir = app_config_dir.join(\"models\");\n69:         let work_dir = dir.path().join(\"work\");\n70:         fs::create_dir_all(&models_dir).unwrap();\n71:         fs::create_dir_all(&home_dir).unwrap();\n72:         fs::create_dir_all(&work_dir).unwrap();\n73:         Self {\n74:             dir,\n75:             config_home,\n76:             data_home,\n77:             home_dir,\n78:             app_config_dir,\n79:             models_dir,\n80:             work_dir,\n81:         }\n82:     }\n83: \n84:     fn sidecar_path(&self) -> PathBuf {\n85:         self.data_home\n86:             .join(\"oulipoly-agent-runner\")\n87:             .join(\"pid-identity.db\")\n88:     }\n89: \n90:     fn state_path(&self) -> PathBuf {\n91:         self.data_home\n92:             .join(\"oulipoly-agent-runner\")\n93:      