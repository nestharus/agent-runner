1764: +use std::sync::OnceLock;\n1765:  use std::time::Duration;\n1766:  use uuid::Uuid;\n1767:  \n1768: @@ -29,6 +33,13 @@ const DEFAULT_AUTO_WAKE_MAX: i64 = 5;\n1769:  const DEFAULT_AUTO_WAKE_RETRY_BASE_MS: u64 = 1_000;\n1770:  const AUTO_WAKE_RETRY_MAX_MS: u64 = 30_000;\n1771:  const WAKE_CLAIM_STALE_AFTER_SECONDS: i64 = 10 * 60;\n1772: +const WAKE_RECLAIM_SWEEP_LIMIT: usize = 8;\n1773: +const WAKE_RECLAIM_SWEEP_SCAN_LIMIT: usize = WAKE_RECLAIM_SWEEP_LIMIT * 32;\n1774: +const WAKE_RECLAIM_REAP_SESSION_LIMIT: usize = 32;\n1775: +const WAKE_RECLAIM_REAP_ROWS_PER_SESSION: usize = 20;\n1776: +#[allow(dead_code)]\n1777: +const WAKE_RECLAIM_SWEEP_INTERVAL_SECONDS: u64 = 60;\n1778: +const CONSUMED_NOTIFICATION_MARKER: &str = \"[OULIPOLY NOTIFICATIONS]\";\n1779:  \n1780:  #[derive(Debug, Clone, Serialize)]\n1781:  pub(crate) struct WakeDiagnostic {\n1782: @@ -89,6 +100,327 @@ pub(crate) fn trigger_notify_wake(session_id: &str) -> WakeDiagnostic {\n1783:      })\n1784:  }\n1785:  \n1786: +pub(crate) fn run_startup_wake_reclaim_sweep() {\n1787: +    if is_auto_wake_invocation() {\n1788: +        return;\n1789: +    }\n1790: +    run_wake_reclaim_sweep_or_warn(\"process_start\");\n1791: +}\n1792: +\n1793: +#[allow(dead_code)]\n1794: +pub(crate) fn start_wake_reclaim_maintenance_driver() {\n1795: +    static DRIVER: OnceLock<()> = OnceLock::new();\n1796: +    DRIVER.get_or_init(spawn_wake_reclaim_maintenance_driver);\n1797: +}\n1798: +\n1799: +#[allow(dead_code)]\n1800: +fn spawn_wake_reclaim_maintenance_driver() {\n1801: +    let result = std::thread::Builder::new()\n1802: +        .name(\"oulipoly-wake-reclaim-sweep\".to_string())\n1803: +        .spawn(wake_reclaim_maintenance_loop);\n1804: +    if let Err(err) = result {\n1805: +        tracing::warn!(\"Failed to start wake reclaim sweep driver: {err}\");\n1806: +    }\n1807: +}\n1808: +\n1809: +#[allow(dead_code)]\n1810: +fn wake_reclaim_maintenance_loop() {\n1811: +    run_wake_reclaim_sweep_or_warn(\"maintenance_start\");\n1812: +    loop {\n1813: +        std::thread::sleep(Duration::from_secs(WAKE_RECLAIM_SWEEP_INTERVAL_SECONDS));\n1814: +        run_wake_reclaim_sweep_or_warn(\"maintenance_tick\");\n1815: +    }\n1816: +}\n1817: +\n1818: +fn run_wake_reclaim_sweep_or_warn(trigger: &str) {\n1819: +    if let Err(err) = run_wake_reclaim_sweep(trigger) {\n1820: +        tracing::warn!(trigger, \"Wake reclaim sweep failed: {err}\");\n1821: +    }\n1822: +}\n1823: +\n1824: +fn run_wake_reclaim_sweep(trigger: &str) -> Result<(), String> {\n1825: +    let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n1826: +        return Ok(());\n1827: +    };\n1828: +    let candidates = db.wake_sweep_candidates(\n1829: +        WAKE_CLAIM_STALE_AFTER_SECONDS,\n1830: +        WAKE_RECLAIM_SWEEP_SCAN_LIMIT,\n1831: +    )?;\n1832: +    let plan = wake_sweep_plan(&mut db, candidates)?;\n1833: +    reap_abandoned_sweep_candidates(&mut db, &plan.reap)?;\n1834: +    drop(db);\n1835: +    for candidate in plan.start {\n1836: +        let diagnostic = start_wake_chain(StartWakeInput {\n1837: +            session_id: &candidate.session_id,\n1838: +            reason: trigger,\n1839: +            auto_wake_count: candidate.auto_wake_count,\n1840: +            renew_token: None,\n1841: +        });\n1842: +        trace_wake_sweep_candidate(&candidate.session_id, &diagnostic);\n1843: +    }\n1844: +    Ok(())\n1845: +}\n1846: +\n1847: +struct WakeSweepPlan {\n1848: +    start: Vec<WakeSweepCandidate>,\n1849: +    reap: Vec<WakeSweepCandidate>,\n1850: +}\n1851: +\n1852: +fn wake_sweep_plan(\n1853: +    db: &mut MailboxDb,\n1854: +    candidates: Vec<WakeSweepCandidate>,\n1855: +) -> Result<WakeSweepPlan, String> {\n1856: +    let (recoverable, reap) = partition_wake_sweep_candidates(db, candidates)?;\n1857: +    let start = select_recoverable_sweep_candidates(recoverable);\n1858: +    Ok(wake_sweep_plan_from_selected(start, reap))\n1859: +}\n1860: +\n1861: +fn partition_wake_sweep_candidates(\n1862: +    db: &mut MailboxDb,\n1863: +    candidates: Vec<WakeSweepCandidate>,\n1864: +) -> Result<(Vec<WakeSweepCandidate>, Vec<WakeSweepCandidate>), String> {\n1865: +    let state = open_default_state_read_only();\n1866: +    let mut recoverable = Vec::new();\n1867: +    let mut reap = Vec::new();\n1868: +    for candidate in candidates {\n1869: +        match wake_sweep_candidate_disposition(db, state.as_ref(), &candidate)? {\n1870: +            WakeSweepDisposition::Recoverable => {\n1871: +                recoverable.push(candidate);\n1872: +            }\n1873: +            WakeSweepDisposition::Abandoned => {\n1874: +                if reap.len() < WAKE_RECLAIM_REAP_SESSION_LIMIT {\n1875: +                    reap.push(candidate);\n1876: +                }\n1877: +            }\n1878: +            WakeSweepDisposition::Skip => {}\n1879: +        }\n1880: +    }\n1881: +    Ok((recoverable, reap))\n1882: +}\n1883: +\n1884: +fn wake_sweep_plan_from_selected(\n1885: +    start: Vec<WakeSweepCandidate>,\n1886: +    reap: Vec<WakeSweepCandidate>,\n1887: +) -> WakeSweepPlan {\n1888: +    WakeSweepPlan { start, reap }\n1889: +}\n1890: +\n1891: +fn select_recoverable_sweep_candidates(\n1892: +    mut candidates: Vec<WakeSweepCandidate>,\n1893: +) -> Vec<WakeSweepCandidate> {\n1894: +    if candidates.len() <= WAKE_RECLAIM_SWEEP_LIMIT {\n1895: +        return candidates;\n1896: +    }\n1897: +    candidates.sort_by_key(|candidate| candidate.min_pending_seq);\n1898: +    let oldest_slots = WAKE_RECLAIM_SWEEP_LIMIT.div_ceil(2);\n1899: +    let newest_slots = WAKE_RECLAIM_SWEEP_LIMIT.saturating_sub(oldest_slots);\n1900: +    let mut selected = candidates\n1901: +        .iter()\n1902: +        .take(oldest_slots)\n1903: +        .cloned()\n1904: +        .collect::<Vec<_>>();\n1905: +    for candidate in candidates.iter().rev().take(newest_slots) {\n1906: +        if !selected\n1907: +            .iter()\n1908: +            .any(|existing| existing.session_id == candidate.session_id)\n1909: +        {\n1910: +            selected.push(candidate.clone());\n1911: +        }\n1912: +    }\n1913: +    selected\n1914: +}\n1915: +\n1916: +#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n1917: +enum WakeSweepDisposition {\n1918: +    Recoverable,\n1919: +    Abandoned,\n1920: +    Skip,\n1921: +}\n1922: +\n1923: +fn wake_sweep_candidate_disposition(\n1924: +    db: &MailboxDb,\n1925: +    state: Option<&StateDb>,\n1926: +    candidate: &WakeSweepCandidate,\n1927: +) -> Result<WakeSweepDisposition, String> {\n1928: +    // Recoverable means either an idle headless runtime with durable resume\n1929: +    // evidence, or a live owner PID identity that must not be reaped. Missing\n1930: +    // runtime/history with no live owner is abandoned debris, not resumable work.\n1931: +    if pending_mailbox_consumed_marker_present(db, &candidate.session_id) {\n1932: +        return Ok(WakeSweepDisposition::Skip);\n1933: +    }\n1934: +    if wake_sweep_candidate_is_resumable(db, state, candidate)? {\n1935: +        return Ok(resumable_wake_sweep_disposition(candidate));\n1936: +    }\n1937: +    if wake_sweep_candidate_has_live_owner(db, &candidate.session_id)? {\n1938: +        return Ok(WakeSweepDisposition::Skip);\n1939: +    }\n1940: +    Ok(WakeSweepDisposition::Abandoned)\n1941: +}\n1942: +\n1943: +fn resumable_wake_sweep_disposition(candidate: &WakeSweepCandidate) -> WakeSweepDisposition {\n1944: +    if wake_sweep_candidate_reached_cap(candidate)\n1945: +        || !wake_sweep_candidate_has_deliverable_pending(&candidate.session_id)\n1946: +    {\n1947: +        return WakeSweepDisposition::Skip;\n1948: +    }\n1949: +    WakeSweepDisposition::Recoverable\n1950: +}\n1951: +\n1952: +fn reap_abandoned_sweep_candidates(\n1953: +    db: &mut MailboxDb,\n1954: +    candidates: &[WakeSweepCandidate],\n1955: +) -> Result<(), String> {\n1956: +    for candidate in candidates {\n1957: +        db.mark_pending_abandoned(\n1958: +            &candidate.session_id,\n1959: +            WAKE_SWEEP_ABANDONED_ERROR,\n1960: +            WAKE_RECLAIM_REAP_ROWS_PER_SESSION,\n1961: +        )?;\n1962: +    }\n1963: +    Ok(())\n1964: +}\n1965: +\n1966: +fn wake_sweep_candidate_has_deliverable_pending(session_id: &str) -> bool {\n1967: +    crate::mailbox_delivery::deliverable_pending_count(session_id)\n1968: +        .map(|count| count > 0)\n1969: +        .unwrap_or(false)\n1970: +}\n1971: +\n1972: +fn wake_sweep_candidate_is_resumable(\n1973: +    db: &MailboxDb,\n1974: +    state: Option<&StateDb>,\n1975: +    candidate: &WakeSweepCandidate,\n1976: +) -> Result<bool, String> {\n1977: +    let Some(runtime) = db.session_runtime(&candidate.session_id)? else {\n1978: +        return Ok(false);\n1979: +    };\n1980: +    if !wake_sweep_runtime_can_resume(&runtime) {\n1981: +        return Ok(false);\n1982: +    }\n1983: +    wake_sweep_runtime_has_resume_evidence(state, &runtime)\n1984: +}\n1985: +\n1986: +fn wake_sweep_runtime_can_resume(runtime: &SessionRuntimeRow) -> bool {\n1987: +    runtime.mode == \"headless\"\n1988: +        && runtime.run_state != \"running\"\n1989: +        && runtime\n1990: +            .provider_name\n1991: +            .as_deref()\n1992: +            .is_some_and(|provider| !provider.is_empty())\n1993: +}\n1994: +\n1995: +fn wake_sweep_runtime_has_resume_evidence(\n1996: +    state: Option<&StateDb>,\n1997: +    runtime: &SessionRuntimeRow,\n1998: +) -> Result<bool, String> {\n1999: +    let Some(state) = state else {\n2000: +        return Ok(false);\n2001: +    };\n2002: +    let Some(provider_name) = runtime.provider_name.as_deref() else {\n2003: +        return Ok(false);\n2004: +    };\n2005: +    if state\n2006: +        .chain_id_for_segment(provider_name, &runtime.session_id)\n2007: +        .map_err(|err| err.to_string())?\n2008: +        .is_some()\n2009: +    {\n2010: +        return Ok(true);\n2011: +    }\n2012: +    state\n2013: +        .count_session_turns(provider_name, &runtime.session_id)\n2014: +        .map(|counts| counts.total > 0)\n2015: +}\n2016: +\n2017: +fn wake_sweep_candidate_has_live_owner(db: &MailboxDb, session_id: &str) -> Result<bool, String> {\n2018: +    for row in db.list_pending(session_id)? {\n2019: +        if mailbox_row_has_live_owner_identity(&row)? {\n2020: +            return Ok(true);\n2021: +        }\n2022: +    }\n2023: +    Ok(false)\n2024: +}\n2025: +\n2026: +fn mailbox_row_has_live_owner_identity(row: &MailboxRow) -> Result<bool, String> {\n2027: +    let Some(recorded) = mailbox_row_owner_identity(row) else {\n2028: +        return Ok(false);\n2029: +    };\n2030: +    read_live_process_identity(recorded.os_pid).map(|live| live.as_ref() == Some(&recorded))\n2031: +}\n2032: +\n2033: +fn mailbox_row_owner_identity(row: &MailboxRow) -> Option<ProcessIdentity> {\n2034: +    Some(ProcessIdentity {\n2035: +        os_pid: row.matched_os_pid?,\n2036: +        os_boot_id: row.matched_os_boot_id.clone()?,\n2037: +        os_pid_starttime_ticks: row.matched_os_pid_starttime_ticks?,\n2038: +    })\n2039: +}\n2040: +\n2041: +fn wake_sweep_candidate_reached_cap(candidate: &WakeSweepCandidate) -> bool {\n2042: +    auto_wake_cap_reached(candidate.auto_wake_count.saturating_sub(1), auto_wake_max())\n2043: +}\n2044: +\n2045: +fn pending_mailbox_consumed_marker_present(db: &MailboxDb, session_id: &str) -> bool {\n2046: +    let Ok(pending) = db.list_pending(session_id) else {\n2047: +        return false;\n2048: +    };\n2049: +    if pending.is_empty() {\n2050: +        return true;\n2051: +    }\n2052: +    let Some(provider_name) = pending_mailbox_provider_name(db, session_id) else {\n2053: +        return false;\n2054: +    };\n2055: +    let Some(state) = open_default_state_read_only() else {\n2056: +        return false;\n2057: +    };\n2058: +    session_has_consumed_notification_marker(&state, &provider_name, session_id)\n2059: +        && pending.iter().all(|row| {\n2060: +            state\n2061: +                .has_session_user_turn_containing(\n2062: +                    &provider_name,\n2063: +                    session_id,\n2064: +                    &mailbox_handle_marker(row),\n2065: +                )\n2066: +                .unwrap_or(false)\n2067: +        })\n2068: +}\n2069: +\n2070: +fn mailbox_handle_marker(row: &MailboxRow) -> String {\n2071: +    format!(\"handle: {}\", row.handle)\n2072: +}\n2073: +\n2074: +fn open_default_state_read_only() -> Option<StateDb> {\n2075: +    let path = StateDb::default_path().ok()?;\n2076: +    if !path.exists() {\n2077: +        return None;\n2078: +    }\n2079: +    StateDb::open_read_only(&path).ok()\n2080: +}\n2081: +\n2082: +fn pending_mailbox_provider_name(db: &MailboxDb, session_id: &str) -> Option<String> {\n2083: +    db.session_runtime(session_id)\n2084: +        .ok()\n2085: +        .flatten()\n2086: +        .and_then(|runtime| runtime.provider_name)\n2087: +}\n2088: +\n2089: +fn session_has_consumed_notification_marker(\n2090: +    state: &StateDb,\n2091: +    provider_name: &str,\n2092: +    session_id: &str,\n2093: +) -> bool {\n2094: +    state\n2095: +        .has_session_user_turn_containing(provider_name, session_id, CONSUMED_NOTIFICATION_MARKER)\n2096: +        .unwrap_or(false)\n2097: +}\n2098: +\n2099: +fn trace_wake_sweep_candidate(session_id: &str, diagnostic: &WakeDiagnostic) {\n2100: +    tracing::debug!(\n2101: +        session_id,\n2102: +        status = diagnostic.status.as_str(),\n2103: +        \"Wake reclaim sweep candidate evaluated\"\n2104: +    );\n2105: +}\n2106: +\n2107:  pub(crate) fn mark_successful_turn_idle_and_recheck(\n2108:      session_id: &str,\n2109:      invocation_uuid: &str,\n2110: @@ -412,7 +744,13 @@ fn start_wake_chain(input: StartWakeInput<'_>) -> WakeDiagnostic {\n2111:          &context.claim.claim_token,\n2112:          input.auto_wake_count,\n2113:      );\n2114: -    wake_spawn_diagnostic(&mut context.db, input, context.claim, spawn)\n2115: +    wake_spawn_diagnos