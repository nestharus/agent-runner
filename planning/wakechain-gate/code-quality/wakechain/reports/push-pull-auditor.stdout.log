ath = sys.argv[1]\n1253: +with open(path, encoding=\"utf-8\") as handle:\n1254: +    records = [json.loads(line) for line in handle if line.strip()]\n1255: +\n1256: +expected = [\n1257: +    {\n1258: +        \"session_id\": \"ses_current_info\",\n1259: +        \"turn_id\": \"msg_user_current\",\n1260: +        \"timestamp\": \"2023-11-14T22:13:20Z\",\n1261: +        \"role\": \"user\",\n1262: +        \"body\": [\n1263: +            {\n1264: +                \"type\": \"text\",\n1265: +                \"text\": \"[OULIPOLY-DELIVERY 123e4567-e89b-12d3-a456-426614174000] wake please\",\n1266: +            }\n1267: +        ],\n1268: +    },\n1269: +    {\n1270: +        \"session_id\": \"ses_current_info\",\n1271: +        \"turn_id\": \"msg_assistant_current\",\n1272: +        \"timestamp\": \"2023-11-14T22:13:25Z\",\n1273: +        \"role\": \"assistant\",\n1274: +        \"body\": [{\"type\": \"text\", \"text\": \"confirmed\"}],\n1275: +    },\n1276: +]\n1277: +\n1278: +if records != expected:\n1279: +    print(\"expected:\", json.dumps(expected, indent=2), file=sys.stderr)\n1280: +    print(\"actual:\", json.dumps(records, indent=2), file=sys.stderr)\n1281: +    raise SystemExit(1)\n1282: +PY\n1283: +}\n1284: +\n1285: +assert_session_id_env_export_records() {\n1286: +  local label=\"$1\"\n1287: +\n1288: +  python3 - \"$RUN_STDOUT\" <<'PY' || fail \"$label: SESSION_ID-env export records did not match\"\n1289: +import json\n1290: +import sys\n1291: +\n1292: +path = sys.argv[1]\n1293: +with open(path, encoding=\"utf-8\") as handle:\n1294: +    records = [json.loads(line) for line in handle if line.strip()]\n1295: +\n1296: +expected = [\n1297: +    {\n1298: +        \"session_id\": \"ses_env_requested\",\n1299: +        \"turn_id\": \"msg_user_env\",\n1300: +        \"timestamp\": \"2023-11-14T22:13:20Z\",\n1301: +        \"role\": \"user\",\n1302: +        \"body\": [{\"type\": \"text\", \"text\": \"wake via SESSION_ID env\"}],\n1303: +    },\n1304: +    {\n1305: +