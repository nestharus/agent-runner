6:         terminal_disposition_outcome(disposition_control, result),\n717:     )? {\n718:         return Ok(control);\n719:     }\n720: \n721:     ingest_mailbox_delivery_confirmation_turn_if_needed(input, provider, result, zero_turn_action);\n722: \n723:     if let Some(control) = handle_unconfirmed_mailbox_delivery_if_needed(\n724:         input,\n725:         attempt,\n726:         provider,\n727:         provider_session_id,\n728:         result,\n729:         zero_turn_action,\n730:     )? {\n731:         return Ok(control);\n732:     }\n733: \n734:     finalize_completed_attempt_for_resume(input, attempt, provider, provider_session_id, result)\n735: }\n736: \n737: fn ingest_mailbox_delivery_confirmation_turn_if_needed(\n738:     input: &ResumeAttemptInput<'_>,\n739:     provider: &oulipoly_config::ProviderConfig,\n740:     result: &executor::ExecutionResult,\n741:     zero_turn_action: ZeroTurnAction,\n742: ) {\n743:     if !mailbox_delivery_requires_turn_confirmation(input, &provider.name, result) {\n744:         return;\n745:     }\n746:     if mailbox_delivery_turn_confirmed(input, &provider.name, result, zero_turn_action) {\n747:         return;\n748:     }\n749:     let report = sessions::scan_provider_session(\n750:         &provider.name,\n751:         &input.env.sessions_cfg,\n752:         &input.env.state,\n753:         &input.resolved.active_session_id,\n754:     );\n755:     emit_pre_confirmation_session_scan_errors(&provider.name, report.errors);\n756: }\n757: \n758: fn emit_pre_confirmation_session_scan_errors(provider_name: &str, errors: Vec<String>) {\n759:     for error in errors {\n760:         formatter::emit_stderr(&format!(\n761:             \"Warning: Session ingest failed for {provider_name}: {error}\"\n762:         ));\n763:     }\n764: }\n765: \n766: enum ResumeTerminalDispositionOutcome {\n767:     Continue(i32),\n768:     Return(i32),\n769:     CompletedAttempt,\n770: }\n771: \n772: fn terminal_disposition_outcome(\n773:     control: ResumeLoopControl,\n774:     result: &executor::ExecutionResult,\n775: ) -> ResumeTerminalDispositionOutcome {\n776:     match control {\n777:         ResumeLoopControl::Continue => ResumeTerminalDispositionOutcome::Continue(result.exit_code),\n778:         ResumeLoopControl::Return(exit_code) => ResumeTerminalDispositionOutcome::Return(exit_code),\n779:         ResumeLoopControl::CompletedAttempt => ResumeTerminalDispositionOutcome::CompletedAttempt,\n780:     }\n781: }\n782: \n783: fn apply_resume_terminal_disposition_outcome(\n784:     input: &ResumeAttemptInput<'_>,\n785:     attempt: &ResumeInvocationAttempt<'_>,\n786:     provider_session_id: &str,\n787:     result: &executor::ExecutionResult,\n788:     outcome: ResumeTerminalDispositionOutcome,\n789: ) -> Result<Option<ResumeAttemptLoopControl>, String> {\n790:     match outcome {\n791:         ResumeTerminalDispositionOutcome::Continue(exit_code) => {\n792:             record_failed_mailbox_delivery_attempt(\n793:                 input,\n794:                 &failed_delivery_error(result, \"resume_retry\"),\n795:             )?;\n796:             mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n797:             Ok(Some(ResumeAttemptLoopControl::Continue(exit_code)))\n798:         }\n799:         ResumeTerminalDispositionOutcome::Return(exit_code) => {\n800:             record_failed_mailbox_delivery_attempt(\n801:                 input,\n802:                 &failed_delivery_error(result, \"resume_failed\"),\n803:             )?;\n804:             mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n805:             Ok(Some(ResumeAttemptLoopControl::Return(exit_code)))\n806:         }\n807:         ResumeTerminalDispositionOutcome::CompletedAttempt => Ok(None),\n808:     }\n809: }\n810: \n811: fn handle_unconfirmed_mailbox_delivery_if_needed(\n812:     input: &ResumeAttemptInput<'_>,\n813:     attempt: &mut ResumeInvocationAttempt<'_>,\n814:     provider: &oulipoly_config::ProviderConfig,\n815:     provider_session_id: &str,\n816:     result: &executor::ExecutionResult,\n817:     zero_turn_action: ZeroTurnAction,\n818: ) -> Result<Option<ResumeAttemptLoopControl>, String> {\n819:     if !mailbox_delivery_unconfirmed(input, &provider.name, result, zero_turn_action) {\n820:         return Ok(None);\n821:     }\n822:     record_failed_mailbox_delivery_attempt(input, \"mailbox_delivery_unconfirmed\")?;\n823:     finalize_unconfirmed_mailbox_delivery(input, attempt, result)?;\n824:     mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(1))?;\n825:     Ok(Some(ResumeAttemptLoopControl::Return(1)))\n826: }\n827: \n828: fn finalize_completed_attempt_for_resume(\n829:     input: &ResumeAttemptInput<'_>,\n830:     attempt: &mut ResumeInvocationAttempt<'_>,\n831:     provider: &oulipoly_config::ProviderConfig,\n832:     provider_session_id: &str,\n833:     result: &executor::ExecutionResult,\n834: ) -> Result<ResumeAttemptLoopControl, String> {\n835:     match finalize_completed_attempt(CompletedAttemptInput {\n836:         agent_runtime_services: input.agent_runtime_services,\n837:         env: input.env,\n838:         invocation: &attempt.invocation,\n839:         invocation_row_id: attempt.invocation_row_id,\n840:         guard: &mut attempt.guard,\n841:         provider_name: &provider.name,\n842:         model: input.resolved.model.as_ref(),\n843:         result,\n844:         working_dir: input.working_dir,\n845:         manual_migrate: input.manual_migrate,\n846:         session_id: input.session_id,\n847:         active_session_id: &input.resolved.active_session_id,\n848:         effective_spawn_cwd: input.effective_spawn_cwd,\n849:         attempts: input.attempts,\n850:         max_attempts: input.max_attempts,\n851:     })? {\n852:         CompletedAttemptControl::Continue => {\n853:             record_failed_mailbox_delivery_attempt(\n854:                 input,\n855:                 &failed_delivery_error(result, \"quota_exhausted\"),\n856:             )?;\n857:             mark_resume_attempt_idle(\n858:                 provider_session_id,\n859:                 &attempt.invocation.id,\n860:                 Some(result.exit_code),\n861:             )?;\n862:             Ok(ResumeAttemptLoopControl::Continue(result.exit_code))\n863:         }\n864:         CompletedAttemptControl::Return(exit_code) => {\n865:             if exit_code == 0 {\n866:                 crate::mailbox_delivery::mark_headless_resume_delivered(\n867:                     input.mailbox_session_id,\n868:                     input.mailbox_delivery_seqs,\n869:                     &attempt.invocation.id,\n870:                 )?;\n871:                 let _ = crate::wake_coordinator::mark_successful_turn_idle_and_recheck(\n872:                     provider_session_id,\n873:                     &attempt.invocation.id,\n874:                     exit_code,\n875:                 )?;\n876:             } else {\n877:                 record_failed_mailbox_delivery_attempt(\n878:                     input,\n879:                     &failed_delivery_error(result, \"resume_failed\"),\n880:                 )?;\n881:                 mark_resume_attempt_idle(\n882:                     provider_session_id,\n883:                     &attempt.invocation.id,\n884:                     Some(exit_code),\n885:                 )?;\n886:             }\n887:             Ok(ResumeAttemptLoopControl::Return(exit_code))\n888:         }\n889:     }\n890: }\n891: \n892: fn mailbox_delivery_unconfirmed(\n893:     input: &ResumeAttemptInput<'_>,\n894:     provider_name: &str,\n895:     result: &executor::ExecutionResult,\n896:     zero_turn_action: ZeroTurnAction,\n897: ) -> bool {\n898:     mailbox_delivery_requires_turn_confirmation(input, provider_name, result)\n899:         && !mailbox_delivery_turn_confirmed(input, provider_name, result, zero_turn_action)\n900: }\n901: \n902: fn mailbox_delivery_requires_turn_confirmation(\n903:     input: &ResumeAttemptInput<'_>,\n904:     provider_name: &str,\n905:     result: &executor::ExecutionResult,\n906: ) -> bool {\n907:     result.exit_code == 0\n908:         && !input.mailbox_delivery_seqs.is_empty()\n909:         && input.answer.is_some_and(|answer| !answer.trim().is_empty())\n910:         && input.env.sessions_cfg.get(provider_name).is_some()\n911: }\n912: \n913: fn mailbox_delivery_turn_confirmed(\n914:     input: &ResumeAttemptInput<'_>,\n915:     provider_name: &str,\n916:     result: &executor::ExecutionResult,\n917:     zero_turn_action: ZeroTurnAction,\n918: ) -> bool {\n919:     matches!(zero_turn_action, ZeroTurnAction::Continue)\n920:         || submitted_user_turn_confirms_mailbox_delivery(input, result)\n921:         || ingested_user_turn_confirms_mailbox_delivery(input, provider_name)\n922: }\n923: \n924: fn submitted_user_turn_confirms_mailbox_delivery(\n925:     input: &ResumeAttemptInput<'_>,\n926:     result: &executor::ExecutionResult,\n927: ) -> bool {\n928:     let Some(submitted) = result.submitted_user_turn.as_ref() else {\n929:         return false;\n930:     };\n931:     let Some(answer) = input.answer else {\n932:         return false;\n933:     };\n934:     submitted.provider_session_id == input.resolved.active_session_id\n935:         && submitted_user_turn_payload_confirms_mailbox_delivery(input, submitted, answer)\n936: }\n937: \n938: fn submitted_user_turn_payload_confirms_mailbox_delivery(\n939:     input: &ResumeAttemptInput<'_>,\n940:     submitted: &executor::SubmittedUserTurn,\n941:     answer: &str,\n942: ) -> bool {\n943:     if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n944:         return submitted.delivery_nonce.as_deref() == Some(delivery_nonce);\n945:     }\n946:     submitted.prompt_sha256 == sha256_hex(answer.as_bytes())\n947: }\n948: \n949: fn ingested_user_turn_confirms_mailbox_delivery(\n950:     input: &ResumeAttemptInput<'_>,\n951:     provider_name: &str,\n952: ) -> bool {\n953:     if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n954:         return input\n955:             .env\n956:             .state\n957:             .has_session_user_turn_containing(\n958:                 provider_name,\n959:                 &input.resolved.active_session_id,\n960:                 delivery_nonce,\n961:             )\n962:             .unwrap_or(false);\n963:     }\n964: \n965:     let Some(answer) = input.answer else {\n966:         return false;\n967:     };\n968:     input\n969:         .env\n970:         .state\n971:         .has_session_user_text_turn(provider_name, &input.resolved.active_session_id, answer)\n972:         .unwrap_or(false)\n973: }\n974: \n975: fn sha256_hex(bytes: &[u8]) -> String {\n976:     let digest = Sha256::digest(bytes);\n977:     digest.iter().map(|byte| format!(\"{byte:02x}\")).collect()\n978: }\n979: \n\n(Showing lines 680-979 of 1545. Use offset=980 to continue.)\n</content>","metadata":{"preview":"\nfn format_resume_acceptance_service_error(err: oulipoly_runtime::services::ServiceError) -> String {\n    format!(\"resume acceptance service failed: {err}\")\n}\n\nfn handle_resume_attempt_terminal_signal(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n) -> Result<ResumeAttemptLoopControl, String> {\n    let terminal_signal_disposition = terminal_signal_disposition_for_result(\n        &input.env.state,\n        &attempt.invocation.id,\n        &provider.name,\n        provider_session_id,\n        result,\n        zero_turn_action,","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/run/resume/orchestration.rs","text":"\nfn format_resume_acceptance_service_error(err: oulipoly_runtime::services::ServiceError) -> String {\n    format!(\"resume acceptance service failed: {err}\")\n}\n\nfn handle_resume_attempt_terminal_signal(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n) -> Result<ResumeAttemptLoopControl, String> {\n    let terminal_signal_disposition = terminal_signal_disposition_for_result(\n        &input.env.state,\n        &attempt.invocation.id,\n        &provider.name,\n        provider_session_id,\n        result,\n        zero_turn_action,\n    );\n\n    let disposition_control = handle_terminal_signal_disposition(ResumeTerminalDispositionInput {\n        agent_runtime_services: input.agent_runtime_services,\n        env: input.env,\n        invocation_row_id: attempt.invocation_row_id,\n        guard: &mut attempt.guard,\n        result,\n        terminal_signal_disposition,\n        zero_turn_action,\n    })?;\n    if let Some(control) = apply_resume_terminal_disposition_outcome(\n        input,\n        attempt,\n        provider_session_id,\n        result,\n        terminal_disposition_outcome(disposition_control, result),\n    )? {\n        return Ok(control);\n    }\n\n    ingest_mailbox_delivery_confirmation_turn_if_needed(input, provider, result, zero_turn_action);\n\n    if let Some(control) = handle_unconfirmed_mailbox_delivery_if_needed(\n        input,\n        attempt,\n        provider,\n        provider_session_id,\n        result,\n        zero_turn_action,\n    )? {\n        return Ok(control);\n    }\n\n    finalize_completed_attempt_for_resume(input, attempt, provider, provider_session_id, result)\n}\n\nfn ingest_mailbox_delivery_confirmation_turn_if_needed(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) {\n    if !mailbox_delivery_requires_turn_confirmation(input, &provider.name, result) {\n        return;\n    }\n    if mailbox_delivery_turn_confirmed(input, &provider.name, result, zero_turn_action) {\n        return;\n    }\n    let report = sessions::scan_provider_session(\n        &provider.name,\n        &input.env.sessions_cfg,\n        &input.env.state,\n        &input.resolved.active_session_id,\n    );\n    emit_pre_confirmation_session_scan_errors(&provider.name, report.errors);\n}\n\nfn emit_pre_confirmation_session_scan_errors(provider_name: &str, errors: Vec<String>) {\n    for error in errors {\n        formatter::emit_stderr(&format!(\n            \"Warning: Session ingest failed for {provider_name}: {error}\"\n        ));\n    }\n}\n\nenum ResumeTerminalDispositionOutcome {\n    Continue(i32),\n    Return(i32),\n    CompletedAttempt,\n}\n\nfn terminal_disposition_outcome(\n    control: ResumeLoopControl,\n    result: &executor::ExecutionResult,\n) -> ResumeTerminalDispositionOutcome {\n    match control {\n        ResumeLoopControl::Continue => ResumeTerminalDispositionOutcome::Continue(result.exit_code),\n        ResumeLoopControl::Return(exit_code) => ResumeTerminalDispositionOutcome::Return(exit_code),\n        ResumeLoopControl::CompletedAttempt => ResumeTerminalDispositionOutcome::CompletedAttempt,\n    }\n}\n\nfn apply_resume_terminal_disposition_outcome(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &ResumeInvocationAttempt<'_>,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    outcome: ResumeTerminalDispositionOutcome,\n) -> Result<Option<ResumeAttemptLoopControl>, String> {\n    match outcome {\n        ResumeTerminalDispositionOutcome::Continue(exit_code) => {\n            record_failed_mailbox_delivery_attempt(\n                input,\n                &failed_delivery_error(result, \"resume_retry\"),\n            )?;\n            mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n            Ok(Some(ResumeAttemptLoopControl::Continue(exit_code)))\n        }\n        ResumeTerminalDispositionOutcome::Return(exit_code) => {\n            record_failed_mailbox_delivery_attempt(\n                input,\n                &failed_delivery_error(result, \"resume_failed\"),\n            )?;\n            mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n            Ok(Some(ResumeAttemptLoopControl::Return(exit_code)))\n        }\n        ResumeTerminalDispositionOutcome::CompletedAttempt => Ok(None),\n    }\n}\n\nfn handle_unconfirmed_mailbox_delivery_if_needed(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) -> Result<Option<ResumeAttemptLoopControl>, String> {\n    if !mailbox_delivery_unconfirmed(input, &provider.name, result, zero_turn_action) {\n        return Ok(None);\n    }\n    record_failed_mailbox_delivery_attempt(input, \"mailbox_delivery_unconfirmed\")?;\n    finalize_unconfirmed_mailbox_delivery(input, attempt, result)?;\n    mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(1))?;\n    Ok(Some(ResumeAttemptLoopControl::Return(1)))\n}\n\nfn finalize_completed_attempt_for_resume(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n) -> Result<ResumeAttemptLoopControl, String> {\n    match finalize_completed_attempt(CompletedAttemptInput {\n        agent_runtime_services: input.agent_runtime_services,\n        env: input.env,\n        invocation: &attempt.invocation,\n        invocation_row_id: attempt.invocation_row_id,\n        guard: &mut attempt.guard,\n        provider_name: &provider.name,\n        model: input.resolved.model.as_ref(),\n        result,\n        working_dir: input.working_dir,\n        manual_migrate: input.manual_migrate,\n        session_id: input.session_id,\n        active_session_id: &input.resolved.active_session_id,\n        effective_spawn_cwd: input.effective_spawn_cwd,\n        attempts: input.attempts,\n        max_attempts: input.max_attempts,\n    })? {\n        CompletedAttemptControl::Continue => {\n            record_failed_mailbox_delivery_attempt(\n                input,\n                &failed_delivery_error(result, \"quota_exhausted\"),\n            )?;\n            mark_resume_attempt_idle(\n                provider_session_id,\n                &attempt.invocation.id,\n                Some(result.exit_code),\n            )?;\n            Ok(ResumeAttemptLoopControl::Continue(result.exit_code))\n        }\n        CompletedAttemptControl::Return(exit_code) => {\n            if exit_code == 0 {\n                crate::mailbox_delivery::mark_headless_resume_delivered(\n                    input.mailbox_session_id,\n                    input.mailbox_delivery_seqs,\n                    &attempt.invocation.id,\n                )?;\n                let _ = crate::wake_coordinator::mark_successful_turn_idle_and_recheck(\n                    provider_session_id,\n                    &attempt.invocation.id,\n                    exit_code,\n                )?;\n            } else {\n                record_failed_mailbox_delivery_attempt(\n                    input,\n                    &failed_delivery_error(result, \"resume_failed\"),\n                )?;\n                mark_resume_attempt_idle(\n                    provider_session_id,\n                    &attempt.invocation.id,\n                    Some(exit_code),\n                )?;\n            }\n            Ok(ResumeAttemptLoopControl::Return(exit_code))\n        }\n    }\n}\n\nfn mailbox_delivery_unconfirmed(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) -> bool {\n    mailbox_delivery_requires_turn_confirmation(input, provider_name, result)\n        && !mailbox_delivery_turn_confirmed(input, provider_name, result, zero_turn_action)\n}\n\nfn mailbox_delivery_requires_turn_confirmation(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n    result: &executor::ExecutionResult,\n) -> bool {\n    result.exit_code == 0\n        && !input.mailbox_delivery_seqs.is_empty()\n        && input.answer.is_some_and(|answer| !answer.trim().is_empty())\n        && input.env.sessions_cfg.get(provider_name).is_some()\n}\n\nfn mailbox_delivery_turn_confirmed(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) -> bool {\n    matches!(zero_turn_action, ZeroTurnAction::Continue)\n        || submitted_user_turn_confirms_mailbox_delivery(input, result)\n        || ingested_user_turn_confirms_mailbox_delivery(input, provider_name)\n}\n\nfn submitted_user_turn_confirms_mailbox_delivery(\n    input: &ResumeAttemptInput<'_>,\n    result: &executor::ExecutionResult,\n) -> bool {\n    let Some(submitted) = result.submitted_user_turn.as_ref() else {\n        return false;\n    };\n    let Some(answer) = input.answer else {\n        return false;\n    };\n    submitted.provider_session_id == input.resolved.active_session_id\n        && submitted_user_turn_payload_confirms_mailbox_delivery(input, submitted, answer)\n}\n\nfn submitted_user_turn_payload_confirms_mailbox_delivery(\n    input: &ResumeAttemptInput<'_>,\n    submitted: &executor::SubmittedUserTurn,\n    answer: &str,\n) -> bool {\n    if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n        return submitted.delivery_nonce.as_deref() == Some(delivery_nonce);\n    }\n    submitted.prompt_sha256 == sha256_hex(answer.as_bytes())\n}\n\nfn ingested_user_turn_confirms_mailbox_delivery(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n) -> bool {\n    if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n        return input\n            .env\n            .state\n            .has_session_user_turn_containing(\n                provider_name,\n                &input.resolved.active_session_id,\n                delivery_nonce,\n            )\n            .unwrap_or(false);\n    }\n\n    let Some(answer) = input.answer else {\n        return false;\n    };\n    input\n        .env\n        .state\n        .has_session_user_text_turn(provider_name, &input.resolved.active_session_id, answer)\n        .unwrap_or(false)\n}\n\nfn sha256_hex(bytes: &[u8]) -> String {\n    let digest = Sha256::digest(bytes);\n    digest.iter().map(|byte| format!(\"{byte:02x}\")).collect()\n}\n","lineStart":680,"lineEnd":979,"totalLines":1545,"truncated":true}},"title":"src-tauri/src/run/resume/orchestration.rs","time":{"start":1780923549333,"end":1780923549366}},"metadata":{"openai":{"itemId":"fc_0abab8e811c21e2e016a26bc9ccf4c819a9e60180e63f4ed30"}},"id":"prt_ea750c612001UuKVG9tXNbnfcm","sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","messageID":"msg_ea7509481001EUAxjzTuH5JY2B"}}
