2: +use std::process::{Command, Output};\n2293: +use std::sync::{Mutex, MutexGuard, OnceLock};\n2294: +use std::time::{Duration, Instant};\n2295: +\n2296: +const MODEL: &str = \"wake-confirm-legacy-opencode\";\n2297: +const PROVIDER: &str = \"opencode\";\n2298: +const SESSION: &str = \"ses_wakeconfirmlegacy\";\n2299: +const HANDLE: &str = \"h-wake-confirm-legacy\";\n2300: +const CHAIN_ID: &str = \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\";\n2301: +\n2302: +struct Fixture {\n2303: +    dir: tempfile::TempDir,\n2304: +    config_home: PathBuf,\n2305: +    data_home: PathBuf,\n2306: +    home_dir: PathBuf,\n2307: +    app_config_dir: PathBuf,\n2308: +    models_dir: PathBuf,\n2309: +    bin_dir: PathBuf,\n2310: +    work_dir: PathBuf,\n2311: +    export_dir: PathBuf,\n2312: +}\n2313: +\n2314: +impl Fixture {\n2315: +    fn new() -> Self {\n2316: +        let dir = tempfile::tempdir().unwrap();\n2317: +        let config_home = dir.path().join(\"xdg-config\");\n2318: +        let data_home = dir.path().join(\"xdg-data\");\n2319: +        let home_dir = dir.path().join(\"home\");\n2320: +        let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n2321: +        let models_dir = app_config_dir.join(\"models\");\n2322: +        let bin_dir = dir.path().join(\"bin\");\n2323: +        let work_dir = dir.path().join(\"work\");\n2324: +        let export_dir = dir.path().join(\"fake-opencode-export\");\n2325: +        fs::create_dir_all(&models_dir).unwrap();\n2326: +        fs::create_dir_all(&bin_dir).unwrap();\n2327: +        fs::create_dir_all(&work_dir).unwrap();\n2328: +        fs::create_dir_all(&export_dir).unwrap();\n2329: +        fs::create_dir_all(&home_dir).unwrap();\n2330: +        Self {\n2331: +            dir,\n2332: +            config_home,\n2333: +            data_home,\n2334: +            home_dir,\n2335: +            app_config_dir,\n2336: +            models_dir,\n2337: +            bin_dir,\n2338: +            work_dir,\n2339: +            e