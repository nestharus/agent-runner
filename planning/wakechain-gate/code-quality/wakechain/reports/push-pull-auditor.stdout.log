: +        converted = timestamp_string(value)\n1150:          if converted:\n1151:              return converted\n1152:      return None\n1153:  \n1154:  \n1155: +def timestamp_string(value) -> str | None:\n1156: +    if isinstance(value, str) and value:\n1157: +        return value\n1158: +    return numeric_timestamp(value)\n1159: +\n1160: +\n1161:  def session_id_from_obj(obj: dict) -> str | None:\n1162: -    for key in (\"sessionID\", \"sessionId\", \"session_id\"):\n1163: -        value = obj.get(key)\n1164: -        if isinstance(value, str) and value:\n1165: -            return value\n1166: +    for mapping in metadata_mappings_from_obj(obj):\n1167: +        for key in (\"sessionID\", \"sessionId\", \"session_id\"):\n1168: +            value = mapping.get(key)\n1169: +            if isinstance(value, str) and value:\n1170: +                return value\n1171:      return None\n1172:  \n1173:  \n1174:  def role_from_obj(obj: dict) -> str | None:\n1175: -    value = obj.get(\"role\")\n1176: -    if value in (\"user\", \"assistant\"):\n1177: -        return value\n1178: -    message = obj.get(\"message\")\n1179: -    if isinstance(message, dict) and message.get(\"role\") in (\"user\", \"assistant\"):\n1180: -        return message.get(\"role\")\n1181: +    for mapping in metadata_mappings_from_obj(obj):\n1182: +        value = mapping.get(\"role\")\n1183: +        if value in (\"user\", \"assistant\"):\n1184: +            return value\n1185:      return None\n1186:  \n1187:  \n1188: @@ -466,12 +530,10 @@ def turn_id_from_obj(obj: dict, default_session_id: str, index: int) -> str:\n1189:  \n1190:  \n1191:  def turn_id_field_from_obj(obj: dict) -> str | None:\n1192: -    value = turn_id_field_from_mapping(obj)\n1193: -    if value:\n1194: -        return value\n1195: -    message = obj.get(\"message\")\n1196: -    if isinstance(message, dict):\n1197: -        return turn_id_field_from_mapping(message)\n1198: +    for mapping in metadata_mappings_from_obj(obj):\n1