e sequencing\n40: //!       - provider retry and migration sequencing\n41: //!   - component: src-tauri/src/dispatch.rs::pre_invocation_failure_marker\n42: //!     role: intrinsic-surface\n43: //!     Domain: pre_invocation_failure_marker\n44: //!     Owns:\n45: //!       - emit_pre_invocation_failure\n46: //!       - pre_invocation_failure_payload\n47: //!       - pre_invocation_failure_message\n48: //!       - emit_pool_exhausted_pre_invocation_failure\n49: //!       - emit_provider_selection_pre_invocation_failure\n50: //!       - emit_provider_resolution_pre_invocation_failure\n51: //!       - OULIPOLY_FAILURE marker line\n52: //!       - OULIPOLY_FAILURE payload field set\n53: //!       - model_provider_names\n54: //! ```\n55: \n56: use oulipoly_runtime::session_replace;\n57: \n58: use crate::cli::inputs::{TopLevelResumePromptSource, resolve_top_level_resume_prompt_source};\n59: use crate::resume_cli::format_resume_error;\n60: use crate::usage::cli::{\n61:     Cli, MailboxSubcommands, NotifySubcommands, SessionSubcommands, Subcommands,\n62: };\n63: use crate::{commands, run, usage, wiring};\n64: \n65: mod clock;\n66: mod formatter;\n67: mod parent_invocation;\n68: mod parser;\n69: mod pre_invocation_failure;\n70: mod predicate;\n71: mod usage_context;\n72: \n73: pub(crate) use clock::utc_now;\n74: pub(crate) use formatter::format_timestamp_rfc3339;\n75: pub(crate) use parent_invocation::resolve_parent_invocation_id;\n76: pub(crate) use parser::provider_session_marker_uuid;\n77: use parser::resume_target_arg;\n78: pub(crate) use pre_invocation_failure::emit_pre_invocation_failure;\n79: pub(crate) use predicate::{\n80:     diagnostics_model_configured, execution_succeeded, should_emit_resume_short_line,\n81: };\n82: \n83: pub(crate) fn run(cli: Cli) -> Result<i32, String> {\n84:     if let Err(err) = recover_pending_session_replaces() {\n85:         return Ok(handle_pending_session_replace_error(&err));\n86:     }\n87:     if startup_wake_reclaim_sweep_enabled(&cli) {\n88:         crate::wake_coordinator::run_startup_wake_reclaim_sweep();\n89:     }\n90: \n91:     if cli.new {\n92:         return run_default_provider_repl(&cli);\n93:     }\n94: \n95:     let agent_runtime_services = wiring::AgentRuntimeServices::cli_defaults();\n96: \n97:     if cli.usage {\n98:         return run_usage_command(&cli, &agent_runtime_services);\n99:     }\n100: \n101:     if let Some(command) = cli.command.clone() {\n102:         return dispatch_subcommand(command, &agent_runtime_services);\n103:     }\n104: \n105:     if let Some(ref session_id) = cli.resume {\n106:         return dispatch_top_level_resume(&cli, session_id, &agent_runtime_services);\n107:     }\n108: \n109:     if let Some(ref model_name) = cli.model {\n110:         return crate::commands::direct_model::run_direct_model_cli(\n111:             &cli,\n112:             model_name,\n113:             &agent_runtime_services,\n114:         );\n115:     }\n116: \n117:     crate::commands::direct_model::run_agent_cli(&cli, &agent_runtime_services)\n118: }\n119: \n120: fn startup_wake_reclaim_sweep_enabled(cli: &Cli) -> bool {\n121:     if cli.resume.is_some() {\n122:         return false;\n123:     }\n124:     !matches!(\n125:         &cli.command,\n126:         Some(Subcommands::Resume { .. })\n127:             | Some(Subcommands::Repl {\n128:                 resume: Some(_),\n129:                 ..\n130:             })\n131:     )\n132: }\n133: \n134: fn recover_pending_session_replaces() -> Result<(), session_replace::ReplaceError> {\n135:     session_replace::recover_pending_replaces()\n136: }\n137: \n138: fn handle_pending_session_replace_error(err: &session_replace::ReplaceError) -> i32 {\n139:     emit_pending_session_replace_error(err);\n140:     pending_session_replace_exit_code(err)\n141: }\n142: \n143: fn emit_pending_session_replace_error(err: &session_replace::ReplaceError) {\n144:     formatter::emit_stderr_line(&err.to_json().to_string());\n145: }\n146: \n147: fn pending_session_replace_exit_code(err: &session_replace::ReplaceError) -> i32 {\n148:     err.exit_code()\n149: }\n150: \n151: fn run_default_provider_repl(cli: &Cli) -> Result<i32, String> {\n152:     let services =\n153:         oulipoly_runtime::repl_default_provider::RuntimeServices::production(cli.project.clone())?;\n154:     oulipoly_runtime::repl_default_provider::run_repl_with_default_provider(services)\n155: }\n156: \n157: fn run_usage_command(\n158:     cli: &Cli,\n159:     agent_runtime_services: &wiring::AgentRuntimeServices,\n160: ) -> Result<i32, String> {\n\n(Showing lines 1-160 of 1106. Use offset=161 to continue.)\n</content>","metadata":{"preview":"//! Top-level CLI routing and dispatch.\n//!\n//! ## Declared roles\n//!\n//! `orchestration`, `parser`, `validator`, `accessor`, `formatter`, `mapper`, `predicate`, `filter`\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_runtime_services\n//!     role: adapter\n//!     Translates:\n//!       - oulipoly_runtime::services ports and DTOs consumed by CLI dispatch\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_state\n//!     role: adapter\n//!     Translates:\n//!       - oulipoly_state DB, schema, quota, invocation row, session row, acceptance row\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_runtime_modules\n//!     role: adapter","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/dispatch.rs","text":"//! Top-level CLI routing and dispatch.\n//!\n//! ## Declared roles\n//!\n//! `orchestration`, `parser`, `validator`, `accessor`, `formatter`, `mapper`, `predicate`, `filter`\n//!\n//! ## Adapter declarations\n//!\n//! ```yaml\n//! adapter_declarations:\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_runtime_services\n//!     role: adapter\n//!     Translates:\n//!       - oulipoly_runtime::services ports and DTOs consumed by CLI dispatch\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_state\n//!     role: adapter\n//!     Translates:\n//!       - oulipoly_state DB, schema, quota, invocation row, session row, acceptance row\n//!   - component: src-tauri/src/dispatch.rs::dispatch_to_runtime_modules\n//!     role: adapter\n//!     Translates:\n//!       - oulipoly_runtime modules outside services consumed by CLI dispatch\n//! ```\n//!\n//! ## Intrinsic-surface declarations\n//!\n//! ```yaml\n//! intrinsic_surface_declarations:\n//!   - component: src-tauri/src/dispatch.rs\n//!     role: intrinsic-surface\n//!     Domain: cli_lifecycle_orchestration\n//!     Owns:\n//!       - lifecycle loops\n//!       - run_with_balancing lifecycle loop\n//!       - run_resume lifecycle loop\n//!       - run_repl lifecycle loop\n//!       - top-level --resume dispatch\n//!       - invocation finalization sequencing\n//!       - terminal signal outcome sequencing\n//!       - provider retry and migration sequencing\n//!   - component: src-tauri/src/dispatch.rs::pre_invocation_failure_marker\n//!     role: intrinsic-surface\n//!     Domain: pre_invocation_failure_marker\n//!     Owns:\n//!       - emit_pre_invocation_failure\n//!       - pre_invocation_failure_payload\n//!       - pre_invocation_failure_message\n//!       - emit_pool_exhausted_pre_invocation_failure\n//!       - emit_provider_selection_pre_invocation_failure\n//!       - emit_provider_resolution_pre_invocation_failure\n//!       - OULIPOLY_FAILURE marker line\n//!       - OULIPOLY_FAILURE payload field set\n//!       - model_provider_names\n//! ```\n\nuse oulipoly_runtime::session_replace;\n\nuse crate::cli::inputs::{TopLevelResumePromptSource, resolve_top_level_resume_prompt_source};\nuse crate::resume_cli::format_resume_error;\nuse crate::usage::cli::{\n    Cli, MailboxSubcommands, NotifySubcommands, SessionSubcommands, Subcommands,\n};\nuse crate::{commands, run, usage, wiring};\n\nmod clock;\nmod formatter;\nmod parent_invocation;\nmod parser;\nmod pre_invocation_failure;\nmod predicate;\nmod usage_context;\n\npub(crate) use clock::utc_now;\npub(crate) use formatter::format_timestamp_rfc3339;\npub(crate) use parent_invocation::resolve_parent_invocation_id;\npub(crate) use parser::provider_session_marker_uuid;\nuse parser::resume_target_arg;\npub(crate) use pre_invocation_failure::emit_pre_invocation_failure;\npub(crate) use predicate::{\n    diagnostics_model_configured, execution_succeeded, should_emit_resume_short_line,\n};\n\npub(crate) fn run(cli: Cli) -> Result<i32, String> {\n    if let Err(err) = recover_pending_session_replaces() {\n        return Ok(handle_pending_session_replace_error(&err));\n    }\n    if startup_wake_reclaim_sweep_enabled(&cli) {\n        crate::wake_coordinator::run_startup_wake_reclaim_sweep();\n    }\n\n    if cli.new {\n        return run_default_provider_repl(&cli);\n    }\n\n    let agent_runtime_services = wiring::AgentRuntimeServices::cli_defaults();\n\n    if cli.usage {\n        return run_usage_command(&cli, &agent_runtime_services);\n    }\n\n    if let Some(command) = cli.command.clone() {\n        return dispatch_subcommand(command, &agent_runtime_services);\n    }\n\n    if let Some(ref session_id) = cli.resume {\n        return dispatch_top_level_resume(&cli, session_id, &agent_runtime_services);\n    }\n\n    if let Some(ref model_name) = cli.model {\n        return crate::commands::direct_model::run_direct_model_cli(\n            &cli,\n            model_name,\n            &agent_runtime_services,\n        );\n    }\n\n    crate::commands::direct_model::run_agent_cli(&cli, &agent_runtime_services)\n}\n\nfn startup_wake_reclaim_sweep_enabled(cli: &Cli) -> bool {\n    if cli.resume.is_some() {\n        return false;\n    }\n    !matches!(\n        &cli.command,\n        Some(Subcommands::Resume { .. })\n            | Some(Subcommands::Repl {\n                resume: Some(_),\n                ..\n            })\n    )\n}\n\nfn recover_pending_session_replaces() -> Result<(), session_replace::ReplaceError> {\n    session_replace::recover_pending_replaces()\n}\n\nfn handle_pending_session_replace_error(err: &session_replace::ReplaceError) -> i32 {\n    emit_pending_session_replace_error(err);\n    pending_session_replace_exit_code(err)\n}\n\nfn emit_pending_session_replace_error(err: &session_replace::ReplaceError) {\n    formatter::emit_stderr_line(&err.to_json().to_string());\n}\n\nfn pending_session_replace_exit_code(err: &session_replace::ReplaceError) -> i32 {\n    err.exit_code()\n}\n\nfn run_default_provider_repl(cli: &Cli) -> Result<i32, String> {\n    let services =\n        oulipoly_runtime::repl_default_provider::RuntimeServices::production(cli.project.clone())?;\n    oulipoly_runtime::repl_default_provider::run_repl_with_default_provider(services)\n}\n\nfn run_usage_command(\n    cli: &Cli,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {","lineStart":1,"lineEnd":160,"totalLines":1106,"truncated":true}},"title":"src-tauri/src/dispatch.rs","time":{"start":1780923549474,"end":1780923549493}},"metadata":{"openai":{"itemId":"fc_0abab8e811c21e2e016a26bc9ccf54819aa0fd1ca80922b484"}},"id":"prt_ea750c6b2001t02wg0YnEKRpmF","sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","messageID":"msg_ea7509481001EUAxjzTuH5JY2B"}}
