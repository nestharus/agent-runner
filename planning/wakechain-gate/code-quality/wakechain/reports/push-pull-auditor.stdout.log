\n665: +            return Ok(Vec::new());\n666: +        }\n667: +        let mut candidates = Vec::new();\n668: +        for session_id in self.pending_wake_session_ids(limit)? {\n669: +            if candidates.len() >= limit {\n670: +                break;\n671: +            }\n672: +            if self.session_is_busy(&session_id)? {\n673: +                continue;\n674: +            }\n675: +            let Some((min_pending_seq, max_pending_seq)) = self.pending_seq_bounds(&session_id)?\n676: +            else {\n677: +                continue;\n678: +            };\n679: +            let Some(claim) = self.wake_claim(&session_id)? else {\n680: +                candidates.push(wake_sweep_candidate(\n681: +                    session_id,\n682: +                    1,\n683: +                    min_pending_seq,\n684: +                    max_pending_seq,\n685: +                ));\n686: +                continue;\n687: +            };\n688: +            if wake_claim_is_reclaimable(&self.conn, &claim, stale_after_seconds)? {\n689: +                candidates.push(wake_sweep_candidate(\n690: +                    session_id,\n691: +                    claim.auto_wake_count.saturating_add(1),\n692: +                    min_pending_seq,\n693: +                    max_pending_seq,\n694: +                ));\n695: +            }\n696: +        }\n697: +        Ok(candidates)\n698: +    }\n699: +\n700:      pub fn validate_wake_claim_for_child(\n701:          &mut self,\n702:          session_id: &str,\n703: @@ -533,6 +650,62 @@ impl MailboxDb {\n704:          collect_rows(rows)\n705:      }\n706:  \n707: +    fn pending_wake_session_ids(&self, limit: usize) -> Result<Vec<String>, String> {\n708: +        if limit == 0 {\n709: +            return Ok(Vec::new());\n710: +        }\n711: +        let oldest_limit = limit.saturating_sub(limit / 2);\n712: +        let newest_limit = limit.saturating_sub(oldest_limit);\n713: +        let mut session_ids = self.oldest_pendin