\n145:         .unwrap();\n146:         fs::write(\n147:             self.app_config_dir.join(\"providers.toml\"),\n148:             format!(\n149:                 r#\"[{PROVIDER}]\n150: command = \"fixture-opencode\"\n151: args = []\n152: prompt_mode = \"arg\"\n153: \"#\n154:             ),\n155:         )\n156:         .unwrap();\n157:         fs::write(\n158:             self.app_config_dir.join(\"sessions.toml\"),\n159:             format!(\n160:                 r#\"[{PROVIDER}]\n161: turn_script = {}\n162: \"#,\n163:                 toml_string(&path_string(&turn_script_path))\n164:             ),\n165:         )\n166:         .unwrap();\n167:     }\n168: \n169:     fn write_external_provider_script(&self) -> PathBuf {\n170:         let path = self.dir.path().join(\"external-provider.py\");\n171:         fs::write(&path, external_provider_script()).unwrap();\n172:         let mut perms = fs::metadata(&path).unwrap().permissions();\n173:         perms.set_mode(0o755);\n174:         fs::set_permissions(&path, perms).unwrap();\n175:         path\n176:     }\n177: \n178:     fn write_turn_script(&self) -> PathBuf {\n179:         let path = self.dir.path().join(\"s11-turns.py\");\n180:         fs::write(&path, turn_script()).unwrap();\n181:         let mut perms = fs::metadata(&path).unwrap().permissions();\n182:         perms.set_mode(0o755);\n183:         fs::set_permissions(&path, perms).unwrap();\n184:         path\n185:     }\n186: \n187:     fn mailbox(&self) -> MailboxDb {\n188:         MailboxDb::open(&self.sidecar_path()).unwrap()\n189:     }\n190: \n191:     fn sidecar_conn(&self) -> Connection {\n192:         Connection::open(self.sidecar_path()).unwrap()\n193:     }\n194: \n195:     fn finalized_invocation_count(&self) -> i64 {\n196:         Connection::open(self.state_path())\n197:             .unwrap()\n198:             .query_row(\n199:                 \"SELECT COUNT(*) FROM invocations WHERE finished_at IS NOT NULL\",\n200:                 [],\n201: 