oken-a\",\n914: +                reason: \"notify_idle\",\n915: +                auto_wake_count: 1,\n916: +                wake_invocation_uuid: None,\n917: +                stale_after_seconds: 600,\n918: +            })\n919: +            .unwrap(),\n920: +            WakeClaimAcquireResult::Acquired(_)\n921: +        ));\n922: +        db.record_wake_claim_pid(\"session-a\", \"token-a\", 999_999_999)\n923: +            .unwrap();\n924: +\n925: +        let stolen = db\n926: +            .try_acquire_wake_claim(WakeClaimRequest {\n927: +                session_id: \"session-a\",\n928: +                claim_token: \"token-b\",\n929: +                reason: \"wake_reclaim_sweep\",\n930: +                auto_wake_count: 2,\n931: +                wake_invocation_uuid: None,\n932: +                stale_after_seconds: 600,\n933: +            })\n934: +            .unwrap();\n935: +\n936: +        let WakeClaimAcquireResult::Acquired(claim) = stolen else {\n937: +            panic!(\"expected dead PID claim to be stolen, got {stolen:?}\");\n938: +        };\n939: +        assert_eq!(claim.claim_token, \"token-b\");\n940: +    }\n941: +\n942: +    #[test]\n943: +    fn wake_live_identity_matched_claim_is_not_stolen_after_ttl() {\n944: +        let dir = tempfile::tempdir().unwrap();\n945: +        let mut db = MailboxDb::open(&dir.path().join(\"pid-identity.db\")).unwrap();\n946: +        db.enqueue_agent_bash_complete(&input(\"handle-a\", \"session-a\"))\n947: +            .unwrap();\n948: +        assert!(matches!(\n949: +            db.try_acquire_wake_claim(WakeClaimRequest {\n950: +                session_id: \"session-a\",\n951: +                claim_token: \"token-a\",\n952: +                reason: \"notify_idle\",\n953: +                auto_wake_count: 1,\n954: +                wake_invocation_uuid: None,\n955: +                stale_after_seconds: 600,\n956: +            })\n957: +            .unwrap(),\n958: +            WakeClaimAcquireResult::Acquired(