ession-123\");\n387:      }\n388:  \n389:      #[test]\n390: @@ -1040,13 +1246,9 @@ echo \"STATE_DIR=$STATE_DIR\" > \"$STATE_DIR/marker.txt\"\"#,\n391:      #[test]\n392:      fn locate_transcript_returns_script_stdout_path() {\n393:          let dir = tempfile::tempdir().unwrap();\n394: -        let transcript = dir.path().join(\"session.jsonl\");\n395: -        std::fs::write(&transcript, \"{\\\"type\\\":\\\"system\\\"}\\n\").unwrap();\n396: -        let script = fixture_script(&format!(\n397: -            r#\"printf '%s\\n' \"$SESSION_ID\" > \"$STATE_DIR/seen-session.txt\"\n398: -printf '%s\\n' \"{}\"\"#,\n399: -            transcript.display()\n400: -        ));\n401: +        let transcript = transcript_fixture_path(dir.path());\n402: +        write_transcript_fixture(&transcript);\n403: +        let script = fixture_script(&locator_script_for_transcript(&transcript));\n404:          let cfg = cfg_with_locator(\"p\", &script.path, Some(dir.path().join(\"state\")));\n405:  \n406:          let path = locate_transcript(&cfg, \"p\", \"session-123\")\n407: @@ -1054,9 +1256,8 @@ printf '%s\\n' \"{}\"\"#,\n408:              .expect(\"locator should return a path\");\n409:  \n410:          assert_eq!(path, transcript);\n411: -        let seen =\n412: -            std::fs::read_to_string(dir.path().join(\"state\").join(\"seen-session.txt\")).unwrap();\n413: -        assert_eq!(seen.trim(), \"session-123\");\n414: +        let seen = marker_contents(&dir.path().join(\"state\"), \"seen-session.txt\");\n415: +        assert_trimmed_eq(&seen, \"session-123\");\n416:      }\n417:  \n418:      #[test]\n419: diff --git a/crates/oulipoly-state/src/db.rs b/crates/oulipoly-state/src/db.rs\n420: index 7ec67ca..e249275 100755\n421: --- a/crates/oulipoly-state/src/db.rs\n422: +++ b/crates/oulipoly-state/src/db.rs\n423: @@ -5879,6 +5879,34 @@ impl StateDb {\n424:          Ok(false)\n425:      }\n426:  \n427: +    pub fn has_session_user_turn_containing(\n428: +        &self,\n429: + 