{"type":"tool_use","timestamp":1780923548987,"sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","part":{"type":"tool","tool":"read","callID":"call_4yM3aQUHmYhDJOHewla2no5L","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-runtime/src/sessions/mod.rs","offset":1,"limit":520},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-runtime/src/sessions/mod.rs</path>\n<type>file</type>\n<content>\n1: //! CLI session log ingestion via user-provided adapter scripts.\n2: //!\n3: //! ## Declared roles\n4: //!\n5: //! `orchestration`, `accessor`, `filter`, `parser`, `validator`, `mapper`, `formatter`, `predicate`\n6: //!\n7: //! ## Intrinsic-surface declarations\n8: //!\n9: //! ```yaml\n10: //! intrinsic_surface_declarations:\n11: //!   - component: crates/oulipoly-runtime/src/sessions/mod.rs\n12: //!     role: intrinsic-surface\n13: //!     Domain: session_turn_ingest\n14: //!     Owns:\n15: //!       - adapter-script scan/ingest\n16: //!       - ScanReport.new_turns\n17: //! ```\n18: //!\n19: //! Mirrors the `quota_script` pattern in `providers.toml`: the application\n20: //! is ignorant of any specific CLI's storage format. Each provider declares\n21: //! a `turn_script` that knows how to enumerate session turns for that CLI\n22: //! and emits them as a normalized JSONL stream.\n23: //!\n24: //! Script contract:\n25: //!   - Run as `sh -c <turn_script>` with `STATE_DIR` env set to a writable dir\n26: //!     the script may use for incremental cursor bookkeeping.\n27: //!   - Stdout: one JSON object per line per turn (in any order):\n28: //!     `{\"session_id\":\"...\",\"turn_id\":\"...\",\"timestamp\":\"<ISO8601>\",\"role\":\"user\"|\"assistant\",\"parent_turn_id\":\"...\",\"is_sidechain\":true}`\n29: //!   - Empty stdout = no new turns. Non-zero exit = error.\n30: //!   - Idempotent: re-running with no source changes outputs nothing.\n31: //!\n32: //! The unified `session_turns` table stores everything across CLIs. The\n33: //! UNIQUE constraint on `(provider, session_id, turn_id)` makes ingestion\n34: //! safe even if a script over-emits (e.g. doesn't honor its cursor).\n35: \n36: use chrono::{DateTime, Utc};\n37: use oulipoly_config::{SessionSourceEntry, SessionsConfig};\n38: use oulipoly_state::{SessionTurnIngest, StateDb};\n39: use serde::Deserialize;\n40: use serde_json::Value;\n41: use std::io::Read;\n42: use std::path::PathBuf;\n43: use std::process::{Child, ChildStderr, ChildStdout, Command, ExitStatus, Stdio};\n44: use std::thread::JoinHandle;\n45: \n46: // Turn scripts run on the pre-dispatch metrics path. Ninety seconds is long\n47: // enough for slow CLI/API startup but prevents provider selection from being\n48: // wedged by a broken adapter or an unexpectedly large history scan.\n49: const SCRIPT_TIMEOUT_SECS: u64 = 90;\n50: \n51: /// A turn as emitted by an adapter script.\n52: #[derive(Debug, Clone, Deserialize, PartialEq, Eq)]\n53: pub struct ScriptTurn {\n54:     pub session_id: String,\n55:     pub turn_id: String,\n56:     pub timestamp: String,\n57:     pub role: String,\n58:     #[serde(default)]\n59:     pub parent_turn_id: Option<String>,\n60:     #[serde(default)]\n61:     pub is_sidechain: Option<bool>,\n62:     #[serde(default)]\n63:     pub is_compaction_boundary: Option<bool>,\n64:     #[serde(default)]\n65:     pub body: Option<Value>,\n66: }\n67: \n68: /// Outcome of scanning one provider's session source.\n69: #[derive(Debug, Clone, Default)]\n70: pub struct ScanReport {\n71:     pub new_turns: u64,\n72:     pub script_lines: u64,\n73:     pub errors: Vec<String>,\n74: }\n75: \n76: pub(crate) fn is_canonical_body_shape(body: &Value) -> bool {\n77:     let Value::Array(chunks) = body else {\n78:         return false;\n79:     };\n80:     chunks.iter().all(is_canonical_body_chunk)\n81: }\n82: \n83: fn is_canonical_body_chunk(chunk: &Value) -> bool {\n84:     let Value::Object(map) = chunk else {\n85:         return false;\n86:     };\n87:     map.get(\"type\").is_some_and(Value::is_string)\n88:         && map.get(\"text\").map(Value::is_string).unwrap_or(true)\n89: }\n90: \n91: /// Run the adapter script for `provider_name` and ingest every turn it emits.\n92: ///\n93: /// Failure modes (script timeout, non-zero exit, malformed JSON) are\n94: /// captured in `report.errors` rather than propagated — the balancer should\n95: /// degrade gracefully when a script is broken, not abort the request.\n96: pub fn scan_provider(\n97:     provider_name: &str,\n98:     sessions_cfg: &SessionsConfig,\n99:     db: &StateDb,\n100: ) -> ScanReport {\n101:     scan_provider_with_timeout(provider_name, sessions_cfg, db, SCRIPT_TIMEOUT_SECS)\n102: }\n103: \n104: /// Run one provider's adapter script for a specific session and ingest every\n105: /// turn it emits. The configured script receives `SESSION_ID` in its env.\n106: pub fn scan_provider_session(\n107:     provider_name: &str,\n108:     sessions_cfg: &SessionsConfig,\n109:     db: &StateDb,\n110:     session_id: &str,\n111: ) -> ScanReport {\n112:     scan_provider_session_with_timeout(\n113:         provider_name,\n114:         sessions_cfg,\n115:         db,\n116:         session_id,\n117:         SCRIPT_TIMEOUT_SECS,\n118:     )\n119: }\n120: \n121: fn scan_provider_with_timeout(\n122:     provider_name: &str,\n123:     sessions_cfg: &SessionsConfig,\n124:     db: &StateDb,\n125:     timeout_secs: u64,\n126: ) -> ScanReport {\n127:     let mut report = ScanReport::default();\n128:     let Some(entry) = provider_session_source(sessions_cfg, provider_name) else {\n129:         return report;\n130:     };\n131: \n132:     let state_dir = resolve_state_dir(provider_name, entry);\n133:     if let Err(error) = create_session_state_dir(&state_dir) {\n134:         return scan_report_with_error(report, error);\n135:     }\n136: \n137:     let stdout = match run_turn_script(&entry.turn_script, &state_dir, timeout_secs) {\n138:         Ok(stdout) => stdout,\n139:         Err(error) => return scan_report_with_error(report, error),\n140:     };\n141: \n142:     let batch = collect_turn_script_batch(provider_name, &stdout, &mut report);\n143:     persist_scanned_turns(provider_name, db, &batch, &mut report);\n144:     report\n145: }\n146: \n147: fn scan_provider_session_with_timeout(\n148:     provider_name: &str,\n149:     sessions_cfg: &SessionsConfig,\n150:     db: &StateDb,\n151:     session_id: &str,\n152:     timeout_secs: u64,\n153: ) -> ScanReport {\n154:     let mut report = ScanReport::default();\n155:     let Some(entry) = provider_session_source(sessions_cfg, provider_name) else {\n156:         return report;\n157:     };\n158: \n159:     let state_dir = resolve_state_dir(provider_name, entry);\n160:     if let Err(error) = create_session_state_dir(&state_dir) {\n161:         return scan_report_with_error(report, error);\n162:     }\n163: \n164:     let stdout = match run_session_script_with_timeout(\n165:         &entry.turn_script,\n166:         &state_dir,\n167:         Some(session_id),\n168:         \"turn script\",\n169:         timeout_secs,\n170:     ) {\n171:         Ok(stdout) => stdout,\n172:         Err(error) => return scan_report_with_error(report, error),\n173:     };\n174: \n175:     let batch = collect_turn_script_batch(provider_name, &stdout, &mut report);\n176:     persist_scanned_turns(provider_name, db, &batch, &mut report);\n177:     report\n178: }\n179: \n180: fn provider_session_source<'a>(\n181:     sessions_cfg: &'a SessionsConfig,\n182:     provider_name: &str,\n183: ) -> Option<&'a SessionSourceEntry> {\n184:     sessions_cfg.get(provider_name)\n185: }\n186: \n187: fn scan_report_with_error(mut report: ScanReport, error: String) -> ScanReport {\n188:     report.errors.push(error);\n189:     report\n190: }\n191: \n192: fn create_session_state_dir(state_dir: &std::path::Path) -> Result<(), String> {\n193:     std::fs::create_dir_all(state_dir)\n194:         .map_err(|error| format_state_dir_create_error(state_dir, error))\n195: }\n196: \n197: fn format_state_dir_create_error(state_dir: &std::path::Path, error: std::io::Error) -> String {\n198:     format!(\n199:         \"could not create state_dir {}: {error}\",\n200:         state_dir.display()\n201:     )\n202: }\n203: \n204: fn collect_turn_script_batch(\n205:     provider_name: &str,\n206:     stdout: &str,\n207:     report: &mut ScanReport,\n208: ) -> Vec<SessionTurnIngest> {\n209:     let mut batch = Vec::new();\n210:     for line in non_empty_script_lines(stdout) {\n211:         let line_number = record_script_line_seen(report);\n212:         if let Some(error) = degraded_marker_error(line) {\n213:             record_scan_error(report, error);\n214:             continue;\n215:         }\n216:         match script_line_to_ingest(provider_name, line, line_number) {\n217:             Ok(parsed) => {\n218:                 record_optional_scan_error(report, parsed.body_error);\n219:                 push_script_turn_ingest(&mut batch, parsed.ingest);\n220:             }\n221:             Err(error) => record_scan_error(report, error),\n222:         }\n223:     }\n224:     batch\n225: }\n226: \n227: fn degraded_marker_error(trimmed: &str) -> Option<String> {\n228:     let marker = parse_degraded_marker_jsonl(trimmed)?;\n229:     if !is_degraded_marker(&marker) {\n230:         return None;\n231:     }\n232:     Some(format_degraded_marker_error(degraded_marker_count(&marker)))\n233: }\n234: \n235: fn parse_degraded_marker_jsonl(trimmed: &str) -> Option<Value> {\n236:     serde_json::from_str(trimmed).ok()\n237: }\n238: \n239: fn is_degraded_marker(value: &Value) -> bool {\n240:     match value {\n241:         Value::Object(map) => map.get(\"degraded\").and_then(Value::as_bool) == Some(true),\n242:         _ => false,\n243:     }\n244: }\n245: \n246: fn degraded_marker_count(value: &Value) -> u64 {\n247:     match value {\n248:         Value::Object(map) => map.get(\"count\").and_then(Value::as_u64).unwrap_or(0),\n249:         _ => 0,\n250:     }\n251: }\n252: \n253: fn format_degraded_marker_error(count: u64) -> String {\n254:     format!(\"turn script degraded before completing scan; best_count={count}\")\n255: }\n256: \n257: fn non_empty_script_lines(stdout: &str) -> Vec<&str> {\n258:     non_empty_trimmed_lines(trimmed_script_lines(stdout))\n259: }\n260: \n261: fn trimmed_script_lines(stdout: &str) -> Vec<&str> {\n262:     stdout.lines().map(str::trim).collect()\n263: }\n264: \n265: fn non_empty_trimmed_lines(lines: Vec<&str>) -> Vec<&str> {\n266:     lines.into_iter().filter(|line| !line.is_empty()).collect()\n267: }\n268: \n269: fn record_script_line_seen(report: &mut ScanReport) -> u64 {\n270:     report.script_lines += 1;\n271:     report.script_lines\n272: }\n273: \n274: fn record_optional_scan_error(report: &mut ScanReport, error: Option<String>) {\n275:     if let Some(error) = error {\n276:         record_scan_error(report, error);\n277:     }\n278: }\n279: \n280: fn record_scan_error(report: &mut ScanReport, error: String) {\n281:     report.errors.push(error);\n282: }\n283: \n284: fn push_script_turn_ingest(batch: &mut Vec<SessionTurnIngest>, ingest: SessionTurnIngest) {\n285:     batch.push(ingest);\n286: }\n287: \n288: fn script_line_to_ingest(\n289:     provider_name: &str,\n290:     trimmed: &str,\n291:     line_number: u64,\n292: ) -> Result<ParsedScriptTurnIngest, String> {\n293:     let turn = parse_script_turn_line(trimmed)?;\n294:     let timestamp = parse_script_turn_timestamp(&turn.timestamp)?;\n295:     let body_validation = validate_script_turn_body(provider_name, line_number, &turn.body);\n296:     let body = serialize_selected_script_turn_body(\n297:         provider_name,\n298:         line_number,\n299:         selected_script_turn_body(&body_validation),\n300:     )?;\n301:     let body_error = script_turn_body_error(&body_validation);\n302:     Ok(script_turn_ingest_from_parts(\n303:         turn, timestamp, body, body_error,\n304:     ))\n305: }\n306: \n307: struct ParsedScriptTurnIngest {\n308:     ingest: SessionTurnIngest,\n309:     body_error: Option<String>,\n310: }\n311: \n312: enum ValidatedScriptTurnBody<'a> {\n313:     Accepted(Option<&'a Value>),\n314:     Rejected(String),\n315: }\n316: \n317: fn parsed_script_turn_ingest(\n318:     ingest: SessionTurnIngest,\n319:     body_error: Option<String>,\n320: ) -> ParsedScriptTurnIngest {\n321:     ParsedScriptTurnIngest { ingest, body_error }\n322: }\n323: \n324: fn parse_script_turn_line(trimmed: &str) -> Result<ScriptTurn, String> {\n325:     serde_json::from_str(trimmed).map_err(|error| format_malformed_turn_line(error, trimmed))\n326: }\n327: \n328: fn format_malformed_turn_line(error: serde_json::Error, trimmed: &str) -> String {\n329:     format!(\"malformed turn line ({error}): {trimmed}\")\n330: }\n331: \n332: fn parse_script_turn_timestamp(timestamp: &str) -> Result<DateTime<Utc>, String> {\n333:     DateTime::parse_from_rfc3339(timestamp)\n334:         .map(|timestamp| timestamp.with_timezone(&Utc))\n335:         .map_err(|error| format_bad_timestamp(timestamp, error))\n336: }\n337: \n338: fn format_bad_timestamp(timestamp: &str, error: chrono::ParseError) -> String {\n339:     format!(\"bad timestamp {timestamp}: {error}\")\n340: }\n341: \n342: fn validate_script_turn_body<'a>(\n343:     provider_name: &str,\n344:     line_number: u64,\n345:     body: &'a Option<Value>,\n346: ) -> ValidatedScriptTurnBody<'a> {\n347:     let Some(body) = body else {\n348:         return ValidatedScriptTurnBody::Accepted(None);\n349:     };\n350:     match validate_script_turn_body_shape(provider_name, line_number, body) {\n351:         Ok(()) => ValidatedScriptTurnBody::Accepted(Some(body)),\n352:         Err(error) => ValidatedScriptTurnBody::Rejected(error),\n353:     }\n354: }\n355: \n356: fn validate_script_turn_body_shape(\n357:     provider_name: &str,\n358:     line_number: u64,\n359:     body: &Value,\n360: ) -> Result<(), String> {\n361:     if is_canonical_body_shape(body) {\n362:         Ok(())\n363:     } else {\n364:         Err(format_invalid_body_shape(provider_name, line_number))\n365:     }\n366: }\n367: \n368: fn format_invalid_body_shape(provider_name: &str, line_number: u64) -> String {\n369:     format!(\n370:         \"invalid body shape for provider {provider_name} line {line_number}: expected canonical content chunk array\"\n371:     )\n372: }\n373: \n374: fn serialize_script_turn_body(\n375:     provider_name: &str,\n376:     line_number: u64,\n377:     body: &Value,\n378: ) -> Result<Option<String>, String> {\n379:     serde_json::to_string(body)\n380:         .map(Some)\n381:         .map_err(|error| format_body_serialize_error(provider_name, line_number, error))\n382: }\n383: \n384: fn selected_script_turn_body<'a>(body: &'a ValidatedScriptTurnBody<'a>) -> Option<&'a Value> {\n385:     match body {\n386:         ValidatedScriptTurnBody::Accepted(Some(body)) => Some(body),\n387:         ValidatedScriptTurnBody::Accepted(None) | ValidatedScriptTurnBody::Rejected(_) => None,\n388:     }\n389: }\n390: \n391: fn serialize_selected_script_turn_body(\n392:     provider_name: &str,\n393:     line_number: u64,\n394:     body: Option<&Value>,\n395: ) -> Result<Option<String>, String> {\n396:     body.map(|body| serialize_script_turn_body(provider_name, line_number, body))\n397:         .transpose()\n398:         .map(Option::flatten)\n399: }\n400: \n401: fn format_body_serialize_error(\n402:     provider_name: &str,\n403:     line_number: u64,\n404:     error: serde_json::Error,\n405: ) -> String {\n406:     format!(\"failed to serialize body for provider {provider_name} line {line_number}: {error}\")\n407: }\n408: \n409: fn script_turn_to_ingest(\n410:     turn: ScriptTurn,\n411:     timestamp: DateTime<Utc>,\n412:     body: Option<String>,\n413: ) -> SessionTurnIngest {\n414:     SessionTurnIngest {\n415:         session_id: turn.session_id,\n416:         turn_id: turn.turn_id,\n417:         timestamp,\n418:         role: turn.role,\n419:         parent_turn_id: turn.parent_turn_id,\n420:         is_sidechain: turn.is_sidechain.unwrap_or(false),\n421:         is_compaction_boundary: turn.is_compaction_boundary.unwrap_or(false),\n422:         body,\n423:     }\n424: }\n425: \n426: fn script_turn_ingest_from_parts(\n427:     turn: ScriptTurn,\n428:     timestamp: DateTime<Utc>,\n429:     body: Option<String>,\n430:     body_error: Option<String>,\n431: ) -> ParsedScriptTurnIngest {\n432:     parsed_script_turn_ingest(script_turn_to_ingest(turn, timestamp, body), body_error)\n433: }\n434: \n435: fn script_turn_body_error(body_validation: &ValidatedScriptTurnBody<'_>) -> Option<String> {\n436:     match body_validation {\n437:         ValidatedScriptTurnBody::Accepted(_) => None,\n438:         ValidatedScriptTurnBody::Rejected(error) => Some(error.clone()),\n439:     }\n440: }\n441: \n442: fn persist_scanned_turns(\n443:     provider_name: &str,\n444:     db: &StateDb,\n445:     batch: &[SessionTurnIngest],\n446:     report: &mut ScanReport,\n447: ) {\n448:     match db.ingest_session_turns_batch(provider_name, batch) {\n449:         Ok(new_turns) => persist_imported_chains(provider_name, db, batch, report, new_turns),\n450:         Err(error) => report.errors.push(error),\n451:     }\n452: }\n453: \n454: fn persist_imported_chains(\n455:     provider_name: &str,\n456:     db: &StateDb,\n457:     batch: &[SessionTurnIngest],\n458:     report: &mut ScanReport,\n459:     new_turns: u64,\n460: ) {\n461:     report.new_turns = new_turns;\n462:     for turn in batch {\n463:         if let Err(error) = db.mint_imported_chain_if_absent(\n464:             provider_name,\n465:             &turn.session_id,\n466:             &turn.timestamp,\n467:             \"<unknown>\",\n468:         ) {\n469:             report.errors.push(error);\n470:         }\n471:     }\n472: }\n473: \n474: /// Scan every provider listed in `sessions_cfg`. Failures in one provider\n475: /// don't abort the others.\n476: pub fn scan_all(sessions_cfg: &SessionsConfig, db: &StateDb) -> Vec<(String, ScanReport)> {\n477:     let mut out = Vec::new();\n478:     for name in sessions_cfg.entries.keys() {\n479:         let report = scan_provider(name, sessions_cfg, db);\n480:         out.push((name.clone(), report));\n481:     }\n482:     out.sort_by(|a, b| a.0.cmp(&b.0));\n483:     out\n484: }\n485: \n486: fn resolve_state_dir(provider_name: &str, entry: &SessionSourceEntry) -> PathBuf {\n487:     if let Some(dir) = &entry.state_dir {\n488:         return dir.clone();\n489:     }\n490:     let base = default_app_data_dir().join(\"sessions\");\n491:     base.join(provider_name)\n492: }\n493: \n494: fn default_app_data_dir() -> PathBuf {\n495:     oulipoly_state::paths::data_dir()\n496:         .unwrap_or_else(|_| PathBuf::from(\".\").join(oulipoly_state::paths::APP_DATA_DIR_NAME))\n497: }\n498: \n499: fn run_turn_script(\n500:     script: &str,\n501:     state_dir: &std::path::Path,\n502:     timeout_secs: u64,\n503: ) -> Result<String, String> {\n504:     run_session_script_with_timeout(script, state_dir, None, \"turn script\", timeout_secs)\n505: }\n506: \n507: pub fn locate_transcript(\n508:     sessions_cfg: &SessionsConfig,\n509:     provider_name: &str,\n510:     session_id: &str,\n511: ) -> Result<Option<PathBuf>, String> {\n512:     let Some(entry) = session_source_entry(sessions_cfg, provider_name) else {\n513:         return Ok(None);\n514:     };\n515:     let Some(locator) = transcript_locator_script(entry) else {\n516:         return Ok(None);\n517:     };\n518: \n519:     let state_dir = resolve_state_dir(provider_name, entry);\n520:     create_session_state_dir(&state_dir)?;\n\n(Showing lines 1-520 of 1339. Use offset=521 to continue.)\n</content>","metadata":{"preview":"//! CLI session log ingestion via user-provided adapter scripts.\n//!\n//! ## Declared roles\n//!\n//! `orchestration`, `accessor`, `filter`, `parser`, `validator`, `mapper`, `formatter`, `predicate`\n//!\n//! ## Intrinsic-surface declarations\n//!\n//! ```yaml\n//! intrinsic_surface_declarations:\n//!   - component: crates/oulipoly-runtime/src/sessions/mod.rs\n//!     role: intrinsic-surface\n//!     Domain: session_turn_ingest\n//!     Owns:\n//!       - adapter-script scan/ingest\n//!       - ScanReport.new_turns\n//! ```\n//!\n//! Mirrors the `quota_script` pattern in `providers.toml`: the application\n//! is ignorant of any specific CLI's storage format. Each provider declares","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-runtime/src/sessions/mod.rs","text":"//! CLI session log ingestion via user-provided adapter scripts.\n//!\n//! ## Declared roles\n//!\n//! `orchestration`, `accessor`, `filter`, `parser`, `validator`, `mapper`, `formatter`, `predicate`\n//!\n//! ## Intrinsic-surface declarations\n//!\n//! ```yaml\n//! intrinsic_surface_declarations:\n//!   - component: crates/oulipoly-runtime/src/sessions/mod.rs\n//!     role: intrinsic-surface\n//!     Domain: session_turn_ingest\n//!     Owns:\n//!       - adapter-script scan/ingest\n//!       - ScanReport.new_turns\n//! ```\n//!\n//! Mirrors the `quota_script` pattern in `providers.toml`: the application\n//! is ignorant of any specific CLI's storage format. Each provider declares\n//! a `turn_script` that knows how to enumerate session turns for that CLI\n//! and emits them as a normalized JSONL stream.\n//!\n//! Script contract:\n//!   - Run as `sh -c <turn_script>` with `STATE_DIR` env set to a writable dir\n//!     the script may use for incremental cursor bookkeeping.\n//!   - Stdout: one JSON object per line per turn (in any order):\n//!     `{\"session_id\":\"...\",\"turn_id\":\"...\",\"timestamp\":\"<ISO8601>\",\"role\":\"user\"|\"assistant\",\"parent_turn_id\":\"...\",\"is_sidechain\":true}`\n//!   - Empty stdout = no new turns. Non-zero exit = error.\n//!   - Idempotent: re-running with no source changes outputs nothing.\n//!\n//! The unified `session_turns` table stores everything across CLIs. The\n//! UNIQUE constraint on `(provider, session_id, turn_id)` makes ingestion\n//! safe even if a script over-emits (e.g. doesn't honor its cursor).\n\nuse chrono::{DateTime, Utc};\nuse oulipoly_config::{SessionSourceEntry, SessionsConfig};\nuse oulipoly_state::{SessionTurnIngest, StateDb};\nuse serde::Deserialize;\nuse serde_json::Value;\nuse std::io::Read;\nuse std::path::PathBuf;\nuse std::process::{Child, ChildStderr, ChildStdout, Command, ExitStatus, Stdio};\nuse std::thread::JoinHandle;\n\n// Turn scripts run on the pre-dispatch metrics path. Ninety seconds is long\n// enough for slow CLI/API startup but prevents provider selection from being\n// wedged by a broken adapter or an unexpectedly large history scan.\nconst SCRIPT_TIMEOUT_SECS: u64 = 90;\n\n/// A turn as emitted by an adapter script.\n#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]\npub struct ScriptTurn {\n    pub session_id: String,\n    pub turn_id: String,\n    pub timestamp: String,\n    pub role: String,\n    #[serde(default)]\n    pub parent_turn_id: Option<String>,\n    #[serde(default)]\n    pub is_sidechain: Option<bool>,\n    #[serde(default)]\n    pub is_compaction_boundary: Option<bool>,\n    #[serde(default)]\n    pub body: Option<Value>,\n}\n\n/// Outcome of scanning one provider's session source.\n#[derive(Debug, Clone, Default)]\npub struct ScanReport {\n    pub new_turns: u64,\n    pub script_lines: u64,\n    pub errors: Vec<String>,\n}\n\npub(crate) fn is_canonical_body_shape(body: &Value) -> bool {\n    let Value::Array(chunks) = body else {\n        return false;\n    };\n    chunks.iter().all(is_canonical_body_chunk)\n}\n\nfn is_canonical_body_chunk(chunk: &Value) -> bool {\n    let Value::Object(map) = chunk else {\n        return false;\n    };\n    map.get(\"type\").is_some_and(Value::is_string)\n        && map.get(\"text\").map(Value::is_string).unwrap_or(true)\n}\n\n/// Run the adapter script for `provider_name` and ingest every turn it emits.\n///\n/// Failure modes (script timeout, non-zero exit, malformed JSON) are\n/// captured in `report.errors` rather than propagated — the balancer should\n/// degrade gracefully when a script is broken, not abort the request.\npub fn scan_provider(\n    provider_name: &str,\n    sessions_cfg: &SessionsConfig,\n    db: &StateDb,\n) -> ScanReport {\n    scan_provider_with_timeout(provider_name, sessions_cfg, db, SCRIPT_TIMEOUT_SECS)\n}\n\n/// Run one provider's adapter script for a specific session and ingest every\n/// turn it emits. The configured script receives `SESSION_ID` in its env.\npub fn scan_provider_session(\n    provider_name: &str,\n    sessions_cfg: &SessionsConfig,\n    db: &StateDb,\n    session_id: &str,\n) -> ScanReport {\n    scan_provider_session_with_timeout(\n        provider_name,\n        sessions_cfg,\n        db,\n        session_id,\n        SCRIPT_TIMEOUT_SECS,\n    )\n}\n\nfn scan_provider_with_timeout(\n    provider_name: &str,\n    sessions_cfg: &SessionsConfig,\n    db: &StateDb,\n    timeout_secs: u64,\n) -> ScanReport {\n    let mut report = ScanReport::default();\n    let Some(entry) = provider_session_source(sessions_cfg, provider_name) else {\n        return report;\n    };\n\n    let state_dir = resolve_state_dir(provider_name, entry);\n    if let Err(error) = create_session_state_dir(&state_dir) {\n        return scan_report_with_error(report, error);\n    }\n\n    let stdout = match run_turn_script(&entry.turn_script, &state_dir, timeout_secs) {\n        Ok(stdout) => stdout,\n        Err(error) => return scan_report_with_error(report, error),\n    };\n\n    let batch = collect_turn_script_batch(provider_name, &stdout, &mut report);\n    persist_scanned_turns(provider_name, db, &batch, &mut report);\n    report\n}\n\nfn scan_provider_session_with_timeout(\n    provider_name: &str,\n    sessions_cfg: &SessionsConfig,\n    db: &StateDb,\n    session_id: &str,\n    timeout_secs: u64,\n) -> ScanReport {\n    let mut report = ScanReport::default();\n    let Some(entry) = provider_session_source(sessions_cfg, provider_name) else {\n        return report;\n    };\n\n    let state_dir = resolve_state_dir(provider_name, entry);\n    if let Err(error) = create_session_state_dir(&state_dir) {\n        return scan_report_with_error(report, error);\n    }\n\n    let stdout = match run_session_script_with_timeout(\n        &entry.turn_script,\n        &state_dir,\n        Some(session_id),\n        \"turn script\",\n        timeout_secs,\n    ) {\n        Ok(stdout) => stdout,\n        Err(error) => return scan_report_with_error(report, error),\n    };\n\n    let batch = collect_turn_script_batch(provider_name, &stdout, &mut report);\n    persist_scanned_turns(provider_name, db, &batch, &mut report);\n    report\n}\n\nfn provider_session_source<'a>(\n    sessions_cfg: &'a SessionsConfig,\n    provider_name: &str,\n) -> Option<&'a SessionSourceEntry> {\n    sessions_cfg.get(provider_name)\n}\n\nfn scan_report_with_error(mut report: ScanReport, error: String) -> ScanReport {\n    report.errors.push(error);\n    report\n}\n\nfn create_session_state_dir(state_dir: &std::path::Path) -> Result<(), String> {\n    std::fs::create_dir_all(state_dir)\n        .map_err(|error| format_state_dir_create_error(state_dir, error))\n}\n\nfn format_state_dir_create_error(state_dir: &std::path::Path, error: std::io::Error) -> String {\n    format!(\n        \"could not create state_dir {}: {error}\",\n        state_dir.display()\n    )\n}\n\nfn collect_turn_script_batch(\n    provider_name: &str,\n    stdout: &str,\n    report: &mut ScanReport,\n) -> Vec<SessionTurnIngest> {\n    let mut batch = Vec::new();\n    for line in non_empty_script_lines(stdout) {\n        let line_number = record_script_line_seen(report);\n        if let Some(error) = degraded_marker_error(line) {\n            record_scan_error(report, error);\n            continue;\n        }\n        match script_line_to_ingest(provider_name, line, line_number) {\n            Ok(parsed) => {\n                record_optional_scan_error(report, parsed.body_error);\n                push_script_turn_ingest(&mut batch, parsed.ingest);\n            }\n            Err(error) => record_scan_error(report, error),\n        }\n    }\n    batch\n}\n\nfn degraded_marker_error(trimmed: &str) -> Option<String> {\n    let marker = parse_degraded_marker_jsonl(trimmed)?;\n    if !is_degraded_marker(&marker) {\n        return None;\n    }\n    Some(format_degraded_marker_error(degraded_marker_count(&marker)))\n}\n\nfn parse_degraded_marker_jsonl(trimmed: &str) -> Option<Value> {\n    serde_json::from_str(trimmed).ok()\n}\n\nfn is_degraded_marker(value: &Value) -> bool {\n    match value {\n        Value::Object(map) => map.get(\"degraded\").and_then(Value::as_bool) == Some(true),\n        _ => false,\n    }\n}\n\nfn degraded_marker_count(value: &Value) -> u64 {\n    match value {\n        Value::Object(map) => map.get(\"count\").and_then(Value::as_u64).unwrap_or(0),\n        _ => 0,\n    }\n}\n\nfn format_degraded_marker_error(count: u64) -> String {\n    format!(\"turn script degraded before completing scan; best_count={count}\")\n}\n\nfn non_empty_script_lines(stdout: &str) -> Vec<&str> {\n    non_empty_trimmed_lines(trimmed_script_lines(stdout))\n}\n\nfn trimmed_script_lines(stdout: &str) -> Vec<&str> {\n    stdout.lines().map(str::trim).collect()\n}\n\nfn non_empty_trimmed_lines(lines: Vec<&str>) -> Vec<&str> {\n    lines.into_iter().filter(|line| !line.is_empty()).collect()\n}\n\nfn record_script_line_seen(report: &mut ScanReport) -> u64 {\n    report.script_lines += 1;\n    report.script_lines\n}\n\nfn record_optional_scan_error(report: &mut ScanReport, error: Option<String>) {\n    if let Some(error) = error {\n        record_scan_error(report, error);\n    }\n}\n\nfn record_scan_error(report: &mut ScanReport, error: String) {\n    report.errors.push(error);\n}\n\nfn push_script_turn_ingest(batch: &mut Vec<SessionTurnIngest>, ingest: SessionTurnIngest) {\n    batch.push(ingest);\n}\n\nfn script_line_to_ingest(\n    provider_name: &str,\n    trimmed: &str,\n    line_number: u64,\n) -> Result<ParsedScriptTurnIngest, String> {\n    let turn = parse_script_turn_line(trimmed)?;\n    let timestamp = parse_script_turn_timestamp(&turn.timestamp)?;\n    let body_validation = validate_script_turn_body(provider_name, line_number, &turn.body);\n    let body = serialize_selected_script_turn_body(\n        provider_name,\n        line_number,\n        selected_script_turn_body(&body_validation),\n    )?;\n    let body_error = script_turn_body_error(&body_validation);\n    Ok(script_turn_ingest_from_parts(\n        turn, timestamp, body, body_error,\n    ))\n}\n\nstruct ParsedScriptTurnIngest {\n    ingest: SessionTurnIngest,\n    body_error: Option<String>,\n}\n\nenum ValidatedScriptTurnBody<'a> {\n    Accepted(Option<&'a Value>),\n    Rejected(String),\n}\n\nfn parsed_script_turn_ingest(\n    ingest: SessionTurnIngest,\n    body_error: Option<String>,\n) -> ParsedScriptTurnIngest {\n    ParsedScriptTurnIngest { ingest, body_error }\n}\n\nfn parse_script_turn_line(trimmed: &str) -> Result<ScriptTurn, String> {\n    serde_json::from_str(trimmed).map_err(|error| format_malformed_turn_line(error, trimmed))\n}\n\nfn format_malformed_turn_line(error: serde_json::Error, trimmed: &str) -> String {\n    format!(\"malformed turn line ({error}): {trimmed}\")\n}\n\nfn parse_script_turn_timestamp(timestamp: &str) -> Result<DateTime<Utc>, String> {\n    DateTime::parse_from_rfc3339(timestamp)\n        .map(|timestamp| timestamp.with_timezone(&Utc))\n        .map_err(|error| format_bad_timestamp(timestamp, error))\n}\n\nfn format_bad_timestamp(timestamp: &str, error: chrono::ParseError) -> String {\n    format!(\"bad timestamp {timestamp}: {error}\")\n}\n\nfn validate_script_turn_body<'a>(\n    provider_name: &str,\n    line_number: u64,\n    body: &'a Option<Value>,\n) -> ValidatedScriptTurnBody<'a> {\n    let Some(body) = body else {\n        return ValidatedScriptTurnBody::Accepted(None);\n    };\n    match validate_script_turn_body_shape(provider_name, line_number, body) {\n        Ok(()) => ValidatedScriptTurnBody::Accepted(Some(body)),\n        Err(error) => ValidatedScriptTurnBody::Rejected(error),\n    }\n}\n\nfn validate_script_turn_body_shape(\n    provider_name: &str,\n    line_number: u64,\n    body: &Value,\n) -> Result<(), String> {\n    if is_canonical_body_shape(body) {\n        Ok(())\n    } else {\n        Err(format_invalid_body_shape(provider_name, line_number))\n    }\n}\n\nfn format_invalid_body_shape(provider_name: &str, line_number: u64) -> String {\n    format!(\n        \"invalid body shape for provider {provider_name} line {line_number}: expected canonical content chunk array\"\n    )\n}\n\nfn serialize_script_turn_body(\n    provider_name: &str,\n    line_number: u64,\n    body: &Value,\n) -> Result<Option<String>, String> {\n    serde_json::to_string(body)\n        .map(Some)\n        .map_err(|error| format_body_serialize_error(provider_name, line_number, error))\n}\n\nfn selected_script_turn_body<'a>(body: &'a ValidatedScriptTurnBody<'a>) -> Option<&'a Value> {\n    match body {\n        ValidatedScriptTurnBody::Accepted(Some(body)) => Some(body),\n        ValidatedScriptTurnBody::Accepted(None) | ValidatedScriptTurnBody::Rejected(_) => None,\n    }\n}\n\nfn serialize_selected_script_turn_body(\n    provider_name: &str,\n    line_number: u64,\n    body: Option<&Value>,\n) -> Result<Option<String>, String> {\n    body.map(|body| serialize_script_turn_body(provider_name, line_number, body))\n        .transpose()\n        .map(Option::flatten)\n}\n\nfn format_body_serialize_error(\n    provider_name: &str,\n    line_number: u64,\n    error: serde_json::Error,\n) -> String {\n    format!(\"failed to serialize body for provider {provider_name} line {line_number}: {error}\")\n}\n\nfn script_turn_to_ingest(\n    turn: ScriptTurn,\n    timestamp: DateTime<Utc>,\n    body: Option<String>,\n) -> SessionTurnIngest {\n    SessionTurnIngest {\n        session_id: turn.session_id,\n        turn_id: turn.turn_id,\n        timestamp,\n        role: turn.role,\n        parent_turn_id: turn.parent_turn_id,\n        is_sidechain: turn.is_sidechain.unwrap_or(false),\n        is_compaction_boundary: turn.is_compaction_boundary.unwrap_or(false),\n        body,\n    }\n}\n\nfn script_turn_ingest_from_parts(\n    turn: ScriptTurn,\n    timestamp: DateTime<Utc>,\n    body: Option<String>,\n    body_error: Option<String>,\n) -> ParsedScriptTurnIngest {\n    parsed_script_turn_ingest(script_turn_to_ingest(turn, timestamp, body), body_error)\n}\n\nfn script_turn_body_error(body_validation: &ValidatedScriptTurnBody<'_>) -> Option<String> {\n    match body_validation {\n        ValidatedScriptTurnBody::Accepted(_) => None,\n        ValidatedScriptTurnBody::Rejected(error) => Some(error.clone()),\n    }\n}\n\nfn persist_scanned_turns(\n    provider_name: &str,\n    db: &StateDb,\n    batch: &[SessionTurnIngest],\n    report: &mut ScanReport,\n) {\n    match db.ingest_session_turns_batch(provider_name, batch) {\n        Ok(new_turns) => persist_imported_chains(provider_name, db, batch, report, new_turns),\n        Err(error) => report.errors.push(error),\n    }\n}\n\nfn persist_imported_chains(\n    provider_name: &str,\n    db: &StateDb,\n    batch: &[SessionTurnIngest],\n    report: &mut ScanReport,\n    new_turns: u64,\n) {\n    report.new_turns = new_turns;\n    for turn in batch {\n        if let Err(error) = db.mint_imported_chain_if_absent(\n            provider_name,\n            &turn.session_id,\n            &turn.timestamp,\n            \"<unknown>\",\n        ) {\n            report.errors.push(error);\n        }\n    }\n}\n\n/// Scan every provider listed in `sessions_cfg`. Failures in one provider\n/// don't abort the others.\npub fn scan_all(sessions_cfg: &SessionsConfig, db: &StateDb) -> Vec<(String, ScanReport)> {\n    let mut out = Vec::new();\n    for name in sessions_cfg.entries.keys() {\n        let report = scan_provider(name, sessions_cfg, db);\n        out.push((name.clone(), report));\n    }\n    out.sort_by(|a, b| a.0.cmp(&b.0));\n    out\n}\n\nfn resolve_state_dir(provider_name: &str, entry: &SessionSourceEntry) -> PathBuf {\n    if let Some(dir) = &entry.state_dir {\n        return dir.clone();\n    }\n    let base = default_app_data_dir().join(\"sessions\");\n    base.join(provider_name)\n}\n\nfn default_app_data_dir() -> PathBuf {\n    oulipoly_state::paths::data_dir()\n        .unwrap_or_else(|_| PathBuf::from(\".\").join(oulipoly_state::paths::APP_DATA_DIR_NAME))\n}\n\nfn run_turn_script(\n    script: &str,\n    state_dir: &std::path::Path,\n    timeout_secs: u64,\n) -> Result<String, String> {\n    run_session_script_with_timeout(script, state_dir, None, \"turn script\", timeout_secs)\n}\n\npub fn locate_transcript(\n    sessions_cfg: &SessionsConfig,\n    provider_name: &str,\n    session_id: &str,\n) -> Result<Option<PathBuf>, String> {\n    let Some(entry) = session_source_entry(sessions_cfg, provider_name) else {\n        return Ok(None);\n    };\n    let Some(locator) = transcript_locator_script(entry) else {\n        return Ok(None);\n    };\n\n    let state_dir = resolve_state_dir(provider_name, entry);\n    create_session_state_dir(&state_dir)?;","lineStart":1,"lineEnd":520,"totalLines":1339,"truncated":true}},"title":"crates/oulipoly-runtime/src/sessions/mod.rs","time":{"start":1780923548966,"end":1780923548983}},"metadata":{"openai":{"itemId":"fc_0abab8e811c21e2e016a26bc9ccf30819ab87aa96df4b234b5"}},"id":"prt_ea750c4f8001RHNsOZ42uX3Xoe","sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","messageID":"msg_ea7509481001EUAxjzTuH5JY2B"}}
{"type":"tool_use","timestamp":1780923549160,"sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","part":{"type":"tool","tool":"read","callID":"call_wgQaKYcTy6321KBhaX0KlJxy","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-state/src/mailbox.rs","offset":1,"limit":760},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-state/src/mailbox.rs</path>\n<type>file</type>\n<content>\n1: //! ## Declared roles\n2: //!\n3: //! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n4: //! `predicate`, `validator`\n5: //!\n6: //! Resume-backed notification mailbox storage in the PID identity sidecar DB.\n7: //! This module deliberately owns only additive sidecar tables and never touches\n8: //! the versioned `state.db` schema.\n9: \n10: use chrono::{DateTime, Duration, SecondsFormat, Utc};\n11: use rusqlite::{Connection, OpenFlags, OptionalExtension, params};\n12: use serde::Serialize;\n13: use std::path::{Path, PathBuf};\n14: \n15: use crate::pid_identity::{self, ProcessIdentity};\n16: \n17: pub const AGENT_BASH_COMPLETE_KIND: &str = \"agent_bash_complete\";\n18: pub const WAKE_SWEEP_ABANDONED_ERROR: &str = \"wake_sweep_abandoned\";\n19: \n20: #[derive(Debug, Clone, PartialEq, Eq, Serialize)]\n21: pub struct MailboxRow {\n22:     pub seq: i64,\n23:     pub session_id: String,\n24:     pub kind: String,\n25:     pub handle: String,\n26:     pub payload_json: String,\n27:     pub enqueued_at: String,\n28:     pub delivered_at: Option<String>,\n29:     pub delivered_by_invocation_uuid: Option<String>,\n30:     pub delivery_attempts: i64,\n31:     pub delivery_error: Option<String>,\n32:     pub owner_invocation_uuid: Option<String>,\n33:     pub matched_os_pid: Option<i64>,\n34:     pub matched_os_boot_id: Option<String>,\n35:     pub matched_os_pid_starttime_ticks: Option<i64>,\n36:     pub matched_chain_index: Option<i64>,\n37:     pub state_dir: String,\n38:     pub meta_path: String,\n39:     pub log_path: String,\n40:     pub rc_path: String,\n41:     pub rc: i32,\n42: }\n43: \n44: #[derive(Debug, Clone, Copy)]\n45: pub struct AgentBashCompleteEnqueue<'a> {\n46:     pub session_id: &'a str,\n47:     pub handle: &'a str,\n48:     pub payload_json: &'a str,\n49:     pub owner_invocation_uuid: Option<&'a str>,\n50:     pub matched_os_pid: Option<i64>,\n51:     pub matched_os_boot_id: Option<&'a str>,\n52:     pub matched_os_pid_starttime_ticks: Option<i64>,\n53:     pub matched_chain_index: Option<i64>,\n54:     pub state_dir: &'a str,\n55:     pub meta_path: &'a str,\n56:     pub log_path: &'a str,\n57:     pub rc_path: &'a str,\n58:     pub rc: i32,\n59: }\n60: \n61: #[derive(Debug, Clone, PartialEq, Eq)]\n62: pub enum EnqueueResult {\n63:     Inserted(MailboxRow),\n64:     AlreadyEnqueued(MailboxRow),\n65:     Conflict { existing: MailboxRow },\n66: }\n67: \n68: #[derive(Debug, Clone, Copy)]\n69: pub struct SessionRuntimeUpsert<'a> {\n70:     pub session_id: &'a str,\n71:     pub mode: &'a str,\n72:     pub invocation_uuid: Option<&'a str>,\n73:     pub provider_name: Option<&'a str>,\n74:     pub model_name: Option<&'a str>,\n75:     pub pty_control_path: Option<&'a str>,\n76:     pub models_dir: Option<&'a str>,\n77:     pub effective_cwd: Option<&'a str>,\n78: }\n79: \n80: #[derive(Debug, Clone, Copy)]\n81: pub struct SessionRuntimeRunningUpdate<'a> {\n82:     pub session_id: &'a str,\n83:     pub mode: &'a str,\n84:     pub invocation_uuid: &'a str,\n85:     pub provider_name: Option<&'a str>,\n86:     pub model_name: Option<&'a str>,\n87:     pub identity: &'a ProcessIdentity,\n88:     pub pty_control_path: Option<&'a str>,\n89:     pub turn_start_max_mailbox_seq: Option<i64>,\n90:     pub models_dir: Option<&'a str>,\n91:     pub effective_cwd: Option<&'a str>,\n92: }\n93: \n94: #[derive(Debug, Clone, Copy)]\n95: pub struct SessionRuntimeIdleUpdate<'a> {\n96:     pub session_id: &'a str,\n97:     pub invocation_uuid: &'a str,\n98:     pub last_exit_code: Option<i32>,\n99: }\n100: \n101: #[derive(Debug, Clone, PartialEq, Eq)]\n102: pub struct SessionRuntimeRow {\n103:     pub session_id: String,\n104:     pub mode: String,\n105:     pub invocation_uuid: Option<String>,\n106:     pub provider_name: Option<String>,\n107:     pub model_name: Option<String>,\n108:     pub pty_control_path: Option<String>,\n109:     pub updated_at: String,\n110:     pub run_state: String,\n111:     pub running_invocation_uuid: Option<String>,\n112:     pub running_os_pid: Option<i64>,\n113:     pub running_os_boot_id: Option<String>,\n114:     pub running_os_pid_starttime_ticks: Option<i64>,\n115:     pub turn_started_at: Option<String>,\n116:     pub turn_ended_at: Option<String>,\n117:     pub turn_start_max_mailbox_seq: Option<i64>,\n118:     pub last_exit_code: Option<i32>,\n119:     pub models_dir: Option<String>,\n120:     pub effective_cwd: Option<String>,\n121: }\n122: \n123: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n124: pub enum SessionLiveness {\n125:     Busy,\n126:     Idle,\n127: }\n128: \n129: #[derive(Debug, Clone, PartialEq, Eq)]\n130: enum SessionRuntimeLivenessDecision {\n131:     Busy,\n132:     Idle,\n133:     Stale {\n134:         running_invocation_uuid: Option<String>,\n135:     },\n136: }\n137: \n138: #[derive(Debug, Clone, Copy)]\n139: pub struct WakeClaimRequest<'a> {\n140:     pub session_id: &'a str,\n141:     pub claim_token: &'a str,\n142:     pub reason: &'a str,\n143:     pub auto_wake_count: i64,\n144:     pub wake_invocation_uuid: Option<&'a str>,\n145:     pub stale_after_seconds: i64,\n146: }\n147: \n148: #[derive(Debug, Clone, PartialEq, Eq)]\n149: pub enum WakeClaimAcquireResult {\n150:     Acquired(WakeClaimRow),\n151:     NoPending,\n152:     Busy,\n153:     AlreadyInFlight(WakeClaimRow),\n154: }\n155: \n156: #[derive(Debug, Clone, PartialEq, Eq)]\n157: pub struct WakeClaimRow {\n158:     pub session_id: String,\n159:     pub claim_token: String,\n160:     pub claimed_at: String,\n161:     pub wake_pid: Option<i64>,\n162:     pub wake_invocation_uuid: Option<String>,\n163:     pub reason: String,\n164:     pub auto_wake_count: i64,\n165:     pub min_pending_seq_at_claim: Option<i64>,\n166:     pub max_pending_seq_at_claim: Option<i64>,\n167: }\n168: \n169: #[derive(Debug, Clone, PartialEq, Eq)]\n170: pub struct WakeSweepCandidate {\n171:     pub session_id: String,\n172:     pub auto_wake_count: i64,\n173:     pub min_pending_seq: i64,\n174:     pub max_pending_seq: i64,\n175: }\n176: \n177: pub struct MailboxDb {\n178:     conn: Connection,\n179:     path: PathBuf,\n180: }\n181: \n182: impl MailboxDb {\n183:     pub fn default_path() -> Result<PathBuf, String> {\n184:         pid_identity::default_path()\n185:     }\n186: \n187:     pub fn open_default() -> Result<Self, String> {\n188:         let path = Self::default_path()?;\n189:         Self::open(&path)\n190:     }\n191: \n192:     pub fn open_default_if_exists() -> Result<Option<Self>, String> {\n193:         let path = Self::default_path()?;\n194:         if !path.exists() {\n195:             return Ok(None);\n196:         }\n197:         Self::open(&path).map(Some)\n198:     }\n199: \n200:     pub fn open(path: &Path) -> Result<Self, String> {\n201:         ensure_parent_dir(path)?;\n202:         let conn = Connection::open(path)\n203:             .map_err(|err| format!(\"Failed to open PID mailbox sidecar: {err}\"))?;\n204:         set_wal_mode(&conn)?;\n205:         pid_identity::ensure_identity_schema(&conn)?;\n206:         ensure_mailbox_schema(&conn)?;\n207:         Ok(Self {\n208:             conn,\n209:             path: path.to_path_buf(),\n210:         })\n211:     }\n212: \n213:     pub fn open_read_only(path: &Path) -> Result<Self, String> {\n214:         let conn = Connection::open_with_flags(path, OpenFlags::SQLITE_OPEN_READ_ONLY)\n215:             .map_err(|err| format!(\"Failed to open PID mailbox sidecar read-only: {err}\"))?;\n216:         Ok(Self {\n217:             conn,\n218:             path: path.to_path_buf(),\n219:         })\n220:     }\n221: \n222:     pub fn path(&self) -> &Path {\n223:         &self.path\n224:     }\n225: \n226:     pub fn connection(&self) -> &Connection {\n227:         &self.conn\n228:     }\n229: \n230:     pub fn enqueue_agent_bash_complete(\n231:         &mut self,\n232:         input: &AgentBashCompleteEnqueue<'_>,\n233:     ) -> Result<EnqueueResult, String> {\n234:         let now = now_rfc3339();\n235:         let tx = self\n236:             .conn\n237:             .transaction()\n238:             .map_err(|err| format!(\"Failed to start mailbox enqueue transaction: {err}\"))?;\n239:         let result = enqueue_agent_bash_complete_in_tx(&tx, input, &now)?;\n240:         tx.commit()\n241:             .map_err(|err| format!(\"Failed to commit mailbox enqueue transaction: {err}\"))?;\n242:         Ok(result)\n243:     }\n244: \n245:     pub fn list_pending(&self, session_id: &str) -> Result<Vec<MailboxRow>, String> {\n246:         let mut stmt = self\n247:             .conn\n248:             .prepare(\n249:                 \"SELECT seq, session_id, kind, handle, payload_json, enqueued_at,\n250:                         delivered_at, delivered_by_invocation_uuid, delivery_attempts,\n251:                         delivery_error, owner_invocation_uuid, matched_os_pid,\n252:                         matched_os_boot_id, matched_os_pid_starttime_ticks,\n253:                         matched_chain_index, state_dir, meta_path, log_path, rc_path, rc\n254:                  FROM mailbox\n255:                  WHERE session_id = ?1 AND delivered_at IS NULL\n256:                  ORDER BY seq ASC\",\n257:             )\n258:             .map_err(|err| format!(\"Failed to prepare pending mailbox query: {err}\"))?;\n259:         let rows = stmt\n260:             .query_map(params![session_id], map_mailbox_row)\n261:             .map_err(|err| format!(\"Failed to query pending mailbox rows: {err}\"))?;\n262:         collect_rows(rows)\n263:     }\n264: \n265:     pub fn list_mailbox(&self, session_id: &str, all: bool) -> Result<Vec<MailboxRow>, String> {\n266:         if all {\n267:             self.list_mailbox_all(session_id)\n268:         } else {\n269:             self.list_pending(session_id)\n270:         }\n271:     }\n272: \n273:     pub fn mark_delivered(\n274:         &mut self,\n275:         session_id: &str,\n276:         seqs: &[i64],\n277:         delivered_by_invocation_uuid: &str,\n278:     ) -> Result<(), String> {\n279:         if seqs.is_empty() {\n280:             return Ok(());\n281:         }\n282:         let now = now_rfc3339();\n283:         let tx = self\n284:             .conn\n285:             .transaction()\n286:             .map_err(|err| format!(\"Failed to start mailbox delivery transaction: {err}\"))?;\n287:         for seq in seqs {\n288:             tx.execute(\n289:                 \"UPDATE mailbox\n290:                  SET delivered_at = ?3,\n291:                      delivered_by_invocation_uuid = ?4,\n292:                      delivery_attempts = delivery_attempts + 1,\n293:                      delivery_error = NULL\n294:                  WHERE session_id = ?1\n295:                    AND seq = ?2\n296:                    AND delivered_at IS NULL\",\n297:                 params![session_id, seq, &now, delivered_by_invocation_uuid],\n298:             )\n299:             .map_err(|err| format!(\"Failed to mark mailbox row delivered: {err}\"))?;\n300:         }\n301:         tx.commit()\n302:             .map_err(|err| format!(\"Failed to commit mailbox delivery transaction: {err}\"))\n303:     }\n304: \n305:     pub fn mark_delivery_failed(\n306:         &mut self,\n307:         session_id: &str,\n308:         seqs: &[i64],\n309:         delivery_error: &str,\n310:     ) -> Result<(), String> {\n311:         if seqs.is_empty() {\n312:             return Ok(());\n313:         }\n314:         let tx = self.conn.transaction().map_err(|err| {\n315:             format!(\"Failed to start mailbox delivery failure transaction: {err}\")\n316:         })?;\n317:         for seq in seqs {\n318:             tx.execute(\n319:                 \"UPDATE mailbox\n320:                  SET delivery_attempts = delivery_attempts + 1,\n321:                      delivery_error = ?3\n322:                  WHERE session_id = ?1\n323:                    AND seq = ?2\n324:                    AND delivered_at IS NULL\",\n325:                 params![session_id, seq, delivery_error],\n326:             )\n327:             .map_err(|err| format!(\"Failed to mark mailbox row delivery failed: {err}\"))?;\n328:         }\n329:         tx.commit()\n330:             .map_err(|err| format!(\"Failed to commit mailbox delivery failure transaction: {err}\"))\n331:     }\n332: \n333:     pub fn mark_pending_abandoned(\n334:         &mut self,\n335:         session_id: &str,\n336:         delivery_error: &str,\n337:         limit: usize,\n338:     ) -> Result<usize, String> {\n339:         if limit == 0 {\n340:             return Ok(0);\n341:         }\n342:         let tx = self\n343:             .conn\n344:             .transaction()\n345:             .map_err(|err| format!(\"Failed to start mailbox abandonment transaction: {err}\"))?;\n346:         let changed = tx\n347:             .execute(\n348:                 \"UPDATE mailbox\n349:                  SET delivery_error = ?2\n350:                  WHERE seq IN (\n351:                     SELECT seq\n352:                     FROM mailbox\n353:                     WHERE session_id = ?1\n354:                       AND delivered_at IS NULL\n355:                       AND (delivery_error IS NULL OR delivery_error != ?2)\n356:                     ORDER BY seq ASC\n357:                     LIMIT ?3\n358:                  )\",\n359:                 params![session_id, delivery_error, limit as i64],\n360:             )\n361:             .map_err(|err| format!(\"Failed to mark mailbox rows abandoned: {err}\"))?;\n362:         if changed > 0 {\n363:             tx.execute(\n364:                 \"DELETE FROM session_wake_claim WHERE session_id = ?1\",\n365:                 params![session_id],\n366:             )\n367:             .map_err(|err| format!(\"Failed to release abandoned wake claim: {err}\"))?;\n368:         }\n369:         tx.commit()\n370:             .map_err(|err| format!(\"Failed to commit mailbox abandonment transaction: {err}\"))?;\n371:         Ok(changed)\n372:     }\n373: \n374:     pub fn upsert_session_runtime(\n375:         &mut self,\n376:         input: SessionRuntimeUpsert<'_>,\n377:     ) -> Result<(), String> {\n378:         let now = now_rfc3339();\n379:         self.conn\n380:             .execute(\n381:                 \"INSERT INTO session_runtime (\n382:                     session_id,\n383:                     mode,\n384:                     invocation_uuid,\n385:                     provider_name,\n386:                     model_name,\n387:                     pty_control_path,\n388:                     updated_at,\n389:                     models_dir,\n390:                     effective_cwd\n391:                  ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)\n392:                  ON CONFLICT(session_id)\n393:                  DO UPDATE SET\n394:                     mode = excluded.mode,\n395:                     invocation_uuid = excluded.invocation_uuid,\n396:                     provider_name = excluded.provider_name,\n397:                     model_name = excluded.model_name,\n398:                     pty_control_path = excluded.pty_control_path,\n399:                     updated_at = excluded.updated_at,\n400:                     models_dir = COALESCE(excluded.models_dir, session_runtime.models_dir),\n401:                     effective_cwd = COALESCE(excluded.effective_cwd, session_runtime.effective_cwd)\",\n402:                 params![\n403:                     input.session_id,\n404:                     input.mode,\n405:                     input.invocation_uuid,\n406:                     input.provider_name,\n407:                     input.model_name,\n408:                     input.pty_control_path,\n409:                     &now,\n410:                     input.models_dir,\n411:                     input.effective_cwd,\n412:                 ],\n413:             )\n414:             .map_err(|err| format!(\"Failed to upsert session runtime row: {err}\"))?;\n415:         Ok(())\n416:     }\n417: \n418:     pub fn mark_session_running(\n419:         &mut self,\n420:         input: SessionRuntimeRunningUpdate<'_>,\n421:     ) -> Result<(), String> {\n422:         validate_running_run_state()?;\n423:         let now = now_rfc3339();\n424:         let turn_start_max_mailbox_seq = self.running_turn_start_max_mailbox_seq(&input)?;\n425:         mark_session_running_row(&self.conn, input, &now, turn_start_max_mailbox_seq)\n426:     }\n427: \n428:     pub fn mark_session_idle(\n429:         &mut self,\n430:         input: SessionRuntimeIdleUpdate<'_>,\n431:     ) -> Result<bool, String> {\n432:         validate_idle_run_state()?;\n433:         let now = now_rfc3339();\n434:         mark_session_idle_row(&self.conn, input, &now)\n435:     }\n436: \n437:     pub fn session_runtime(&self, session_id: &str) -> Result<Option<SessionRuntimeRow>, String> {\n438:         let row = session_runtime_row(&self.conn, session_id)?;\n439:         validate_session_runtime_row(row.as_ref())?;\n440:         Ok(row)\n441:     }\n442: \n443:     pub fn session_liveness(&mut self, session_id: &str) -> Result<SessionLiveness, String> {\n444:         let row = self.session_runtime(session_id)?;\n445:         let decision = session_runtime_liveness_decision(row.as_ref())?;\n446:         self.clear_stale_running_row_for_liveness(session_id, &decision)?;\n447:         Ok(session_liveness_from_decision(&decision))\n448:     }\n449: \n450:     pub fn try_acquire_wake_claim(\n451:         &mut self,\n452:         input: WakeClaimRequest<'_>,\n453:     ) -> Result<WakeClaimAcquireResult, String> {\n454:         self.try_acquire_or_renew_wake_claim(input, None)\n455:     }\n456: \n457:     pub fn try_acquire_or_renew_wake_claim(\n458:         &mut self,\n459:         input: WakeClaimRequest<'_>,\n460:         renew_token: Option<&str>,\n461:     ) -> Result<WakeClaimAcquireResult, String> {\n462:         if !self.session_has_pending_mailbox(input.session_id)? {\n463:             return Ok(WakeClaimAcquireResult::NoPending);\n464:         }\n465:         if self.session_is_busy(input.session_id)? {\n466:             return Ok(WakeClaimAcquireResult::Busy);\n467:         }\n468:         let now = now_rfc3339();\n469:         let tx = self\n470:             .conn\n471:             .transaction()\n472:             .map_err(|err| format!(\"Failed to start wake claim transaction: {err}\"))?;\n473:         let pending_bounds = pending_seq_bounds_tx(&tx, input.session_id)?;\n474:         let Some((min_seq, max_seq)) = pending_bounds else {\n475:             tx.commit()\n476:                 .map_err(|err| format!(\"Failed to commit empty wake claim transaction: {err}\"))?;\n477:             return Ok(WakeClaimAcquireResult::NoPending);\n478:         };\n479:         if let Some(existing) = fresh_in_flight_wake_claim(\n480:             &tx,\n481:             wake_claim_tx(&tx, input.session_id)?,\n482:             input.stale_after_seconds,\n483:             renew_token,\n484:         )? {\n485:             tx.commit().map_err(|err| {\n486:                 format!(\"Failed to commit existing wake claim transaction: {err}\")\n487:             })?;\n488:             return Ok(WakeClaimAcquireResult::AlreadyInFlight(existing));\n489:         }\n490:         let claim = acquire_wake_claim_tx(&tx, input, &now, min_seq, max_seq)?;\n491:         tx.commit()\n492:             .map_err(|err| format!(\"Failed to commit wake claim transaction: {err}\"))?;\n493:         Ok(WakeClaimAcquireResult::Acquired(claim))\n494:     }\n495: \n496:     pub fn wake_claim(&self, session_id: &str) -> Result<Option<WakeClaimRow>, String> {\n497:         wake_claim(&self.conn, session_id)\n498:     }\n499: \n500:     pub fn release_wake_claim(\n501:         &mut self,\n502:         session_id: &str,\n503:         claim_token: Option<&str>,\n504:     ) -> Result<bool, String> {\n505:         let changed = match claim_token {\n506:             Some(token) => self.conn.execute(\n507:                 \"DELETE FROM session_wake_claim WHERE session_id = ?1 AND claim_token = ?2\",\n508:                 params![session_id, token],\n509:             ),\n510:             None => self.conn.execute(\n511:                 \"DELETE FROM session_wake_claim WHERE session_id = ?1\",\n512:                 params![session_id],\n513:             ),\n514:         }\n515:         .map_err(|err| format!(\"Failed to release wake claim: {err}\"))?;\n516:         Ok(changed > 0)\n517:     }\n518: \n519:     pub fn record_wake_claim_pid(\n520:         &mut self,\n521:         session_id: &str,\n522:         claim_token: &str,\n523:         wake_pid: i64,\n524:     ) -> Result<bool, String> {\n525:         let changed = self\n526:             .conn\n527:             .execute(\n528:                 \"UPDATE session_wake_claim\n529:                  SET wake_pid = ?3\n530:                  WHERE session_id = ?1\n531:                    AND claim_token = ?2\",\n532:                 params![session_id, claim_token, wake_pid],\n533:             )\n534:             .map_err(|err| format!(\"Failed to record wake claim PID: {err}\"))?;\n535:         Ok(changed > 0)\n536:     }\n537: \n538:     pub fn record_wake_claim_pid_identity(\n539:         &mut self,\n540:         session_id: &str,\n541:         claim_token: &str,\n542:         wake_pid: i64,\n543:         provider_name: Option<&str>,\n544:         model_name: Option<&str>,\n545:     ) -> Result<bool, String> {\n546:         if let Some(identity) = pid_identity::read_live_process_identity(wake_pid)? {\n547:             let recorded_at = now_rfc3339();\n548:             pid_identity::PidIdentityDb::open(self.path())?.record_identity(\n549:                 pid_identity::PidIdentityRecord {\n550:                     identity: &identity,\n551:                     os_pgid: None,\n552:                     invocation_uuid: claim_token,\n553:                     session_id: Some(session_id),\n554:                     provider_name,\n555:                     model_name,\n556:                     recorded_at: &recorded_at,\n557:                 },\n558:             )?;\n559:         }\n560:         self.record_wake_claim_pid(session_id, claim_token, wake_pid)\n561:     }\n562: \n563:     pub fn wake_sweep_candidates(\n564:         &mut self,\n565:         stale_after_seconds: i64,\n566:         limit: usize,\n567:     ) -> Result<Vec<WakeSweepCandidate>, String> {\n568:         if limit == 0 {\n569:             return Ok(Vec::new());\n570:         }\n571:         let mut candidates = Vec::new();\n572:         for session_id in self.pending_wake_session_ids(limit)? {\n573:             if candidates.len() >= limit {\n574:                 break;\n575:             }\n576:             if self.session_is_busy(&session_id)? {\n577:                 continue;\n578:             }\n579:             let Some((min_pending_seq, max_pending_seq)) = self.pending_seq_bounds(&session_id)?\n580:             else {\n581:                 continue;\n582:             };\n583:             let Some(claim) = self.wake_claim(&session_id)? else {\n584:                 candidates.push(wake_sweep_candidate(\n585:                     session_id,\n586:                     1,\n587:                     min_pending_seq,\n588:                     max_pending_seq,\n589:                 ));\n590:                 continue;\n591:             };\n592:             if wake_claim_is_reclaimable(&self.conn, &claim, stale_after_seconds)? {\n593:                 candidates.push(wake_sweep_candidate(\n594:                     session_id,\n595:                     claim.auto_wake_count.saturating_add(1),\n596:                     min_pending_seq,\n597:                     max_pending_seq,\n598:                 ));\n599:             }\n600:         }\n601:         Ok(candidates)\n602:     }\n603: \n604:     pub fn validate_wake_claim_for_child(\n605:         &mut self,\n606:         session_id: &str,\n607:         claim_token: &str,\n608:     ) -> Result<bool, String> {\n609:         let claim = self.wake_claim(session_id)?;\n610:         if !wake_claim_is_valid_for_child(claim.as_ref(), claim_token) {\n611:             return Ok(false);\n612:         }\n613:         self.release_busy_child_wake_claim(session_id, claim_token)\n614:     }\n615: \n616:     #[cfg(test)]\n617:     fn force_wake_claim_age_for_test(\n618:         &mut self,\n619:         session_id: &str,\n620:         seconds_old: i64,\n621:     ) -> Result<(), String> {\n622:         let claimed_at = (Utc::now() - Duration::seconds(seconds_old))\n623:             .to_rfc3339_opts(SecondsFormat::Secs, true);\n624:         self.conn\n625:             .execute(\n626:                 \"UPDATE session_wake_claim SET claimed_at = ?2 WHERE session_id = ?1\",\n627:                 params![session_id, &claimed_at],\n628:             )\n629:             .map_err(|err| format!(\"Failed to age wake claim for test: {err}\"))?;\n630:         Ok(())\n631:     }\n632: \n633:     fn list_mailbox_all(&self, session_id: &str) -> Result<Vec<MailboxRow>, String> {\n634:         let mut stmt = self\n635:             .conn\n636:             .prepare(\n637:                 \"SELECT seq, session_id, kind, handle, payload_json, enqueued_at,\n638:                         delivered_at, delivered_by_invocation_uuid, delivery_attempts,\n639:                         delivery_error, owner_invocation_uuid, matched_os_pid,\n640:                         matched_os_boot_id, matched_os_pid_starttime_ticks,\n641:                         matched_chain_index, state_dir, meta_path, log_path, rc_path, rc\n642:                  FROM mailbox\n643:                  WHERE session_id = ?1\n644:                  ORDER BY seq ASC\",\n645:             )\n646:             .map_err(|err| format!(\"Failed to prepare mailbox query: {err}\"))?;\n647:         let rows = stmt\n648:             .query_map(params![session_id], map_mailbox_row)\n649:             .map_err(|err| format!(\"Failed to query mailbox rows: {err}\"))?;\n650:         collect_rows(rows)\n651:     }\n652: \n653:     fn pending_wake_session_ids(&self, limit: usize) -> Result<Vec<String>, String> {\n654:         if limit == 0 {\n655:             return Ok(Vec::new());\n656:         }\n657:         let oldest_limit = limit.saturating_sub(limit / 2);\n658:         let newest_limit = limit.saturating_sub(oldest_limit);\n659:         let mut session_ids = self.oldest_pending_wake_session_ids(oldest_limit)?;\n660:         for session_id in self.newest_pending_wake_session_ids(newest_limit)? {\n661:             if session_ids.len() >= limit {\n662:                 break;\n663:             }\n664:             if !session_ids.iter().any(|existing| existing == &session_id) {\n665:                 session_ids.push(session_id);\n666:             }\n667:         }\n668:         Ok(session_ids)\n669:     }\n670: \n671:     fn oldest_pending_wake_session_ids(&self, limit: usize) -> Result<Vec<String>, String> {\n672:         self.pending_wake_session_ids_by_oldest_seq(limit, \"ASC\")\n673:     }\n674: \n675:     fn newest_pending_wake_session_ids(&self, limit: usize) -> Result<Vec<String>, String> {\n676:         self.pending_wake_session_ids_by_oldest_seq(limit, \"DESC\")\n677:     }\n678: \n679:     fn pending_wake_session_ids_by_oldest_seq(\n680:         &self,\n681:         limit: usize,\n682:         direction: &str,\n683:     ) -> Result<Vec<String>, String> {\n684:         let mut stmt = self\n685:             .conn\n686:             .prepare(&format!(\n687:                 \"SELECT session_id\n688:                  FROM mailbox\n689:                  WHERE delivered_at IS NULL\n690:                    AND (delivery_error IS NULL OR delivery_error != ?2)\n691:                  GROUP BY session_id\n692:                  ORDER BY MIN(seq) {direction}\n693:                  LIMIT ?1\",\n694:             ))\n695:             .map_err(|err| format!(\"Failed to prepare pending wake session query: {err}\"))?;\n696:         let rows = stmt\n697:             .query_map(params![limit as i64, WAKE_SWEEP_ABANDONED_ERROR], |row| {\n698:                 row.get::<_, String>(0)\n699:             })\n700:             .map_err(|err| format!(\"Failed to query pending wake sessions: {err}\"))?;\n701:         rows.collect::<Result<Vec<_>, _>>()\n702:             .map_err(|err| format!(\"Failed to read pending wake session row: {err}\"))\n703:     }\n704: \n705:     fn pending_seq_bounds(&self, session_id: &str) -> Result<Option<(i64, i64)>, String> {\n706:         pending_seq_bounds_on(&self.conn, session_id)\n707:     }\n708: \n709:     #[cfg(test)]\n710:     fn enqueue_agent_bash_complete_then_rollback(\n711:         &mut self,\n712:         input: &AgentBashCompleteEnqueue<'_>,\n713:     ) -> Result<(), String> {\n714:         let now = now_rfc3339();\n715:         let tx = self\n716:             .conn\n717:             .transaction()\n718:             .map_err(|err| format!(\"Failed to start mailbox rollback test transaction: {err}\"))?;\n719:         let _ = enqueue_agent_bash_complete_in_tx(&tx, input, &now)?;\n720:         Err(\"forced rollback before commit\".to_string())\n721:     }\n722: \n723:     fn max_mailbox_seq(&self, session_id: &str) -> Result<Option<i64>, String> {\n724:         self.conn\n725:             .query_row(\n726:                 \"SELECT MAX(seq) FROM mailbox WHERE session_id = ?1\",\n727:                 params![session_id],\n728:                 |row| row.get(0),\n729:             )\n730:             .map_err(|err| format!(\"Failed to read mailbox max seq: {err}\"))\n731:     }\n732: \n733:     fn running_turn_start_max_mailbox_seq(\n734:         &self,\n735:         input: &SessionRuntimeRunningUpdate<'_>,\n736:     ) -> Result<Option<i64>, String> {\n737:         let Some(seq) = input.turn_start_max_mailbox_seq else {\n738:             return self.max_mailbox_seq(input.session_id);\n739:         };\n740:         Ok(Some(seq))\n741:     }\n742: \n743:     fn session_has_pending_mailbox(&self, session_id: &str) -> Result<bool, String> {\n744:         self.list_pending(session_id)\n745:             .map(|pending| !pending.is_empty())\n746:     }\n747: \n748:     fn session_is_busy(&mut self, session_id: &str) -> Result<bool, String> {\n749:         self.session_liveness(session_id)\n750:             .map(|liveness| liveness == SessionLiveness::Busy)\n751:     }\n752: \n753:     fn release_busy_child_wake_claim(\n754:         &mut self,\n755:         session_id: &str,\n756:         claim_token: &str,\n757:     ) -> Result<bool, String> {\n758:         if self.busy_child_wake_claim_should_release(session_id)? {\n759:             self.release_child_wake_claim(session_id, claim_token)?;\n760:             return Ok(false);\n\n(Showing lines 1-760 of 2145. Use offset=761 to continue.)\n</content>","metadata":{"preview":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n//! `predicate`, `validator`\n//!\n//! Resume-backed notification mailbox storage in the PID identity sidecar DB.\n//! This module deliberately owns only additive sidecar tables and never touches\n//! the versioned `state.db` schema.\n\nuse chrono::{DateTime, Duration, SecondsFormat, Utc};\nuse rusqlite::{Connection, OpenFlags, OptionalExtension, params};\nuse serde::Serialize;\nuse std::path::{Path, PathBuf};\n\nuse crate::pid_identity::{self, ProcessIdentity};\n\npub const AGENT_BASH_COMPLETE_KIND: &str = \"agent_bash_complete\";\npub const WAKE_SWEEP_ABANDONED_ERROR: &str = \"wake_sweep_abandoned\";\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize)]","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-state/src/mailbox.rs","text":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n//! `predicate`, `validator`\n//!\n//! Resume-backed notification mailbox storage in the PID identity sidecar DB.\n//! This module deliberately owns only additive sidecar tables and never touches\n//! the versioned `state.db` schema.\n\nuse chrono::{DateTime, Duration, SecondsFormat, Utc};\nuse rusqlite::{Connection, OpenFlags, OptionalExtension, params};\nuse serde::Serialize;\nuse std::path::{Path, PathBuf};\n\nuse crate::pid_identity::{self, ProcessIdentity};\n\npub const AGENT_BASH_COMPLETE_KIND: &str = \"agent_bash_complete\";\npub const WAKE_SWEEP_ABANDONED_ERROR: &str = \"wake_sweep_abandoned\";\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\npub struct MailboxRow {\n    pub seq: i64,\n    pub session_id: String,\n    pub kind: String,\n    pub handle: String,\n    pub payload_json: String,\n    pub enqueued_at: String,\n    pub delivered_at: Option<String>,\n    pub delivered_by_invocation_uuid: Option<String>,\n    pub delivery_attempts: i64,\n    pub delivery_error: Option<String>,\n    pub owner_invocation_uuid: Option<String>,\n    pub matched_os_pid: Option<i64>,\n    pub matched_os_boot_id: Option<String>,\n    pub matched_os_pid_starttime_ticks: Option<i64>,\n    pub matched_chain_index: Option<i64>,\n    pub state_dir: String,\n    pub meta_path: String,\n    pub log_path: String,\n    pub rc_path: String,\n    pub rc: i32,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct AgentBashCompleteEnqueue<'a> {\n    pub session_id: &'a str,\n    pub handle: &'a str,\n    pub payload_json: &'a str,\n    pub owner_invocation_uuid: Option<&'a str>,\n    pub matched_os_pid: Option<i64>,\n    pub matched_os_boot_id: Option<&'a str>,\n    pub matched_os_pid_starttime_ticks: Option<i64>,\n    pub matched_chain_index: Option<i64>,\n    pub state_dir: &'a str,\n    pub meta_path: &'a str,\n    pub log_path: &'a str,\n    pub rc_path: &'a str,\n    pub rc: i32,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum EnqueueResult {\n    Inserted(MailboxRow),\n    AlreadyEnqueued(MailboxRow),\n    Conflict { existing: MailboxRow },\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct SessionRuntimeUpsert<'a> {\n    pub session_id: &'a str,\n    pub mode: &'a str,\n    pub invocation_uuid: Option<&'a str>,\n    pub provider_name: Option<&'a str>,\n    pub model_name: Option<&'a str>,\n    pub pty_control_path: Option<&'a str>,\n    pub models_dir: Option<&'a str>,\n    pub effective_cwd: Option<&'a str>,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct SessionRuntimeRunningUpdate<'a> {\n    pub session_id: &'a str,\n    pub mode: &'a str,\n    pub invocation_uuid: &'a str,\n    pub provider_name: Option<&'a str>,\n    pub model_name: Option<&'a str>,\n    pub identity: &'a ProcessIdentity,\n    pub pty_control_path: Option<&'a str>,\n    pub turn_start_max_mailbox_seq: Option<i64>,\n    pub models_dir: Option<&'a str>,\n    pub effective_cwd: Option<&'a str>,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct SessionRuntimeIdleUpdate<'a> {\n    pub session_id: &'a str,\n    pub invocation_uuid: &'a str,\n    pub last_exit_code: Option<i32>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct SessionRuntimeRow {\n    pub session_id: String,\n    pub mode: String,\n    pub invocation_uuid: Option<String>,\n    pub provider_name: Option<String>,\n    pub model_name: Option<String>,\n    pub pty_control_path: Option<String>,\n    pub updated_at: String,\n    pub run_state: String,\n    pub running_invocation_uuid: Option<String>,\n    pub running_os_pid: Option<i64>,\n    pub running_os_boot_id: Option<String>,\n    pub running_os_pid_starttime_ticks: Option<i64>,\n    pub turn_started_at: Option<String>,\n    pub turn_ended_at: Option<String>,\n    pub turn_start_max_mailbox_seq: Option<i64>,\n    pub last_exit_code: Option<i32>,\n    pub models_dir: Option<String>,\n    pub effective_cwd: Option<String>,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum SessionLiveness {\n    Busy,\n    Idle,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\nenum SessionRuntimeLivenessDecision {\n    Busy,\n    Idle,\n    Stale {\n        running_invocation_uuid: Option<String>,\n    },\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct WakeClaimRequest<'a> {\n    pub session_id: &'a str,\n    pub claim_token: &'a str,\n    pub reason: &'a str,\n    pub auto_wake_count: i64,\n    pub wake_invocation_uuid: Option<&'a str>,\n    pub stale_after_seconds: i64,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum WakeClaimAcquireResult {\n    Acquired(WakeClaimRow),\n    NoPending,\n    Busy,\n    AlreadyInFlight(WakeClaimRow),\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct WakeClaimRow {\n    pub session_id: String,\n    pub claim_token: String,\n    pub claimed_at: String,\n    pub wake_pid: Option<i64>,\n    pub wake_invocation_uuid: Option<String>,\n    pub reason: String,\n    pub auto_wake_count: i64,\n    pub min_pending_seq_at_claim: Option<i64>,\n    pub max_pending_seq_at_claim: Option<i64>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct WakeSweepCandidate {\n    pub session_id: String,\n    pub auto_wake_count: i64,\n    pub min_pending_seq: i64,\n    pub max_pending_seq: i64,\n}\n\npub struct MailboxDb {\n    conn: Connection,\n    path: PathBuf,\n}\n\nimpl MailboxDb {\n    pub fn default_path() -> Result<PathBuf, String> {\n        pid_identity::default_path()\n    }\n\n    pub fn open_default() -> Result<Self, String> {\n        let path = Self::default_path()?;\n        Self::open(&path)\n    }\n\n    pub fn open_default_if_exists() -> Result<Option<Self>, String> {\n        let path = Self::default_path()?;\n        if !path.exists() {\n            return Ok(None);\n        }\n        Self::open(&path).map(Some)\n    }\n\n    pub fn open(path: &Path) -> Result<Self, String> {\n        ensure_parent_dir(path)?;\n        let conn = Connection::open(path)\n            .map_err(|err| format!(\"Failed to open PID mailbox sidecar: {err}\"))?;\n        set_wal_mode(&conn)?;\n        pid_identity::ensure_identity_schema(&conn)?;\n        ensure_mailbox_schema(&conn)?;\n        Ok(Self {\n            conn,\n            path: path.to_path_buf(),\n        })\n    }\n\n    pub fn open_read_only(path: &Path) -> Result<Self, String> {\n        let conn = Connection::open_with_flags(path, OpenFlags::SQLITE_OPEN_READ_ONLY)\n            .map_err(|err| format!(\"Failed to open PID mailbox sidecar read-only: {err}\"))?;\n        Ok(Self {\n            conn,\n            path: path.to_path_buf(),\n        })\n    }\n\n    pub fn path(&self) -> &Path {\n        &self.path\n    }\n\n    pub fn connection(&self) -> &Connection {\n        &self.conn\n    }\n\n    pub fn enqueue_agent_bash_complete(\n        &mut self,\n        input: &AgentBashCompleteEnqueue<'_>,\n    ) -> Result<EnqueueResult, String> {\n        let now = now_rfc3339();\n        let tx = self\n            .conn\n            .transaction()\n            .map_err(|err| format!(\"Failed to start mailbox enqueue transaction: {err}\"))?;\n        let result = enqueue_agent_bash_complete_in_tx(&tx, input, &now)?;\n        tx.commit()\n            .map_err(|err| format!(\"Failed to commit mailbox enqueue transaction: {err}\"))?;\n        Ok(result)\n    }\n\n    pub fn list_pending(&self, session_id: &str) -> Result<Vec<MailboxRow>, String> {\n        let mut stmt = self\n            .conn\n            .prepare(\n                \"SELECT seq, session_id, kind, handle, payload_json, enqueued_at,\n                        delivered_at, delivered_by_invocation_uuid, delivery_attempts,\n                        delivery_error, owner_invocation_uuid, matched_os_pid,\n                        matched_os_boot_id, matched_os_pid_starttime_ticks,\n                        matched_chain_index, state_dir, meta_path, log_path, rc_path, rc\n                 FROM mailbox\n                 WHERE session_id = ?1 AND delivered_at IS NULL\n                 ORDER BY seq ASC\",\n            )\n            .map_err(|err| format!(\"Failed to prepare pending mailbox query: {err}\"))?;\n        let rows = stmt\n            .query_map(params![session_id], map_mailbox_row)\n            .map_err(|err| format!(\"Failed to query pending mailbox rows: {err}\"))?;\n        collect_rows(rows)\n    }\n\n    pub fn list_mailbox(&self, session_id: &str, all: bool) -> Result<Vec<MailboxRow>, String> {\n        if all {\n            self.list_mailbox_all(session_id)\n        } else {\n            self.list_pending(session_id)\n        }\n    }\n\n    pub fn mark_delivered(\n        &mut self,\n        session_id: &str,\n        seqs: &[i64],\n        delivered_by_invocation_uuid: &str,\n    ) -> Result<(), String> {\n        if seqs.is_empty() {\n            return Ok(());\n        }\n        let now = now_rfc3339();\n        let tx = self\n            .conn\n            .transaction()\n            .map_err(|err| format!(\"Failed to start mailbox delivery transaction: {err}\"))?;\n        for seq in seqs {\n            tx.execute(\n                \"UPDATE mailbox\n                 SET delivered_at = ?3,\n                     delivered_by_invocation_uuid = ?4,\n                     delivery_attempts = delivery_attempts + 1,\n                     delivery_error = NULL\n                 WHERE session_id = ?1\n                   AND seq = ?2\n                   AND delivered_at IS NULL\",\n                params![session_id, seq, &now, delivered_by_invocation_uuid],\n            )\n            .map_err(|err| format!(\"Failed to mark mailbox row delivered: {err}\"))?;\n        }\n        tx.commit()\n            .map_err(|err| format!(\"Failed to commit mailbox delivery transaction: {err}\"))\n    }\n\n    pub fn mark_delivery_failed(\n        &mut self,\n        session_id: &str,\n        seqs: &[i64],\n        delivery_error: &str,\n    ) -> Result<(), String> {\n        if seqs.is_empty() {\n            return Ok(());\n        }\n        let tx = self.conn.transaction().map_err(|err| {\n            format!(\"Failed to start mailbox delivery failure transaction: {err}\")\n        })?;\n        for seq in seqs {\n            tx.execute(\n                \"UPDATE mailbox\n                 SET delivery_attempts = delivery_attempts + 1,\n                     delivery_error = ?3\n                 WHERE session_id = ?1\n                   AND seq = ?2\n                   AND delivered_at IS NULL\",\n                params![session_id, seq, delivery_error],\n            )\n            .map_err(|err| format!(\"Failed to mark mailbox row delivery failed: {err}\"))?;\n        }\n        tx.commit()\n            .map_err(|err| format!(\"Failed to commit mailbox delivery failure transaction: {err}\"))\n    }\n\n    pub fn mark_pending_abandoned(\n        &mut self,\n        session_id: &str,\n        delivery_error: &str,\n        limit: usize,\n    ) -> Result<usize, String> {\n        if limit == 0 {\n            return Ok(0);\n        }\n        let tx = self\n            .conn\n            .transaction()\n            .map_err(|err| format!(\"Failed to start mailbox abandonment transaction: {err}\"))?;\n        let changed = tx\n            .execute(\n                \"UPDATE mailbox\n                 SET delivery_error = ?2\n                 WHERE seq IN (\n                    SELECT seq\n                    FROM mailbox\n                    WHERE session_id = ?1\n                      AND delivered_at IS NULL\n                      AND (delivery_error IS NULL OR delivery_error != ?2)\n                    ORDER BY seq ASC\n                    LIMIT ?3\n                 )\",\n                params![session_id, delivery_error, limit as i64],\n            )\n            .map_err(|err| format!(\"Failed to mark mailbox rows abandoned: {err}\"))?;\n        if changed > 0 {\n            tx.execute(\n                \"DELETE FROM session_wake_claim WHERE session_id = ?1\",\n                params![session_id],\n            )\n            .map_err(|err| format!(\"Failed to release abandoned wake claim: {err}\"))?;\n        }\n        tx.commit()\n            .map_err(|err| format!(\"Failed to commit mailbox abandonment transaction: {err}\"))?;\n        Ok(changed)\n    }\n\n    pub fn upsert_session_runtime(\n        &mut self,\n        input: SessionRuntimeUpsert<'_>,\n    ) -> Result<(), String> {\n        let now = now_rfc3339();\n        self.conn\n            .execute(\n                \"INSERT INTO session_runtime (\n                    session_id,\n                    mode,\n                    invocation_uuid,\n                    provider_name,\n                    model_name,\n                    pty_control_path,\n                    updated_at,\n                    models_dir,\n                    effective_cwd\n                 ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)\n                 ON CONFLICT(session_id)\n                 DO UPDATE SET\n                    mode = excluded.mode,\n                    invocation_uuid = excluded.invocation_uuid,\n                    provider_name = excluded.provider_name,\n                    model_name = excluded.model_name,\n                    pty_control_path = excluded.pty_control_path,\n                    updated_at = excluded.updated_at,\n                    models_dir = COALESCE(excluded.models_dir, session_runtime.models_dir),\n                    effective_cwd = COALESCE(excluded.effective_cwd, session_runtime.effective_cwd)\",\n                params![\n                    input.session_id,\n                    input.mode,\n                    input.invocation_uuid,\n                    input.provider_name,\n                    input.model_name,\n                    input.pty_control_path,\n                    &now,\n                    input.models_dir,\n                    input.effective_cwd,\n                ],\n            )\n            .map_err(|err| format!(\"Failed to upsert session runtime row: {err}\"))?;\n        Ok(())\n    }\n\n    pub fn mark_session_running(\n        &mut self,\n        input: SessionRuntimeRunningUpdate<'_>,\n    ) -> Result<(), String> {\n        validate_running_run_state()?;\n        let now = now_rfc3339();\n        let turn_start_max_mailbox_seq = self.running_turn_start_max_mailbox_seq(&input)?;\n        mark_session_running_row(&self.conn, input, &now, turn_start_max_mailbox_seq)\n    }\n\n    pub fn mark_session_idle(\n        &mut self,\n        input: SessionRuntimeIdleUpdate<'_>,\n    ) -> Result<bool, String> {\n        validate_idle_run_state()?;\n        let now = now_rfc3339();\n        mark_session_idle_row(&self.conn, input, &now)\n    }\n\n    pub fn session_runtime(&self, session_id: &str) -> Result<Option<SessionRuntimeRow>, String> {\n        let row = session_runtime_row(&self.conn, session_id)?;\n        validate_session_runtime_row(row.as_ref())?;\n        Ok(row)\n    }\n\n    pub fn session_liveness(&mut self, session_id: &str) -> Result<SessionLiveness, String> {\n        let row = self.session_runtime(session_id)?;\n        let decision = session_runtime_liveness_decision(row.as_ref())?;\n        self.clear_stale_running_row_for_liveness(session_id, &decision)?;\n        Ok(session_liveness_from_decision(&decision))\n    }\n\n    pub fn try_acquire_wake_claim(\n        &mut self,\n        input: WakeClaimRequest<'_>,\n    ) -> Result<WakeClaimAcquireResult, String> {\n        self.try_acquire_or_renew_wake_claim(input, None)\n    }\n\n    pub fn try_acquire_or_renew_wake_claim(\n        &mut self,\n        input: WakeClaimRequest<'_>,\n        renew_token: Option<&str>,\n    ) -> Result<WakeClaimAcquireResult, String> {\n        if !self.session_has_pending_mailbox(input.session_id)? {\n            return Ok(WakeClaimAcquireResult::NoPending);\n        }\n        if self.session_is_busy(input.session_id)? {\n            return Ok(WakeClaimAcquireResult::Busy);\n        }\n        let now = now_rfc3339();\n        let tx = self\n            .conn\n            .transaction()\n            .map_err(|err| format!(\"Failed to start wake claim transaction: {err}\"))?;\n        let pending_bounds = pending_seq_bounds_tx(&tx, input.session_id)?;\n        let Some((min_seq, max_seq)) = pending_bounds else {\n            tx.commit()\n                .map_err(|err| format!(\"Failed to commit empty wake claim transaction: {err}\"))?;\n            return Ok(WakeClaimAcquireResult::NoPending);\n        };\n        if let Some(existing) = fresh_in_flight_wake_claim(\n            &tx,\n            wake_claim_tx(&tx, input.session_id)?,\n            input.stale_after_seconds,\n            renew_token,\n        )? {\n            tx.commit().map_err(|err| {\n                format!(\"Failed to commit existing wake claim transaction: {err}\")\n            })?;\n            return Ok(WakeClaimAcquireResult::AlreadyInFlight(existing));\n        }\n        let claim = acquire_wake_claim_tx(&tx, input, &now, min_seq, max_seq)?;\n        tx.commit()\n            .map_err(|err| format!(\"Failed to commit wake claim transaction: {err}\"))?;\n        Ok(WakeClaimAcquireResult::Acquired(claim))\n    }\n\n    pub fn wake_claim(&self, session_id: &str) -> Result<Option<WakeClaimRow>, String> {\n        wake_claim(&self.conn, session_id)\n    }\n\n    pub fn release_wake_claim(\n        &mut self,\n        session_id: &str,\n        claim_token: Option<&str>,\n    ) -> Result<bool, String> {\n        let changed = match claim_token {\n            Some(token) => self.conn.execute(\n                \"DELETE FROM session_wake_claim WHERE session_id = ?1 AND claim_token = ?2\",\n                params![session_id, token],\n            ),\n            None => self.conn.execute(\n                \"DELETE FROM session_wake_claim WHERE session_id = ?1\",\n                params![session_id],\n            ),\n        }\n        .map_err(|err| format!(\"Failed to release wake claim: {err}\"))?;\n        Ok(changed > 0)\n    }\n\n    pub fn record_wake_claim_pid(\n        &mut self,\n        session_id: &str,\n        claim_token: &str,\n        wake_pid: i64,\n    ) -> Result<bool, String> {\n        let changed = self\n            .conn\n            .execute(\n                \"UPDATE session_wake_claim\n                 SET wake_pid = ?3\n                 WHERE session_id = ?1\n                   AND claim_token = ?2\",\n                params![session_id, claim_token, wake_pid],\n            )\n            .map_err(|err| format!(\"Failed to record wake claim PID: {err}\"))?;\n        Ok(changed > 0)\n    }\n\n    pub fn record_wake_claim_pid_identity(\n        &mut self,\n        session_id: &str,\n        claim_token: &str,\n        wake_pid: i64,\n        provider_name: Option<&str>,\n        model_name: Option<&str>,\n    ) -> Result<bool, String> {\n        if let Some(identity) = pid_identity::read_live_process_identity(wake_pid)? {\n            let recorded_at = now_rfc3339();\n            pid_identity::PidIdentityDb::open(self.path())?.record_identity(\n                pid_identity::PidIdentityRecord {\n                    identity: &identity,\n                    os_pgid: None,\n                    invocation_uuid: claim_token,\n                    session_id: Some(session_id),\n                    provider_name,\n                    model_name,\n                    recorded_at: &recorded_at,\n                },\n            )?;\n        }\n        self.record_wake_claim_pid(session_id, claim_token, wake_pid)\n    }\n\n    pub fn wake_sweep_candidates(\n        &mut self,\n        stale_after_seconds: i64,\n        limit: usize,\n    ) -> Result<Vec<WakeSweepCandidate>, String> {\n        if limit == 0 {\n            return Ok(Vec::new());\n        }\n        let mut candidates = Vec::new();\n        for session_id in self.pending_wake_session_ids(limit)? {\n            if candidates.len() >= limit {\n                break;\n            }\n            if self.session_is_busy(&session_id)? {\n                continue;\n            }\n            let Some((min_pending_seq, max_pending_seq)) = self.pending_seq_bounds(&session_id)?\n            else {\n                continue;\n            };\n            let Some(claim) = self.wake_claim(&session_id)? else {\n                candidates.push(wake_sweep_candidate(\n                    session_id,\n                    1,\n                    min_pending_seq,\n                    max_pending_seq,\n                ));\n                continue;\n            };\n            if wake_claim_is_reclaimable(&self.conn, &claim, stale_after_seconds)? {\n                candidates.push(wake_sweep_candidate(\n                    session_id,\n                    claim.auto_wake_count.saturating_add(1),\n                    min_pending_seq,\n                    max_pending_seq,\n                ));\n            }\n        }\n        Ok(candidates)\n    }\n\n    pub fn validate_wake_claim_for_child(\n        &mut self,\n        session_id: &str,\n        claim_token: &str,\n    ) -> Result<bool, String> {\n        let claim = self.wake_claim(session_id)?;\n        if !wake_claim_is_valid_for_child(claim.as_ref(), claim_token) {\n            return Ok(false);\n        }\n        self.release_busy_child_wake_claim(session_id, claim_token)\n    }\n\n    #[cfg(test)]\n    fn force_wake_claim_age_for_test(\n        &mut self,\n        session_id: &str,\n        seconds_old: i64,\n    ) -> Result<(), String> {\n        let claimed_at = (Utc::now() - Duration::seconds(seconds_old))\n            .to_rfc3339_opts(SecondsFormat::Secs, true);\n        self.conn\n            .execute(\n                \"UPDATE session_wake_claim SET claimed_at = ?2 WHERE session_id = ?1\",\n                params![session_id, &claimed_at],\n            )\n            .map_err(|err| format!(\"Failed to age wake claim for test: {err}\"))?;\n        Ok(())\n    }\n\n    fn list_mailbox_all(&self, session_id: &str) -> Result<Vec<MailboxRow>, String> {\n        let mut stmt = self\n            .conn\n            .prepare(\n                \"SELECT seq, session_id, kind, handle, payload_json, enqueued_at,\n                        delivered_at, delivered_by_invocation_uuid, delivery_attempts,\n                        delivery_error, owner_invocation_uuid, matched_os_pid,\n                        matched_os_boot_id, matched_os_pid_starttime_ticks,\n                        matched_chain_index, state_dir, meta_path, log_path, rc_path, rc\n                 FROM mailbox\n                 WHERE session_id = ?1\n                 ORDER BY seq ASC\",\n            )\n            .map_err(|err| format!(\"Failed to prepare mailbox query: {err}\"))?;\n        let rows = stmt\n            .query_map(params![session_id], map_mailbox_row)\n            .map_err(|err| format!(\"Failed to query mailbox rows: {err}\"))?;\n        collect_rows(rows)\n    }\n\n    fn pending_wake_session_ids(&self, limit: usize) -> Result<Vec<String>, String> {\n        if limit == 0 {\n            return Ok(Vec::new());\n        }\n        let oldest_limit = limit.saturating_sub(limit / 2);\n        let newest_limit = limit.saturating_sub(oldest_limit);\n        let mut session_ids = self.oldest_pending_wake_session_ids(oldest_limit)?;\n        for session_id in self.newest_pending_wake_session_ids(newest_limit)? {\n            if session_ids.len() >= limit {\n                break;\n            }\n            if !session_ids.iter().any(|existing| existing == &session_id) {\n                session_ids.push(session_id);\n            }\n        }\n        Ok(session_ids)\n    }\n\n    fn oldest_pending_wake_session_ids(&self, limit: usize) -> Result<Vec<String>, String> {\n        self.pending_wake_session_ids_by_oldest_seq(limit, \"ASC\")\n    }\n\n    fn newest_pending_wake_session_ids(&self, limit: usize) -> Result<Vec<String>, String> {\n        self.pending_wake_session_ids_by_oldest_seq(limit, \"DESC\")\n    }\n\n    fn pending_wake_session_ids_by_oldest_seq(\n        &self,\n        limit: usize,\n        direction: &str,\n    ) -> Result<Vec<String>, String> {\n        let mut stmt = self\n            .conn\n            .prepare(&format!(\n                \"SELECT session_id\n                 FROM mailbox\n                 WHERE delivered_at IS NULL\n                   AND (delivery_error IS NULL OR delivery_error != ?2)\n                 GROUP BY session_id\n                 ORDER BY MIN(seq) {direction}\n                 LIMIT ?1\",\n            ))\n            .map_err(|err| format!(\"Failed to prepare pending wake session query: {err}\"))?;\n        let rows = stmt\n            .query_map(params![limit as i64, WAKE_SWEEP_ABANDONED_ERROR], |row| {\n                row.get::<_, String>(0)\n            })\n            .map_err(|err| format!(\"Failed to query pending wake sessions: {err}\"))?;\n        rows.collect::<Result<Vec<_>, _>>()\n            .map_err(|err| format!(\"Failed to read pending wake session row: {err}\"))\n    }\n\n    fn pending_seq_bounds(&self, session_id: &str) -> Result<Option<(i64, i64)>, String> {\n        pending_seq_bounds_on(&self.conn, session_id)\n    }\n\n    #[cfg(test)]\n    fn enqueue_agent_bash_complete_then_rollback(\n        &mut self,\n        input: &AgentBashCompleteEnqueue<'_>,\n    ) -> Result<(), String> {\n        let now = now_rfc3339();\n        let tx = self\n            .conn\n            .transaction()\n            .map_err(|err| format!(\"Failed to start mailbox rollback test transaction: {err}\"))?;\n        let _ = enqueue_agent_bash_complete_in_tx(&tx, input, &now)?;\n        Err(\"forced rollback before commit\".to_string())\n    }\n\n    fn max_mailbox_seq(&self, session_id: &str) -> Result<Option<i64>, String> {\n        self.conn\n            .query_row(\n                \"SELECT MAX(seq) FROM mailbox WHERE session_id = ?1\",\n                params![session_id],\n                |row| row.get(0),\n            )\n            .map_err(|err| format!(\"Failed to read mailbox max seq: {err}\"))\n    }\n\n    fn running_turn_start_max_mailbox_seq(\n        &self,\n        input: &SessionRuntimeRunningUpdate<'_>,\n    ) -> Result<Option<i64>, String> {\n        let Some(seq) = input.turn_start_max_mailbox_seq else {\n            return self.max_mailbox_seq(input.session_id);\n        };\n        Ok(Some(seq))\n    }\n\n    fn session_has_pending_mailbox(&self, session_id: &str) -> Result<bool, String> {\n        self.list_pending(session_id)\n            .map(|pending| !pending.is_empty())\n    }\n\n    fn session_is_busy(&mut self, session_id: &str) -> Result<bool, String> {\n        self.session_liveness(session_id)\n            .map(|liveness| liveness == SessionLiveness::Busy)\n    }\n\n    fn release_busy_child_wake_claim(\n        &mut self,\n        session_id: &str,\n        claim_token: &str,\n    ) -> Result<bool, String> {\n        if self.busy_child_wake_claim_should_release(session_id)? {\n            self.release_child_wake_claim(session_id, claim_token)?;\n            return Ok(false);","lineStart":1,"lineEnd":760,"totalLines":2145,"truncated":true}},"title":"crates/oulipoly-state/src/mailbox.rs","time":{"start":1780923549126,"end":1780923549157}},"metadata":{"openai":{"itemId":"fc_0abab8e811c21e2e016a26bc9ccf44819a8e394ac6972935e0"}},"id":"prt_ea750c569001xQIlU4wX8Q818r","sessionID":"ses_158b04353ffeBDs6p8N4H5rApd","messageID":"msg_ea7509481001EUAxjzTuH5JY2B"}}
