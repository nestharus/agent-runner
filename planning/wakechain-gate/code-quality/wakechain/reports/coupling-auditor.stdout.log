         }\n83:     };\n84:     let result = run_resume_loop(ResumeLoopInput {\n85:         agent_runtime_services,\n86:         prepared: &mut prepared,\n87:         manual_migrate,\n88:         session_id,\n89:         working_dir,\n90:     });\n91:     if failed_auto_wake_exit(&result) {\n92:         let _ = crate::wake_coordinator::recheck_after_failed_auto_wake(session_id);\n93:     }\n94:     result\n95: }\n96: \n97: fn failed_auto_wake_exit(result: &Result<i32, String>) -> bool {\n98:     crate::wake_coordinator::is_auto_wake_invocation() && !matches!(result, Ok(0))\n99: }\n100: \n101: fn reject_invalid_resume_input(session_id: &str) -> Option<i32> {\n102:     match validator::validate_resume_input(session_id) {\n103:         Ok(()) => None,\n104:         Err(message) => {\n105:             formatter::emit_stderr(&message);\n106:             Some(1)\n107:         }\n108:     }\n109: }\n110: \n111: struct PreparedHeadlessResumeExecution {\n112:     answer: Option<String>,\n113:     mailbox_session_id: String,\n114:     mailbox_delivery_seqs: Vec<i64>,\n115:     mailbox_delivery_nonce: Option<String>,\n116:     env: crate::migration_providers::ResumeExecutionEnvironment,\n117:     resolved: oulipoly_state::ResolvedResume,\n118:     effective_spawn_cwd: std::path::PathBuf,\n119:     parent_invocation_id: Option<i64>,\n120:     max_attempts: usize,\n121: }\n122: \n123: #[allow(clippy::too_many_arguments)]\n124: fn prepare_headless_resume_execution(\n125:     agent_runtime_services: &wiring::AgentRuntimeServices,\n126:     model_name: Option<&str>,\n127:     session_id: &str,\n128:     prompt: Option<&str>,\n129:     file: Option<&Path>,\n130:     working_dir: Option<&Path>,\n131:     models_dir_override: Option<&Path>,\n132: ) -> Result<Result<PreparedHeadlessResumeExecution, i32>, String> {\n133:     let answer = resolve_resume_answer(prompt, file)?;\n134:     let env = load_resume_execution_environment(models_dir_override)?;\n135:     refresh_resume_provider_registry(agent_runtime_services, &env)?;\n136:     let resolved = match resolve_resume_for_headless_execution(\n137:         agent_runtime_services,\n138:         &env,\n139:         session_id,\n140:         model_name,\n141:     ) {\n142:         Ok(resolved) => resolved,\n143:         Err(exit_code) => return Ok(Err(exit_code)),\n144:     };\n145:     if let Err(exit_code) = prepare_initial_headless_resume_target(\n146:         &resolved,\n147:         &env.providers_cfg,\n148:         std::io::stderr().is_terminal(),\n149:     ) {\n150:         return Ok(Err(exit_code));\n151:     }\n152:     let effective_spawn_cwd = effective_resume_execution_cwd(&env, session_id, working_dir)?;\n153:     let parent_invocation_id = crate::dispatch::resolve_parent_invocation_id(&env.state);\n154:     let max_attempts = headless_resume_retry_budget(&resolved);\n155:     let mailbox_delivery = crate::mailbox_delivery::prepare_headless_resume_delivery(\n156:         &resolved,\n157:         answer,\n158:         Some(&env.models_dir),\n159:     )?;\n160:     Ok(Ok(PreparedHeadlessResumeExecution {\n161:         answer: mailbox_delivery.answer,\n162:         mailbox_session_id: mailbox_delivery.session_id,\n163:         mailbox_delivery_seqs: mailbox_delivery.seqs,\n164:         mailbox_delivery_nonce: mailbox_delivery.delivery_nonce,\n165:         env,\n166:         resolved,\n167:         effective_spawn_cwd,\n168:         parent_invocation_id,\n169:         max_attempts,\n170:     }))\n171: }\n172: \n173: fn refresh_resume_provider_registry(\n174:     agent_runtime_services: &wiring::AgentRuntimeServices,\n175:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n176: ) -> Result<(), String> {\n177:     let models = env.models.values().cloned().collect::<Vec<_>>();\n178:     let registry =\n179:         ProviderRegistry::from_model_configs(&models, resume_provider_registry_options(env))\n180:             .map_err(|err| format!(\"failed to build resume provider registry: {err}\"))?;\n181:     agent_runtime_services\n182:         .provider_registry_handle\n183:         .replace(Arc::new(registry));\n184:     Ok(())\n185: }\n186: \n187: fn resume_provider_registry_options(\n188:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n189: ) -> ProviderRegistryOptions {\n190:     ProviderRegistryOptions::default()\n191:         .with_path_entries_from_process_path()\n192:         .with_config_root(env.config_root.clone())\n193:         .with_data_root(resume_provider_registry_data_root(env))\n194: }\n195: \n196: fn resume_provider_registry_data_root(\n197:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n198: ) -> std::path::PathBuf {\n199:     oulipoly_state::paths::data_dir().unwrap_or_else(|_| env.config_root.clone())\n200: }\n201: \n202: fn effective_resume_execution_cwd(\n203:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n204:     session_id: &str,\n205:     working_dir: Option<&Path>,\n206: ) -> Result<std::path::PathBuf, String> {\n207:     effective_resume_spawn_cwd(\n208:         &env.state,\n209:         &env.models,\n210:         &env.providers_cfg,\n211:         &env.sessions_cfg,\n212:         session_id,\n213:         working_dir,\n214:     )\n215: }\n216: \n217: fn headless_resume_retry_budget(resolved: &oulipoly_state::ResolvedResume) -> usize {\n218:     resolved\n219:         .model\n220:         .as_ref()\n221:         .map(|model| model.providers.len())\n222:         .unwrap_or(1)\n223:         .max(1)\n224:         + 1\n225: }\n226: \n227: struct ResumeLoopInput<'a> {\n228:     agent_runtime_services: &'a wiring::AgentRuntimeServices,\n229:     prepared: &'a mut PreparedHeadlessResumeExecution,\n230:     manual_migrate: Option<&'a str>,\n231:     session_id: &'a str,\n232:     working_dir: Option<&'a Path>,\n233: }\n234: \n235: fn run_resume_loop(input: ResumeLoopInput<'_>) -> Result<i32, String> {\n236:     let mut attempts = 0usize;\n237:     let mut last_exit_code = 1;\n238:     let mut zero_turn_confirmation = ZeroTurnConfirmationState::new();\n239: \n240:     loop {\n241:         if resume_attempts_exhausted(attempts, input.prepared.max_attempts) {\n242:             return Ok(resume_attempts_exhausted_exit_code(last_exit_code));\n243:         }\n244:         attempts += 1;\n245: \n246:         match run_resume_attempt(ResumeAttemptInput {\n247:             agent_runtime_services: input.agent_runtime_services,\n248:             env: &input.prepared.env,\n249:             resolved: &mut input.prepared.resolved,\n250:             answer: input.prepared.answer.as_deref(),\n251:             mailbox_session_id: &input.prepared.mailbox_session_id,\n252:             mailbox_delivery_seqs: &input.prepared.mailbox_delivery_seqs,\n253:             mailbox_delivery_nonce: input.prepared.mailbox_delivery_nonce.as_deref(),\n254:             manual_migrate: input.manual_migrate,\n255:             session_id: input.session_id,\n256:             working_dir: input.working_dir,\n257:             attempts,\n258:             max_attempts: input.prepared.max_attempts,\n259:             parent_invocation_id: input.prepared.parent_invocation_id,\n260:             effective_spawn_cwd: &input.prepared.effective_spawn_cwd,\n261:             zero_turn_confirmation: &mut zero_turn_confirmation,\n262:         })? {\n263:             ResumeAttemptLoopControl::Continue(exit_code) => {\n264:                 last_exit_code = exit_code;\n265:                 continue;\n266:             }\n267:             ResumeAttemptLoopControl::Return(exit_code) => return Ok(exit_code),\n268:         }\n269:     }\n270: }\n271: \n272: fn resume_attempts_exhausted(attempts: usize, max_attempts: usize) -> bool {\n273:     attempts >= max_attempts\n274: }\n275: \n276: fn resume_attempts_exhausted_exit_code(last_exit_code: i32) -> i32 {\n277:     formatter::emit_stderr(\"BLOCKED:all-providers-exhausted\");\n278:     normalized_resume_exhausted_exit_code(last_exit_code)\n279: }\n280: \n281: fn normalized_resume_exhausted_exit_code(last_exit_code: i32) -> i32 {\n282:     if last_exit_code == 0 {\n283:         1\n284:     } else {\n285:         last_exit_code\n286:     }\n287: }\n288: \n289: struct ResumeAttemptInput<'a> {\n290:     agent_runtime_services: &'a wiring::AgentRuntimeServices,\n291:     env: &'a crate::migration_providers::ResumeExecutionEnvironment,\n292:     resolved: &'a mut oulipoly_state::ResolvedResume,\n293:     answer: Option<&'a str>,\n294:     mailbox_session_id: &'a str,\n295:     mailbox_delivery_seqs: &'a [i64],\n296:     mailbox_delivery_nonce: Option<&'a str>,\n297:     manual_migrate: Option<&'a str>,\n298:     session_id: &'a str,\n299:     working_dir: Option<&'a Path>,\n300:     attempts: usize,\n301:     max_attempts: usize,\n302:     parent_invocation_id: Option<i64>,\n303:     effective_spawn_cwd: &'a Path,\n304:     zero_turn_confirmation: &'a mut ZeroTurnConfirmationState,\n305: }\n306: \n307: enum ResumeAttemptLoopControl {\n308:     Continue(i32),\n309:     Return(i32),\n310: }\n311: \n312: fn run_resume_attempt(\n313:     mut input: ResumeAttemptInput<'_>,\n314: ) -> Result<ResumeAttemptLoopControl, String> {\n315:     let target = match prepare_resume_attempt_target(&mut input)? {\n316:         Ok(target) => target,\n317:         Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n318:     };\n319:     let provider_index = target.provider_index;\n320:     let provider = target.provider;\n321:     let strategy = match resume_attempt_strategy_for_target(input.resolved, &provider) {\n322:         Ok(strategy) => strategy,\n323:         Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n324:     };\n325: \n326:     let mut bound_attempt = setup_bound_resume_attempt(&input, &provider, provider_index)?;\n327: \n328:     let mut result = match execute_resume_attempt_command(\n329:         &input,\n330:         &provider,\n331:         provider_index,\n332:         target.prompt_mode,\n333:         &bound_attempt.invocation_env,\n334:         strategy,\n335:     ) {\n336:         Ok(result) => result,\n337:         Err(_spawn_err) => return handle_resume_attempt_spawn_error(&input, &mut bound_attempt),\n338:     };\n339: \n340:     handle_resume_attempt_result(&mut input, &mut bound_attempt, &provider, &mut result)\n341: }\n342: \n343: fn handle_resume_attempt_spawn_error(\n344:     input: &ResumeAttemptInput<'_>,\n345:     bound_attempt: &mut BoundResumeAttempt<'_>,\n346: ) -> Result<ResumeAttemptLoopControl, String> {\n347:     record_failed_mailbox_delivery_attempt(input, \"resume_spawn_error\")?;\n348:     finalize_resume_spawn_error(input, &mut bound_attempt.attempt)?;\n349:     Ok(ResumeAttemptLoopControl::Return(1))\n350: }\n351: \n352: fn handle_resume_attempt_result(\n353:     input: &mut ResumeAttemptInput<'_>,\n354:     bound_attempt: &mut BoundResumeAttempt<'_>,\n355:     provider: &oulipoly_config::ProviderConfig,\n356:     result: &mut executor::ExecutionResult,\n357: ) -> Result<ResumeAttemptLoopControl, String> {\n358:     apply_resume_attempt_classification(\n359:         input.env,\n360:         &provider.name,\n361:         &bound_attempt.provider_session_id,\n362:         &bound_attempt.zero_turn_baseline,\n363:         input.zero_turn_confirmation,\n364:         result,\n365:     )\n366:     .and_then(|zero_turn_action| {\n367:         record_resume_acceptance_if_present(\n368:             input,\n369:             bound_attempt.attempt.invocation_row_id,\n370:             result,\n371:         )?;\n372:         emit_captured_child_marker_lines(&result.captured_child_invocations);\n373:         handle_resume_attempt_terminal_signal(\n374:             input,\n375:             &mut bound_attempt.attempt,\n376:             provider,\n377:             &bound_attempt.provider_session_id,\n378:             result,\n379:             zero_turn_action,\n380:         )\n381:     })\n382: }\n383: \n384: fn resume_attempt_strategy_for_target<'a>(\n385:     resolved: &oulipoly_state::ResolvedResume,\n386:     provider: &'a oulipoly_config::ProviderConfig,\n387: ) -> Result<Option<&'a oulipoly_config::ResumeStrategy>, i32> {\n388:     if resolved_uses_provider_ref(resolved) {\n389:         return Ok(None);\n390:     }\n391:     resume_attempt_strategy(provider).map(Some)\n392: }\n393: \n394: fn resume_attempt_strategy(\n395:     provider: &oulipoly_config::ProviderConfig,\n396: ) -> Result<&oulipoly_config::ResumeStrategy, i32> {\n397:     provider\n398:         .resume\n399:         .as_ref()\n400:         .ok_or_else(|| missing_resume_block_exit_code(&provider.name))\n401: }\n402: \n403: fn missing_resume_block_exit_code(provider_name: &str) -> i32 {\n404:     formatter::emit_missing_resume_block(provider_name);\n405:     1\n406: }\n407: \n408: fn execute_resume_attempt_command(\n409:     input: &ResumeAttemptInput<'_>,\n410:     provider: &oulipoly_config::ProviderConfig,\n411:     provider_index: usize,\n412:     prompt_mode: oulipoly_config::PromptMode,\n413:     invocation_env: &str,\n414:     strategy: Option<&oulipoly_config::ResumeStrategy>,\n415: ) -> Result<executor::ExecutionResult, String> {\n416:     if let Some(request) = provider_ref_resume_executor_request(\n417:         input,\n418:         provider,\n419:         provider_index,\n420:         prompt_mode,\n421:         invocation_env,\n422:     ) {\n423:         return input\n424:             .agent_runtime_services\n425:             .executor_service\n426:             .execute(request)\n427:             .map(|output| output.result)\n428:             .map_err(|err| err.to_string());\n429:     }\n430:     executor::cli::execute_resume_optional_prompt_with_model_identity(\n431:         provider,\n432:         provider_index,\n433:         prompt_mode,\n434:         input.answer,\n435:         Some(input.effective_spawn_cwd),\n436:         Some(invocation_env),\n437:         executor::cli::ResumePayload {\n438:             session_id: &input.resolved.active_session_id,\n439:             strategy: strategy.expect(\"legacy resume target must have a resume strategy\"),\n440:         },\n441:         input.resolved.model_name.as_deref().unwrap_or(\"<unknown>\"),\n442:     )\n443: }\n444: \n445: fn provider_ref_resume_executor_request(\n446:     input: &ResumeAttemptInput<'_>,\n447:     provider: &oulipoly_config::ProviderConfig,\n448:     provider_index: usize,\n449:     prompt_mode: oulipoly_config::PromptMode,\n450:     invocation_env: &str,\n451: ) -> Option<ExecutorServiceRequest> {\n452:     let model = input.resolved.model.as_ref()?;\n453:     model.provider.as_ref()?;\n454:     Some(\n455:         ExecutorServiceRequest::EffectiveWithStartKnownProviderSessionId {\n456:             model: model.clone(),\n457:             provider: provider.clone(),\n458:             provider_index,\n459:             prompt_mode,\n460:             prompt: input.answer.unwrap_or_default().to_string(),\n461:             working_dir: Some(input.effective_spawn_cwd.to_path_buf()),\n462:             extra_inputs: HashMap::new(),\n463:             parent_invocation_env: Some(invocation_env.to_string()),\n464:             start_known_provider_session_id: input.resolved.active_session_id.clone(),\n465:         },\n466:     )\n467: }\n468: \n469: fn finalize_resume_spawn_error(\n470:     input: &ResumeAttemptInput<'_>,\n471:     attempt: &mut ResumeInvocationAttempt<'_>,\n472: ) -> Result<(), String> {\n473:     input\n474:         .agent_runtime_services\n475:         .invocation_lifecycle_service\n476:         .finalize_invocation(mapper::spawn_error_finalize_request(\n477:             &input.env.state,\n478:             attempt.invocation_row_id,\n479:         ))\n480:         .map_err(|err| err.to_string())?;\n481:     attempt.guard.mark_finalized();\n482:     mark_resume_attempt_idle(\n483:         &input.resolved.active_session_id,\n484:         &attempt.invocation.id,\n485:         Some(1),\n486:     )?;\n487:     Ok(())\n488: }\n489: \n490: fn prepare_resume_attempt_target(\n491:     input: &mut ResumeAttemptInput<'_>,\n492: ) -> Result<Result<crate::resume_cli::ResumeExecutionTarget, i32>, String> {\n493:     let mut target =\n494:         match renderable_resume_execution_target(input.resolved, &input.env.providers_cfg) {\n495:             Ok(target) => target,\n496:             Err(exit_code) => return Ok(Err(exit_code)),\n497:         };\n498:     if let Err(exit_code) = migrate_resume_target(\n499:         input.agent_runtime_services,\n500:         input.env,\n501:         input.resolved,\n502:         &mut target,\n503:         input.manual_migrate,\n504:         input.attempts,\n505:         input.effective_spawn_cwd,\n506:     ) {\n507:         return Ok(Err(exit_code));\n508:     }\n509:     Ok(Ok(target))\n510: }\n511: \n512: struct ResumeInvocationAttempt<'state> {\n513:     invocation: oulipoly_state::CompositeInvocationId,\n514:     invocation_row_id: i64,\n515:     guard: FinalizerGuard<'state>,\n516: }\n517: \n518: struct BoundResumeAttempt<'state> {\n519:     attempt: ResumeInvocationAttempt<'state>,\n520:     provider_session_id: String,\n521:     zero_turn_baseline: crate::zero_turn_orchestration::ZeroTurnBaseline,\n522:     invocation_env: String,\n523: }\n524: \n525: fn setup_bound_resume_attempt<'state>(\n526:     input: &ResumeAttemptInput<'state>,\n527:     provider: &oulipoly_config::ProviderConfig,\n528:     provider_index: usize,\n529: ) -> Result<BoundResumeAttempt<'state>, String> {\n530:     let attempt = start_resume_invocation(input, provider, provider_index)?;\n531:     let provider_session_id = input.resolved.active_session_id.clone();\n532:     bind_resume_attempt_session(\n533:         input,\n534:         provider,\n535:         attempt.invocation_row_id,\n536:         &provider_session_id,\n537:     )?;\n538:     let zero_turn_baseline = zero_turn_record_baseline(\n539:         &input.env.state,\n540:         &input.env.sessions_cfg,\n541:         &provider.name,\n542:         Some(&provider_session_id),\n543:     );\n544:     let invocation_env = resume_invocation_env(&attempt.invocation)?;\n545:     formatter::emit_stderr(&attempt.invocation.stderr_line());\n546:     Ok(BoundResumeAttempt {\n547:         attempt,\n548:         provider_session_id,\n549:         zero_turn_baseline,\n550:         invocation_env,\n551:     })\n552: }\n553: \n554: fn start_resume_invocation<'state>(\n555:     input: &ResumeAttemptInput<'state>,\n556:     provider: &oulipoly_config::ProviderConfig,\n557:     provider_index: usize,\n558: ) -> Result<ResumeInvocationAttempt<'state>, String> {\n559:     let invocation = mapper::composite_invocation_id(&provider.name);\n560:     let invocation_start = mapper::resume_invocation_start(\n561:         &invocation,\n562:         input.resolved.model_name.as_deref(),\n563:         &provider.name,\n564:         provider_index,\n565:         input.parent_invocation_id,\n566:     );\n567:     let invocation_row_id = input\n568:         .agent_runtime_services\n569:         .invocation_lifecycle_service\n570:         .start_invocation(mapper::invocation_lifecycle_start_request(\n571:             &input.env.state,\n572:             &invocation_start,\n573:         ))\n574:         .map_err(|err| err.to_string())?\n575:         .invocation_row_id;\n576:     let guard = FinalizerGuard::new(&input.env.state, invocation_row_id);\n577:     Ok(ResumeInvocationAttempt {\n578:         invocation,\n579:         invocation_row_id,\n580:         guard,\n581:     })\n582: }\n583: \n584: fn bind_resume_attempt_session(\n585:     input: &ResumeAttemptInput<'_>,\n586:     provider: &oulipoly_config::ProviderConfig,\n587:     invocation_row_id: i64,\n588:     provider_session_id: &str,\n589: ) -> Result<(), String> {\n590:     input.env.state.bind_invocation_provider_session_start(\n591:         invocation_row_id,\n592:         &mapper::resumed_provider_session_binding(\n593:             provider,\n594:             provider_session_id,\n595:             Some(input.session_id.to_string()),\n596:         ),\n597:     )?;\n598:     if should_record_legacy_resume_input(input.manual_migrate) {\n599:         record_legacy_resume_input_session_id(input, invocation_row_id)?;\n600:     }\n601:     Ok(())\n602: }\n603: \n604: fn should_record_legacy_resume_input(manual_migrate: Option<&str>) -> bool {\n605:     manual_migrate.is_some()\n606: }\n607: \n608: fn record_legacy_resume_input_session_id(\n609:     input: &ResumeAttemptInput<'_>,\n610:     invocation_row_id: i64,\n611: ) -> Result<(), String> {\n612:     input\n613:         .env\n614:         .state\n615:         .record_legacy_resume_input_session_id(invocation_row_id, input.session_id)\n616: }\n617: \n618: fn resume_invocation_env(\n619:     invocation: &oulipoly_state::CompositeInvocationId,\n620: ) -> Result<String, String> {\n621:     serde_json::to_string(invocation).map_err(|e| format!(\"Failed to serialize invocation id: {e}\"))\n622: }\n623: \n624: fn apply_resume_attempt_classification(\n625:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n626:     provider_name: &str,\n627:     provider_session_id: &str,\n628:     zero_turn_baseline: &crate::zero_turn_orchestration::ZeroTurnBaseline,\n629:     zero_turn_confirmation: &mut ZeroTurnConfirmationState,\n630:     result: &mut executor::ExecutionResult,\n631: ) -> Result<crate::zero_turn_orchestration::ZeroTurnAction, String> {\n632:     apply_age153_terminal_signal_fixture_override(result);\n633:     let zero_turn_classification =\n634:         zero_turn_classify_after_completion(&env.state, &env.sessions_cfg, zero_turn_baseline);\n635:     apply_zero_turn_classification_to_result(result, provider_name, &zero_turn_classification);\n636:     Ok(next_action(\n637:         zero_turn_confirmation,\n638:         zero_turn_classification_for_action(\n639:             zero_turn_classification,\n640:             result,\n641:             provider_name,\n642:             Some(provider_session_id),\n643:         ),\n644:     ))\n645: }\n646: \n647: fn record_resume_acceptance_if_present(\n648:     input: &ResumeAttemptInput<'_>,\n649:     invocation_row_id: i64,\n650:     result: &executor::ExecutionResult,\n651: ) -> Result<(), String> {\n652:     let Some(acceptance) = resume_acceptance_result(result) else {\n653:         return Ok(());\n654:     };\n655:     record_resume_acceptance(input, invocation_row_id, acceptance)\n656: }\n657: \n658: fn resume_acceptance_result(\n659:     result: &executor::ExecutionResult,\n660: ) -> Option<&oulipoly_runtime::executor::ResumeAcceptanceResult> {\n661:     result.resume_acceptance.as_ref()\n662: }\n663: \n664: fn record_resume_acceptance(\n665:     input: &ResumeAttemptInput<'_>,\n666:     invocation_row_id: i64,\n667:     acceptance: &oulipoly_runtime::executor::ResumeAcceptanceResult,\n668: ) -> Result<(), String> {\n669:     input\n670:         .agent_runtime_services\n671:         .resume_service\n672:         .record_acceptance(mapper::resume_acceptance_request(\n673:             &input.env.state,\n674:             invocation_row_id,\n675:             acceptance,\n676:         ))\n677:         .map_err(format_resume_acceptance_service_error)?;\n678:     Ok(())\n679: }\n680: \n681: fn format_resume_acceptance_service_error(err: oulipoly_runtime::services::ServiceError) -> String {\n682:     format!(\"resume acceptance service failed: {err}\")\n683: }\n684: \n685: fn handle_resume_attempt_terminal_signal(\n686:     input: &ResumeAttemptInput<'_>,\n687:     attempt: &mut ResumeInvocationAttempt<'_>,\n688:     provider: &oulipoly_config::ProviderConfig,\n689:     provider_session_id: &str,\n690:     result: &executor::ExecutionResult,\n691:     zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n692: ) -> Result<ResumeAttemptLoopControl, String> {\n693:     let terminal_signal_disposition = terminal_signal_disposition_for_result(\n694:         &input.env.state,\n695:         &attempt.invocation.id,\n696:         &provider.name,\n697:         provider_session_id,\n698:         result,\n699:         zero_turn_action,\n700:     );\n701: \n702:     let disposition_control = handle_terminal_signal_disposition(ResumeTerminalDispositionInput {\n703:         agent_runtime_services: input.agent_runtime_services,\n704:         env: input.env,\n705:         invocation_row_id: attempt.invocation_row_id,\n706:         guard: &mut attempt.guard,\n707:         result,\n708:         terminal_signal_disposition,\n709:         zero_turn_action,\n710:     })?;\n711:     if let Some(control) = apply_resume_terminal_disposition_outcome(\n712:         input,\n713:         attempt,\n714:         provider_session_id,\n715:         result,\n716:         terminal_disposition_outcome(disposition_control, result),\n717:     )? {\n718:         return Ok(control);\n719:     }\n720: \n721:     ingest_mailbox_delivery_confirmation_turn_if_needed(input, provider, result, zero_turn_action);\n722: \n723:     if let Some(control) = handle_unconfirmed_mailbox_delivery_if_needed(\n724:         input,\n725:         attempt,\n726:         provider,\n727:         provider_session_id,\n728:         result,\n729:         zero_turn_action,\n730:     )? {\n731:         return Ok(control);\n732:     }\n733: \n734:     finalize_completed_attempt_for_resume(input, attempt, provider, provider_session_id, result)\n735: }\n736: \n737: fn ingest_mailbox_delivery_confirmation_turn_if_needed(\n738:     input: &ResumeAttemptInput<'_>,\n739:     provider: &oulipoly_config::ProviderConfig,\n740:     result: &executor::ExecutionResult,\n741:     zero_turn_action: ZeroTurnAction,\n742: ) {\n743:     if !mailbox_delivery_requires_turn_confirmation(input, &provider.name, result) {\n744:         return;\n745:     }\n746:     if mailbox_delivery_turn_confirmed(input, &provider.name, result, zero_turn_action) {\n747:         return;\n748:     }\n749:     let report = sessions::scan_provider_session(\n750:         &provider.name,\n751:         &input.env.sessions_cfg,\n752:         &input.env.state,\n753:         &input.resolved.active_session_id,\n754:     );\n755:     emit_pre_confirmation_session_scan_errors(&provider.name, report.errors);\n756: }\n757: \n758: fn emit_pre_confirmation_session_scan_errors(provider_name: &str, errors: Vec<String>) {\n759:     for error in errors {\n760:         formatter::emit_stderr(&format!(\n761:             \"Warning: Session ingest failed for {provider_name}: {error}\"\n762:         ));\n763:     }\n764: }\n765: \n766: enum ResumeTerminalDispositionOutcome {\n767:     Continue(i32),\n768:     Return(i32),\n769:     CompletedAttempt,\n770: }\n771: \n772: fn terminal_disposition_outcome(\n773:     control: ResumeLoopControl,\n774:     result: &executor::ExecutionResult,\n775: ) -> ResumeTerminalDispositionOutcome {\n776:     match control {\n777:         ResumeLoopControl::Continue => ResumeTerminalDispositionOutcome::Continue(result.exit_code),\n778:         ResumeLoopControl::Return(exit_code) => ResumeTerminalDispositionOutcome::Return(exit_code),\n779:         ResumeLoopControl::CompletedAttempt => ResumeTerminalDispositionOutcome::CompletedAttempt,\n780:     }\n781: }\n782: \n783: fn apply_resume_terminal_disposition_outcome(\n784:     input: &ResumeAttemptInput<'_>,\n785:     attempt: &ResumeInvocationAttempt<'_>,\n786:     provider_session_id: &str,\n787:     result: &executor::ExecutionResult,\n788:     outcome: ResumeTerminalDispositionOutcome,\n789: ) -> Result<Option<ResumeAttemptLoopControl>, String> {\n790:     match outcome {\n791:         ResumeTerminalDispositionOutcome::Continue(exit_code) => {\n792:             record_failed_mailbox_delivery_attempt(\n793:                 input,\n794:                 &failed_delivery_error(result, \"resume_retry\"),\n795:             )?;\n796:             mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n797:             Ok(Some(ResumeAttemptLoopControl::Continue(exit_code)))\n798:         }\n799:         ResumeTerminalDispositionOutcome::Return(exit_code) => {\n800:             record_failed_mailbox_delivery_attempt(\n801:                 input,\n802:                 &failed_delivery_error(result, \"resume_failed\"),\n803:             )?;\n804:             mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n805:             Ok(Some(ResumeAttemptLoopControl::Return(exit_code)))\n806:         }\n807:         ResumeTerminalDispositionOutcome::CompletedAttempt => Ok(None),\n808:     }\n809: }\n810: \n811: fn handle_unconfirmed_mailbox_delivery_if_needed(\n812:     input: &ResumeAttemptInput<'_>,\n813:     attempt: &mut ResumeInvocationAttempt<'_>,\n814:     provider: &oulipoly_config::ProviderConfig,\n815:     provider_session_id: &str,\n816:     result: &executor::ExecutionResult,\n817:     zero_turn_action: ZeroTurnAction,\n818: ) -> Result<Option<ResumeAttemptLoopControl>, String> {\n819:     if !mailbox_delivery_unconfirmed(input, &provider.name, result, zero_turn_action) {\n820:         return Ok(None);\n821:     }\n822:     record_failed_mailbox_delivery_attempt(input, \"mailbox_delivery_unconfirmed\")?;\n823:     finalize_unconfirmed_mailbox_delivery(input, attempt, result)?;\n824:     mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(1))?;\n825:     Ok(Some(ResumeAttemptLoopControl::Return(1)))\n826: }\n827: \n828: fn finalize_completed_attempt_for_resume(\n829:     input: &ResumeAttemptInput<'_>,\n830:     attempt: &mut ResumeInvocationAttempt<'_>,\n831:     provider: &oulipoly_config::ProviderConfig,\n832:     provider_session_id: &str,\n833:     result: &executor::ExecutionResult,\n834: ) -> Result<ResumeAttemptLoopControl, String> {\n835:     match finalize_completed_attempt(CompletedAttemptInput {\n836:         agent_runtime_services: input.agent_runtime_services,\n837:         env: input.env,\n838:         invocation: &attempt.invocation,\n839:         invocation_row_id: attempt.invocation_row_id,\n840:         guard: &mut attempt.guard,\n841:         provider_name: &provider.name,\n842:         model: input.resolved.model.as_ref(),\n843:         result,\n844:         working_dir: input.working_dir,\n845:         manual_migrate: input.manual_migrate,\n846:         session_id: input.session_id,\n847:         active_session_id: &input.resolved.active_session_id,\n848:         effective_spawn_cwd: input.effective_spawn_cwd,\n849:         attempts: input.attempts,\n850:         max_attempts: input.max_attempts,\n851:     })? {\n852:         CompletedAttemptControl::Continue => {\n853:             record_failed_mailbox_delivery_attempt(\n854:                 input,\n855:                 &failed_delivery_error(result, \"quota_exhausted\"),\n856:             )?;\n857:             mark_resume_attempt_idle(\n858:                 provider_session_id,\n859:                 &attempt.invocation.id,\n860:                 Some(result.exit_code),\n861:             )?;\n862:             Ok(ResumeAttemptLoopControl::Continue(result.exit_code))\n863:         }\n864:         CompletedAttemptControl::Return(exit_code) => {\n865:             if exit_code == 0 {\n866:                 crate::mailbox_delivery::mark_headless_resume_delivered(\n867:                     input.mailbox_session_id,\n868:                     input.mailbox_delivery_seqs,\n869:                     &attempt.invocation.id,\n870:                 )?;\n871:                 let _ = crate::wake_coordinator::mark_successful_turn_idle_and_recheck(\n872:                     provider_session_id,\n873:                     &attempt.invocation.id,\n874:                     exit_code,\n875:                 )?;\n876:             } else {\n877:                 record_failed_mailbox_delivery_attempt(\n878:                     input,\n879:                     &failed_delivery_error(result, \"resume_failed\"),\n880:                 )?;\n881:                 mark_resume_attempt_idle(\n882:                     provider_session_id,\n883:                     &attempt.invocation.id,\n884:                     Some(exit_code),\n885:                 )?;\n886:             }\n887:             Ok(ResumeAttemptLoopControl::Return(exit_code))\n888:         }\n889:     }\n890: }\n891: \n892: fn mailbox_delivery_unconfirmed(\n893:     input: &ResumeAttemptInput<'_>,\n894:     provider_name: &str,\n895:     result: &executor::ExecutionResult,\n896:     zero_turn_action: ZeroTurnAction,\n897: ) -> bool {\n898:     mailbox_delivery_requires_turn_confirmation(input, provider_name, result)\n899:         && !mailbox_delivery_turn_confirmed(input, provider_name, result, zero_turn_action)\n900: }\n901: \n902: fn mailbox_delivery_requires_turn_confirmation(\n903:     input: &ResumeAttemptInput<'_>,\n904:     provider_name: &str,\n905:     result: &executor::ExecutionResult,\n906: ) -> bool {\n907:     result.exit_code == 0\n908:         && !input.mailbox_delivery_seqs.is_empty()\n909:         && input.answer.is_some_and(|answer| !answer.trim().is_empty())\n910:         && input.env.sessions_cfg.get(provider_name).is_some()\n911: }\n912: \n913: fn mailbox_delivery_turn_confirmed(\n914:     input: &ResumeAttemptInput<'_>,\n915:     provider_name: &str,\n916:     result: &executor::ExecutionResult,\n917:     zero_turn_action: ZeroTurnAction,\n918: ) -> bool {\n919:     matches!(zero_turn_action, ZeroTurnAction::Continue)\n920:         || submitted_user_turn_confirms_mailbox_delivery(input, result)\n921:         || ingested_user_turn_confirms_mailbox_delivery(input, provider_name)\n922: }\n923: \n924: fn submitted_user_turn_confirms_mailbox_delivery(\n925:     input: &ResumeAttemptInput<'_>,\n926:     result: &executor::ExecutionResult,\n927: ) -> bool {\n928:     let Some(submitted) = result.submitted_user_turn.as_ref() else {\n929:         return false;\n930:     };\n931:     let Some(answer) = input.answer else {\n932:         return false;\n933:     };\n934:     submitted.provider_session_id == input.resolved.active_session_id\n935:         && submitted_user_turn_payload_confirms_mailbox_delivery(input, submitted, answer)\n936: }\n937: \n938: fn submitted_user_turn_payload_confirms_mailbox_delivery(\n939:     input: &ResumeAttemptInput<'_>,\n940:     submitted: &executor::SubmittedUserTurn,\n941:     answer: &str,\n942: ) -> bool {\n943:     if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n944:         return submitted.delivery_nonce.as_deref() == Some(delivery_nonce);\n945:     }\n946:     submitted.prompt_sha256 == sha256_hex(answer.as_bytes())\n947: }\n948: \n949: fn ingested_user_turn_confirms_mailbox_delivery(\n950:     input: &ResumeAttemptInput<'_>,\n951:     provider_name: &str,\n952: ) -> bool {\n953:     if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n954:         return input\n955:             .env\n956:             .state\n957:             .has_session_user_turn_containing(\n958:                 provider_name,\n959:                 &input.resolved.active_session_id,\n960:                 delivery_nonce,\n961:             )\n962:             .unwrap_or(false);\n963:     }\n964: \n965:     let Some(answer) = input.answer else {\n966:         return false;\n967:     };\n968:     input\n969:         .env\n970:         .state\n971:         .has_session_user_text_turn(provider_name, &input.resolved.active_session_id, answer)\n972:         .unwrap_or(false)\n973: }\n974: \n975: fn sha256_hex(bytes: &[u8]) -> String {\n976:     let digest = Sha256::digest(bytes);\n977:     digest.iter().map(|byte| format!(\"{byte:02x}\")).collect()\n978: }\n979: \n980: fn finalize_unconfirmed_mailbox_delivery(\n981:     input: &ResumeAttemptInput<'_>,\n982:     attempt: &mut ResumeInvocationAttempt<'_>,\n983:     result: &executor::ExecutionResult,\n984: ) -> Result<(), String> {\n985:     formatter::emit_stderr(\n986:         \"resume mailbox delivery was not confirmed by a new session turn; leaving mailbox rows pending\",\n987:     );\n988:     input\n989:         .agent_runtime_services\n990:         .invocation_lifecycle_service\n991:         .finalize_invocation(mapper::finalize_request(\n992:             &input.env.state,\n993:             attempt.invocation_row_id,\n994:             false,\n995:             1,\n996:             Some(\"mailbox_delivery_unconfirmed\"),\n997:             result.terminal_reason.as_deref(),\n998:         ))\n999:         .map_err(|err| err.to_string())?;\n1000:     attempt.guard.mark_finalized();\n1001:     Ok(())\n1002: }\n1003: \n1004: fn record_failed_mailbox_delivery_attempt(\n1005:     input: &ResumeAttemptInput<'_>,\n1006:     delivery_error: &str,\n1007: ) -> Result<(), String> {\n1008:     crate::mailbox_delivery::mark_headless_resume_delivery_failed(\n1009:         input.mailbox_session_id,\n1010:         input.mailbox_delivery_seqs,\n1011:         delivery_error,\n1012:     )\n1013: }\n1014: \n1015: fn failed_delivery_error(result: &executor::ExecutionResult, fallback: &str) -> String {\n1016:     terminal_signal_reason(&result.terminal_signal, result.terminal_reason.as_deref())\n1017:         .or(result.terminal_reason.as_deref())\n1018:         .unwrap_or(fallback)\n1019:         .to_string()\n1020: }\n1021: \n1022: fn mark_resume_attempt_idle(\n1023:     provider_session_id: &str,\n1024:     invocation_uuid: &str,\n1025:     exit_code: Option<i32>,\n1026: ) -> Result<(), String> {\n1027:     crate::wake_coordinator::mark_session_idle_after_turn(\n1028:         provider_session_id,\n1029:         invocation_uuid,\n1030:         exit_code,\n1031:     )\n1032: }\n1033: \n1034: fn resolve_resume_for_headless_execution(\n1035:     agent_runtime_services: &wiring::AgentRuntimeServices,\n1036:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n1037:     session_id: &str,\n1038:     model_name: Option<&str>,\n1039: ) -> Result<oulipoly_state::ResolvedResume, i32> {\n1040:     let output = agent_runtime_services\n1041:         .resume_service\n1042:         .resolve_resume(mapper::resume_service_request(env, session_id, model_name))\n1043:         .map_err(|err| err.to_string());\n1044:     headless_resume_resolution_result(output, env, session_id, model_name)\n1045: }\n1046: \n1047: fn headless_resume_resolution_result(\n1048:     output: Result<ResumeServiceOutput, String>,\n1049:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n1050:     session_id: &str,\n1051:     model_name: Option<&str>,\n1052: ) -> Result<oulipoly_state::ResolvedResume, i32> {\n1053:     match map_headless_resume_resolution(output) {\n1054:         HeadlessResumeResolution::Resolved(resolved) => Ok(resolved),\n1055:         resolution => {\n1056:             render_headless_resume_resolution_error(resolution, env, session_id, model_name);\n1057:             Err(1)\n1058:         }\n1059:     }\n1060: }\n1061: \n1062: enum HeadlessResumeResolution {\n1063:     Resolved(oulipoly_state::ResolvedResume),\n1064:     ProviderModelMismatch { active_provider: String },\n1065:     Rejected(oulipoly_state::ResumeError),\n1066:     ServiceFailure(String),\n1067: }\n1068: \n1069: fn map_headless_resume_resolution(\n1070:     output: Result<ResumeServiceOutput, String>,\n1071: ) -> HeadlessResumeResolution {\n1072:     match output {\n1073:         Ok(ResumeServiceOutput::ResumeResolved { resolved }) => {\n1074:             HeadlessResumeResolution::Resolved(resolved)\n1075:         }\n1076:         Ok(ResumeServiceOutput::ResumeRejected {\n1077:             error:\n1078:                 oulipoly_state::ResumeError::ProviderModelMismatch {\n1079:                     active_provider, ..\n1080:                 },\n1081:         }) => HeadlessResumeResolution::ProviderModelMismatch { active_provider },\n1082:         Ok(ResumeServiceOutput::ResumeRejected { error }) => {\n1083:             HeadlessResumeResolution::Rejected(error)\n1084:         }\n1085:         Err(err) => HeadlessResumeResolution::ServiceFailure(err),\n1086:     }\n1087: }\n1088: \n1089: fn render_headless_resume_resolution_error(\n1090:     resolution: HeadlessResumeResolution,\n1091:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n1092:     session_id: &str,\n1093:     model_name: Option<&str>,\n1094: ) {\n1095:     match resolution {\n1096:         HeadlessResumeResolution::ProviderModelMismatch { active_provider } => {\n1097:             render_resume_model_pool_mismatch(\n1098:                 &env.models,\n1099:                 model_name.unwrap_or(\"<unknown>\"),\n1100:                 session_id,\n1101:                 &active_provider,\n1102:             );\n1103:         }\n1104:         HeadlessResumeResolution::Rejected(error) => render_resume_error(error),\n1105:         HeadlessResumeResolution::ServiceFailure(err) => render_resume_service_failure(&err),\n1106:         HeadlessResumeResolution::Resolved(_) => {}\n1107:     }\n1108: }\n1109: \n1110: fn render_resume_error(error: oulipoly_state::ResumeError) {\n1111:     formatter::emit_stderr(&format_resume_error(error));\n1112: }\n1113: \n1114: fn render_resume_service_failure(error: &str) {\n1115:     formatter::emit_stderr(&format!(\"resume service failed: {error}\"));\n1116: }\n1117: \n1118: fn prepare_initial_headless_resume_target(\n1119:     resolved: &oulipoly_state::ResolvedResume,\n1120:     providers_cfg: &oulipoly_config::ProvidersConfig,\n1121:     stderr_is_terminal: bool,\n1122: ) -> Result<(), i32> {\n1123:     let target = renderable_resume_execution_target(resolved, providers_cfg)?;\n1124:     render_resume_short_line_if_needed(stderr_is_terminal, &resolved.active_provider);\n1125:     validate_headless_resume_target(resolved, &target, &resolved.active_provider)\n1126: }\n1127: \n1128: fn render_resume_short_line_if_needed(stderr_is_terminal: bool, selected_provider: &str) {\n1129:     if crate::dispatch::should_emit_resume_short_line(stderr_is_terminal) {\n1130:         formatter::emit_resume_short_line(selected_provider);\n1131:     }\n1132: }\n1133: \n1134: fn validate_headless_resume_target(\n1135:     resolved: &oulipoly_state::ResolvedResume,\n1136:     target: &crate::resume_cli::ResumeExecutionTarget,\n1137:     selected_provider: &str,\n1138: ) -> Result<(), i32> {\n1139:     if resolved_uses_provider_ref(resolved) {\n1140:         return validate_provider_ref_headless_resume_target(resolved, target, selected_provider)\n1141:             .map_err(|message| provider_ref_resume_block_exit_code(&message));\n1142:     }\n1143:     if headless_resume_target_has_resume(target) {\n1144:         Ok(())\n1145:     } else {\n1146:         Err(headless_missing_resume_block_exit_code(selected_provider))\n1147:     }\n1148: }\n1149: \n1150: fn validate_provider_ref_headless_resume_target(\n1151:     resolved: &oulipoly_state::ResolvedResume,\n1152:     target: &crate::resume_cli::ResumeExecutionTarget,\n1153:     selected_provider: &str,\n1154: ) -> Result<(), String> {\n1155:     let model = require_provider_ref_resolved_model(\n1156:         provider_ref_resolved_model(resolved),\n1157:         selected_provider,\n1158:     )?;\n1159:     require_provider_ref_model_implementation(model, selected_provider)?;\n1160:     let target_member_name = require_provider_ref_target_member_name(\n1161:         provider_ref_target_member_name(model, target.provider_index),\n1162:         selected_provider,\n1163:         target.provider_index,\n1164:     )?;\n1165:     require_provider_ref_resolved_provider(selected_provider, target_member_name)?;\n1166:     require_provider_ref_loaded_provider(\n1167:         selected_provider,\n1168:         provider_ref_loaded_provider_name(target),\n1169:     )\n1170: }\n1171: \n1172: fn require_provider_ref_resolved_model<'a>(\n1173:     model: Option<&'a oulipoly_config::ModelConfig>,\n1174:     selected_provider: &str,\n1175: ) -> Result<&'a oulipoly_config::ModelConfig, String> {\n1176:     model.ok_or_else(|| provider_ref_missing_model_message(selected_provider))\n1177: }\n1178: \n1179: fn require_provider_ref_model_implementation(\n1180:     model: &oulipoly_config::ModelConfig,\n1181:     selected_provider: &str,\n1182: ) -> Result<(), String> {\n1183:     if provider_ref_model_has_implementation(model) {\n1184:         Ok(())\n1185:     } else {\n1186:         Err(provider_ref_missing_implementation_message(\n1187:             selected_provider,\n1188:         ))\n1189:     }\n1190: }\n1191: \n1192: fn require_provider_ref_target_member_name<'a>(\n1193:     target_member_name: Option<&'a str>,\n1194:     selected_provider: &str,\n1195:     provider_index: usize,\n1196: ) -> Result<&'a str, String> {\n1197:     target_member_name\n1198:         .ok_or_else(|| provider_ref_invalid_index_message(selected_provider, provider_index))\n1199: }\n1200: \n\n(Showing lines 1-1200 of 1545. Use offset=1201 to continue.)\n</content>","metadata":{"preview":"//! ## Declared roles\n//!\n//! `orchestration`, `validator`, `accessor`, `mapper`, `filter`, `predicate`, `formatter`\n\nuse std::collections::HashMap;\nuse std::io::IsTerminal;\nuse std::path::Path;\nuse std::sync::Arc;\n\nuse oulipoly_runtime::provider_registry::{ProviderRegistry, ProviderRegistryOptions};\nuse oulipoly_runtime::services::{\n    ExecutorServiceRequest, InvocationLifecycleServicePort, MigrationServiceOutput,\n    ResumeServiceOutput, ServiceError,\n};\nuse oulipoly_runtime::{executor, sessions};\nuse sha2::{Digest, Sha256};\n\nuse super::disposition::{\n    ResumeLoopControl, ResumeTerminalDispositionInput, confirmed_zero_turn_maybe_quota,\n    handle_terminal_signal_disposition,","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/run/resume/orchestration.rs","text":"//! ## Declared roles\n//!\n//! `orchestration`, `validator`, `accessor`, `mapper`, `filter`, `predicate`, `formatter`\n\nuse std::collections::HashMap;\nuse std::io::IsTerminal;\nuse std::path::Path;\nuse std::sync::Arc;\n\nuse oulipoly_runtime::provider_registry::{ProviderRegistry, ProviderRegistryOptions};\nuse oulipoly_runtime::services::{\n    ExecutorServiceRequest, InvocationLifecycleServicePort, MigrationServiceOutput,\n    ResumeServiceOutput, ServiceError,\n};\nuse oulipoly_runtime::{executor, sessions};\nuse sha2::{Digest, Sha256};\n\nuse super::disposition::{\n    ResumeLoopControl, ResumeTerminalDispositionInput, confirmed_zero_turn_maybe_quota,\n    handle_terminal_signal_disposition,\n};\nuse super::finalization::{\n    CompletedAttemptControl, CompletedAttemptInput, finalize_completed_attempt,\n};\nuse super::{formatter, mapper, validator};\nuse crate::captured_child::emit_captured_child_marker_lines;\nuse crate::cli::inputs::resolve_resume_answer;\nuse crate::invocation::finalize::FinalizerGuard;\nuse crate::migration_providers::load_resume_execution_environment;\nuse crate::quota_zero_turn::{\n    apply_zero_turn_classification_to_result, filter_quota_exhausted_migration_candidates,\n    zero_turn_classification_for_action, zero_turn_classify_after_completion,\n    zero_turn_record_baseline,\n};\nuse crate::resume_cli::{\n    format_resume_error, render_resume_model_pool_mismatch, renderable_resume_execution_target,\n    resume_migration_pool,\n};\nuse crate::spawn_cwd::effective_resume_spawn_cwd;\nuse crate::terminal_outcome_adapter::{\n    TerminalSignalDisposition, apply_age153_terminal_signal_fixture_override,\n    confirm_maybe_quota_exhausted, resume_terminal_signal_for_outcome, terminal_signal_reason,\n};\nuse crate::wiring;\nuse crate::zero_turn_orchestration::{ZeroTurnAction, ZeroTurnConfirmationState, next_action};\n\n#[allow(clippy::too_many_arguments)]\npub(crate) fn run_resume(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    model_name: Option<&str>,\n    session_id: &str,\n    manual_migrate: Option<&str>,\n    prompt: Option<&str>,\n    file: Option<&Path>,\n    working_dir: Option<&Path>,\n    models_dir_override: Option<&Path>,\n) -> Result<i32, String> {\n    if let Some(exit_code) = reject_invalid_resume_input(session_id) {\n        return Ok(exit_code);\n    }\n    if let Some(exit_code) = crate::wake_coordinator::validate_auto_wake_child(session_id)? {\n        return Ok(exit_code);\n    }\n    if !crate::wake_coordinator::is_auto_wake_invocation() {\n        crate::wake_coordinator::reset_manual_resume_wake_claim(session_id)?;\n    }\n    // Source guard marker: agent_runtime_services.resume_service.resolve_resume(ResumeServiceRequest)\n\n    let mut prepared = match prepare_headless_resume_execution(\n        agent_runtime_services,\n        model_name,\n        session_id,\n        prompt,\n        file,\n        working_dir,\n        models_dir_override,\n    )? {\n        Ok(prepared) => prepared,\n        Err(exit_code) => {\n            crate::wake_coordinator::release_current_auto_wake_claim_for_session(session_id);\n            return Ok(exit_code);\n        }\n    };\n    let result = run_resume_loop(ResumeLoopInput {\n        agent_runtime_services,\n        prepared: &mut prepared,\n        manual_migrate,\n        session_id,\n        working_dir,\n    });\n    if failed_auto_wake_exit(&result) {\n        let _ = crate::wake_coordinator::recheck_after_failed_auto_wake(session_id);\n    }\n    result\n}\n\nfn failed_auto_wake_exit(result: &Result<i32, String>) -> bool {\n    crate::wake_coordinator::is_auto_wake_invocation() && !matches!(result, Ok(0))\n}\n\nfn reject_invalid_resume_input(session_id: &str) -> Option<i32> {\n    match validator::validate_resume_input(session_id) {\n        Ok(()) => None,\n        Err(message) => {\n            formatter::emit_stderr(&message);\n            Some(1)\n        }\n    }\n}\n\nstruct PreparedHeadlessResumeExecution {\n    answer: Option<String>,\n    mailbox_session_id: String,\n    mailbox_delivery_seqs: Vec<i64>,\n    mailbox_delivery_nonce: Option<String>,\n    env: crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: oulipoly_state::ResolvedResume,\n    effective_spawn_cwd: std::path::PathBuf,\n    parent_invocation_id: Option<i64>,\n    max_attempts: usize,\n}\n\n#[allow(clippy::too_many_arguments)]\nfn prepare_headless_resume_execution(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    model_name: Option<&str>,\n    session_id: &str,\n    prompt: Option<&str>,\n    file: Option<&Path>,\n    working_dir: Option<&Path>,\n    models_dir_override: Option<&Path>,\n) -> Result<Result<PreparedHeadlessResumeExecution, i32>, String> {\n    let answer = resolve_resume_answer(prompt, file)?;\n    let env = load_resume_execution_environment(models_dir_override)?;\n    refresh_resume_provider_registry(agent_runtime_services, &env)?;\n    let resolved = match resolve_resume_for_headless_execution(\n        agent_runtime_services,\n        &env,\n        session_id,\n        model_name,\n    ) {\n        Ok(resolved) => resolved,\n        Err(exit_code) => return Ok(Err(exit_code)),\n    };\n    if let Err(exit_code) = prepare_initial_headless_resume_target(\n        &resolved,\n        &env.providers_cfg,\n        std::io::stderr().is_terminal(),\n    ) {\n        return Ok(Err(exit_code));\n    }\n    let effective_spawn_cwd = effective_resume_execution_cwd(&env, session_id, working_dir)?;\n    let parent_invocation_id = crate::dispatch::resolve_parent_invocation_id(&env.state);\n    let max_attempts = headless_resume_retry_budget(&resolved);\n    let mailbox_delivery = crate::mailbox_delivery::prepare_headless_resume_delivery(\n        &resolved,\n        answer,\n        Some(&env.models_dir),\n    )?;\n    Ok(Ok(PreparedHeadlessResumeExecution {\n        answer: mailbox_delivery.answer,\n        mailbox_session_id: mailbox_delivery.session_id,\n        mailbox_delivery_seqs: mailbox_delivery.seqs,\n        mailbox_delivery_nonce: mailbox_delivery.delivery_nonce,\n        env,\n        resolved,\n        effective_spawn_cwd,\n        parent_invocation_id,\n        max_attempts,\n    }))\n}\n\nfn refresh_resume_provider_registry(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n) -> Result<(), String> {\n    let models = env.models.values().cloned().collect::<Vec<_>>();\n    let registry =\n        ProviderRegistry::from_model_configs(&models, resume_provider_registry_options(env))\n            .map_err(|err| format!(\"failed to build resume provider registry: {err}\"))?;\n    agent_runtime_services\n        .provider_registry_handle\n        .replace(Arc::new(registry));\n    Ok(())\n}\n\nfn resume_provider_registry_options(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n) -> ProviderRegistryOptions {\n    ProviderRegistryOptions::default()\n        .with_path_entries_from_process_path()\n        .with_config_root(env.config_root.clone())\n        .with_data_root(resume_provider_registry_data_root(env))\n}\n\nfn resume_provider_registry_data_root(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n) -> std::path::PathBuf {\n    oulipoly_state::paths::data_dir().unwrap_or_else(|_| env.config_root.clone())\n}\n\nfn effective_resume_execution_cwd(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    session_id: &str,\n    working_dir: Option<&Path>,\n) -> Result<std::path::PathBuf, String> {\n    effective_resume_spawn_cwd(\n        &env.state,\n        &env.models,\n        &env.providers_cfg,\n        &env.sessions_cfg,\n        session_id,\n        working_dir,\n    )\n}\n\nfn headless_resume_retry_budget(resolved: &oulipoly_state::ResolvedResume) -> usize {\n    resolved\n        .model\n        .as_ref()\n        .map(|model| model.providers.len())\n        .unwrap_or(1)\n        .max(1)\n        + 1\n}\n\nstruct ResumeLoopInput<'a> {\n    agent_runtime_services: &'a wiring::AgentRuntimeServices,\n    prepared: &'a mut PreparedHeadlessResumeExecution,\n    manual_migrate: Option<&'a str>,\n    session_id: &'a str,\n    working_dir: Option<&'a Path>,\n}\n\nfn run_resume_loop(input: ResumeLoopInput<'_>) -> Result<i32, String> {\n    let mut attempts = 0usize;\n    let mut last_exit_code = 1;\n    let mut zero_turn_confirmation = ZeroTurnConfirmationState::new();\n\n    loop {\n        if resume_attempts_exhausted(attempts, input.prepared.max_attempts) {\n            return Ok(resume_attempts_exhausted_exit_code(last_exit_code));\n        }\n        attempts += 1;\n\n        match run_resume_attempt(ResumeAttemptInput {\n            agent_runtime_services: input.agent_runtime_services,\n            env: &input.prepared.env,\n            resolved: &mut input.prepared.resolved,\n            answer: input.prepared.answer.as_deref(),\n            mailbox_session_id: &input.prepared.mailbox_session_id,\n            mailbox_delivery_seqs: &input.prepared.mailbox_delivery_seqs,\n            mailbox_delivery_nonce: input.prepared.mailbox_delivery_nonce.as_deref(),\n            manual_migrate: input.manual_migrate,\n            session_id: input.session_id,\n            working_dir: input.working_dir,\n            attempts,\n            max_attempts: input.prepared.max_attempts,\n            parent_invocation_id: input.prepared.parent_invocation_id,\n            effective_spawn_cwd: &input.prepared.effective_spawn_cwd,\n            zero_turn_confirmation: &mut zero_turn_confirmation,\n        })? {\n            ResumeAttemptLoopControl::Continue(exit_code) => {\n                last_exit_code = exit_code;\n                continue;\n            }\n            ResumeAttemptLoopControl::Return(exit_code) => return Ok(exit_code),\n        }\n    }\n}\n\nfn resume_attempts_exhausted(attempts: usize, max_attempts: usize) -> bool {\n    attempts >= max_attempts\n}\n\nfn resume_attempts_exhausted_exit_code(last_exit_code: i32) -> i32 {\n    formatter::emit_stderr(\"BLOCKED:all-providers-exhausted\");\n    normalized_resume_exhausted_exit_code(last_exit_code)\n}\n\nfn normalized_resume_exhausted_exit_code(last_exit_code: i32) -> i32 {\n    if last_exit_code == 0 {\n        1\n    } else {\n        last_exit_code\n    }\n}\n\nstruct ResumeAttemptInput<'a> {\n    agent_runtime_services: &'a wiring::AgentRuntimeServices,\n    env: &'a crate::migration_providers::ResumeExecutionEnvironment,\n    resolved: &'a mut oulipoly_state::ResolvedResume,\n    answer: Option<&'a str>,\n    mailbox_session_id: &'a str,\n    mailbox_delivery_seqs: &'a [i64],\n    mailbox_delivery_nonce: Option<&'a str>,\n    manual_migrate: Option<&'a str>,\n    session_id: &'a str,\n    working_dir: Option<&'a Path>,\n    attempts: usize,\n    max_attempts: usize,\n    parent_invocation_id: Option<i64>,\n    effective_spawn_cwd: &'a Path,\n    zero_turn_confirmation: &'a mut ZeroTurnConfirmationState,\n}\n\nenum ResumeAttemptLoopControl {\n    Continue(i32),\n    Return(i32),\n}\n\nfn run_resume_attempt(\n    mut input: ResumeAttemptInput<'_>,\n) -> Result<ResumeAttemptLoopControl, String> {\n    let target = match prepare_resume_attempt_target(&mut input)? {\n        Ok(target) => target,\n        Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n    };\n    let provider_index = target.provider_index;\n    let provider = target.provider;\n    let strategy = match resume_attempt_strategy_for_target(input.resolved, &provider) {\n        Ok(strategy) => strategy,\n        Err(exit_code) => return Ok(ResumeAttemptLoopControl::Return(exit_code)),\n    };\n\n    let mut bound_attempt = setup_bound_resume_attempt(&input, &provider, provider_index)?;\n\n    let mut result = match execute_resume_attempt_command(\n        &input,\n        &provider,\n        provider_index,\n        target.prompt_mode,\n        &bound_attempt.invocation_env,\n        strategy,\n    ) {\n        Ok(result) => result,\n        Err(_spawn_err) => return handle_resume_attempt_spawn_error(&input, &mut bound_attempt),\n    };\n\n    handle_resume_attempt_result(&mut input, &mut bound_attempt, &provider, &mut result)\n}\n\nfn handle_resume_attempt_spawn_error(\n    input: &ResumeAttemptInput<'_>,\n    bound_attempt: &mut BoundResumeAttempt<'_>,\n) -> Result<ResumeAttemptLoopControl, String> {\n    record_failed_mailbox_delivery_attempt(input, \"resume_spawn_error\")?;\n    finalize_resume_spawn_error(input, &mut bound_attempt.attempt)?;\n    Ok(ResumeAttemptLoopControl::Return(1))\n}\n\nfn handle_resume_attempt_result(\n    input: &mut ResumeAttemptInput<'_>,\n    bound_attempt: &mut BoundResumeAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    result: &mut executor::ExecutionResult,\n) -> Result<ResumeAttemptLoopControl, String> {\n    apply_resume_attempt_classification(\n        input.env,\n        &provider.name,\n        &bound_attempt.provider_session_id,\n        &bound_attempt.zero_turn_baseline,\n        input.zero_turn_confirmation,\n        result,\n    )\n    .and_then(|zero_turn_action| {\n        record_resume_acceptance_if_present(\n            input,\n            bound_attempt.attempt.invocation_row_id,\n            result,\n        )?;\n        emit_captured_child_marker_lines(&result.captured_child_invocations);\n        handle_resume_attempt_terminal_signal(\n            input,\n            &mut bound_attempt.attempt,\n            provider,\n            &bound_attempt.provider_session_id,\n            result,\n            zero_turn_action,\n        )\n    })\n}\n\nfn resume_attempt_strategy_for_target<'a>(\n    resolved: &oulipoly_state::ResolvedResume,\n    provider: &'a oulipoly_config::ProviderConfig,\n) -> Result<Option<&'a oulipoly_config::ResumeStrategy>, i32> {\n    if resolved_uses_provider_ref(resolved) {\n        return Ok(None);\n    }\n    resume_attempt_strategy(provider).map(Some)\n}\n\nfn resume_attempt_strategy(\n    provider: &oulipoly_config::ProviderConfig,\n) -> Result<&oulipoly_config::ResumeStrategy, i32> {\n    provider\n        .resume\n        .as_ref()\n        .ok_or_else(|| missing_resume_block_exit_code(&provider.name))\n}\n\nfn missing_resume_block_exit_code(provider_name: &str) -> i32 {\n    formatter::emit_missing_resume_block(provider_name);\n    1\n}\n\nfn execute_resume_attempt_command(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_index: usize,\n    prompt_mode: oulipoly_config::PromptMode,\n    invocation_env: &str,\n    strategy: Option<&oulipoly_config::ResumeStrategy>,\n) -> Result<executor::ExecutionResult, String> {\n    if let Some(request) = provider_ref_resume_executor_request(\n        input,\n        provider,\n        provider_index,\n        prompt_mode,\n        invocation_env,\n    ) {\n        return input\n            .agent_runtime_services\n            .executor_service\n            .execute(request)\n            .map(|output| output.result)\n            .map_err(|err| err.to_string());\n    }\n    executor::cli::execute_resume_optional_prompt_with_model_identity(\n        provider,\n        provider_index,\n        prompt_mode,\n        input.answer,\n        Some(input.effective_spawn_cwd),\n        Some(invocation_env),\n        executor::cli::ResumePayload {\n            session_id: &input.resolved.active_session_id,\n            strategy: strategy.expect(\"legacy resume target must have a resume strategy\"),\n        },\n        input.resolved.model_name.as_deref().unwrap_or(\"<unknown>\"),\n    )\n}\n\nfn provider_ref_resume_executor_request(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_index: usize,\n    prompt_mode: oulipoly_config::PromptMode,\n    invocation_env: &str,\n) -> Option<ExecutorServiceRequest> {\n    let model = input.resolved.model.as_ref()?;\n    model.provider.as_ref()?;\n    Some(\n        ExecutorServiceRequest::EffectiveWithStartKnownProviderSessionId {\n            model: model.clone(),\n            provider: provider.clone(),\n            provider_index,\n            prompt_mode,\n            prompt: input.answer.unwrap_or_default().to_string(),\n            working_dir: Some(input.effective_spawn_cwd.to_path_buf()),\n            extra_inputs: HashMap::new(),\n            parent_invocation_env: Some(invocation_env.to_string()),\n            start_known_provider_session_id: input.resolved.active_session_id.clone(),\n        },\n    )\n}\n\nfn finalize_resume_spawn_error(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n) -> Result<(), String> {\n    input\n        .agent_runtime_services\n        .invocation_lifecycle_service\n        .finalize_invocation(mapper::spawn_error_finalize_request(\n            &input.env.state,\n            attempt.invocation_row_id,\n        ))\n        .map_err(|err| err.to_string())?;\n    attempt.guard.mark_finalized();\n    mark_resume_attempt_idle(\n        &input.resolved.active_session_id,\n        &attempt.invocation.id,\n        Some(1),\n    )?;\n    Ok(())\n}\n\nfn prepare_resume_attempt_target(\n    input: &mut ResumeAttemptInput<'_>,\n) -> Result<Result<crate::resume_cli::ResumeExecutionTarget, i32>, String> {\n    let mut target =\n        match renderable_resume_execution_target(input.resolved, &input.env.providers_cfg) {\n            Ok(target) => target,\n            Err(exit_code) => return Ok(Err(exit_code)),\n        };\n    if let Err(exit_code) = migrate_resume_target(\n        input.agent_runtime_services,\n        input.env,\n        input.resolved,\n        &mut target,\n        input.manual_migrate,\n        input.attempts,\n        input.effective_spawn_cwd,\n    ) {\n        return Ok(Err(exit_code));\n    }\n    Ok(Ok(target))\n}\n\nstruct ResumeInvocationAttempt<'state> {\n    invocation: oulipoly_state::CompositeInvocationId,\n    invocation_row_id: i64,\n    guard: FinalizerGuard<'state>,\n}\n\nstruct BoundResumeAttempt<'state> {\n    attempt: ResumeInvocationAttempt<'state>,\n    provider_session_id: String,\n    zero_turn_baseline: crate::zero_turn_orchestration::ZeroTurnBaseline,\n    invocation_env: String,\n}\n\nfn setup_bound_resume_attempt<'state>(\n    input: &ResumeAttemptInput<'state>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_index: usize,\n) -> Result<BoundResumeAttempt<'state>, String> {\n    let attempt = start_resume_invocation(input, provider, provider_index)?;\n    let provider_session_id = input.resolved.active_session_id.clone();\n    bind_resume_attempt_session(\n        input,\n        provider,\n        attempt.invocation_row_id,\n        &provider_session_id,\n    )?;\n    let zero_turn_baseline = zero_turn_record_baseline(\n        &input.env.state,\n        &input.env.sessions_cfg,\n        &provider.name,\n        Some(&provider_session_id),\n    );\n    let invocation_env = resume_invocation_env(&attempt.invocation)?;\n    formatter::emit_stderr(&attempt.invocation.stderr_line());\n    Ok(BoundResumeAttempt {\n        attempt,\n        provider_session_id,\n        zero_turn_baseline,\n        invocation_env,\n    })\n}\n\nfn start_resume_invocation<'state>(\n    input: &ResumeAttemptInput<'state>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_index: usize,\n) -> Result<ResumeInvocationAttempt<'state>, String> {\n    let invocation = mapper::composite_invocation_id(&provider.name);\n    let invocation_start = mapper::resume_invocation_start(\n        &invocation,\n        input.resolved.model_name.as_deref(),\n        &provider.name,\n        provider_index,\n        input.parent_invocation_id,\n    );\n    let invocation_row_id = input\n        .agent_runtime_services\n        .invocation_lifecycle_service\n        .start_invocation(mapper::invocation_lifecycle_start_request(\n            &input.env.state,\n            &invocation_start,\n        ))\n        .map_err(|err| err.to_string())?\n        .invocation_row_id;\n    let guard = FinalizerGuard::new(&input.env.state, invocation_row_id);\n    Ok(ResumeInvocationAttempt {\n        invocation,\n        invocation_row_id,\n        guard,\n    })\n}\n\nfn bind_resume_attempt_session(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    invocation_row_id: i64,\n    provider_session_id: &str,\n) -> Result<(), String> {\n    input.env.state.bind_invocation_provider_session_start(\n        invocation_row_id,\n        &mapper::resumed_provider_session_binding(\n            provider,\n            provider_session_id,\n            Some(input.session_id.to_string()),\n        ),\n    )?;\n    if should_record_legacy_resume_input(input.manual_migrate) {\n        record_legacy_resume_input_session_id(input, invocation_row_id)?;\n    }\n    Ok(())\n}\n\nfn should_record_legacy_resume_input(manual_migrate: Option<&str>) -> bool {\n    manual_migrate.is_some()\n}\n\nfn record_legacy_resume_input_session_id(\n    input: &ResumeAttemptInput<'_>,\n    invocation_row_id: i64,\n) -> Result<(), String> {\n    input\n        .env\n        .state\n        .record_legacy_resume_input_session_id(invocation_row_id, input.session_id)\n}\n\nfn resume_invocation_env(\n    invocation: &oulipoly_state::CompositeInvocationId,\n) -> Result<String, String> {\n    serde_json::to_string(invocation).map_err(|e| format!(\"Failed to serialize invocation id: {e}\"))\n}\n\nfn apply_resume_attempt_classification(\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    provider_name: &str,\n    provider_session_id: &str,\n    zero_turn_baseline: &crate::zero_turn_orchestration::ZeroTurnBaseline,\n    zero_turn_confirmation: &mut ZeroTurnConfirmationState,\n    result: &mut executor::ExecutionResult,\n) -> Result<crate::zero_turn_orchestration::ZeroTurnAction, String> {\n    apply_age153_terminal_signal_fixture_override(result);\n    let zero_turn_classification =\n        zero_turn_classify_after_completion(&env.state, &env.sessions_cfg, zero_turn_baseline);\n    apply_zero_turn_classification_to_result(result, provider_name, &zero_turn_classification);\n    Ok(next_action(\n        zero_turn_confirmation,\n        zero_turn_classification_for_action(\n            zero_turn_classification,\n            result,\n            provider_name,\n            Some(provider_session_id),\n        ),\n    ))\n}\n\nfn record_resume_acceptance_if_present(\n    input: &ResumeAttemptInput<'_>,\n    invocation_row_id: i64,\n    result: &executor::ExecutionResult,\n) -> Result<(), String> {\n    let Some(acceptance) = resume_acceptance_result(result) else {\n        return Ok(());\n    };\n    record_resume_acceptance(input, invocation_row_id, acceptance)\n}\n\nfn resume_acceptance_result(\n    result: &executor::ExecutionResult,\n) -> Option<&oulipoly_runtime::executor::ResumeAcceptanceResult> {\n    result.resume_acceptance.as_ref()\n}\n\nfn record_resume_acceptance(\n    input: &ResumeAttemptInput<'_>,\n    invocation_row_id: i64,\n    acceptance: &oulipoly_runtime::executor::ResumeAcceptanceResult,\n) -> Result<(), String> {\n    input\n        .agent_runtime_services\n        .resume_service\n        .record_acceptance(mapper::resume_acceptance_request(\n            &input.env.state,\n            invocation_row_id,\n            acceptance,\n        ))\n        .map_err(format_resume_acceptance_service_error)?;\n    Ok(())\n}\n\nfn format_resume_acceptance_service_error(err: oulipoly_runtime::services::ServiceError) -> String {\n    format!(\"resume acceptance service failed: {err}\")\n}\n\nfn handle_resume_attempt_terminal_signal(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: crate::zero_turn_orchestration::ZeroTurnAction,\n) -> Result<ResumeAttemptLoopControl, String> {\n    let terminal_signal_disposition = terminal_signal_disposition_for_result(\n        &input.env.state,\n        &attempt.invocation.id,\n        &provider.name,\n        provider_session_id,\n        result,\n        zero_turn_action,\n    );\n\n    let disposition_control = handle_terminal_signal_disposition(ResumeTerminalDispositionInput {\n        agent_runtime_services: input.agent_runtime_services,\n        env: input.env,\n        invocation_row_id: attempt.invocation_row_id,\n        guard: &mut attempt.guard,\n        result,\n        terminal_signal_disposition,\n        zero_turn_action,\n    })?;\n    if let Some(control) = apply_resume_terminal_disposition_outcome(\n        input,\n        attempt,\n        provider_session_id,\n        result,\n        terminal_disposition_outcome(disposition_control, result),\n    )? {\n        return Ok(control);\n    }\n\n    ingest_mailbox_delivery_confirmation_turn_if_needed(input, provider, result, zero_turn_action);\n\n    if let Some(control) = handle_unconfirmed_mailbox_delivery_if_needed(\n        input,\n        attempt,\n        provider,\n        provider_session_id,\n        result,\n        zero_turn_action,\n    )? {\n        return Ok(control);\n    }\n\n    finalize_completed_attempt_for_resume(input, attempt, provider, provider_session_id, result)\n}\n\nfn ingest_mailbox_delivery_confirmation_turn_if_needed(\n    input: &ResumeAttemptInput<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) {\n    if !mailbox_delivery_requires_turn_confirmation(input, &provider.name, result) {\n        return;\n    }\n    if mailbox_delivery_turn_confirmed(input, &provider.name, result, zero_turn_action) {\n        return;\n    }\n    let report = sessions::scan_provider_session(\n        &provider.name,\n        &input.env.sessions_cfg,\n        &input.env.state,\n        &input.resolved.active_session_id,\n    );\n    emit_pre_confirmation_session_scan_errors(&provider.name, report.errors);\n}\n\nfn emit_pre_confirmation_session_scan_errors(provider_name: &str, errors: Vec<String>) {\n    for error in errors {\n        formatter::emit_stderr(&format!(\n            \"Warning: Session ingest failed for {provider_name}: {error}\"\n        ));\n    }\n}\n\nenum ResumeTerminalDispositionOutcome {\n    Continue(i32),\n    Return(i32),\n    CompletedAttempt,\n}\n\nfn terminal_disposition_outcome(\n    control: ResumeLoopControl,\n    result: &executor::ExecutionResult,\n) -> ResumeTerminalDispositionOutcome {\n    match control {\n        ResumeLoopControl::Continue => ResumeTerminalDispositionOutcome::Continue(result.exit_code),\n        ResumeLoopControl::Return(exit_code) => ResumeTerminalDispositionOutcome::Return(exit_code),\n        ResumeLoopControl::CompletedAttempt => ResumeTerminalDispositionOutcome::CompletedAttempt,\n    }\n}\n\nfn apply_resume_terminal_disposition_outcome(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &ResumeInvocationAttempt<'_>,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    outcome: ResumeTerminalDispositionOutcome,\n) -> Result<Option<ResumeAttemptLoopControl>, String> {\n    match outcome {\n        ResumeTerminalDispositionOutcome::Continue(exit_code) => {\n            record_failed_mailbox_delivery_attempt(\n                input,\n                &failed_delivery_error(result, \"resume_retry\"),\n            )?;\n            mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n            Ok(Some(ResumeAttemptLoopControl::Continue(exit_code)))\n        }\n        ResumeTerminalDispositionOutcome::Return(exit_code) => {\n            record_failed_mailbox_delivery_attempt(\n                input,\n                &failed_delivery_error(result, \"resume_failed\"),\n            )?;\n            mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(exit_code))?;\n            Ok(Some(ResumeAttemptLoopControl::Return(exit_code)))\n        }\n        ResumeTerminalDispositionOutcome::CompletedAttempt => Ok(None),\n    }\n}\n\nfn handle_unconfirmed_mailbox_delivery_if_needed(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) -> Result<Option<ResumeAttemptLoopControl>, String> {\n    if !mailbox_delivery_unconfirmed(input, &provider.name, result, zero_turn_action) {\n        return Ok(None);\n    }\n    record_failed_mailbox_delivery_attempt(input, \"mailbox_delivery_unconfirmed\")?;\n    finalize_unconfirmed_mailbox_delivery(input, attempt, result)?;\n    mark_resume_attempt_idle(provider_session_id, &attempt.invocation.id, Some(1))?;\n    Ok(Some(ResumeAttemptLoopControl::Return(1)))\n}\n\nfn finalize_completed_attempt_for_resume(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    provider: &oulipoly_config::ProviderConfig,\n    provider_session_id: &str,\n    result: &executor::ExecutionResult,\n) -> Result<ResumeAttemptLoopControl, String> {\n    match finalize_completed_attempt(CompletedAttemptInput {\n        agent_runtime_services: input.agent_runtime_services,\n        env: input.env,\n        invocation: &attempt.invocation,\n        invocation_row_id: attempt.invocation_row_id,\n        guard: &mut attempt.guard,\n        provider_name: &provider.name,\n        model: input.resolved.model.as_ref(),\n        result,\n        working_dir: input.working_dir,\n        manual_migrate: input.manual_migrate,\n        session_id: input.session_id,\n        active_session_id: &input.resolved.active_session_id,\n        effective_spawn_cwd: input.effective_spawn_cwd,\n        attempts: input.attempts,\n        max_attempts: input.max_attempts,\n    })? {\n        CompletedAttemptControl::Continue => {\n            record_failed_mailbox_delivery_attempt(\n                input,\n                &failed_delivery_error(result, \"quota_exhausted\"),\n            )?;\n            mark_resume_attempt_idle(\n                provider_session_id,\n                &attempt.invocation.id,\n                Some(result.exit_code),\n            )?;\n            Ok(ResumeAttemptLoopControl::Continue(result.exit_code))\n        }\n        CompletedAttemptControl::Return(exit_code) => {\n            if exit_code == 0 {\n                crate::mailbox_delivery::mark_headless_resume_delivered(\n                    input.mailbox_session_id,\n                    input.mailbox_delivery_seqs,\n                    &attempt.invocation.id,\n                )?;\n                let _ = crate::wake_coordinator::mark_successful_turn_idle_and_recheck(\n                    provider_session_id,\n                    &attempt.invocation.id,\n                    exit_code,\n                )?;\n            } else {\n                record_failed_mailbox_delivery_attempt(\n                    input,\n                    &failed_delivery_error(result, \"resume_failed\"),\n                )?;\n                mark_resume_attempt_idle(\n                    provider_session_id,\n                    &attempt.invocation.id,\n                    Some(exit_code),\n                )?;\n            }\n            Ok(ResumeAttemptLoopControl::Return(exit_code))\n        }\n    }\n}\n\nfn mailbox_delivery_unconfirmed(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) -> bool {\n    mailbox_delivery_requires_turn_confirmation(input, provider_name, result)\n        && !mailbox_delivery_turn_confirmed(input, provider_name, result, zero_turn_action)\n}\n\nfn mailbox_delivery_requires_turn_confirmation(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n    result: &executor::ExecutionResult,\n) -> bool {\n    result.exit_code == 0\n        && !input.mailbox_delivery_seqs.is_empty()\n        && input.answer.is_some_and(|answer| !answer.trim().is_empty())\n        && input.env.sessions_cfg.get(provider_name).is_some()\n}\n\nfn mailbox_delivery_turn_confirmed(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n    result: &executor::ExecutionResult,\n    zero_turn_action: ZeroTurnAction,\n) -> bool {\n    matches!(zero_turn_action, ZeroTurnAction::Continue)\n        || submitted_user_turn_confirms_mailbox_delivery(input, result)\n        || ingested_user_turn_confirms_mailbox_delivery(input, provider_name)\n}\n\nfn submitted_user_turn_confirms_mailbox_delivery(\n    input: &ResumeAttemptInput<'_>,\n    result: &executor::ExecutionResult,\n) -> bool {\n    let Some(submitted) = result.submitted_user_turn.as_ref() else {\n        return false;\n    };\n    let Some(answer) = input.answer else {\n        return false;\n    };\n    submitted.provider_session_id == input.resolved.active_session_id\n        && submitted_user_turn_payload_confirms_mailbox_delivery(input, submitted, answer)\n}\n\nfn submitted_user_turn_payload_confirms_mailbox_delivery(\n    input: &ResumeAttemptInput<'_>,\n    submitted: &executor::SubmittedUserTurn,\n    answer: &str,\n) -> bool {\n    if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n        return submitted.delivery_nonce.as_deref() == Some(delivery_nonce);\n    }\n    submitted.prompt_sha256 == sha256_hex(answer.as_bytes())\n}\n\nfn ingested_user_turn_confirms_mailbox_delivery(\n    input: &ResumeAttemptInput<'_>,\n    provider_name: &str,\n) -> bool {\n    if let Some(delivery_nonce) = input.mailbox_delivery_nonce {\n        return input\n            .env\n            .state\n            .has_session_user_turn_containing(\n                provider_name,\n                &input.resolved.active_session_id,\n                delivery_nonce,\n            )\n            .unwrap_or(false);\n    }\n\n    let Some(answer) = input.answer else {\n        return false;\n    };\n    input\n        .env\n        .state\n        .has_session_user_text_turn(provider_name, &input.resolved.active_session_id, answer)\n        .unwrap_or(false)\n}\n\nfn sha256_hex(bytes: &[u8]) -> String {\n    let digest = Sha256::digest(bytes);\n    digest.iter().map(|byte| format!(\"{byte:02x}\")).collect()\n}\n\nfn finalize_unconfirmed_mailbox_delivery(\n    input: &ResumeAttemptInput<'_>,\n    attempt: &mut ResumeInvocationAttempt<'_>,\n    result: &executor::ExecutionResult,\n) -> Result<(), String> {\n    formatter::emit_stderr(\n        \"resume mailbox delivery was not confirmed by a new session turn; leaving mailbox rows pending\",\n    );\n    input\n        .agent_runtime_services\n        .invocation_lifecycle_service\n        .finalize_invocation(mapper::finalize_request(\n            &input.env.state,\n            attempt.invocation_row_id,\n            false,\n            1,\n            Some(\"mailbox_delivery_unconfirmed\"),\n            result.terminal_reason.as_deref(),\n        ))\n        .map_err(|err| err.to_string())?;\n    attempt.guard.mark_finalized();\n    Ok(())\n}\n\nfn record_failed_mailbox_delivery_attempt(\n    input: &ResumeAttemptInput<'_>,\n    delivery_error: &str,\n) -> Result<(), String> {\n    crate::mailbox_delivery::mark_headless_resume_delivery_failed(\n        input.mailbox_session_id,\n        input.mailbox_delivery_seqs,\n        delivery_error,\n    )\n}\n\nfn failed_delivery_error(result: &executor::ExecutionResult, fallback: &str) -> String {\n    terminal_signal_reason(&result.terminal_signal, result.terminal_reason.as_deref())\n        .or(result.terminal_reason.as_deref())\n        .unwrap_or(fallback)\n        .to_string()\n}\n\nfn mark_resume_attempt_idle(\n    provider_session_id: &str,\n    invocation_uuid: &str,\n    exit_code: Option<i32>,\n) -> Result<(), String> {\n    crate::wake_coordinator::mark_session_idle_after_turn(\n        provider_session_id,\n        invocation_uuid,\n        exit_code,\n    )\n}\n\nfn resolve_resume_for_headless_execution(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    session_id: &str,\n    model_name: Option<&str>,\n) -> Result<oulipoly_state::ResolvedResume, i32> {\n    let output = agent_runtime_services\n        .resume_service\n        .resolve_resume(mapper::resume_service_request(env, session_id, model_name))\n        .map_err(|err| err.to_string());\n    headless_resume_resolution_result(output, env, session_id, model_name)\n}\n\nfn headless_resume_resolution_result(\n    output: Result<ResumeServiceOutput, String>,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    session_id: &str,\n    model_name: Option<&str>,\n) -> Result<oulipoly_state::ResolvedResume, i32> {\n    match map_headless_resume_resolution(output) {\n        HeadlessResumeResolution::Resolved(resolved) => Ok(resolved),\n        resolution => {\n            render_headless_resume_resolution_error(resolution, env, session_id, model_name);\n            Err(1)\n        }\n    }\n}\n\nenum HeadlessResumeResolution {\n    Resolved(oulipoly_state::ResolvedResume),\n    ProviderModelMismatch { active_provider: String },\n    Rejected(oulipoly_state::ResumeError),\n    ServiceFailure(String),\n}\n\nfn map_headless_resume_resolution(\n    output: Result<ResumeServiceOutput, String>,\n) -> HeadlessResumeResolution {\n    match output {\n        Ok(ResumeServiceOutput::ResumeResolved { resolved }) => {\n            HeadlessResumeResolution::Resolved(resolved)\n        }\n        Ok(ResumeServiceOutput::ResumeRejected {\n            error:\n                oulipoly_state::ResumeError::ProviderModelMismatch {\n                    active_provider, ..\n                },\n        }) => HeadlessResumeResolution::ProviderModelMismatch { active_provider },\n        Ok(ResumeServiceOutput::ResumeRejected { error }) => {\n            HeadlessResumeResolution::Rejected(error)\n        }\n        Err(err) => HeadlessResumeResolution::ServiceFailure(err),\n    }\n}\n\nfn render_headless_resume_resolution_error(\n    resolution: HeadlessResumeResolution,\n    env: &crate::migration_providers::ResumeExecutionEnvironment,\n    session_id: &str,\n    model_name: Option<&str>,\n) {\n    match resolution {\n        HeadlessResumeResolution::ProviderModelMismatch { active_provider } => {\n            render_resume_model_pool_mismatch(\n                &env.models,\n                model_name.unwrap_or(\"<unknown>\"),\n                session_id,\n                &active_provider,\n            );\n        }\n        HeadlessResumeResolution::Rejected(error) => render_resume_error(error),\n        HeadlessResumeResolution::ServiceFailure(err) => render_resume_service_failure(&err),\n        HeadlessResumeResolution::Resolved(_) => {}\n    }\n}\n\nfn render_resume_error(error: oulipoly_state::ResumeError) {\n    formatter::emit_stderr(&format_resume_error(error));\n}\n\nfn render_resume_service_failure(error: &str) {\n    formatter::emit_stderr(&format!(\"resume service failed: {error}\"));\n}\n\nfn prepare_initial_headless_resume_target(\n    resolved: &oulipoly_state::ResolvedResume,\n    providers_cfg: &oulipoly_config::ProvidersConfig,\n    stderr_is_terminal: bool,\n) -> Result<(), i32> {\n    let target = renderable_resume_execution_target(resolved, providers_cfg)?;\n    render_resume_short_line_if_needed(stderr_is_terminal, &resolved.active_provider);\n    validate_headless_resume_target(resolved, &target, &resolved.active_provider)\n}\n\nfn render_resume_short_line_if_needed(stderr_is_terminal: bool, selected_provider: &str) {\n    if crate::dispatch::should_emit_resume_short_line(stderr_is_terminal) {\n        formatter::emit_resume_short_line(selected_provider);\n    }\n}\n\nfn validate_headless_resume_target(\n    resolved: &oulipoly_state::ResolvedResume,\n    target: &crate::resume_cli::ResumeExecutionTarget,\n    selected_provider: &str,\n) -> Result<(), i32> {\n    if resolved_uses_provider_ref(resolved) {\n        return validate_provider_ref_headless_resume_target(resolved, target, selected_provider)\n            .map_err(|message| provider_ref_resume_block_exit_code(&message));\n    }\n    if headless_resume_target_has_resume(target) {\n        Ok(())\n    } else {\n        Err(headless_missing_resume_block_exit_code(selected_provider))\n    }\n}\n\nfn validate_provider_ref_headless_resume_target(\n    resolved: &oulipoly_state::ResolvedResume,\n    target: &crate::resume_cli::ResumeExecutionTarget,\n    selected_provider: &str,\n) -> Result<(), String> {\n    let model = require_provider_ref_resolved_model(\n        provider_ref_resolved_model(resolved),\n        selected_provider,\n    )?;\n    require_provider_ref_model_implementation(model, selected_provider)?;\n    let target_member_name = require_provider_ref_target_member_name(\n        provider_ref_target_member_name(model, target.provider_index),\n        selected_provider,\n        target.provider_index,\n    )?;\n    require_provider_ref_resolved_provider(selected_provider, target_member_name)?;\n    require_provider_ref_loaded_provider(\n        selected_provider,\n        provider_ref_loaded_provider_name(target),\n    )\n}\n\nfn require_provider_ref_resolved_model<'a>(\n    model: Option<&'a oulipoly_config::ModelConfig>,\n    selected_provider: &str,\n) -> Result<&'a oulipoly_config::ModelConfig, String> {\n    model.ok_or_else(|| provider_ref_missing_model_message(selected_provider))\n}\n\nfn require_provider_ref_model_implementation(\n    model: &oulipoly_config::ModelConfig,\n    selected_provider: &str,\n) -> Result<(), String> {\n    if provider_ref_model_has_implementation(model) {\n        Ok(())\n    } else {\n        Err(provider_ref_missing_implementation_message(\n            selected_provider,\n        ))\n    }\n}\n\nfn require_provider_ref_target_member_name<'a>(\n    target_member_name: Option<&'a str>,\n    selected_provider: &str,\n    provider_index: usize,\n) -> Result<&'a str, String> {\n    target_member_name\n        .ok_or_else(|| provider_ref_invalid_index_message(selected_provider, provider_index))\n}\n","lineStart":1,"lineEnd":1200,"totalLines":1545,"truncated":true}},"title":"src-tauri/src/run/resume/orchestration.rs","time":{"start":1780923080187,"end":1780923080249}},"metadata":{"openai":{"itemId":"fc_0bea6e3aadc7efe2016a26bac80b008198acf5d95d06e61c1d"}},"id":"prt_ea7499df7001rIv6uPSDaXlb32","sessionID":"ses_158b7240dffejD0kl19r2Asju7","messageID":"msg_ea7497a38001ZEv6CJi9mhcErI"}}
