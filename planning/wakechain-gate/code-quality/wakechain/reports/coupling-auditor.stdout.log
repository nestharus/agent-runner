   \"{\\\"type\\\":\\\"system\\\"}\\n\"\n256: +    }\n257: +\n258: +    fn write_transcript_fixture(path: &std::path::Path) {\n259: +        std::fs::write(path, transcript_fixture_body()).unwrap();\n260: +    }\n261: +\n262: +    fn locator_script_for_transcript(transcript: &std::path::Path) -> String {\n263: +        format!(\n264: +            r#\"printf '%s\\n' \"$SESSION_ID\" > \"$STATE_DIR/seen-session.txt\"\n265: +printf '%s\\n' \"{}\"\"#,\n266: +            transcript.display()\n267: +        )\n268: +    }\n269: +\n270:      #[test]\n271:      fn ingests_assistant_turns_and_advances_count() {\n272:          let db = db();\n273: @@ -872,20 +1099,9 @@ EOF\"#,\n274:  \n275:          assert_eq!(report.errors, Vec::<String>::new());\n276:          assert_eq!(report.new_turns, 1);\n277: -        let raw_body: String = db\n278: -            .connection()\n279: -            .query_row(\n280: -                \"SELECT body FROM session_turns\n281: -                 WHERE provider_name = 'p' AND session_id = 'S1' AND turn_id = 'edge-body'\",\n282: -                [],\n283: -                |row| row.get(0),\n284: -            )\n285: -            .unwrap();\n286: -        let body: serde_json::Value = serde_json::from_str(&raw_body).unwrap();\n287: -        assert_eq!(\n288: -            body,\n289: -            serde_json::json!([{\"type\":\"text\",\"text\":\"line one\\n日本語\\n{\\\"escaped\\\":true}\\u{0007}\"}])\n290: -        );\n291: +        let raw_body = stored_turn_body(&db, \"p\", \"S1\", \"edge-body\");\n292: +        let body = parsed_json_value(&raw_body);\n293: +        assert_edge_body_preserved(&body);\n294:      }\n295:  \n296:      #[test]\n297: @@ -904,22 +1120,8 @@ EOF\"#,\n298:  \n299:          assert_eq!(report.new_turns, 2);\n300:          assert_eq!(report.errors.len(), 2);\n301: -        assert!(report.errors.iter().all(|error| {\n302: -            error.contains(\"invalid body shape\")\n303: -                && error.contains(\"expected canon