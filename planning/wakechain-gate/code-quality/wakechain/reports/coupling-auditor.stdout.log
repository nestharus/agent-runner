  args.model,\n307:         resume_target_arg(args.session_id, args.chain_id),\n308:         args.rotate_provider,\n309:         args.prompt,\n310:         args.file,\n311:         args.project,\n312:         args.models_dir,\n313:     )\n314: }\n315: \n316: fn dispatch_session_subcommand(\n317:     command: SessionSubcommands,\n318:     agent_runtime_services: &wiring::AgentRuntimeServices,\n319: ) -> Result<i32, String> {\n320:     match command {\n321:         SessionSubcommands::Locate { session_id, json } => {\n322:             dispatch_session_locate_subcommand(&session_id, json)\n323:         }\n324:         SessionSubcommands::SchemaProbe => {\n325:             crate::commands::schema_probe::run_session_schema_probe()\n326:         }\n327:         SessionSubcommands::Export { session_id, format } => {\n328:             dispatch_session_export_subcommand(&session_id, &format, agent_runtime_services)\n329:         }\n330:         SessionSubcommands::PauseHandshake { session_id, ttl_ms } => {\n331:             crate::commands::handshake::run_pause_handshake(\n332:                 &session_id,\n333:                 ttl_ms,\n334:                 agent_runtime_services,\n335:             )\n336:         }\n337:         SessionSubcommands::OfPid { pid, json } => {\n338:             crate::commands::pid_session::run_of_pid(pid, json)\n339:         }\n340:         SessionSubcommands::Alive { pid, json } => {\n341:             crate::commands::pid_session::run_alive(pid, json)\n342:         }\n343:         SessionSubcommands::Subtree {\n344:             pid,\n345:             json,\n346:             max_depth,\n347:         } => crate::commands::pid_session::run_subtree(pid, json, max_depth),\n348:         SessionSubcommands::ResumeHandshake { session_id, token } => {\n349:             crate::commands::handshake::run_resume_handshake(\n350:                 &session_id,\n351:                 &token,\n352:                 agent_runtime_services,\n353:             )\n354:         }\n355:         SessionSubcommands::ImportReplace {\n356:             session_id,\n357:             from_file,\n358:             preimage_sha256,\n359:         } => crate::commands::session_import_replace::run_session_import_replace(\n360:             &session_id,\n361:             from_file.as_deref(),\n362:             preimage_sha256.as_deref(),\n363:             agent_runtime_services,\n364:         ),\n365:     }\n366: }\n367: \n368: fn dispatch_session_locate_subcommand(session_id: &str, json: bool) -> Result<i32, String> {\n369:     commands::session_locate_export::run_session_locate(session_id, json)\n370: }\n371: \n372: fn dispatch_session_export_subcommand(\n373:     session_id: &str,\n374:     format: &str,\n375:     agent_runtime_services: &wiring::AgentRuntimeServices,\n376: ) -> Result<i32, String> {\n377:     commands::session_locate_export::run_session_export(session_id, format, agent_runtime_services)\n378: }\n379: \n380: fn dispatch_top_level_resume(\n381:     cli: &Cli,\n382:     session_id: &str,\n383:     agent_runtime_services: &wiring::AgentRuntimeServices,\n384: ) -> Result<i32, String> {\n385:     validate_top_level_resume_cli(cli)?;\n386:     match resolve_top_level_resume_prompt_source(cli)? {\n387:         TopLevelResumePromptSource::Headless {\n388:             positional_or_stdin_prompt,\n389:         } => dispatch_headless_top_level_resume(\n390:             cli,\n391:             session_id,\n392:             positional_or_stdin_prompt.as_deref(),\n393:             agent_runtime_services,\n394:         ),\n395:         TopLevelResumePromptSource::Interactive => {\n396:             dispatch_interactive_top_level_resume(cli, session_id, agent_runtime_services)\n397:         }\n398:     }\n399: }\n400: \n401: fn dispatch_headless_top_level_resume(\n402:     cli: &Cli,\n403:     session_id: &str,\n404:     positional_or_stdin_prompt: Option<&str>,\n405:     agent_runtime_services: &wiring::AgentRuntimeServices,\n406: ) -> Result<i32, String> {\n407:     run::run_resume(\n408:         agent_runtime_services,\n409:         cli.model.as_deref(),\n410:         session_id,\n411:         cli.rotate_provider.as_deref(),\n412:         positional_or_stdin_prompt,\n413:         cli.file.as_deref(),\n414:         cli.project.as_deref(),\n415:         cli.models_dir.as_deref(),\n416:     )\n417: }\n418: \n419: fn dispatch_interactive_top_level_resume(\n420:     cli: &Cli,\n421:     session_id: &str,\n422:     agent_runtime_services: &wiring::AgentRuntimeServices,\n423: ) -> Result<i32, String> {\n424:     run::run_repl(\n425:         agent_runtime_services,\n426:         cli.model.as_deref(),\n427:         Some(session_id),\n428:         cli.rotate_provider.as_deref(),\n429:         cli.project.as_deref(),\n430:         cli.models_dir.as_deref(),\n431:     )\n432: }\n433: \n434: fn validate_top_level_resume_cli(cli: &Cli) -> Result<(), String> {\n435:     if cli.agent_file.is_some() {\n436:         Err(formatter::format_resume_agent_file_incompatible_error())\n437:     } else {\n438:         Ok(())\n439:     }\n440: }\n441: \n442: pub(crate) fn render_resume_error(error: oulipoly_state::ResumeError) {\n443:     formatter::emit_stderr_line(&format_resume_error(error));\n444: }\n445: \n446: pub(crate) fn resume_session_mismatch_category() -> String {\n447:     oulipoly_runtime::diagnostics::ErrorCategory::ResumeSessionMismatch\n448:         .as_str()\n449:         .to_string()\n450: }\n451: \n452: pub(crate) fn diagnose_execution_error(\n453:     agent_runtime_services: &wiring::AgentRuntimeServices,\n454:     result: &oulipoly_runtime::executor::ExecutionResult,\n455:     models: &std::collections::HashMap<String, oulipoly_config::ModelConfig>,\n456:     working_dir: Option<&std::path::Path>,\n457: ) -> Option<String> {\n458:     let input = crate::redaction::diagnostic_input(&result.stderr, &result.stdout);\n459:     crate::commands::diagnostics::run_diagnostics(\n460:         agent_runtime_services,\n461:         &input,\n462:         result.exit_code,\n463:         models,\n464:         working_dir,\n465:     )\n466: }\n467: \n468: #[cfg(test)]\n469: mod tests {\n470:     use super::*;\n471:     use clap::Parser;\n472:     use oulipoly_state::{CompositeInvocationId, InvocationStart, StateDb};\n473:     use std::panic::{AssertUnwindSafe, catch_unwind};\n474:     use std::path::{Path, PathBuf};\n475:     use std::sync::{Mutex, OnceLock};\n476:     use uuid::Uuid;\n477: \n478:     const REPL_MODEL: &str = \"fixture-model\";\n479: \n480:     trait ResumeSessionField {\n481:         fn as_optional_str(&self) -> Option<&str>;\n482:     }\n483: \n484:     impl ResumeSessionField for String {\n485:         fn as_optional_str(&self) -> Option<&str> {\n486:             Some(self.as_str())\n487:         }\n488:     }\n489: \n490:     impl ResumeSessionField for Option<String> {\n491:         fn as_optional_str(&self) -> Option<&str> {\n492:             self.as_deref()\n493:         }\n494:     }\n495: \n496:     fn resume_session_field_as_deref(field: &impl ResumeSessionField) -> Option<&str> {\n497:         field.as_optional_str()\n498:     }\n499: \n500:     fn parse_resume_subcommand<const N: usize>(argv: [&str; N]) -> Subcommands {\n501:         Cli::try_parse_from(argv)\n502:             .unwrap()\n503:             .command\n504:             .expect(\"resume argv should produce a subcommand\")\n505:     }\n506: \n507:     fn assert_resume_debug_contains_option_field(\n508:         command: Subcommands,\n509:         field_name: &str,\n510:         expected: &str,\n511:     ) {\n512:         assert_resume_subcommand(&command);\n513: \n514:         let rendered = render_subcommand_debug(&command);\n515:         let expected_fragment = expected_option_field_fragment(field_name, expected);\n516:         assert!(\n517:             rendered.contains(&expected_fragment),\n518:             \"expected `{expected_fragment}` in parsed Resume variant: {rendered}\"\n519:         );\n520:     }\n521: \n522:     fn assert_resume_subcommand(command: &Subcommands) {\n523:         match command {\n524:             Subcommands::Resume { .. } => {}\n525:             _ => panic!(\"expected resume subcommand\"),\n526:         }\n527:     }\n528: \n529:     fn render_subcommand_debug(command: &Subcommands) -> String {\n530:         format!(\"{command:?}\")\n531:     }\n532: \n533:     fn expected_option_field_fragment(field_name: &str, expected: &str) -> String {\n534:         format!(\"{field_name}: Some(\\\"{expected}\\\")\")\n535:     }\n536: \n537:     fn env_lock() -> &'static Mutex<()> {\n538:         static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n539:         LOCK.get_or_init(|| Mutex::new(()))\n540:     }\n541: \n542:     fn with_parent_invocation_env(value: Option<&str>, test: impl FnOnce()) {\n543:         let _guard = env_lock().lock().unwrap();\n544:         let previous = read_parent_invocation_env();\n545:         set_parent_invocation_env(value);\n546: \n547:         let result = catch_unwind(AssertUnwindSafe(test));\n548: \n549:         restore_parent_invocation_env(previous);\n550: \n551:         if let Err(payload) = result {\n552:             std::panic::resume_unwind(payload);\n553:         }\n554:     }\n555: \n556:     fn read_parent_invocation_env() -> Option<std::ffi::OsString> {\n557:         std::env::var_os(\"OULIPOLY_PARENT_INVOCATION\")\n558:     }\n559: \n560:     fn set_parent_invocation_env(value: Option<&str>) {\n561:         match value {\n562:             Some(value) => set_parent_invocation_env_value(value),\n563:             None => remove_parent_invocation_env(),\n564:         }\n565:     }\n566: \n567:     fn restore_parent_invocation_env(value: Option<std::ffi::OsString>) {\n568:         match value {\n569:             Some(value) => set_parent_invocation_env_os_value(value),\n570:             None => remove_parent_invocation_env(),\n571:         }\n572:     }\n573: \n574:     fn set_parent_invocation_env_value(value: &str) {\n575:         unsafe {\n576:             std::env::set_var(\"OULIPOLY_PARENT_INVOCATION\", value);\n577:         }\n578:     }\n579: \n580:     fn set_parent_invocation_env_os_value(value: std::ffi::OsString) {\n581:         unsafe {\n582:             std::env::set_var(\"OULIPOLY_PARENT_INVOCATION\", value);\n583:         }\n584:     }\n585: \n586:     fn remove_parent_invocation_env() {\n587:         unsafe {\n588:             std::env::remove_var(\"OULIPOLY_PARENT_INVOCATION\");\n589:         }\n590:     }\n591: \n592:     fn test_db() -> StateDb {\n593:         open_test_db(Path::new(\":memory:\"))\n594:     }\n595: \n596:     fn open_test_db(path: &Path) -> StateDb {\n597:         StateDb::open(path).unwrap()\n598:     }\n599: \n600:     #[test]\n601:     fn no_subcommand_still_parses_existing_model_flow() {\n602:         // `agent` is the first positional in `Cli`, so a single bare arg\n603:         // (`ping`) lands there — `prompt_args` only captures any *additional*\n604:         // trailing args. The existing `collect_positional_prompt(_, true)`\n605:         // path joins agent + prompt_args, so the runtime prompt still\n606:         // becomes \"ping\". Exercised end-to-end by the integration test\n607:         // `default_cli_flow_still_runs_without_subcommand`.\n608:         let cli =\n609:             Cli::try_parse_from([\"oulipoly-agent-runner\", \"--model\", \"fixture\", \"ping\"]).unwrap();\n610: \n611:         assert!(cli.command.is_none());\n612:         assert_eq!(cli.model.as_deref(), Some(\"fixture\"));\n613:         assert_eq!(cli.agent.as_deref(), Some(\"ping\"));\n614:         assert!(cli.prompt_args.is_empty());\n615: \n616:         // Two trailing args: the first goes to `agent`, the rest into\n617:         // `prompt_args`. This is the existing PR-A behavior preserved\n618:         // under subcommand dispatch.\n619:         let cli = Cli::try_parse_from([\n620:             \"oulipoly-agent-runner\",\n621:             \"--model\",\n622:             \"fixture\",\n623:             \"ping\",\n624:             \"pong\",\n625:         ])\n626:         .unwrap();\n627:         assert_eq!(cli.agent.as_deref(), Some(\"ping\"));\n628:         assert_eq!(cli.prompt_args, vec![\"pong\"]);\n629:     }\n630: \n631:     #[test]\n632:     fn parser_accepts_long_new() {\n633:         let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"--new\"]).unwrap();\n634: \n635:         assert!(cli.new);\n636:         assert!(cli.command.is_none());\n637:         assert!(cli.agent.is_none());\n638:         assert!(cli.prompt_args.is_empty());\n639:         assert!(cli.model.is_none());\n640:         assert!(cli.resume.is_none());\n641:     }\n642: \n643:     #[test]\n644:     fn parser_accepts_short_n() {\n645:         let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"-n\"]).unwrap();\n646: \n647:         assert!(cli.new);\n648:         assert!(cli.command.is_none());\n649:         assert!(cli.agent.is_none());\n650:         assert!(cli.prompt_args.is_empty());\n651:         assert!(cli.model.is_none());\n652:         assert!(cli.resume.is_none());\n653:     }\n654: \n655:     #[test]\n656:     fn parser_rejects_resume_then_new() {\n657:         let err = match Cli::try_parse_from([\n658:             \"oulipoly-agent-runner\",\n659:             \"--resume\",\n660:             \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n661:             \"--new\",\n662:         ]) {\n663:             Ok(_) => panic!(\"--resume and --new should conflict\"),\n664:             Err(err) => err,\n665:         };\n666: \n667:         assert_eq!(err.kind(), clap::error::ErrorKind::ArgumentConflict);\n668:         let rendered = err.to_string();\n669:         assert!(rendered.contains(\"--resume\"), \"{rendered}\");\n670:         assert!(rendered.contains(\"--new\"), \"{rendered}\");\n671:     }\n672: \n673:     #[test]\n674:     fn parser_rejects_new_then_resume() {\n675:         let err = match Cli::try_parse_from([\n676:             \"oulipoly-agent-runner\",\n677:             \"--new\",\n678:             \"--resume\",\n679:             \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n680:         ]) {\n681:             Ok(_) => panic!(\"--new and --resume should conflict\"),\n682:             Err(err) => err,\n683:         };\n684: \n685:         assert_eq!(err.kind(), clap::error::ErrorKind::ArgumentConflict);\n686:         let rendered = err.to_string();\n687:         assert!(rendered.contains(\"--new\"), \"{rendered}\");\n688:         assert!(rendered.contains(\"--resume\"), \"{rendered}\");\n689:     }\n690: \n691:     #[test]\n692:     fn repl_subcommand_parses_required_model_without_optional_paths() {\n693:         let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"repl\", REPL_MODEL]).unwrap();\n694: \n695:         match cli.command {\n696:             Some(Subcommands::Repl {\n697:                 model,\n698:                 resume,\n699:                 rotate_provider: _,\n700:                 project,\n701:                 models_dir,\n702:             }) => {\n703:                 assert_eq!(model.as_deref(), Some(REPL_MODEL));\n704:                 assert_eq!(resume, None);\n705:                 assert_eq!(project, None);\n706:                 assert_eq!(models_dir, None);\n707:             }\n708:             _ => panic!(\"expected repl subcommand\"),\n709:         }\n710:     }\n711: \n712:     #[test]\n713:     fn repl_subcommand_parses_project_path() {\n714:         let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"repl\", REPL_MODEL, \"-p\", \"/tmp\"])\n715:             .unwrap();\n716: \n717:         match cli.command {\n718:             Some(Subcommands::Repl {\n719:                 resume, project, ..\n720:             }) => {\n721:                 assert_eq!(resume, None);\n722:                 assert_eq!(project, Some(PathBuf::from(\"/tmp\")));\n723:             }\n724:             _ => panic!(\"expected repl subcommand\"),\n725:         }\n726:     }\n727: \n728:     #[test]\n729:     fn repl_subcommand_parses_models_dir_override() {\n730:         let cli = Cli::try_parse_from([\n731:             \"oulipoly-agent-runner\",\n732:             \"repl\",\n733:             \"--models-dir\",\n734:             \"/tmp/models\",\n735:             REPL_MODEL,\n736:         ])\n737:         .unwrap();\n738: \n739:         match cli.command {\n740:             Some(Subcommands::Repl {\n741:                 resume, models_dir, ..\n742:             }) => {\n743:                 assert_eq!(resume, None);\n744:                 assert_eq!(models_dir, Some(PathBuf::from(\"/tmp/models\")));\n745:             }\n746:             _ => panic!(\"expected repl subcommand\"),\n747:         }\n748:     }\n749: \n750:     #[test]\n751:     fn repl_subcommand_parses_resume_after_model() {\n752:         let session_id = \"5169694d-de0f-40d1-890c-6e28e55bab27\";\n753:         let cli = Cli::try_parse_from([\n754:             \"oulipoly-agent-runner\",\n755:             \"repl\",\n756:             REPL_MODEL,\n757:             \"--resume\",\n758:             session_id,\n759:         ])\n760:         .unwrap();\n761: \n762:         match cli.command {\n763:             Some(Subcommands::Repl { model, resume, .. }) => {\n764:                 assert_eq!(model.as_deref(), Some(REPL_MODEL));\n765:                 assert_eq!(resume.as_deref(), Some(session_id));\n766:             }\n767:             _ => panic!(\"expected repl subcommand\"),\n768:         }\n769:     }\n770: \n771:     #[test]\n772:     fn resume_subcommand_accepts_positional_chain_id() {\n773:         let chain_id = \"7ec82d7d-5f83-4be7-8868-b1ce3c9c3123\";\n774:         let command = parse_resume_subcommand([\"oulipoly-agent-runner\", \"resume\", chain_id]);\n775: \n776:         // Keep this layout-tolerant: Phase 6c may use flat fields or a flattened target Args struct.\n777:         assert_resume_debug_contains_option_field(command, \"chain_id\", chain_id);\n778:     }\n779: \n780:     #[test]\n781:     fn resume_subcommand_accepts_session_id_flag() {\n782:         let session_id = \"5169694d-de0f-40d1-890c-6e28e55bab27\";\n783:         let command = parse_resume_subcommand([\n784:             \"oulipoly-agent-runner\",\n785:             \"resume\",\n786:             \"--session-id\",\n787:             session_id,\n788:         ]);\n789: \n790:         assert_resume_debug_contains_option_field(command, \"session_id\", session_id);\n791:     }\n792: \n793:     #[test]\n794:     fn resume_subcommand_rejects_both_positional_and_session_id() {\n795:         let err = match Cli::try_parse_from([\n796:             \"oulipoly-agent-runner\",\n797:             \"resume\",\n798:             \"7ec82d7d-5f83-4be7-8868-b1ce3c9c3123\",\n799:             \"--session-id\",\n800:             \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n801:         ]) {\n802:             Ok(_) => panic!(\"expected clap to reject both resume target forms\"),\n803:             Err(err) => err,\n804:         };\n805: \n806:         assert_eq!(err.kind(), clap::error::ErrorKind::ArgumentConflict);\n807:     }\n808: \n809:     #[test]\n810:     fn resume_subcommand_rejects_no_target() {\n811:         let err = match Cli::try_parse_from([\"oulipoly-agent-runner\", \"resume\"]) {\n812:             Ok(_) => panic!(\"expected clap to reject resume without a target\"),\n813:             Err(err) => err,\n814:         };\n815: \n816:         assert_eq!(err.kind(), clap::error::ErrorKind::MissingRequiredArgument);\n817:     }\n818: \n819:     #[test]\n820:     fn resume_subcommand_dispatch_routes_positional_to_run_resume_arg() {\n821:         let chain_id = \"7ec82d7d-5f83-4be7-8868-b1ce3c9c3123\";\n822:         let command = parse_resume_subcommand([\"oulipoly-agent-runner\", \"resume\", chain_id]);\n823: \n824:         // Parser-level proxy for dispatch: the field selected by the Resume arm must hold\n825:         // the positional target unchanged so Phase 6c can pass it directly to run_resume.\n826:         assert_resume_debug_contains_option_field(command, \"chain_id\", chain_id);\n827:     }\n828: \n829:     #[test]\n830:     fn resume_subcommand_parses_answer_file_and_project() {\n831:         let session_id = \"5169694d-de0f-40d1-890c-6e28e55bab27\";\n832:         let cli = Cli::try_parse_from([\n833:             \"oulipoly-agent-runner\",\n834:             \"resume\",\n835:             \"-m\",\n836:             REPL_MODEL,\n837:             \"--session-id\",\n838:             session_id,\n839:             \"-f\",\n840:             \"/tmp/answer.md\",\n841:             \"-p\",\n842:             \"/tmp/project\",\n843:             \"--models-dir\",\n844:             \"/tmp/models\",\n845:         ])\n846:         .unwrap();\n847: \n848:         match cli.command {\n849:             Some(Subcommands::Resume {\n850:                 model,\n851:                 session_id: parsed_session,\n852:                 rotate_provider: _,\n853:                 prompt,\n854:                 file,\n855:                 project,\n856:                 models_dir,\n857:                 ..\n858:             }) => {\n859:                 assert_eq!(model.as_deref(), Some(REPL_MODEL));\n860:                 assert_eq!(\n861:                     resume_session_field_as_deref(&parsed_session),\n862:                     Some(session_id)\n863:                 );\n864:                 assert_eq!(prompt, None);\n865:                 assert_eq!(file, Some(PathBuf::from(\"/tmp/answer.md\")));\n866:                 assert_eq!(project, Some(PathBuf::from(\"/tmp/project\")));\n867:                 assert_eq!(models_dir, Some(PathBuf::from(\"/tmp/models\")));\n868:             }\n869:             _ => panic!(\"expected resume subcommand\"),\n870:         }\n871:     }\n872: \n873:     #[test]\n874:     fn resume_subcommand_parses_inline_prompt() {\n875:         let cli = Cli::try_parse_from([\n876:             \"oulipoly-agent-runner\",\n877:             \"resume\",\n878:             \"-m\",\n879:             REPL_MODEL,\n880:             \"--session-id\",\n881:             \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n882:             \"--prompt\",\n883:             \"answer text\",\n884:         ])\n885:         .unwrap();\n886: \n887:         match cli.command {\n888:             Some(Subcommands::Resume { prompt, file, .. }) => {\n889:                 assert_eq!(prompt.as_deref(), Some(\"answer text\"));\n890:                 assert_eq!(file, None);\n891:             }\n892:             _ => panic!(\"expected resume subcommand\"),\n893:         }\n894:     }\n895: \n896:     #[test]\n897:     fn resume_subcommand_rejects_prompt_and_file_together() {\n898:         let err = match Cli::try_parse_from([\n899:             \"oulipoly-agent-runner\",\n900:             \"resume\",\n901:             \"-m\",\n902:             REPL_MODEL,\n903:             \"--session-id\",\n904:             \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n905:             \"--prompt\",\n906:             \"answer text\",\n907:             \"-f\",\n908:             \"/tmp/answer.md\",\n909:         ]) {\n910:             Ok(_) => panic!(\"expected clap to reject --prompt with --file\"),\n911:             Err(err) => err,\n912:         };\n913: \n914:         let rendered = err.to_string();\n915:         assert!(\n916:             rendered.contains(\"--prompt\") || rendered.contains(\"--file\"),\n917:             \"{rendered}\"\n918:         );\n919:     }\n920: \n921:     #[test]\n922:     fn repl_subcommand_parses_resume_before_model() {\n923:         let session_id = \"5169694d-de0f-40d1-890c-6e28e55bab27\";\n924:         let cli = Cli::try_parse_from([\n925:             \"oulipoly-agent-runner\",\n926:             \"repl\",\n927:             \"--resume\",\n928:             session_id,\n929:             REPL_MODEL,\n930:         ])\n931:         .unwrap();\n932: \n933:         match cli.command {\n934:             Some(Subcommands::Repl { model, resume, .. }) => {\n935:                 assert_eq!(model.as_deref(), Some(REPL_MODEL));\n936:                 assert_eq!(resume.as_deref(), Some(session_id));\n937:             }\n938:             _ => panic!(\"expected repl subcommand\"),\n939:         }\n940:     }\n941: \n942:     #[test]\n943:     fn repl_subcommand_allows_missing_model_with_resume() {\n944:         let cli = Cli::try_parse_from([\n945:             \"oulipoly-agent-runner\",\n946:             \"repl\",\n947:             \"--resume\",\n948:             \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n949:         ])\n950:         .unwrap();\n951: \n952:         match cli.command {\n953:             Some(Subcommands::Repl { model, resume, .. }) => {\n954:                 assert_eq!(model, None);\n955:                 assert_eq!(\n956:                     resume.as_deref(),\n957:                     Some(\"5169694d-de0f-40d1-890c-6e28e55bab27\")\n958:                 );\n959:             }\n960:             _ => panic!(\"expected repl subcommand\"),\n961:         }\n962:     }\n963: \n964:     #[test]\n965:     fn repl_subcommand_requires_resume_value() {\n966:         let err =\n967:             match Cli::try_parse_from([\"oulipoly-agent-runner\", \"repl\", REPL_MODEL, \"--resume\"]) {\n968:                 Ok(_) => panic!(\"expected clap to reject --resume without a value\"),\n969:                 Err(err) => err,\n970:             };\n971: \n972:         let rendered = err.to_string();\n973:         assert!(rendered.contains(\"--resume\"), \"{rendered}\");\n974:     }\n975: \n976:     #[test]\n977:     fn repl_subcommand_rejects_extra_positional_arguments() {\n978:         let err = match Cli::try_parse_from([\"oulipoly-agent-runner\", \"repl\", REPL_MODEL, \"extra\"])\n979:         {\n980:             Ok(_) => panic!(\"expected clap to reject extra repl positional arguments\"),\n981:             Err(err) => err,\n982:         };\n983: \n984:         let rendered = err.to_string();\n985:         assert!(rendered.contains(\"extra\"), \"{rendered}\");\n986:     }\n987: \n988:     #[test]\n989:     fn resolve_parent_invocation_id_returns_none_when_env_is_unset() {\n990:         let db = test_db();\n991: \n992:         with_parent_invocation_env(None, || {\n993:             assert_eq!(resolve_parent_invocation_id(&db), None);\n994:         });\n995:     }\n996: \n997:     #[test]\n998:     fn resolve_parent_invocation_id_returns_existing_parent_rowid() {\n999:         let db = test_db();\n1000:         let parent = CompositeInvocationId {\n1001:             source: \"fixture-provider\".to_string(),\n1002:             id: Uuid::new_v4().to_string(),\n1003:         };\n1004:         let row_id = db\n1005:             .start_invocation(&InvocationStart {\n1006:                 invocation_uuid: parent.id.clone(),\n1007:                 model_name: \"fixture-model\".to_string(),\n1008:                 provider_name: parent.source.clone(),\n1009:                 provider_index: 0,\n1010:                 parent_invocation_id: None,\n1011:             })\n1012:             .unwrap();\n1013:         let parent_env = serde_json::to_string(&parent).unwrap();\n1014: \n1015:         with_parent_invocation_env(Some(&parent_env), || {\n1016:             assert_eq!(resolve_parent_invocation_id(&db), Some(row_id));\n1017:         });\n1018:     }\n1019: \n1020:     #[test]\n1021:     fn resolve_parent_invocation_id_uses_same_db_uuid_despite_source_name_drift() {\n1022:         let db = test_db();\n1023:         let parent = CompositeInvocationId {\n1024:             source: \"renamed-provider\".to_string(),\n1025:             id: Uuid::new_v4().to_string(),\n1026:         };\n1027:         let row_id = db\n1028:             .start_invocation(&InvocationStart {\n1029:                 invocation_uuid: parent.id.clone(),\n1030:                 model_name: \"fixture-model\".to_string(),\n1031:                 provider_name: \"fixture-provider\".to_string(),\n1032:                 provider_index: 0,\n1033:                 parent_invocation_id: None,\n1034:             })\n1035:             .unwrap();\n1036:         db.finalize_invocation(row_id, false, 1, None, Some(\"exit_nonzero\"))\n1037:             .unwrap();\n1038:         let parent_env = serde_json::to_string(&parent).unwrap();\n1039: \n1040:         with_parent_invocation_env(Some(&parent_env), || {\n1041:             assert_eq!(resolve_parent_invocation_id(&db), Some(row_id));\n1042:         });\n1043:     }\n1044: \n1045:     #[test]\n1046:     fn resolve_parent_invocation_id_returns_none_for_malformed_json() {\n1047:         let db = test_db();\n1048:         with_parent_invocation_env(Some(\"not-json\"), || {\n1049:             assert_eq!(resolve_parent_invocation_id(&db), None);\n1050:         });\n1051:     }\n1052: \n1053:     #[test]\n1054:     fn resolve_parent_invocation_id_returns_none_for_unknown_uuid() {\n1055:         let db = test_db();\n1056:         let raw = r#\"{\"source\":\"fixture-provider\",\"id\":\"00000000-0000-0000-0000-000000000000\"}\"#;\n1057:         with_parent_invocation_env(Some(raw), || {\n1058:             assert_eq!(resolve_parent_invocation_id(&db), None);\n1059:         });\n1060:     }\n1061: \n1062:     #[test]\n1063:     fn resolve_parent_invocation_id_returns_none_for_invalid_uuid_format() {\n1064:         let db = test_db();\n1065:         let raw = r#\"{\"source\":\"fixture-provider\",\"id\":\"not-a-uuid\"}\"#;\n1066:         with_parent_invocation_env(Some(raw), || {\n1067:             assert_eq!(resolve_parent_invocation_id(&db), None);\n1068:         });\n1069:     }\n1070: \n1071:     #[test]\n1072:     fn resume_short_line_helper_emits_for_non_tty_stderr() {\n1073:         assert!(should_emit_resume_short_line(false));\n1074:     }\n1075: \n1076:     #[test]\n1077:     fn resume_short_line_helper_also_emits_for_tty_stderr() {\n1078:         // The short [resume] -> <provider> line is unconditional per\n1079:         // proposal §5: V10 (observable selection) wins over V15\n1080:         // (caller-controlled surface) for this single line. The test\n1081:         // pins the \"always-on\" guarantee against future drift.\n1082:         assert!(should_emit_resume_short_line(true));\n1083:     }\n1084: \n1085:     // risk: CLI surface; level: unit; source: proposal §11.1 CLI surface / A8.\n1086:     #[test]\n1087:     fn top_level_resume_parse_allows_missing_model_and_rotate_provider_flag() {\n1088:         let cli = Cli::try_parse_from([\n1089:             \"oulipoly-agent-runner\",\n1090:             \"--resume\",\n1091:             \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n1092:             \"--rotate-provider\",\n1093:             \"provider2\",\n1094:             \"continue\",\n1095:         ])\n1096:         .unwrap();\n1097: \n1098:         assert!(cli.command.is_none());\n1099:         assert_eq!(cli.model, None);\n1100:         assert_eq!(\n1101:             cli.resume.as_deref(),\n1102:             Some(\"5169694d-de0f-40d1-890c-6e28e55bab27\")\n1103:         );\n1104:         assert_eq!(cli.rotate_provider.as_deref(), Some(\"provider2\"));\n1105:     }\n1106: }\n\n(End of file - total 1106 lines)\n</content>","metadata":{"preview":"    }\n}\n\nfn dispatch_mailbox_subcommand(command: MailboxSubcommands) -> Result<i32, String> {\n    match command {\n        MailboxSubcommands::List {\n            session_id,\n            all,\n            json,\n        } => crate::commands::mailbox::run_list(&session_id, all, json),\n    }\n}\n\nfn dispatch_trace_subcommand(\n    invocation_uuid: &str,\n    json: bool,\n    inline_transcript: bool,\n    transcript: bool,\n    max_depth: usize,\n    agent_runtime_services: &wiring::AgentRuntimeServices,","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/dispatch.rs","text":"    }\n}\n\nfn dispatch_mailbox_subcommand(command: MailboxSubcommands) -> Result<i32, String> {\n    match command {\n        MailboxSubcommands::List {\n            session_id,\n            all,\n            json,\n        } => crate::commands::mailbox::run_list(&session_id, all, json),\n    }\n}\n\nfn dispatch_trace_subcommand(\n    invocation_uuid: &str,\n    json: bool,\n    inline_transcript: bool,\n    transcript: bool,\n    max_depth: usize,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    commands::trace::run_trace_command(\n        commands::trace::trace_options(max_depth, json, inline_transcript, transcript),\n        invocation_uuid,\n        agent_runtime_services,\n    )\n}\n\nstruct ResumeDispatchArgs<'a> {\n    model: Option<&'a str>,\n    session_id: Option<&'a str>,\n    chain_id: Option<&'a str>,\n    rotate_provider: Option<&'a str>,\n    prompt: Option<&'a str>,\n    file: Option<&'a std::path::Path>,\n    project: Option<&'a std::path::Path>,\n    models_dir: Option<&'a std::path::Path>,\n}\n\nfn dispatch_resume_subcommand(\n    args: ResumeDispatchArgs<'_>,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    run::run_resume(\n        agent_runtime_services,\n        args.model,\n        resume_target_arg(args.session_id, args.chain_id),\n        args.rotate_provider,\n        args.prompt,\n        args.file,\n        args.project,\n        args.models_dir,\n    )\n}\n\nfn dispatch_session_subcommand(\n    command: SessionSubcommands,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    match command {\n        SessionSubcommands::Locate { session_id, json } => {\n            dispatch_session_locate_subcommand(&session_id, json)\n        }\n        SessionSubcommands::SchemaProbe => {\n            crate::commands::schema_probe::run_session_schema_probe()\n        }\n        SessionSubcommands::Export { session_id, format } => {\n            dispatch_session_export_subcommand(&session_id, &format, agent_runtime_services)\n        }\n        SessionSubcommands::PauseHandshake { session_id, ttl_ms } => {\n            crate::commands::handshake::run_pause_handshake(\n                &session_id,\n                ttl_ms,\n                agent_runtime_services,\n            )\n        }\n        SessionSubcommands::OfPid { pid, json } => {\n            crate::commands::pid_session::run_of_pid(pid, json)\n        }\n        SessionSubcommands::Alive { pid, json } => {\n            crate::commands::pid_session::run_alive(pid, json)\n        }\n        SessionSubcommands::Subtree {\n            pid,\n            json,\n            max_depth,\n        } => crate::commands::pid_session::run_subtree(pid, json, max_depth),\n        SessionSubcommands::ResumeHandshake { session_id, token } => {\n            crate::commands::handshake::run_resume_handshake(\n                &session_id,\n                &token,\n                agent_runtime_services,\n            )\n        }\n        SessionSubcommands::ImportReplace {\n            session_id,\n            from_file,\n            preimage_sha256,\n        } => crate::commands::session_import_replace::run_session_import_replace(\n            &session_id,\n            from_file.as_deref(),\n            preimage_sha256.as_deref(),\n            agent_runtime_services,\n        ),\n    }\n}\n\nfn dispatch_session_locate_subcommand(session_id: &str, json: bool) -> Result<i32, String> {\n    commands::session_locate_export::run_session_locate(session_id, json)\n}\n\nfn dispatch_session_export_subcommand(\n    session_id: &str,\n    format: &str,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    commands::session_locate_export::run_session_export(session_id, format, agent_runtime_services)\n}\n\nfn dispatch_top_level_resume(\n    cli: &Cli,\n    session_id: &str,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    validate_top_level_resume_cli(cli)?;\n    match resolve_top_level_resume_prompt_source(cli)? {\n        TopLevelResumePromptSource::Headless {\n            positional_or_stdin_prompt,\n        } => dispatch_headless_top_level_resume(\n            cli,\n            session_id,\n            positional_or_stdin_prompt.as_deref(),\n            agent_runtime_services,\n        ),\n        TopLevelResumePromptSource::Interactive => {\n            dispatch_interactive_top_level_resume(cli, session_id, agent_runtime_services)\n        }\n    }\n}\n\nfn dispatch_headless_top_level_resume(\n    cli: &Cli,\n    session_id: &str,\n    positional_or_stdin_prompt: Option<&str>,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    run::run_resume(\n        agent_runtime_services,\n        cli.model.as_deref(),\n        session_id,\n        cli.rotate_provider.as_deref(),\n        positional_or_stdin_prompt,\n        cli.file.as_deref(),\n        cli.project.as_deref(),\n        cli.models_dir.as_deref(),\n    )\n}\n\nfn dispatch_interactive_top_level_resume(\n    cli: &Cli,\n    session_id: &str,\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n) -> Result<i32, String> {\n    run::run_repl(\n        agent_runtime_services,\n        cli.model.as_deref(),\n        Some(session_id),\n        cli.rotate_provider.as_deref(),\n        cli.project.as_deref(),\n        cli.models_dir.as_deref(),\n    )\n}\n\nfn validate_top_level_resume_cli(cli: &Cli) -> Result<(), String> {\n    if cli.agent_file.is_some() {\n        Err(formatter::format_resume_agent_file_incompatible_error())\n    } else {\n        Ok(())\n    }\n}\n\npub(crate) fn render_resume_error(error: oulipoly_state::ResumeError) {\n    formatter::emit_stderr_line(&format_resume_error(error));\n}\n\npub(crate) fn resume_session_mismatch_category() -> String {\n    oulipoly_runtime::diagnostics::ErrorCategory::ResumeSessionMismatch\n        .as_str()\n        .to_string()\n}\n\npub(crate) fn diagnose_execution_error(\n    agent_runtime_services: &wiring::AgentRuntimeServices,\n    result: &oulipoly_runtime::executor::ExecutionResult,\n    models: &std::collections::HashMap<String, oulipoly_config::ModelConfig>,\n    working_dir: Option<&std::path::Path>,\n) -> Option<String> {\n    let input = crate::redaction::diagnostic_input(&result.stderr, &result.stdout);\n    crate::commands::diagnostics::run_diagnostics(\n        agent_runtime_services,\n        &input,\n        result.exit_code,\n        models,\n        working_dir,\n    )\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use clap::Parser;\n    use oulipoly_state::{CompositeInvocationId, InvocationStart, StateDb};\n    use std::panic::{AssertUnwindSafe, catch_unwind};\n    use std::path::{Path, PathBuf};\n    use std::sync::{Mutex, OnceLock};\n    use uuid::Uuid;\n\n    const REPL_MODEL: &str = \"fixture-model\";\n\n    trait ResumeSessionField {\n        fn as_optional_str(&self) -> Option<&str>;\n    }\n\n    impl ResumeSessionField for String {\n        fn as_optional_str(&self) -> Option<&str> {\n            Some(self.as_str())\n        }\n    }\n\n    impl ResumeSessionField for Option<String> {\n        fn as_optional_str(&self) -> Option<&str> {\n            self.as_deref()\n        }\n    }\n\n    fn resume_session_field_as_deref(field: &impl ResumeSessionField) -> Option<&str> {\n        field.as_optional_str()\n    }\n\n    fn parse_resume_subcommand<const N: usize>(argv: [&str; N]) -> Subcommands {\n        Cli::try_parse_from(argv)\n            .unwrap()\n            .command\n            .expect(\"resume argv should produce a subcommand\")\n    }\n\n    fn assert_resume_debug_contains_option_field(\n        command: Subcommands,\n        field_name: &str,\n        expected: &str,\n    ) {\n        assert_resume_subcommand(&command);\n\n        let rendered = render_subcommand_debug(&command);\n        let expected_fragment = expected_option_field_fragment(field_name, expected);\n        assert!(\n            rendered.contains(&expected_fragment),\n            \"expected `{expected_fragment}` in parsed Resume variant: {rendered}\"\n        );\n    }\n\n    fn assert_resume_subcommand(command: &Subcommands) {\n        match command {\n            Subcommands::Resume { .. } => {}\n            _ => panic!(\"expected resume subcommand\"),\n        }\n    }\n\n    fn render_subcommand_debug(command: &Subcommands) -> String {\n        format!(\"{command:?}\")\n    }\n\n    fn expected_option_field_fragment(field_name: &str, expected: &str) -> String {\n        format!(\"{field_name}: Some(\\\"{expected}\\\")\")\n    }\n\n    fn env_lock() -> &'static Mutex<()> {\n        static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n        LOCK.get_or_init(|| Mutex::new(()))\n    }\n\n    fn with_parent_invocation_env(value: Option<&str>, test: impl FnOnce()) {\n        let _guard = env_lock().lock().unwrap();\n        let previous = read_parent_invocation_env();\n        set_parent_invocation_env(value);\n\n        let result = catch_unwind(AssertUnwindSafe(test));\n\n        restore_parent_invocation_env(previous);\n\n        if let Err(payload) = result {\n            std::panic::resume_unwind(payload);\n        }\n    }\n\n    fn read_parent_invocation_env() -> Option<std::ffi::OsString> {\n        std::env::var_os(\"OULIPOLY_PARENT_INVOCATION\")\n    }\n\n    fn set_parent_invocation_env(value: Option<&str>) {\n        match value {\n            Some(value) => set_parent_invocation_env_value(value),\n            None => remove_parent_invocation_env(),\n        }\n    }\n\n    fn restore_parent_invocation_env(value: Option<std::ffi::OsString>) {\n        match value {\n            Some(value) => set_parent_invocation_env_os_value(value),\n            None => remove_parent_invocation_env(),\n        }\n    }\n\n    fn set_parent_invocation_env_value(value: &str) {\n        unsafe {\n            std::env::set_var(\"OULIPOLY_PARENT_INVOCATION\", value);\n        }\n    }\n\n    fn set_parent_invocation_env_os_value(value: std::ffi::OsString) {\n        unsafe {\n            std::env::set_var(\"OULIPOLY_PARENT_INVOCATION\", value);\n        }\n    }\n\n    fn remove_parent_invocation_env() {\n        unsafe {\n            std::env::remove_var(\"OULIPOLY_PARENT_INVOCATION\");\n        }\n    }\n\n    fn test_db() -> StateDb {\n        open_test_db(Path::new(\":memory:\"))\n    }\n\n    fn open_test_db(path: &Path) -> StateDb {\n        StateDb::open(path).unwrap()\n    }\n\n    #[test]\n    fn no_subcommand_still_parses_existing_model_flow() {\n        // `agent` is the first positional in `Cli`, so a single bare arg\n        // (`ping`) lands there — `prompt_args` only captures any *additional*\n        // trailing args. The existing `collect_positional_prompt(_, true)`\n        // path joins agent + prompt_args, so the runtime prompt still\n        // becomes \"ping\". Exercised end-to-end by the integration test\n        // `default_cli_flow_still_runs_without_subcommand`.\n        let cli =\n            Cli::try_parse_from([\"oulipoly-agent-runner\", \"--model\", \"fixture\", \"ping\"]).unwrap();\n\n        assert!(cli.command.is_none());\n        assert_eq!(cli.model.as_deref(), Some(\"fixture\"));\n        assert_eq!(cli.agent.as_deref(), Some(\"ping\"));\n        assert!(cli.prompt_args.is_empty());\n\n        // Two trailing args: the first goes to `agent`, the rest into\n        // `prompt_args`. This is the existing PR-A behavior preserved\n        // under subcommand dispatch.\n        let cli = Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"--model\",\n            \"fixture\",\n            \"ping\",\n            \"pong\",\n        ])\n        .unwrap();\n        assert_eq!(cli.agent.as_deref(), Some(\"ping\"));\n        assert_eq!(cli.prompt_args, vec![\"pong\"]);\n    }\n\n    #[test]\n    fn parser_accepts_long_new() {\n        let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"--new\"]).unwrap();\n\n        assert!(cli.new);\n        assert!(cli.command.is_none());\n        assert!(cli.agent.is_none());\n        assert!(cli.prompt_args.is_empty());\n        assert!(cli.model.is_none());\n        assert!(cli.resume.is_none());\n    }\n\n    #[test]\n    fn parser_accepts_short_n() {\n        let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"-n\"]).unwrap();\n\n        assert!(cli.new);\n        assert!(cli.command.is_none());\n        assert!(cli.agent.is_none());\n        assert!(cli.prompt_args.is_empty());\n        assert!(cli.model.is_none());\n        assert!(cli.resume.is_none());\n    }\n\n    #[test]\n    fn parser_rejects_resume_then_new() {\n        let err = match Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"--resume\",\n            \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n            \"--new\",\n        ]) {\n            Ok(_) => panic!(\"--resume and --new should conflict\"),\n            Err(err) => err,\n        };\n\n        assert_eq!(err.kind(), clap::error::ErrorKind::ArgumentConflict);\n        let rendered = err.to_string();\n        assert!(rendered.contains(\"--resume\"), \"{rendered}\");\n        assert!(rendered.contains(\"--new\"), \"{rendered}\");\n    }\n\n    #[test]\n    fn parser_rejects_new_then_resume() {\n        let err = match Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"--new\",\n            \"--resume\",\n            \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n        ]) {\n            Ok(_) => panic!(\"--new and --resume should conflict\"),\n            Err(err) => err,\n        };\n\n        assert_eq!(err.kind(), clap::error::ErrorKind::ArgumentConflict);\n        let rendered = err.to_string();\n        assert!(rendered.contains(\"--new\"), \"{rendered}\");\n        assert!(rendered.contains(\"--resume\"), \"{rendered}\");\n    }\n\n    #[test]\n    fn repl_subcommand_parses_required_model_without_optional_paths() {\n        let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"repl\", REPL_MODEL]).unwrap();\n\n        match cli.command {\n            Some(Subcommands::Repl {\n                model,\n                resume,\n                rotate_provider: _,\n                project,\n                models_dir,\n            }) => {\n                assert_eq!(model.as_deref(), Some(REPL_MODEL));\n                assert_eq!(resume, None);\n                assert_eq!(project, None);\n                assert_eq!(models_dir, None);\n            }\n            _ => panic!(\"expected repl subcommand\"),\n        }\n    }\n\n    #[test]\n    fn repl_subcommand_parses_project_path() {\n        let cli = Cli::try_parse_from([\"oulipoly-agent-runner\", \"repl\", REPL_MODEL, \"-p\", \"/tmp\"])\n            .unwrap();\n\n        match cli.command {\n            Some(Subcommands::Repl {\n                resume, project, ..\n            }) => {\n                assert_eq!(resume, None);\n                assert_eq!(project, Some(PathBuf::from(\"/tmp\")));\n            }\n            _ => panic!(\"expected repl subcommand\"),\n        }\n    }\n\n    #[test]\n    fn repl_subcommand_parses_models_dir_override() {\n        let cli = Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"repl\",\n            \"--models-dir\",\n            \"/tmp/models\",\n            REPL_MODEL,\n        ])\n        .unwrap();\n\n        match cli.command {\n            Some(Subcommands::Repl {\n                resume, models_dir, ..\n            }) => {\n                assert_eq!(resume, None);\n                assert_eq!(models_dir, Some(PathBuf::from(\"/tmp/models\")));\n            }\n            _ => panic!(\"expected repl subcommand\"),\n        }\n    }\n\n    #[test]\n    fn repl_subcommand_parses_resume_after_model() {\n        let session_id = \"5169694d-de0f-40d1-890c-6e28e55bab27\";\n        let cli = Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"repl\",\n            REPL_MODEL,\n            \"--resume\",\n            session_id,\n        ])\n        .unwrap();\n\n        match cli.command {\n            Some(Subcommands::Repl { model, resume, .. }) => {\n                assert_eq!(model.as_deref(), Some(REPL_MODEL));\n                assert_eq!(resume.as_deref(), Some(session_id));\n            }\n            _ => panic!(\"expected repl subcommand\"),\n        }\n    }\n\n    #[test]\n    fn resume_subcommand_accepts_positional_chain_id() {\n        let chain_id = \"7ec82d7d-5f83-4be7-8868-b1ce3c9c3123\";\n        let command = parse_resume_subcommand([\"oulipoly-agent-runner\", \"resume\", chain_id]);\n\n        // Keep this layout-tolerant: Phase 6c may use flat fields or a flattened target Args struct.\n        assert_resume_debug_contains_option_field(command, \"chain_id\", chain_id);\n    }\n\n    #[test]\n    fn resume_subcommand_accepts_session_id_flag() {\n        let session_id = \"5169694d-de0f-40d1-890c-6e28e55bab27\";\n        let command = parse_resume_subcommand([\n            \"oulipoly-agent-runner\",\n            \"resume\",\n            \"--session-id\",\n            session_id,\n        ]);\n\n        assert_resume_debug_contains_option_field(command, \"session_id\", session_id);\n    }\n\n    #[test]\n    fn resume_subcommand_rejects_both_positional_and_session_id() {\n        let err = match Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"resume\",\n            \"7ec82d7d-5f83-4be7-8868-b1ce3c9c3123\",\n            \"--session-id\",\n            \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n        ]) {\n            Ok(_) => panic!(\"expected clap to reject both resume target forms\"),\n            Err(err) => err,\n        };\n\n        assert_eq!(err.kind(), clap::error::ErrorKind::ArgumentConflict);\n    }\n\n    #[test]\n    fn resume_subcommand_rejects_no_target() {\n        let err = match Cli::try_parse_from([\"oulipoly-agent-runner\", \"resume\"]) {\n            Ok(_) => panic!(\"expected clap to reject resume without a target\"),\n            Err(err) => err,\n        };\n\n        assert_eq!(err.kind(), clap::error::ErrorKind::MissingRequiredArgument);\n    }\n\n    #[test]\n    fn resume_subcommand_dispatch_routes_positional_to_run_resume_arg() {\n        let chain_id = \"7ec82d7d-5f83-4be7-8868-b1ce3c9c3123\";\n        let command = parse_resume_subcommand([\"oulipoly-agent-runner\", \"resume\", chain_id]);\n\n        // Parser-level proxy for dispatch: the field selected by the Resume arm must hold\n        // the positional target unchanged so Phase 6c can pass it directly to run_resume.\n        assert_resume_debug_contains_option_field(command, \"chain_id\", chain_id);\n    }\n\n    #[test]\n    fn resume_subcommand_parses_answer_file_and_project() {\n        let session_id = \"5169694d-de0f-40d1-890c-6e28e55bab27\";\n        let cli = Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"resume\",\n            \"-m\",\n            REPL_MODEL,\n            \"--session-id\",\n            session_id,\n            \"-f\",\n            \"/tmp/answer.md\",\n            \"-p\",\n            \"/tmp/project\",\n            \"--models-dir\",\n            \"/tmp/models\",\n        ])\n        .unwrap();\n\n        match cli.command {\n            Some(Subcommands::Resume {\n                model,\n                session_id: parsed_session,\n                rotate_provider: _,\n                prompt,\n                file,\n                project,\n                models_dir,\n                ..\n            }) => {\n                assert_eq!(model.as_deref(), Some(REPL_MODEL));\n                assert_eq!(\n                    resume_session_field_as_deref(&parsed_session),\n                    Some(session_id)\n                );\n                assert_eq!(prompt, None);\n                assert_eq!(file, Some(PathBuf::from(\"/tmp/answer.md\")));\n                assert_eq!(project, Some(PathBuf::from(\"/tmp/project\")));\n                assert_eq!(models_dir, Some(PathBuf::from(\"/tmp/models\")));\n            }\n            _ => panic!(\"expected resume subcommand\"),\n        }\n    }\n\n    #[test]\n    fn resume_subcommand_parses_inline_prompt() {\n        let cli = Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"resume\",\n            \"-m\",\n            REPL_MODEL,\n            \"--session-id\",\n            \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n            \"--prompt\",\n            \"answer text\",\n        ])\n        .unwrap();\n\n        match cli.command {\n            Some(Subcommands::Resume { prompt, file, .. }) => {\n                assert_eq!(prompt.as_deref(), Some(\"answer text\"));\n                assert_eq!(file, None);\n            }\n            _ => panic!(\"expected resume subcommand\"),\n        }\n    }\n\n    #[test]\n    fn resume_subcommand_rejects_prompt_and_file_together() {\n        let err = match Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"resume\",\n            \"-m\",\n            REPL_MODEL,\n            \"--session-id\",\n            \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n            \"--prompt\",\n            \"answer text\",\n            \"-f\",\n            \"/tmp/answer.md\",\n        ]) {\n            Ok(_) => panic!(\"expected clap to reject --prompt with --file\"),\n            Err(err) => err,\n        };\n\n        let rendered = err.to_string();\n        assert!(\n            rendered.contains(\"--prompt\") || rendered.contains(\"--file\"),\n            \"{rendered}\"\n        );\n    }\n\n    #[test]\n    fn repl_subcommand_parses_resume_before_model() {\n        let session_id = \"5169694d-de0f-40d1-890c-6e28e55bab27\";\n        let cli = Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"repl\",\n            \"--resume\",\n            session_id,\n            REPL_MODEL,\n        ])\n        .unwrap();\n\n        match cli.command {\n            Some(Subcommands::Repl { model, resume, .. }) => {\n                assert_eq!(model.as_deref(), Some(REPL_MODEL));\n                assert_eq!(resume.as_deref(), Some(session_id));\n            }\n            _ => panic!(\"expected repl subcommand\"),\n        }\n    }\n\n    #[test]\n    fn repl_subcommand_allows_missing_model_with_resume() {\n        let cli = Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"repl\",\n            \"--resume\",\n            \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n        ])\n        .unwrap();\n\n        match cli.command {\n            Some(Subcommands::Repl { model, resume, .. }) => {\n                assert_eq!(model, None);\n                assert_eq!(\n                    resume.as_deref(),\n                    Some(\"5169694d-de0f-40d1-890c-6e28e55bab27\")\n                );\n            }\n            _ => panic!(\"expected repl subcommand\"),\n        }\n    }\n\n    #[test]\n    fn repl_subcommand_requires_resume_value() {\n        let err =\n            match Cli::try_parse_from([\"oulipoly-agent-runner\", \"repl\", REPL_MODEL, \"--resume\"]) {\n                Ok(_) => panic!(\"expected clap to reject --resume without a value\"),\n                Err(err) => err,\n            };\n\n        let rendered = err.to_string();\n        assert!(rendered.contains(\"--resume\"), \"{rendered}\");\n    }\n\n    #[test]\n    fn repl_subcommand_rejects_extra_positional_arguments() {\n        let err = match Cli::try_parse_from([\"oulipoly-agent-runner\", \"repl\", REPL_MODEL, \"extra\"])\n        {\n            Ok(_) => panic!(\"expected clap to reject extra repl positional arguments\"),\n            Err(err) => err,\n        };\n\n        let rendered = err.to_string();\n        assert!(rendered.contains(\"extra\"), \"{rendered}\");\n    }\n\n    #[test]\n    fn resolve_parent_invocation_id_returns_none_when_env_is_unset() {\n        let db = test_db();\n\n        with_parent_invocation_env(None, || {\n            assert_eq!(resolve_parent_invocation_id(&db), None);\n        });\n    }\n\n    #[test]\n    fn resolve_parent_invocation_id_returns_existing_parent_rowid() {\n        let db = test_db();\n        let parent = CompositeInvocationId {\n            source: \"fixture-provider\".to_string(),\n            id: Uuid::new_v4().to_string(),\n        };\n        let row_id = db\n            .start_invocation(&InvocationStart {\n                invocation_uuid: parent.id.clone(),\n                model_name: \"fixture-model\".to_string(),\n                provider_name: parent.source.clone(),\n                provider_index: 0,\n                parent_invocation_id: None,\n            })\n            .unwrap();\n        let parent_env = serde_json::to_string(&parent).unwrap();\n\n        with_parent_invocation_env(Some(&parent_env), || {\n            assert_eq!(resolve_parent_invocation_id(&db), Some(row_id));\n        });\n    }\n\n    #[test]\n    fn resolve_parent_invocation_id_uses_same_db_uuid_despite_source_name_drift() {\n        let db = test_db();\n        let parent = CompositeInvocationId {\n            source: \"renamed-provider\".to_string(),\n            id: Uuid::new_v4().to_string(),\n        };\n        let row_id = db\n            .start_invocation(&InvocationStart {\n                invocation_uuid: parent.id.clone(),\n                model_name: \"fixture-model\".to_string(),\n                provider_name: \"fixture-provider\".to_string(),\n                provider_index: 0,\n                parent_invocation_id: None,\n            })\n            .unwrap();\n        db.finalize_invocation(row_id, false, 1, None, Some(\"exit_nonzero\"))\n            .unwrap();\n        let parent_env = serde_json::to_string(&parent).unwrap();\n\n        with_parent_invocation_env(Some(&parent_env), || {\n            assert_eq!(resolve_parent_invocation_id(&db), Some(row_id));\n        });\n    }\n\n    #[test]\n    fn resolve_parent_invocation_id_returns_none_for_malformed_json() {\n        let db = test_db();\n        with_parent_invocation_env(Some(\"not-json\"), || {\n            assert_eq!(resolve_parent_invocation_id(&db), None);\n        });\n    }\n\n    #[test]\n    fn resolve_parent_invocation_id_returns_none_for_unknown_uuid() {\n        let db = test_db();\n        let raw = r#\"{\"source\":\"fixture-provider\",\"id\":\"00000000-0000-0000-0000-000000000000\"}\"#;\n        with_parent_invocation_env(Some(raw), || {\n            assert_eq!(resolve_parent_invocation_id(&db), None);\n        });\n    }\n\n    #[test]\n    fn resolve_parent_invocation_id_returns_none_for_invalid_uuid_format() {\n        let db = test_db();\n        let raw = r#\"{\"source\":\"fixture-provider\",\"id\":\"not-a-uuid\"}\"#;\n        with_parent_invocation_env(Some(raw), || {\n            assert_eq!(resolve_parent_invocation_id(&db), None);\n        });\n    }\n\n    #[test]\n    fn resume_short_line_helper_emits_for_non_tty_stderr() {\n        assert!(should_emit_resume_short_line(false));\n    }\n\n    #[test]\n    fn resume_short_line_helper_also_emits_for_tty_stderr() {\n        // The short [resume] -> <provider> line is unconditional per\n        // proposal §5: V10 (observable selection) wins over V15\n        // (caller-controlled surface) for this single line. The test\n        // pins the \"always-on\" guarantee against future drift.\n        assert!(should_emit_resume_short_line(true));\n    }\n\n    // risk: CLI surface; level: unit; source: proposal §11.1 CLI surface / A8.\n    #[test]\n    fn top_level_resume_parse_allows_missing_model_and_rotate_provider_flag() {\n        let cli = Cli::try_parse_from([\n            \"oulipoly-agent-runner\",\n            \"--resume\",\n            \"5169694d-de0f-40d1-890c-6e28e55bab27\",\n            \"--rotate-provider\",\n            \"provider2\",\n            \"continue\",\n        ])\n        .unwrap();\n\n        assert!(cli.command.is_none());\n        assert_eq!(cli.model, None);\n        assert_eq!(\n            cli.resume.as_deref(),\n            Some(\"5169694d-de0f-40d1-890c-6e28e55bab27\")\n        );\n        assert_eq!(cli.rotate_provider.as_deref(), Some(\"provider2\"));\n    }\n}","lineStart":261,"lineEnd":1106,"totalLines":1106,"truncated":false}},"title":"src-tauri/src/dispatch.rs","time":{"start":1780923100592,"end":1780923100683}},"metadata":{"openai":{"itemId":"fc_00c41a6e73c1a15e016a26badc8238819b812e72453f9d38b0"}},"id":"prt_ea749ed96001uu4hiErIuMkGsE","sessionID":"ses_158b7240dffejD0kl19r2Asju7","messageID":"msg_ea7499e85001MsFrm8a67wqDdt"}}
{"type":"tool_use","timestamp":1780923100701,"sessionID":"ses_158b7240dffejD0kl19r2Asju7","part":{"type":"tool","tool":"read","callID":"call_uBBQmLKgG0qFGOCLPa6dyQT7","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/scripts/tests/opencode-turns.test.sh","offset":1,"limit":900},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/scripts/tests/opencode-turns.test.sh</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env bash\n2: #\n3: # Run from the repo root:\n4: #   cd <repo-root> && scripts/tests/opencode-turns.test.sh\n5: \n6: set -euo pipefail\n7: \n8: SCRIPT=\"$PWD/scripts/opencode-turns\"\n9: \n10: fail() {\n11:   echo \"$*\" >&2\n12:   exit 1\n13: }\n14: \n15: values_equal() {\n16:   [[ \"$1\" == \"$2\" ]]\n17: }\n18: \n19: assert_eq_failure_message() {\n20:   local label=\"$1\"\n21:   local expected=\"$2\"\n22:   local actual=\"$3\"\n23: \n24:   printf '%s: expected <%s>, got <%s>' \"$label\" \"$expected\" \"$actual\"\n25: }\n26: \n27: assert_eq() {\n28:   local actual=\"$1\"\n29:   local expected=\"$2\"\n30:   local label=\"$3\"\n31: \n32:   if ! values_equal \"$actual\" \"$expected\"; then\n33:     fail \"$(assert_eq_failure_message \"$label\" \"$expected\" \"$actual\")\"\n34:   fi\n35: }\n36: \n37: status_zero() {\n38:   [[ \"$1\" -eq 0 ]]\n39: }\n40: \n41: status_zero_failure_message() {\n42:   local label=\"$1\"\n43:   local status=\"$2\"\n44: \n45:   printf '%s: expected exit 0, got %s; stderr: %s' \"$label\" \"$status\" \"$(cat \"$RUN_STDERR\")\"\n46: }\n47: \n48: assert_status_zero() {\n49:   local status=\"$1\"\n50:   local label=\"$2\"\n51: \n52:   if ! status_zero \"$status\"; then\n53:     fail \"$(status_zero_failure_message \"$label\" \"$status\")\"\n54:   fi\n55: }\n56: \n57: stdout_contains_pattern() {\n58:   grep -Fq \"$1\" \"$RUN_STDOUT\"\n59: }\n60: \n61: stdout_contains_failure_message() {\n62:   local label=\"$1\"\n63:   local pattern=\"$2\"\n64: \n65:   printf '%s: stdout did not contain <%s>; stdout: %s' \"$label\" \"$pattern\" \"$(cat \"$RUN_STDOUT\")\"\n66: }\n67: \n68: assert_stdout_contains() {\n69:   local pattern=\"$1\"\n70:   local label=\"$2\"\n71: \n72:   if ! stdout_contains_pattern \"$pattern\"; then\n73:     fail \"$(stdout_contains_failure_message \"$label\" \"$pattern\")\"\n74:   fi\n75: }\n76: \n77: stdout_excludes_pattern() {\n78:   ! grep -Fq \"$1\" \"$RUN_STDOUT\"\n79: }\n80: \n81: stdout_unexpected_failure_message() {\n82:   local label=\"$1\"\n83:   local pattern=\"$2\"\n84: \n85:   printf '%s: stdout unexpectedly contained <%s>; stdout: %s' \"$label\" \"$pattern\" \"$(cat \"$RUN_STDOUT\")\"\n86: }\n87: \n88: assert_stdout_not_contains() {\n89:   local pattern=\"$1\"\n90:   local label=\"$2\"\n91: \n92:   if ! stdout_excludes_pattern \"$pattern\"; then\n93:     fail \"$(stdout_unexpected_failure_message \"$label\" \"$pattern\")\"\n94:   fi\n95: }\n96: \n97: assert_current_export_records() {\n98:   local label=\"$1\"\n99: \n100:   python3 - \"$RUN_STDOUT\" <<'PY' || fail \"$label: current-format export records did not match\"\n101: import json\n102: import sys\n103: \n104: path = sys.argv[1]\n105: with open(path, encoding=\"utf-8\") as handle:\n106:     records = [json.loads(line) for line in handle if line.strip()]\n107: \n108: expected = [\n109:     {\n110:         \"session_id\": \"ses_current_info\",\n111:         \"turn_id\": \"msg_user_current\",\n112:         \"timestamp\": \"2023-11-14T22:13:20Z\",\n113:         \"role\": \"user\",\n114:         \"body\": [\n115:             {\n116:                 \"type\": \"text\",\n117:                 \"text\": \"[OULIPOLY-DELIVERY 123e4567-e89b-12d3-a456-426614174000] wake please\",\n118:             }\n119:         ],\n120:     },\n121:     {\n122:         \"session_id\": \"ses_current_info\",\n123:         \"turn_id\": \"msg_assistant_current\",\n124:         \"timestamp\": \"2023-11-14T22:13:25Z\",\n125:         \"role\": \"assistant\",\n126:         \"body\": [{\"type\": \"text\", \"text\": \"confirmed\"}],\n127:     },\n128: ]\n129: \n130: if records != expected:\n131:     print(\"expected:\", json.dumps(expected, indent=2), file=sys.stderr)\n132:     print(\"actual:\", json.dumps(records, indent=2), file=sys.stderr)\n133:     raise SystemExit(1)\n134: PY\n135: }\n136: \n137: assert_session_id_env_export_records() {\n138:   local label=\"$1\"\n139: \n140:   python3 - \"$RUN_STDOUT\" <<'PY' || fail \"$label: SESSION_ID-env export records did not match\"\n141: import json\n142: import sys\n143: \n144: path = sys.argv[1]\n145: with open(path, encoding=\"utf-8\") as handle:\n146:     records = [json.loads(line) for line in handle if line.strip()]\n147: \n148: expected = [\n149:     {\n150:         \"session_id\": \"ses_env_requested\",\n151:         \"turn_id\": \"msg_user_env\",\n152:         \"timestamp\": \"2023-11-14T22:13:20Z\",\n153:         \"role\": \"user\",\n154:         \"body\": [{\"type\": \"text\", \"text\": \"wake via SESSION_ID env\"}],\n155:     },\n156:     {\n157:         \"session_id\": \"ses_env_requested\",\n158:         \"turn_id\": \"msg_assistant_env\",\n159:         \"timestamp\": \"2023-11-14T22:13:25Z\",\n160:         \"role\": \"assistant\",\n161:         \"body\": [{\"type\": \"text\", \"text\": \"confirmed via env\"}],\n162:     },\n163: ]\n164: \n165: if records != expected:\n166:     print(\"expected:\", json.dumps(expected, indent=2), file=sys.stderr)\n167:     print(\"actual:\", json.dumps(records, indent=2), file=sys.stderr)\n168:     raise SystemExit(1)\n169: PY\n170: }\n171: \n172: file_size_bytes() {\n173:   local path=\"$1\"\n174: \n175:   if [[ ! -f \"$path\" ]]; then\n176:     missing_file_size_bytes\n177:     return\n178:   fi\n179:   existing_file_size_bytes \"$path\"\n180: }\n181: \n182: existing_file_size_bytes() {\n183:   local path=\"$1\"\n184: \n185:   wc -c <\"$path\" | tr -d ' '\n186: }\n187: \n188: missing_file_size_bytes() {\n189:   echo 0\n190: }\n191: \n192: marker_size_sample() {\n193:   local marker=\"$1\"\n194: \n195:   file_size_bytes \"$marker\"\n196:   sleep 1\n197:   file_size_bytes \"$marker\"\n198: }\n199: \n200: marker_size_stable() {\n201:   [[ \"$1\" == \"$2\" ]]\n202: }\n203: \n204: marker_growth_failure_message() {\n205:   local label=\"$1\"\n206:   local before=\"$2\"\n207:   local after=\"$3\"\n208: \n209:   printf '%s: descendant marker kept growing after timeout kill (%s -> %s bytes)' \"$label\" \"$before\" \"$after\"\n210: }\n211: \n212: assert_marker_stopped_growing() {\n213:   local marker=\"$1\"\n214:   local label=\"$2\"\n215:   local -a sizes\n216:   local before after\n217: \n218:   mapfile -t sizes < <(marker_size_sample \"$marker\")\n219:   before=\"${sizes[0]}\"\n220:   after=\"${sizes[1]}\"\n221:   if ! marker_size_stable \"$before\" \"$after\"; then\n222:     fail \"$(marker_growth_failure_message \"$label\" \"$before\" \"$after\")\"\n223:   fi\n224: }\n225: \n226: process_state() {\n227:   local pid=\"$1\"\n228: \n229:   if ! process_exists \"$pid\"; then\n230:     absent_process_state\n231:     return\n232:   fi\n233:   read_process_state \"$pid\"\n234: }\n235: \n236: process_exists() {\n237:   local pid=\"$1\"\n238: \n239:   kill -0 \"$pid\" 2>/dev/null\n240: }\n241: \n242: read_process_state() {\n243:   local pid=\"$1\"\n244: \n245:   ps -o stat= -p \"$pid\" 2>/dev/null | tr -d ' ' || true\n246: }\n247: \n248: absent_process_state() {\n249:   echo absent\n250: }\n251: \n252: process_state_allowed() {\n253:   local state=\"$1\"\n254: \n255:   [[ \"$state\" == absent || \"$state\" == Z* ]]\n256: }\n257: \n258: process_running_failure_message() {\n259:   local label=\"$1\"\n260:   local pid=\"$2\"\n261:   local state=\"$3\"\n262: \n263:   printf '%s: descendant process %s survived timeout kill with state <%s>' \"$label\" \"$pid\" \"$state\"\n264: }\n265: \n266: assert_process_not_running() {\n267:   local pid=\"$1\"\n268:   local label=\"$2\"\n269:   local state\n270: \n271:   state=\"$(process_state \"$pid\")\"\n272:   if process_state_allowed \"$state\"; then\n273:     return\n274:   fi\n275:   fail \"$(process_running_failure_message \"$label\" \"$pid\" \"$state\")\"\n276: }\n277: \n278: write_executable_mock() {\n279:   local path=\"$1\"\n280:   local body_writer=\"$2\"\n281: \n282:   \"$body_writer\" >\"$path\"\n283:   chmod +x \"$path\"\n284: }\n285: \n286: emit_timestampless_cap_mock_body() {\n287:   cat <<'MOCK_OPENCODE'\n288: #!/usr/bin/env bash\n289: set -euo pipefail\n290: \n291: if [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n292:   cat <<'JSON'\n293: [\n294:   {\"id\":\"ses_cap_one\"},\n295:   {\"id\":\"ses_cap_two\"},\n296:   {\"id\":\"ses_cap_three\"},\n297:   {\"id\":\"ses_cap_four\"},\n298:   {\"id\":\"ses_cap_five\"}\n299: ]\n300: JSON\n301:   exit 0\n302: fi\n303: \n304: if [[ \"$1\" == \"export\" ]]; then\n305:   session_id=\"$2\"\n306:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n307:   printf '[{\"sessionID\":\"%s\",\"messageID\":\"turn-%s\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"role\":\"assistant\",\"content\":\"ok\"}]\\n' \"$session_id\" \"$session_id\"\n308:   exit 0\n309: fi\n310: \n311: echo \"unexpected opencode args: $*\" >&2\n312: exit 64\n313: MOCK_OPENCODE\n314: }\n315: \n316: write_timestampless_cap_mock() {\n317:   local path=\"$1\"\n318: \n319:   write_executable_mock \"$path\" emit_timestampless_cap_mock_body\n320: }\n321: \n322: emit_window_filter_mock_body() {\n323:   cat <<'MOCK_OPENCODE'\n324: #!/usr/bin/env bash\n325: set -euo pipefail\n326: \n327: if [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n328:   python3 - <<'PY'\n329: import json\n330: from datetime import datetime, timedelta, timezone\n331: \n332: now = datetime.now(timezone.utc)\n333: sessions = [\n334:     {\"id\": \"ses_recent_one\", \"updatedAt\": (now - timedelta(hours=1)).isoformat().replace(\"+00:00\", \"Z\")},\n335:     {\"sessionID\": \"ses_recent_two\", \"createdAt\": (now - timedelta(hours=5)).isoformat().replace(\"+00:00\", \"Z\")},\n336:     {\"sessionId\": \"ses_old\", \"updatedAt\": (now - timedelta(hours=9)).isoformat().replace(\"+00:00\", \"Z\")},\n337:     {\"id\": \"ses_without_timestamp\"},\n338: ]\n339: print(json.dumps(sessions))\n340: PY\n341:   exit 0\n342: fi\n343: \n344: if [[ \"$1\" == \"export\" ]]; then\n345:   session_id=\"$2\"\n346:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n347:   printf '[{\"sessionID\":\"%s\",\"messageID\":\"turn-%s\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"role\":\"assistant\",\"content\":\"ok\"}]\\n' \"$session_id\" \"$session_id\"\n348:   exit 0\n349: fi\n350: \n351: echo \"unexpected opencode args: $*\" >&2\n352: exit 64\n353: MOCK_OPENCODE\n354: }\n355: \n356: write_window_filter_mock() {\n357:   local path=\"$1\"\n358: \n359:   write_executable_mock \"$path\" emit_window_filter_mock_body\n360: }\n361: \n362: emit_timeout_mock_body() {\n363:   cat <<'MOCK_OPENCODE'\n364: #!/usr/bin/env bash\n365: set -euo pipefail\n366: \n367: if [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n368:   cat <<'JSON'\n369: [\n370:   {\"id\":\"ses_fast\"},\n371:   {\"id\":\"ses_slow\"}\n372: ]\n373: JSON\n374:   exit 0\n375: fi\n376: \n377: if [[ \"$1\" == \"export\" ]]; then\n378:   session_id=\"$2\"\n379:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n380:   if [[ \"$session_id\" == \"ses_slow\" ]]; then\n381:     sleep 5\n382:   fi\n383:   printf '[{\"sessionID\":\"%s\",\"messageID\":\"turn-%s\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"role\":\"assistant\",\"content\":\"ok\"}]\\n' \"$session_id\" \"$session_id\"\n384:   exit 0\n385: fi\n386: \n387: echo \"unexpected opencode args: $*\" >&2\n388: exit 64\n389: MOCK_OPENCODE\n390: }\n391: \n392: write_timeout_mock() {\n393:   local path=\"$1\"\n394: \n395:   write_executable_mock \"$path\" emit_timeout_mock_body\n396: }\n397: \n39