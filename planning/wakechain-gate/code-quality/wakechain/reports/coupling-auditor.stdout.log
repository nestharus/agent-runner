e((min_seq, max_seq)) = pending_bounds else {\n475:             tx.commit()\n476:                 .map_err(|err| format!(\"Failed to commit empty wake claim transaction: {err}\"))?;\n477:             return Ok(WakeClaimAcquireResult::NoPending);\n478:         };\n479:         if let Some(existing) = fresh_in_flight_wake_claim(\n480:             &tx,\n481:             wake_claim_tx(&tx, input.session_id)?,\n482:             input.stale_after_seconds,\n483:             renew_token,\n484:         )? {\n485:             tx.commit().map_err(|err| {\n486:                 format!(\"Failed to commit existing wake claim transaction: {err}\")\n487:             })?;\n488:             return Ok(WakeClaimAcquireResult::AlreadyInFlight(existing));\n489:         }\n490:         let claim = acquire_wake_claim_tx(&tx, input, &now, min_seq, max_seq)?;\n491:         tx.commit()\n492:             .map_err(|err| format!(\"Failed to commit wake claim transaction: {err}\"))?;\n493:         Ok(WakeClaimAcquireResult::Acquired(claim))\n494:     }\n495: \n496:     pub fn wake_claim(&self, session_id: &str) -> Result<Option<WakeClaimRow>, String> {\n497:         wake_claim(&self.conn, session_id)\n498:     }\n499: \n500:     pub fn release_wake_claim(\n501:         &mut self,\n502:         session_id: &str,\n503:         claim_token: Option<&str>,\n504:     ) -> Result<bool, String> {\n505:         let changed = match claim_token {\n506:             Some(token) => self.conn.execute(\n507:                 \"DELETE FROM session_wake_claim WHERE session_id = ?1 AND claim_token = ?2\",\n508:                 params![session_id, token],\n509:             ),\n510:             None => self.conn.execute(\n511:                 \"DELETE FROM session_wake_claim WHERE session_id = ?1\",\n512:                 params![session_id],\n513:             ),\n514:         }\n515:         .map_err(|err| format!(\"Failed to release wake claim: {err}\"))?;\n516:         Ok(changed > 0)\n517:     }\n518: \n519:     pu