ken: String,\n160:     pub claimed_at: String,\n161:     pub wake_pid: Option<i64>,\n162:     pub wake_invocation_uuid: Option<String>,\n163:     pub reason: String,\n164:     pub auto_wake_count: i64,\n165:     pub min_pending_seq_at_claim: Option<i64>,\n166:     pub max_pending_seq_at_claim: Option<i64>,\n167: }\n168: \n169: #[derive(Debug, Clone, PartialEq, Eq)]\n170: pub struct WakeSweepCandidate {\n171:     pub session_id: String,\n172:     pub auto_wake_count: i64,\n173:     pub min_pending_seq: i64,\n174:     pub max_pending_seq: i64,\n175: }\n176: \n177: pub struct MailboxDb {\n178:     conn: Connection,\n179:     path: PathBuf,\n180: }\n181: \n182: impl MailboxDb {\n183:     pub fn default_path() -> Result<PathBuf, String> {\n184:         pid_identity::default_path()\n185:     }\n186: \n187:     pub fn open_default() -> Result<Self, String> {\n188:         let path = Self::default_path()?;\n189:         Self::open(&path)\n190:     }\n191: \n192:     pub fn open_default_if_exists() -> Result<Option<Self>, String> {\n193:         let path = Self::default_path()?;\n194:         if !path.exists() {\n195:             return Ok(None);\n196:         }\n197:         Self::open(&path).map(Some)\n198:     }\n199: \n200:     pub fn open(path: &Path) -> Result<Self, String> {\n201:         ensure_parent_dir(path)?;\n202:         let conn = Connection::open(path)\n203:             .map_err(|err| format!(\"Failed to open PID mailbox sidecar: {err}\"))?;\n204:         set_wal_mode(&conn)?;\n205:         pid_identity::ensure_identity_schema(&conn)?;\n206:         ensure_mailbox_schema(&conn)?;\n207:         Ok(Self {\n208:             conn,\n209:             path: path.to_path_buf(),\n210:         })\n211:     }\n212: \n213:     pub fn open_read_only(path: &Path) -> Result<Self, String> {\n214:         let conn = Connection::open_with_flags(path, OpenFlags::SQLITE_OPEN_READ_ONLY)\n215:             .map_err(|err| format!(\"Failed to open PID mailbox sidecar read-only: {err}\"))?;\n216:         Ok(Self {\n217:             conn,\n218:             path: path.to_path_buf(),\n219:         })\n220:     }\n221: \n222:     pub fn path(&self) -> &Path {\n223:         &self.path\n224:     }\n225: \n226:     pub fn connection(&self) -> &Connection {\n227:         &self.conn\n228:     }\n229: \n230:     pub fn enqueue_agent_bash_complete(\n231:         &mut self,\n232:         input: &AgentBashCompleteEnqueue<'_>,\n233:     ) -> Result<EnqueueResult, String> {\n234:         let now = now_rfc3339();\n235:         let tx = self\n236:             .conn\n237:             .transaction()\n238:             .map_err(|err| format!(\"Failed to start mailbox enqueue transaction: {err}\"))?;\n239:         let result = enqueue_agent_bash_complete_in_tx(&tx, input, &now)?;\n240:         tx.commit()\n\n(Showing lines 1-240 of 2145. Use offset=241 to continue.)\n</content>","metadata":{"preview":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n//! `predicate`, `validator`\n//!\n//! Resume-backed notification mailbox storage in the PID identity sidecar DB.\n//! This module deliberately owns only additive sidecar tables and never touches\n//! the versioned `state.db` schema.\n\nuse chrono::{DateTime, Duration, SecondsFormat, Utc};\nuse rusqlite::{Connection, OpenFlags, OptionalExtension, params};\nuse serde::Serialize;\nuse std::path::{Path, PathBuf};\n\nuse crate::pid_identity::{self, ProcessIdentity};\n\npub const AGENT_BASH_COMPLETE_KIND: &str = \"agent_bash_complete\";\npub const WAKE_SWEEP_ABANDONED_ERROR: &str = \"wake_sweep_abandoned\";\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize)]","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/crates/oulipoly-state/src/mailbox.rs","text":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n//! `predicate`, `validator`\n//!\n//! Resume-backed notification mailbox storage in the PID identity sidecar DB.\n//! This module deliberately owns only additive sidecar tables and never touches\n//! the versioned `state.db` schema.\n\nuse chrono::{DateTime, Duration, SecondsFormat, Utc};\nuse rusqlite::{Connection, OpenFlags, OptionalExtension, params};\nuse serde::Serialize;\nuse std::path::{Path, PathBuf};\n\nuse crate::pid_identity::{self, ProcessIdentity};\n\npub const AGENT_BASH_COMPLETE_KIND: &str = \"agent_bash_complete\";\npub const WAKE_SWEEP_ABANDONED_ERROR: &str = \"wake_sweep_abandoned\";\n\n#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\npub struct MailboxRow {\n    pub seq: i64,\n    pub session_id: String,\n    pub kind: String,\n    pub handle: String,\n    pub payload_json: String,\n    pub enqueued_at: String,\n    pub delivered_at: Option<String>,\n    pub delivered_by_invocation_uuid: Option<String>,\n    pub delivery_attempts: i64,\n    pub delivery_error: Option<String>,\n    pub owner_invocation_uuid: Option<String>,\n    pub matched_os_pid: Option<i64>,\n    pub matched_os_boot_id: Option<String>,\n    pub matched_os_pid_starttime_ticks: Option<i64>,\n    pub matched_chain_index: Option<i64>,\n    pub state_dir: String,\n    pub meta_path: String,\n    pub log_path: String,\n    pub rc_path: String,\n    pub rc: i32,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct AgentBashCompleteEnqueue<'a> {\n    pub session_id: &'a str,\n    pub handle: &'a str,\n    pub payload_json: &'a str,\n    pub owner_invocation_uuid: Option<&'a str>,\n    pub matched_os_pid: Option<i64>,\n    pub matched_os_boot_id: Option<&'a str>,\n    pub matched_os_pid_starttime_ticks: Option<i64>,\n    pub matched_chain_index: Option<i64>,\n    pub state_dir: &'a str,\n    pub meta_path: &'a str,\n    pub log_path: &'a str,\n    pub rc_path: &'a str,\n    pub rc: i32,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum EnqueueResult {\n    Inserted(MailboxRow),\n    AlreadyEnqueued(MailboxRow),\n    Conflict { existing: MailboxRow },\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct SessionRuntimeUpsert<'a> {\n    pub session_id: &'a str,\n    pub mode: &'a str,\n    pub invocation_uuid: Option<&'a str>,\n    pub provider_name: Option<&'a str>,\n    pub model_name: Option<&'a str>,\n    pub pty_control_path: Option<&'a str>,\n    pub models_dir: Option<&'a str>,\n    pub effective_cwd: Option<&'a str>,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct SessionRuntimeRunningUpdate<'a> {\n    pub session_id: &'a str,\n    pub mode: &'a str,\n    pub invocation_uuid: &'a str,\n    pub provider_name: Option<&'a str>,\n    pub model_name: Option<&'a str>,\n    pub identity: &'a ProcessIdentity,\n    pub pty_control_path: Option<&'a str>,\n    pub turn_start_max_mailbox_seq: Option<i64>,\n    pub models_dir: Option<&'a str>,\n    pub effective_cwd: Option<&'a str>,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct SessionRuntimeIdleUpdate<'a> {\n    pub session_id: &'a str,\n    pub invocation_uuid: &'a str,\n    pub last_exit_code: Option<i32>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct SessionRuntimeRow {\n    pub session_id: String,\n    pub mode: String,\n    pub invocation_uuid: Option<String>,\n    pub provider_name: Option<String>,\n    pub model_name: Option<String>,\n    pub pty_control_path: Option<String>,\n    pub updated_at: String,\n    pub run_state: String,\n    pub running_invocation_uuid: Option<String>,\n    pub running_os_pid: Option<i64>,\n    pub running_os_boot_id: Option<String>,\n    pub running_os_pid_starttime_ticks: Option<i64>,\n    pub turn_started_at: Option<String>,\n    pub turn_ended_at: Option<String>,\n    pub turn_start_max_mailbox_seq: Option<i64>,\n    pub last_exit_code: Option<i32>,\n    pub models_dir: Option<String>,\n    pub effective_cwd: Option<String>,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum SessionLiveness {\n    Busy,\n    Idle,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\nenum SessionRuntimeLivenessDecision {\n    Busy,\n    Idle,\n    Stale {\n        running_invocation_uuid: Option<String>,\n    },\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct WakeClaimRequest<'a> {\n    pub session_id: &'a str,\n    pub claim_token: &'a str,\n    pub reason: &'a str,\n    pub auto_wake_count: i64,\n    pub wake_invocation_uuid: Option<&'a str>,\n    pub stale_after_seconds: i64,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum WakeClaimAcquireResult {\n    Acquired(WakeClaimRow),\n    NoPending,\n    Busy,\n    AlreadyInFlight(WakeClaimRow),\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct WakeClaimRow {\n    pub session_id: String,\n    pub claim_token: String,\n    pub claimed_at: String,\n    pub wake_pid: Option<i64>,\n    pub wake_invocation_uuid: Option<String>,\n    pub reason: String,\n    pub auto_wake_count: i64,\n    pub min_pending_seq_at_claim: Option<i64>,\n    pub max_pending_seq_at_claim: Option<i64>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct WakeSweepCandidate {\n    pub session_id: String,\n    pub auto_wake_count: i64,\n    pub min_pending_seq: i64,\n    pub max_pending_seq: i64,\n}\n\npub struct MailboxDb {\n    conn: Connection,\n    path: PathBuf,\n}\n\nimpl MailboxDb {\n    pub fn default_path() -> Result<PathBuf, String> {\n        pid_identity::default_path()\n    }\n\n    pub fn open_default() -> Result<Self, String> {\n        let path = Self::default_path()?;\n        Self::open(&path)\n    }\n\n    pub fn open_default_if_exists() -> Result<Option<Self>, String> {\n        let path = Self::default_path()?;\n        if !path.exists() {\n            return Ok(None);\n        }\n        Self::open(&path).map(Some)\n    }\n\n    pub fn open(path: &Path) -> Result<Self, String> {\n        ensure_parent_dir(path)?;\n        let conn = Connection::open(path)\n            .map_err(|err| format!(\"Failed to open PID mailbox sidecar: {err}\"))?;\n        set_wal_mode(&conn)?;\n        pid_identity::ensure_identity_schema(&conn)?;\n        ensure_mailbox_schema(&conn)?;\n        Ok(Self {\n            conn,\n            path: path.to_path_buf(),\n        })\n    }\n\n    pub fn open_read_only(path: &Path) -> Result<Self, String> {\n        let conn = Connection::open_with_flags(path, OpenFlags::SQLITE_OPEN_READ_ONLY)\n            .map_err(|err| format!(\"Failed to open PID mailbox sidecar read-only: {err}\"))?;\n        Ok(Self {\n            conn,\n            path: path.to_path_buf(),\n        })\n    }\n\n    pub fn path(&self) -> &Path {\n        &self.path\n    }\n\n    pub fn connection(&self) -> &Connection {\n        &self.conn\n    }\n\n    pub fn enqueue_agent_bash_complete(\n        &mut self,\n        input: &AgentBashCompleteEnqueue<'_>,\n    ) -> Result<EnqueueResult, String> {\n        let now = now_rfc3339();\n        let tx = self\n            .conn\n            .transaction()\n            .map_err(|err| format!(\"Failed to start mailbox enqueue transaction: {err}\"))?;\n        let result = enqueue_agent_bash_complete_in_tx(&tx, input, &now)?;\n        tx.commit()","lineStart":1,"lineEnd":240,"totalLines":2145,"truncated":true}},"title":"crates/oulipoly-state/src/mailbox.rs","time":{"start":1780923110678,"end":1780923110810}},"metadata":{"openai":{"itemId":"fc_0bb18758e859da8f016a26bae6736c819896a9a0395afa6ec3"}},"id":"prt_ea74a150f001jkXkJdHoB1mhe6","sessionID":"ses_158b7240dffejD0kl19r2Asju7","messageID":"msg_ea749eeb0001CXFCyGd4yl62lt"}}
