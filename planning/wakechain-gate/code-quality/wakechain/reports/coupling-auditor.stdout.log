e sequencing\n40: //!       - provider retry and migration sequencing\n41: //!   - component: src-tauri/src/dispatch.rs::pre_invocation_failure_marker\n42: //!     role: intrinsic-surface\n43: //!     Domain: pre_invocation_failure_marker\n44: //!     Owns:\n45: //!       - emit_pre_invocation_failure\n46: //!       - pre_invocation_failure_payload\n47: //!       - pre_invocation_failure_message\n48: //!       - emit_pool_exhausted_pre_invocation_failure\n49: //!       - emit_provider_selection_pre_invocation_failure\n50: //!       - emit_provider_resolution_pre_invocation_failure\n51: //!       - OULIPOLY_FAILURE marker line\n52: //!       - OULIPOLY_FAILURE payload field set\n53: //!       - model_provider_names\n54: //! ```\n55: \n56: use oulipoly_runtime::session_replace;\n57: \n58: use crate::cli::inputs::{TopLevelResumePromptSource, resolve_top_level_resume_prompt_source};\n59: use crate::resume_cli::format_resume_error;\n60: use crate::usage::cli::{\n61:     Cli, MailboxSubcommands, NotifySubcommands, SessionSubcommands, Subcommands,\n62: };\n63: use crate::{commands, run, usage, wiring};\n64: \n65: mod clock;\n66: mod formatter;\n67: mod parent_invocation;\n68: mod parser;\n69: mod pre_invocation_failure;\n70: mod predicate;\n71: mod usage_context;\n72: \n73: pub(crate) use clock::utc_now;\n74: pub(crate) use formatter::format_timestamp_rfc3339;\n75: pub(crate) use parent_invocation::resolve_parent_invocation_id;\n76: pub(crate) use parser::provider_session_marker_uuid;\n77: use parser::resume_target_arg;\n78: pub(crate) use pre_invocation_failure::emit_pre_invocation_failure;\n79: pub(crate) use predicate::{\n80:     diagnostics_model_configured, execution_succeeded, should_emit_resume_short_line,\n81: };\n82: \n83: pub(crate) fn run(cli: Cli) -> Result<i32, String> {\n84:     if let Err(err) = recover_pending_session_replaces() {\n85:         return Ok(handle_pending_session_replace_error(&err));\n86:     }\n87:     if startup_wake_reclaim_sweep_enabled(&c