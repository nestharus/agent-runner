{"type":"tool_use","timestamp":1780923053024,"sessionID":"ses_158b7240dffejD0kl19r2Asju7","part":{"type":"tool","tool":"read","callID":"call_6oGss9Lcgns2rnhJyTnjwIoR","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/planning/wakechain-gate/gates/diff.patch","offset":1,"limit":3000},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/planning/wakechain-gate/gates/diff.patch</path>\n<type>file</type>\n<content>\n1: diff --git a/crates/oulipoly-runtime/src/sessions/mod.rs b/crates/oulipoly-runtime/src/sessions/mod.rs\n2: index bdc79dc..09cfe45 100644\n3: --- a/crates/oulipoly-runtime/src/sessions/mod.rs\n4: +++ b/crates/oulipoly-runtime/src/sessions/mod.rs\n5: @@ -101,6 +101,23 @@ pub fn scan_provider(\n6:      scan_provider_with_timeout(provider_name, sessions_cfg, db, SCRIPT_TIMEOUT_SECS)\n7:  }\n8:  \n9: +/// Run one provider's adapter script for a specific session and ingest every\n10: +/// turn it emits. The configured script receives `SESSION_ID` in its env.\n11: +pub fn scan_provider_session(\n12: +    provider_name: &str,\n13: +    sessions_cfg: &SessionsConfig,\n14: +    db: &StateDb,\n15: +    session_id: &str,\n16: +) -> ScanReport {\n17: +    scan_provider_session_with_timeout(\n18: +        provider_name,\n19: +        sessions_cfg,\n20: +        db,\n21: +        session_id,\n22: +        SCRIPT_TIMEOUT_SECS,\n23: +    )\n24: +}\n25: +\n26:  fn scan_provider_with_timeout(\n27:      provider_name: &str,\n28:      sessions_cfg: &SessionsConfig,\n29: @@ -127,6 +144,39 @@ fn scan_provider_with_timeout(\n30:      report\n31:  }\n32:  \n33: +fn scan_provider_session_with_timeout(\n34: +    provider_name: &str,\n35: +    sessions_cfg: &SessionsConfig,\n36: +    db: &StateDb,\n37: +    session_id: &str,\n38: +    timeout_secs: u64,\n39: +) -> ScanReport {\n40: +    let mut report = ScanReport::default();\n41: +    let Some(entry) = provider_session_source(sessions_cfg, provider_name) else {\n42: +        return report;\n43: +    };\n44: +\n45: +    let state_dir = resolve_state_dir(provider_name, entry);\n46: +    if let Err(error) = create_session_state_dir(&state_dir) {\n47: +        return scan_report_with_error(report, error);\n48: +    }\n49: +\n50: +    let stdout = match run_session_script_with_timeout(\n51: +        &entry.turn_script,\n52: +        &state_dir,\n53: +        Some(session_id),\n54: +        \"turn script\",\n55: +        timeout_secs,\n56: +    ) {\n57: +        Ok(stdout) => stdout,\n58: +        Err(error) => return scan_report_with_error(report, error),\n59: +    };\n60: +\n61: +    let batch = collect_turn_script_batch(provider_name, &stdout, &mut report);\n62: +    persist_scanned_turns(provider_name, db, &batch, &mut report);\n63: +    report\n64: +}\n65: +\n66:  fn provider_session_source<'a>(\n67:      sessions_cfg: &'a SessionsConfig,\n68:      provider_name: &str,\n69: @@ -758,14 +808,38 @@ mod tests {\n70:  \n71:      fn fixture_script(body: &str) -> Fixture {\n72:          let dir = tempfile::tempdir().unwrap();\n73: -        let path = dir.path().join(\"turn-script.sh\");\n74: -        std::fs::write(&path, format!(\"#!/usr/bin/env bash\\n{body}\\n\")).unwrap();\n75: -        let mut perms = std::fs::metadata(&path).unwrap().permissions();\n76: -        perms.set_mode(0o755);\n77: -        std::fs::set_permissions(&path, perms).unwrap();\n78: +        let path = fixture_script_path(dir.path());\n79: +        write_script_file(&path, &formatted_fixture_script(body));\n80: +        make_script_executable(&path);\n81:          Fixture { _dir: dir, path }\n82:      }\n83:  \n84: +    fn fixture_script_path(dir: &std::path::Path) -> std::path::PathBuf {\n85: +        dir.join(\"turn-script.sh\")\n86: +    }\n87: +\n88: +    fn formatted_fixture_script(body: &str) -> String {\n89: +        format!(\"#!/usr/bin/env bash\\n{body}\\n\")\n90: +    }\n91: +\n92: +    fn write_script_file(path: &std::path::Path, contents: &str) {\n93: +        std::fs::write(path, contents).unwrap();\n94: +    }\n95: +\n96: +    fn make_script_executable(path: &std::path::Path) {\n97: +        let permissions = executable_permissions(script_permissions(path));\n98: +        std::fs::set_permissions(path, permissions).unwrap();\n99: +    }\n100: +\n101: +    fn script_permissions(path: &std::path::Path) -> std::fs::Permissions {\n102: +        std::fs::metadata(path).unwrap().permissions()\n103: +    }\n104: +\n105: +    fn executable_permissions(mut permissions: std::fs::Permissions) -> std::fs::Permissions {\n106: +        permissions.set_mode(0o755);\n107: +        permissions\n108: +    }\n109: +\n110:      fn cfg_with(provider: &str, script_path: &std::path::Path) -> SessionsConfig {\n111:          let mut entries = HashMap::new();\n112:          entries.insert(\n113: @@ -796,6 +870,159 @@ mod tests {\n114:          SessionsConfig { entries }\n115:      }\n116:  \n117: +    fn cfg_with_state_dir(\n118: +        provider: &str,\n119: +        script_path: &std::path::Path,\n120: +        state_dir: std::path::PathBuf,\n121: +    ) -> SessionsConfig {\n122: +        let mut entries = HashMap::new();\n123: +        entries.insert(\n124: +            provider.to_string(),\n125: +            SessionSourceEntry {\n126: +                turn_script: script_path.to_string_lossy().into_owned(),\n127: +                transcript_locator: None,\n128: +                state_dir: Some(state_dir),\n129: +            },\n130: +        );\n131: +        SessionsConfig { entries }\n132: +    }\n133: +\n134: +    fn stored_turn_body(\n135: +        db: &StateDb,\n136: +        provider_name: &str,\n137: +        session_id: &str,\n138: +        turn_id: &str,\n139: +    ) -> String {\n140: +        db.connection()\n141: +            .query_row(\n142: +                \"SELECT body FROM session_turns\n143: +                 WHERE provider_name = ?1 AND session_id = ?2 AND turn_id = ?3\",\n144: +                rusqlite::params![provider_name, session_id, turn_id],\n145: +                |row| row.get(0),\n146: +            )\n147: +            .unwrap()\n148: +    }\n149: +\n150: +    fn parsed_json_value(raw: &str) -> serde_json::Value {\n151: +        serde_json::from_str(raw).unwrap()\n152: +    }\n153: +\n154: +    fn assert_edge_body_preserved(body: &serde_json::Value) {\n155: +        assert_eq!(body, &expected_edge_body());\n156: +    }\n157: +\n158: +    fn expected_edge_body() -> serde_json::Value {\n159: +        serde_json::json!([{\"type\":\"text\",\"text\":\"line one\\n日本語\\n{\\\"escaped\\\":true}\\u{0007}\"}])\n160: +    }\n161: +\n162: +    fn all_invalid_body_shape_errors(errors: &[String]) -> bool {\n163: +        errors.iter().all(|error| {\n164: +            error.contains(\"invalid body shape\")\n165: +                && error.contains(\"expected canonical content chunk array\")\n166: +        })\n167: +    }\n168: +\n169: +    fn stored_turn_bodies(\n170: +        db: &StateDb,\n171: +        provider_name: &str,\n172: +        session_id: &str,\n173: +    ) -> Vec<Option<String>> {\n174: +        db.connection()\n175: +            .prepare(\n176: +                \"SELECT body FROM session_turns\n177: +                 WHERE provider_name = ?1 AND session_id = ?2\n178: +                 ORDER BY turn_id\",\n179: +            )\n180: +            .unwrap()\n181: +            .query_map(rusqlite::params![provider_name, session_id], |row| {\n182: +                row.get(0)\n183: +            })\n184: +            .unwrap()\n185: +            .map(Result::unwrap)\n186: +            .collect()\n187: +    }\n188: +\n189: +    fn leaked_marker_script(marker_path: &std::path::Path) -> String {\n190: +        format!(\n191: +            \"(sleep 2; printf leaked > {}) & wait\",\n192: +            marker_path.display()\n193: +        )\n194: +    }\n195: +\n196: +    fn assert_marker_does_not_exist(path: &std::path::Path) {\n197: +        assert!(