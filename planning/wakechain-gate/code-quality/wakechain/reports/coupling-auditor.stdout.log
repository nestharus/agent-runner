xecutionEnvironment,\n1295:     resolved: &mut oulipoly_state::ResolvedResume,\n1296:     target: &mut crate::resume_cli::ResumeExecutionTarget,\n1297:     manual_migrate: Option<&str>,\n1298:     attempts: usize,\n1299:     effective_spawn_cwd: &Path,\n1300: ) -> Result<(), i32> {\n1301:     if validate_provider_ref_default_migration_skip(resolved, target, manual_migrate)? {\n1302:         return Ok(());\n1303:     }\n1304:     let migration_model = migration_model_for_attempt(env, resolved, manual_migrate, attempts);\n1305:     let migration_result = dispatch_resume_migration(\n1306:         agent_runtime_services,\n1307:         env,\n1308:         resolved,\n1309:         manual_migrate,\n1310:         attempts,\n1311:         effective_spawn_cwd,\n1312:         &migration_model,\n1313:     );\n1314:     apply_resume_migration_result(env, resolved, target, migration_result)\n1315: }\n1316: \n1317: fn validate_provider_ref_default_migration_skip(\n1318:     resolved: &oulipoly_state::ResolvedResume,\n1319:     target: &crate::resume_cli::ResumeExecutionTarget,\n1320:     manual_migrate: Option<&str>,\n1321: ) -> Result<bool, i32> {\n1322:     if !should_skip_provider_ref_default_migration(resolved, manual_migrate) {\n1323:         return Ok(false);\n1324:     }\n1325:     validate_provider_ref_headless_resume_target(resolved, target, &resolved.active_provider)\n1326:         .map_err(|message| provider_ref_resume_block_exit_code(&message))?;\n1327:     Ok(true)\n1328: }\n1329: \n1330: fn apply_resume_migration_result(\n1331:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n1332:     resolved: &mut oulipoly_state::ResolvedResume,\n1333:     target: &mut crate::resume_cli::ResumeExecutionTarget,\n1334:     migration_result: Result<MigrationServiceOutput, ServiceError>,\n1335: ) -> Result<(), i32> {\n1336:     match migration_result {\n1337:         Ok(MigrationServiceOutput::Migrated { segment: migrated })\n1338:         | Ok(MigrationServiceOutput::AutoRotated {\n1339:             segment: migrated, ..\n1340:         }) => apply_migrated_segment(env, resolved, target, migrated),\n1341:         Ok(MigrationServiceOutput::Stay) => Ok(()),\n1342:         Ok(MigrationServiceOutput::RotationFailed { reason }) => fail_rotation(reason),\n1343:         Err(err) => fail_migration_service(err),\n1344:     }\n1345: }\n1346: \n1347: fn should_skip_provider_ref_default_migration(\n1348:     resolved: &oulipoly_state::ResolvedResume,\n1349:     manual_migrate: Option<&str>,\n1350: ) -> bool {\n1351:     manual_migrate.is_none() && resolved_uses_provider_ref(resolved)\n1352: }\n1353: \n1354: fn resolved_uses_provider_ref(resolved: &oulipoly_state::ResolvedResume) -> bool {\n1355:     resolved\n1356:         .model\n1357:         .as_ref()\n1358:         .is_some_and(|model| model.provider.is_some())\n1359: }\n1360: \n1361: fn migration_model_for_attempt(\n1362:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n1363:     resolved: &oulipoly_state::ResolvedResume,\n1364:     manual_migrate: Option<&str>,\n1365:     attempts: usize,\n1366: ) -> oulipoly_config::ModelConfig {\n1367:     let mut migration_model = migration_model_pool(env, resolved);\n1368:     apply_migration_candidate_filter(\n1369:         env,\n1370:         resolved,\n1371:         manual_migrate,\n1372:         attempts,\n1373:         &mut migration_model,\n1374:     );\n1375:     migration_model\n1376: }\n1377: \n1378: fn apply_migration_candidate_filter(\n1379:     env: &crate::migration_providers::ResumeExecutionEnvironment,\n1380:     resolved: &oulipoly_state::ResolvedResume,\n1381:     manual_migrate: Option<&str>,\n1382:     attempts: usize,\n1383:     migration_model: &mut oulipoly_config::ModelConfig,\n1384: ) {\n1385:     if should_filter_migration_candidates(manual_migrate, attempts) {\n1386:         filter_quota_exhausted_migration_model(env, resolved, migration_model);\n1387:     }\n1388: }\n1389: \n1390: fn migration_model_