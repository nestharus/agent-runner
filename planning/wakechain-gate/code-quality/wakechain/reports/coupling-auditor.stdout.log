: --- /dev/null\n2248: +++ b/src-tauri/tests/wake_confirm_legacy_opencode.rs\n2249: @@ -0,0 +1,655 @@\n2250: +#![cfg(unix)]\n2251: +\n2252: +//! ## Declared roles\n2253: +//!\n2254: +//! Roles: orchestration, formatter, mapper, accessor, parser, validator,\n2255: +//! predicate, filter.\n2256: +//!\n2257: +//! TEST: legacy opencode wake-confirmation fixtures — fake CLI script\n2258: +//! formatters, model/config mappers, state and mailbox accessors, transcript\n2259: +//! parsers, consumed-notification predicates and filters, delivery/claim row\n2260: +//! validators, and test orchestration.\n2261: +//!\n2262: +//! ## Adapter declarations\n2263: +//!\n2264: +//! ```yaml\n2265: +//! adapter_declarations:\n2266: +//!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n2267: +//!     role: adapter\n2268: +//!     Translates:\n2269: +//!       - legacy-opencode-cli-contract\n2270: +//!       - wake-confirmation-transcript-contract\n2271: +//!       - mailbox-sidecar-contract\n2272: +//!       - invocation-state-db-contract\n2273: +//!       - test-fixture-process-contract\n2274: +//! intrinsic_surface_declarations:\n2275: +//!   - component: src-tauri/tests/wake_confirm_legacy_opencode.rs\n2276: +//!     role: intrinsic-surface\n2277: +//!     Domain: legacy opencode wake-confirmation regression suite\n2278: +//!     Owns:\n2279: +//!       - isolated config/data fixture materialization\n2280: +//!       - fake opencode script generation and executable setup\n2281: +//!       - transcript export fixture construction\n2282: +//!       - wake/resume command invocation and environment isolation\n2283: +//!       - delivery confirmation and consumed-notification assertions\n2284: +//! ```\n2285: +\n2286: +use oulipoly_state::StateDb;\n2287: +use oulipoly_state::mailbox::{AgentBashCompleteEnqueue, MailboxDb};\n2288: +use rusqlite::{Connection, params};\n2289: +use std::fs;\n2290: +use std::os::unix::fs::PermissionsExt;\n2291: +use std::path::{Path, PathBuf};\n2292: +use std::process::{Command, Output};\n2293: +use std::sync::{Mutex, MutexGuard, OnceLock};\n2294: +use std::time::{Duration, Instant};\n2295: +\n2296: +const MODEL: &str = \"wake-confirm-legacy-opencode\";\n2297: +const PROVIDER: &str = \"opencode\";\n2298: +const SESSION: &str = \"ses_wakeconfirmlegacy\";\n2299: +const HANDLE: &str = \"h-wake-confirm-legacy\";\n2300: +const CHAIN_ID: &str = \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\";\n2301: +\n2302: +struct Fixture {\n2303: +    dir: tempfile::TempDir,\n2304: +    config_home: PathBuf,\n2305: +    data_home: PathBuf,\n2306: +    home_dir: PathBuf,\n2307: +    app_config_dir: PathBuf,\n2308: +    models_dir: PathBuf,\n2309: +    bin_dir: PathBuf,\n2310: +    work_dir: PathBuf,\n2311: +    export_dir: PathBuf,\n2312: +}\n2313: +\n2314: +impl Fixture {\n2315: +    fn new() -> Self {\n2316: +        let dir = tempfile::tempdir().unwrap();\n2317: +        let config_home = dir.path().join(\"xdg-config\");\n2318: +        let data_home = dir.path().join(\"xdg-data\");\n2319: +        let home_dir = dir.path().join(\"home\");\n2320: +        let app_config_dir = config_home.join(\"oulipoly-agent-runner\");\n2321: +        let models_dir = app_config_dir.join(\"models\");\n2322: +        let bin_dir = dir.path().join(\"bin\");\n2323: +        let work_dir = dir.path().join(\"work\");\n2324: +        let export_dir = dir.path().join(\"fake-opencode-export\");\n2325: +        fs::create_dir_all(&models_dir).unwrap();\n2326: +        fs::create_dir_all(&bin_dir).unwrap();\n2327: +        fs::create_dir_all(&work_dir).unwrap();\n2328: +        fs::create_dir_all(&export_dir).unwrap();\n2329: +        fs::create_dir_all(&home_dir).unwrap();\n2330: +        Self {\n2331: +            dir,\n2332: +            config_home,\n2333: +            data_home,\n2334: +            home_dir,\n2335: +            app_config_dir,\n2336: +            models_dir,\n2337: +            bin_dir,\n2338: +            work_dir,\n2339: +            export_dir,\n2340: +        }\n2341: +    }\n2342: +\n2343: +    fn app_data_dir(&self) -> PathBuf {\n2344: +        self.data_home.join(\"oulipoly-agent-runner\")\n2345: +    }\n2346: +\n2347: +    fn sidecar_path(&self) -> PathBuf {\n2348: +        self.app_data_dir().join(\"pid-identity.db\")\n2349: +    }\n2350: +\n2351: +    fn state_path(&self) -> PathBuf {\n2352: +        self.app_data_dir().join(\"state.db\")\n2353: +    }\n2354: +\n2355: +    fn run(&self, mut cmd: Command) -> Output {\n2356: +        cmd.env(\"XDG_CONFIG_HOME\", &self.config_home)\n2357: +            .env(\"XDG_DATA_HOME\", &self.data_home)\n2358: +            .env(\"HOME\", &self.home_dir)\n2359: +            .env(\"PATH\", self.path_env())\n2360: +            .env(\"AGENT_BASH_AGENT_RUNNER_BIN\", runner_bin())\n2361: +            .env(\"WAKE_CONFIRM_WORK_DIR\", &self.work_dir)\n2362: +            .env(\"WAKE_CONFIRM_EXPORT_DIR\", &self.export_dir)\n2363: +            .env_remove(\"OULIPOLY_DATA_DIR\")\n2364: +            .env_remove(\"OULIPOLY_AUTO_WAKE\")\n2365: +            .env_remove(\"OULIPOLY_AUTO_WAKE_SESSION_ID\")\n2366: +            .env_remove(\"OULIPOLY_AUTO_WAKE_TOKEN\")\n2367: +            .env_remove(\"OULIPOLY_AUTO_WAKE_COUNT\")\n2368: +            .env_remove(\"OULIPOLY_PARENT_INVOCATION\")\n2369: +            .current_dir(self.dir.path());\n2370: +        cmd.output().unwrap()\n2371: +    }\n2372: +\n2373: +    fn path_env(&self) -> String {\n2374: +        let current = std::env::var(\"PATH\").unwrap_or_default();\n2375: +        format!(\"{}:{current}\", self.bin_dir.display())\n2376: +    }\n2377: +\n2378: +    fn run_agent(&self, prompt: &str) -> Output {\n2379: +        let mut cmd = Command::new(runner_bin());\n2380: +        cmd.env(\"WAKE_CONFIRM_NO_NOTIFY\", \"1\")\n2381: +            .arg(\"-m\")\n2382: +            .arg(MODEL)\n2383: +            .arg(\"--models-dir\")\n2384: +            .arg(&self.models_dir)\n2385: +            .arg(prompt);\n2386: +        self.run(cmd)\n2387: +    }\n2388: +\n2389: +    fn run_resume_with_env(&self, envs: &[(&str, &str)]) -> Output {\n2390: +        let mut cmd = Command::new(runner_bin());\n2391: +        for (key, value) in envs {\n2392: +            cmd.env(key, value);\n2393: +        }\n2394: +        cmd.arg(\"resume\")\n2395: +            .arg(\"--session-id\")\n2396: +            .arg(SESSION)\n2397: +            .arg(\"-m\")\n2398: +            .arg(MODEL)\n2399: +            .arg(\"--models-dir\")\n2400: +            .arg(&self.models_dir);\n2401: +        self.run(cmd)\n2402: +    }\n2403: +\n2404: +    fn write_legacy_opencode(&self) {\n2405: +        self.write_executable(\"opencode\", fake_opencode_script());\n2406: +        self.write_executable(\"opencode-turns\", fake_opencode_turns_script());\n2407: +        fs::write(\n2408: +            self.models_dir.join(format!(\"{MODEL}.toml\")),\n2409: +            format!(\n2410: +                r#\"prompt_mode = \"arg\"\n2411: +\n2412: +[[providers]]\n2413: +name = \"{PROVIDER}\"\n2414: +args = []\n2415: +\"#,\n2416: +            ),\n2417: +        )\n2418: +        .unwrap();\n2419: +        fs::write(\n2420: +            self.app_config_dir.join(\"providers.toml\"),\n2421: +            format!(\n2422: +                r#\"[{PROVIDER}]\n2423: +command = \"opencode\"\n2424: +args = [\"run\"]\n2425: +prompt_mode = \"arg\"\n2426: +\n2427: +[{PROVIDER}.session_capture]\n2428: +kind = \"stdout_json_event\"\n2429: +json_args = [\"--json\"]\n2430: +event_type = \"step_start\"\n2431: +event_id_path = \"sessionID\"\n2432: +\n2433: +[{PROVIDER}.resume]\n2434: +kind = \"flag\"\n2435: +flag = \"--session\"\n2436: +\"#,\n2437: +            ),\n2438: +        )\n2439: +        .unwrap();\n2440: +        fs::write(\n2441: +            self.app_config_dir.join(\"sessions.toml\"),\n2442: +            format!(\n2443: +                r#\"[{PROVIDER}]\n2444: +turn_script = \"opencode-turns\"\n2445: +state_dir = {}\n2446: +\"#,\n2447: +                toml_string(&path_string(&self.work_dir.join(\"turn-state\")))\n2448: +            ),\n2449: +        )\n2450: +        .unwrap();\n2451: +    }\n2452: +\n2453: +    fn write_executable(&self, name: &str, body: &str) -> PathBuf {\n2454: +        let path = self.bin_dir.join(name);\n2455: +        fs::write(&path, body).unwrap();\n2456: +        let mut perms = fs::metadata(&path).unwrap().permissions();\n2457: +        perms.set_mode(0o755);\n2458: +        fs::set_permissions(&path, perms).unwrap();\n2459: +        path\n2460: +    }\n2461: +\n2462: +    fn mailbox(&self) -> MailboxDb {\n2463: +        MailboxDb::open(&self.sidecar_path()).unwrap()\n2464: +    }\n2465: +\n2466: +    fn state(&self) -> StateDb {\n2467: +        StateDb::open(&self.state_path()).unwrap()\n2468: +    }\n2469: +\n2470: +    fn ensure_active_chain_for_legacy_session(&self) {\n2471: +        if self\n2472: +            .state()\n2473: +            .chain_id_for_segment(PROVIDER, SESSION)\n2474: +            .unwrap()\n2475: +            .is_some()\n2476: +        {\n2477: +            return;\n2478: +        }\n2479: +        let conn = Connection::open(self.state_path()).unwrap();\n2480: +        conn.execute(\n2481: +            \"INSERT INTO session_chains (chain_id, created_at, last_used_at, model_name)\n2482: +             VALUES (?1, '2026-06-07T00:00:00Z', '2026-06-07T00:00:00Z', ?2)\",\n2483: +            params![CHAIN_ID, MODEL],\n2484: +        )\n2485: +        .unwrap();\n2486: +        conn.execute(\n2487: +            \"INSERT INTO session_chain_segments\n2488: +                (chain_id, provider_name, session_id, started_at, transition_reason)\n2489: +             VALUES (?1, ?2, ?3, '2026-06-07T00:00:00Z', 'initial')\",\n2490: +            params![CHAIN_ID, PROVIDER, SESSION],\n2491: +        )\n2492: +        .unwrap();\n2493: +    }\n2494: +\n2495: +    fn seed_mailbox_notification(&self) {\n2496: +        let state_dir = self.work_dir.join(HANDLE);\n2497: +        fs::create_dir_all(&state_dir).unwrap();\n2498: +        let meta = state_dir.join(\"meta.json\");\n2499: +        let log = state_dir.join(\"log\");\n2500: +        let rc = state_dir.join(\"rc\");\n2501: +        fs::write(&meta, r#\"{\"caller_chain\":[]}\"#).unwrap();\n2502: +        fs::write(&log, \"legacy opencode workload completed\\n\").unwrap();\n2503: +        fs::write(&rc, \"0\\n\").unwrap();\n2504: +        let payload_json = serde_json::json!({\n2505: +            \"schema_version\": 1,\n2506: +            \"kind\": \"agent_bash_complete\",\n2507: +            \"handle\": HANDLE,\n2508: +            \"state_dir\": path_string(&state_dir),\n2509: +            \"meta_path\": path_string(&meta),\n2510: +            \"log_path\": path_string(&log),\n2511: +            \"rc_path\": path_string(&rc),\n2512: +            \"rc\": 0,\n2513: +        })\n2514: +        .to_string();\n2515: +        let mut mailbox = self.mailbox();\n2516: +        mailbox\n2517: +            .enqueue_agent_bash_complete(&AgentBashCompleteEnqueue {\n2518: +                session_id: SESSION,\n2519: +                handle: HANDLE,\n2520: +                payload_json: &payload_json,\n2521: +                owner_invocation_uuid: None,\n2522: +                matched_os_pid: None,\n2523: +                matched_os_boot_id: None,\n2524: +                matched_os_pid_starttime_ticks: None,\n2525: +                matched_chain_index: None,\n2526: +                state_dir: &path_string(&state_dir),\n2527: +                meta_path: &path_string(&meta),\n2528: +                log_path: &path_string(&log),\n2529: +                rc_path: &path_string(&rc),\n2530: +                rc: 0,\n2531: +            })\n2532: +            .unwrap();\n2533: +    }\n2534: +\n2535: +    fn notification_prompt_path(&self) -> PathBuf {\n2536: +        self.work_dir.join(\"legacy-wake-resumed.txt\")\n2537: +    }\n2538: +\n2539: +    fn export_path(&self) -> PathBuf {\n2540: +        self.export_dir.join(format!(\"{SESSION}.jsonl\"))\n2541: +    }\n2542: +\n2543: +    fn export_text(&self) -> String {\n2544: +        fs::read_to_string(self.export_path()).unwrap_or_default()\n2545: +    }\n2546: +\n2547: +    fn unconfirmed_invocation_count(&self) -> i64 {\n2548: +        Connection::open(self.state_path())\n2549: +            .unwrap()\n2550: +            .query_row(\n2551: +                \"SELECT COUNT(*) FROM invocations WHERE error_category = 'mailbox_delivery_unconfirmed'\",\n2552: +                [],\n2553: +                |row| row.get(0),\n2554: +            )\n2555: +            .unwrap()\n2556: +    }\n2557: +\n2558: +    fn assert_xdg_isolated(&self) {\n2559: +        assert!(\n2560: +            !self.home_dir.join(\".config/oulipoly-agent-runner\").exists(),\n2561: +            \"config must stay in isolated XDG_CONFIG_HOME\"\n2562: +        );\n2563: +        assert!(\n2564: +            !self\n2565: +                .home_dir\n2566: +                .join(\".local/share/oulipoly-agent-runner\")\n2567: +                .exists(),\n2568: +            \"state must stay in isolated XDG_DATA_HOME\"\n2569: +        );\n2570: +    }\n2571: +}\n2572: +\n2573: +#[test]\n2574: +fn legacy_opencode_resume_confirms_delivery_after_targeted_turn_ingest() {\n2575: +    let _guard = integration_test_guard();\n2576: +    let fixture = prepared_fixture();\n2577: +    fixture.seed_mailbox_notification();\n2578: +\n2579: +    let output = fixture.run_resume_with_env(&[]);\n2580: +    let prompt = wait_for_file(&fixture.notification_prompt_path());\n2581: +    assert!(prompt.starts_with(\"[OULIPOLY NOTIFICATIONS]\"), \"{prompt}\");\n2582: +    assert!(prompt.contains(\"kind: agent_bash_complete\"), \"{prompt}\");\n2583: +    assert!(prompt.contains(\"handle: h-wake-confirm-legacy\"), \"{prompt}\");\n2584: +    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n2585: +    wait_until(\"fake opencode export contains delivery nonce\", || {\n2586: +        let exported = fixture.export_text();\n2587: +        exported.contains(\"[OULIPOLY NOTIFICATIONS]\") && exported.contains(\"[OULIPOLY-DELIVERY \")\n2588: +    });\n2589: +\n2590: +    assert_success(&output);\n2591: +    wait_until(\"legacy opencode delivery marked delivered\", || {\n2592: +        let db = fixture.mailbox();\n2593: +        let rows = db.list_mailbox(SESSION, true).unwrap();\n2594: +        rows.len() == 1\n2595: +            && rows[0].delivered_at.is_some()\n2596: +            && rows[0].delivery_error.is_none()\n2597: +            && rows[0].delivery_attempts == 1\n2598: +            && rows[0].delivered_by_invocation_uuid.is_some()\n2599: +    });\n2600: +    assert!(\n2601: +        !fixture\n2602: +            .state()\n2603: +            .has_session_user_text_turn(PROVIDER, SESSION, &prompt)\n2604: +            .unwrap(),\n2605: +        \"fixture should quote-wrap the delivered user body so exact-text confirmation stays red\"\n2606: +    );\n2607: +    assert!(\n2608: +        fixture\n2609: +            .state()\n2610: +            .has_session_user_turn_containing(\n2611: +                PROVIDER,\n2612: +                SESSION,\n2613: +                &delivery_nonce_from_prompt(&prompt)\n2614: +            )\n2615: +            .unwrap(),\n2616: +        \"session_turns should contain the delivery nonce in the quote-wrapped user body\"\n2617: +    );\n2618: +    assert_eq!(fixture.unconfirmed_invocation_count(), 0);\n2619: +    assert!(fixture.mailbox().list_pending(SESSION).unwrap().is_empty());\n2620: +    fixture.assert_xdg_isolated();\n2621: +}\n2622: +\n2623: +#[test]\n2624: +fn legacy_opencode_resume_leaves_mailbox_pending_when_ingested_turn_omits_delivery_nonce() {\n2625: +    let _guard = integration_test_guard();\n2626: +    let fixture = prepared_fixture();\n2627: +    fixture.seed_mailbox_notification();\n2628: +\n2629: +    let output = fixture.run_resume_with_env(&[(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\", \"1\")]);\n2630: +    assert_exit_code(&output, 1);\n2631: +    let prompt = wait_for_file(&fixture.notification_prompt_path());\n2632: +    assert!(prompt.contains(\"[OULIPOLY-DELIVERY \"), \"{prompt}\");\n2633: +    wait_until(\n2634: +        \"fake opencode export contains user turn without delivery nonce\",\n2635: +        || {\n2636: +            let exported = fixture.export_text();\n2637: +            exported.contains(\"[OULIPOLY NOTIFICATIONS]\")\n2638: +                && !exported.contains(\"[OULIPOLY-DELIVERY \")\n2639: +        },\n2640: +    );\n2641: +    wait_until(\n2642: +        \"nonce-less export leaves mailbox pending unconfirmed\",\n2643: +        || {\n2644: +            let db = fixture.mailbox();\n2645: +            let rows = db.list_mailbox(SESSION, true).unwrap();\n2646: +            rows.len() == 1\n2647: +                && rows[0].delivered_at.is_none()\n2648: +                && rows[0].delivery_attempts == 1\n2649: +                && rows[0].delivery_error.as_deref() == Some(\"mailbox_delivery_unconfirmed\")\n2650: +                && rows[0].delivered_by_invocation_uuid.is_none()\n2651: +        },\n2652: +    );\n2653: +    assert!(\n2654: +        !fixture\n2655: +            .state()\n2656: +            .has_session_user_turn_containing(\n2657: +                PROVIDER,\n2658: +                SESSION,\n2659: +                &delivery_nonce_from_prompt(&prompt)\n2660: +            )\n2661: +            .unwrap(),\n2662: +        \"stored resume turn without the delivery nonce must not confirm delivery\"\n2663: +    );\n2664: +    assert_eq!(fixture.unconfirmed_invocation_count(), 1);\n2665: +    assert_eq!(fixture.mailbox().list_pending(SESSION).unwrap().len(), 1);\n2666: +    fixture.assert_xdg_isolated();\n2667: +}\n2668: +\n2669: +#[test]\n2670: +fn legacy_opencode_resume_leaves_mailbox_pending_when_export_omits_notification_turn() {\n2671: +    let _guard = integration_test_guard();\n2672: +    let fixture = prepare