{"type":"tool_use","timestamp":1780923080236,"sessionID":"ses_158b7240dffejD0kl19r2Asju7","part":{"type":"tool","tool":"read","callID":"call_0lkCsoNrqnuowmGREnaL3pbB","state":{"status":"completed","input":{"filePath":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/wake_coordinator.rs","offset":1,"limit":1400},"output":"<path>/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/wake_coordinator.rs</path>\n<type>file</type>\n<content>\n1: //! ## Declared roles\n2: //!\n3: //! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n4: //! `predicate`, `validator`\n5: \n6: use oulipoly_state::StateDb;\n7: use oulipoly_state::mailbox::{\n8:     MailboxDb, MailboxRow, SessionLiveness, SessionRuntimeIdleUpdate, SessionRuntimeRow,\n9:     WAKE_SWEEP_ABANDONED_ERROR, WakeClaimAcquireResult, WakeClaimRequest, WakeClaimRow,\n10:     WakeSweepCandidate,\n11: };\n12: use oulipoly_state::pid_identity::{ProcessIdentity, read_live_process_identity};\n13: use serde::Serialize;\n14: use std::path::PathBuf;\n15: use std::process::{Child, Command, Stdio};\n16: use std::sync::OnceLock;\n17: use std::time::Duration;\n18: use uuid::Uuid;\n19: \n20: #[cfg(unix)]\n21: use oulipoly_runtime::executor::cli::pty_broker;\n22: #[cfg(unix)]\n23: use std::os::unix::process::CommandExt;\n24: \n25: const AUTO_WAKE_ENV: &str = \"OULIPOLY_AUTO_WAKE\";\n26: const AUTO_WAKE_SESSION_ID_ENV: &str = \"OULIPOLY_AUTO_WAKE_SESSION_ID\";\n27: const AUTO_WAKE_TOKEN_ENV: &str = \"OULIPOLY_AUTO_WAKE_TOKEN\";\n28: const AUTO_WAKE_COUNT_ENV: &str = \"OULIPOLY_AUTO_WAKE_COUNT\";\n29: const AUTO_WAKE_MAX_ENV: &str = \"OULIPOLY_AUTO_WAKE_MAX\";\n30: const AUTO_WAKE_RETRY_BASE_MS_ENV: &str = \"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\";\n31: const PARENT_INVOCATION_ENV: &str = \"OULIPOLY_PARENT_INVOCATION\";\n32: const DEFAULT_AUTO_WAKE_MAX: i64 = 5;\n33: const DEFAULT_AUTO_WAKE_RETRY_BASE_MS: u64 = 1_000;\n34: const AUTO_WAKE_RETRY_MAX_MS: u64 = 30_000;\n35: const WAKE_CLAIM_STALE_AFTER_SECONDS: i64 = 10 * 60;\n36: const WAKE_RECLAIM_SWEEP_LIMIT: usize = 8;\n37: const WAKE_RECLAIM_SWEEP_SCAN_LIMIT: usize = WAKE_RECLAIM_SWEEP_LIMIT * 32;\n38: const WAKE_RECLAIM_REAP_SESSION_LIMIT: usize = 32;\n39: const WAKE_RECLAIM_REAP_ROWS_PER_SESSION: usize = 20;\n40: #[allow(dead_code)]\n41: const WAKE_RECLAIM_SWEEP_INTERVAL_SECONDS: u64 = 60;\n42: const CONSUMED_NOTIFICATION_MARKER: &str = \"[OULIPOLY NOTIFICATIONS]\";\n43: \n44: #[derive(Debug, Clone, Serialize)]\n45: pub(crate) struct WakeDiagnostic {\n46:     pub(crate) attempted: bool,\n47:     pub(crate) status: String,\n48:     pub(crate) claim_token: Option<String>,\n49:     pub(crate) wake_pid: Option<i64>,\n50:     pub(crate) auto_wake_count: Option<i64>,\n51:     pub(crate) message: Option<String>,\n52: }\n53: \n54: impl WakeDiagnostic {\n55:     fn status(status: &str) -> Self {\n56:         Self {\n57:             attempted: false,\n58:             status: status.to_string(),\n59:             claim_token: None,\n60:             wake_pid: None,\n61:             auto_wake_count: None,\n62:             message: None,\n63:         }\n64:     }\n65: \n66:     fn with_message(status: &str, message: String) -> Self {\n67:         Self {\n68:             attempted: false,\n69:             status: status.to_string(),\n70:             claim_token: None,\n71:             wake_pid: None,\n72:             auto_wake_count: None,\n73:             message: Some(message),\n74:         }\n75:     }\n76: }\n77: \n78: pub(crate) fn mark_session_idle_after_turn(\n79:     session_id: &str,\n80:     invocation_uuid: &str,\n81:     exit_code: Option<i32>,\n82: ) -> Result<(), String> {\n83:     let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n84:         return Ok(());\n85:     };\n86:     db.mark_session_idle(SessionRuntimeIdleUpdate {\n87:         session_id,\n88:         invocation_uuid,\n89:         last_exit_code: exit_code,\n90:     })?;\n91:     Ok(())\n92: }\n93: \n94: pub(crate) fn trigger_notify_wake(session_id: &str) -> WakeDiagnostic {\n95:     start_wake_chain(StartWakeInput {\n96:         session_id,\n97:         reason: \"notify_idle\",\n98:         auto_wake_count: 1,\n99:         renew_token: None,\n100:     })\n101: }\n102: \n103: pub(crate) fn run_startup_wake_reclaim_sweep() {\n104:     if is_auto_wake_invocation() {\n105:         return;\n106:     }\n107:     run_wake_reclaim_sweep_or_warn(\"process_start\");\n108: }\n109: \n110: #[allow(dead_code)]\n111: pub(crate) fn start_wake_reclaim_maintenance_driver() {\n112:     static DRIVER: OnceLock<()> = OnceLock::new();\n113:     DRIVER.get_or_init(spawn_wake_reclaim_maintenance_driver);\n114: }\n115: \n116: #[allow(dead_code)]\n117: fn spawn_wake_reclaim_maintenance_driver() {\n118:     let result = std::thread::Builder::new()\n119:         .name(\"oulipoly-wake-reclaim-sweep\".to_string())\n120:         .spawn(wake_reclaim_maintenance_loop);\n121:     if let Err(err) = result {\n122:         tracing::warn!(\"Failed to start wake reclaim sweep driver: {err}\");\n123:     }\n124: }\n125: \n126: #[allow(dead_code)]\n127: fn wake_reclaim_maintenance_loop() {\n128:     run_wake_reclaim_sweep_or_warn(\"maintenance_start\");\n129:     loop {\n130:         std::thread::sleep(Duration::from_secs(WAKE_RECLAIM_SWEEP_INTERVAL_SECONDS));\n131:         run_wake_reclaim_sweep_or_warn(\"maintenance_tick\");\n132:     }\n133: }\n134: \n135: fn run_wake_reclaim_sweep_or_warn(trigger: &str) {\n136:     if let Err(err) = run_wake_reclaim_sweep(trigger) {\n137:         tracing::warn!(trigger, \"Wake reclaim sweep failed: {err}\");\n138:     }\n139: }\n140: \n141: fn run_wake_reclaim_sweep(trigger: &str) -> Result<(), String> {\n142:     let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n143:         return Ok(());\n144:     };\n145:     let candidates = db.wake_sweep_candidates(\n146:         WAKE_CLAIM_STALE_AFTER_SECONDS,\n147:         WAKE_RECLAIM_SWEEP_SCAN_LIMIT,\n148:     )?;\n149:     let plan = wake_sweep_plan(&mut db, candidates)?;\n150:     reap_abandoned_sweep_candidates(&mut db, &plan.reap)?;\n151:     drop(db);\n152:     for candidate in plan.start {\n153:         let diagnostic = start_wake_chain(StartWakeInput {\n154:             session_id: &candidate.session_id,\n155:             reason: trigger,\n156:             auto_wake_count: candidate.auto_wake_count,\n157:             renew_token: None,\n158:         });\n159:         trace_wake_sweep_candidate(&candidate.session_id, &diagnostic);\n160:     }\n161:     Ok(())\n162: }\n163: \n164: struct WakeSweepPlan {\n165:     start: Vec<WakeSweepCandidate>,\n166:     reap: Vec<WakeSweepCandidate>,\n167: }\n168: \n169: fn wake_sweep_plan(\n170:     db: &mut MailboxDb,\n171:     candidates: Vec<WakeSweepCandidate>,\n172: ) -> Result<WakeSweepPlan, String> {\n173:     let (recoverable, reap) = partition_wake_sweep_candidates(db, candidates)?;\n174:     let start = select_recoverable_sweep_candidates(recoverable);\n175:     Ok(wake_sweep_plan_from_selected(start, reap))\n176: }\n177: \n178: fn partition_wake_sweep_candidates(\n179:     db: &mut MailboxDb,\n180:     candidates: Vec<WakeSweepCandidate>,\n181: ) -> Result<(Vec<WakeSweepCandidate>, Vec<WakeSweepCandidate>), String> {\n182:     let state = open_default_state_read_only();\n183:     let mut recoverable = Vec::new();\n184:     let mut reap = Vec::new();\n185:     for candidate in candidates {\n186:         match wake_sweep_candidate_disposition(db, state.as_ref(), &candidate)? {\n187:             WakeSweepDisposition::Recoverable => {\n188:                 recoverable.push(candidate);\n189:             }\n190:             WakeSweepDisposition::Abandoned => {\n191:                 if reap.len() < WAKE_RECLAIM_REAP_SESSION_LIMIT {\n192:                     reap.push(candidate);\n193:                 }\n194:             }\n195:             WakeSweepDisposition::Skip => {}\n196:         }\n197:     }\n198:     Ok((recoverable, reap))\n199: }\n200: \n201: fn wake_sweep_plan_from_selected(\n202:     start: Vec<WakeSweepCandidate>,\n203:     reap: Vec<WakeSweepCandidate>,\n204: ) -> WakeSweepPlan {\n205:     WakeSweepPlan { start, reap }\n206: }\n207: \n208: fn select_recoverable_sweep_candidates(\n209:     mut candidates: Vec<WakeSweepCandidate>,\n210: ) -> Vec<WakeSweepCandidate> {\n211:     if candidates.len() <= WAKE_RECLAIM_SWEEP_LIMIT {\n212:         return candidates;\n213:     }\n214:     candidates.sort_by_key(|candidate| candidate.min_pending_seq);\n215:     let oldest_slots = WAKE_RECLAIM_SWEEP_LIMIT.div_ceil(2);\n216:     let newest_slots = WAKE_RECLAIM_SWEEP_LIMIT.saturating_sub(oldest_slots);\n217:     let mut selected = candidates\n218:         .iter()\n219:         .take(oldest_slots)\n220:         .cloned()\n221:         .collect::<Vec<_>>();\n222:     for candidate in candidates.iter().rev().take(newest_slots) {\n223:         if !selected\n224:             .iter()\n225:             .any(|existing| existing.session_id == candidate.session_id)\n226:         {\n227:             selected.push(candidate.clone());\n228:         }\n229:     }\n230:     selected\n231: }\n232: \n233: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n234: enum WakeSweepDisposition {\n235:     Recoverable,\n236:     Abandoned,\n237:     Skip,\n238: }\n239: \n240: fn wake_sweep_candidate_disposition(\n241:     db: &MailboxDb,\n242:     state: Option<&StateDb>,\n243:     candidate: &WakeSweepCandidate,\n244: ) -> Result<WakeSweepDisposition, String> {\n245:     // Recoverable means either an idle headless runtime with durable resume\n246:     // evidence, or a live owner PID identity that must not be reaped. Missing\n247:     // runtime/history with no live owner is abandoned debris, not resumable work.\n248:     if pending_mailbox_consumed_marker_present(db, &candidate.session_id) {\n249:         return Ok(WakeSweepDisposition::Skip);\n250:     }\n251:     if wake_sweep_candidate_is_resumable(db, state, candidate)? {\n252:         return Ok(resumable_wake_sweep_disposition(candidate));\n253:     }\n254:     if wake_sweep_candidate_has_live_owner(db, &candidate.session_id)? {\n255:         return Ok(WakeSweepDisposition::Skip);\n256:     }\n257:     Ok(WakeSweepDisposition::Abandoned)\n258: }\n259: \n260: fn resumable_wake_sweep_disposition(candidate: &WakeSweepCandidate) -> WakeSweepDisposition {\n261:     if wake_sweep_candidate_reached_cap(candidate)\n262:         || !wake_sweep_candidate_has_deliverable_pending(&candidate.session_id)\n263:     {\n264:         return WakeSweepDisposition::Skip;\n265:     }\n266:     WakeSweepDisposition::Recoverable\n267: }\n268: \n269: fn reap_abandoned_sweep_candidates(\n270:     db: &mut MailboxDb,\n271:     candidates: &[WakeSweepCandidate],\n272: ) -> Result<(), String> {\n273:     for candidate in candidates {\n274:         db.mark_pending_abandoned(\n275:             &candidate.session_id,\n276:             WAKE_SWEEP_ABANDONED_ERROR,\n277:             WAKE_RECLAIM_REAP_ROWS_PER_SESSION,\n278:         )?;\n279:     }\n280:     Ok(())\n281: }\n282: \n283: fn wake_sweep_candidate_has_deliverable_pending(session_id: &str) -> bool {\n284:     crate::mailbox_delivery::deliverable_pending_count(session_id)\n285:         .map(|count| count > 0)\n286:         .unwrap_or(false)\n287: }\n288: \n289: fn wake_sweep_candidate_is_resumable(\n290:     db: &MailboxDb,\n291:     state: Option<&StateDb>,\n292:     candidate: &WakeSweepCandidate,\n293: ) -> Result<bool, String> {\n294:     let Some(runtime) = db.session_runtime(&candidate.session_id)? else {\n295:         return Ok(false);\n296:     };\n297:     if !wake_sweep_runtime_can_resume(&runtime) {\n298:         return Ok(false);\n299:     }\n300:     wake_sweep_runtime_has_resume_evidence(state, &runtime)\n301: }\n302: \n303: fn wake_sweep_runtime_can_resume(runtime: &SessionRuntimeRow) -> bool {\n304:     runtime.mode == \"headless\"\n305:         && runtime.run_state != \"running\"\n306:         && runtime\n307:             .provider_name\n308:             .as_deref()\n309:             .is_some_and(|provider| !provider.is_empty())\n310: }\n311: \n312: fn wake_sweep_runtime_has_resume_evidence(\n313:     state: Option<&StateDb>,\n314:     runtime: &SessionRuntimeRow,\n315: ) -> Result<bool, String> {\n316:     let Some(state) = state else {\n317:         return Ok(false);\n318:     };\n319:     let Some(provider_name) = runtime.provider_name.as_deref() else {\n320:         return Ok(false);\n321:     };\n322:     if state\n323:         .chain_id_for_segment(provider_name, &runtime.session_id)\n324:         .map_err(|err| err.to_string())?\n325:         .is_some()\n326:     {\n327:         return Ok(true);\n328:     }\n329:     state\n330:         .count_session_turns(provider_name, &runtime.session_id)\n331:         .map(|counts| counts.total > 0)\n332: }\n333: \n334: fn wake_sweep_candidate_has_live_owner(db: &MailboxDb, session_id: &str) -> Result<bool, String> {\n335:     for row in db.list_pending(session_id)? {\n336:         if mailbox_row_has_live_owner_identity(&row)? {\n337:             return Ok(true);\n338:         }\n339:     }\n340:     Ok(false)\n341: }\n342: \n343: fn mailbox_row_has_live_owner_identity(row: &MailboxRow) -> Result<bool, String> {\n344:     let Some(recorded) = mailbox_row_owner_identity(row) else {\n345:         return Ok(false);\n346:     };\n347:     read_live_process_identity(recorded.os_pid).map(|live| live.as_ref() == Some(&recorded))\n348: }\n349: \n350: fn mailbox_row_owner_identity(row: &MailboxRow) -> Option<ProcessIdentity> {\n351:     Some(ProcessIdentity {\n352:         os_pid: row.matched_os_pid?,\n353:         os_boot_id: row.matched_os_boot_id.clone()?,\n354:         os_pid_starttime_ticks: row.matched_os_pid_starttime_ticks?,\n355:     })\n356: }\n357: \n358: fn wake_sweep_candidate_reached_cap(candidate: &WakeSweepCandidate) -> bool {\n359:     auto_wake_cap_reached(candidate.auto_wake_count.saturating_sub(1), auto_wake_max())\n360: }\n361: \n362: fn pending_mailbox_consumed_marker_present(db: &MailboxDb, session_id: &str) -> bool {\n363:     let Ok(pending) = db.list_pending(session_id) else {\n364:         return false;\n365:     };\n366:     if pending.is_empty() {\n367:         return true;\n368:     }\n369:     let Some(provider_name) = pending_mailbox_provider_name(db, session_id) else {\n370:         return false;\n371:     };\n372:     let Some(state) = open_default_state_read_only() else {\n373:         return false;\n374:     };\n375:     session_has_consumed_notification_marker(&state, &provider_name, session_id)\n376:         && pending.iter().all(|row| {\n377:             state\n378:                 .has_session_user_turn_containing(\n379:                     &provider_name,\n380:                     session_id,\n381:                     &mailbox_handle_marker(row),\n382:                 )\n383:                 .unwrap_or(false)\n384:         })\n385: }\n386: \n387: fn mailbox_handle_marker(row: &MailboxRow) -> String {\n388:     format!(\"handle: {}\", row.handle)\n389: }\n390: \n391: fn open_default_state_read_only() -> Option<StateDb> {\n392:     let path = StateDb::default_path().ok()?;\n393:     if !path.exists() {\n394:         return None;\n395:     }\n396:     StateDb::open_read_only(&path).ok()\n397: }\n398: \n399: fn pending_mailbox_provider_name(db: &MailboxDb, session_id: &str) -> Option<String> {\n400:     db.session_runtime(session_id)\n401:         .ok()\n402:         .flatten()\n403:         .and_then(|runtime| runtime.provider_name)\n404: }\n405: \n406: fn session_has_consumed_notification_marker(\n407:     state: &StateDb,\n408:     provider_name: &str,\n409:     session_id: &str,\n410: ) -> bool {\n411:     state\n412:         .has_session_user_turn_containing(provider_name, session_id, CONSUMED_NOTIFICATION_MARKER)\n413:         .unwrap_or(false)\n414: }\n415: \n416: fn trace_wake_sweep_candidate(session_id: &str, diagnostic: &WakeDiagnostic) {\n417:     tracing::debug!(\n418:         session_id,\n419:         status = diagnostic.status.as_str(),\n420:         \"Wake reclaim sweep candidate evaluated\"\n421:     );\n422: }\n423: \n424: pub(crate) fn mark_successful_turn_idle_and_recheck(\n425:     session_id: &str,\n426:     invocation_uuid: &str,\n427:     exit_code: i32,\n428: ) -> Result<WakeDiagnostic, String> {\n429:     mark_session_idle_after_turn(session_id, invocation_uuid, Some(exit_code))?;\n430:     Ok(successful_turn_recheck(session_id))\n431: }\n432: \n433: fn successful_turn_recheck(session_id: &str) -> WakeDiagnostic {\n434:     trigger_turn_end_recheck(session_id)\n435: }\n436: \n437: pub(crate) fn validate_auto_wake_child(session_id: &str) -> Result<Option<i32>, String> {\n438:     if !auto_wake_marker_present() {\n439:         return Ok(None);\n440:     }\n441:     let marker = auto_wake_child_marker();\n442:     if !auto_wake_child_marker_matches(session_id, &marker) {\n443:         return Ok(Some(0));\n444:     }\n445:     validate_auto_wake_child_claim(session_id, &marker.claim_token)\n446: }\n447: \n448: struct AutoWakeChildMarker {\n449:     expected_session: String,\n450:     claim_token: String,\n451: }\n452: \n453: fn auto_wake_marker_present() -> bool {\n454:     std::env::var_os(AUTO_WAKE_ENV).is_some()\n455: }\n456: \n457: fn auto_wake_child_marker() -> AutoWakeChildMarker {\n458:     auto_wake_child_marker_from_parts(auto_wake_expected_session(), auto_wake_child_claim_token())\n459: }\n460: \n461: fn auto_wake_expected_session() -> String {\n462:     std::env::var(AUTO_WAKE_SESSION_ID_ENV).unwrap_or_default()\n463: }\n464: \n465: fn auto_wake_child_claim_token() -> String {\n466:     std::env::var(AUTO_WAKE_TOKEN_ENV).unwrap_or_default()\n467: }\n468: \n469: fn auto_wake_child_marker_from_parts(\n470:     expected_session: String,\n471:     claim_token: String,\n472: ) -> AutoWakeChildMarker {\n473:     AutoWakeChildMarker {\n474:         expected_session,\n475:         claim_token,\n476:     }\n477: }\n478: \n479: fn auto_wake_child_marker_matches(session_id: &str, marker: &AutoWakeChildMarker) -> bool {\n480:     marker.expected_session == session_id && !marker.claim_token.is_empty()\n481: }\n482: \n483: fn validate_auto_wake_child_claim(\n484:     session_id: &str,\n485:     claim_token: &str,\n486: ) -> Result<Option<i32>, String> {\n487:     let Some(mut db) = open_optional_wake_mailbox()? else {\n488:         return Ok(Some(0));\n489:     };\n490:     validate_auto_wake_claim_with_db(&mut db, session_id, claim_token)\n491: }\n492: \n493: fn open_optional_wake_mailbox() -> Result<Option<MailboxDb>, String> {\n494:     MailboxDb::open_default_if_exists()\n495: }\n496: \n497: fn validate_auto_wake_claim_with_db(\n498:     db: &mut MailboxDb,\n499:     session_id: &str,\n500:     claim_token: &str,\n501: ) -> Result<Option<i32>, String> {\n502:     db.validate_wake_claim_for_child(session_id, claim_token)\n503:         .map(auto_wake_child_validation_result)\n504: }\n505: \n506: fn auto_wake_child_validation_result(valid: bool) -> Option<i32> {\n507:     if valid { None } else { Some(0) }\n508: }\n509: \n510: pub(crate) fn is_auto_wake_invocation() -> bool {\n511:     auto_wake_marker_present()\n512: }\n513: \n514: pub(crate) fn reset_manual_resume_wake_claim(session_id: &str) -> Result<(), String> {\n515:     let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n516:         return Ok(());\n517:     };\n518:     db.release_wake_claim(session_id, None)?;\n519:     Ok(())\n520: }\n521: \n522: pub(crate) fn release_current_auto_wake_claim_for_session(session_id: &str) {\n523:     let auto_wake = current_auto_wake();\n524:     release_current_auto_wake_claim(session_id, auto_wake.as_ref());\n525: }\n526: \n527: pub(crate) fn recheck_after_failed_auto_wake(session_id: &str) -> WakeDiagnostic {\n528:     let Some(auto_wake) = current_auto_wake() else {\n529:         return WakeDiagnostic::status(\"not_auto_wake\");\n530:     };\n531:     release_current_auto_wake_claim(session_id, Some(&auto_wake));\n532:     failed_auto_wake_recheck(session_id, &auto_wake)\n533: }\n534: \n535: fn trigger_turn_end_recheck(session_id: &str) -> WakeDiagnostic {\n536:     let pending_count = match turn_end_pending_count(session_id) {\n537:         Ok(count) => count,\n538:         Err(err) => return storage_error_diagnostic(err),\n539:     };\n540:     let auto_wake = current_auto_wake();\n541:     apply_turn_end_recheck_decision(\n542:         session_id,\n543:         auto_wake.as_ref(),\n544:         turn_end_recheck_decision(session_id, pending_count, auto_wake.as_ref()),\n545:     )\n546: }\n547: \n548: fn failed_auto_wake_recheck(session_id: &str, auto_wake: &AutoWakeEnv) -> WakeDiagnostic {\n549:     let pending_count = match turn_end_pending_count(session_id) {\n550:         Ok(count) => count,\n551:         Err(err) => return storage_error_diagnostic(err),\n552:     };\n553:     apply_failed_auto_wake_recheck_decision(\n554:         session_id,\n555:         auto_wake,\n556:         failed_auto_wake_recheck_decision(session_id, pending_count, auto_wake),\n557:     )\n558: }\n559: \n560: enum TurnEndRecheckDecision<'a> {\n561:     NoPending,\n562:     CapReached { current_count: i64, max_count: i64 },\n563:     Start(StartWakeInput<'a>),\n564: }\n565: \n566: fn turn_end_recheck_decision<'a>(\n567:     session_id: &'a str,\n568:     pending_count: usize,\n569:     auto_wake: Option<&'a AutoWakeEnv>,\n570: ) -> TurnEndRecheckDecision<'a> {\n571:     if no_pending(pending_count) {\n572:         return TurnEndRecheckDecision::NoPending;\n573:     }\n574:     let current_count = current_auto_wake_count(auto_wake);\n575:     let max_count = auto_wake_max();\n576:     if auto_wake_cap_reached(current_count, max_count) {\n577:         return TurnEndRecheckDecision::CapReached {\n578:             current_count,\n579:             max_count,\n580:         };\n581:     }\n582:     TurnEndRecheckDecision::Start(StartWakeInput {\n583:         session_id,\n584:         reason: \"turn_end_recheck\",\n585:         auto_wake_count: current_count + 1,\n586:         renew_token: auto_wake.map(|wake| wake.token.as_str()),\n587:     })\n588: }\n589: \n590: fn apply_turn_end_recheck_decision(\n591:     session_id: &str,\n592:     auto_wake: Option<&AutoWakeEnv>,\n593:     decision: TurnEndRecheckDecision<'_>,\n594: ) -> WakeDiagnostic {\n595:     match decision {\n596:         TurnEndRecheckDecision::NoPending => {\n597:             release_current_auto_wake_claim(session_id, auto_wake);\n598:             WakeDiagnostic::status(\"no_pending\")\n599:         }\n600:         TurnEndRecheckDecision::CapReached {\n601:             current_count,\n602:             max_count,\n603:         } => {\n604:             release_current_auto_wake_claim(session_id, auto_wake);\n605:             emit_auto_wake_cap_reached(session_id, current_count, max_count);\n606:             auto_wake_cap_diagnostic(current_count)\n607:         }\n608:         TurnEndRecheckDecision::Start(input) => start_wake_chain(input),\n609:     }\n610: }\n611: \n612: enum FailedAutoWakeRecheckDecision<'a> {\n613:     NoPending,\n614:     CapReached { current_count: i64, max_count: i64 },\n615:     Retry(StartWakeInput<'a>),\n616: }\n617: \n618: fn failed_auto_wake_recheck_decision<'a>(\n619:     session_id: &'a str,\n620:     pending_count: usize,\n621:     auto_wake: &'a AutoWakeEnv,\n622: ) -> FailedAutoWakeRecheckDecision<'a> {\n623:     if no_pending(pending_count) {\n624:         return FailedAutoWakeRecheckDecision::NoPending;\n625:     }\n626:     let max_count = auto_wake_max();\n627:     if auto_wake_cap_reached(auto_wake.count, max_count) {\n628:         return FailedAutoWakeRecheckDecision::CapReached {\n629:             current_count: auto_wake.count,\n630:             max_count,\n631:         };\n632:     }\n633:     FailedAutoWakeRecheckDecision::Retry(StartWakeInput {\n634:         session_id,\n635:         reason: \"wake_failure_retry\",\n636:         auto_wake_count: auto_wake.count + 1,\n637:         renew_token: None,\n638:     })\n639: }\n640: \n641: fn apply_failed_auto_wake_recheck_decision(\n642:     session_id: &str,\n643:     auto_wake: &AutoWakeEnv,\n644:     decision: FailedAutoWakeRecheckDecision<'_>,\n645: ) -> WakeDiagnostic {\n646:     match decision {\n647:         FailedAutoWakeRecheckDecision::NoPending => WakeDiagnostic::status(\"no_pending\"),\n648:         FailedAutoWakeRecheckDecision::CapReached {\n649:             current_count,\n650:             max_count,\n651:         } => {\n652:             emit_auto_wake_cap_reached(session_id, current_count, max_count);\n653:             auto_wake_cap_diagnostic(current_count)\n654:         }\n655:         FailedAutoWakeRecheckDecision::Retry(input) => {\n656:             sleep_before_failed_auto_wake_retry(auto_wake.count);\n657:             start_wake_chain(input)\n658:         }\n659:     }\n660: }\n661: \n662: fn sleep_before_failed_auto_wake_retry(auto_wake_count: i64) {\n663:     std::thread::sleep(auto_wake_retry_delay(auto_wake_count));\n664: }\n665: \n666: fn auto_wake_retry_delay(auto_wake_count: i64) -> Duration {\n667:     Duration::from_millis(auto_wake_retry_delay_ms(auto_wake_count))\n668: }\n669: \n670: fn auto_wake_retry_delay_ms(auto_wake_count: i64) -> u64 {\n671:     let base_ms = auto_wake_retry_base_ms();\n672:     let exponent = auto_wake_count.saturating_sub(1).clamp(0, 10) as u32;\n673:     base_ms\n674:         .saturating_mul(2_u64.saturating_pow(exponent))\n675:         .min(AUTO_WAKE_RETRY_MAX_MS)\n676: }\n677: \n678: fn auto_wake_retry_base_ms() -> u64 {\n679:     parsed_auto_wake_retry_base_ms()\n680:         .filter(|value| *value > 0)\n681:         .unwrap_or(DEFAULT_AUTO_WAKE_RETRY_BASE_MS)\n682: }\n683: \n684: fn parsed_auto_wake_retry_base_ms() -> Option<u64> {\n685:     std::env::var(AUTO_WAKE_RETRY_BASE_MS_ENV)\n686:         .ok()\n687:         .and_then(|value| value.parse::<u64>().ok())\n688: }\n689: \n690: fn current_auto_wake_count(auto_wake: Option<&AutoWakeEnv>) -> i64 {\n691:     auto_wake.map(|wake| wake.count).unwrap_or(0)\n692: }\n693: \n694: fn turn_end_pending_count(session_id: &str) -> Result<usize, String> {\n695:     pending_count(session_id)\n696: }\n697: \n698: fn no_pending(pending_count: usize) -> bool {\n699:     pending_count == 0\n700: }\n701: \n702: fn auto_wake_cap_reached(current_count: i64, max_count: i64) -> bool {\n703:     current_count >= max_count\n704: }\n705: \n706: fn emit_auto_wake_cap_reached(session_id: &str, current_count: i64, max_count: i64) {\n707:     eprintln!(\n708:         \"auto_wake_cap_reached session_id={session_id} count={current_count} max={max_count}\"\n709:     );\n710: }\n711: \n712: fn auto_wake_cap_diagnostic(current_count: i64) -> WakeDiagnostic {\n713:     let mut diagnostic = WakeDiagnostic::status(\"auto_wake_cap_reached\");\n714:     diagnostic.auto_wake_count = Some(current_count);\n715:     diagnostic\n716: }\n717: \n718: fn storage_error_diagnostic(err: String) -> WakeDiagnostic {\n719:     WakeDiagnostic::with_message(\"storage_error\", err)\n720: }\n721: \n722: struct AutoWakeEnv {\n723:     token: String,\n724:     count: i64,\n725: }\n726: \n727: #[derive(Clone, Copy)]\n728: struct StartWakeInput<'a> {\n729:     session_id: &'a str,\n730:     reason: &'a str,\n731:     auto_wake_count: i64,\n732:     renew_token: Option<&'a str>,\n733: }\n734: \n735: fn start_wake_chain(input: StartWakeInput<'_>) -> WakeDiagnostic {\n736:     let claim_token = Uuid::new_v4().to_string();\n737:     let mut context = match prepare_wake_start_context(input, &claim_token) {\n738:         Ok(context) => context,\n739:         Err(diagnostic) => return diagnostic,\n740:     };\n741:     let spawn = spawn_detached_resume(\n742:         input.session_id,\n743:         context.runtime.as_ref(),\n744:         &context.claim.claim_token,\n745:         input.auto_wake_count,\n746:     );\n747:     wake_spawn_diagnostic(\n748:         &mut context.db,\n749:         input,\n750:         context.runtime.as_ref(),\n751:         context.claim,\n752:         spawn,\n753:     )\n754: }\n755: \n756: struct WakeStartContext {\n757:     db: MailboxDb,\n758:     runtime: Option<SessionRuntimeRow>,\n759:     claim: WakeClaimRow,\n760: }\n761: \n762: fn prepare_wake_start_context(\n763:     input: StartWakeInput<'_>,\n764:     claim_token: &str,\n765: ) -> Result<WakeStartContext, WakeDiagnostic> {\n766:     let mut db = open_wake_mailbox().map_err(storage_error_diagnostic)?;\n767:     let runtime =\n768:         session_runtime_for_wake(&db, input.session_id).map_err(storage_error_diagnostic)?;\n769:     if wake_runtime_busy(&mut db, input.session_id, runtime.as_ref())? {\n770:         return Err(WakeDiagnostic::status(\"busy\"));\n771:     }\n772:     let claim = acquire_startable_wake_claim(&mut db, input, claim_token)?;\n773:     Ok(WakeStartContext { db, runtime, claim })\n774: }\n775: \n776: fn wake_runtime_busy(\n777:     db: &mut MailboxDb,\n778:     session_id: &str,\n779:     runtime: Option<&SessionRuntimeRow>,\n780: ) -> Result<bool, WakeDiagnostic> {\n781:     let liveness =\n782:         pty_runtime_liveness(db, session_id, runtime).map_err(storage_error_diagnostic)?;\n783:     cleanup_idle_runtime(runtime, liveness);\n784:     Ok(optional_pty_liveness_is_busy(liveness))\n785: }\n786: \n787: fn acquire_startable_wake_claim(\n788:     db: &mut MailboxDb,\n789:     input: StartWakeInput<'_>,\n790:     claim_token: &str,\n791: ) -> Result<WakeClaimRow, WakeDiagnostic> {\n792:     let claim_result =\n793:         acquire_wake_claim(db, input, claim_token).map_err(storage_error_diagnostic)?;\n794:     wake_claim_to_start(claim_result)\n795: }\n796: \n797: fn wake_claim_to_start(result: WakeClaimAcquireResult) -> Result<WakeClaimRow, WakeDiagnostic> {\n798:     match result {\n799:         WakeClaimAcquireResult::Acquired(claim) => Ok(claim),\n800:         WakeClaimAcquireResult::NoPending => Err(WakeDiagnostic::status(\"no_pending\")),\n801:         WakeClaimAcquireResult::Busy => Err(WakeDiagnostic::status(\"busy\")),\n802:         WakeClaimAcquireResult::AlreadyInFlight(claim) => Err(already_in_flight_diagnostic(claim)),\n803:     }\n804: }\n805: \n806: fn wake_spawn_diagnostic(\n807:     db: &mut MailboxDb,\n808:     input: StartWakeInput<'_>,\n809:     runtime: Option<&SessionRuntimeRow>,\n810:     claim: WakeClaimRow,\n811:     spawn: Result<i64, String>,\n812: ) -> WakeDiagnostic {\n813:     match spawn {\n814:         Ok(wake_pid) => successful_wake_spawn_diagnostic(db, input, runtime, claim, wake_pid),\n815:         Err(err) => failed_wake_spawn_diagnostic(db, input, claim, err),\n816:     }\n817: }\n818: \n819: fn successful_wake_spawn_diagnostic(\n820:     db: &mut MailboxDb,\n821:     input: StartWakeInput<'_>,\n822:     runtime: Option<&SessionRuntimeRow>,\n823:     claim: WakeClaimRow,\n824:     wake_pid: i64,\n825: ) -> WakeDiagnostic {\n826:     record_wake_pid_or_warn(db, input.session_id, &claim.claim_token, wake_pid, runtime);\n827:     spawned_wake_diagnostic(claim.claim_token, wake_pid, input.auto_wake_count)\n828: }\n829: \n830: fn failed_wake_spawn_diagnostic(\n831:     db: &mut MailboxDb,\n832:     input: StartWakeInput<'_>,\n833:     claim: WakeClaimRow,\n834:     err: String,\n835: ) -> WakeDiagnostic {\n836:     let _ = db.release_wake_claim(input.session_id, Some(&claim.claim_token));\n837:     spawn_error_diagnostic(claim.claim_token, input.auto_wake_count, err)\n838: }\n839: \n840: fn open_wake_mailbox() -> Result<MailboxDb, String> {\n841:     MailboxDb::open_default()\n842: }\n843: \n844: fn session_runtime_for_wake(\n845:     db: &MailboxDb,\n846:     session_id: &str,\n847: ) -> Result<Option<SessionRuntimeRow>, String> {\n848:     db.session_runtime(session_id)\n849: }\n850: \n851: fn pty_runtime_liveness(\n852:     db: &mut MailboxDb,\n853:     session_id: &str,\n854:     runtime: Option<&SessionRuntimeRow>,\n855: ) -> Result<Option<SessionLiveness>, String> {\n856:     if running_pty_runtime(runtime).is_none() {\n857:         return Ok(None);\n858:     };\n859:     session_liveness_for_runtime(db, session_id).map(Some)\n860: }\n861: \n862: fn running_pty_runtime(runtime: Option<&SessionRuntimeRow>) -> Option<&SessionRuntimeRow> {\n863:     runtime.filter(|row| row.mode == \"pty_interactive\" && row.run_state == \"running\")\n864: }\n865: \n866: fn session_liveness_for_runtime(\n867:     db: &mut MailboxDb,\n868:     session_id: &str,\n869: ) -> Result<SessionLiveness, String> {\n870:     db.session_liveness(session_id)\n871: }\n872: \n873: fn cleanup_idle_runtime(runtime: Option<&SessionRuntimeRow>, liveness: Option<SessionLiveness>) {\n874:     if let (Some(row), Some(SessionLiveness::Idle)) = (running_pty_runtime(runtime), liveness) {\n875:         unlink_stale_pty_socket(row.pty_control_path.as_deref());\n876:     }\n877: }\n878: \n879: fn optional_pty_liveness_is_busy(liveness: Option<SessionLiveness>) -> bool {\n880:     liveness.is_some_and(pty_liveness_is_busy)\n881: }\n882: \n883: fn pty_liveness_is_busy(liveness: SessionLiveness) -> bool {\n884:     liveness == SessionLiveness::Busy\n885: }\n886: \n887: #[cfg(unix)]\n888: fn unlink_stale_pty_socket(path: Option<&str>) {\n889:     if let Some(path) = path {\n890:         let _ = pty_broker::unlink_control_socket_if_owned(path);\n891:     }\n892: }\n893: \n894: #[cfg(not(unix))]\n895: fn unlink_stale_pty_socket(_path: Option<&str>) {}\n896: \n897: fn acquire_wake_claim(\n898:     db: &mut MailboxDb,\n899:     input: StartWakeInput<'_>,\n900:     claim_token: &str,\n901: ) -> Result<WakeClaimAcquireResult, String> {\n902:     db.try_acquire_or_renew_wake_claim(wake_claim_request(input, claim_token), input.renew_token)\n903: }\n904: \n905: fn wake_claim_request<'a>(input: StartWakeInput<'a>, claim_token: &'a str) -> WakeClaimRequest<'a> {\n906:     WakeClaimRequest {\n907:         session_id: input.session_id,\n908:         claim_token,\n909:         reason: input.reason,\n910:         auto_wake_count: input.auto_wake_count,\n911:         wake_invocation_uuid: None,\n912:         stale_after_seconds: WAKE_CLAIM_STALE_AFTER_SECONDS,\n913:     }\n914: }\n915: \n916: fn already_in_flight_diagnostic(claim: WakeClaimRow) -> WakeDiagnostic {\n917:     let mut diagnostic = WakeDiagnostic::status(\"already_in_flight\");\n918:     diagnostic.claim_token = Some(claim.claim_token);\n919:     diagnostic.wake_pid = claim.wake_pid;\n920:     diagnostic.auto_wake_count = Some(claim.auto_wake_count);\n921:     diagnostic\n922: }\n923: \n924: fn record_wake_pid_or_warn(\n925:     db: &mut MailboxDb,\n926:     session_id: &str,\n927:     claim_token: &str,\n928:     wake_pid: i64,\n929:     runtime: Option<&SessionRuntimeRow>,\n930: ) {\n931:     let provider_name = runtime.and_then(|row| row.provider_name.as_deref());\n932:     let model_name = runtime.and_then(|row| row.model_name.as_deref());\n933:     if let Err(err) = db.record_wake_claim_pid_identity(\n934:         session_id,\n935:         claim_token,\n936:         wake_pid,\n937:         provider_name,\n938:         model_name,\n939:     ) {\n940:         tracing::warn!(session_id, claim_token, \"Failed to record wake PID: {err}\");\n941:     }\n942: }\n943: \n944: fn spawned_wake_diagnostic(\n945:     claim_token: String,\n946:     wake_pid: i64,\n947:     auto_wake_count: i64,\n948: ) -> WakeDiagnostic {\n949:     WakeDiagnostic {\n950:         attempted: true,\n951:         status: \"spawned\".to_string(),\n952:         claim_token: Some(claim_token),\n953:         wake_pid: Some(wake_pid),\n954:         auto_wake_count: Some(auto_wake_count),\n955:         message: None,\n956:     }\n957: }\n958: \n959: fn spawn_error_diagnostic(\n960:     claim_token: String,\n961:     auto_wake_count: i64,\n962:     err: String,\n963: ) -> WakeDiagnostic {\n964:     WakeDiagnostic {\n965:         attempted: true,\n966:         status: \"spawn_error\".to_string(),\n967:         claim_token: Some(claim_token),\n968:         wake_pid: None,\n969:         auto_wake_count: Some(auto_wake_count),\n970:         message: Some(err),\n971:     }\n972: }\n973: \n974: fn spawn_detached_resume(\n975:     session_id: &str,\n976:     runtime: Option<&SessionRuntimeRow>,\n977:     claim_token: &str,\n978:     auto_wake_count: i64,\n979: ) -> Result<i64, String> {\n980:     let exe = current_agents_exe()?;\n981:     let cmd = detached_resume_command(exe, session_id, runtime, claim_token, auto_wake_count);\n982:     spawn_detached_child(cmd)\n983: }\n984: \n985: fn current_agents_exe() -> Result<PathBuf, String> {\n986:     std::env::current_exe().map_err(current_agents_exe_error)\n987: }\n988: \n989: fn current_agents_exe_error(err: std::io::Error) -> String {\n990:     format!(\"Failed to resolve current agents binary: {err}\")\n991: }\n992: \n993: fn spawn_detached_child(mut cmd: Command) -> Result<i64, String> {\n994:     cmd.spawn().map(child_pid).map_err(detached_spawn_error)\n995: }\n996: \n997: fn child_pid(child: Child) -> i64 {\n998:     i64::from(child.id())\n999: }\n1000: \n1001: fn detached_spawn_error(err: std::io::Error) -> String {\n1002:     format!(\"Failed to spawn detached wake resume: {err}\")\n1003: }\n1004: \n1005: fn detached_resume_command(\n1006:     exe: PathBuf,\n1007:     session_id: &str,\n1008:     runtime: Option<&SessionRuntimeRow>,\n1009:     claim_token: &str,\n1010:     auto_wake_count: i64,\n1011: ) -> Command {\n1012:     let mut cmd = Command::new(exe);\n1013:     configure_resume_args(&mut cmd, session_id, runtime);\n1014:     configure_wake_stdio_and_env(&mut cmd, session_id, claim_token, auto_wake_count);\n1015:     configure_detached(&mut cmd);\n1016:     cmd\n1017: }\n1018: \n1019: fn configure_resume_args(cmd: &mut Command, session_id: &str, runtime: Option<&SessionRuntimeRow>) {\n1020:     cmd.arg(\"resume\").arg(\"--session-id\").arg(session_id);\n1021:     append_non_empty_arg(cmd, \"-m\", runtime.and_then(|row| row.model_name.as_deref()));\n1022:     append_non_empty_arg(\n1023:         cmd,\n1024:         \"--models-dir\",\n1025:         runtime.and_then(|row| row.models_dir.as_deref()),\n1026:     );\n1027: }\n1028: \n1029: fn append_non_empty_arg(cmd: &mut Command, flag: &str, value: Option<&str>) {\n1030:     let Some(value) = value.filter(|value| !value.is_empty()) else {\n1031:         return;\n1032:     };\n1033:     cmd.arg(flag).arg(value);\n1034: }\n1035: \n1036: fn configure_wake_stdio_and_env(\n1037:     cmd: &mut Command,\n1038:     session_id: &str,\n1039:     claim_token: &str,\n1040:     auto_wake_count: i64,\n1041: ) {\n1042:     cmd.stdin(Stdio::null())\n1043:         .stdout(Stdio::null())\n1044:         .stderr(Stdio::null())\n1045:         .env(AUTO_WAKE_ENV, \"1\")\n1046:         .env(AUTO_WAKE_SESSION_ID_ENV, session_id)\n1047:         .env(AUTO_WAKE_TOKEN_ENV, claim_token)\n1048:         .env(AUTO_WAKE_COUNT_ENV, auto_wake_count.to_string())\n1049:         .env_remove(PARENT_INVOCATION_ENV);\n1050: }\n1051: \n1052: #[cfg(unix)]\n1053: fn configure_detached(cmd: &mut Command) {\n1054:     unsafe {\n1055:         cmd.pre_exec(|| {\n1056:             if libc::setsid() == -1 {\n1057:                 return Err(std::io::Error::last_os_error());\n1058:             }\n1059:             Ok(())\n1060:         });\n1061:     }\n1062: }\n1063: \n1064: #[cfg(not(unix))]\n1065: fn configure_detached(_cmd: &mut Command) {}\n1066: \n1067: fn pending_count(session_id: &str) -> Result<usize, String> {\n1068:     crate::mailbox_delivery::deliverable_pending_count(session_id)\n1069: }\n1070: \n1071: fn current_auto_wake() -> Option<AutoWakeEnv> {\n1072:     auto_wake_marker_present()\n1073:         .then(current_auto_wake_env)\n1074:         .flatten()\n1075: }\n1076: \n1077: fn auto_wake_max() -> i64 {\n1078:     validated_auto_wake_max(parsed_auto_wake_max())\n1079: }\n1080: \n1081: fn current_auto_wake_env() -> Option<AutoWakeEnv> {\n1082:     Some(auto_wake_env(auto_wake_token()?, auto_wake_count()))\n1083: }\n1084: \n1085: fn auto_wake_count() -> i64 {\n1086:     parse_auto_wake_count(auto_wake_count_value())\n1087: }\n1088: \n1089: fn parsed_auto_wake_max() -> Option<i64> {\n1090:     parse_auto_wake_max(auto_wake_max_value())\n1091: }\n1092: \n1093: fn auto_wake_token() -> Option<String> {\n1094:     std::env::var(AUTO_WAKE_TOKEN_ENV).ok()\n1095: }\n1096: \n1097: fn auto_wake_count_value() -> Option<String> {\n1098:     std::env::var(AUTO_WAKE_COUNT_ENV).ok()\n1099: }\n1100: \n1101: fn auto_wake_max_value() -> Option<String> {\n1102:     std::env::var(AUTO_WAKE_MAX_ENV).ok()\n1103: }\n1104: \n1105: fn parse_auto_wake_count(value: Option<String>) -> i64 {\n1106:     value.and_then(|value| value.parse().ok()).unwrap_or(1)\n1107: }\n1108: \n1109: fn parse_auto_wake_max(value: Option<String>) -> Option<i64> {\n1110:     value.and_then(|value| value.parse::<i64>().ok())\n1111: }\n1112: \n1113: fn validated_auto_wake_max(value: Option<i64>) -> i64 {\n1114:     value\n1115:         .filter(|value| *value > 0)\n1116:         .unwrap_or(DEFAULT_AUTO_WAKE_MAX)\n1117: }\n1118: \n1119: fn auto_wake_env(token: String, count: i64) -> AutoWakeEnv {\n1120:     AutoWakeEnv { token, count }\n1121: }\n1122: \n1123: fn release_current_auto_wake_claim(session_id: &str, auto_wake: Option<&AutoWakeEnv>) {\n1124:     let Some(auto_wake) = auto_wake else {\n1125:         return;\n1126:     };\n1127:     match MailboxDb::open_default_if_exists() {\n1128:         Ok(Some(mut db)) => release_wake_claim_or_warn(&mut db, session_id, &auto_wake.token),\n1129:         Ok(None) => {}\n1130:         Err(err) => warn_open_sidecar_for_release_failed(session_id, err),\n1131:     }\n1132: }\n1133: \n1134: fn release_wake_claim_or_warn(db: &mut MailboxDb, session_id: &str, token: &str) {\n1135:     if let Err(err) = db.release_wake_claim(session_id, Some(token)) {\n1136:         warn_release_wake_claim_failed(session_id, err);\n1137:     }\n1138: }\n1139: \n1140: fn warn_release_wake_claim_failed(session_id: &str, err: String) {\n1141:     tracing::warn!(session_id, \"Failed to release wake claim: {err}\");\n1142: }\n1143: \n1144: fn warn_open_sidecar_for_release_failed(session_id: &str, err: String) {\n1145:     tracing::warn!(\n1146:         session_id,\n1147:         \"Failed to open sidecar to release wake claim: {err}\"\n1148:     );\n1149: }\n\n(End of file - total 1149 lines)\n</content>","metadata":{"preview":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n//! `predicate`, `validator`\n\nuse oulipoly_state::StateDb;\nuse oulipoly_state::mailbox::{\n    MailboxDb, MailboxRow, SessionLiveness, SessionRuntimeIdleUpdate, SessionRuntimeRow,\n    WAKE_SWEEP_ABANDONED_ERROR, WakeClaimAcquireResult, WakeClaimRequest, WakeClaimRow,\n    WakeSweepCandidate,\n};\nuse oulipoly_state::pid_identity::{ProcessIdentity, read_live_process_identity};\nuse serde::Serialize;\nuse std::path::PathBuf;\nuse std::process::{Child, Command, Stdio};\nuse std::sync::OnceLock;\nuse std::time::Duration;\nuse uuid::Uuid;\n\n#[cfg(unix)]","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/nes/projects/agent-runner/worktrees/wake-sweep-robustness/src-tauri/src/wake_coordinator.rs","text":"//! ## Declared roles\n//!\n//! `accessor`, `filter`, `formatter`, `mapper`, `orchestration`, `parser`,\n//! `predicate`, `validator`\n\nuse oulipoly_state::StateDb;\nuse oulipoly_state::mailbox::{\n    MailboxDb, MailboxRow, SessionLiveness, SessionRuntimeIdleUpdate, SessionRuntimeRow,\n    WAKE_SWEEP_ABANDONED_ERROR, WakeClaimAcquireResult, WakeClaimRequest, WakeClaimRow,\n    WakeSweepCandidate,\n};\nuse oulipoly_state::pid_identity::{ProcessIdentity, read_live_process_identity};\nuse serde::Serialize;\nuse std::path::PathBuf;\nuse std::process::{Child, Command, Stdio};\nuse std::sync::OnceLock;\nuse std::time::Duration;\nuse uuid::Uuid;\n\n#[cfg(unix)]\nuse oulipoly_runtime::executor::cli::pty_broker;\n#[cfg(unix)]\nuse std::os::unix::process::CommandExt;\n\nconst AUTO_WAKE_ENV: &str = \"OULIPOLY_AUTO_WAKE\";\nconst AUTO_WAKE_SESSION_ID_ENV: &str = \"OULIPOLY_AUTO_WAKE_SESSION_ID\";\nconst AUTO_WAKE_TOKEN_ENV: &str = \"OULIPOLY_AUTO_WAKE_TOKEN\";\nconst AUTO_WAKE_COUNT_ENV: &str = \"OULIPOLY_AUTO_WAKE_COUNT\";\nconst AUTO_WAKE_MAX_ENV: &str = \"OULIPOLY_AUTO_WAKE_MAX\";\nconst AUTO_WAKE_RETRY_BASE_MS_ENV: &str = \"OULIPOLY_AUTO_WAKE_RETRY_BASE_MS\";\nconst PARENT_INVOCATION_ENV: &str = \"OULIPOLY_PARENT_INVOCATION\";\nconst DEFAULT_AUTO_WAKE_MAX: i64 = 5;\nconst DEFAULT_AUTO_WAKE_RETRY_BASE_MS: u64 = 1_000;\nconst AUTO_WAKE_RETRY_MAX_MS: u64 = 30_000;\nconst WAKE_CLAIM_STALE_AFTER_SECONDS: i64 = 10 * 60;\nconst WAKE_RECLAIM_SWEEP_LIMIT: usize = 8;\nconst WAKE_RECLAIM_SWEEP_SCAN_LIMIT: usize = WAKE_RECLAIM_SWEEP_LIMIT * 32;\nconst WAKE_RECLAIM_REAP_SESSION_LIMIT: usize = 32;\nconst WAKE_RECLAIM_REAP_ROWS_PER_SESSION: usize = 20;\n#[allow(dead_code)]\nconst WAKE_RECLAIM_SWEEP_INTERVAL_SECONDS: u64 = 60;\nconst CONSUMED_NOTIFICATION_MARKER: &str = \"[OULIPOLY NOTIFICATIONS]\";\n\n#[derive(Debug, Clone, Serialize)]\npub(crate) struct WakeDiagnostic {\n    pub(crate) attempted: bool,\n    pub(crate) status: String,\n    pub(crate) claim_token: Option<String>,\n    pub(crate) wake_pid: Option<i64>,\n    pub(crate) auto_wake_count: Option<i64>,\n    pub(crate) message: Option<String>,\n}\n\nimpl WakeDiagnostic {\n    fn status(status: &str) -> Self {\n        Self {\n            attempted: false,\n            status: status.to_string(),\n            claim_token: None,\n            wake_pid: None,\n            auto_wake_count: None,\n            message: None,\n        }\n    }\n\n    fn with_message(status: &str, message: String) -> Self {\n        Self {\n            attempted: false,\n            status: status.to_string(),\n            claim_token: None,\n            wake_pid: None,\n            auto_wake_count: None,\n            message: Some(message),\n        }\n    }\n}\n\npub(crate) fn mark_session_idle_after_turn(\n    session_id: &str,\n    invocation_uuid: &str,\n    exit_code: Option<i32>,\n) -> Result<(), String> {\n    let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n        return Ok(());\n    };\n    db.mark_session_idle(SessionRuntimeIdleUpdate {\n        session_id,\n        invocation_uuid,\n        last_exit_code: exit_code,\n    })?;\n    Ok(())\n}\n\npub(crate) fn trigger_notify_wake(session_id: &str) -> WakeDiagnostic {\n    start_wake_chain(StartWakeInput {\n        session_id,\n        reason: \"notify_idle\",\n        auto_wake_count: 1,\n        renew_token: None,\n    })\n}\n\npub(crate) fn run_startup_wake_reclaim_sweep() {\n    if is_auto_wake_invocation() {\n        return;\n    }\n    run_wake_reclaim_sweep_or_warn(\"process_start\");\n}\n\n#[allow(dead_code)]\npub(crate) fn start_wake_reclaim_maintenance_driver() {\n    static DRIVER: OnceLock<()> = OnceLock::new();\n    DRIVER.get_or_init(spawn_wake_reclaim_maintenance_driver);\n}\n\n#[allow(dead_code)]\nfn spawn_wake_reclaim_maintenance_driver() {\n    let result = std::thread::Builder::new()\n        .name(\"oulipoly-wake-reclaim-sweep\".to_string())\n        .spawn(wake_reclaim_maintenance_loop);\n    if let Err(err) = result {\n        tracing::warn!(\"Failed to start wake reclaim sweep driver: {err}\");\n    }\n}\n\n#[allow(dead_code)]\nfn wake_reclaim_maintenance_loop() {\n    run_wake_reclaim_sweep_or_warn(\"maintenance_start\");\n    loop {\n        std::thread::sleep(Duration::from_secs(WAKE_RECLAIM_SWEEP_INTERVAL_SECONDS));\n        run_wake_reclaim_sweep_or_warn(\"maintenance_tick\");\n    }\n}\n\nfn run_wake_reclaim_sweep_or_warn(trigger: &str) {\n    if let Err(err) = run_wake_reclaim_sweep(trigger) {\n        tracing::warn!(trigger, \"Wake reclaim sweep failed: {err}\");\n    }\n}\n\nfn run_wake_reclaim_sweep(trigger: &str) -> Result<(), String> {\n    let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n        return Ok(());\n    };\n    let candidates = db.wake_sweep_candidates(\n        WAKE_CLAIM_STALE_AFTER_SECONDS,\n        WAKE_RECLAIM_SWEEP_SCAN_LIMIT,\n    )?;\n    let plan = wake_sweep_plan(&mut db, candidates)?;\n    reap_abandoned_sweep_candidates(&mut db, &plan.reap)?;\n    drop(db);\n    for candidate in plan.start {\n        let diagnostic = start_wake_chain(StartWakeInput {\n            session_id: &candidate.session_id,\n            reason: trigger,\n            auto_wake_count: candidate.auto_wake_count,\n            renew_token: None,\n        });\n        trace_wake_sweep_candidate(&candidate.session_id, &diagnostic);\n    }\n    Ok(())\n}\n\nstruct WakeSweepPlan {\n    start: Vec<WakeSweepCandidate>,\n    reap: Vec<WakeSweepCandidate>,\n}\n\nfn wake_sweep_plan(\n    db: &mut MailboxDb,\n    candidates: Vec<WakeSweepCandidate>,\n) -> Result<WakeSweepPlan, String> {\n    let (recoverable, reap) = partition_wake_sweep_candidates(db, candidates)?;\n    let start = select_recoverable_sweep_candidates(recoverable);\n    Ok(wake_sweep_plan_from_selected(start, reap))\n}\n\nfn partition_wake_sweep_candidates(\n    db: &mut MailboxDb,\n    candidates: Vec<WakeSweepCandidate>,\n) -> Result<(Vec<WakeSweepCandidate>, Vec<WakeSweepCandidate>), String> {\n    let state = open_default_state_read_only();\n    let mut recoverable = Vec::new();\n    let mut reap = Vec::new();\n    for candidate in candidates {\n        match wake_sweep_candidate_disposition(db, state.as_ref(), &candidate)? {\n            WakeSweepDisposition::Recoverable => {\n                recoverable.push(candidate);\n            }\n            WakeSweepDisposition::Abandoned => {\n                if reap.len() < WAKE_RECLAIM_REAP_SESSION_LIMIT {\n                    reap.push(candidate);\n                }\n            }\n            WakeSweepDisposition::Skip => {}\n        }\n    }\n    Ok((recoverable, reap))\n}\n\nfn wake_sweep_plan_from_selected(\n    start: Vec<WakeSweepCandidate>,\n    reap: Vec<WakeSweepCandidate>,\n) -> WakeSweepPlan {\n    WakeSweepPlan { start, reap }\n}\n\nfn select_recoverable_sweep_candidates(\n    mut candidates: Vec<WakeSweepCandidate>,\n) -> Vec<WakeSweepCandidate> {\n    if candidates.len() <= WAKE_RECLAIM_SWEEP_LIMIT {\n        return candidates;\n    }\n    candidates.sort_by_key(|candidate| candidate.min_pending_seq);\n    let oldest_slots = WAKE_RECLAIM_SWEEP_LIMIT.div_ceil(2);\n    let newest_slots = WAKE_RECLAIM_SWEEP_LIMIT.saturating_sub(oldest_slots);\n    let mut selected = candidates\n        .iter()\n        .take(oldest_slots)\n        .cloned()\n        .collect::<Vec<_>>();\n    for candidate in candidates.iter().rev().take(newest_slots) {\n        if !selected\n            .iter()\n            .any(|existing| existing.session_id == candidate.session_id)\n        {\n            selected.push(candidate.clone());\n        }\n    }\n    selected\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\nenum WakeSweepDisposition {\n    Recoverable,\n    Abandoned,\n    Skip,\n}\n\nfn wake_sweep_candidate_disposition(\n    db: &MailboxDb,\n    state: Option<&StateDb>,\n    candidate: &WakeSweepCandidate,\n) -> Result<WakeSweepDisposition, String> {\n    // Recoverable means either an idle headless runtime with durable resume\n    // evidence, or a live owner PID identity that must not be reaped. Missing\n    // runtime/history with no live owner is abandoned debris, not resumable work.\n    if pending_mailbox_consumed_marker_present(db, &candidate.session_id) {\n        return Ok(WakeSweepDisposition::Skip);\n    }\n    if wake_sweep_candidate_is_resumable(db, state, candidate)? {\n        return Ok(resumable_wake_sweep_disposition(candidate));\n    }\n    if wake_sweep_candidate_has_live_owner(db, &candidate.session_id)? {\n        return Ok(WakeSweepDisposition::Skip);\n    }\n    Ok(WakeSweepDisposition::Abandoned)\n}\n\nfn resumable_wake_sweep_disposition(candidate: &WakeSweepCandidate) -> WakeSweepDisposition {\n    if wake_sweep_candidate_reached_cap(candidate)\n        || !wake_sweep_candidate_has_deliverable_pending(&candidate.session_id)\n    {\n        return WakeSweepDisposition::Skip;\n    }\n    WakeSweepDisposition::Recoverable\n}\n\nfn reap_abandoned_sweep_candidates(\n    db: &mut MailboxDb,\n    candidates: &[WakeSweepCandidate],\n) -> Result<(), String> {\n    for candidate in candidates {\n        db.mark_pending_abandoned(\n            &candidate.session_id,\n            WAKE_SWEEP_ABANDONED_ERROR,\n            WAKE_RECLAIM_REAP_ROWS_PER_SESSION,\n        )?;\n    }\n    Ok(())\n}\n\nfn wake_sweep_candidate_has_deliverable_pending(session_id: &str) -> bool {\n    crate::mailbox_delivery::deliverable_pending_count(session_id)\n        .map(|count| count > 0)\n        .unwrap_or(false)\n}\n\nfn wake_sweep_candidate_is_resumable(\n    db: &MailboxDb,\n    state: Option<&StateDb>,\n    candidate: &WakeSweepCandidate,\n) -> Result<bool, String> {\n    let Some(runtime) = db.session_runtime(&candidate.session_id)? else {\n        return Ok(false);\n    };\n    if !wake_sweep_runtime_can_resume(&runtime) {\n        return Ok(false);\n    }\n    wake_sweep_runtime_has_resume_evidence(state, &runtime)\n}\n\nfn wake_sweep_runtime_can_resume(runtime: &SessionRuntimeRow) -> bool {\n    runtime.mode == \"headless\"\n        && runtime.run_state != \"running\"\n        && runtime\n            .provider_name\n            .as_deref()\n            .is_some_and(|provider| !provider.is_empty())\n}\n\nfn wake_sweep_runtime_has_resume_evidence(\n    state: Option<&StateDb>,\n    runtime: &SessionRuntimeRow,\n) -> Result<bool, String> {\n    let Some(state) = state else {\n        return Ok(false);\n    };\n    let Some(provider_name) = runtime.provider_name.as_deref() else {\n        return Ok(false);\n    };\n    if state\n        .chain_id_for_segment(provider_name, &runtime.session_id)\n        .map_err(|err| err.to_string())?\n        .is_some()\n    {\n        return Ok(true);\n    }\n    state\n        .count_session_turns(provider_name, &runtime.session_id)\n        .map(|counts| counts.total > 0)\n}\n\nfn wake_sweep_candidate_has_live_owner(db: &MailboxDb, session_id: &str) -> Result<bool, String> {\n    for row in db.list_pending(session_id)? {\n        if mailbox_row_has_live_owner_identity(&row)? {\n            return Ok(true);\n        }\n    }\n    Ok(false)\n}\n\nfn mailbox_row_has_live_owner_identity(row: &MailboxRow) -> Result<bool, String> {\n    let Some(recorded) = mailbox_row_owner_identity(row) else {\n        return Ok(false);\n    };\n    read_live_process_identity(recorded.os_pid).map(|live| live.as_ref() == Some(&recorded))\n}\n\nfn mailbox_row_owner_identity(row: &MailboxRow) -> Option<ProcessIdentity> {\n    Some(ProcessIdentity {\n        os_pid: row.matched_os_pid?,\n        os_boot_id: row.matched_os_boot_id.clone()?,\n        os_pid_starttime_ticks: row.matched_os_pid_starttime_ticks?,\n    })\n}\n\nfn wake_sweep_candidate_reached_cap(candidate: &WakeSweepCandidate) -> bool {\n    auto_wake_cap_reached(candidate.auto_wake_count.saturating_sub(1), auto_wake_max())\n}\n\nfn pending_mailbox_consumed_marker_present(db: &MailboxDb, session_id: &str) -> bool {\n    let Ok(pending) = db.list_pending(session_id) else {\n        return false;\n    };\n    if pending.is_empty() {\n        return true;\n    }\n    let Some(provider_name) = pending_mailbox_provider_name(db, session_id) else {\n        return false;\n    };\n    let Some(state) = open_default_state_read_only() else {\n        return false;\n    };\n    session_has_consumed_notification_marker(&state, &provider_name, session_id)\n        && pending.iter().all(|row| {\n            state\n                .has_session_user_turn_containing(\n                    &provider_name,\n                    session_id,\n                    &mailbox_handle_marker(row),\n                )\n                .unwrap_or(false)\n        })\n}\n\nfn mailbox_handle_marker(row: &MailboxRow) -> String {\n    format!(\"handle: {}\", row.handle)\n}\n\nfn open_default_state_read_only() -> Option<StateDb> {\n    let path = StateDb::default_path().ok()?;\n    if !path.exists() {\n        return None;\n    }\n    StateDb::open_read_only(&path).ok()\n}\n\nfn pending_mailbox_provider_name(db: &MailboxDb, session_id: &str) -> Option<String> {\n    db.session_runtime(session_id)\n        .ok()\n        .flatten()\n        .and_then(|runtime| runtime.provider_name)\n}\n\nfn session_has_consumed_notification_marker(\n    state: &StateDb,\n    provider_name: &str,\n    session_id: &str,\n) -> bool {\n    state\n        .has_session_user_turn_containing(provider_name, session_id, CONSUMED_NOTIFICATION_MARKER)\n        .unwrap_or(false)\n}\n\nfn trace_wake_sweep_candidate(session_id: &str, diagnostic: &WakeDiagnostic) {\n    tracing::debug!(\n        session_id,\n        status = diagnostic.status.as_str(),\n        \"Wake reclaim sweep candidate evaluated\"\n    );\n}\n\npub(crate) fn mark_successful_turn_idle_and_recheck(\n    session_id: &str,\n    invocation_uuid: &str,\n    exit_code: i32,\n) -> Result<WakeDiagnostic, String> {\n    mark_session_idle_after_turn(session_id, invocation_uuid, Some(exit_code))?;\n    Ok(successful_turn_recheck(session_id))\n}\n\nfn successful_turn_recheck(session_id: &str) -> WakeDiagnostic {\n    trigger_turn_end_recheck(session_id)\n}\n\npub(crate) fn validate_auto_wake_child(session_id: &str) -> Result<Option<i32>, String> {\n    if !auto_wake_marker_present() {\n        return Ok(None);\n    }\n    let marker = auto_wake_child_marker();\n    if !auto_wake_child_marker_matches(session_id, &marker) {\n        return Ok(Some(0));\n    }\n    validate_auto_wake_child_claim(session_id, &marker.claim_token)\n}\n\nstruct AutoWakeChildMarker {\n    expected_session: String,\n    claim_token: String,\n}\n\nfn auto_wake_marker_present() -> bool {\n    std::env::var_os(AUTO_WAKE_ENV).is_some()\n}\n\nfn auto_wake_child_marker() -> AutoWakeChildMarker {\n    auto_wake_child_marker_from_parts(auto_wake_expected_session(), auto_wake_child_claim_token())\n}\n\nfn auto_wake_expected_session() -> String {\n    std::env::var(AUTO_WAKE_SESSION_ID_ENV).unwrap_or_default()\n}\n\nfn auto_wake_child_claim_token() -> String {\n    std::env::var(AUTO_WAKE_TOKEN_ENV).unwrap_or_default()\n}\n\nfn auto_wake_child_marker_from_parts(\n    expected_session: String,\n    claim_token: String,\n) -> AutoWakeChildMarker {\n    AutoWakeChildMarker {\n        expected_session,\n        claim_token,\n    }\n}\n\nfn auto_wake_child_marker_matches(session_id: &str, marker: &AutoWakeChildMarker) -> bool {\n    marker.expected_session == session_id && !marker.claim_token.is_empty()\n}\n\nfn validate_auto_wake_child_claim(\n    session_id: &str,\n    claim_token: &str,\n) -> Result<Option<i32>, String> {\n    let Some(mut db) = open_optional_wake_mailbox()? else {\n        return Ok(Some(0));\n    };\n    validate_auto_wake_claim_with_db(&mut db, session_id, claim_token)\n}\n\nfn open_optional_wake_mailbox() -> Result<Option<MailboxDb>, String> {\n    MailboxDb::open_default_if_exists()\n}\n\nfn validate_auto_wake_claim_with_db(\n    db: &mut MailboxDb,\n    session_id: &str,\n    claim_token: &str,\n) -> Result<Option<i32>, String> {\n    db.validate_wake_claim_for_child(session_id, claim_token)\n        .map(auto_wake_child_validation_result)\n}\n\nfn auto_wake_child_validation_result(valid: bool) -> Option<i32> {\n    if valid { None } else { Some(0) }\n}\n\npub(crate) fn is_auto_wake_invocation() -> bool {\n    auto_wake_marker_present()\n}\n\npub(crate) fn reset_manual_resume_wake_claim(session_id: &str) -> Result<(), String> {\n    let Some(mut db) = MailboxDb::open_default_if_exists()? else {\n        return Ok(());\n    };\n    db.release_wake_claim(session_id, None)?;\n    Ok(())\n}\n\npub(crate) fn release_current_auto_wake_claim_for_session(session_id: &str) {\n    let auto_wake = current_auto_wake();\n    release_current_auto_wake_claim(session_id, auto_wake.as_ref());\n}\n\npub(crate) fn recheck_after_failed_auto_wake(session_id: &str) -> WakeDiagnostic {\n    let Some(auto_wake) = current_auto_wake() else {\n        return WakeDiagnostic::status(\"not_auto_wake\");\n    };\n    release_current_auto_wake_claim(session_id, Some(&auto_wake));\n    failed_auto_wake_recheck(session_id, &auto_wake)\n}\n\nfn trigger_turn_end_recheck(session_id: &str) -> WakeDiagnostic {\n    let pending_count = match turn_end_pending_count(session_id) {\n        Ok(count) => count,\n        Err(err) => return storage_error_diagnostic(err),\n    };\n    let auto_wake = current_auto_wake();\n    apply_turn_end_recheck_decision(\n        session_id,\n        auto_wake.as_ref(),\n        turn_end_recheck_decision(session_id, pending_count, auto_wake.as_ref()),\n    )\n}\n\nfn failed_auto_wake_recheck(session_id: &str, auto_wake: &AutoWakeEnv) -> WakeDiagnostic {\n    let pending_count = match turn_end_pending_count(session_id) {\n        Ok(count) => count,\n        Err(err) => return storage_error_diagnostic(err),\n    };\n    apply_failed_auto_wake_recheck_decision(\n        session_id,\n        auto_wake,\n        failed_auto_wake_recheck_decision(session_id, pending_count, auto_wake),\n    )\n}\n\nenum TurnEndRecheckDecision<'a> {\n    NoPending,\n    CapReached { current_count: i64, max_count: i64 },\n    Start(StartWakeInput<'a>),\n}\n\nfn turn_end_recheck_decision<'a>(\n    session_id: &'a str,\n    pending_count: usize,\n    auto_wake: Option<&'a AutoWakeEnv>,\n) -> TurnEndRecheckDecision<'a> {\n    if no_pending(pending_count) {\n        return TurnEndRecheckDecision::NoPending;\n    }\n    let current_count = current_auto_wake_count(auto_wake);\n    let max_count = auto_wake_max();\n    if auto_wake_cap_reached(current_count, max_count) {\n        return TurnEndRecheckDecision::CapReached {\n            current_count,\n            max_count,\n        };\n    }\n    TurnEndRecheckDecision::Start(StartWakeInput {\n        session_id,\n        reason: \"turn_end_recheck\",\n        auto_wake_count: current_count + 1,\n        renew_token: auto_wake.map(|wake| wake.token.as_str()),\n    })\n}\n\nfn apply_turn_end_recheck_decision(\n    session_id: &str,\n    auto_wake: Option<&AutoWakeEnv>,\n    decision: TurnEndRecheckDecision<'_>,\n) -> WakeDiagnostic {\n    match decision {\n        TurnEndRecheckDecision::NoPending => {\n            release_current_auto_wake_claim(session_id, auto_wake);\n            WakeDiagnostic::status(\"no_pending\")\n        }\n        TurnEndRecheckDecision::CapReached {\n            current_count,\n            max_count,\n        } => {\n            release_current_auto_wake_claim(session_id, auto_wake);\n            emit_auto_wake_cap_reached(session_id, current_count, max_count);\n            auto_wake_cap_diagnostic(current_count)\n        }\n        TurnEndRecheckDecision::Start(input) => start_wake_chain(input),\n    }\n}\n\nenum FailedAutoWakeRecheckDecision<'a> {\n    NoPending,\n    CapReached { current_count: i64, max_count: i64 },\n    Retry(StartWakeInput<'a>),\n}\n\nfn failed_auto_wake_recheck_decision<'a>(\n    session_id: &'a str,\n    pending_count: usize,\n    auto_wake: &'a AutoWakeEnv,\n) -> FailedAutoWakeRecheckDecision<'a> {\n    if no_pending(pending_count) {\n        return FailedAutoWakeRecheckDecision::NoPending;\n    }\n    let max_count = auto_wake_max();\n    if auto_wake_cap_reached(auto_wake.count, max_count) {\n        return FailedAutoWakeRecheckDecision::CapReached {\n            current_count: auto_wake.count,\n            max_count,\n        };\n    }\n    FailedAutoWakeRecheckDecision::Retry(StartWakeInput {\n        session_id,\n        reason: \"wake_failure_retry\",\n        auto_wake_count: auto_wake.count + 1,\n        renew_token: None,\n    })\n}\n\nfn apply_failed_auto_wake_recheck_decision(\n    session_id: &str,\n    auto_wake: &AutoWakeEnv,\n    decision: FailedAutoWakeRecheckDecision<'_>,\n) -> WakeDiagnostic {\n    match decision {\n        FailedAutoWakeRecheckDecision::NoPending => WakeDiagnostic::status(\"no_pending\"),\n        FailedAutoWakeRecheckDecision::CapReached {\n            current_count,\n            max_count,\n        } => {\n            emit_auto_wake_cap_reached(session_id, current_count, max_count);\n            auto_wake_cap_diagnostic(current_count)\n        }\n        FailedAutoWakeRecheckDecision::Retry(input) => {\n            sleep_before_failed_auto_wake_retry(auto_wake.count);\n            start_wake_chain(input)\n        }\n    }\n}\n\nfn sleep_before_failed_auto_wake_retry(auto_wake_count: i64) {\n    std::thread::sleep(auto_wake_retry_delay(auto_wake_count));\n}\n\nfn auto_wake_retry_delay(auto_wake_count: i64) -> Duration {\n    Duration::from_millis(auto_wake_retry_delay_ms(auto_wake_count))\n}\n\nfn auto_wake_retry_delay_ms(auto_wake_count: i64) -> u64 {\n    let base_ms = auto_wake_retry_base_ms();\n    let exponent = auto_wake_count.saturating_sub(1).clamp(0, 10) as u32;\n    base_ms\n        .saturating_mul(2_u64.saturating_pow(exponent))\n        .min(AUTO_WAKE_RETRY_MAX_MS)\n}\n\nfn auto_wake_retry_base_ms() -> u64 {\n    parsed_auto_wake_retry_base_ms()\n        .filter(|value| *value > 0)\n        .unwrap_or(DEFAULT_AUTO_WAKE_RETRY_BASE_MS)\n}\n\nfn parsed_auto_wake_retry_base_ms() -> Option<u64> {\n    std::env::var(AUTO_WAKE_RETRY_BASE_MS_ENV)\n        .ok()\n        .and_then(|value| value.parse::<u64>().ok())\n}\n\nfn current_auto_wake_count(auto_wake: Option<&AutoWakeEnv>) -> i64 {\n    auto_wake.map(|wake| wake.count).unwrap_or(0)\n}\n\nfn turn_end_pending_count(session_id: &str) -> Result<usize, String> {\n    pending_count(session_id)\n}\n\nfn no_pending(pending_count: usize) -> bool {\n    pending_count == 0\n}\n\nfn auto_wake_cap_reached(current_count: i64, max_count: i64) -> bool {\n    current_count >= max_count\n}\n\nfn emit_auto_wake_cap_reached(session_id: &str, current_count: i64, max_count: i64) {\n    eprintln!(\n        \"auto_wake_cap_reached session_id={session_id} count={current_count} max={max_count}\"\n    );\n}\n\nfn auto_wake_cap_diagnostic(current_count: i64) -> WakeDiagnostic {\n    let mut diagnostic = WakeDiagnostic::status(\"auto_wake_cap_reached\");\n    diagnostic.auto_wake_count = Some(current_count);\n    diagnostic\n}\n\nfn storage_error_diagnostic(err: String) -> WakeDiagnostic {\n    WakeDiagnostic::with_message(\"storage_error\", err)\n}\n\nstruct AutoWakeEnv {\n    token: String,\n    count: i64,\n}\n\n#[derive(Clone, Copy)]\nstruct StartWakeInput<'a> {\n    session_id: &'a str,\n    reason: &'a str,\n    auto_wake_count: i64,\n    renew_token: Option<&'a str>,\n}\n\nfn start_wake_chain(input: StartWakeInput<'_>) -> WakeDiagnostic {\n    let claim_token = Uuid::new_v4().to_string();\n    let mut context = match prepare_wake_start_context(input, &claim_token) {\n        Ok(context) => context,\n        Err(diagnostic) => return diagnostic,\n    };\n    let spawn = spawn_detached_resume(\n        input.session_id,\n        context.runtime.as_ref(),\n        &context.claim.claim_token,\n        input.auto_wake_count,\n    );\n    wake_spawn_diagnostic(\n        &mut context.db,\n        input,\n        context.runtime.as_ref(),\n        context.claim,\n        spawn,\n    )\n}\n\nstruct WakeStartContext {\n    db: MailboxDb,\n    runtime: Option<SessionRuntimeRow>,\n    claim: WakeClaimRow,\n}\n\nfn prepare_wake_start_context(\n    input: StartWakeInput<'_>,\n    claim_token: &str,\n) -> Result<WakeStartContext, WakeDiagnostic> {\n    let mut db = open_wake_mailbox().map_err(storage_error_diagnostic)?;\n    let runtime =\n        session_runtime_for_wake(&db, input.session_id).map_err(storage_error_diagnostic)?;\n    if wake_runtime_busy(&mut db, input.session_id, runtime.as_ref())? {\n        return Err(WakeDiagnostic::status(\"busy\"));\n    }\n    let claim = acquire_startable_wake_claim(&mut db, input, claim_token)?;\n    Ok(WakeStartContext { db, runtime, claim })\n}\n\nfn wake_runtime_busy(\n    db: &mut MailboxDb,\n    session_id: &str,\n    runtime: Option<&SessionRuntimeRow>,\n) -> Result<bool, WakeDiagnostic> {\n    let liveness =\n        pty_runtime_liveness(db, session_id, runtime).map_err(storage_error_diagnostic)?;\n    cleanup_idle_runtime(runtime, liveness);\n    Ok(optional_pty_liveness_is_busy(liveness))\n}\n\nfn acquire_startable_wake_claim(\n    db: &mut MailboxDb,\n    input: StartWakeInput<'_>,\n    claim_token: &str,\n) -> Result<WakeClaimRow, WakeDiagnostic> {\n    let claim_result =\n        acquire_wake_claim(db, input, claim_token).map_err(storage_error_diagnostic)?;\n    wake_claim_to_start(claim_result)\n}\n\nfn wake_claim_to_start(result: WakeClaimAcquireResult) -> Result<WakeClaimRow, WakeDiagnostic> {\n    match result {\n        WakeClaimAcquireResult::Acquired(claim) => Ok(claim),\n        WakeClaimAcquireResult::NoPending => Err(WakeDiagnostic::status(\"no_pending\")),\n        WakeClaimAcquireResult::Busy => Err(WakeDiagnostic::status(\"busy\")),\n        WakeClaimAcquireResult::AlreadyInFlight(claim) => Err(already_in_flight_diagnostic(claim)),\n    }\n}\n\nfn wake_spawn_diagnostic(\n    db: &mut MailboxDb,\n    input: StartWakeInput<'_>,\n    runtime: Option<&SessionRuntimeRow>,\n    claim: WakeClaimRow,\n    spawn: Result<i64, String>,\n) -> WakeDiagnostic {\n    match spawn {\n        Ok(wake_pid) => successful_wake_spawn_diagnostic(db, input, runtime, claim, wake_pid),\n        Err(err) => failed_wake_spawn_diagnostic(db, input, claim, err),\n    }\n}\n\nfn successful_wake_spawn_diagnostic(\n    db: &mut MailboxDb,\n    input: StartWakeInput<'_>,\n    runtime: Option<&SessionRuntimeRow>,\n    claim: WakeClaimRow,\n    wake_pid: i64,\n) -> WakeDiagnostic {\n    record_wake_pid_or_warn(db, input.session_id, &claim.claim_token, wake_pid, runtime);\n    spawned_wake_diagnostic(claim.claim_token, wake_pid, input.auto_wake_count)\n}\n\nfn failed_wake_spawn_diagnostic(\n    db: &mut MailboxDb,\n    input: StartWakeInput<'_>,\n    claim: WakeClaimRow,\n    err: String,\n) -> WakeDiagnostic {\n    let _ = db.release_wake_claim(input.session_id, Some(&claim.claim_token));\n    spawn_error_diagnostic(claim.claim_token, input.auto_wake_count, err)\n}\n\nfn open_wake_mailbox() -> Result<MailboxDb, String> {\n    MailboxDb::open_default()\n}\n\nfn session_runtime_for_wake(\n    db: &MailboxDb,\n    session_id: &str,\n) -> Result<Option<SessionRuntimeRow>, String> {\n    db.session_runtime(session_id)\n}\n\nfn pty_runtime_liveness(\n    db: &mut MailboxDb,\n    session_id: &str,\n    runtime: Option<&SessionRuntimeRow>,\n) -> Result<Option<SessionLiveness>, String> {\n    if running_pty_runtime(runtime).is_none() {\n        return Ok(None);\n    };\n    session_liveness_for_runtime(db, session_id).map(Some)\n}\n\nfn running_pty_runtime(runtime: Option<&SessionRuntimeRow>) -> Option<&SessionRuntimeRow> {\n    runtime.filter(|row| row.mode == \"pty_interactive\" && row.run_state == \"running\")\n}\n\nfn session_liveness_for_runtime(\n    db: &mut MailboxDb,\n    session_id: &str,\n) -> Result<SessionLiveness, String> {\n    db.session_liveness(session_id)\n}\n\nfn cleanup_idle_runtime(runtime: Option<&SessionRuntimeRow>, liveness: Option<SessionLiveness>) {\n    if let (Some(row), Some(SessionLiveness::Idle)) = (running_pty_runtime(runtime), liveness) {\n        unlink_stale_pty_socket(row.pty_control_path.as_deref());\n    }\n}\n\nfn optional_pty_liveness_is_busy(liveness: Option<SessionLiveness>) -> bool {\n    liveness.is_some_and(pty_liveness_is_busy)\n}\n\nfn pty_liveness_is_busy(liveness: SessionLiveness) -> bool {\n    liveness == SessionLiveness::Busy\n}\n\n#[cfg(unix)]\nfn unlink_stale_pty_socket(path: Option<&str>) {\n    if let Some(path) = path {\n        let _ = pty_broker::unlink_control_socket_if_owned(path);\n    }\n}\n\n#[cfg(not(unix))]\nfn unlink_stale_pty_socket(_path: Option<&str>) {}\n\nfn acquire_wake_claim(\n    db: &mut MailboxDb,\n    input: StartWakeInput<'_>,\n    claim_token: &str,\n) -> Result<WakeClaimAcquireResult, String> {\n    db.try_acquire_or_renew_wake_claim(wake_claim_request(input, claim_token), input.renew_token)\n}\n\nfn wake_claim_request<'a>(input: StartWakeInput<'a>, claim_token: &'a str) -> WakeClaimRequest<'a> {\n    WakeClaimRequest {\n        session_id: input.session_id,\n        claim_token,\n        reason: input.reason,\n        auto_wake_count: input.auto_wake_count,\n        wake_invocation_uuid: None,\n        stale_after_seconds: WAKE_CLAIM_STALE_AFTER_SECONDS,\n    }\n}\n\nfn already_in_flight_diagnostic(claim: WakeClaimRow) -> WakeDiagnostic {\n    let mut diagnostic = WakeDiagnostic::status(\"already_in_flight\");\n    diagnostic.claim_token = Some(claim.claim_token);\n    diagnostic.wake_pid = claim.wake_pid;\n    diagnostic.auto_wake_count = Some(claim.auto_wake_count);\n    diagnostic\n}\n\nfn record_wake_pid_or_warn(\n    db: &mut MailboxDb,\n    session_id: &str,\n    claim_token: &str,\n    wake_pid: i64,\n    runtime: Option<&SessionRuntimeRow>,\n) {\n    let provider_name = runtime.and_then(|row| row.provider_name.as_deref());\n    let model_name = runtime.and_then(|row| row.model_name.as_deref());\n    if let Err(err) = db.record_wake_claim_pid_identity(\n        session_id,\n        claim_token,\n        wake_pid,\n        provider_name,\n        model_name,\n    ) {\n        tracing::warn!(session_id, claim_token, \"Failed to record wake PID: {err}\");\n    }\n}\n\nfn spawned_wake_diagnostic(\n    claim_token: String,\n    wake_pid: i64,\n    auto_wake_count: i64,\n) -> WakeDiagnostic {\n    WakeDiagnostic {\n        attempted: true,\n        status: \"spawned\".to_string(),\n        claim_token: Some(claim_token),\n        wake_pid: Some(wake_pid),\n        auto_wake_count: Some(auto_wake_count),\n        message: None,\n    }\n}\n\nfn spawn_error_diagnostic(\n    claim_token: String,\n    auto_wake_count: i64,\n    err: String,\n) -> WakeDiagnostic {\n    WakeDiagnostic {\n        attempted: true,\n        status: \"spawn_error\".to_string(),\n        claim_token: Some(claim_token),\n        wake_pid: None,\n        auto_wake_count: Some(auto_wake_count),\n        message: Some(err),\n    }\n}\n\nfn spawn_detached_resume(\n    session_id: &str,\n    runtime: Option<&SessionRuntimeRow>,\n    claim_token: &str,\n    auto_wake_count: i64,\n) -> Result<i64, String> {\n    let exe = current_agents_exe()?;\n    let cmd = detached_resume_command(exe, session_id, runtime, claim_token, auto_wake_count);\n    spawn_detached_child(cmd)\n}\n\nfn current_agents_exe() -> Result<PathBuf, String> {\n    std::env::current_exe().map_err(current_agents_exe_error)\n}\n\nfn current_agents_exe_error(err: std::io::Error) -> String {\n    format!(\"Failed to resolve current agents binary: {err}\")\n}\n\nfn spawn_detached_child(mut cmd: Command) -> Result<i64, String> {\n    cmd.spawn().map(child_pid).map_err(detached_spawn_error)\n}\n\nfn child_pid(child: Child) -> i64 {\n    i64::from(child.id())\n}\n\nfn detached_spawn_error(err: std::io::Error) -> String {\n    format!(\"Failed to spawn detached wake resume: {err}\")\n}\n\nfn detached_resume_command(\n    exe: PathBuf,\n    session_id: &str,\n    runtime: Option<&SessionRuntimeRow>,\n    claim_token: &str,\n    auto_wake_count: i64,\n) -> Command {\n    let mut cmd = Command::new(exe);\n    configure_resume_args(&mut cmd, session_id, runtime);\n    configure_wake_stdio_and_env(&mut cmd, session_id, claim_token, auto_wake_count);\n    configure_detached(&mut cmd);\n    cmd\n}\n\nfn configure_resume_args(cmd: &mut Command, session_id: &str, runtime: Option<&SessionRuntimeRow>) {\n    cmd.arg(\"resume\").arg(\"--session-id\").arg(session_id);\n    append_non_empty_arg(cmd, \"-m\", runtime.and_then(|row| row.model_name.as_deref()));\n    append_non_empty_arg(\n        cmd,\n        \"--models-dir\",\n        runtime.and_then(|row| row.models_dir.as_deref()),\n    );\n}\n\nfn append_non_empty_arg(cmd: &mut Command, flag: &str, value: Option<&str>) {\n    let Some(value) = value.filter(|value| !value.is_empty()) else {\n        return;\n    };\n    cmd.arg(flag).arg(value);\n}\n\nfn configure_wake_stdio_and_env(\n    cmd: &mut Command,\n    session_id: &str,\n    claim_token: &str,\n    auto_wake_count: i64,\n) {\n    cmd.stdin(Stdio::null())\n        .stdout(Stdio::null())\n        .stderr(Stdio::null())\n        .env(AUTO_WAKE_ENV, \"1\")\n        .env(AUTO_WAKE_SESSION_ID_ENV, session_id)\n        .env(AUTO_WAKE_TOKEN_ENV, claim_token)\n        .env(AUTO_WAKE_COUNT_ENV, auto_wake_count.to_string())\n        .env_remove(PARENT_INVOCATION_ENV);\n}\n\n#[cfg(unix)]\nfn configure_detached(cmd: &mut Command) {\n    unsafe {\n        cmd.pre_exec(|| {\n            if libc::setsid() == -1 {\n                return Err(std::io::Error::last_os_error());\n            }\n            Ok(())\n        });\n    }\n}\n\n#[cfg(not(unix))]\nfn configure_detached(_cmd: &mut Command) {}\n\nfn pending_count(session_id: &str) -> Result<usize, String> {\n    crate::mailbox_delivery::deliverable_pending_count(session_id)\n}\n\nfn current_auto_wake() -> Option<AutoWakeEnv> {\n    auto_wake_marker_present()\n        .then(current_auto_wake_env)\n        .flatten()\n}\n\nfn auto_wake_max() -> i64 {\n    validated_auto_wake_max(parsed_auto_wake_max())\n}\n\nfn current_auto_wake_env() -> Option<AutoWakeEnv> {\n    Some(auto_wake_env(auto_wake_token()?, auto_wake_count()))\n}\n\nfn auto_wake_count() -> i64 {\n    parse_auto_wake_count(auto_wake_count_value())\n}\n\nfn parsed_auto_wake_max() -> Option<i64> {\n    parse_auto_wake_max(auto_wake_max_value())\n}\n\nfn auto_wake_token() -> Option<String> {\n    std::env::var(AUTO_WAKE_TOKEN_ENV).ok()\n}\n\nfn auto_wake_count_value() -> Option<String> {\n    std::env::var(AUTO_WAKE_COUNT_ENV).ok()\n}\n\nfn auto_wake_max_value() -> Option<String> {\n    std::env::var(AUTO_WAKE_MAX_ENV).ok()\n}\n\nfn parse_auto_wake_count(value: Option<String>) -> i64 {\n    value.and_then(|value| value.parse().ok()).unwrap_or(1)\n}\n\nfn parse_auto_wake_max(value: Option<String>) -> Option<i64> {\n    value.and_then(|value| value.parse::<i64>().ok())\n}\n\nfn validated_auto_wake_max(value: Option<i64>) -> i64 {\n    value\n        .filter(|value| *value > 0)\n        .unwrap_or(DEFAULT_AUTO_WAKE_MAX)\n}\n\nfn auto_wake_env(token: String, count: i64) -> AutoWakeEnv {\n    AutoWakeEnv { token, count }\n}\n\nfn release_current_auto_wake_claim(session_id: &str, auto_wake: Option<&AutoWakeEnv>) {\n    let Some(auto_wake) = auto_wake else {\n        return;\n    };\n    match MailboxDb::open_default_if_exists() {\n        Ok(Some(mut db)) => release_wake_claim_or_warn(&mut db, session_id, &auto_wake.token),\n        Ok(None) => {}\n        Err(err) => warn_open_sidecar_for_release_failed(session_id, err),\n    }\n}\n\nfn release_wake_claim_or_warn(db: &mut MailboxDb, session_id: &str, token: &str) {\n    if let Err(err) = db.release_wake_claim(session_id, Some(token)) {\n        warn_release_wake_claim_failed(session_id, err);\n    }\n}\n\nfn warn_release_wake_claim_failed(session_id: &str, err: String) {\n    tracing::warn!(session_id, \"Failed to release wake claim: {err}\");\n}\n\nfn warn_open_sidecar_for_release_failed(session_id: &str, err: String) {\n    tracing::warn!(\n        session_id,\n        \"Failed to open sidecar to release wake claim: {err}\"\n    );\n}","lineStart":1,"lineEnd":1149,"totalLines":1149,"truncated":false}},"title":"src-tauri/src/wake_coordinator.rs","time":{"start":1780923080141,"end":1780923080229}},"metadata":{"openai":{"itemId":"fc_0bea6e3aadc7efe2016a26bac80acc8198b56196f50e7056e9"}},"id":"prt_ea7499db1001bQ71r45rxuX7yb","sessionID":"ses_158b7240dffejD0kl19r2Asju7","messageID":"msg_ea7497a38001ZEv6CJi9mhcErI"}}
