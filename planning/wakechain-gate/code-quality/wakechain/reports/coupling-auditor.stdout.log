\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n465:   cat <<'JSON'\n466: [\n467:   {\"id\":\"ses_current_requested\"}\n468: ]\n469: JSON\n470:   exit 0\n471: fi\n472: \n473: if [[ \"$1\" == \"export\" ]]; then\n474:   session_id=\"$2\"\n475:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n476:   cat <<'JSON'\n477: {\n478:   \"info\": {\n479:     \"id\": \"ses_current_info\",\n480:     \"time\": {\"created\": 1700000000000}\n481:   },\n482:   \"messages\": [\n483:     {\n484:       \"info\": {\n485:         \"role\": \"user\",\n486:         \"time\": {\"created\": 1700000000000},\n487:         \"id\": \"msg_user_current\",\n488:         \"sessionID\": \"ses_current_info\"\n489:       },\n490:       \"parts\": [\n491:         {\n492:           \"type\": \"text\",\n493:           \"text\": \"[OULIPOLY-DELIVERY 123e4567-e89b-12d3-a456-426614174000] wake please\"\n494:         }\n495:       ]\n496:     },\n497:     {\n498:       \"info\": {\n499:         \"role\": \"assistant\",\n500:         \"time\": {\"created\": 1700000005000},\n501:         \"id\": \"msg_assistant_current\",\n502:         \"sessionID\": \"ses_current_info\"\n503:       },\n504:       \"parts\": [{\"type\": \"text\", \"text\": \"confirmed\"}]\n505:     }\n506:   ]\n507: }\n508: JSON\n509:   exit 0\n510: fi\n511: \n512: echo \"unexpected opencode args: $*\" >&2\n513: exit 64\n514: MOCK_OPENCODE\n515: }\n516: \n517: write_current_export_mock() {\n518:   local path=\"$1\"\n519: \n520:   write_executable_mock \"$path\" emit_current_export_mock_body\n521: }\n522: \n523: emit_session_id_env_mock_body() {\n524:   cat <<'MOCK_OPENCODE'\n525: #!/usr/bin/env bash\n526: set -euo pipefail\n527: \n528: if [[ \"$1\" == \"session\" && \"$2\" == \"list\" && \"${3:-}\" == \"--json\" ]]; then\n529:   printf '[]\\n'\n530:   exit 0\n531: fi\n532: \n533: if [[ \"$1\" == \"export\" ]]; then\n534:   session_id=\"$2\"\n535:   printf '%s\\n' \"$session_id\" >>\"$OPENCODE_TURNS_EXPORT_LOG\"\n536:   if [[ \"$session_id\" != \"ses_env_requested\" ]]; then\n537:     printf '[]\\n'\n538:     exit 0\n539:   fi\n540:   cat <<'JSON'\n541: {\n542:   \"info\": {\n543:     \"id\": \"ses_env_requested\",\n544:     \"time\": {\"created\": 1700000000000}\n545:   },\n546:   \"messages\": [\n547:     {\n548:       \"info\": {\n549:         \"role\": \"user\",\n550:         \"time\": {\"created\": 1700000000000},\n551:         \"id\": \"msg_user_env\",\n552:         \"sessionID\": \"ses_env_requested\"\n553:       },\n554:       \"parts\": [{\"type\": \"text\", \"text\": \"wake via SESSION_ID env\"}]\n555:     },\n556:     {\n557:       \"info\": {\n558:         \"role\": \"assistant\",\n559:         \"time\": {\"created\": 1700000005000},\n560:         \"id\": \"msg_assistant_env\",\n561:         \"sessionID\": \"ses_env_requested\"\n562:       },\n563:       \"parts\": [{\"type\": \"text\", \"text\": \"confirmed via env\"}]\n564:     }\n565:   ]\n566: }\n567: JSON\n568:   exit 0\n569: fi\n570: \n571: echo \"unexpected opencode args: $*\" >&2\n572: exit 64\n573: MOCK_OPENCODE\n574: }\n575: \n576: write_session_id_env_mock() {\n577:   local path=\"$1\"\n578: \n579:   write_executable_mock \"$path\" emit_session_id_env_mock_body\n580: }\n581: \n582: run_opencode_turns() {\n583:   local tmpdir=\"$1\"\n584:   local opencode_bin=\"$2\"\n585: \n586:   RUN_STDOUT=\"$tmpdir/stdout.jsonl\"\n587:   RUN_STDERR=\"$tmpdir/stderr.txt\"\n588:   OPENCODE_TURNS_EXPORT_LOG=\"$tmpdir/exports.log\"\n589:   export OPENCODE_TURNS_EXPORT_LOG\n590:   : >\"$OPENCODE_TURNS_EXPORT_LOG\"\n591: \n592:   set +e\n593:   OPENCODE_BIN=\"$opencode_bin\" \\\n594:     OPENCODE_TURNS_WINDOW_HOURS=\"${OPENCODE_TURNS_WINDOW_HOURS:-6}\" \\\n595:     OPENCODE_TURNS_MAX_SESSIONS=\"${OPENCODE_TURNS_MAX_SESSIONS:-25}\" \\\n596:     OPENCODE_TURNS_CALL_TIMEOUT=\"${OPENCODE_TURNS_CALL_TIMEOUT:-20}\" \\\n597:     OPENCODE_TURNS_DEADLINE=\"${OPENCODE_TURNS_DEADLINE:-60}\" \\\n598:     \"$SCRIPT\" \"$tmpdir/opencode-root\" >\"$RUN_STDOUT\" 2>\"$RUN_STDERR\"\n599:   RUN_STATUS=$?\n600:   set -e\n601: }\n602: \n603: run_opencode_turns_with_session_id_env_on_path() {\n604:   local tmpdir=\"$1\"\n605:   local session_id=\"$2\"\n606: \n607:   RUN_STDOUT=\"$tmpdir/stdout.jsonl\"\n608:   RUN_STDERR=\"$tmpdir/stderr.txt\"\n609:   OPENCODE_TURNS_EXPORT_LOG=\"$tmpdir/exports.log\"\n610:   export OPENCODE_TURNS_EXPORT_LOG\n611:   : >\"$OPENCODE_TURNS_EXPORT_LOG\"\n612: \n613:   set +e\n614:   env -u OPENCODE_BIN \\\n615:     PATH=\"$tmpdir/bin:$PATH\" \\\n616:     SESSION_ID=\"$session_id\" \\\n617:     OPENCODE_TURNS_WINDOW_HOURS=6 \\\n618:     OPENCODE_TURNS_MAX_SESSIONS=25 \\\n619:     OPENCODE_TURNS_CALL_TIMEOUT=20 \\\n620:     OPENCODE_TURNS_DEADLINE=60 \\\n621:     \"$SCRIPT\" \"$tmpdir/opencode-root\" >\"$RUN_STDOUT\" 2>\"$RUN_STDERR\"\n622:   RUN_STATUS=$?\n623:   set -e\n624: }\n625: \n626: test_timestampless_session_list_applies_max_sessions_cap() {\n627:   local tmpdir\n628:   tmpdir=\"$(mktemp -d)\"\n629:   trap \"rm -rf '$tmpdir'\" RETURN\n630: \n631:   mkdir -p \"$tmpdir/bin\"\n632:   write_timestampless_cap_mock \"$tmpdir/bin/opencode\"\n633: \n634:   OPENCODE_TURNS_MAX_SESSIONS=3 run_opencode_turns \"$tmpdir\" \"$tmpdir/bin/opencode\"\n635: \n636:   assert_status_zero \"$RUN_STATUS\" \"$FUNCNAME\"\n637:   assert_eq \"$(cat \"$OPENCODE_TURNS_EXPORT_LOG\")\" $'ses_cap_one\\nses_cap_two\\nses_cap_three' \"$FUNCNAME exports\"\n638:   assert_eq \"$(wc -l <\"$OPENCODE_TURNS_EXPORT_LOG\" | tr -d ' ')\" \"3\" \"$FUNCNAME export count\"\n639:   assert_stdout_contains '\"session_id\":\"ses_cap_one\"' \"$FUNCNAME cap one\"\n640:   assert_stdout_contains '\"session_id\":\"ses_cap_three\"' \"$FUNCNAME cap three\"\n641:   assert_stdout_not_contains 'ses_cap_four' \"$FUNCNAME cap excludes fourth\"\n642:   assert_stdout_not_contains 'ses_cap_five' \"$FUNCNAME cap excludes fifth\"\n643: }\n644: \n645: test_exports_only_recent_window_sessions() {\n646:   local tmpdir\n647: 