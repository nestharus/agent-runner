 fixture\n2714: +}\n2715: +\n2716: +fn fake_opencode_script() -> &'static str {\n2717: +    r#\"#!/usr/bin/env python3\n2718: +import json\n2719: +import os\n2720: +import pathlib\n2721: +import re\n2722: +import sys\n2723: +\n2724: +SESSION = \"ses_wakeconfirmlegacy\"\n2725: +\n2726: +def work_dir():\n2727: +    return pathlib.Path(os.environ[\"WAKE_CONFIRM_WORK_DIR\"])\n2728: +\n2729: +def export_dir():\n2730: +    return pathlib.Path(os.environ[\"WAKE_CONFIRM_EXPORT_DIR\"])\n2731: +\n2732: +def session_path(session_id):\n2733: +    return export_dir() / f\"{session_id}.jsonl\"\n2734: +\n2735: +def next_turn_id(session_id, role):\n2736: +    path = session_path(session_id)\n2737: +    if not path.exists():\n2738: +        return f\"{role}-1\"\n2739: +    count = sum(1 for line in path.read_text(encoding=\"utf-8\").splitlines() if line.strip())\n2740: +    return f\"{role}-{count + 1}\"\n2741: +\n2742: +def append_turn(session_id, role, text):\n2743: +    export_dir().mkdir(parents=True, exist_ok=True)\n2744: +    turn = {\n2745: +        \"session_id\": session_id,\n2746: +        \"turn_id\": next_turn_id(session_id, role),\n2747: +        \"timestamp\": \"2026-06-07T00:00:00Z\",\n2748: +        \"role\": role,\n2749: +        \"body\": [{\"type\": \"text\", \"text\": text}],\n2750: +    }\n2751: +    with session_path(session_id).open(\"a\", encoding=\"utf-8\") as handle:\n2752: +        handle.write(json.dumps(turn, separators=(\",\", \":\")) + \"\\n\")\n2753: +\n2754: +def stored_resume_prompt(prompt):\n2755: +    if os.environ.get(\"WAKE_CONFIRM_STRIP_DELIVERY_NONCE\") == \"1\":\n2756: +        prompt = re.sub(r\"^\\[OULIPOLY-DELIVERY [^\\n]*\\]\\n?\", \"\", prompt, flags=re.MULTILINE)\n2757: +    return f'\"{prompt}\"'\n2758: +\n2759: +def parse_run(argv):\n2760: +    session_id = SESSION\n2761: +    prompt = \"\"\n2762: +    index = 0\n2763: +    while index < len(argv):\n2764: +        arg = argv[index]\n2765: +        if arg == \"--session\" and index + 1 < len(argv):\n2766: +            session_id = argv[index + 1]\n2767: +            index += 2\n2768: +            continue\n2769: +        if arg == \"--json\":\n2770: +            index += 1\n2771: +            continue\n2772: +        prompt = arg\n2773: +        index += 1\n2774: +    return session_id, prompt\n2775: +\n2776: +def run(argv):\n2777: +    session_id, prompt = parse_run(argv)\n2778: +    if \"--session\" in argv:\n2779: +        (work_dir() / \"legacy-wake-resumed.txt\").write_text(prompt, encoding=\"utf-8\")\n2780: +        if os.environ.get(\"WAKE_CONFIRM_OMIT_RESUME_USER_TURN\") != \"1\":\n2781: +            append_turn(session_id, \"user\", stored_resume_prompt(prompt))\n2782: +        append_turn(session_id, \"assistant\", \"legacy wake acknowledged\")\n2783: +        print(\"legacy wake acknowledged\", flush=True)\n2784: +        return 0\n2785: +    print(json.dumps({\"type\": \"step_start\", \"sessionID\": SESSION}), flush=True)\n2786: +    append_turn(SESSION, \"user\", prompt)\n2787: +    append_turn(SESSION, \"assistant\", \"legacy parent acknowledged\")\n2788: +    print(\"legacy parent acknowledged\", flush=True)\n2789: +    return 0\n2790: +\n2791: +def export_session(argv):\n2792: +    session_id = argv[0] if argv else SESSION\n2793: +    path = session_path(session_id)\n2794: +    if path.exists():\n2795: +        sys.stdout.write(path.read_text(encoding=\"utf-8\"))\n2796: +    return 0\n2797: +\n2798: +def main():\n2799: +    subcommand = sys.argv[1] if len(sys.argv) > 1 else \"\"\n2800: +    if subcommand == \"export\":\n2801: +        return export_session(sys.argv[2:])\n2802: +    if subcommand == \"run\":\n2803: +        return run(sys.argv[2:])\n2804: +    print(f\"unsupported fake opencode subcommand: {subcommand}\", file=sys.stderr)\n2805: +    return 64\n2806: +\n2807: +if __name__ == \"__main__\":\n2808: +    raise SystemExit(main())\n2809: +\"#\n2810: +}\n2811: +\n2812: +fn fake_opencode_turns_script() -> &'static str {\n2813: +    r#\"#!/usr/bin/env python3\n2814: +import os\n2815: +import subprocess\n2816: +import sys\n2817: +\n2818: +session_id = os.environ.get(\"SESSION_ID\")\n2819: +if not session_id:\n2820: +    raise SystemExit(0)\n2821: +\n2822: +result = subprocess.run(\n2823: +    [\"opencode\", \"export\", session_id],\n2824: +    stdout=subprocess.PIPE,\n2825: +    stderr=subprocess.PIPE,\n2826: +    text=True,\n2827: +    check=False,\n2828: +)\n2829: +if result.returncode != 0:\n2830: +    sys.stderr.write(result.stderr)\n2831: +    raise SystemExit(result.returncode)\n2832: +sys.stdout.write(result.stdout)\n2833: +\"#\n2834: +}\n2835: +\n2836: +fn assert_success(output: &Output) {\n2837: +    assert_exit_code(output, 0);\n2838: +}\n2839: +\n2840: +fn assert_exit_code(output: &Output, expected: i32) {\n2841: +    assert_eq!(\n2842: +        output.status.code(),\n2843: +        Some(expected),\n2844: +        \"stdout={}\\nstderr={}\",\n2845: +        String::from_utf8_lossy(&output.stdout),\n2846: +        String::from_utf8_lossy(&output.stderr)\n2847: +    );\n2848: +}\n2849: +\n2850: +fn wait_for_file(path: &Path) -> String {\n2851: +    wait_for_path_exists(path);\n2852: +    fs::read_to_string(path).unwrap()\n2853: +}\n2854: +\n2855: +fn wait_for_path_exists(path: &Path) {\n2856: +    wait_until(&format!(\"{} exists\", path.display()), || path.exists());\n2857: +}\n2858: +\n2859: +fn wait_until(label: &str, mut predicate: impl FnMut() -> bool) {\n2860: +    let start = Instant::now();\n2861: +    while start.elapsed() < Duration::from_secs(10) {\n2862: +        if predicate() {\n2863: +            return;\n2864: +        }\n2865: +        std::thread::sleep(Duration::from_millis(50));\n2866: +    }\n2867: +    panic!(\"timed out waiting for {label}\");\n2868: +}\n2869: +\n2870: +fn delivery_nonce_from_prompt(prompt: &str) -> String {\n2871: +    let prefix = \"[OULIPOLY-DELIVERY \";\n2872: +    let start = prompt\n2873: +        .find(prefix)\n2874: +        .unwra